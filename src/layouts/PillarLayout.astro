---
import BaseLayout from './BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import DefinitionBlock from '../components/DefinitionBlock.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import CTABand from '../components/CTABand.astro';
import { siteConfig } from '../data/site';
import { generateBreadcrumbs, generateFAQPage } from '../data/schema';
import { t } from '../i18n/utils';

interface Props {
  pillar: {
    title: string;
    pageSlug: string;
    citableDefinition: string;
    subtopics: Array<{ title: string; description: string }>;
    faq: Array<{ q: string; a: string }>;
    seo: { title: string; description: string };
  };
}

const { pillar } = Astro.props;
const pageUrl = `/themen/${pillar.pageSlug}`;

const breadcrumbs = [
  { label: t('breadcrumb.home'), href: '/' },
  { label: t('breadcrumb.themen'), href: '/themen' },
  { label: pillar.title },
];

const breadcrumbSchema = breadcrumbs.map((b) => ({
  name: b.label,
  url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}${pageUrl}`,
}));
---

<BaseLayout
  title={pillar.seo.title}
  description={pillar.seo.description}
  schemas={[
    generateBreadcrumbs(breadcrumbSchema),
    ...(pillar.faq.length > 0 ? [generateFAQPage(pillar.faq)] : []),
  ]}
  locale="de"
>
  <BreadcrumbNav items={breadcrumbs} />

  <DefinitionBlock
    term={pillar.title}
    definition={pillar.citableDefinition}
  />

  <article class="py-12 md:py-16 lg:py-20">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <div class="prose prose-lg max-w-none mb-12">
        <slot />
      </div>
    </div>

    {pillar.subtopics.length > 0 && (
      <section class="py-12 md:py-16 bg-bg-alt">
        <div class="max-w-3xl mx-auto px-4 md:px-6">
          <h2 class="font-heading text-2xl md:text-3xl text-text mb-8">
            Themen im Überblick
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {pillar.subtopics.map((topic) => (
              <div class="bg-white rounded-card p-6 border border-border">
                <h3 class="font-medium text-text mb-2">{topic.title}</h3>
                <p class="text-sm text-text-muted leading-relaxed">{topic.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}
  </article>

  {pillar.faq.length > 0 && (
    <FAQAccordion
      items={pillar.faq}
      locale="de"
      pageType="pillar"
      pageSlug={pillar.pageSlug}
    />
  )}

  <CTABand
    title="Mehr über dieses Thema erfahren?"
    subtitle="Entdecke meine Produkte und Artikel zu diesem Thema — wissenschaftlich fundiert."
    ctaText="Angebot entdecken"
    ctaHref="/angebot"
    eventName="product_cta_click"
    locale="de"
    pageType="pillar"
    pageSlug={pillar.pageSlug}
  />
</BaseLayout>
