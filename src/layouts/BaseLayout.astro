---
import '../styles/global.css';
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyMobileCTA from '../components/StickyMobileCTA.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { siteConfig, type Locale } from '../data/site';
import type { PageType } from '../lib/analytics';
import { getTrackingScript, getCapiHelperScript } from '../lib/analytics';
import { t } from '../i18n/utils';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  hreflang?: Array<{ lang: string; href: string }>;
  noindex?: boolean;
  schemas?: string[];
  locale?: Locale;
  hideNewsletter?: boolean;
  hideStickyMobileCTA?: boolean;
}

const {
  title,
  description,
  canonical = `${siteConfig.url}${Astro.url.pathname}`,
  ogImage,
  ogType,
  hreflang,
  noindex = false,
  schemas = [],
  locale = 'nl',
  hideNewsletter = false,
  hideStickyMobileCTA = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang={locale} class="scroll-smooth">
<head>
  <SEOHead
    title={title}
    description={description}
    canonical={canonical}
    ogImage={ogImage}
    ogType={ogType}
    hreflang={hreflang}
    noindex={noindex}
    schemas={schemas}
    locale={locale}
  />

  <script is:inline set:html={getTrackingScript()} />
  <script is:inline set:html={getCapiHelperScript()} />
</head>
<body class="bg-bg text-text min-h-screen flex flex-col">
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-[100] focus:px-4 focus:py-2 focus:bg-accent focus:text-white focus:rounded-button focus:text-sm"
  >
    {t('general.skipToContent', locale)}
  </a>

  <Header locale={locale} currentPath={Astro.url.pathname} hreflang={hreflang} />

  <main id="main-content" class="flex-1">
    <slot />
  </main>

  <div class="h-20 md:hidden" aria-hidden="true"></div>

  <Footer locale={locale} hideNewsletter={hideNewsletter} />

  {!hideStickyMobileCTA && <StickyMobileCTA locale={locale} />}

  <CookieConsent locale={locale} />

  <script is:inline>
  (function(){
    if(!('IntersectionObserver' in window)) {
      document.querySelectorAll('.js-reveal').forEach(function(el){el.classList.add('is-visible')});
      return;
    }
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if(e.isIntersecting){e.target.classList.add('is-visible');io.unobserve(e.target)}
      });
    },{threshold:0.1,rootMargin:'0px 0px -40px 0px'});
    document.querySelectorAll('.js-reveal').forEach(function(el){io.observe(el)});
  })();
  </script>
</body>
</html>
