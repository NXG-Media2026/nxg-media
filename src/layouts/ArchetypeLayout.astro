---
import BaseLayout from './BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import CTABand from '../components/CTABand.astro';
import ExternalCTAButton from '../components/ExternalCTAButton.astro';
import { siteConfig } from '../data/site';
import { generateBreadcrumbs, generateFAQPage } from '../data/schema';
import { t } from '../i18n/utils';
import { trackOnClick } from '../lib/analytics';
import { getCluster, type ClusterConfig } from '../lib/clusters';

interface Props {
  archetype: {
    title: string;
    pageSlug: string;
    shortDescription: string;
    explanation: string;
    commonSymptoms: string[];
    recommendedProductSlugs: string[];
    recommendedCoachingSlugs: string[];
    recommendedClusterSlugs?: string[];
    faq: Array<{ q: string; a: string }>;
    seo: { title: string; description: string };
  };
}

const { archetype } = Astro.props;

// Resolve recommended clusters — only include those with existing YAML configs
const resolvedClusters: ClusterConfig[] = (archetype.recommendedClusterSlugs ?? [])
  .map((slug) => getCluster(slug))
  .filter((c): c is ClusterConfig => c !== null);
const pageUrl = `/archetypen/${archetype.pageSlug}`;

const breadcrumbs = [
  { label: t('breadcrumb.home'), href: '/' },
  { label: t('quiz.heading'), href: '/quiz' },
  { label: archetype.title },
];

const breadcrumbSchema = breadcrumbs.map((b) => ({
  name: b.label,
  url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}${pageUrl}`,
}));
---

<BaseLayout
  title={archetype.seo.title}
  description={archetype.seo.description}
  noindex={true}
  schemas={[
    generateBreadcrumbs(breadcrumbSchema),
    ...(archetype.faq.length > 0 ? [generateFAQPage(archetype.faq)] : []),
  ]}
  locale="de"
>
  <BreadcrumbNav items={breadcrumbs} />

  <article class="py-12 md:py-16 lg:py-20">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <div class="mb-10 md:mb-14">
        <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/10 text-accent rounded-full mb-4">
          Dein Hormon-Typ
        </span>
        <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl text-text mb-4">
          {archetype.title}
        </h1>
        <p class="text-lg text-text-muted leading-relaxed">
          {archetype.shortDescription}
        </p>
      </div>

      <div class="bg-bg-alt rounded-card p-6 md:p-8 border border-border mb-12">
        <h2 class="font-heading text-xl text-text mb-3">Was das bedeutet</h2>
        <p class="text-text-muted leading-relaxed">
          {archetype.explanation}
        </p>
      </div>

      {archetype.commonSymptoms.length > 0 && (
        <section class="mb-12">
          <h2 class="font-heading text-2xl md:text-3xl text-text mb-6">
            Typische Anzeichen
          </h2>
          <ul class="space-y-3">
            {archetype.commonSymptoms.map((symptom) => (
              <li class="flex items-start gap-3 text-text-muted">
                <svg class="w-5 h-5 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" />
                </svg>
                {symptom}
              </li>
            ))}
          </ul>
        </section>
      )}

      <div class="prose prose-lg max-w-none prose-headings:font-heading prose-headings:text-text prose-p:text-text-muted prose-p:leading-relaxed prose-li:text-text-muted mb-12">
        <slot />
      </div>

      {resolvedClusters.length > 0 && (
        <section class="mb-12">
          <h2 class="font-heading text-2xl md:text-3xl text-text mb-2">
            Vertiefe dein Ergebnis
          </h2>
          <p class="text-text-muted mb-6">
            Diese Themen helfen dir, dein Ergebnis besser einzuordnen und die n&auml;chsten Schritte zu verstehen.
          </p>
          <div class="space-y-4">
            {resolvedClusters.map((cluster) => (
              <a
                href={`/themen/${cluster.hubSlug}`}
                class="group block bg-bg-alt rounded-card p-5 md:p-6 border border-border hover:border-accent/30 hover:shadow-md transition-all duration-300"
                onclick={trackOnClick('cross_cluster_link_click', {
                  page_type: 'archetype',
                  page_slug: archetype.pageSlug,
                  locale: 'de',
                  source_page_type: 'archetype',
                  target_cluster: cluster.slug,
                })}
              >
                <div class="flex items-start justify-between gap-4">
                  <div>
                    <span class="inline-flex items-center px-2.5 py-0.5 text-xs font-medium bg-accent/10 text-accent rounded-full mb-2">
                      {cluster.shortTitle || cluster.title}
                    </span>
                    <h3 class="font-heading text-lg text-text mb-1 group-hover:text-accent transition-colors">
                      {cluster.title}
                    </h3>
                    <p class="text-sm text-text-muted leading-relaxed line-clamp-2">
                      {cluster.citableDefinition}
                    </p>
                  </div>
                  <svg class="w-5 h-5 text-text-muted group-hover:text-accent shrink-0 mt-1 group-hover:translate-x-1 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </div>
              </a>
            ))}
          </div>
        </section>
      )}

      {(archetype.recommendedProductSlugs.length > 0 || archetype.recommendedCoachingSlugs.length > 0) && (
        <section class="bg-bg-alt rounded-card p-6 md:p-8 border border-border mb-12">
          <h2 class="font-heading text-xl text-text mb-4">Meine Empfehlung für dich</h2>
          <div class="flex flex-wrap gap-3">
            {archetype.recommendedProductSlugs.map((slug) => (
              <a
                href={`/produkte/${slug}`}
                class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-text-inverse bg-primary hover:bg-primary-dark rounded-button transition-colors"
              >
                Zum Produkt
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            ))}
            {archetype.recommendedCoachingSlugs.map((slug) => (
              <a
                href={`/coaching/${slug}`}
                class="inline-flex items-center gap-2 px-5 py-2.5 text-sm font-medium text-primary border border-primary hover:bg-primary/5 rounded-button transition-colors"
              >
                Zum Coaching
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
  </article>

  {archetype.faq.length > 0 && (
    <FAQAccordion
      items={archetype.faq}
      locale="de"
      pageType="archetype"
      pageSlug={archetype.pageSlug}
    />
  )}

  <CTABand
    title="Bereit, deinen Hormon-Typ zu unterstützen?"
    subtitle="Entdecke meine Produkte und Coaching-Angebote — passend zu deinem Typ."
    ctaText="Angebot entdecken"
    ctaHref="/angebot"
    eventName="product_cta_click"
    locale="de"
    pageType="archetype"
    pageSlug={archetype.pageSlug}
  />
</BaseLayout>
