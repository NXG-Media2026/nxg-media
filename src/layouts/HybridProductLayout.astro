---
/**
 * HybridProductLayout — cluster-aware product page (sales + SEO hybrid).
 *
 * Based on CLUSTER_ARCHITECTURE_V1.2 §4.2
 *
 * Differences from ProductLayout:
 * - Resolves cluster context from YAML
 * - "Related learning" section from cluster articles
 * - "Not for you if" section for honest positioning
 * - Cross-sell from cluster YAML (graceful fallback)
 * - Lead magnet alt-CTA only if it exists
 * - Enhanced analytics with cluster properties
 * - No Calendly (controlled by cluster.calendlyContext)
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import TestimonialSlider from '../components/TestimonialSlider.astro';
import CTABand from '../components/CTABand.astro';
import { siteConfig } from '../data/site';
import { generateProduct, generateBreadcrumbs, generateFAQPage } from '../data/schema';
import { getProductTestimonials } from '../data/testimonials';
import type { Testimonial } from '../data/testimonials';
import { t } from '../i18n/utils';
import { trackOnClick } from '../lib/analytics';
import { getCluster, getClusterArticles } from '../lib/clusters';

interface Props {
  product: {
    title: string;
    pageSlug: string;
    price: string;
    currency: string;
    plugAndPayUrl: string;
    heroImage?: ImageMetadata;
    shortDescription: string;
    longDescription: string;
    includes: Array<{ title: string; description: string; icon?: string }>;
    targetAudience: string[];
    notForYou?: string[];
    cluster?: string;
    productType?: string;
    faq: Array<{ q: string; a: string }>;
    relatedProductSlugs?: string[];
    seo: { title: string; description: string };
  };
}

const { product } = Astro.props;
const pageUrl = `/produkte/${product.pageSlug}`;
const ogImage = `/images/og/products/${product.pageSlug}.png`;

// ─── Cluster context ────────────────────────────────────────────
const clusterSlug = product.cluster || '';
const cluster = clusterSlug ? getCluster(clusterSlug) : null;
const clusterArticles = clusterSlug ? await getClusterArticles(clusterSlug) : [];

// ─── Cross-sell from cluster YAML (graceful) ────────────────────
const allProducts = await getCollection('produkte');
const crossSellSlugs = cluster?.crossSellProducts ?? [];
const crossSellProducts = crossSellSlugs
  .map((slug) => allProducts.find((p) => p.data.pageSlug === slug))
  .filter((p): p is NonNullable<typeof p> => p != null);

// Also resolve frontmatter related products as fallback
const relatedProducts = (product.relatedProductSlugs ?? [])
  .map((slug) => allProducts.find((p) => p.data.pageSlug === slug))
  .filter((p): p is NonNullable<typeof p> => p != null);

// Combine: cross-sell first, then related, deduplicate, exclude self
const combinedRelated = [...crossSellProducts, ...relatedProducts]
  .filter((p, i, arr) => arr.findIndex((x) => x.data.pageSlug === p.data.pageSlug) === i)
  .filter((p) => p.data.pageSlug !== product.pageSlug)
  .slice(0, 3);

// ─── Lead magnet (only if exists) ───────────────────────────────
const leadMagnetSlug = cluster?.leadMagnets?.primary?.slug || '';
const hasLeadMagnet = leadMagnetSlug.trim() !== '';

// ─── Testimonials ───────────────────────────────────────────────
const productTestimonials: Testimonial[] = getProductTestimonials(product.pageSlug, 4);

// ─── Analytics props ────────────────────────────────────────────
const analyticsBase = {
  page_type: 'product' as const,
  page_slug: product.pageSlug,
  locale: 'de',
  product: product.pageSlug,
  product_type: product.productType || 'guide',
  product_cluster: clusterSlug,
  source_page_type: 'product' as const,
  source_cluster: clusterSlug,
};

// ─── Breadcrumbs ────────────────────────────────────────────────
const breadcrumbs = [
  { label: t('breadcrumb.home'), href: '/' },
  { label: t('breadcrumb.angebot'), href: '/angebot' },
  { label: t('breadcrumb.produkte'), href: '/produkte' },
  { label: product.title },
];

const breadcrumbSchema = breadcrumbs.map((b) => ({
  name: b.label,
  url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}${pageUrl}`,
}));
---

<BaseLayout
  title={product.seo.title}
  description={product.seo.description}
  ogImage={ogImage}
  ogType="product"
  schemas={[
    generateProduct({
      name: product.title,
      description: product.shortDescription,
      url: `${siteConfig.url}${pageUrl}`,
      price: product.price,
      currency: product.currency,
      reviews: productTestimonials,
    }),
    generateBreadcrumbs(breadcrumbSchema),
    ...(product.faq.length > 0 ? [generateFAQPage(product.faq)] : []),
  ]}
  locale="de"
>
  <BreadcrumbNav items={breadcrumbs} />

  {/* ─── Hero Image ──────────────────────────────────────────── */}
  {product.heroImage && (
    <div class="w-full bg-bg-alt">
      <div class="max-w-5xl mx-auto">
        <Image
          src={product.heroImage}
          alt={`${product.title} — digitales Produkt von doc.veri`}
          width={1200}
          height={750}
          class="w-full h-auto"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  )}

  {/* ─── Hero Header ─────────────────────────────────────────── */}
  <header class="py-12 md:py-16 lg:py-20 bg-bg">
    <div class="max-w-3xl mx-auto px-4 md:px-6 text-center">
      {cluster && (
        <a
          href={`/themen/${cluster.hubSlug}`}
          class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/10 text-accent-dark rounded-full mb-4 hover:bg-accent/20 transition-colors"
        >
          {cluster.shortTitle || cluster.title}
        </a>
      )}
      <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl text-text mb-4 leading-tight">
        {product.title}
      </h1>
      <p class="text-lg md:text-xl text-text-muted leading-relaxed mb-8 max-w-2xl mx-auto">
        {product.shortDescription}
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6">
        <span class="text-3xl md:text-4xl font-heading font-bold text-text">{product.price} &euro;</span>
        <a
          href={product.plugAndPayUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center px-8 py-4 text-base font-medium text-text-inverse bg-primary hover:bg-primary-dark transition-colors rounded-button shadow-lg"
          onclick={trackOnClick('product_cta_click', { ...analyticsBase, cta_location: 'hero' })}
        >
          {t('cta.buyNow')}
          <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
        </a>
      </div>
    </div>
  </header>

  {/* ─── Long Description Callout ────────────────────────────── */}
  <section class="py-10 md:py-14 bg-bg-alt">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <div class="border-l-4 border-accent pl-6 md:pl-8">
        <p class="text-lg md:text-xl text-text leading-relaxed italic">
          {product.longDescription}
        </p>
      </div>
    </div>
  </section>

  {/* ─── Markdown Content (sales narrative) ──────────────────── */}
  <article class="py-12 md:py-16 bg-bg">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <div class="
        prose prose-lg max-w-none
        prose-headings:font-heading prose-headings:text-text prose-headings:leading-tight
        prose-h2:text-2xl prose-h2:md:text-3xl prose-h2:mt-12 prose-h2:mb-6 prose-h2:pt-8 prose-h2:border-t prose-h2:border-border
        prose-h3:text-xl prose-h3:md:text-2xl prose-h3:mt-10 prose-h3:mb-4
        prose-h4:text-lg prose-h4:md:text-xl prose-h4:mt-8 prose-h4:mb-3 prose-h4:text-accent
        prose-p:text-text-muted prose-p:leading-relaxed prose-p:mb-5
        prose-li:text-text-muted prose-li:leading-relaxed
        prose-strong:text-text prose-strong:font-semibold
        prose-ul:my-4 prose-ul:space-y-2
        prose-ol:my-4 prose-ol:space-y-2
        prose-a:text-primary prose-a:underline prose-a:underline-offset-2 hover:prose-a:text-primary-dark
      ">
        <slot />
      </div>
    </div>
  </article>

  {/* ─── What's Included ─────────────────────────────────────── */}
  {product.includes.length > 0 && (
    <section class="py-12 md:py-16 bg-bg-alt">
      <div class="max-w-3xl mx-auto px-4 md:px-6">
        <h2 class="font-heading text-2xl md:text-3xl text-text mb-8 text-center">
          {t('product.whatIsInside')}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {product.includes.map((item) => (
            <div class="bg-white rounded-card p-6 border border-border shadow-sm hover:shadow-md transition-shadow">
              <h3 class="font-heading font-medium text-text mb-2">{item.title}</h3>
              <p class="text-sm text-text-muted leading-relaxed">{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* ─── For You / Not For You ───────────────────────────────── */}
  <section class="py-12 md:py-16 bg-bg">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {/* For you if */}
        {product.targetAudience.length > 0 && (
          <div>
            <h2 class="font-heading text-xl md:text-2xl text-text mb-6 flex items-center gap-2">
              <svg class="w-6 h-6 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              Perfekt für dich, wenn&hellip;
            </h2>
            <ul class="space-y-3">
              {product.targetAudience.map((item) => (
                <li class="flex items-start gap-3 text-text-muted">
                  <svg class="w-5 h-5 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                  </svg>
                  <span class="text-sm leading-relaxed">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {/* Not for you if */}
        {product.notForYou && product.notForYou.length > 0 && (
          <div>
            <h2 class="font-heading text-xl md:text-2xl text-text mb-6 flex items-center gap-2">
              <svg class="w-6 h-6 text-text-muted shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
              Nicht das Richtige, wenn&hellip;
            </h2>
            <ul class="space-y-3">
              {product.notForYou.map((item) => (
                <li class="flex items-start gap-3 text-text-muted">
                  <svg class="w-5 h-5 text-text-muted/50 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                  </svg>
                  <span class="text-sm leading-relaxed">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  </section>

  {/* ─── Mid-page CTA ────────────────────────────────────────── */}
  <div class="py-10 md:py-14 bg-bg-alt">
    <div class="max-w-3xl mx-auto px-4 md:px-6 text-center">
      <a
        href={product.plugAndPayUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center px-10 py-4 text-lg font-medium text-text-inverse bg-primary hover:bg-primary-dark transition-colors rounded-button shadow-lg"
        onclick={trackOnClick('product_cta_click', { ...analyticsBase, cta_location: 'inline' })}
      >
        {t('cta.buyNow')} — {product.price} &euro;
        <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
        </svg>
      </a>
    </div>
  </div>

  {/* ─── Related Learning (cluster articles) ─────────────────── */}
  {clusterArticles.length > 0 && (
    <section class="py-12 md:py-16 bg-bg">
      <div class="max-w-3xl mx-auto px-4 md:px-6">
        <h2 class="font-heading text-2xl md:text-3xl text-text mb-2">
          Mehr zum Thema {cluster?.shortTitle || cluster?.title || 'lernen'}
        </h2>
        <p class="text-text-muted mb-8">
          Kostenlose Artikel aus unserem Wissensbereich.
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {clusterArticles.slice(0, 4).map((article) => (
            <a
              href={`/blog/${article.data.pageSlug}`}
              class="group block bg-white border border-border rounded-card p-5 hover:border-accent/30 hover:shadow-lg transition-all duration-300"
            >
              <h3 class="font-heading text-base md:text-lg text-text mb-2 group-hover:text-accent transition-colors leading-snug">
                {article.data.title}
              </h3>
              <p class="text-sm text-text-muted leading-relaxed line-clamp-2 mb-3">
                {article.data.excerpt}
              </p>
              <span class="text-xs text-text-muted">
                {article.data.readingTime} Min. Lesezeit
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* ─── Cross-sell / Related Products ───────────────────────── */}
  {combinedRelated.length > 0 && (
    <section class="py-12 md:py-16 bg-bg-alt">
      <div class="max-w-3xl mx-auto px-4 md:px-6">
        <h2 class="font-heading text-2xl md:text-3xl text-text mb-8 text-center">
          Das könnte dich auch interessieren
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {combinedRelated.map((rp) => (
            <a
              href={`/produkte/${rp.data.pageSlug}`}
              class="block bg-white rounded-card p-6 border border-border shadow-sm hover:shadow-md hover:border-accent/30 transition-all group"
            >
              <h3 class="font-heading font-medium text-text group-hover:text-accent transition-colors mb-2">
                {rp.data.title}
              </h3>
              <p class="text-sm text-text-muted leading-relaxed mb-3">{rp.data.shortDescription}</p>
              <span class="text-sm font-semibold text-accent">{rp.data.price} &euro;</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* ─── Testimonials ────────────────────────────────────────── */}
  {productTestimonials.length > 0 && (
    <TestimonialSlider
      title="Das sagen Kundinnen"
      testimonials={productTestimonials.map(t => ({
        name: t.name,
        text: t.text,
        rating: t.rating,
        outcome: t.outcome,
      }))}
      locale="de"
    />
  )}

  {/* ─── FAQ ─────────────────────────────────────────────────── */}
  {product.faq.length > 0 && (
    <FAQAccordion
      items={product.faq}
      locale="de"
      pageType="product"
      pageSlug={product.pageSlug}
    />
  )}

  {/* ─── Final CTA ───────────────────────────────────────────── */}
  <div class="py-12 md:py-16 bg-bg">
    <div class="max-w-3xl mx-auto px-4 md:px-6 text-center">
      <p class="text-text-muted mb-6 text-lg">Bereit loszulegen?</p>
      <a
        href={product.plugAndPayUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center px-10 py-4 text-lg font-medium text-text-inverse bg-primary hover:bg-primary-dark transition-colors rounded-button shadow-lg"
        onclick={trackOnClick('product_cta_click', { ...analyticsBase, cta_location: 'product_bottom' })}
      >
        {t('cta.buyNow')} — {product.price} &euro;
        <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
        </svg>
      </a>

      {/* Lead magnet alt-CTA — only if it actually exists */}
      {hasLeadMagnet && (
        <p class="mt-6 text-sm text-text-muted">
          Noch nicht bereit? <a href={`/lead-magnet/${leadMagnetSlug}`} class="text-accent underline underline-offset-2 hover:text-accent-dark transition-colors">Hol dir den kostenlosen Guide</a>
        </p>
      )}
    </div>
  </div>

  {/* ─── Contact CTA ─────────────────────────────────────────── */}
  <CTABand
    title="Fragen zum Produkt?"
    subtitle="Schreib mir — ich helfe dir gerne weiter."
    ctaText="Kontakt aufnehmen"
    ctaHref="/kontakt"
    eventName="discovery_call_click"
    locale="de"
    pageType="product"
    pageSlug={product.pageSlug}
  />
</BaseLayout>
