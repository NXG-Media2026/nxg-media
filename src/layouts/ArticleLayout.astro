---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import AuthorByline from '../components/AuthorByline.astro';
import BlogToProductBridge from '../components/BlogToProductBridge.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import CTABand from '../components/CTABand.astro';
import { siteConfig, type Locale } from '../data/site';
import { generateArticle, generateBreadcrumbs } from '../data/schema';
import { t, localizePath, getTranslatedPath, getCollectionBasePath } from '../i18n/utils';
import { getHreflangForContent } from '../i18n/hreflang';

interface Props {
  article: {
    title: string;
    pageSlug: string;
    pillarSlug: string;
    cluster?: string;
    secondaryClusters?: string[];
    publishedDate: Date;
    lastReviewedDate: Date;
    excerpt: string;
    readingTime: number;
    relatedProductSlugs?: string[];
    translationKey?: string;
    seo: { title: string; description: string };
  };
  locale?: Locale;
}

const { article, locale = 'de' } = Astro.props;
const blogBase = getCollectionBasePath('blog', locale);
const pageUrl = `${blogBase}/${article.pageSlug}`;

const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: localizePath('/', locale) },
  { label: t('breadcrumb.blog', locale), href: blogBase },
  { label: article.title },
];

const breadcrumbSchema = breadcrumbs.map((b) => ({
  name: b.label,
  url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}${pageUrl}`,
}));

// Check if pillar/topic page exists for this locale
const pillars = await getCollection('pillars');
const pillarExists = locale === 'de'
  ? pillars.some((p) => p.data.pageSlug === article.pillarSlug)
  : false;
// For EN, check if there's a cluster with this pillar slug as hubSlug (after localization)
import { getAllClusters } from '../lib/clusters';
const allClusters = getAllClusters();
const clusterTopicExists = locale !== 'de' && allClusters.some((c) => {
  const enOverride = c.locales?.[locale];
  return enOverride?.hubSlug === article.pillarSlug || c.hubSlug === article.pillarSlug;
});
const pillarPageExists = pillarExists || clusterTopicExists;

// Fetch related products for internal linking (same locale)
const allProducts = await getCollection('produkte');
const relatedProducts = (article.relatedProductSlugs ?? [])
  .map((slug) => allProducts.find((p) => p.data.pageSlug === slug && (!p.data.locale || p.data.locale === locale)))
  .filter((p): p is NonNullable<typeof p> => p != null);

const publishedISO = article.publishedDate.toISOString().split('T')[0];
const reviewedISO = article.lastReviewedDate.toISOString().split('T')[0];

const dateLocaleMap: Record<string, string> = { de: 'de-DE', en: 'en-US' };
const fmtDate = (d: Date) =>
  d.toLocaleDateString(dateLocaleMap[locale] ?? 'de-DE', { year: 'numeric', month: 'long', day: 'numeric' });

const hreflang = await getHreflangForContent(article.translationKey, 'artikel', 'blog');
---

<BaseLayout
  title={article.seo.title}
  description={article.seo.description}
  ogType="article"
  hreflang={hreflang}
  schemas={[
    generateArticle({
      title: article.title,
      description: article.seo.description,
      url: `${siteConfig.url}${pageUrl}`,
      datePublished: publishedISO,
      dateModified: reviewedISO,
    }, locale),
    generateBreadcrumbs(breadcrumbSchema),
  ]}
  locale={locale}
>
  <BreadcrumbNav items={breadcrumbs} />

  <article class="py-12 md:py-16 lg:py-20">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <div class="mb-10">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          {pillarPageExists ? (
            <a
              href={`${getCollectionBasePath('themen', locale)}/${article.pillarSlug}`}
              class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/10 text-accent rounded-full hover:bg-accent/20 transition-colors"
            >
              {article.pillarSlug.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase())}
            </a>
          ) : (
            <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/10 text-accent rounded-full">
              {article.pillarSlug.replace(/-/g, ' ').replace(/\b\w/g, c => c.toUpperCase())}
            </span>
          )}
          <span class="text-sm text-text-muted">{article.readingTime} {t('blog.readingTime', locale)}</span>
        </div>

        <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl text-text mb-6">
          {article.title}
        </h1>

        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-text-muted">
          <span>{t('blog.by', locale)} {siteConfig.founder.name}</span>
          <span aria-hidden="true">&middot;</span>
          <time datetime={publishedISO}>{fmtDate(article.publishedDate)}</time>
          {reviewedISO !== publishedISO && (
            <>
              <span aria-hidden="true">&middot;</span>
              <span>{t('blog.updated', locale)} {fmtDate(article.lastReviewedDate)}</span>
            </>
          )}
        </div>
      </div>

      <AuthorByline
        authorName={siteConfig.founder.name}
        authorSlug={siteConfig.founder.slug}
        publishedDate={publishedISO}
        reviewedDate={reviewedISO}
        locale={locale}
      />

      <div class="prose prose-lg max-w-none mb-12">
        <slot />
      </div>

      {/* BlogToProductBridge — only for cluster-aware articles */}
      {article.cluster && (
        <BlogToProductBridge
          clusterSlug={article.cluster}
          sourcePageSlug={article.pageSlug}
          locale={locale}
        />
      )}
    </div>
  </article>

  {relatedProducts.length > 0 && (
    <section class="py-12 md:py-16 bg-bg-alt">
      <div class="max-w-3xl mx-auto px-4 md:px-6">
        <h2 class="font-heading text-2xl md:text-3xl text-text mb-8 text-center">
          {t('blog.relatedProducts', locale)}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {relatedProducts.map((rp) => (
            <a
              href={`${getCollectionBasePath('produkte', locale)}/${rp.data.pageSlug}`}
              class="block bg-white rounded-card p-6 border border-border shadow-sm hover:shadow-md hover:border-accent/30 transition-all group"
            >
              <h3 class="font-heading font-medium text-text group-hover:text-accent transition-colors mb-2">
                {rp.data.title}
              </h3>
              <p class="text-sm text-text-muted leading-relaxed mb-3">{rp.data.shortDescription}</p>
              <span class="text-sm font-semibold text-accent">{rp.data.price} &euro;</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <CTABand
    title={t('layout.applyKnowledge', locale)}
    subtitle={t('layout.applyKnowledgeSub', locale)}
    ctaText={t('layout.discoverOffers', locale)}
    ctaHref={getTranslatedPath('/angebot', locale)}
    eventName="product_cta_click"
    locale={locale}
    pageType="article"
    pageSlug={article.pageSlug}
  />
</BaseLayout>
