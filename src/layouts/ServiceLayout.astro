---
import BaseLayout from './BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import CalendlyEmbed from '../components/CalendlyEmbed.astro';
import CTABand from '../components/CTABand.astro';
import ClientResults from '../components/ClientResults.astro';
import { siteConfig, type Locale } from '../data/site';
import { generateService, generateBreadcrumbs, generateFAQPage, generateHowTo } from '../data/schema';
import { t, localizePath, getCollectionBasePath } from '../i18n/utils';
import { trackOnClick } from '../lib/analytics';
import { getTestimonials } from '../data/testimonials';

interface Props {
  service: {
    title: string;
    pageSlug: string;
    cluster: string;
    brandFocus: string;
    productType: string;
    primaryCta: string;
    secondaryCta?: string;
    problemRecognition: string;
    failedSolutions: string[];
    mechanism: string;
    method: Array<{ title: string; description: string }>;
    forYouIf: string[];
    notForYouIf: string[];
    faq: Array<{ question: string; answer: string }>;
    pricing?: {
      setup?: string;
      monthly?: string;
      minimumTerm?: string;
      status?: string;
      note?: string;
    };
  };
  locale?: Locale;
}

const { service, locale = 'nl' } = Astro.props;
const servicesBase = getCollectionBasePath('diensten', locale);
const pageUrl = `${servicesBase}/${service.pageSlug}`;

const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: localizePath('/', locale) },
  { label: t('breadcrumb.diensten', locale), href: servicesBase },
  { label: service.title },
];

const breadcrumbSchema = breadcrumbs.map((b) => ({
  name: b.label,
  url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}${pageUrl}`,
}));

const seoTitle = `${service.title} | ${siteConfig.name}`;
const seoDescription = service.problemRecognition.slice(0, 155);

const faqForSchema = service.faq.map((item) => ({
  question: item.question,
  answer: item.answer,
}));

const isAudit = service.cluster === 'ai-vindbaarheid';
const calendlyEventName = isAudit ? 'ai_vindbaarheid_call_booked' : 'expert_growth_calendly_open';

const calendlyTitleMap: Record<string, Record<string, string>> = {
  'ai-vindbaarheid': {
    nl: 'Bespreek je scan-resultaten',
    en: 'Discuss your scan results',
    es: 'Comenta tus resultados del análisis',
  },
  'expert-growth': {
    nl: 'Plan een persoonlijk gesprek',
    en: 'Book a personal call',
    es: 'Reserva una llamada personal',
  },
};
const calendlySubtitleMap: Record<string, Record<string, string>> = {
  'ai-vindbaarheid': {
    nl: 'We lopen samen door je audit en bespreken de logische vervolgstappen — vrijblijvend.',
    en: 'We walk through your audit together and discuss next steps — no obligation.',
    es: 'Revisamos juntos tu auditoría y comentamos los próximos pasos — sin compromiso.',
  },
  'expert-growth': {
    nl: 'Kies een moment dat je uitkomt — vrijblijvend en persoonlijk.',
    en: 'Pick a time that works for you — no obligation, completely personal.',
    es: 'Elige un momento que te convenga — sin compromiso y personal.',
  },
};

const calendlyTitle = calendlyTitleMap[service.cluster]?.[locale] ?? t('calendly.title', locale);
const calendlySubtitle = calendlySubtitleMap[service.cluster]?.[locale] ?? t('calendly.subtitle', locale);

// Client results for Coach Accelerator service page
const isCoachAccelerator = service.cluster === 'expert-growth' && service.productType === 'service';
const testimonials = isCoachAccelerator ? getTestimonials({ locale }) : [];

const clientResultsLabels: Record<string, Record<string, string>> = {
  title: { nl: 'Resultaten van klanten', en: 'Client results', es: 'Resultados de clientes' },
  caseLabel: { nl: 'Lees de case', en: 'Read the case', es: 'Leer el caso' },
  allCasesLabel: { nl: 'Bekijk alle cases', en: 'View all cases', es: 'Ver todos los casos' },
};

const casesBase = locale === 'en' ? '/en/cases/' : locale === 'es' ? '/es/casos/' : '/cases/';
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  schemas={[
    generateService({
      name: service.title,
      description: seoDescription,
      url: `${siteConfig.url}${pageUrl}`,
    }),
    generateBreadcrumbs(breadcrumbSchema),
    ...(faqForSchema.length > 0 ? [generateFAQPage(faqForSchema)] : []),
    ...(service.method.length > 0 ? [generateHowTo({
      name: service.title,
      description: seoDescription,
      steps: service.method,
    })] : []),
  ]}
  locale={locale}
>
  <BreadcrumbNav items={breadcrumbs} />

  <article class="py-12 md:py-16 lg:py-20">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      {/* Hero */}
      <div class="mb-10 md:mb-14">
        <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/10 text-accent rounded-full mb-4">
          {service.productType === 'audit' ? 'Audit' : 'Service'}
        </span>
        <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl text-text mb-4">
          {service.title}
        </h1>
        <p class="text-lg text-text-muted leading-relaxed mb-8">
          {service.problemRecognition}
        </p>
        <a
          href="#calendly"
          class="inline-flex items-center px-6 py-3 text-base font-medium text-text-inverse bg-primary hover:bg-primary-dark transition-colors rounded-button"
          onclick={trackOnClick(calendlyEventName, { page_type: 'service', page_slug: service.pageSlug, locale, cta_location: 'hero', cluster: service.cluster })}
        >
          {service.primaryCta}
          <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      {/* Markdown content */}
      <div class="prose prose-lg max-w-none mb-12">
        <slot />
      </div>
    </div>

    {/* Failed Solutions */}
    {service.failedSolutions.length > 0 && (
      <section class="py-12 md:py-16 bg-bg-alt">
        <div class="max-w-3xl mx-auto px-4 md:px-6">
          <h2 class="font-heading text-2xl md:text-3xl text-text mb-8">
            {t('service.failedSolutions', locale)}
          </h2>
          <ul class="space-y-4">
            {service.failedSolutions.map((item) => (
              <li class="flex items-start gap-3 text-text-muted">
                <svg class="w-5 h-5 text-text-muted/50 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {/* Mechanism */}
    <section class="py-12 md:py-16 bg-bg">
      <div class="max-w-3xl mx-auto px-4 md:px-6">
        <h2 class="font-heading text-2xl md:text-3xl text-text mb-6">
          {t('service.mechanism', locale)}
        </h2>
        <div class="border-l-4 border-accent pl-6 md:pl-8">
          <p class="text-lg text-text leading-relaxed">{service.mechanism}</p>
        </div>
      </div>
    </section>

    {/* Method */}
    {service.method.length > 0 && (
      <section class="py-12 md:py-16 bg-bg-alt">
        <div class="max-w-3xl mx-auto px-4 md:px-6">
          <h2 class="font-heading text-2xl md:text-3xl text-text mb-8">
            {t('service.method', locale)}
          </h2>
          <div class="space-y-8">
            {service.method.map((step, idx) => (
              <div class="flex items-start gap-5">
                <div class="w-10 h-10 rounded-full bg-accent-light flex items-center justify-center shrink-0">
                  <span class="text-sm font-semibold text-accent">{idx + 1}</span>
                </div>
                <div>
                  <h3 class="font-medium text-text mb-2">{step.title}</h3>
                  <p class="text-sm text-text-muted leading-relaxed">{step.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {/* For You / Not For You */}
    <section class="py-12 md:py-16 bg-bg">
      <div class="max-w-3xl mx-auto px-4 md:px-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {service.forYouIf.length > 0 && (
            <div>
              <h2 class="font-heading text-xl md:text-2xl text-text mb-6 flex items-center gap-2">
                <svg class="w-6 h-6 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                {t('service.forYouIf', locale)}
              </h2>
              <ul class="space-y-3">
                {service.forYouIf.map((item) => (
                  <li class="flex items-start gap-3 text-text-muted">
                    <svg class="w-5 h-5 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                    </svg>
                    <span class="text-sm leading-relaxed">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
          {service.notForYouIf.length > 0 && (
            <div>
              <h2 class="font-heading text-xl md:text-2xl text-text mb-6 flex items-center gap-2">
                <svg class="w-6 h-6 text-text-muted shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                </svg>
                {t('service.notForYouIf', locale)}
              </h2>
              <ul class="space-y-3">
                {service.notForYouIf.map((item) => (
                  <li class="flex items-start gap-3 text-text-muted">
                    <svg class="w-5 h-5 text-text-muted/50 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                    <span class="text-sm leading-relaxed">{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>
      </div>
    </section>
  </article>

  {/* Client Results (Coach Accelerator only) */}
  {isCoachAccelerator && testimonials.length > 0 && (
    <ClientResults
      title={clientResultsLabels.title[locale] ?? 'Client results'}
      featuredCases={[
        {
          testimonial: testimonials.find((t) => t.id === 'rolf-happywithyoga')!,
          period: locale === 'es' ? 'Desde 2022' : locale === 'en' ? 'Since 2022' : 'Sinds 2022',
          stats: [
            { value: '30.000+', label: locale === 'es' ? 'leads de webinar' : locale === 'en' ? 'webinar leads' : 'webinarleads' },
            { value: '1.700+', label: locale === 'es' ? 'ventas de mini-curso' : locale === 'en' ? 'mini-course sales' : 'mini-cursus verkopen' },
            { value: '2.000', label: locale === 'es' ? 'miembros de pago' : locale === 'en' ? 'paying members' : 'betalende leden' },
          ],
          caseHref: `${casesBase}happy-with-yoga/`,
        },
        {
          testimonial: testimonials.find((t) => t.id === 'tessa-youlife')!,
          period: locale === 'es' ? 'Desde feb 2025' : locale === 'en' ? 'Since Feb 2025' : 'Sinds feb 2025',
          stats: [
            { value: '~€10k/' + (locale === 'es' ? 'mes' : locale === 'en' ? 'mo' : 'mnd'), label: locale === 'es' ? 'productos online' : locale === 'en' ? 'online products' : 'online producten' },
            { value: '6', label: locale === 'es' ? 'productos lanzados' : locale === 'en' ? 'products launched' : 'producten gelanceerd' },
            { value: '~10/' + (locale === 'es' ? 'mes' : locale === 'en' ? 'mo' : 'mnd'), label: locale === 'es' ? 'clientes de coaching' : locale === 'en' ? 'coaching clients' : 'coachingklanten' },
          ],
          caseHref: `${casesBase}youlife/`,
        },
        {
          testimonial: testimonials.find((t) => t.id === 'josine-coachjosine')!,
          period: locale === 'es' ? 'Desde oct 2025' : locale === 'en' ? 'Since Oct 2025' : 'Sinds okt 2025',
          stats: [
            { value: '600×', label: locale === 'es' ? 'guía vendida' : locale === 'en' ? 'guide sold' : 'gids verkocht' },
            { value: '80', label: locale === 'es' ? 'inscripciones masterclass' : locale === 'en' ? 'masterclass signups' : 'masterclass-aanmeldingen' },
          ],
          caseHref: `${casesBase}coach-josine/`,
        },
      ].filter((c) => c.testimonial)}
      smallResults={[
        {
          name: 'Manon van Bakel',
          period: locale === 'es' ? 'Primer mes' : locale === 'en' ? 'First month' : 'Eerste maand',
          stats: [
            { value: '120', label: locale === 'es' ? 'inscripciones en 2 semanas' : locale === 'en' ? 'signups in 2 weeks' : 'aanmeldingen in 2 weken' },
            { value: '~10%', label: locale === 'es' ? 'conversión a programas' : locale === 'en' ? 'conversion to programmes' : 'conversie naar trajecten' },
          ],
        },
        {
          name: 'Kim Bongers',
          period: locale === 'es' ? '2 meses' : locale === 'en' ? '2 months' : '2 maanden',
          stats: [
            { value: '90', label: locale === 'es' ? 'inscripciones masterclass' : locale === 'en' ? 'masterclass signups' : 'masterclass-aanmeldingen' },
            { value: '350×', label: locale === 'es' ? 'guía vendida' : locale === 'en' ? 'guide sold' : 'gids verkocht' },
            { value: '8%', label: locale === 'es' ? 'conversión' : locale === 'en' ? 'conversion' : 'conversie' },
          ],
        },
        {
          name: 'MCM Research',
          logo: 'mcm-research-logo.webp',
          period: locale === 'es' ? 'Cliente desde 2022' : locale === 'en' ? 'Client since 2022' : 'Klant sinds 2022',
          stats: [
            { value: '2.500+', label: locale === 'es' ? 'leads en Países Bajos' : locale === 'en' ? 'leads in Netherlands' : 'leads in Nederland' },
            { value: '500', label: locale === 'es' ? 'candidatos NL' : locale === 'en' ? 'applicants NL' : 'sollicitanten NL' },
            { value: '1.500+', label: locale === 'es' ? 'leads en Bélgica' : locale === 'en' ? 'leads in Belgium' : 'leads in België' },
            { value: '250', label: locale === 'es' ? 'candidatos BE' : locale === 'en' ? 'applicants BE' : 'sollicitanten BE' },
          ],
        },
      ]}
      otherTestimonials={testimonials.filter((t) => ['claire-ikrouwvanje', 'andrew-coreprogression'].includes(t.id))}
      caseLabel={clientResultsLabels.caseLabel[locale] ?? 'Read the case'}
      allCasesHref={casesBase}
      allCasesLabel={clientResultsLabels.allCasesLabel[locale] ?? 'View all cases'}
      locale={locale}
    />
  )}

  {/* FAQ */}
  {service.faq.length > 0 && (
    <FAQAccordion
      items={service.faq.map((f) => ({ q: f.question, a: f.answer }))}
      locale={locale}
      pageType="service"
      pageSlug={service.pageSlug}
    />
  )}

  {/* Calendly */}
  <div id="calendly">
    <CalendlyEmbed
      pageType="service"
      pageSlug={service.pageSlug}
      locale={locale}
      title={calendlyTitle}
      subtitle={calendlySubtitle}
    />
  </div>

  <CTABand
    title={service.primaryCta}
    subtitle={calendlySubtitle}
    ctaText={t('cta.bookCall', locale)}
    ctaHref="#calendly"
    eventName={calendlyEventName}
    locale={locale}
    pageType="service"
    pageSlug={service.pageSlug}
  />
</BaseLayout>
