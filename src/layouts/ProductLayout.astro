---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import CTABand from '../components/CTABand.astro';
import { siteConfig } from '../data/site';
import { generateProduct, generateBreadcrumbs, generateFAQPage } from '../data/schema';
import { t } from '../i18n/utils';
import { trackOnClick } from '../lib/analytics';

interface Props {
  product: {
    title: string;
    pageSlug: string;
    price: string;
    currency: string;
    plugAndPayUrl: string;
    heroImage?: ImageMetadata;
    shortDescription: string;
    longDescription: string;
    includes: Array<{ title: string; description: string; icon?: string }>;
    targetAudience: string[];
    faq: Array<{ q: string; a: string }>;
    seo: { title: string; description: string };
  };
}

const { product } = Astro.props;
const pageUrl = `/produkte/${product.pageSlug}`;

const breadcrumbs = [
  { label: t('breadcrumb.home'), href: '/' },
  { label: t('breadcrumb.angebot'), href: '/angebot' },
  { label: t('breadcrumb.produkte'), href: '/produkte' },
  { label: product.title },
];

const breadcrumbSchema = breadcrumbs.map((b) => ({
  name: b.label,
  url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}${pageUrl}`,
}));
---

<BaseLayout
  title={product.seo.title}
  description={product.seo.description}
  schemas={[
    generateProduct({
      name: product.title,
      description: product.shortDescription,
      url: `${siteConfig.url}${pageUrl}`,
      price: product.price,
      currency: product.currency,
    }),
    generateBreadcrumbs(breadcrumbSchema),
    ...(product.faq.length > 0 ? [generateFAQPage(product.faq)] : []),
  ]}
  locale="de"
>
  <BreadcrumbNav items={breadcrumbs} />

  {product.heroImage && (
    <div class="w-full bg-bg-alt">
      <div class="max-w-5xl mx-auto">
        <Image
          src={product.heroImage}
          alt={`${product.title} — digitales Produkt von doc.veri`}
          width={1200}
          height={750}
          class="w-full h-auto"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  )}

  <article class="py-12 md:py-16 lg:py-20">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <div class="mb-10 md:mb-14">
        <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl text-text mb-4">
          {product.title}
        </h1>
        <p class="text-lg text-text-muted leading-relaxed mb-6">
          {product.shortDescription}
        </p>
        <div class="flex items-center gap-6">
          <span class="text-3xl font-heading font-bold text-text">{product.price} €</span>
          <a
            href={product.plugAndPayUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center px-6 py-3 text-base font-medium text-text-inverse bg-primary hover:bg-primary-dark transition-colors rounded-button"
            onclick={trackOnClick('product_cta_click', { page_type: 'product', page_slug: product.pageSlug, locale: 'de', cta_location: 'inline' })}
          >
            {t('cta.buyNow')}
            <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
            </svg>
          </a>
        </div>
      </div>

      <div class="prose prose-lg max-w-none prose-headings:font-heading prose-headings:text-text prose-p:text-text-muted prose-p:leading-relaxed mb-12">
        <p>{product.longDescription}</p>
      </div>

      <div class="prose prose-lg max-w-none prose-headings:font-heading prose-headings:text-text prose-p:text-text-muted prose-p:leading-relaxed mb-12">
        <slot />
      </div>
    </div>

    {product.includes.length > 0 && (
      <section class="py-12 md:py-16 bg-bg-alt">
        <div class="max-w-3xl mx-auto px-4 md:px-6">
          <h2 class="font-heading text-2xl md:text-3xl text-text mb-8">
            {t('product.whatIsInside')}
          </h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {product.includes.map((item) => (
              <div class="bg-white rounded-card p-6 border border-border">
                <h3 class="font-medium text-text mb-2">{item.title}</h3>
                <p class="text-sm text-text-muted">{item.description}</p>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {product.targetAudience.length > 0 && (
      <section class="py-12 md:py-16 bg-bg">
        <div class="max-w-3xl mx-auto px-4 md:px-6">
          <h2 class="font-heading text-2xl md:text-3xl text-text mb-8">
            {t('product.whoIsThisFor')}
          </h2>
          <ul class="space-y-4">
            {product.targetAudience.map((audience) => (
              <li class="flex items-start gap-3 text-text-muted">
                <svg class="w-5 h-5 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                {audience}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}
  </article>

  {product.faq.length > 0 && (
    <FAQAccordion
      items={product.faq}
      locale="de"
      pageType="product"
      pageSlug={product.pageSlug}
    />
  )}

  <div class="py-8 bg-bg">
    <div class="max-w-3xl mx-auto px-4 md:px-6 text-center">
      <a
        href={product.plugAndPayUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center px-8 py-4 text-base font-medium text-text-inverse bg-primary hover:bg-primary-dark transition-colors rounded-button shadow-lg"
        onclick={trackOnClick('product_cta_click', { page_type: 'product', page_slug: product.pageSlug, locale: 'de', cta_location: 'product_bottom' })}
      >
        {t('cta.buyNow')} — {product.price} €
        <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
        </svg>
      </a>
    </div>
  </div>

  <CTABand
    title="Fragen zum Produkt?"
    subtitle="Schreib mir — ich helfe dir gerne weiter."
    ctaText="Kontakt aufnehmen"
    ctaHref="/kontakt"
    eventName="discovery_call_click"
    locale="de"
    pageType="product"
    pageSlug={product.pageSlug}
  />
</BaseLayout>
