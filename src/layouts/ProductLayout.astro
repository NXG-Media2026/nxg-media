---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import TestimonialSlider from '../components/TestimonialSlider.astro';
import CTABand from '../components/CTABand.astro';
import { siteConfig } from '../data/site';
import { generateProduct, generateBreadcrumbs, generateFAQPage } from '../data/schema';
import { getProductTestimonials } from '../data/testimonials';
import type { Testimonial } from '../data/testimonials';
import { t, localizePath, getTranslatedPath, getCollectionBasePath } from '../i18n/utils';
import { getHreflangForContent } from '../i18n/hreflang';
import { trackOnClick } from '../lib/analytics';
import type { Locale } from '../data/site';

interface Props {
  product: {
    title: string;
    pageSlug: string;
    price: string;
    currency: string;
    plugAndPayUrl: string;
    heroImage?: ImageMetadata;
    shortDescription: string;
    longDescription: string;
    includes: Array<{ title: string; description: string; icon?: string }>;
    targetAudience: string[];
    faq: Array<{ q: string; a: string }>;
    relatedProductSlugs?: string[];
    translationKey?: string;
    seo: { title: string; description: string };
  };
  locale?: Locale;
}

const { product, locale = 'de' } = Astro.props;
const productsBase = getCollectionBasePath('produkte', locale);
const pageUrl = `${productsBase}/${product.pageSlug}`;
const ogImage = `/images/og/products/${product.pageSlug}.png`;

const productTestimonials: Testimonial[] = getProductTestimonials(product.pageSlug, 4, locale);

const allProducts = await getCollection('produkte');
const sameLocaleProducts = allProducts.filter((p) => !p.data.locale || p.data.locale === locale);
const relatedProducts = (product.relatedProductSlugs ?? [])
  .map((slug) => sameLocaleProducts.find((p) => p.data.pageSlug === slug))
  .filter((p): p is NonNullable<typeof p> => p != null);

const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: localizePath('/', locale) },
  { label: t('breadcrumb.angebot', locale), href: getTranslatedPath('/angebot', locale) },
  { label: t('breadcrumb.produkte', locale), href: productsBase },
  { label: product.title },
];

const breadcrumbSchema = breadcrumbs.map((b) => ({
  name: b.label,
  url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}${pageUrl}`,
}));

const hreflang = await getHreflangForContent(product.translationKey, 'produkte', 'produkte');
---

<BaseLayout
  title={product.seo.title}
  description={product.seo.description}
  ogImage={ogImage}
  ogType="product"
  hreflang={hreflang}
  schemas={[
    generateProduct({
      name: product.title,
      description: product.shortDescription,
      url: `${siteConfig.url}${pageUrl}`,
      price: product.price,
      currency: product.currency,
      reviews: productTestimonials,
    }),
    generateBreadcrumbs(breadcrumbSchema),
    ...(product.faq.length > 0 ? [generateFAQPage(product.faq)] : []),
  ]}
  locale={locale}
>
  <BreadcrumbNav items={breadcrumbs} />

  {product.heroImage && (
    <div class="w-full bg-bg-alt">
      <div class="max-w-5xl mx-auto">
        <Image
          src={product.heroImage}
          alt={`${product.title} — ${t('product.digitalProductAlt', locale)}`}
          width={1200}
          height={750}
          class="w-full h-auto"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  )}

  <!-- Hero header -->
  <header class="py-12 md:py-16 lg:py-20 bg-bg">
    <div class="max-w-3xl mx-auto px-4 md:px-6 text-center">
      <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl text-text mb-4 leading-tight">
        {product.title}
      </h1>
      <p class="text-lg md:text-xl text-text-muted leading-relaxed mb-8 max-w-2xl mx-auto">
        {product.shortDescription}
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6">
        <span class="text-3xl md:text-4xl font-heading font-bold text-text">{product.price} &euro;</span>
        <a
          href={product.plugAndPayUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center px-8 py-4 text-base font-medium text-text-inverse bg-primary hover:bg-primary-dark transition-colors rounded-button shadow-lg"
          onclick={trackOnClick('product_cta_click', { page_type: 'product', page_slug: product.pageSlug, locale, cta_location: 'hero' })}
        >
          {t('cta.buyNow', locale)}
          <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
        </a>
      </div>
    </div>
  </header>

  <!-- Long description highlight -->
  <section class="py-10 md:py-14 bg-bg-alt">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <div class="border-l-4 border-accent pl-6 md:pl-8">
        <p class="text-lg md:text-xl text-text leading-relaxed italic">
          {product.longDescription}
        </p>
      </div>
    </div>
  </section>

  <!-- Markdown content: well-formatted prose -->
  <article class="py-12 md:py-16 bg-bg">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <div class="prose prose-lg prose-product max-w-none">
        <slot />
      </div>
    </div>
  </article>

  <!-- What's included -->
  {product.includes.length > 0 && (
    <section class="py-12 md:py-16 bg-bg-alt">
      <div class="max-w-3xl mx-auto px-4 md:px-6">
        <h2 class="font-heading text-2xl md:text-3xl text-text mb-8 text-center">
          {t('product.whatIsInside', locale)}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {product.includes.map((item) => (
            <div class="bg-white rounded-card p-6 border border-border shadow-sm hover:shadow-md transition-shadow">
              <h3 class="font-heading font-medium text-text mb-2">{item.title}</h3>
              <p class="text-sm text-text-muted leading-relaxed">{item.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Target audience -->
  {product.targetAudience.length > 0 && (
    <section class="py-12 md:py-16 bg-bg">
      <div class="max-w-3xl mx-auto px-4 md:px-6">
        <h2 class="font-heading text-2xl md:text-3xl text-text mb-8 text-center">
          {t('product.whoIsThisFor', locale)}
        </h2>
        <ul class="space-y-4 max-w-2xl mx-auto">
          {product.targetAudience.map((audience) => (
            <li class="flex items-start gap-3 text-text-muted">
              <svg class="w-6 h-6 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span class="text-base leading-relaxed">{audience}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Related products (internal linking) -->
  {relatedProducts.length > 0 && (
    <section class="py-12 md:py-16 bg-bg-alt">
      <div class="max-w-3xl mx-auto px-4 md:px-6">
        <h2 class="font-heading text-2xl md:text-3xl text-text mb-8 text-center">
          {t('product.youMayAlsoLike', locale)}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {relatedProducts.map((rp) => (
            <a
              href={`${productsBase}/${rp.data.pageSlug}`}
              class="block bg-white rounded-card p-6 border border-border shadow-sm hover:shadow-md hover:border-accent/30 transition-all group"
            >
              <h3 class="font-heading font-medium text-text group-hover:text-accent transition-colors mb-2">
                {rp.data.title}
              </h3>
              <p class="text-sm text-text-muted leading-relaxed mb-3">{rp.data.shortDescription}</p>
              <span class="text-sm font-semibold text-accent">{rp.data.price} &euro;</span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Reviews / testimonials -->
  {productTestimonials.length > 0 && (
    <TestimonialSlider
      title={t('testimonial.heading', locale)}
      testimonials={productTestimonials.map(t => ({
        name: t.name,
        text: t.text,
        rating: t.rating,
        outcome: t.outcome,
      }))}
      locale={locale}
    />
  )}

  <!-- FAQ -->
  {product.faq.length > 0 && (
    <FAQAccordion
      items={product.faq}
      locale={locale}
      pageType="product"
      pageSlug={product.pageSlug}
    />
  )}

  <!-- Bottom CTA -->
  <div class="py-12 md:py-16 bg-bg">
    <div class="max-w-3xl mx-auto px-4 md:px-6 text-center">
      <p class="text-text-muted mb-6 text-lg">{t('product.readyToStart', locale)}</p>
      <a
        href={product.plugAndPayUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center px-10 py-4 text-lg font-medium text-text-inverse bg-primary hover:bg-primary-dark transition-colors rounded-button shadow-lg"
        onclick={trackOnClick('product_cta_click', { page_type: 'product', page_slug: product.pageSlug, locale, cta_location: 'product_bottom' })}
      >
        {t('cta.buyNow', locale)} — {product.price} &euro;
        <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
        </svg>
      </a>
    </div>
  </div>

  <CTABand
    title={t('product.questionsAbout', locale)}
    subtitle={t('product.getInTouch', locale)}
    ctaText={t('nav.contact', locale)}
    ctaHref={getTranslatedPath('/kontakt', locale)}
    eventName="discovery_call_click"
    locale={locale}
    pageType="product"
    pageSlug={product.pageSlug}
  />
</BaseLayout>
