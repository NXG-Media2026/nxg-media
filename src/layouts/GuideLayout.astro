---
import BaseLayout from './BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import AuthorByline from '../components/AuthorByline.astro';
import CTABand from '../components/CTABand.astro';
import { siteConfig, type Locale } from '../data/site';
import { generateArticle, generateBreadcrumbs } from '../data/schema';
import { t, localizePath, getCollectionBasePath } from '../i18n/utils';

interface Props {
  guide: {
    title: string;
    pageSlug: string;
    cluster?: string;
    publishedAt: string;
    authorId: string;
    contentSchema: {
      primaryQuestion: string;
      primaryAnswer: string;
    };
  };
  locale?: Locale;
}

const { guide, locale = 'nl' } = Astro.props;
const guidesBase = getCollectionBasePath('guides', locale);
const pageUrl = `${guidesBase}/${guide.pageSlug}`;

const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: localizePath('/', locale) },
  { label: t('breadcrumb.guides', locale), href: guidesBase },
  { label: guide.title },
];

const breadcrumbSchema = breadcrumbs.map((b) => ({
  name: b.label,
  url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}${pageUrl}`,
}));

const seoTitle = `${guide.title} | ${siteConfig.name}`;
const seoDescription = guide.contentSchema.primaryAnswer.slice(0, 155);

const clusterCtaMap: Record<string, { text: string; href: string }> = {
  'expert-growth': {
    text: locale === 'en' ? 'Explore Expert Growth' : 'Bekijk Expert Growth',
    href: locale === 'en' ? '/en/expert-growth-accelerator/' : '/expert-growth-accelerator/',
  },
  'ai-vindbaarheid': {
    text: locale === 'en' ? 'Run the AI visibility scan' : 'Doe de AI-vindbaarheidsscan',
    href: locale === 'en' ? '/en/ai-visibility/' : '/ai-vindbaarheid/',
  },
};

const cta = guide.cluster ? (clusterCtaMap[guide.cluster] ?? null) : null;
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  ogType="article"
  schemas={[
    generateArticle({
      title: guide.title,
      description: seoDescription,
      url: `${siteConfig.url}${pageUrl}`,
      datePublished: guide.publishedAt,
    }, locale),
    generateBreadcrumbs(breadcrumbSchema),
  ]}
  locale={locale}
>
  <BreadcrumbNav items={breadcrumbs} />

  <article class="py-12 md:py-16 lg:py-20">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <div class="mb-10">
        {guide.cluster && (
          <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/10 text-accent rounded-full mb-4">
            {guide.cluster}
          </span>
        )}
        <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl text-text mb-6">
          {guide.title}
        </h1>
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-text-muted">
          <span>{t('guide.by', locale)} {siteConfig.founder.name}</span>
          <span aria-hidden="true">&middot;</span>
          <time datetime={guide.publishedAt}>{guide.publishedAt}</time>
        </div>
      </div>

      <AuthorByline
        authorName={siteConfig.founder.name}
        authorSlug={siteConfig.founder.slug}
        publishedDate={guide.publishedAt}
        locale={locale}
      />

      <div class="prose prose-lg max-w-none mb-12">
        <slot />
      </div>
    </div>
  </article>

  {cta && (
    <CTABand
      title={cta.text}
      subtitle={t('calendly.subtitle', locale)}
      ctaText={cta.text}
      ctaHref={cta.href}
      eventName="cross_cluster_link_click"
      locale={locale}
      pageType="guide"
      pageSlug={guide.pageSlug}
    />
  )}
</BaseLayout>
