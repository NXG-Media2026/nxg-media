---
import BaseLayout from './BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import CalendlyEmbed from '../components/CalendlyEmbed.astro';
import CTABand from '../components/CTABand.astro';
import { siteConfig, type Locale } from '../data/site';
import { generateService, generateBreadcrumbs, generateFAQPage } from '../data/schema';
import { t, localizePath, getTranslatedPath, getCollectionBasePath } from '../i18n/utils';
import { getHreflangForContent } from '../i18n/hreflang';
import { trackOnClick } from '../lib/analytics';

interface Props {
  coaching: {
    title: string;
    pageSlug: string;
    format: string;
    duration: string;
    heroImage?: { src: string } | string;
    shortDescription: string;
    outcomes: string[];
    methodology: Array<{ title: string; description: string }>;
    includes: string[];
    faq: Array<{ q: string; a: string }>;
    ctaUrl: string;
    translationKey?: string;
    seo: { title: string; description: string };
  };
  locale?: Locale;
}

const { coaching, locale = 'de' } = Astro.props;
const coachingBase = getCollectionBasePath('coaching', locale);
const pageUrl = `${coachingBase}/${coaching.pageSlug}`;

const formatLabels: Record<string, Record<string, string>> = {
  de: { '1-on-1': '1:1', 'group': 'Gruppe', 'hybrid': 'Hybrid' },
  en: { '1-on-1': '1:1', 'group': 'Group', 'hybrid': 'Hybrid' },
};

const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: localizePath('/', locale) },
  { label: t('breadcrumb.angebot', locale), href: getTranslatedPath('/angebot', locale) },
  { label: t('breadcrumb.coaching', locale), href: coachingBase },
  { label: coaching.title },
];

const breadcrumbSchema = breadcrumbs.map((b) => ({
  name: b.label,
  url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}${pageUrl}`,
}));

const hreflang = await getHreflangForContent(coaching.translationKey, 'coaching', 'coaching');
---

<BaseLayout
  title={coaching.seo.title}
  description={coaching.seo.description}
  hreflang={hreflang}
  schemas={[
    generateService({
      name: coaching.title,
      description: coaching.shortDescription,
      url: `${siteConfig.url}${pageUrl}`,
    }),
    generateBreadcrumbs(breadcrumbSchema),
    ...(coaching.faq.length > 0 ? [generateFAQPage(coaching.faq)] : []),
  ]}
  locale={locale}
>
  <BreadcrumbNav items={breadcrumbs} />

  <article class="py-12 md:py-16 lg:py-20">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <div class="mb-10 md:mb-14">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/10 text-accent rounded-full">
            {(formatLabels[locale] ?? formatLabels.de)[coaching.format] ?? coaching.format}
          </span>
          <span class="text-sm text-text-muted">{coaching.duration}</span>
        </div>
        <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl text-text mb-4">
          {coaching.title}
        </h1>
        <p class="text-lg text-text-muted leading-relaxed mb-8">
          {coaching.shortDescription}
        </p>
        <a
          href={coaching.ctaUrl}
          class="inline-flex items-center px-6 py-3 text-base font-medium text-text-inverse bg-primary hover:bg-primary-dark transition-colors rounded-button"
          onclick={trackOnClick('coaching_cta_click', { page_type: 'coaching', page_slug: coaching.pageSlug, locale, cta_location: 'inline' })}
        >
          {t('cta.bookCall', locale)}
          <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

      <div class="prose prose-lg max-w-none mb-12">
        <slot />
      </div>
    </div>

    {coaching.outcomes.length > 0 && (
      <section class="py-12 md:py-16 bg-bg-alt">
        <div class="max-w-3xl mx-auto px-4 md:px-6">
          <h2 class="font-heading text-2xl md:text-3xl text-text mb-8">
            {t('coaching.outcomes', locale)}
          </h2>
          <ul class="space-y-4">
            {coaching.outcomes.map((outcome) => (
              <li class="flex items-start gap-3 text-text-muted">
                <svg class="w-5 h-5 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                {outcome}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {coaching.methodology.length > 0 && (
      <section class="py-12 md:py-16 bg-bg">
        <div class="max-w-3xl mx-auto px-4 md:px-6">
          <h2 class="font-heading text-2xl md:text-3xl text-text mb-8">
            {t('coaching.methodology', locale)}
          </h2>
          <div class="space-y-8">
            {coaching.methodology.map((step, idx) => (
              <div class="flex items-start gap-5">
                <div class="w-10 h-10 rounded-full bg-accent-light flex items-center justify-center shrink-0">
                  <span class="text-sm font-semibold text-accent">{idx + 1}</span>
                </div>
                <div>
                  <h3 class="font-medium text-text mb-2">{step.title}</h3>
                  <p class="text-sm text-text-muted leading-relaxed">{step.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    {coaching.includes.length > 0 && (
      <section class="py-12 md:py-16 bg-bg-alt">
        <div class="max-w-3xl mx-auto px-4 md:px-6">
          <h2 class="font-heading text-2xl md:text-3xl text-text mb-8">
            {t('coaching.includes', locale)}
          </h2>
          <ul class="space-y-3">
            {coaching.includes.map((item) => (
              <li class="flex items-start gap-3 text-text-muted">
                <svg class="w-5 h-5 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}
  </article>

  {coaching.faq.length > 0 && (
    <FAQAccordion
      items={coaching.faq}
      locale={locale}
      pageType="coaching"
      pageSlug={coaching.pageSlug}
    />
  )}

  <CalendlyEmbed
    pageType="coaching"
    pageSlug={coaching.pageSlug}
  />

  <CTABand
    title={t('coaching.readyForNext', locale)}
    subtitle={t('coaching.bookFreeSub', locale)}
    ctaText={t('coaching.bookFreeBtn', locale)}
    ctaHref={coaching.ctaUrl}
    eventName="coaching_cta_click"
    locale={locale}
    pageType="coaching"
    pageSlug={coaching.pageSlug}
  />
</BaseLayout>
