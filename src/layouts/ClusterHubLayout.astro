---
import BaseLayout from './BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import CTABand from '../components/CTABand.astro';
import { siteConfig, type Locale } from '../data/site';
import { generateBreadcrumbs, generateFAQPage } from '../data/schema';
import { t, localizePath, getCollectionBasePath } from '../i18n/utils';

import type { ClusterConfig } from '../lib/clusters';
import {
  getClusterCitableDefinition,
  getClusterHubIntro,
  getClusterFaqLocalized,
  getClusterCases,
  getClusterGuides,
  getClusterBridges,
  getCluster,
} from '../lib/clusters';

interface Props {
  cluster: ClusterConfig;
  locale?: Locale;
}

const { cluster, locale = 'nl' } = Astro.props;
const casesBase = getCollectionBasePath('cases', locale);
const guidesBase = getCollectionBasePath('guides', locale);

const citableDefinition = getClusterCitableDefinition(cluster, locale);
const hubIntro = getClusterHubIntro(cluster, locale);
const faqItems = getClusterFaqLocalized(cluster, locale);
const cases = await getClusterCases(cluster.slug, locale);
const guides = await getClusterGuides(cluster.slug, locale);
const bridges = getClusterBridges(cluster.slug, 'hub');

const resolvedBridges = bridges.map((bridge) => {
  const targetCluster = getCluster(bridge.cluster);
  const bridgeText = bridge.bridgeText[locale] ?? bridge.bridgeText.nl ?? '';
  return { ...bridge, bridgeText: bridgeText, href: targetCluster ? `/${targetCluster.hubSlug}/` : null };
});

const faqForComponent = faqItems.map((item) => ({
  q: item.question,
  a: item.answer,
}));

const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: localizePath('/', locale) },
  { label: cluster.shortTitle || cluster.title },
];

const breadcrumbSchema = breadcrumbs.map((b) => ({
  name: b.label,
  url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}/${cluster.hubSlug}/`,
}));

const seoTitle = `${cluster.title} | ${siteConfig.name}`;
const seoDescription = citableDefinition.trim().slice(0, 155);
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  schemas={[
    generateBreadcrumbs(breadcrumbSchema),
    ...(faqItems.length > 0 ? [generateFAQPage(faqItems)] : []),
  ]}
  locale={locale}
>
  <BreadcrumbNav items={breadcrumbs} />

  {/* Hero / Citable Definition */}
  <section class="py-12 md:py-16 lg:py-20">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl text-text mb-6">
        {cluster.title}
      </h1>
      <p class="text-lg text-text-muted leading-relaxed mb-8">
        {citableDefinition}
      </p>
    </div>
  </section>

  {/* Hub Intro */}
  {hubIntro && hubIntro.trim() !== '' && (
    <section class="py-12 md:py-16 bg-bg-alt">
      <div class="max-w-3xl mx-auto px-4 md:px-6">
        <div class="prose prose-lg max-w-none">
          <p set:html={hubIntro} />
        </div>
      </div>
    </section>
  )}

  {/* Featured Cases */}
  {cases.length > 0 && (
    <section class="py-12 md:py-16 lg:py-20">
      <div class="max-w-4xl mx-auto px-4 md:px-6">
        <h2 class="font-heading text-2xl md:text-3xl text-text mb-8 md:mb-12">
          {t('proof.heading', locale)}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
          {cases.map((caseItem, idx) => (
            <a
              href={`${casesBase}/${caseItem.data.pageSlug}`}
              class:list={[
                'group block bg-white border border-border rounded-card overflow-hidden',
                'hover:border-accent/30 hover:shadow-lg transition-all duration-300',
                'js-reveal',
              ]}
              style={`--reveal-delay: ${idx * 100}ms`}
            >
              <div class="p-6">
                <span class="text-xs font-medium text-accent uppercase tracking-wider mb-2 block">
                  {caseItem.data.clientType}
                </span>
                <h3 class="font-heading text-lg md:text-xl text-text mb-2 group-hover:text-accent transition-colors">
                  {caseItem.data.title}
                </h3>
                {caseItem.data.proofStats.length > 0 && (
                  <div class="flex flex-wrap gap-3 mt-4">
                    {caseItem.data.proofStats.slice(0, 3).map((stat) => (
                      <span class="inline-flex items-center px-3 py-1 text-xs bg-bg-alt rounded-full">
                        <strong class="text-accent mr-1">{stat.value}</strong> {stat.label}
                      </span>
                    ))}
                  </div>
                )}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* Featured Guides */}
  {guides.length > 0 && (
    <section class="py-12 md:py-16 bg-bg-alt">
      <div class="max-w-4xl mx-auto px-4 md:px-6">
        <h2 class="font-heading text-2xl md:text-3xl text-text mb-8">
          {t('cluster.guidesAbout', locale)} {cluster.shortTitle}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {guides.map((guide) => (
            <a
              href={`${guidesBase}/${guide.data.pageSlug}`}
              class="group block bg-white border border-border rounded-card p-5 hover:border-accent/30 hover:shadow-lg transition-all duration-300"
            >
              <h3 class="font-heading text-base md:text-lg text-text mb-2 group-hover:text-accent transition-colors">
                {guide.data.title}
              </h3>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* Cross-Cluster Bridges */}
  {resolvedBridges.length > 0 && (
    <section class="py-12 md:py-16">
      <div class="max-w-3xl mx-auto px-4 md:px-6">
        <h2 class="font-heading text-2xl md:text-3xl text-text mb-8">
          {t('cluster.relatedTopics', locale)}
        </h2>
        <div class="space-y-4">
          {resolvedBridges.map((bridge) => {
            const inner = (
              <div class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-full bg-accent/10 flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                  </svg>
                </div>
                <div>
                  <h3 class="font-medium text-text mb-1 capitalize">{bridge.cluster}</h3>
                  <p class="text-sm text-text-muted leading-relaxed">{bridge.bridgeText}</p>
                </div>
              </div>
            );

            return bridge.href ? (
              <a href={bridge.href} class="block bg-white border border-border rounded-card p-6 js-reveal hover:border-accent/30 hover:shadow-lg transition-all duration-300">
                {inner}
              </a>
            ) : (
              <div class="bg-white border border-border rounded-card p-6 js-reveal">{inner}</div>
            );
          })}
        </div>
      </div>
    </section>
  )}

  {/* FAQ */}
  {faqForComponent.length > 0 && (
    <FAQAccordion
      items={faqForComponent}
      locale={locale}
      pageType="cluster_hub"
      pageSlug={cluster.hubSlug}
    />
  )}

  {/* Slot for additional page-specific content */}
  <slot />
</BaseLayout>
