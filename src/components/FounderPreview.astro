---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { siteConfig } from '../data/site';
import type { Locale } from '../data/site';

interface Props {
  locale?: Locale;
  image?: ImageMetadata;
}

const { locale = 'de', image } = Astro.props;
const { founder } = siteConfig;
const initials = founder.name.split(' ').map(w => w[0]).join('').slice(0, 2);
---

<section class="py-16 md:py-24 lg:py-32 bg-bg">
  <div class="max-w-4xl mx-auto px-4 md:px-6">
    <div class="grid grid-cols-1 md:grid-cols-5 gap-10 md:gap-12 items-center">

      <div class="md:col-span-2 flex justify-center js-reveal">
        {image ? (
          <Image
            src={image}
            alt={`Porträt von ${founder.name} — ${founder.role}`}
            width={320}
            height={320}
            class="w-48 h-48 md:w-64 md:h-64 rounded-full object-cover shadow-lg"
            loading="lazy"
            decoding="async"
          />
        ) : founder.image ? (
          <img
            src={founder.image}
            alt={`Porträt von ${founder.name} — ${founder.role}`}
            width="320"
            height="320"
            class="w-48 h-48 md:w-64 md:h-64 rounded-full object-cover shadow-lg"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <div class="w-48 h-48 md:w-64 md:h-64 rounded-full bg-accent-light flex items-center justify-center shadow-lg">
            <span class="text-5xl md:text-6xl font-heading text-accent">{initials}</span>
          </div>
        )}
      </div>

      <div class="md:col-span-3 js-reveal" style="--reveal-delay: 150ms">
        <div class="w-12 h-1 bg-accent rounded-full mb-6"></div>
        <h2 class="font-heading text-3xl md:text-4xl text-text mb-2">
          {founder.name}
        </h2>
        <p class="text-sm font-medium text-accent mb-5">{founder.role}</p>
        <p class="text-text-muted leading-relaxed mb-6">
          {founder.bio}
        </p>

        {founder.qualifications.length > 0 && (
          <ul class="space-y-2 mb-8">
            {founder.qualifications.map((q) => (
              <li class="text-sm text-text-muted flex items-center gap-2">
                <svg class="w-4 h-4 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                {q}
              </li>
            ))}
          </ul>
        )}

        <a
          href="/ueber"
          class="inline-flex items-center text-base font-medium text-accent-dark hover:underline underline-offset-2 transition-colors"
        >
          Mehr über {founder.name}
          <svg class="w-5 h-5 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
