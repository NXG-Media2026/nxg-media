---
/**
 * BundleUpsellBlock — smart bundle recommendation for standalone products.
 *
 * Renders a non-pushy upsell block when a product is part of a larger bundle.
 * Resolves the target bundle product, renders nothing if it doesn't exist,
 * and uses localized URLs + analytics tracking.
 *
 * Placement: after "What's included" / value proposition, before related products / FAQ.
 */
import { getCollection } from 'astro:content';
import { t, getCollectionBasePath } from '../i18n/utils';
import { trackOnClick } from '../lib/analytics';
import type { Locale } from '../data/site';

interface Props {
  partOfBundle: {
    product: string;
    reason: string;
    label?: string;
    ctaLabel?: string;
  };
  currentSlug: string;
  locale?: Locale;
}

const { partOfBundle, currentSlug, locale = 'de' } = Astro.props;

// Resolve the target bundle product
const allProducts = await getCollection('produkte');
const sameLocaleProducts = allProducts.filter((p) => !p.data.locale || p.data.locale === locale);
const bundleProduct = sameLocaleProducts.find((p) => p.data.pageSlug === partOfBundle.product);

// Don't render if bundle product doesn't exist
if (!bundleProduct) return;

// Don't render on the bundle page itself
if (currentSlug === partOfBundle.product) return;

const productsBase = getCollectionBasePath('produkte', locale);
const bundleUrl = `${productsBase}/${bundleProduct.data.pageSlug}`;
const eyebrow = partOfBundle.label || t('product.bundleEyebrow', locale);
const ctaText = partOfBundle.ctaLabel || t('product.bundleCta', locale);
---

<section class="py-10 md:py-14 bg-bg">
  <div class="max-w-3xl mx-auto px-4 md:px-6">
    <div class="relative bg-white border border-accent/20 rounded-card p-6 md:p-8 shadow-sm">
      {/* Eyebrow */}
      <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/10 text-accent-dark rounded-full mb-4">
        <svg class="w-4 h-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" />
        </svg>
        {eyebrow}
      </span>

      {/* Headline */}
      <h2 class="font-heading text-xl md:text-2xl text-text mb-3 leading-snug">
        {t('product.bundleHeadline', locale)}
      </h2>

      {/* Reason */}
      <p class="text-text-muted leading-relaxed mb-6">
        {partOfBundle.reason}
      </p>

      {/* Bundle info + CTA */}
      <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4">
        <div class="flex-1">
          <p class="font-heading font-medium text-text">
            {bundleProduct.data.title}
          </p>
          <p class="text-sm text-text-muted">
            {bundleProduct.data.price} &euro;
          </p>
        </div>
        <a
          href={bundleUrl}
          class="inline-flex items-center px-6 py-3 text-sm font-medium text-text-inverse bg-primary hover:bg-primary-dark transition-colors rounded-button shadow-sm"
          onclick={trackOnClick('bundle_upsell_click', {
            page_type: 'product',
            page_slug: currentSlug,
            locale,
            target_product: bundleProduct.data.pageSlug,
          })}
        >
          {ctaText}
          <svg class="ml-2 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
