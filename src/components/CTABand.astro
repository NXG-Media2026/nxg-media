---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { EventName, CTALocation, PageType } from '../lib/analytics';
import { trackOnClick } from '../lib/analytics';
import type { Locale } from '../data/site';

interface Props {
  title: string;
  subtitle?: string;
  ctaText: string;
  ctaHref?: string;
  openChooser?: boolean;
  backgroundImage?: ImageMetadata | string;
  backgroundAlt?: string;
  eventName?: EventName;
  ctaLocation?: CTALocation;
  locale?: Locale;
  pageType?: PageType;
  pageSlug?: string;
}

const {
  title,
  subtitle,
  ctaText,
  ctaHref = '#',
  openChooser = false,
  backgroundImage,
  backgroundAlt = '',
  eventName = 'product_cta_click',
  ctaLocation = 'inline',
  locale = 'nl',
  pageType = 'homepage',
  pageSlug = '/',
} = Astro.props;
---

<section class="relative overflow-hidden">
  {backgroundImage ? (
    <>
      {/* Background image */}
      <div class="absolute inset-0">
        {typeof backgroundImage === 'string' ? (
          <img
            src={backgroundImage}
            alt={backgroundAlt}
            width="1400"
            height="1735"
            class="w-full h-full object-cover"
            loading="lazy"
            decoding="async"
          />
        ) : (
          <Image
            src={backgroundImage}
            alt={backgroundAlt}
            widths={[768, 1280, 1400]}
            sizes="100vw"
            class="w-full h-full object-cover"
            loading="lazy"
            decoding="async"
          />
        )}
        <div class="absolute inset-0 bg-[#2D2A26]/80"></div>
      </div>
      <div class="relative py-16 md:py-20">
        <div class="max-w-[1260px] mx-auto px-5 md:px-8 text-center">
          <h2 class="font-heading font-extrabold text-3xl md:text-[2.5rem] leading-[0.98] text-white mb-4 uppercase">
            {title}
          </h2>
          {subtitle && (
            <p class="text-lg text-white/80 mb-8 max-w-2xl mx-auto">
              {subtitle}
            </p>
          )}
          {openChooser ? (
            <button
              type="button"
              data-scanner-open
              class="inline-flex items-center gap-2 px-6 py-[15px] text-[15px] font-extrabold bg-accent hover:bg-accent-dark text-white transition-all duration-300 rounded-button shadow-lg shadow-accent/25 hover:shadow-xl cursor-pointer"
              onclick={trackOnClick(eventName, {
                page_type: pageType,
                page_slug: pageSlug,
                locale,
                cta_location: ctaLocation,
              })}
            >
              {ctaText}
              <span aria-hidden="true">↗</span>
            </button>
          ) : (
            <a
              href={ctaHref}
              class="inline-flex items-center gap-2 px-6 py-[15px] text-[15px] font-extrabold bg-accent hover:bg-accent-dark text-white transition-all duration-300 rounded-button shadow-lg shadow-accent/25 hover:shadow-xl"
              onclick={trackOnClick(eventName, {
                page_type: pageType,
                page_slug: pageSlug,
                locale,
                cta_location: ctaLocation,
              })}
            >
              {ctaText}
              <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      </div>
    </>
  ) : (
    <div class="bg-accent py-16 md:py-20">
      <div class="max-w-[1260px] mx-auto px-5 md:px-8 flex flex-col md:flex-row items-center justify-between gap-8">
        <div>
          <h2 class="font-heading font-extrabold text-3xl md:text-[2.5rem] leading-[0.98] text-text uppercase">
            {title}
          </h2>
          {subtitle && (
            <p class="text-base text-text/70 mt-2">
              {subtitle}
            </p>
          )}
        </div>
        {openChooser ? (
          <button
            type="button"
            data-scanner-open
            class="inline-flex items-center gap-2 px-6 py-[15px] text-[15px] font-extrabold text-white bg-text hover:bg-primary transition-colors rounded-button shrink-0 cursor-pointer"
            onclick={trackOnClick(eventName, {
              page_type: pageType,
              page_slug: pageSlug,
              locale,
              cta_location: ctaLocation,
            })}
          >
            {ctaText}
            <span aria-hidden="true">↗</span>
          </button>
        ) : (
          <a
            href={ctaHref}
            class="inline-flex items-center gap-2 px-6 py-[15px] text-[15px] font-extrabold text-white bg-text hover:bg-primary transition-colors rounded-button shrink-0"
            onclick={trackOnClick(eventName, {
              page_type: pageType,
              page_slug: pageSlug,
              locale,
              cta_location: ctaLocation,
            })}
          >
            {ctaText}
            <span aria-hidden="true">↗</span>
          </a>
        )}
      </div>
    </div>
  )}
</section>
