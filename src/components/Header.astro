---
import { navigation } from '../data/navigation';
import { siteConfig, type Locale } from '../data/site';
import { t, localizePath, getTranslatedPath } from '../i18n/utils';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale?: Locale;
  currentPath?: string;
  hreflang?: Array<{ lang: string; href: string }>;
}

const { locale = 'de', currentPath = '/', hreflang } = Astro.props;
const navItems = navigation[locale];
const showLanguageSwitcher = siteConfig.languageSwitcherEnabled;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === href;
  return currentPath.startsWith(href);
}
---

<header class="sticky top-0 z-50 bg-bg/95 backdrop-blur-sm border-b border-border">
  <div class="max-w-7xl mx-auto px-4 md:px-6">
    <div class="flex items-center justify-between h-16 md:h-20">

      <a href={localizePath('/', locale)} class="font-heading text-xl md:text-2xl text-text hover:text-primary transition-colors py-3 -my-1 inline-flex items-center">
        {siteConfig.name}
      </a>

      <nav class="hidden lg:flex items-center gap-1" aria-label="Hauptnavigation">
        {navItems.map((item) => (
          item.children ? (
            <div class="group relative">
              <a
                href={item.href}
                class:list={[
                  'flex items-center gap-1 px-3 py-3 min-h-[44px] text-sm font-medium transition-colors rounded-button',
                  isActive(item.href) ? 'text-primary' : 'text-text hover:text-primary',
                ]}
              >
                {item.label}
                <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                </svg>
              </a>
              <div class="invisible opacity-0 translate-y-2 group-hover:visible group-hover:opacity-100 group-hover:translate-y-0 transition-all duration-200 absolute top-full left-0 pt-2 z-50">
                <ul class="bg-bg-white rounded-card shadow-lg border border-border py-2 min-w-[220px]">
                  {item.children.map((child) => (
                    <li>
                      <a
                        href={child.href}
                        class:list={[
                          'block px-4 py-3 min-h-[44px] text-sm transition-colors',
                          currentPath === child.href ? 'text-primary bg-bg-alt' : 'text-text hover:text-primary hover:bg-bg-alt',
                        ]}
                      >
                        {child.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ) : item.href === '/quiz' ? (
            <a
              href={item.href}
              class:list={[
                'inline-flex items-center gap-1.5 px-3 py-3 min-h-[44px] text-sm font-medium transition-colors rounded-button',
                isActive(item.href) ? 'text-accent' : 'text-accent hover:text-accent-dark',
              ]}
            >
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z" />
              </svg>
              {item.label}
            </a>
          ) : (
            <a
              href={item.href}
              class:list={[
                'inline-flex items-center px-3 py-3 min-h-[44px] text-sm font-medium transition-colors rounded-button',
                isActive(item.href) ? 'text-primary' : 'text-text hover:text-primary',
              ]}
            >
              {item.label}
            </a>
          )
        ))}

        {showLanguageSwitcher && hreflang && hreflang.length > 0 && (
          <div class="ml-2">
            <LanguageSwitcher locale={locale} currentPath={currentPath} hreflang={hreflang} />
          </div>
        )}

        <a
          href={getTranslatedPath('/angebot', locale)}
          class="ml-3 inline-flex items-center px-4 py-2 text-sm font-medium text-text-inverse bg-primary hover:bg-primary-dark transition-colors rounded-button"
        >
          {t('cta.discover', locale)}
        </a>
      </nav>

      <button
        id="menu-btn"
        class="lg:hidden p-3 -mr-2 min-h-[44px] min-w-[44px] inline-flex items-center justify-center text-text hover:text-primary transition-colors rounded-button"
        aria-label={t('general.menu')}
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg class="menu-icon-open w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="menu-icon-close w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="hidden lg:hidden fixed top-16 left-0 w-full h-[calc(100dvh-4rem)] z-40 bg-bg overflow-y-auto"
    aria-label="Mobile Navigation"
  >
    <div class="px-4 py-6 space-y-1">
      {navItems.map((item) => (
        item.children ? (
          <details class="group">
            <summary class="flex items-center justify-between py-3 min-h-[44px] text-lg font-medium text-text cursor-pointer list-none">
              <span>{item.label}</span>
              <svg class="w-5 h-5 text-text-muted transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </summary>
            <ul class="pl-4 pb-2 space-y-1">
              <li>
                <a
                  href={item.href}
                  class:list={[
                    'block py-3 min-h-[44px] text-base transition-colors',
                    isActive(item.href) ? 'text-primary font-medium' : 'text-text-muted hover:text-primary',
                  ]}
                >
                  {t('cta.viewAll')}
                </a>
              </li>
              {item.children.map((child) => (
                <li>
                  <a
                    href={child.href}
                    class:list={[
                      'block py-3 min-h-[44px] text-base transition-colors',
                      currentPath === child.href ? 'text-primary font-medium' : 'text-text-muted hover:text-primary',
                    ]}
                  >
                    {child.label}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        ) : item.href === '/quiz' ? (
          <a
            href={item.href}
            class:list={[
              'flex items-center gap-2 py-3 text-lg font-medium transition-colors',
              isActive(item.href) ? 'text-accent' : 'text-accent hover:text-accent-dark',
            ]}
          >
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z" />
            </svg>
            {item.label}
          </a>
        ) : (
          <a
            href={item.href}
            class:list={[
              'block py-3 text-lg font-medium transition-colors',
              isActive(item.href) ? 'text-primary' : 'text-text hover:text-primary',
            ]}
          >
            {item.label}
          </a>
        )
      ))}

      {showLanguageSwitcher && hreflang && hreflang.length > 0 && (
        <div class="pt-4 mt-4 border-t border-border flex items-center gap-3">
          <span class="text-sm text-text-muted">{t('general.language')}:</span>
          <LanguageSwitcher locale={locale} currentPath={currentPath} hreflang={hreflang} />
        </div>
      )}

      <a
        href={getTranslatedPath('/angebot', locale)}
        class="block w-full mt-4 py-3 text-center text-base font-medium text-text-inverse bg-primary hover:bg-primary-dark transition-colors rounded-button"
      >
        {t('cta.discover', locale)}
      </a>
    </div>
  </nav>
</header>

<script is:inline>
  (function() {
    var btn = document.getElementById('menu-btn');
    var nav = document.getElementById('mobile-nav');
    if (!btn || !nav) return;
    btn.addEventListener('click', function() {
      var open = nav.classList.contains('hidden');
      nav.classList.toggle('hidden');
      btn.setAttribute('aria-expanded', String(open));
      btn.querySelector('.menu-icon-open').classList.toggle('hidden');
      btn.querySelector('.menu-icon-close').classList.toggle('hidden');
    });
  })();
</script>
