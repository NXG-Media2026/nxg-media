---
import { navigation } from '../data/navigation';
import { siteConfig, type Locale } from '../data/site';
import '../styles/navigation.css';
interface Props { locale?: Locale; currentPath?: string; hreflang?: Array<{lang:string;href:string}>; }
const {locale='nl',currentPath='/',hreflang=[]}=Astro.props;
const items=navigation[locale].filter(item=>!item.isButton);
const cta=navigation[locale].find(item=>item.isButton);
const home=locale==='nl'?'/':`/${locale}`;
const normalize=(path:string)=>path.replace(/\/+$/,'')||'/';
const active=(href:string)=>!href.includes('#')&&(normalize(currentPath)===normalize(href)||normalize(currentPath).startsWith(normalize(href)+'/'));
const words={nl:{nav:'Hoofdnavigatie',menu:'Menu',all:'Alle diensten',languages:'Taal'},en:{nav:'Main navigation',menu:'Menu',all:'All services',languages:'Language'},es:{nav:'Navegación principal',menu:'Menú',all:'Todos los servicios',languages:'Idioma'}}[locale];
const languages=siteConfig.locales.map(lang=>({lang,href:hreflang.find(h=>h.lang===lang)?.href.replace(siteConfig.url,'')||(lang==='nl'?'/':`/${lang}`)}));
---
<header class="site-header" data-site-header><div class="site-header-row">
<a class="site-brand" href={home}><strong>NXG-media</strong><span>AI Search Agency</span></a>
<button type="button" class="site-menu-button" aria-expanded="false" aria-controls="site-navigation"><span>{words.menu}</span><span class="site-menu-symbol" aria-hidden="true">☰</span></button>
<nav class="site-nav" id="site-navigation" aria-label={words.nav}>
<ul class="site-nav-links">{items.map(item=><li>{item.children ? <details class="site-dropdown"><summary class:list={{'is-active':item.children.some(child=>active(child.href))}}>{item.label}<span aria-hidden="true">⌄</span></summary><ul class="site-submenu"><li><a href={item.href}>{words.all} ↗</a></li>{item.children.map(child=><li><a href={child.href} aria-current={active(child.href)?'page':undefined}>{child.label}</a></li>)}</ul></details> : <a href={item.href} aria-current={active(item.href)?'page':undefined}>{item.label}</a>}</li>)}</ul>
{siteConfig.languageSwitcherEnabled&&<div class="site-languages" aria-label={words.languages}>{languages.map(l=>l.lang===locale?<span aria-current="true">{l.lang.toUpperCase()}</span>:<a href={l.href} lang={l.lang} hreflang={l.lang}>{l.lang.toUpperCase()}</a>)}</div>}
{cta&&<a class="site-nav-cta" href={cta.href}>{cta.label}<span aria-hidden="true">↗</span></a>}
</nav></div></header>
<script is:inline>
(()=>{const header=document.querySelector('[data-site-header]');if(!header)return;const button=header.querySelector('.site-menu-button');const nav=header.querySelector('.site-nav');const dropdowns=[...header.querySelectorAll('.site-dropdown')];
function setOpen(open){header.classList.toggle('is-menu-open',open);button.setAttribute('aria-expanded',String(open));button.querySelector('.site-menu-symbol').textContent=open?'×':'☰';if(!open)dropdowns.forEach(d=>d.open=false);}
button.addEventListener('click',()=>setOpen(button.getAttribute('aria-expanded')!=='true'));
nav.addEventListener('click',e=>{if(e.target.closest('a'))setOpen(false);});
document.addEventListener('click',e=>{if(!header.contains(e.target))setOpen(false);});
document.addEventListener('keydown',e=>{if(e.key!=='Escape')return;const expanded=dropdowns.find(d=>d.open);if(expanded){expanded.open=false;expanded.querySelector('summary').focus();}else if(header.classList.contains('is-menu-open')){setOpen(false);button.focus();}});
header.addEventListener('focusout',()=>setTimeout(()=>{if(!header.contains(document.activeElement))setOpen(false);},0));
matchMedia('(min-width:1120px)').addEventListener('change',()=>setOpen(false));})();
</script>
