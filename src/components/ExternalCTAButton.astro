---
import type { EventName, CTALocation, PageType } from '../lib/analytics';
import { trackOnClick } from '../lib/analytics';
import type { Locale } from '../data/site';

type Variant = 'primary' | 'secondary' | 'outline';

interface Props {
  href: string;
  label: string;
  variant?: Variant;
  eventName?: EventName;
  ctaLocation?: CTALocation;
  pageType?: PageType;
  pageSlug?: string;
  locale?: Locale;
  class?: string;
}

const {
  href,
  label,
  variant = 'primary',
  eventName = 'external_link_click',
  ctaLocation = 'inline',
  pageType = 'page',
  pageSlug = '/',
  locale = 'de',
  class: className = '',
} = Astro.props;

const baseClasses = 'inline-flex items-center gap-2 font-medium transition-colors rounded-button';

const variantClasses: Record<Variant, string> = {
  primary: 'px-6 py-3 text-base text-text-inverse bg-primary hover:bg-primary-dark shadow-lg',
  secondary: 'px-6 py-3 text-base text-primary bg-white border border-primary hover:bg-primary/5',
  outline: 'px-5 py-2.5 text-sm text-accent border border-accent/30 hover:border-accent hover:text-accent-dark',
};
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class:list={[baseClasses, variantClasses[variant], className]}
  onclick={trackOnClick(eventName, {
    page_type: pageType,
    page_slug: pageSlug,
    locale,
    cta_location: ctaLocation,
  })}
>
  {label}
  <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
  </svg>
</a>
