---
import { trackOnClick } from '../lib/analytics';
import { t } from '../i18n/utils';
import type { Locale } from '../data/site';
import type { PageType } from '../lib/analytics';

interface Props {
  pageType?: PageType;
  pageSlug: string;
  title?: string;
  subtitle?: string;
  locale?: Locale;
}

const {
  pageType = 'contact',
  pageSlug,
  locale = 'nl',
  title = t('calendly.title', locale),
  subtitle = t('calendly.subtitle', locale),
} = Astro.props;

const calendlyUrl = 'https://calendly.com/nxgmedia/gratis-15-minuten-strategiegesprek?hide_event_type_details=1&hide_gdpr_banner=1';
---

<section
  id="calendly"
  class="py-12 md:py-16 bg-bg-alt"
  data-analytics-page-type={pageType}
  data-analytics-page-slug={pageSlug}
  data-analytics-locale={locale}
>
  <div class="max-w-3xl mx-auto px-4 md:px-6">
    {title && (
      <div class="text-center mb-8">
        <h2 class="font-heading text-2xl md:text-3xl text-text mb-3">
          {title}
        </h2>
        {subtitle && (
          <p class="text-text-muted max-w-xl mx-auto">
            {subtitle}
          </p>
        )}
      </div>
    )}

    <div
      id="calendly-container"
      class="rounded-card overflow-hidden bg-white shadow-sm"
      data-calendly-url={calendlyUrl}
      style="min-width:320px;min-height:700px;"
    >
      {/* Loading spinner shown until Calendly loads */}
      <div id="calendly-loading" class="w-full flex flex-col items-center justify-center gap-4 py-16 text-center">
        <svg class="w-10 h-10 text-accent animate-spin" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span class="text-sm text-text-muted">Agenda laden...</span>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    const container = document.getElementById('calendly-container');
    if (!container) return;

    let loaded = false;

    function loadCalendly() {
      if (loaded) return;
      loaded = true;

      const url = container.dataset.calendlyUrl;
      if (!url) return;

      // Remove loading spinner
      const loading = document.getElementById('calendly-loading');
      if (loading) loading.remove();

      // Create Calendly widget
      const widget = document.createElement('div');
      widget.className = 'calendly-inline-widget';
      widget.dataset.url = url;
      widget.style.minWidth = '320px';
      widget.style.height = '700px';
      container.appendChild(widget);

      // Load Calendly script
      const script = document.createElement('script');
      script.src = 'https://assets.calendly.com/assets/external/widget.js';
      script.async = true;
      document.head.appendChild(script);

      // Track event
      const section = document.getElementById('calendly');
      if (section && typeof window.trackEvent === 'function') {
        const pageType = section.dataset.analyticsPageType || 'contact';
        const pageSlug = section.dataset.analyticsPageSlug || '';
        const locale = section.dataset.analyticsLocale || 'nl';
        window.trackEvent('discovery_call_view', {
          page_type: pageType,
          page_slug: pageSlug,
          locale: locale,
          provider: 'calendly',
        });
      }
    }

    // Auto-load when section scrolls into view
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              loadCalendly();
              observer.disconnect();
            }
          });
        },
        { rootMargin: '200px' } // Start loading 200px before visible
      );
      observer.observe(container);
    } else {
      // Fallback: load immediately for older browsers
      loadCalendly();
    }
  })();
</script>
