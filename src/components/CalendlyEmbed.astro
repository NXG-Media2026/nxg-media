---
import { trackOnClick } from '../lib/analytics';
import { t } from '../i18n/utils';
import type { Locale } from '../data/site';
import type { PageType } from '../lib/analytics';

interface Props {
  pageType?: PageType;
  pageSlug: string;
  title?: string;
  subtitle?: string;
  locale?: Locale;
}

const {
  pageType = 'contact',
  pageSlug,
  locale = 'nl',
  title = t('calendly.title', locale),
  subtitle = t('calendly.subtitle', locale),
} = Astro.props;

const calendlyUrl = 'https://calendly.com/nxgmedia/gratis-15-minuten-strategiegesprek?hide_event_type_details=1&hide_gdpr_banner=1';

const loadLabel: Record<string, string> = {
  nl: 'Klik om de agenda te laden',
  en: 'Click to load the calendar',
  es: 'Haz clic para cargar el calendario',
};
---

<section
  id="calendly"
  class="py-12 md:py-16 bg-bg-alt"
  data-analytics-page-type={pageType}
  data-analytics-page-slug={pageSlug}
  data-analytics-locale={locale}
>
  <div class="max-w-3xl mx-auto px-4 md:px-6">
    {title && (
      <div class="text-center mb-8">
        <h2 class="font-heading text-2xl md:text-3xl text-text mb-3">
          {title}
        </h2>
        {subtitle && (
          <p class="text-text-muted max-w-xl mx-auto">
            {subtitle}
          </p>
        )}
      </div>
    )}

    <div
      id="calendly-container"
      class="rounded-card overflow-hidden bg-white shadow-sm"
      data-calendly-url={calendlyUrl}
      style="min-width:320px;min-height:700px;"
    >
      <button
        id="calendly-load-btn"
        type="button"
        class="w-full h-full flex flex-col items-center justify-center gap-4 py-16 text-center cursor-pointer hover:bg-bg-alt/50 transition-colors"
      >
        <svg class="w-12 h-12 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5" />
        </svg>
        <span class="text-base font-medium text-accent">{loadLabel[locale] ?? loadLabel.nl}</span>
        <span class="text-sm text-text-muted">Calendly</span>
      </button>
    </div>
  </div>
</section>

<script>
  (function () {
    const btn = document.getElementById('calendly-load-btn');
    const container = document.getElementById('calendly-container');
    if (!btn || !container) return;

    let loaded = false;

    btn.addEventListener('click', function () {
      if (loaded) return;
      loaded = true;

      const url = container.dataset.calendlyUrl;
      if (!url) return;

      btn.remove();

      const widget = document.createElement('div');
      widget.className = 'calendly-inline-widget';
      widget.dataset.url = url;
      widget.style.minWidth = '320px';
      widget.style.height = '700px';
      container.appendChild(widget);

      const script = document.createElement('script');
      script.src = 'https://assets.calendly.com/assets/external/widget.js';
      script.async = true;
      document.head.appendChild(script);

      const section = document.getElementById('calendly');
      if (section && typeof window.trackEvent === 'function') {
        const pageType = section.dataset.analyticsPageType || 'contact';
        const pageSlug = section.dataset.analyticsPageSlug || '';
        const locale = section.dataset.analyticsLocale || 'nl';
        window.trackEvent('discovery_call_click', {
          page_type: pageType,
          page_slug: pageSlug,
          locale: locale,
          cta_location: 'inline',
          provider: 'calendly',
        });
      }
    });
  })();
</script>
