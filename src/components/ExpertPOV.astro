---
/**
 * ExpertPOV — short "Why this exists" callout with Verena's point of view.
 *
 * Renders a calm, expert-led block that connects the product to
 * the doc.veri philosophy. Optional — only shown when text is provided.
 */
import { siteConfig } from '../data/site';
import type { Locale } from '../data/site';

interface Props {
  text: string;
  locale?: Locale;
}

const { text, locale = 'de' } = Astro.props;
const label = locale === 'en' ? 'Why this approach' : 'Warum dieser Ansatz';
---

<section class="py-10 md:py-14 bg-bg">
  <div class="max-w-3xl mx-auto px-4 md:px-6">
    <div class="bg-bg-alt rounded-card p-8 md:p-10 border border-border">
      <p class="text-xs font-medium uppercase tracking-wider text-accent mb-4">{label}</p>
      <blockquote class="text-lg md:text-xl text-text leading-relaxed font-heading italic">
        &ldquo;{text}&rdquo;
      </blockquote>
      <p class="text-sm text-text-muted mt-4">— {siteConfig.founder.name}</p>
    </div>
  </div>
</section>
