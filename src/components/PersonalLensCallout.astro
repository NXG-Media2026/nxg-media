---
/**
 * PersonalLensCallout — a subtle expert-lens block for blog articles.
 *
 * Used to inject Verena's personal observations, reframes, or
 * myth-busting perspective into articles without breaking the
 * article's informational flow.
 *
 * Styled as a soft card — premium editorial feel, not loud, not salesy.
 * Never used for product promotion or generic advice.
 */
import { siteConfig } from '../data/site';
import type { Locale } from '../data/site';

interface Props {
  /** The callout text — Verena's observation or reframe */
  text: string;
  /** Optional label override. Defaults to locale-aware "Verena's perspective" / "Verenas Perspektive" */
  label?: string;
  locale?: Locale;
}

const { text, label, locale = 'de' } = Astro.props;
const defaultLabel = locale === 'en' ? "Verena’s perspective" : 'Verenas Perspektive';
const displayLabel = label || defaultLabel;
---

<aside class="personal-lens-callout my-8 md:my-10 not-prose" role="note">
  <div class="rounded-lg bg-accent/5 border border-accent/15 px-6 py-5 md:px-8 md:py-6">
    <p class="text-xs font-medium uppercase tracking-wider text-accent/80 mb-3">{displayLabel}</p>
    <p class="text-base md:text-[1.05rem] text-text leading-relaxed italic">
      {text}
    </p>
    <p class="text-sm text-text-muted mt-3">— {siteConfig.founder.name}</p>
  </div>
</aside>
