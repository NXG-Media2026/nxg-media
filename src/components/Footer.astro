---
import { siteConfig } from '../data/site';
import { navigation } from '../data/navigation';
import { t } from '../i18n/utils';
import type { Locale } from '../data/site';
import { buildNewsletterPayload, serializePayload } from '../lib/emailCapture';

interface Props {
  locale?: Locale;
}

const { locale = 'de' } = Astro.props;
const navItems = navigation[locale];
const year = new Date().getFullYear();
const nlFormId = 'footer-newsletter';
const nlPayloadJson = serializePayload(buildNewsletterPayload('', { route: 'footer' }));
---

<footer class="bg-primary-dark text-white/90">
  <div class="max-w-7xl mx-auto px-4 md:px-6 pt-16 md:pt-24 pb-10">
    <div class="max-w-xl mx-auto text-center mb-14">
      <h3 class="font-heading text-xl text-white mb-2">{t('newsletter.heading')}</h3>
      <p class="text-sm text-white/60 mb-5">Evidenzbasierte Impulse zu Hormonen, Training und Ernährung — direkt in dein Postfach.</p>
      <form
        id={nlFormId}
        class="flex flex-col sm:flex-row gap-3"
        data-page-type="page"
        data-page-slug="footer"
        data-locale={locale}
        data-email-payload={nlPayloadJson}
      >
        <label for={`${nlFormId}-email`} class="sr-only">{t('newsletter.placeholder')}</label>
        <input
          id={`${nlFormId}-email`}
          type="email"
          name="email"
          required
          placeholder={t('newsletter.placeholder')}
          class="flex-1 px-4 py-3 rounded-button text-sm text-text bg-white border border-white/20 focus:outline-none focus:ring-2 focus:ring-accent"
        />
        <button
          type="submit"
          class="px-6 py-3 text-sm font-medium text-primary bg-white hover:bg-bg-alt rounded-button transition-colors"
        >
          {t('newsletter.button')}
        </button>
      </form>
      <p class="newsletter-success hidden mt-4 text-white/90 text-sm" aria-live="polite">
        {t('newsletter.success')}
      </p>
      <p class="newsletter-error hidden mt-4 text-red-300 text-sm" role="alert">
        {t('newsletter.error')}
      </p>
    </div>
  </div>

  <div class="border-t border-white/10">
  <div class="max-w-7xl mx-auto px-4 md:px-6 py-16 md:py-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 lg:gap-8">

      <div>
        <a href="/" class="font-heading text-xl text-white hover:text-primary-light transition-colors">
          {siteConfig.name}
        </a>
        <p class="mt-3 text-sm text-white/60 leading-relaxed">
          {siteConfig.tagline}
        </p>

        {(siteConfig.socials.instagram || siteConfig.socials.linkedin || siteConfig.socials.youtube) && (
          <ul class="mt-6 flex items-center gap-3" aria-label="Social Media">
            {siteConfig.socials.instagram && (
              <li>
                <a href={siteConfig.socials.instagram} target="_blank" rel="noopener noreferrer me" aria-label="Instagram"
                  class="inline-flex w-9 h-9 items-center justify-center rounded-full bg-white/5 text-white/70 hover:bg-primary-light hover:text-white transition-colors">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2.2c3.2 0 3.6 0 4.8.1 1.2.1 1.8.2 2.2.4.5.2.9.5 1.3.9.4.4.6.8.9 1.3.2.4.4 1 .4 2.2.1 1.2.1 1.6.1 4.8s0 3.6-.1 4.8c-.1 1.2-.2 1.8-.4 2.2-.2.5-.5.9-.9 1.3-.4.4-.8.6-1.3.9-.4.2-1 .4-2.2.4-1.2.1-1.6.1-4.8.1s-3.6 0-4.8-.1c-1.2-.1-1.8-.2-2.2-.4-.5-.2-.9-.5-1.3-.9-.4-.4-.6-.8-.9-1.3-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.8c.1-1.2.2-1.8.4-2.2.2-.5.5-.9.9-1.3.4-.4.8-.6 1.3-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 1.8c-3.1 0-3.5 0-4.7.1-1.1.1-1.7.2-2.1.4-.5.2-.9.5-1.3.9-.3.3-.6.7-.8 1.3-.2.4-.3 1-.4 2.1-.1 1.2-.1 1.6-.1 4.7s0 3.5.1 4.7c.1 1.1.2 1.7.4 2.1.2.5.5.9.9 1.3.3.3.7.6 1.3.8.4.2 1 .3 2.1.4 1.2.1 1.6.1 4.7.1s3.5 0 4.7-.1c1.1-.1 1.7-.2 2.1-.4.5-.2.9-.5 1.3-.9.3-.3.6-.7.8-1.3.2-.4.3-1 .4-2.1.1-1.2.1-1.6.1-4.7s0-3.5-.1-4.7c-.1-1.1-.2-1.7-.4-2.1-.2-.5-.5-.9-.9-1.3-.3-.3-.7-.6-1.3-.8-.4-.2-1-.3-2.1-.4-1.2-.1-1.6-.1-4.7-.1zm0 3.1a4.9 4.9 0 110 9.8 4.9 4.9 0 010-9.8zm0 8.1a3.2 3.2 0 100-6.4 3.2 3.2 0 000 6.4zm6.3-8.3a1.1 1.1 0 11-2.3 0 1.1 1.1 0 012.3 0z"/>
                  </svg>
                </a>
              </li>
            )}
            {siteConfig.socials.linkedin && (
              <li>
                <a href={siteConfig.socials.linkedin} target="_blank" rel="noopener noreferrer me" aria-label="LinkedIn"
                  class="inline-flex w-9 h-9 items-center justify-center rounded-full bg-white/5 text-white/70 hover:bg-primary-light hover:text-white transition-colors">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 11.01-4.12 2.06 2.06 0 01-.01 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/>
                  </svg>
                </a>
              </li>
            )}
            {siteConfig.socials.youtube && (
              <li>
                <a href={siteConfig.socials.youtube} target="_blank" rel="noopener noreferrer me" aria-label="YouTube"
                  class="inline-flex w-9 h-9 items-center justify-center rounded-full bg-white/5 text-white/70 hover:bg-primary-light hover:text-white transition-colors">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M23.5 6.2a3 3 0 00-2.1-2.1C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.4.6A3 3 0 00.5 6.2C0 8.1 0 12 0 12s0 3.9.5 5.8a3 3 0 002.1 2.1c1.9.6 9.4.6 9.4.6s7.5 0 9.4-.6a3 3 0 002.1-2.1c.5-1.9.5-5.8.5-5.8s0-3.9-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z"/>
                  </svg>
                </a>
              </li>
            )}
          </ul>
        )}
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white/60 mb-4">
          {t('nav.angebot')}
        </h3>
        <ul class="space-y-2.5">
          {navItems
            .find((item) => item.href === '/angebot')
            ?.children?.map((child) => (
              <li>
                <a href={child.href} class="text-sm text-white/70 hover:text-primary-light transition-colors">
                  {child.label}
                </a>
              </li>
            ))}
        </ul>

        <h3 class="text-sm font-semibold uppercase tracking-wider text-white/60 mb-4 mt-8">
          Wissen
        </h3>
        <ul class="space-y-2.5">
          <li>
            <a href="/themen" class="text-sm text-white/70 hover:text-primary-light transition-colors">
              {t('nav.themen')}
            </a>
          </li>
          <li>
            <a href="/blog" class="text-sm text-white/70 hover:text-primary-light transition-colors">
              {t('nav.blog')}
            </a>
          </li>
          <li>
            <a href="/glossar" class="text-sm text-white/70 hover:text-primary-light transition-colors">
              {t('nav.glossar')}
            </a>
          </li>
          <li>
            <a href="/masterclass/hormone-histamin-zyklus-superpower" class="text-sm text-white/70 hover:text-primary-light transition-colors">
              Kostenlose Masterclass
            </a>
          </li>
          <li>
            <a href="/faq" class="text-sm text-white/70 hover:text-primary-light transition-colors">
              {t('nav.faq')}
            </a>
          </li>
        </ul>
      </div>

      <div>
        <h3 class="text-sm font-semibold uppercase tracking-wider text-white/60 mb-4">
          {t('nav.about')}
        </h3>
        <ul class="space-y-2.5">
          <li>
            <a href="/ueber" class="text-sm text-white/70 hover:text-primary-light transition-colors">
              {t('nav.about')}
            </a>
          </li>
          <li>
            <a href="/kontakt" class="text-sm text-white/70 hover:text-primary-light transition-colors">
              {t('nav.contact')}
            </a>
          </li>
        </ul>

        <h3 class="text-sm font-semibold uppercase tracking-wider text-white/60 mb-4 mt-8">
          Kontakt
        </h3>
        <ul class="space-y-3">
          <li>
            <a href={`mailto:${siteConfig.email}`} class="flex items-center gap-3 text-sm text-white/70 hover:text-primary-light transition-colors">
              <svg class="w-5 h-5 text-white/40 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
              </svg>
              {siteConfig.email}
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
  </div>

  <div class="border-t border-white/10">
    <div class="max-w-7xl mx-auto px-4 md:px-6 py-5 flex flex-col md:flex-row items-center justify-between gap-3">
      <p class="text-xs text-white/70">
        &copy; {year} {siteConfig.name}. {t('footer.rights')}.
      </p>
      <div class="flex items-center gap-4">
        <a href="/datenschutz" class="text-xs text-white/70 hover:text-white transition-colors">
          {t('footer.privacy')}
        </a>
        <a href="/impressum" class="text-xs text-white/70 hover:text-white transition-colors">
          {t('footer.impressum')}
        </a>
        <a href="/agb" class="text-xs text-white/70 hover:text-white transition-colors">
          {t('footer.agb')}
        </a>
      </div>
    </div>
  </div>

  <script is:inline>
  (function() {
    var form = document.getElementById('footer-newsletter');
    if (!form || form.dataset.bound) return;
    form.dataset.bound = '1';

    var btn = form.querySelector('button[type="submit"]');
    var btnText = btn ? btn.textContent : '';

    function setLoading(on) {
      if (!btn) return;
      btn.disabled = on;
      btn.textContent = on ? 'Einen Moment…' : btnText;
      var input = form.querySelector('input[type="email"]');
      if (input) input.disabled = on;
    }

    function showError() {
      var el = form.parentElement.querySelector('.newsletter-error');
      if (el) el.classList.remove('hidden');
    }

    function hideError() {
      var el = form.parentElement.querySelector('.newsletter-error');
      if (el) el.classList.add('hidden');
    }

    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var email = form.querySelector('input[type="email"]').value;
      if (!email) return;

      hideError();
      setLoading(true);

      // Build payload from pre-serialized template
      var payloadTemplate = form.dataset.emailPayload;
      var payload = payloadTemplate ? JSON.parse(payloadTemplate) : {};
      payload.email = email;

      var provider = 'placeholder'; // TODO: read from env when ESP is configured

      function onSuccess() {
        if (typeof trackEvent === 'function') {
          trackEvent('newsletter_signup', {
            page_type: 'page',
            page_slug: 'footer',
            locale: form.dataset.locale || 'de',
            provider: provider,
          });
        }
        form.style.display = 'none';
        var msg = form.parentElement.querySelector('.newsletter-success');
        if (msg) msg.classList.remove('hidden');
      }

      function onError() {
        setLoading(false);
        showError();
      }

      if (provider === 'placeholder') {
        console.log('[emailCapture:placeholder] newsletter_footer', JSON.stringify(payload, null, 2));
        onSuccess();
      } else {
        fetch('/api/email-capture', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        }).then(function(res) {
          if (res.ok) { onSuccess(); } else { onError(); }
        }).catch(function() {
          onError();
        });
      }
    });
  })();
  </script>
</footer>
