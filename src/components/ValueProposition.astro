---
/**
 * ValueProposition — compact "Do this / Get this / Here's how" block.
 *
 * Placed near the hero on product pages. Works with explicit frontmatter
 * or generates a graceful fallback from product metadata.
 */
import { t } from '../i18n/utils';
import type { Locale } from '../data/site';

interface Props {
  doThis: string;
  getThis: string[];
  howItWorks: string[];
  locale?: Locale;
}

const { doThis, getThis, howItWorks, locale = 'de' } = Astro.props;

const labels = locale === 'en'
  ? { do: 'Do this', get: 'Get this', how: "Here's how" }
  : { do: 'So funktioniert es', get: 'Das bekommst du', how: 'Dein Zugang' };
---

<section class="py-10 md:py-14 bg-bg">
  <div class="max-w-3xl mx-auto px-4 md:px-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {/* Do this */}
      <div class="bg-bg-alt rounded-card p-6 border border-border">
        <p class="text-xs font-medium uppercase tracking-wider text-accent mb-3">{labels.do}</p>
        <p class="text-sm text-text leading-relaxed">{doThis}</p>
      </div>

      {/* Get this */}
      <div class="bg-bg-alt rounded-card p-6 border border-border">
        <p class="text-xs font-medium uppercase tracking-wider text-accent mb-3">{labels.get}</p>
        <ul class="space-y-2">
          {getThis.map((item) => (
            <li class="flex items-start gap-2 text-sm text-text leading-relaxed">
              <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
              </svg>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>

      {/* Here's how */}
      <div class="bg-bg-alt rounded-card p-6 border border-border">
        <p class="text-xs font-medium uppercase tracking-wider text-accent mb-3">{labels.how}</p>
        <ul class="space-y-2">
          {howItWorks.map((item) => (
            <li class="flex items-center gap-2 text-sm text-text leading-relaxed">
              <span class="w-1.5 h-1.5 bg-accent rounded-full shrink-0"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
