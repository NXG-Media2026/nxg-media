---
import type { Testimonial } from '../data/testimonials';

interface Props {
  testimonials: Testimonial[];
  locale?: string;
}

const { testimonials, locale = 'nl' } = Astro.props;
const [featured, ...rest] = testimonials;
const colors = ['bg-accent', 'bg-primary', 'bg-amber-500', 'bg-emerald-500', 'bg-rose-500'];

function getInitials(name: string): string {
  return name
    .split(' ')
    .map((w) => w[0])
    .join('')
    .toUpperCase()
    .slice(0, 2);
}

function renderStars(rating: number = 5): string {
  return '★'.repeat(rating) + '☆'.repeat(5 - rating);
}
---

<section class="py-16 md:py-24">
  <div class="max-w-4xl mx-auto px-4 md:px-6">

    {/* Featured testimonial */}
    {featured && (
      <div class="mb-12 border-l-4 border-accent bg-bg-alt rounded-card p-8 md:p-10">
        <div class="flex items-center gap-4 mb-6">
          <div class:list={[
            'w-14 h-14 rounded-full flex items-center justify-center text-white font-bold text-lg shrink-0',
            colors[0],
          ]}>
            {getInitials(featured.name)}
          </div>
          <div>
            <p class="font-heading text-lg text-text">{featured.name}</p>
            {featured.outcome && (
              <p class="text-sm text-text-muted">{featured.outcome}</p>
            )}
          </div>
        </div>
        <div class="text-accent text-xl mb-4 tracking-wide" aria-label={`${featured.rating ?? 5} van 5 sterren`}>
          {renderStars(featured.rating)}
        </div>
        <blockquote class="text-text leading-relaxed text-lg md:text-xl italic">
          &ldquo;{featured.text}&rdquo;
        </blockquote>
      </div>
    )}

    {/* Remaining testimonials — 2 col grid */}
    {rest.length > 0 && (
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {rest.map((t, i) => (
          <div class="bg-bg-alt border border-border rounded-card p-6">
            <div class="flex items-center gap-3 mb-4">
              <div class:list={[
                'w-10 h-10 rounded-full flex items-center justify-center text-white font-bold text-sm shrink-0',
                colors[(i + 1) % colors.length],
              ]}>
                {getInitials(t.name)}
              </div>
              <div>
                <p class="font-heading text-base text-text">{t.name}</p>
                {t.outcome && (
                  <p class="text-xs text-text-muted">{t.outcome}</p>
                )}
              </div>
            </div>
            <div class="text-accent text-base mb-3 tracking-wide" aria-label={`${t.rating ?? 5} van 5 sterren`}>
              {renderStars(t.rating)}
            </div>
            <blockquote class="text-text-muted leading-relaxed text-sm">
              &ldquo;{t.text}&rdquo;
            </blockquote>
          </div>
        ))}
      </div>
    )}

  </div>
</section>
