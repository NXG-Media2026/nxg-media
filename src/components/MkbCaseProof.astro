---
import type { Locale } from '../data/site';
interface Props { locale?: Locale; }
const { locale = 'nl' } = Astro.props;

const i18n = {
  nl: { heading: 'Praktijken en dienstverleners', intro: 'Deze cases gaan over het online fundament en organische vindbaarheid. Ze tonen geen resultaat van een complete betaalde Growth-campagne.', start: 'De start: ', work: 'Ons werk: ', period: 'De periode: ', cta: 'Bekijk de MKB-aanpak', ctaHref: '/landermkb/' },
  en: { heading: 'Practices and service providers', intro: 'These cases are about the online foundation and organic findability. They do not show results from a complete paid Growth campaign.', start: 'Starting point: ', work: 'Our work: ', period: 'The timeline: ', cta: 'View the SMB approach', ctaHref: '/en/nxg-growth/' },
  es: { heading: 'Consultorios y proveedores de servicios', intro: 'Estos casos tratan sobre el fundamento online y la visibilidad orgánica. No muestran resultados de una campaña de Growth de pago completa.', start: 'El inicio: ', work: 'Nuestro trabajo: ', period: 'El periodo: ', cta: 'Ver el enfoque PYMES', ctaHref: '/es/nxg-growth/' },
}[locale];

const casesData = {
  nl: [
    {name:'Costa Blanca Movement Centre',photo:'james.webp',title:'Van nul naar 12–15 patiënten per maand',before:'Geen website, geen Google-historie en geen backlinks.',work:'Een nieuwe website en het fundament voor organische vindbaarheid in Google en AI-antwoorden.',period:'Binnen 14 dagen op pagina 1 in Google. Na twee maanden kwamen er 12–15 patiënten per maand online binnen.',stats:['12–15 patiënten per maand','800+ organische bezoekers per maand'],proof:'google-proof.webp',proofLabel:'Bekijk het Google-resultaat'},
    {name:'Dr. Verena Mann',photo:'verena.webp',title:'Van 2 naar 19 aanvragen per maand',before:'Wel expertise en een community, maar nauwelijks aanvragen via de website.',work:'Expertise, bewijs en de aanvraagroute duidelijker neergezet, met aandacht voor organische AI-vindbaarheid.',period:'De website was in deze case circa zes weken live.',stats:['2 → 19 aanvragen per maand','0 → 15 AI-vermeldingen'],proof:'verena-proof.webp',proofLabel:'Bekijk de AI-vermelding'}
  ],
  en: [
    {name:'Costa Blanca Movement Centre',photo:'james.webp',title:'From zero to 12–15 patients per month',before:'No website, no Google history and no backlinks.',work:'A new website and the foundation for organic findability in Google and AI answers.',period:'On page 1 in Google within 14 days. After two months, 12–15 patients per month came in online.',stats:['12–15 patients per month','800+ organic visitors per month'],proof:'google-proof.webp',proofLabel:'View the Google result'},
    {name:'Dr. Verena Mann',photo:'verena.webp',title:'From 2 to 19 enquiries per month',before:'Expertise and a community, but hardly any enquiries via the website.',work:'Expertise, proof and the enquiry route made clearer, with attention to organic AI findability.',period:'The website was live for approximately six weeks in this case.',stats:['2 → 19 enquiries per month','0 → 15 AI mentions'],proof:'verena-proof.webp',proofLabel:'View the AI mention'}
  ],
  es: [
    {name:'Costa Blanca Movement Centre',photo:'james.webp',title:'De cero a 12–15 pacientes al mes',before:'Sin web, sin historial en Google y sin backlinks.',work:'Una nueva web y el fundamento para la visibilidad orgánica en Google y respuestas de IA.',period:'En la página 1 de Google en 14 días. Tras dos meses, llegaban 12–15 pacientes al mes de forma online.',stats:['12–15 pacientes al mes','800+ visitantes orgánicos al mes'],proof:'google-proof.webp',proofLabel:'Ver el resultado de Google'},
    {name:'Dr. Verena Mann',photo:'verena.webp',title:'De 2 a 19 solicitudes al mes',before:'Experiencia y una comunidad, pero casi sin solicitudes a través de la web.',work:'Experiencia, pruebas y la ruta de solicitud más clara, con atención a la visibilidad orgánica en IA.',period:'La web estuvo activa aproximadamente seis semanas en este caso.',stats:['2 → 19 solicitudes al mes','0 → 15 menciones en IA'],proof:'verena-proof.webp',proofLabel:'Ver la mención de IA'}
  ],
}[locale];
---
<section class="py-12 md:py-16"><div class="max-w-6xl mx-auto px-4 md:px-6"><h2 class="font-heading mb-5">{i18n.heading}</h2><p class="text-text-muted max-w-3xl mb-8">{i18n.intro}</p><div class="grid md:grid-cols-2 gap-6">{casesData.map(c=><article class="p-6 md:p-8 rounded-card border border-border bg-white"><div class="flex items-center gap-4 mb-6"><img src={'/lander-assets/proof/'+c.photo} alt={c.name} width="64" height="64" loading="lazy" class="rounded-full w-16 h-16 object-cover" /><strong>{c.name}</strong></div><h3 class="font-heading mb-5">{c.title}</h3><p class="text-text-muted mb-4"><strong class="text-text">{i18n.start}</strong>{c.before}</p><p class="text-text-muted mb-4"><strong class="text-text">{i18n.work}</strong>{c.work}</p><p class="text-text-muted mb-5"><strong class="text-text">{i18n.period}</strong>{c.period}</p><ul class="space-y-2 mb-6">{c.stats.map(stat=><li class="font-bold text-primary">{stat}</li>)}</ul><a href={'/lander-assets/proof/'+c.proof} target="_blank" rel="noopener noreferrer" class="text-primary font-bold block mb-5"><img src={'/lander-assets/proof/'+c.proof} alt={c.proofLabel+' — '+c.name} loading="lazy" decoding="async" style="display:block;width:100%;height:auto;border-radius:8px;margin-bottom:12px" /><span>{c.proofLabel} ↗</span></a><a href={i18n.ctaHref} class="text-primary font-bold">{i18n.cta} ↗</a></article>)}</div></div></section>
