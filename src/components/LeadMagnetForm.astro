---
import { trackOnClick } from '../lib/analytics';
import type { Locale } from '../data/site';
import type { PageType } from '../lib/analytics';
import { t } from '../i18n/utils';

interface Props {
  pageSlug: string;
  deliveryFileUrl?: string;
  locale?: Locale;
}

const {
  pageSlug,
  deliveryFileUrl,
  locale = 'de',
} = Astro.props;

const formId = `lm-form-${pageSlug}`;
---

<div class="bg-bg-alt rounded-card p-6 md:p-8 border border-border" id={`${formId}-wrapper`}>
  <h3 class="font-heading text-xl text-text mb-2">
    {t('leadMagnet.downloadHeading', locale)}
  </h3>
  <p class="text-sm text-text-muted mb-5">
    {t('leadMagnet.downloadSubtext', locale)}
  </p>
  <form
    id={formId}
    class="flex flex-col sm:flex-row gap-3"
    data-page-slug={pageSlug}
    data-locale={locale}
    data-delivery-url={deliveryFileUrl ?? ''}
  >
    <label for={`${formId}-email`} class="sr-only">{t('leadMagnet.emailPlaceholder', locale)}</label>
    <input
      id={`${formId}-email`}
      type="email"
      name="email"
      required
      placeholder={t('leadMagnet.emailPlaceholder', locale)}
      class="flex-1 px-4 py-3 rounded-button text-sm text-text bg-white border border-border focus:outline-none focus:ring-2 focus:ring-accent"
    />
    <button
      type="submit"
      class="inline-flex items-center justify-center gap-2 px-6 py-3 text-sm font-medium text-text-inverse bg-primary hover:bg-primary-dark rounded-button transition-colors"
    >
      {t('cta.downloadFree', locale)}
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
      </svg>
    </button>
  </form>

  <div class="lm-success hidden mt-6 text-center">
    <div class="inline-flex items-center justify-center w-12 h-12 bg-accent/10 text-accent rounded-full mb-3">
      <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
      </svg>
    </div>
    <h4 class="font-heading text-lg text-text mb-1">{t('leadMagnet.successHeading', locale)}</h4>
    <p class="text-sm text-text-muted" aria-live="polite">{t('leadMagnet.successMessage', locale)}</p>
  </div>
</div>

<script is:inline>
(function() {
  document.querySelectorAll('form[id^="lm-form-"]').forEach(function(form) {
    if (form.dataset.bound) return;
    form.dataset.bound = '1';
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var email = form.querySelector('input[type="email"]').value;
      if (!email) return;
      var data = form.dataset;
      if (typeof trackEvent === 'function') {
        trackEvent('lead_magnet_download', {
          page_type: 'lead_magnet',
          page_slug: data.pageSlug || '',
          locale: data.locale || 'de',
          provider: 'placeholder',
        });
      }
      form.style.display = 'none';
      var wrapper = form.parentElement;
      var msg = wrapper.querySelector('.lm-success');
      if (msg) msg.classList.remove('hidden');
    });
  });
})();
</script>
