---
/**
 * BlogToProductBridge — contextual bridge from a cluster article to the
 * cluster's primary product.
 *
 * Based on CLUSTER_ARCHITECTURE_V1.2 §4.3
 *
 * Renders only if:
 * - The article has a `cluster` field
 * - The cluster YAML exists and has a `primaryProduct`
 * - The referenced product actually exists in the produkte collection
 *
 * If none of these conditions are met, renders nothing.
 * No hardcoded slugs — everything resolved from cluster graph.
 */
import { getCluster, getClusterPrimaryProduct } from '../lib/clusters';
import { trackOnClick } from '../lib/analytics';
import { t, getCollectionBasePath } from '../i18n/utils';
import type { Locale } from '../data/site';

interface Props {
  clusterSlug: string;
  sourcePageSlug: string;
  locale?: Locale;
}

const { clusterSlug, sourcePageSlug, locale = 'de' } = Astro.props;

const cluster = getCluster(clusterSlug);
const product = await getClusterPrimaryProduct(clusterSlug, locale);

// Analytics
const productBasePath = getCollectionBasePath('produkte', locale);

const analyticsProps = product ? {
  page_type: 'article' as const,
  page_slug: sourcePageSlug,
  locale,
  product: product.data.pageSlug,
  product_type: product.data.productType || 'guide',
  product_cluster: clusterSlug,
  source_page_type: 'article' as const,
  source_cluster: clusterSlug,
  cta_location: 'inline' as const,
} : null;
---

{product && cluster && (
  <aside class="my-12 md:my-16" aria-label={locale === 'en' ? 'Product recommendation' : 'Produktempfehlung'}>
    <div class="bg-gradient-to-br from-primary/5 to-accent/5 border border-accent/20 rounded-card p-6 md:p-8">
      <div class="flex flex-col md:flex-row md:items-center gap-6">
        <div class="flex-1">
          <span class="inline-flex items-center px-2.5 py-0.5 text-xs font-medium bg-accent/10 text-accent-dark rounded-full mb-3">
            {cluster.shortTitle || cluster.title}
          </span>
          <h3 class="font-heading text-xl md:text-2xl text-text mb-2">
            {product.data.title}
          </h3>
          <p class="text-sm text-text-muted leading-relaxed mb-4 md:mb-0">
            {product.data.shortDescription}
          </p>
        </div>
        <div class="flex flex-col items-start md:items-end gap-3 shrink-0">
          <span class="text-2xl font-heading font-bold text-text">{product.data.price} &euro;</span>
          <a
            href={`${productBasePath}/${product.data.pageSlug}`}
            class="inline-flex items-center px-6 py-3 text-sm font-medium text-text-inverse bg-primary hover:bg-primary-dark transition-colors rounded-button shadow-md"
            onclick={trackOnClick('product_cta_click', analyticsProps!)}
          >
            {t('cta.learnMore', locale)}
            <svg class="ml-2 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </aside>
)}
