---
/**
 * CTAReassurance — small bullets below a CTA button.
 *
 * Shows 2–3 reassurance points like "Instant access", "Self-paced",
 * "One-time payment". Keeps CTAs from feeling like a leap of faith.
 */
interface Props {
  bullets: string[];
}

const { bullets } = Astro.props;
if (bullets.length === 0) return;
---

<div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-1 mt-4">
  {bullets.map((bullet) => (
    <span class="inline-flex items-center gap-1.5 text-xs text-text-muted">
      <svg class="w-3.5 h-3.5 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
      </svg>
      {bullet}
    </span>
  ))}
</div>
