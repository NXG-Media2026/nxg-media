---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { EventName, CTALocation, PageType } from '../lib/analytics';
import { trackOnClick } from '../lib/analytics';
import type { Locale } from '../data/site';

interface Props {
  title: string;
  subtitle: string;
  ctaText: string;
  ctaHref: string;
  secondaryCtaText?: string;
  secondaryCtaHref?: string;
  backgroundImage?: ImageMetadata | string;
  backgroundAlt?: string;
  locale?: Locale;
  pageType?: PageType;
  pageSlug?: string;
  eventName?: EventName;
}

const {
  title,
  subtitle,
  ctaText,
  ctaHref,
  secondaryCtaText,
  secondaryCtaHref,
  backgroundImage,
  backgroundAlt = '',
  locale = 'de',
  pageType = 'homepage',
  pageSlug = '/',
  eventName = 'product_cta_click',
} = Astro.props;

const trackProps = { page_type: pageType, page_slug: pageSlug, locale, cta_location: 'hero' as CTALocation };
---

<section class="relative overflow-hidden bg-primary-dark text-white min-h-[60vh] md:min-h-[80vh] flex items-center">
  {backgroundImage ? (
    <div class="absolute inset-0">
      {typeof backgroundImage === 'string' ? (
        <img
          src={backgroundImage}
          alt={backgroundAlt}
          width="1920"
          height="1280"
          class="w-full h-full object-cover"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      ) : (
        <Image
          src={backgroundImage}
          alt={backgroundAlt}
          widths={[768, 1280, 1920]}
          sizes="100vw"
          class="w-full h-full object-cover"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      )}
      <div class="absolute inset-0 bg-gradient-to-r from-primary-dark/95 via-primary-dark/75 to-primary-dark/30"></div>
      <div class="absolute bottom-0 inset-x-0 h-24 bg-gradient-to-t from-primary-dark/50 to-transparent"></div>
    </div>
  ) : (
    <div class="absolute inset-0 bg-gradient-to-br from-primary-dark via-primary to-primary-dark"></div>
  )}

  <div class="absolute top-1/3 right-1/4 w-[600px] h-[600px] rounded-full bg-white/5 blur-[120px] pointer-events-none"></div>

  <div class="relative max-w-7xl mx-auto px-4 md:px-6 py-24 md:py-32 lg:py-40 w-full">
    <div class="max-w-2xl js-reveal">
      <div class="w-12 h-1 bg-accent-light rounded-full mb-8"></div>

      <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl xl:text-7xl leading-[1.1] mb-6">
        {title}
      </h1>
      <p class="text-lg md:text-xl text-white/80 leading-relaxed mb-10 max-w-xl">
        {subtitle}
      </p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href={ctaHref}
          class="inline-flex items-center justify-center px-8 py-4 text-base font-medium bg-white text-primary-dark hover:bg-bg transition-all duration-300 rounded-button shadow-lg"
          onclick={trackOnClick(eventName, trackProps)}
        >
          {ctaText}
          <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        {secondaryCtaText && secondaryCtaHref && (
          <a
            href={secondaryCtaHref}
            class="inline-flex items-center justify-center px-8 py-4 text-base font-medium border-2 border-accent text-accent-light hover:bg-accent/15 hover:border-accent-light transition-all duration-300 rounded-button"
          >
            {secondaryCtaText}
          </a>
        )}
      </div>
    </div>
  </div>
</section>
