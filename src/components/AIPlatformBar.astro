---
/**
 * AIPlatformBar — Shows major AI platforms and their scale.
 * Reinforces why AI visibility matters. Used on homepage.
 *
 * All logos are inline SVGs based on official brand marks.
 * If a platform updates their logo, replace the SVG path here.
 */

import type { Locale } from '../data/site';

interface Props {
  locale?: Locale;
  title?: string;
}

const { locale = 'nl', title } = Astro.props;

const titles: Record<string, string> = {
  nl: 'Waar je klanten al zoeken',
  en: 'Where your clients already search',
  es: 'Donde tus clientes ya buscan',
};

const platforms = [
  {
    name: 'ChatGPT',
    stat: { nl: '400M+ gebruikers per week', en: '400M+ weekly users', es: '400M+ usuarios semanales' },
  },
  {
    name: 'Gemini',
    stat: { nl: 'Geïntegreerd in Google Search', en: 'Integrated in Google Search', es: 'Integrado en Google Search' },
  },
  {
    name: 'Perplexity',
    stat: { nl: '15M+ dagelijkse zoekvragen', en: '15M+ daily search queries', es: '15M+ consultas diarias' },
  },
  {
    name: 'Claude',
    stat: { nl: 'Snelst groeiende AI-assistent', en: 'Fastest growing AI assistant', es: 'Asistente IA de más rápido crecimiento' },
  },
];

const sectionTitle = title ?? titles[locale] ?? titles.nl;
---

<section class="py-12 md:py-16">
  <div class="max-w-5xl mx-auto px-4 md:px-6">

    <h2 class="font-heading text-xl md:text-2xl text-text text-center mb-10">{sectionTitle}</h2>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 md:gap-8">
      {platforms.map((p) => (
        <div class="flex flex-col items-center text-center gap-3">
          {/* Logo */}
          <div class="w-12 h-12 flex items-center justify-center">
            {p.name === 'ChatGPT' && (
              <svg class="w-10 h-10" viewBox="0 0 24 24" fill="#10A37F" xmlns="http://www.w3.org/2000/svg" aria-label="ChatGPT logo" role="img">
                <path d="M22.282 9.821a5.985 5.985 0 0 0-.516-4.91 6.046 6.046 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.18a5.998 5.998 0 0 0-3.998 2.9 6.047 6.047 0 0 0 .743 7.097 5.98 5.98 0 0 0 .51 4.911 6.051 6.051 0 0 0 6.515 2.9A5.985 5.985 0 0 0 13.26 24a6.056 6.056 0 0 0 5.772-4.206 5.99 5.99 0 0 0 3.997-2.9 6.056 6.056 0 0 0-.747-7.073zM13.26 22.43a4.476 4.476 0 0 1-2.876-1.04l.141-.081 4.779-2.758a.795.795 0 0 0 .392-.681v-6.737l2.02 1.168a.071.071 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.494 4.494zM3.6 18.304a4.47 4.47 0 0 1-.535-3.014l.142.085 4.783 2.759a.771.771 0 0 0 .78 0l5.843-3.369v2.332a.08.08 0 0 1-.033.062L9.74 19.95a4.5 4.5 0 0 1-6.14-1.646zM2.34 7.896a4.485 4.485 0 0 1 2.366-1.973V11.6a.766.766 0 0 0 .388.676l5.815 3.355-2.02 1.168a.076.076 0 0 1-.071 0l-4.83-2.786A4.504 4.504 0 0 1 2.34 7.872zm16.597 3.855l-5.833-3.387L15.119 7.2a.076.076 0 0 1 .071 0l4.83 2.791a4.494 4.494 0 0 1-.676 8.105v-5.678a.79.79 0 0 0-.407-.667zm2.01-3.023l-.141-.085-4.774-2.782a.776.776 0 0 0-.785 0L9.409 9.23V6.897a.066.066 0 0 1 .028-.061l4.83-2.787a4.5 4.5 0 0 1 6.68 4.66zm-12.64 4.135l-2.02-1.164a.08.08 0 0 1-.038-.057V6.075a4.5 4.5 0 0 1 7.375-3.453l-.142.08L8.704 5.46a.795.795 0 0 0-.393.681zm1.097-2.365l2.602-1.5 2.607 1.5v2.999l-2.597 1.5-2.607-1.5z"/>
              </svg>
            )}
            {p.name === 'Gemini' && (
              <svg class="w-10 h-10" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-label="Google Gemini logo" role="img">
                <defs>
                  <linearGradient id="gemini-g" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0%" stop-color="#4285F4"/>
                    <stop offset="35%" stop-color="#9B72CB"/>
                    <stop offset="65%" stop-color="#D96570"/>
                    <stop offset="100%" stop-color="#D96570"/>
                  </linearGradient>
                </defs>
                <path d="M12 0C12 6.627 6.627 12 0 12c6.627 0 12 5.373 12 12 0-6.627 5.373-12 12-12C17.373 12 12 6.627 12 0z" fill="url(#gemini-g)"/>
              </svg>
            )}
            {p.name === 'Perplexity' && (
              <svg class="w-10 h-10" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Perplexity logo" role="img">
                <path d="M7.55 3.2V9.5H4.75V11.25H7.55V17.1L4 20.25V21.5H10.15V14.5H13.85V21.5H20V20.25L16.45 17.1V11.25H19.25V9.5H16.45V3.2L12 6.75L7.55 3.2Z" fill="#20808D"/>
                <path d="M12 6.75V14.5" stroke="#20808D" stroke-width="1.2"/>
                <path d="M10.15 9.5V2.5L12 6.75L13.85 2.5V9.5" fill="#20808D"/>
              </svg>
            )}
            {p.name === 'Claude' && (
              <svg class="w-10 h-10" viewBox="0 0 24 24" fill="#D97757" xmlns="http://www.w3.org/2000/svg" aria-label="Claude logo" role="img">
                <path d="M4.709 15.955l4.397-2.006-.893-2.16L4.35 13.42a.463.463 0 0 0-.263.598l.622 1.937zM8.68 7.092l-3.174 3.47a.463.463 0 0 0 .076.666l1.6 1.198 3.097-3.803L8.68 7.092zM11.468 2.2L9.267 6.234l1.832 1.378L13.37 3.28a.463.463 0 0 0-.232-.613L11.468 2.2zM14.636 2.656l-1.33 5.04 2.225.587 1.003-4.67a.463.463 0 0 0-.375-.534l-1.523-.423zM18.34 6.2l-3.614 3.174 1.338 1.67 3.313-2.898a.463.463 0 0 0 .054-.664L18.34 6.2zM19.648 11.85l-4.876.363.163 2.236 4.564-.014a.463.463 0 0 0 .45-.475l-.301-2.11zM17.456 16.88l-3.782-2.72-1.26 1.74 3.49 2.923a.463.463 0 0 0 .66-.078l.892-1.865zM12.9 20.088l-.67-4.856-2.18.5.23 4.68a.463.463 0 0 0 .512.42l2.108-.744zM7.47 17.6l2.48-4.06-1.932-1.08-2.164 3.878a.463.463 0 0 0 .2.638l1.416.625z"/>
              </svg>
            )}
          </div>

          {/* Platform name */}
          <p class="font-heading text-base font-semibold text-text">{p.name}</p>

          {/* Stat */}
          <p class="text-xs text-text-muted leading-snug">{p.stat[locale]}</p>
        </div>
      ))}
    </div>

  </div>
</section>
