---
/**
 * VideoTestimonialCarousel — horizontal scrolling carousel with video thumbnails,
 * star ratings, names, companies, and quotes. Videos play in a lightbox overlay.
 *
 * Videos go in /src/assets/videos/testimonials/ (or provide a YouTube/external URL).
 * Thumbnails go in /src/assets/images/testimonials/.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { siteConfig } from '../data/site';

export interface VideoTestimonial {
  id: string;
  name: string;
  company: string;
  quote: string;
  rating: number;
  thumbnail: ImageMetadata;
  videoUrl?: string; // YouTube/Vimeo URL or local path — empty = thumbnail only
  uploadDate?: string; // ISO date e.g. '2024-06-15'
}

interface Props {
  title?: string;
  subtitle?: string;
  testimonials: VideoTestimonial[];
}

const {
  title = 'Wat Klanten Zeggen Over Werken met Joost',
  subtitle = 'Echte ervaringen van ondernemers die succesvol samenwerken met Joost',
  testimonials,
} = Astro.props;

function renderStars(rating: number): string {
  return '★'.repeat(Math.min(rating, 5)) + '☆'.repeat(Math.max(0, 5 - rating));
}

// Build VideoObject schema for each video with a URL
const baseUrl = siteConfig.url;
const videoSchemaScripts = testimonials
  .filter((v) => v.videoUrl)
  .map((v) => {
    const schema = {
      '@context': 'https://schema.org',
      '@type': 'VideoObject',
      name: `Testimonial ${v.name} — ${v.company}`,
      description: v.quote,
      contentUrl: v.videoUrl!.startsWith('http') ? v.videoUrl : `${baseUrl}${v.videoUrl}`,
      thumbnailUrl: `${baseUrl}${v.thumbnail.src}`,
      uploadDate: v.uploadDate ?? '2024-01-01',
      inLanguage: /[a-z]{4,}/i.test(v.quote) && !/[àáâãäåèéêëìíîïòóôõöùúûü]/i.test(v.quote) ? 'en' : 'nl',
      publisher: { '@type': 'Organization', name: siteConfig.name, url: baseUrl },
    };
    return `<script type="application/ld+json">${JSON.stringify(schema)}<\/script>`;
  })
  .join('\n');
---

<section class="py-16 md:py-24">
  <div class="max-w-6xl mx-auto px-4 md:px-6">

    {/* Heading */}
    <div class="text-center mb-10">
      <h2 class="font-heading text-2xl md:text-3xl lg:text-4xl text-text mb-3">{title}</h2>
      {subtitle && <p class="text-text-muted max-w-xl mx-auto">{subtitle}</p>}
    </div>

    {/* Carousel wrapper with nav arrows */}
    <div class="relative">
      {/* Nav arrows — desktop only */}
      <button
        type="button"
        class="vtc-prev hidden md:flex absolute -left-4 lg:-left-6 top-1/2 -translate-y-1/2 z-10 w-10 h-10 items-center justify-center rounded-full bg-white border border-border shadow-md hover:shadow-lg hover:border-accent/40 transition-all disabled:opacity-30 disabled:cursor-default"
        aria-label="Vorige"
      >
        <svg class="w-5 h-5 text-text" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
      </button>
      <button
        type="button"
        class="vtc-next hidden md:flex absolute -right-4 lg:-right-6 top-1/2 -translate-y-1/2 z-10 w-10 h-10 items-center justify-center rounded-full bg-white border border-border shadow-md hover:shadow-lg hover:border-accent/40 transition-all disabled:opacity-30 disabled:cursor-default"
        aria-label="Volgende"
      >
        <svg class="w-5 h-5 text-text" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </button>

      {/* Carousel track */}
      <div class="vtc-track flex gap-6 overflow-x-auto snap-x snap-mandatory scrollbar-hide pb-4 scroll-smooth">
        {testimonials.map((t) => (
          <div class="vtc-card snap-start shrink-0 w-[280px] md:w-[300px] bg-bg-alt rounded-card border border-border flex flex-col overflow-hidden">

            {/* Thumbnail */}
            <div class="relative aspect-video bg-text/5 overflow-hidden group cursor-pointer" data-video-url={t.videoUrl ?? ''} data-video-title={`Testimonial ${t.name} — ${t.company}`}>
              <Image
                src={t.thumbnail}
                alt={`Video testimonial van ${t.name}, ${t.company}`}
                widths={[300, 450]}
                sizes="300px"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
              {/* Play button overlay */}
              {t.videoUrl && (
                <div class="absolute inset-0 flex items-center justify-center">
                  <div class="w-14 h-14 rounded-full bg-white/90 shadow-lg flex items-center justify-center group-hover:bg-white transition-colors">
                    <svg class="w-6 h-6 text-accent ml-0.5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </div>
                </div>
              )}
            </div>

            {/* Content */}
            <div class="p-5 flex flex-col flex-1">
              {/* Stars */}
              <div class="text-accent text-lg tracking-wide mb-3" aria-label={`${t.rating} van 5 sterren`}>
                {renderStars(t.rating)}
              </div>

              {/* Name + company */}
              <p class="font-heading text-base text-text font-semibold">{t.name}</p>
              <p class="text-xs text-text-muted mb-3">{t.company}</p>

              {/* Quote */}
              <blockquote class="text-sm text-text-muted leading-relaxed italic flex-1">
                &ldquo;{t.quote}&rdquo;
              </blockquote>
            </div>
          </div>
        ))}
      </div>

      {/* Dot indicators */}
      <div class="vtc-dots flex justify-center gap-2 mt-4">
        {testimonials.map((_, i) => (
          <button
            type="button"
            class={`w-2.5 h-2.5 rounded-full transition-colors ${i === 0 ? 'bg-accent' : 'bg-border hover:bg-accent/50'}`}
            aria-label={`Ga naar testimonial ${i + 1}`}
            data-dot-index={i}
          />
        ))}
      </div>
    </div>

  </div>
</section>

{/* VideoObject structured data for SEO */}
<Fragment set:html={videoSchemaScripts} />

{/* Video lightbox */}
<div id="vtc-lightbox" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/80 backdrop-blur-sm p-4">
  <button id="vtc-close" type="button" class="absolute top-4 right-4 w-10 h-10 rounded-full bg-white/20 hover:bg-white/30 flex items-center justify-center text-white transition-colors" aria-label="Sluiten">
    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
    </svg>
  </button>
  <div id="vtc-player" class="w-full max-w-3xl aspect-video rounded-lg overflow-hidden bg-black"></div>
</div>

<style>
  /* Hide scrollbar but keep scroll behavior */
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  @media (pointer: fine) {
    .vtc-track {
      cursor: grab;
    }
  }
</style>

<script>
  (function () {
    const lightbox = document.getElementById('vtc-lightbox');
    const player = document.getElementById('vtc-player');
    const closeBtn = document.getElementById('vtc-close');
    if (!lightbox || !player || !closeBtn) return;

    // ── Carousel navigation ──
    const track = document.querySelector('.vtc-track') as HTMLElement | null;
    const prevBtn = document.querySelector('.vtc-prev') as HTMLButtonElement | null;
    const nextBtn = document.querySelector('.vtc-next') as HTMLButtonElement | null;
    const dots = document.querySelectorAll('[data-dot-index]') as NodeListOf<HTMLButtonElement>;
    const cards = document.querySelectorAll('.vtc-card') as NodeListOf<HTMLElement>;

    function getCardWidth(): number {
      if (!cards.length || !track) return 300;
      return cards[0].offsetWidth + 24; // card width + gap (gap-6 = 24px)
    }

    function getActiveIndex(): number {
      if (!track) return 0;
      const scrollLeft = track.scrollLeft;
      const cardW = getCardWidth();
      return Math.round(scrollLeft / cardW);
    }

    function updateDots(index: number) {
      dots.forEach((dot, i) => {
        dot.classList.toggle('bg-accent', i === index);
        dot.classList.toggle('bg-border', i !== index);
        dot.classList.toggle('hover:bg-accent/50', i !== index);
      });
    }

    function updateArrows() {
      if (!track || !prevBtn || !nextBtn) return;
      const atStart = track.scrollLeft <= 4;
      const atEnd = track.scrollLeft + track.clientWidth >= track.scrollWidth - 4;
      prevBtn.disabled = atStart;
      nextBtn.disabled = atEnd;
    }

    function scrollToIndex(index: number) {
      if (!track) return;
      const cardW = getCardWidth();
      track.scrollTo({ left: index * cardW, behavior: 'smooth' });
    }

    if (track) {
      // Arrow buttons
      prevBtn?.addEventListener('click', () => {
        const idx = Math.max(0, getActiveIndex() - 1);
        scrollToIndex(idx);
      });

      nextBtn?.addEventListener('click', () => {
        const maxIdx = cards.length - 1;
        const idx = Math.min(maxIdx, getActiveIndex() + 1);
        scrollToIndex(idx);
      });

      // Dot buttons
      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          const idx = parseInt(dot.dataset.dotIndex ?? '0', 10);
          scrollToIndex(idx);
        });
      });

      // Update on scroll
      let scrollTimer: ReturnType<typeof setTimeout>;
      track.addEventListener('scroll', () => {
        clearTimeout(scrollTimer);
        scrollTimer = setTimeout(() => {
          updateDots(getActiveIndex());
          updateArrows();
        }, 50);
      }, { passive: true });

      // Enable mouse drag to scroll on desktop
      let isDragging = false;
      let startX = 0;
      let scrollLeft = 0;

      track.addEventListener('mousedown', (e) => {
        isDragging = true;
        startX = e.pageX - track.offsetLeft;
        scrollLeft = track.scrollLeft;
        track.style.cursor = 'grabbing';
        track.style.userSelect = 'none';
      });

      track.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        e.preventDefault();
        const x = e.pageX - track.offsetLeft;
        const walk = (x - startX) * 1.5;
        track.scrollLeft = scrollLeft - walk;
      });

      const stopDrag = () => {
        isDragging = false;
        track.style.cursor = '';
        track.style.userSelect = '';
      };

      track.addEventListener('mouseup', stopDrag);
      track.addEventListener('mouseleave', stopDrag);

      // Initial state
      updateArrows();
      updateDots(0);
    }

    // ── Lightbox (video playback) ──
    document.querySelectorAll('[data-video-url]').forEach((el) => {
      const url = (el as HTMLElement).dataset.videoUrl;
      const videoTitle = (el as HTMLElement).dataset.videoTitle || 'Video testimonial';
      if (!url) return;

      el.addEventListener('click', () => {
        // YouTube embed
        if (url.includes('youtube.com') || url.includes('youtu.be')) {
          const id = url.includes('youtu.be')
            ? url.split('/').pop()
            : new URLSearchParams(new URL(url).search).get('v');
          player.innerHTML = `<iframe src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1" class="w-full h-full" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen title="${videoTitle}"></iframe>`;
        }
        // Vimeo
        else if (url.includes('vimeo.com')) {
          const id = url.split('/').pop();
          player.innerHTML = `<iframe src="https://player.vimeo.com/video/${id}?autoplay=1" class="w-full h-full" frameborder="0" allow="autoplay" allowfullscreen title="${videoTitle}"></iframe>`;
        }
        // Direct video file
        else {
          player.innerHTML = `<video src="${url}" class="w-full h-full" controls autoplay title="${videoTitle}" aria-label="${videoTitle}"></video>`;
        }

        lightbox.classList.remove('hidden');
        lightbox.classList.add('flex');
      });
    });

    function closeLightbox() {
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      player.innerHTML = '';
    }

    closeBtn.addEventListener('click', closeLightbox);
    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
    });
  })();
</script>
