---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import CTABand from '../components/CTABand.astro';
import { siteConfig } from '../data/site';
import { generateCollectionPage, generateBreadcrumbs } from '../data/schema';
import { t } from '../i18n/utils';
import { buildHreflangPair } from '../i18n/hreflang';

const breadcrumbs = [
  { label: t('breadcrumb.home'), href: '/' },
  { label: t('nav.angebot') },
];

const breadcrumbSchema = breadcrumbs.map((b) => ({
  name: b.label,
  url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}/angebot`,
}));

const offerings = [
  {
    title: 'Produkte',
    href: '/produkte',
    description: 'Digitale Guides, E-Books und Kurse — wissenschaftlich fundiert und sofort umsetzbar.',
    details: 'Von Hormonbalance über zyklusbewusstes Training bis Ernährung: Produkte auf aktueller Studienlage, die erklären, was generischer Rat am weiblichen Körper falsch macht.',
    icon: 'M12 6.042A8.967 8.967 0 006 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 016 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 016-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0018 18a8.967 8.967 0 00-6 2.292m0-14.25v14.25',
  },
  {
    title: 'Coaching',
    href: '/coaching',
    description: 'Individuelles Coaching für deine Gesundheitsziele — persönlich begleitet von Dr. Verena.',
    details: '1:1, Gruppen- oder Hybrid-Coaching: Gemeinsam entwickeln wir einen Plan, der zu dir, deinem Zyklus und deinem Leben passt. Evidenzbasiert und mit persönlicher Begleitung.',
    icon: 'M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z',
  },
  {
    title: 'Mitgliedschaft',
    href: '/mitgliedschaft',
    description: 'Community, laufende Begleitung und exklusive Inhalte — gemeinsam stärker.',
    details: 'Werde Teil einer Community von Frauen, die ihre Gesundheit ernst nehmen. Regelmäßige Live-Calls, exklusive Inhalte und gegenseitige Unterstützung.',
    icon: 'M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12z',
  },
];
---

<BaseLayout
  title={`Angebot | ${siteConfig.name}`}
  description="Produkte, Coaching und Mitgliedschaft — wissenschaftlich fundierte Frauen-Gesundheit von Dr. Verena."
  hreflang={buildHreflangPair('/angebot', '/en/offers')}
  schemas={[
    generateCollectionPage({
      name: 'Angebot',
      url: `${siteConfig.url}/angebot`,
      description: 'Produkte, Coaching und Mitgliedschaft für wissenschaftlich fundierte Frauen-Gesundheit.',
    }),
    generateBreadcrumbs(breadcrumbSchema),
  ]}
  locale="de"
>
  <BreadcrumbNav items={breadcrumbs} />

  <section class="py-16 md:py-24 lg:py-32 bg-bg">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <div class="text-center mb-14 md:mb-20">
        <h1 class="font-heading text-4xl md:text-5xl text-text mb-4">
          Angebot
        </h1>
        <p class="text-lg text-text-muted max-w-2xl mx-auto">
          Wissen und Begleitung für jede Phase deiner Gesundheitsreise — von digitalen Produkten über individuelles Coaching bis zur Community.
        </p>
      </div>

      <div class="space-y-8">
        {offerings.map((item, idx) => (
          <a
            href={item.href}
            class:list={[
              'group block bg-white border border-border rounded-card p-8 md:p-10',
              'hover:border-accent/30 hover:shadow-xl transition-all duration-300',
              'js-reveal',
            ]}
            style={`--reveal-delay: ${idx * 100}ms`}
          >
            <div class="flex items-start gap-6">
              <div class="w-14 h-14 rounded-full bg-accent-light flex items-center justify-center shrink-0">
                <svg class="w-6 h-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d={item.icon} />
                </svg>
              </div>
              <div class="flex-1">
                <h2 class="font-heading text-2xl text-text mb-2 group-hover:text-accent transition-colors">
                  {item.title}
                </h2>
                <p class="text-text-muted font-medium mb-3">{item.description}</p>
                <p class="text-sm text-text-muted leading-relaxed mb-4">{item.details}</p>
                <span class="inline-flex items-center text-sm font-medium text-accent-dark group-hover:underline underline-offset-2">
                  {t('cta.learnMore')}
                  <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTABand
    title="Nicht sicher, was zu dir passt?"
    subtitle="Schreib mir — gemeinsam finden wir das passende Angebot für dich."
    ctaText="Kontakt aufnehmen"
    ctaHref="/kontakt"
    eventName="discovery_call_click"
    locale="de"
    pageType="page"
    pageSlug="/angebot"
  />
</BaseLayout>
