---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import { siteConfig } from '../data/site';
import { generateBreadcrumbs, generateFAQPage, generateService } from '../data/schema';
import { getTestimonials } from '../data/testimonials';

import heroPhoto from '../assets/images/founder/joost-sitting-laptop-lookingfront.webp';
import founderPhoto from '../assets/images/founder/joost-standing-relaxed.webp';
import verenaPhoto from '../assets/images/cases/verena-mann-linkedin.webp';
import jamesPhoto from '../assets/images/cases/james-mitchell-portrait.png';
import proofVerenaAi from '../assets/images/cases/doc_veri_ai_answer_cropped.PNG';
import proofVerenaChatgpt from '../assets/images/cases/doc-veri-chatgptproof.jpeg';
import proofGoogle from '../assets/images/cases/proof-google-torrevieja.png';
import proofChatgpt from '../assets/images/cases/proof-chatgpt-local.png';

import josineWhatsApp from '../assets/images/cases/coachjosine_whatsapp_proof.png';
import josineProduct from '../assets/images/cases/eetgids-coachjosine-product-proof.webp';
import tessaWhatsApp from '../assets/images/cases/tessa-youlife-whatsapp-proof.webp';
import rolfWhatsApp from '../assets/images/cases/rolf-happywithyoga-whatsapp-proof.webp';

const locale = 'nl';
const testimonials = getTestimonials({ locale: 'nl' });

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logos/*.{webp,avif,png,jpg}', { eager: true });
const logos = Object.entries(logoFiles)
  .filter(([path]) => /logo/i.test(path.split('/').pop()!))
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/, '');
    const name = filename.replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim();
    return { src: mod.default, alt: name };
  });

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'AI Expert Groei Traject' },
];

const faqItems = [
  {
    question: 'Is dit gewoon AI-vindbaarheid?',
    answer: 'AI-vindbaarheid is de ingang en diagnose. Het traject gaat over het fundament erachter: positionering, bewijs, content, instaproute en opvolging. Beter gevonden worden heeft weinig zin als bezoekers daarna niet begrijpen waarom jij de logische keuze bent.',
  },
  {
    question: 'Moet ik meteen een online platform bouwen?',
    answer: 'De eerste fase is bewust klein: een duidelijke positionering, een eerste instaproute en bewijs dat mensen willen instappen. Pas als dat werkt, bouwen we door. Veel coaches starten niet in fase 3 — ze starten met een compacte route die bewijs oplevert.',
  },
  {
    question: 'Werken advertenties nog voor coaches?',
    answer: 'Directe advertenties naar een duur traject of salescall zijn vaak lastig. Daarom bouwen we meestal eerst een tussenstap zoals een gids, scan, masterclass of mini-product. Dat verlaagt de instapdrempel en bouwt vertrouwen op voordat iemand een gesprek inplant.',
  },
  {
    question: 'Wat als ik al een website heb?',
    answer: 'Dan kijken we wat bruikbaar is en wat scherper moet. Soms bouwen we door op wat er staat, soms is een nieuw fundament logischer. Het gaat niet om de techniek, maar om of je expertise duidelijk genoeg overkomt voor bezoekers en AI.',
  },
  {
    question: 'Is dit geschikt als ik nog geen groot publiek heb?',
    answer: 'Een groot publiek is geen voorwaarde, zolang je expertise en aanbod duidelijk genoeg zijn. Met een kleine route testen we waar mensen op reageren. Vaak begint groei niet bij meer bereik, maar bij een scherpere positionering en een duidelijkere eerste stap.',
  },
];

const faqForSchema = faqItems.map((item) => ({ question: item.question, answer: item.answer }));
const faqForComponent = faqItems.map((item) => ({ q: item.question, a: item.answer }));

const serviceSchema = generateService({
  name: 'AI Expert Groei Traject',
  description: 'Bouw een AI-ready expertfundament rond je expertise. Voor coaches en experts die beter gevonden willen worden en een route willen bouwen naar aanvragen, producten en coachingklanten.',
  url: `${siteConfig.url}/ai-expert-groei-traject/`,
  serviceType: 'Expert Growth System',
});
---

<BaseLayout
  title="AI Expert Groei Traject voor Coaches & Experts | NXG Media"
  description="Bouw een AI-ready expertfundament rond je expertise. Voor coaches en experts die beter gevonden willen worden en een route willen bouwen naar aanvragen, producten en coachingklanten."
  canonical={`${siteConfig.url}/ai-expert-groei-traject/`}
  schemas={[
    generateBreadcrumbs(breadcrumbs.map((b) => ({ name: b.label, url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}/ai-expert-groei-traject/` }))),
    generateFAQPage(faqForSchema),
    serviceSchema,
  ]}
  locale={locale}
>
  <BreadcrumbNav items={breadcrumbs} />

  {/* ── 1. HERO ── */}
  <section class="relative py-20 md:py-28 lg:py-36 overflow-hidden">
    <div class="absolute inset-0">
      <Image
        src={heroPhoto}
        alt="Joost van Putten — online groei-strateeg voor coaches en experts"
        widths={[800, 1200, 1600]}
        sizes="100vw"
        class="w-full h-full object-cover"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-white/95 via-white/85 to-white/40"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 md:px-6">
      <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl text-text mb-6 leading-tight max-w-2xl">
        Word de expert die AI begrijpt &mdash; en klanten weten te kiezen
      </h1>
      <p class="text-lg md:text-xl text-text-muted leading-relaxed mb-10 max-w-xl">
        Voor coaches, therapeuten en experts die niet alleen beter gevonden willen worden in ChatGPT, Gemini en Google, maar hun expertise willen omzetten in een duidelijke route naar aanvragen, producten en coachingklanten.
      </p>
      <div class="flex flex-col sm:flex-row items-start gap-4">
        <a
          href="#analyse"
          class="inline-flex items-center px-8 py-4 text-base font-medium text-text-inverse bg-primary hover:bg-primary-dark transition-colors rounded-button shadow-lg"
        >
          Vraag mijn persoonlijke analyse aan
          <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a
          href="#oplossing"
          class="inline-flex items-center px-8 py-4 text-base font-medium text-primary border-2 border-primary hover:bg-primary/5 transition-colors rounded-button"
        >
          Bekijk hoe het traject werkt
        </a>
      </div>
      <p class="text-xs text-text-muted mt-4">
        AI-vindbaarheid als ingang. Een compleet expertfundament als oplossing.
      </p>
    </div>
  </section>

  {/* ── Proof Stats ── */}
  <section class="bg-bg-alt border-y border-border">
    <div class="max-w-4xl mx-auto px-4 md:px-6 py-8 md:py-10">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <div class="font-heading text-2xl md:text-3xl text-primary">19/mnd</div>
          <p class="text-xs text-text-muted mt-1">aanvragen na fundament</p>
          <p class="text-xs text-accent font-medium mt-0.5">Dr. Verena Mann</p>
        </div>
        <div>
          <div class="font-heading text-2xl md:text-3xl text-primary">600&times;</div>
          <p class="text-xs text-text-muted mt-1">gids verkocht in 4 mnd</p>
          <p class="text-xs text-accent font-medium mt-0.5">Coach Josine</p>
        </div>
        <div>
          <div class="font-heading text-2xl md:text-3xl text-primary">&euro;10k/mnd</div>
          <p class="text-xs text-text-muted mt-1">online productomzet</p>
          <p class="text-xs text-accent font-medium mt-0.5">Youlife</p>
        </div>
        <div>
          <div class="font-heading text-2xl md:text-3xl text-primary">2.000</div>
          <p class="text-xs text-text-muted mt-1">betalende platformleden</p>
          <p class="text-xs text-accent font-medium mt-0.5">Happy With Yoga</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── 2. REFRAME ── */}
  <section class="py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/10 text-accent rounded-full mb-4 uppercase tracking-wider">AI-vindbaarheid is niet het einddoel</span>
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-6">
        Je AI-score laat zien hoe duidelijk jouw expertise online begrepen wordt
      </h2>
      <p class="text-text-muted leading-relaxed mb-4">
        Als AI jou niet goed begrijpt, is dat vaak geen los technisch probleem. Het is meestal een signaal dat je positionering, bewijs, content, aanbod en volgende stap nog niet scherp genoeg samenkomen.
      </p>
      <p class="text-text-muted leading-relaxed">
        Precies datzelfde probleem voelen potenti&euml;le klanten ook. Ze zien misschien wel dat je kennis hebt, maar niet direct waarom jij de logische keuze bent &mdash; of wat hun eerste stap moet zijn.
      </p>
    </div>
  </section>

  {/* ── 3. PROBLEEM ── */}
  <section class="py-16 md:py-20 bg-primary">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-white mb-8">
        Veel coaches hebben geen kennisprobleem. Ze hebben een systeemprobleem.
      </h2>
      <div class="space-y-4">
        <div class="flex items-start gap-4 bg-white/5 rounded-card p-4 border border-white/10">
          <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
          <p class="text-white/80 leading-relaxed">Je hebt expertise, maar die staat verspreid over losse posts, pagina&rsquo;s en verhalen.</p>
        </div>
        <div class="flex items-start gap-4 bg-white/5 rounded-card p-4 border border-white/10">
          <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
          <p class="text-white/80 leading-relaxed">Mensen volgen je wel, maar zetten geen concrete stap.</p>
        </div>
        <div class="flex items-start gap-4 bg-white/5 rounded-card p-4 border border-white/10">
          <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
          <p class="text-white/80 leading-relaxed">Je aanbod is waardevol, maar nog niet scherp genoeg verpakt.</p>
        </div>
        <div class="flex items-start gap-4 bg-white/5 rounded-card p-4 border border-white/10">
          <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
          <p class="text-white/80 leading-relaxed">Koude advertenties direct naar een salescall werken steeds minder goed.</p>
        </div>
        <div class="flex items-start gap-4 bg-white/5 rounded-card p-4 border border-white/10">
          <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
          <p class="text-white/80 leading-relaxed">Je mist een laagdrempelige tussenstap zoals een gids, scan, masterclass of mini-product.</p>
        </div>
        <div class="flex items-start gap-4 bg-white/5 rounded-card p-4 border border-white/10">
          <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
          <p class="text-white/80 leading-relaxed">Warme interesse verdwijnt omdat er geen duidelijke e-mailopvolging of klantreis is.</p>
        </div>
      </div>
      <p class="text-white font-medium mt-8 text-lg">
        Daarom bouwen we niet alleen aan AI-vindbaarheid. We bouwen het systeem eromheen.
      </p>
    </div>
  </section>

  {/* ── 4. OPLOSSING ── */}
  <section id="oplossing" class="py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <div class="max-w-3xl">
        <h2 class="font-heading text-2xl md:text-3xl text-text mb-3">Het AI-ready Expert Fundament</h2>
        <p class="text-lg text-text-muted leading-relaxed mb-12">
          Een compact groeisysteem dat jouw expertise vindbaar, begrijpelijk en verkoopbaar maakt.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center mb-4">
            <span class="font-heading text-primary text-lg">1</span>
          </div>
          <h3 class="font-heading text-lg text-text mb-2">Gevonden worden</h3>
          <p class="text-sm text-text-muted leading-relaxed">AI, Google en bezoekers begrijpen waarvoor jij de expert bent. Je expertise wordt vindbaar bij de juiste zoekvragen.</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-10 h-10 rounded-full bg-accent/10 flex items-center justify-center mb-4">
            <span class="font-heading text-accent text-lg">2</span>
          </div>
          <h3 class="font-heading text-lg text-text mb-2">Vertrouwen opbouwen</h3>
          <p class="text-sm text-text-muted leading-relaxed">Je methode, bewijs, verhaal en resultaten staan op de juiste plek. Bezoekers begrijpen binnen seconden waarom jij de logische keuze bent.</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center mb-4">
            <span class="font-heading text-primary text-lg">3</span>
          </div>
          <h3 class="font-heading text-lg text-text mb-2">Mensen laten instappen</h3>
          <p class="text-sm text-text-muted leading-relaxed">Een gids, scan, masterclass of mini-product met e-mailopvolging maakt de eerste stap laagdrempelig. Van interesse naar actie.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── 5. 90-DAGEN ── */}
  <section class="py-16 md:py-20 bg-bg-alt">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-3">Wat bouwen we in de eerste 90 dagen?</h2>
      <p class="text-lg text-text-muted leading-relaxed mb-12 max-w-3xl">
        Niet meteen een groot platform. Eerst bouwen we een compacte route die bewijst dat mensen willen instappen.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
        <div class="bg-white rounded-card p-6 border border-border">
          <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-medium bg-primary/10 text-primary rounded-full mb-3">01</span>
          <h3 class="font-heading text-lg text-text mb-2">Expertpositionering</h3>
          <p class="text-sm text-text-muted leading-relaxed">Voor wie ben jij de logische keuze, welk probleem los je op en waarom moeten mensen jou vertrouwen?</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-medium bg-primary/10 text-primary rounded-full mb-3">02</span>
          <h3 class="font-heading text-lg text-text mb-2">Niche- of specialisatiepagina&rsquo;s</h3>
          <p class="text-sm text-text-muted leading-relaxed">Pagina&rsquo;s rond je methode, doelgroep en thema&rsquo;s, zodat AI, Google en bezoekers je expertise beter begrijpen.</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-medium bg-accent/10 text-accent rounded-full mb-3">03</span>
          <h3 class="font-heading text-lg text-text mb-2">Instaproute</h3>
          <p class="text-sm text-text-muted leading-relaxed">Een gids, scan, masterclass of mini-product waarmee mensen laagdrempelig kennis met je maken.</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-medium bg-accent/10 text-accent rounded-full mb-3">04</span>
          <h3 class="font-heading text-lg text-text mb-2">Landingspagina</h3>
          <p class="text-sm text-text-muted leading-relaxed">Een duidelijke pagina die niet alleen informeert, maar mensen naar de volgende stap brengt.</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-medium bg-primary/10 text-primary rounded-full mb-3">05</span>
          <h3 class="font-heading text-lg text-text mb-2">E-mailopvolging</h3>
          <p class="text-sm text-text-muted leading-relaxed">Een korte flow die vertrouwen opbouwt en warme interesse niet laat verdwijnen.</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-medium bg-primary/10 text-primary rounded-full mb-3">06</span>
          <h3 class="font-heading text-lg text-text mb-2">Eerste traffic-test</h3>
          <p class="text-sm text-text-muted leading-relaxed">Met advertenties of bestaande kanalen testen we welke boodschap, doelgroep en instaproute werkt.</p>
        </div>
      </div>

      <p class="text-accent font-medium text-center">
        De eerste 90 dagen zijn bedoeld om bewijs te cre&euml;ren &mdash; niet om meteen een groot platform te bouwen.
      </p>
    </div>
  </section>

  {/* ── 6. WAAROM KOUDE ADS NIET GENOEG ZIJN ── */}
  <section class="py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-6">
        Waarom direct naar een salescall steeds moeilijker wordt
      </h2>
      <p class="text-text-muted leading-relaxed mb-4">
        Veel coaches proberen koude mensen direct naar een gesprek te sturen. Maar voor iemand die jou nog niet kent, is die stap vaak te groot.
      </p>
      <p class="text-text-muted leading-relaxed mb-10">
        Daarom werkt een tussenstap vaak beter: een gids, scan, masterclass of mini-product waarmee iemand eerst je visie, methode en stijl ervaart.
      </p>

      {/* Visuele flow */}
      <div class="bg-bg-alt rounded-card p-6 md:p-8 border border-border">
        <div class="flex flex-col md:flex-row items-stretch gap-3 md:gap-0">
          <div class="flex-1 bg-white rounded-lg p-4 text-center border border-border">
            <div class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-2">
              <span class="text-primary text-sm font-heading">1</span>
            </div>
            <p class="text-xs font-medium text-text">Content, AI of advertentie</p>
            <p class="text-[10px] text-text-muted mt-1">Iemand ontdekt jou</p>
          </div>
          <div class="hidden md:flex items-center px-2 text-accent">&rarr;</div>
          <div class="flex-1 bg-white rounded-lg p-4 text-center border-2 border-accent/30">
            <div class="w-8 h-8 rounded-full bg-accent/10 flex items-center justify-center mx-auto mb-2">
              <span class="text-accent text-sm font-heading">2</span>
            </div>
            <p class="text-xs font-medium text-text">Instaproute</p>
            <p class="text-[10px] text-text-muted mt-1">Gids, scan of masterclass</p>
          </div>
          <div class="hidden md:flex items-center px-2 text-accent">&rarr;</div>
          <div class="flex-1 bg-white rounded-lg p-4 text-center border border-border">
            <div class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center mx-auto mb-2">
              <span class="text-primary text-sm font-heading">3</span>
            </div>
            <p class="text-xs font-medium text-text">E-mailopvolging</p>
            <p class="text-[10px] text-text-muted mt-1">Vertrouwen groeit</p>
          </div>
          <div class="hidden md:flex items-center px-2 text-accent">&rarr;</div>
          <div class="flex-1 bg-white rounded-lg p-4 text-center border border-border">
            <div class="w-8 h-8 rounded-full bg-accent/10 flex items-center justify-center mx-auto mb-2">
              <span class="text-accent text-sm font-heading">4</span>
            </div>
            <p class="text-xs font-medium text-text">Aanvraag of klant</p>
            <p class="text-[10px] text-text-muted mt-1">Warm en gekwalificeerd</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── 7. CASES / PROOF ── */}
  <section class="py-16 md:py-20 bg-primary">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-3xl md:text-4xl text-white mb-3">Van eerste AI-vindbaarheid naar volwassen online platform</h2>
      <p class="text-white/60 text-lg mb-14 max-w-3xl">
        Niet iedere coach hoeft meteen een groot platform te bouwen. Vaak begint het kleiner: je expertise scherper verpakken, een eerste instaproute bouwen en met bewijs zien dat mensen willen instappen.
      </p>

      {/* ── Case 1: Dr. Verena Mann ── */}
      <div class="bg-white/5 backdrop-blur border border-white/10 rounded-card p-6 md:p-8 mb-8">
        <div class="flex items-center gap-4 mb-5">
          <div class="w-12 h-12 rounded-full overflow-hidden ring-2 ring-accent/30 shrink-0">
            <Image src={verenaPhoto} alt="Dr. Verena Mann" widths={[48, 96]} sizes="48px" class="w-full h-full object-cover" loading="lazy" decoding="async" />
          </div>
          <div>
            <p class="text-white font-medium text-sm">Dr. Verena Mann</p>
            <a href="https://doc-veri.pages.dev" target="_blank" rel="noopener" class="text-accent/70 hover:text-accent text-xs transition-colors">doc-veri.pages.dev</a>
          </div>
          <div class="ml-auto flex items-center gap-3">
            <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-medium bg-accent/20 text-accent rounded-full">Expertplatform</span>
            <span class="text-white/30 text-xs">&plusmn;1,5 maand</span>
          </div>
        </div>

        <div class="grid grid-cols-3 gap-3 mb-5">
          <div class="bg-white/5 rounded-lg p-3 text-center">
            <p class="font-heading text-xl text-accent">2 &rarr; 19</p>
            <p class="text-[10px] text-white/50">aanvragen/mnd</p>
          </div>
          <div class="bg-white/5 rounded-lg p-3 text-center">
            <p class="font-heading text-xl text-accent">0 &rarr; 15</p>
            <p class="text-[10px] text-white/50">AI-vermeldingen</p>
          </div>
          <div class="bg-white/5 rounded-lg p-3 text-center">
            <p class="font-heading text-xl text-accent">&plusmn;6 wk</p>
