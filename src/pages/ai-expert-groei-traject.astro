---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import { siteConfig } from '../data/site';
import { generateBreadcrumbs, generateFAQPage, generateService } from '../data/schema';

import heroPhoto from '../assets/images/founder/joost-sitting-laptop-lookingfront.webp';
import founderPhoto from '../assets/images/founder/joost-standing-relaxed.webp';
import verenaPhoto from '../assets/images/cases/verena-mann-linkedin.webp';
import jamesPhoto from '../assets/images/cases/james-mitchell-portrait.png';
import proofVerenaAi from '../assets/images/cases/doc_veri_ai_answer_cropped.PNG';
import proofVerenaChatgpt from '../assets/images/cases/doc-veri-chatgptproof.jpeg';
import proofGoogle from '../assets/images/cases/proof-google-torrevieja.png';
import proofChatgpt from '../assets/images/cases/proof-chatgpt-local.png';

import josineWhatsApp from '../assets/images/cases/coachjosine_whatsapp_proof.png';
import josineProduct from '../assets/images/cases/eetgids-coachjosine-product-proof.webp';
import tessaWhatsApp from '../assets/images/cases/tessa-youlife-whatsapp-proof.webp';
import rolfWhatsApp from '../assets/images/cases/rolf-happywithyoga-whatsapp-proof.webp';

const locale = 'nl';

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logos/*.{webp,avif,png,jpg}', { eager: true });
const logos = Object.entries(logoFiles)
  .filter(([path]) => /logo/i.test(path.split('/').pop()!))
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/, '');
    const name = filename.replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim();
    return { src: mod.default, alt: name };
  });

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'AI Expert Groei Traject' },
];

const faqItems = [
  {
    question: 'Is dit gewoon AI-vindbaarheid?',
    answer: 'AI-vindbaarheid is de ingang en diagnose. Het traject gaat over het fundament erachter: positionering, bewijs, content, instaproute en opvolging. Beter gevonden worden heeft weinig zin als bezoekers daarna niet begrijpen waarom jij de logische keuze bent.',
  },
  {
    question: 'Moet ik meteen een online platform bouwen?',
    answer: 'De eerste fase is bewust klein: een duidelijke positionering, een eerste instaproute en bewijs dat mensen willen instappen. Pas als dat werkt, bouwen we door. Veel coaches starten niet in fase 3 — ze starten met een compacte route die bewijs oplevert.',
  },
  {
    question: 'Werken advertenties nog voor coaches?',
    answer: 'Directe advertenties naar een duur traject of salescall zijn vaak lastig. Daarom bouwen we meestal eerst een tussenstap zoals een gids, scan, masterclass of mini-product. Dat verlaagt de instapdrempel en bouwt vertrouwen op voordat iemand een gesprek inplant.',
  },
  {
    question: 'Wat als ik al een website heb?',
    answer: 'Dan kijken we wat bruikbaar is en wat scherper moet. Soms bouwen we door op wat er staat, soms is een nieuw fundament logischer. Het gaat niet om de techniek, maar om of je expertise duidelijk genoeg overkomt voor bezoekers en AI.',
  },
  {
    question: 'Is dit geschikt als ik nog geen groot publiek heb?',
    answer: 'Een groot publiek is geen voorwaarde, zolang je expertise en aanbod duidelijk genoeg zijn. Met een kleine route testen we waar mensen op reageren. Vaak begint groei niet bij meer bereik, maar bij een scherpere positionering en een duidelijkere eerste stap.',
  },
];

const faqForSchema = faqItems.map((item) => ({ question: item.question, answer: item.answer }));
const faqForComponent = faqItems.map((item) => ({ q: item.question, a: item.answer }));

const serviceSchema = generateService({
  name: 'AI Expert Groei Traject',
  description: 'Bouw een AI-ready expertfundament rond je expertise. Voor coaches en experts die beter gevonden willen worden en een route willen bouwen naar aanvragen, producten en coachingklanten.',
  url: `${siteConfig.url}/ai-expert-groei-traject/`,
  serviceType: 'Expert Growth System',
});
---

<BaseLayout
  title="AI Expert Groei Traject voor Coaches & Experts | NXG Media"
  description="Bouw een AI-ready expertfundament rond je expertise. Voor coaches en experts die beter gevonden willen worden en een route willen bouwen naar aanvragen, producten en coachingklanten."
  canonical={`${siteConfig.url}/ai-expert-groei-traject/`}
  schemas={[
    generateBreadcrumbs(breadcrumbs.map((b) => ({ name: b.label, url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}/ai-expert-groei-traject/` }))),
    generateFAQPage(faqForSchema),
    serviceSchema,
  ]}
  locale={locale}
>
  <BreadcrumbNav items={breadcrumbs} />

  {/* ── 1. HERO ── */}
  <section class="relative py-16 md:py-24 lg:py-32 overflow-hidden">
    <div class="absolute inset-0">
      <Image
        src={heroPhoto}
        alt="Joost van Putten — online groei-strateeg voor coaches en experts"
        widths={[800, 1200, 1600]}
        sizes="100vw"
        class="w-full h-full object-cover"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-white/95 via-white/85 to-white/40"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 md:px-6">
      <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl text-text mb-5 leading-tight max-w-2xl">
        Je scan laat zien waar je expertfundament lekt. <em class="text-accent not-italic">Nu bouwen we de route naar aanvragen.</em>
      </h1>
      <p class="text-text-muted leading-relaxed mb-8 max-w-xl">
        AI-vindbaarheid is de ingang. Maar als AI jou niet goed begrijpt, is dat vaak hetzelfde probleem dat potenti&euml;le klanten voelen: je positionering, bewijs, instaproute en opvolging zijn nog niet logisch genoeg verbonden.
      </p>
      <div class="flex flex-col sm:flex-row items-start gap-3">
        <a
          href="#analyse"
          class="inline-flex items-center px-8 py-4 text-base font-medium text-text-inverse bg-primary hover:bg-primary-dark transition-colors rounded-button shadow-lg"
        >
          Laat Joost mijn groeiroute bepalen
          <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a
          href="#cases"
          class="inline-flex items-center px-8 py-4 text-base font-medium text-primary border-2 border-primary hover:bg-primary/5 transition-colors rounded-button"
        >
          Bekijk de cases
        </a>
      </div>
      <p class="text-xs text-text-muted mt-4">
        Voor coaches, therapeuten en experts die hun expertise willen omzetten in aanvragen, producten en coachingklanten.
      </p>
    </div>
  </section>

  {/* ── 2. PROOF STRIP ── */}
  <section class="bg-bg-alt border-y border-border">
    <div class="max-w-4xl mx-auto px-4 md:px-6 py-8 md:py-10">
      <p class="text-xs uppercase tracking-widest text-text-muted font-medium text-center mb-5">Wat dit al opleverde bij andere experts</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <div class="font-heading text-2xl md:text-3xl text-primary">2 &rarr; 19</div>
          <p class="text-xs text-text-muted mt-1">aanvragen/mnd</p>
          <p class="text-xs text-accent font-medium mt-0.5">Dr. Verena Mann</p>
        </div>
        <div>
          <div class="font-heading text-2xl md:text-3xl text-primary">600+</div>
          <p class="text-xs text-text-muted mt-1">gidsen verkocht</p>
          <p class="text-xs text-accent font-medium mt-0.5">Coach Josine</p>
        </div>
        <div>
          <div class="font-heading text-2xl md:text-3xl text-primary">&plusmn;&euro;10k/mnd</div>
          <p class="text-xs text-text-muted mt-1">online productomzet</p>
          <p class="text-xs text-accent font-medium mt-0.5">Tessa / Youlife</p>
        </div>
        <div>
          <div class="font-heading text-2xl md:text-3xl text-primary">2.000</div>
          <p class="text-xs text-text-muted mt-1">betalende leden</p>
          <p class="text-xs text-accent font-medium mt-0.5">Happy With Yoga</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── 3. REFRAME: EXPERTFUNDAMENT ── */}
  <section class="py-14 md:py-20">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-3">
        Je probleem is meestal niet alleen vindbaarheid. Het is je expertfundament.
      </h2>
      <p class="text-text-muted leading-relaxed mb-10 max-w-3xl">
        Je expertise kan sterk zijn, maar als je online fundament niet duidelijk laat zien waarvoor jij de logische keuze bent, wat iemand als eerste stap kan doen en hoe vertrouwen wordt opgebouwd, verlies je warme interesse.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">
        <div class="bg-white rounded-card p-5 border border-border">
          <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center mb-3">
            <span class="font-heading text-primary text-lg">1</span>
          </div>
          <h3 class="font-heading text-lg text-text mb-1">Gevonden worden</h3>
          <p class="text-sm text-text-muted leading-relaxed">AI, Google en bezoekers begrijpen waarvoor jij de expert bent.</p>
        </div>
        <div class="bg-white rounded-card p-5 border border-border">
          <div class="w-10 h-10 rounded-full bg-accent/10 flex items-center justify-center mb-3">
            <span class="font-heading text-accent text-lg">2</span>
          </div>
          <h3 class="font-heading text-lg text-text mb-1">Vertrouwen opbouwen</h3>
          <p class="text-sm text-text-muted leading-relaxed">Je methode, verhaal, bewijs en resultaten staan op de juiste plek.</p>
        </div>
        <div class="bg-white rounded-card p-5 border border-border">
          <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center mb-3">
            <span class="font-heading text-primary text-lg">3</span>
          </div>
          <h3 class="font-heading text-lg text-text mb-1">Mensen laten instappen</h3>
          <p class="text-sm text-text-muted leading-relaxed">Een gids, scan, masterclass of mini-product maakt de eerste stap laagdrempelig.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── 4. 90-DAGEN ROUTE ── */}
  <section class="py-14 md:py-20 bg-bg-alt">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-3">In de eerste 90 dagen bouwen we je eerste groeiroute</h2>
      <p class="text-text-muted leading-relaxed mb-10 max-w-3xl">
        Niet meteen een groot platform. Eerst een compacte route die bewijst dat mensen willen instappen.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6 mb-8">
        <div class="bg-white rounded-card p-5 border border-border">
          <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-medium bg-primary/10 text-primary rounded-full mb-3">Fase 1</span>
          <h3 class="font-heading text-lg text-text mb-2">Expertpositie + nichepagina&rsquo;s</h3>
          <p class="text-sm text-text-muted leading-relaxed">Voor wie ben jij de logische keuze, welk probleem los je op en hoe wordt dat vindbaar voor AI, Google en bezoekers?</p>
        </div>
        <div class="bg-white rounded-card p-5 border border-border">
          <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-medium bg-accent/10 text-accent rounded-full mb-3">Fase 2</span>
          <h3 class="font-heading text-lg text-text mb-2">Instaproute + landingspagina</h3>
          <p class="text-sm text-text-muted leading-relaxed">Een gids, scan, masterclass of mini-product met een pagina die mensen naar de volgende stap brengt.</p>
        </div>
        <div class="bg-white rounded-card p-5 border border-border">
          <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-medium bg-primary/10 text-primary rounded-full mb-3">Fase 3</span>
          <h3 class="font-heading text-lg text-text mb-2">E-mailopvolging + traffic-test</h3>
          <p class="text-sm text-text-muted leading-relaxed">Een korte flow die vertrouwen opbouwt en een eerste test met advertenties of bestaande kanalen.</p>
        </div>
      </div>

      <p class="text-accent font-medium text-center">
        De eerste 90 dagen zijn bedoeld om bewijs te cre&euml;ren &mdash; niet om meteen een groot platform te bouwen.
      </p>
    </div>
  </section>

  {/* ── 5. CASES / PROOF ── */}
  <section id="cases" class="py-16 md:py-24 bg-primary">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-3xl md:text-4xl text-white mb-3">Dit is wat er kan gebeuren als het fundament klopt</h2>
      <p class="text-white/60 mb-12 max-w-3xl">
        Niet iedere coach bouwt meteen een groot platform. Vaak begint het kleiner: expertise scherper verpakken, een eerste instaproute bouwen en bewijzen dat mensen willen instappen.
      </p>

      {/* ── Case 1: Dr. Verena Mann ── */}
      <div class="bg-white/5 backdrop-blur border border-white/10 rounded-card p-5 md:p-8 mb-8">
        <div class="flex items-center gap-4 mb-5">
          <div class="w-12 h-12 rounded-full overflow-hidden ring-2 ring-accent/30 shrink-0">
            <Image src={verenaPhoto} alt="Dr. Verena Mann" widths={[48, 96]} sizes="48px" class="w-full h-full object-cover" loading="lazy" decoding="async" />
          </div>
          <div>
            <p class="text-white font-medium text-sm">Dr. Verena Mann</p>
            <a href="https://doc-veri.pages.dev" target="_blank" rel="noopener" class="text-accent/70 hover:text-accent text-xs transition-colors">doc-veri.pages.dev</a>
          </div>
          <div class="ml-auto flex items-center gap-3">
            <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-medium bg-accent/20 text-accent rounded-full">Expertplatform</span>
          </div>
        </div>

        <div class="grid grid-cols-3 gap-3 mb-5">
          <div class="bg-white/5 rounded-lg p-3 text-center">
            <p class="font-heading text-xl text-accent">2 &rarr; 19</p>
            <p class="text-[10px] text-white/50">aanvragen/mnd</p>
          </div>
          <div class="bg-white/5 rounded-lg p-3 text-center">
            <p class="font-heading text-xl text-accent">0 &rarr; 15</p>
            <p class="text-[10px] text-white/50">AI-vermeldingen</p>
          </div>
          <div class="bg-white/5 rounded-lg p-3 text-center">
            <p class="font-heading text-xl text-accent">&plusmn;6 wk</p>
            <p class="text-[10px] text-white/50">live</p>
          </div>
        </div>

        <p class="text-white/70 text-sm leading-relaxed mb-3">
          Sterke expertise en actieve community, maar nauwelijks aanvragen van mensen die haar nog niet kenden. Door haar expertise concreter rond thema&rsquo;s, klantproblemen en bewijs te verpakken, werd ze niet alleen beter zichtbaar, maar ook logischer om contact mee op te nemen.
        </p>
        <p class="text-accent text-sm font-medium italic">
          &ldquo;Van betere online aanwezigheid naar aanvragen van mensen die haar nog niet kenden.&rdquo;
        </p>

        <div class="grid grid-cols-2 gap-3 mt-5">
          <div class="lightbox-trigger cursor-zoom-in group">
            <div class="bg-black/40 border border-white/10 rounded-lg overflow-hidden">
              <Image src={proofVerenaAi} alt="ChatGPT noemt Dr. Verena Mann als passende expertin" width={1200} quality={85} class="w-full h-auto" loading="lazy" />
            </div>
            <p class="text-white/30 text-[10px] mt-1 text-center group-hover:text-white/50 transition-colors">AI-antwoord: &ldquo;eine passende Expertin&rdquo;</p>
          </div>
          <div class="lightbox-trigger cursor-zoom-in group">
            <div class="bg-black/40 border border-white/10 rounded-lg overflow-hidden">
              <Image src={proofVerenaChatgpt} alt="ChatGPT beveelt Dr. Verena Mann aan met link naar site" width={1200} quality={85} class="w-full h-auto" loading="lazy" />
            </div>
            <p class="text-white/30 text-[10px] mt-1 text-center group-hover:text-white/50 transition-colors">ChatGPT met directe link naar haar site</p>
          </div>
        </div>
      </div>

      {/* ── Case 2: Coach Josine ── */}
      <div class="bg-white/5 backdrop-blur border border-white/10 rounded-card p-5 md:p-8 mb-8">
        <div class="flex items-center gap-4 mb-5">
          <div>
            <p class="text-white font-medium text-sm">Josine &mdash; Coach Josine</p>
            <a href="https://www.coachjosine.nl" target="_blank" rel="noopener" class="text-accent/70 hover:text-accent text-xs transition-colors">coachjosine.nl</a>
          </div>
          <div class="ml-auto">
            <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-medium bg-accent/20 text-accent rounded-full">Eerste tractie</span>
          </div>
        </div>

        <div class="grid grid-cols-3 gap-3 mb-5">
          <div class="bg-white/5 rounded-lg p-3 text-center">
            <p class="font-heading text-xl text-accent">600+</p>
            <p class="text-[10px] text-white/50">gidsen verkocht</p>
          </div>
          <div class="bg-white/5 rounded-lg p-3 text-center">
            <p class="font-heading text-xl text-accent">80</p>
            <p class="text-[10px] text-white/50">masterclass-aanmeldingen</p>
          </div>
          <div class="bg-white/5 rounded-lg p-3 text-center">
            <p class="font-heading text-xl text-accent">18</p>
            <p class="text-[10px] text-white/50">wilden direct het programma</p>
          </div>
        </div>

        <p class="text-white/70 text-sm leading-relaxed mb-3">
          Had expertise, maar geen digitale instaproute. We maakten haar eerste gids concreet, bouwden de landingspagina en koppelden dit aan een masterclassroute. Mensen kochten de gids, kwamen naar de masterclass en vroegen door naar het programma.
        </p>
        <p class="text-accent text-sm font-medium italic">
          &ldquo;Niet meteen een platform, maar eerst bewijs dat mensen willen instappen.&rdquo;
        </p>

        <div class="grid grid-cols-2 gap-3 mt-5">
          <div class="lightbox-trigger cursor-zoom-in group">
            <div class="bg-black/40 border border-white/10 rounded-lg overflow-hidden">
              <Image src={josineProduct} alt="Eetgids Coach Josine — productpagina" width={600} quality={80} class="w-full h-auto" loading="lazy" />
            </div>
            <p class="text-white/30 text-[10px] mt-1 text-center group-hover:text-white/50 transition-colors">De eetgids die het bewijs leverde</p>
          </div>
          <div class="lightbox-trigger cursor-zoom-in group">
            <div class="bg-black/40 border border-white/10 rounded-lg overflow-hidden">
              <Image src={josineWhatsApp} alt="WhatsApp bericht Josine over resultaten" width={600} quality={80} class="w-full h-auto" loading="lazy" />
            </div>
            <p class="text-white/30 text-[10px] mt-1 text-center group-hover:text-white/50 transition-colors">Reactie van Josine</p>
          </div>
        </div>
      </div>

      {/* ── Case 3: Tessa / Youlife ── */}
      <div class="bg-white/5 backdrop-blur border border-white/10 rounded-card p-5 md:p-8 mb-8">
        <div class="flex items-center gap-4 mb-5">
          <div>
            <p class="text-white font-medium text-sm">Tessa &mdash; Youlife</p>
          </div>
          <div class="ml-auto">
            <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-medium bg-accent/20 text-accent rounded-full">Productgroei</span>
          </div>
        </div>

        <div class="grid grid-cols-3 gap-3 mb-5">
          <div class="bg-white/5 rounded-lg p-3 text-center">
            <p class="font-heading text-xl text-accent">&euro;10k/mnd</p>
            <p class="text-[10px] text-white/50">online productomzet</p>
          </div>
          <div class="bg-white/5 rounded-lg p-3 text-center">
            <p class="font-heading text-xl text-accent">1 &rarr; 6</p>
            <p class="text-[10px] text-white/50">online producten</p>
          </div>
          <div class="bg-white/5 rounded-lg p-3 text-center">
            <p class="font-heading text-xl text-accent">&plusmn;10/mnd</p>
            <p class="text-[10px] text-white/50">coachingklanten</p>
          </div>
        </div>

        <p class="text-white/70 text-sm leading-relaxed mb-3">
          Begon niet met een groot platform, maar met losse producten en de vraag: hoe maken we dit voorspelbaar? Vanuit &eacute;&eacute;n product bouwden we door naar meerdere producten, e-mailflows en coachingaanvragen.
        </p>
        <p class="text-accent text-sm font-medium italic">
          &ldquo;De Guide verkoopt super goed. Het is nu al winstgevend.&rdquo;
        </p>

        <div class="grid grid-cols-2 gap-3 mt-5">
          <div class="lightbox-trigger cursor-zoom-in group">
            <div class="bg-black/40 border border-white/10 rounded-lg overflow-hidden">
              <Image src={tessaWhatsApp} alt="WhatsApp bericht Tessa — resultaten Youlife" width={600} quality={80} class="w-full h-auto" loading="lazy" />
            </div>
            <p class="text-white/30 text-[10px] mt-1 text-center group-hover:text-white/50 transition-colors">Reactie van Tessa</p>
          </div>
          <div class="bg-white/5 rounded-lg p-4 flex items-center justify-center">
            <a href="/cases/tessa-youlife/" class="text-accent hover:text-accent-dark text-sm font-medium transition-colors">Bekijk de volledige case &rarr;</a>
          </div>
        </div>
      </div>

      {/* ── Case 4: Happy With Yoga ── */}
      <div class="bg-white/5 backdrop-blur border border-white/10 rounded-card p-5 md:p-8 mb-8">
        <div class="flex items-center gap-4 mb-5">
          <div>
            <p class="text-white font-medium text-sm">Rolf &mdash; Happy With Yoga</p>
          </div>
          <div class="ml-auto">
            <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-medium bg-accent/20 text-accent rounded-full">Volwassen platform</span>
          </div>
        </div>

        <div class="grid grid-cols-3 gap-3 mb-5">
          <div class="bg-white/5 rounded-lg p-3 text-center">
            <p class="font-heading text-xl text-accent">30.000+</p>
            <p class="text-[10px] text-white/50">webinarleads</p>
          </div>
          <div class="bg-white/5 rounded-lg p-3 text-center">
            <p class="font-heading text-xl text-accent">1.700+</p>
