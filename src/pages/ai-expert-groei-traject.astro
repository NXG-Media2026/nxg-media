---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import { siteConfig } from '../data/site';
import { generateBreadcrumbs, generateFAQPage, generateService } from '../data/schema';
import { buildHreflangTrilingual } from '../i18n/hreflang';

import heroPhoto from '../assets/images/founder/joost-sitting-laptop-lookingfront.webp';
import founderPhoto from '../assets/images/founder/joost-standing-relaxed.webp';
import verenaPhoto from '../assets/images/cases/verena-mann-linkedin.webp';
import jamesPhoto from '../assets/images/cases/james-mitchell-portrait.png';
import proofVerenaAi from '../assets/images/cases/doc_veri_ai_answer_cropped.PNG';
import proofVerenaChatgpt from '../assets/images/cases/doc-veri-chatgptproof.jpeg';
import proofGoogle from '../assets/images/cases/proof-google-torrevieja.png';
import proofChatgpt from '../assets/images/cases/proof-chatgpt-local.png';

import josineWhatsApp from '../assets/images/cases/coachjosine_whatsapp_proof.png';
import josineProduct from '../assets/images/cases/eetgids-coachjosine-product-proof.webp';
import tessaWhatsApp from '../assets/images/cases/tessa-youlife-whatsapp-proof.webp';
import rolfWhatsApp from '../assets/images/cases/rolf-happywithyoga-whatsapp-proof.webp';

const locale = 'nl';

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logos/*.{webp,avif,png,jpg}', { eager: true });
const logos = Object.entries(logoFiles)
  .filter(([path]) => /logo/i.test(path.split('/').pop()!))
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/, '');
    const name = filename.replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim();
    return { src: mod.default, alt: name };
  });

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'AI Expert Groei Traject' },
];

const faqItems = [
  {
    question: 'Is dit gewoon AI-vindbaarheid?',
    answer: 'AI-vindbaarheid is de ingang. Het traject gaat over het fundament erachter: positionering, bewijs, content, instaproute en opvolging. Beter gevonden worden heeft weinig zin als bezoekers daarna niet begrijpen waarom jij de logische keuze bent.',
  },
  {
    question: 'Wat is het verschil tussen Expert Website Fundament en Coach Accelerator?',
    answer: 'Het Expert Website Fundament bouwt je expertpositie en vindbaarheid. Coach Accelerator voegt daar het volledige groeisysteem aan toe: instaproute, e-mailopvolging, advertentiestrategie, leadtest en optimalisatie richting klanten. De case-resultaten op deze pagina kwamen uit het Coach Accelerator model.',
  },
  {
    question: 'Moet ik meteen een online platform bouwen?',
    answer: 'De eerste fase is bewust klein: een duidelijke positionering, een eerste instaproute en bewijs dat mensen willen instappen. Pas als dat werkt, bouwen we door. Veel coaches starten niet in fase 3 — ze starten met een compacte route die bewijs oplevert.',
  },
  {
    question: 'Werken advertenties nog voor coaches?',
    answer: 'Directe advertenties naar een duur traject of salescall zijn vaak lastig. Daarom bouwen we meestal eerst een tussenstap zoals een gids, scan, masterclass of mini-product. Dat verlaagt de instapdrempel en bouwt vertrouwen op voordat iemand een gesprek inplant.',
  },
  {
    question: 'Wat als ik al een website heb?',
    answer: 'Dan kijken we wat bruikbaar is en wat scherper moet. Soms bouwen we door op wat er staat, soms is een nieuw fundament logischer. Het gaat niet om de techniek, maar om of je expertise duidelijk genoeg overkomt voor bezoekers en AI.',
  },
  {
    question: 'Is dit geschikt als ik nog geen groot publiek heb?',
    answer: 'Een groot publiek is geen voorwaarde, zolang je expertise en aanbod duidelijk genoeg zijn. Met een kleine route testen we waar mensen op reageren. Vaak begint groei niet bij meer bereik, maar bij een scherpere positionering en een duidelijkere eerste stap.',
  },
  {
    question: 'Kan ik ook alleen wat losse tips krijgen?',
    answer: 'Niet als uitgebreid adviestraject. Deze analyse is bedoeld voor coaches en experts die willen weten welke route commercieel het meeste kans maakt. Zoek je alleen gratis tips om zelf ooit iets mee te doen, dan past dit traject minder goed.',
  },
  {
    question: 'Wat als er weinig groeikans blijkt te liggen?',
    answer: 'Dan zeggen we dat eerlijk. Niet elke expert of niche is geschikt voor dit model. We starten liever niet dan dat we een traject doen waar weinig commerciele kans in zit.',
  },
];

const faqForSchema = faqItems.map((item) => ({ question: item.question, answer: item.answer }));
const faqForComponent = faqItems.map((item) => ({ q: item.question, a: item.answer }));

const hreflang = buildHreflangTrilingual(
  '/ai-expert-groei-traject/',
  '/en/ai-expert-growth/',
  '/es/crecimiento-experto-ia/',
);

const serviceSchema = generateService({
  name: 'AI Expert Groei Traject',
  description: 'Van expertise naar aanvragen, instappers en klanten. Expert Website Fundament vanaf €299/mnd of Coach Accelerator Growth System vanaf €500/mnd. Voor coaches, therapeuten en kennisexperts.',
  url: `${siteConfig.url}/ai-expert-groei-traject/`,
  serviceType: 'Expert Growth System',
});
---

<BaseLayout
  title="Expert Groei Traject voor Coaches & Experts | NXG Media"
  description="Je expertise is niet het probleem. Je systeem naar klanten wel. Expert Website Fundament vanaf €299/mnd of Coach Accelerator vanaf €500/mnd."
  canonical={`${siteConfig.url}/ai-expert-groei-traject/`}
  schemas={[
    generateBreadcrumbs(breadcrumbs.map((b) => ({ name: b.label, url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}/ai-expert-groei-traject/` }))),
    generateFAQPage(faqForSchema),
    serviceSchema,
  ]}
  locale={locale}
  hreflang={hreflang}
  hideNewsletter={true}
  hideStickyMobileCTA={true}
>
  <BreadcrumbNav items={breadcrumbs} />


  {/* ── 1. HERO ── */}
  <section class="relative overflow-hidden bg-primary">
    <div class="absolute inset-0 hidden md:block">
      <Image src={heroPhoto} alt="" width={800} class="absolute right-0 top-0 h-full w-auto object-cover object-top opacity-[0.15]" loading="eager" />
    </div>

    <div class="relative px-5 md:px-6 pt-10 pb-10 md:pt-14 md:pb-16">
      <div class="max-w-2xl mx-auto">
        <h1 class="font-heading text-[1.75rem] leading-[1.15] md:text-[2.75rem] md:leading-[1.1] text-white mb-4">
          Je expertise is niet het probleem.<br />
          <em class="text-accent not-italic">Je systeem naar klanten wel.</em>
        </h1>

        <p class="text-white/70 leading-relaxed mb-2 text-[0.9rem] md:text-base max-w-xl">
          Voor coaches, therapeuten en experts die meer aanvragen, instappers en klanten willen uit hun kennis &mdash; zonder afhankelijk te blijven van losse posts, DM's of directe salescalls.
        </p>
        <p class="text-white/90 font-medium mb-5 text-[0.9rem] md:text-base max-w-xl">
          We bouwen je expertfundament &oacute;f je complete groeisysteem: AI-vindbaarheid, scherpe positionering, een laagdrempelige instaproute, e-mailopvolging en pagina's die vertrouwen omzetten in actie.
        </p>

        <p class="text-accent text-xs font-medium uppercase tracking-widest mb-3">Dit model leverde al op:</p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-6 max-w-lg">
          <div class="bg-white/[0.08] border border-white/15 rounded-lg px-3 py-2 text-center">
            <p class="font-heading text-lg text-white">2 &rarr; 19</p>
            <p class="text-white/50 text-[0.6rem]">aanvragen/mnd</p>
          </div>
          <div class="bg-white/[0.08] border border-white/15 rounded-lg px-3 py-2 text-center">
            <p class="font-heading text-lg text-white">600+</p>
            <p class="text-white/50 text-[0.6rem]">gidsen verkocht</p>
          </div>
          <div class="bg-white/[0.08] border border-white/15 rounded-lg px-3 py-2 text-center">
            <p class="font-heading text-lg text-white">&euro;10k/mnd</p>
            <p class="text-white/50 text-[0.6rem]">productomzet</p>
          </div>
          <div class="bg-white/[0.08] border border-white/15 rounded-lg px-3 py-2 text-center">
            <p class="font-heading text-lg text-white">2.000</p>
            <p class="text-white/50 text-[0.6rem]">betalende leden</p>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-start gap-3">
          <a href="#analyse" class="inline-flex items-center gap-2 px-8 py-4 text-base font-medium text-white bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg w-full sm:w-auto justify-center">
            Check mijn groeikans
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
          <a href="#cases" class="inline-flex items-center px-8 py-4 text-base font-medium text-white/80 border border-white/20 hover:bg-white/5 transition-colors rounded-button w-full sm:w-auto justify-center">
            Bekijk de coach-cases
          </a>
        </div>

        <p class="text-white/40 text-xs mt-4">Volgende 90-dagen ronde start 1 juli &middot; Max 4 coaches/experts</p>
      </div>
    </div>
  </section>


  {/* ── 2. PIJN-SECTIE ── */}
  <section class="px-4 md:px-6 py-12 md:py-16">
    <div class="max-w-3xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-3">
        Veel coaches hebben geen kennisprobleem. Ze hebben een routeprobleem.
      </h2>
      <p class="text-text-muted text-[0.95rem] leading-relaxed mb-6">
        Je post. Je deelt waarde. Mensen reageren positief. Maar er ontstaat te weinig voorspelbare vraag.
      </p>

      <ul class="space-y-2.5 mb-6">
        {[
          'Je content krijgt reacties, maar te weinig aanvragen.',
          'Je website vertelt wie je bent, maar verkoopt je route niet.',
          'Mensen vinden je interessant, maar zetten geen eerste stap.',
          'Direct naar een salescall voelt te groot.',
          'Je expertise is verspreid over posts, blogs, stories en losse producten.',
          'AI en Google begrijpen niet duidelijk waarvoor jij de expert bent.',
        ].map((item) => (
          <li class="flex items-start gap-2.5 text-sm text-text">
            <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 11-18 0 9 9 0 0118 0zm-9 3.75h.008v.008H12v-.008z" /></svg>
            {item}
          </li>
        ))}
      </ul>

      <p class="text-text font-medium text-[0.95rem]">
        Daarom bouwen we geen mooie website. We bouwen een route van interesse naar instap naar aanvraag.
      </p>
    </div>
  </section>


  {/* ── 3. VAN WEBSITE NAAR EXPERT-ECOSYSTEEM ── */}
  <section class="px-4 md:px-6 py-12 md:py-16 bg-bg-alt">
    <div class="max-w-3xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-3">Van website naar expert-ecosysteem</h2>
      <p class="text-text-muted text-[0.95rem] leading-relaxed mb-4">
        Een normale website zegt: dit is wie ik ben en dit is wat ik aanbied. Een expert-ecosysteem helpt Google, AI en potentiele klanten begrijpen wie je helpt, waar je autoriteit ligt, welke thema's bij je methode horen, welke eerste stap iemand kan zetten en hoe ze kunnen doorgroeien naar coaching, membership of een programma.
      </p>
      <p class="text-text-muted text-[0.95rem] leading-relaxed mb-4">
        Voor coaches en experts bouwen we geen losse website. We bouwen een expert-ecosysteem: vindbaarheid, positionering, instaproute, producten, masterclass/quiz, e-mailopvolging en conversie naar coaching of programma.
      </p>
      <p class="text-text font-medium text-sm">
        In 90 dagen bouwen we jouw eerste versie van zo'n expert-ecosysteem. Niet zo uitgebreid als doc.veri vanaf dag een, maar wel met dezelfde logica: duidelijke expertpositie, instaproute, opvolging en een fundament dat Google, AI en potentiele klanten begrijpen.
      </p>
    </div>
  </section>


  {/* ── 4. TWEE OFFERS ── */}
  <section class="px-4 md:px-6 py-14 md:py-20">
    <div class="max-w-5xl mx-auto">
      <div class="text-center mb-8">
        <h2 class="font-heading text-2xl md:text-3xl text-text mb-2">Twee routes. Welke past bij jouw fase?</h2>
        <p class="text-text-muted text-[0.95rem] max-w-2xl mx-auto">
          Wil je eerst je expertfundament goed neerzetten, of wil je het volledige systeem waarmee expertise leads, instappers en klanten oplevert?
        </p>
      </div>

      {/* Cohort card */}
      <div class="relative max-w-md mx-auto mb-10">
        <div class="absolute -inset-1 bg-accent/20 rounded-2xl blur-md"></div>
        <div class="relative bg-primary-dark rounded-xl overflow-hidden shadow-xl border border-accent/30">
          <div class="bg-accent px-4 py-2">
            <span class="text-[0.65rem] font-bold tracking-[0.2em] uppercase text-white">Volgende 90-dagen ronde</span>
          </div>
          <div class="px-6 py-6 md:px-8 md:py-7">
            <p class="text-white/50 text-xs font-medium uppercase tracking-wider mb-1">Start</p>
            <p class="font-heading text-5xl md:text-6xl text-white leading-none mb-5">1 juli</p>
            <div class="flex flex-wrap justify-center gap-2 mb-5">
              <span class="inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold bg-white/10 text-white rounded-full">Max 4 coaches/experts</span>
            </div>
            <div class="border-t border-white/10 pt-4">
              <p class="text-white/60 text-sm leading-relaxed text-center">
                De analyse, positionering, instaproute en eerste groeifase worden persoonlijk opgezet. Daarom beperken we het aantal.
              </p>
            </div>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-[1fr_1.15fr] gap-5 mb-10">

        {/* ── OFFER 1 — Expert Website Fundament ── */}
        <div class="bg-white border border-border rounded-card p-5 md:p-6 flex flex-col">
          <span class="inline-block self-start px-2.5 py-0.5 text-[0.55rem] font-medium tracking-widest uppercase bg-accent/10 text-accent rounded-full mb-3">Expert fundament</span>

          <p class="font-heading text-lg text-text mb-0.5">Expert Website Fundament</p>
          <div class="flex items-baseline gap-1 mb-0.5">
            <p class="font-heading text-2xl text-accent">Vanaf &euro;299<span class="text-sm text-text-muted font-body">/mnd</span></p>
          </div>
          <p class="text-text-muted text-xs mb-4">90 dagen</p>

          <p class="text-text font-medium text-sm mb-3">Word online serieus neergezet als expert.</p>

          <p class="text-xs uppercase tracking-widest text-text-muted font-medium mb-1">Uitkomst na 90 dagen</p>
          <p class="text-text-muted text-sm leading-relaxed mb-4">
            Je hebt een expertwebsite die duidelijk maakt wie je helpt, waar je autoriteit ligt, welke thema's bij jou horen en welke eerste stap bezoekers kunnen zetten.
          </p>

          <p class="text-xs uppercase tracking-widest text-text-muted font-medium mb-1">Beste keuze als</p>
          <p class="text-text-muted text-sm leading-relaxed mb-4">
            Je vooral beter gevonden, begrepen en vertrouwd wilt worden door Google, AI en potentiele klanten.
          </p>

          <a href="#analyse" class="inline-flex items-center justify-center gap-2 px-5 py-3 text-sm font-medium text-accent border-2 border-accent hover:bg-accent hover:text-white transition-colors rounded-button w-full mt-auto mb-4">
            Bouw mijn expertfundament
          </a>

          <details class="group border-t border-border pt-3">
            <summary class="flex items-center justify-between cursor-pointer text-xs text-accent font-medium select-none">
              Wat zit erin?
              <svg class="w-3.5 h-3.5 text-accent transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <ul class="mt-3 space-y-1.5">
              {[
                'Nieuwe snelle expertwebsite',
                'AI/Google-vindbare structuur',
                'Duidelijke expertpositionering',
                'Thematische pagina\'s / content clusters',
                'Aanbodpagina\'s voor coaching, producten, masterclass of membership',
                'Basis SEO/GEO',
                'Structured data / schema',
                'llms.txt / AI-uitlegbestand',
                'FAQ\'s en bewijsblokken',
                'Conversiegerichte CTA\'s',
                'Beheerpaneel',
                'Hosting en monitoring',
              ].map((item) => (
                <li class="flex items-start gap-2 text-xs text-text">
                  <svg class="w-3 h-3 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                  {item}
                </li>
              ))}
            </ul>
          </details>

          <div class="bg-bg-alt rounded-lg px-3 py-2 mt-3">
            <p class="text-[0.65rem] text-text-muted">Bevat geen advertentiestrategie, mini-product uitwerking, quiz-funnel, campagnebeheer of intensieve groei-uitvoering.</p>
          </div>
        </div>

        {/* ── OFFER 2 — Coach Accelerator ── */}
        <div class="bg-gradient-to-b from-white to-accent/[0.03] border-2 border-accent/40 rounded-card p-5 md:p-6 shadow-xl relative flex flex-col ring-1 ring-accent/10">
          <span class="absolute -top-3.5 left-1/2 -translate-x-1/2 inline-block px-4 py-1 text-[0.6rem] font-bold tracking-[0.15em] uppercase bg-accent text-white rounded-full shadow-md whitespace-nowrap">Aanbevolen &mdash; complete groeisysteem</span>

          <span class="inline-block self-start px-2.5 py-0.5 text-[0.55rem] font-medium tracking-widest uppercase bg-accent/10 text-accent rounded-full mb-3 mt-1">Volledige groei</span>

          <p class="font-heading text-lg text-text mb-0.5">Coach Accelerator Growth System</p>
          <div class="flex items-baseline gap-1 mb-0.5">
            <p class="font-heading text-3xl text-accent">Vanaf &euro;500<span class="text-sm text-text-muted font-body">/mnd</span></p>
          </div>
          <p class="text-text-muted text-xs mb-4">90 dagen</p>

          <p class="text-text font-medium text-sm mb-3">Bouw het systeem waarmee je expertise leads en klanten oplevert.</p>

          <p class="text-xs uppercase tracking-widest text-accent font-medium mb-1">Uitkomst na 90 dagen</p>
          <p class="text-text text-sm leading-relaxed mb-4">
            Je hebt niet alleen een expertfundament, maar ook een concrete groeiroute: instaproute, landingspagina, e-mailopvolging, advertentiehoek en eerste leadtest.
          </p>

          <p class="text-xs uppercase tracking-widest text-accent font-medium mb-1">Beste keuze als</p>
          <p class="text-text-muted text-sm leading-relaxed mb-4">
            Je serieus wilt bouwen aan leads, instappers, productverkopen, masterclass-aanmeldingen of coachingaanvragen.
          </p>

          <div class="flex items-center gap-2 mb-4">
            <span class="text-[0.6rem] uppercase tracking-widest text-accent font-semibold">Impact</span>
            <div class="flex gap-0.5">
              <span class="w-5 h-1.5 rounded-full bg-accent"></span>
              <span class="w-5 h-1.5 rounded-full bg-accent"></span>
              <span class="w-5 h-1.5 rounded-full bg-accent"></span>
            </div>
            <span class="text-[0.6rem] text-accent font-semibold">Hoogste resultaatpotentieel</span>
          </div>

          <a href="#analyse" class="inline-flex items-center justify-center gap-2 px-6 py-4 text-base font-semibold text-white bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg w-full mt-auto mb-4">
            Start met Coach Accelerator
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>

          <details class="group border-t border-accent/15 pt-3">
            <summary class="flex items-center justify-between cursor-pointer text-xs text-accent font-medium select-none">
              Wat zit erin?
              <svg class="w-3.5 h-3.5 text-accent transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
            </summary>
            <ul class="mt-3 space-y-1.5">
              {[
                'Alles uit Expert Website Fundament',
                'Keuze en uitwerking juiste instaproute',
                'AI quiz / scan / leadmagnet',
                'Mini-product positionering',
                'Masterclass-strategie',
                'Landingspagina\'s',
                'E-mailflow',
                'Meta Ads strategie',
                'Advertentiehooks / angles',
                'Testcampagne begeleiding',
                'Analyse van leadkwaliteit',
                'Optimalisatie richting aanvragen, productverkopen of coachingklanten',
              ].map((item) => (
                <li class="flex items-start gap-2 text-xs text-text font-medium">
                  <svg class="w-3 h-3 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                  {item}
                </li>
              ))}
            </ul>
          </details>
        </div>
      </div>

      {/* Comparison block */}
      <div class="max-w-3xl mx-auto">
        <p class="text-xs uppercase tracking-widest text-accent font-medium text-center mb-4">Het verschil in een zin</p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-6">
          <div class="bg-bg-alt rounded-lg px-4 py-3">
            <p class="text-xs text-accent font-medium mb-1">Expert Website Fundament</p>
            <p class="text-sm text-text">Je wordt online serieus neergezet als expert.</p>
          </div>
          <div class="bg-accent/5 border border-accent/15 rounded-lg px-4 py-3">
            <p class="text-xs text-accent font-medium mb-1">Coach Accelerator</p>
            <p class="text-sm text-text font-medium">We bouwen het systeem waarmee je expertise leads, instappers en klanten kan opleveren.</p>
          </div>
        </div>
        <p class="text-sm text-text-muted text-center max-w-xl mx-auto">
          De cases op deze pagina kwamen niet alleen door een mooie website. Ze kwamen door de combinatie van positionering, aanbod, funnel, instapproduct/masterclass, e-mail, advertenties en optimalisatie. Daarom hoort het volledige resultaatpotentieel vooral bij Coach Accelerator.
        </p>
      </div>
