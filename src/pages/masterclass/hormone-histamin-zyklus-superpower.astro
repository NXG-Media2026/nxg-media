---
/**
 * Masterclass placeholder / waitlist page.
 *
 * TEMPORARY: No Webinargeek integration yet. No Calendly.
 * Placeholder waitlist signup block only.
 *
 * Structure follows the 12-step conversion framework:
 * 1. Situational hook  2. Emotional tension  3. Reality check
 * 4. Reframe  5. Masterclass promise  6. Practical details
 * 7. What you'll learn  8. Expert authority  9. Proof/testimonial
 * 10. Recognition  11. FAQ  12. Final CTA
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import CTABand from '../../components/CTABand.astro';
import { Image } from 'astro:assets';
import { siteConfig } from '../../data/site';
import { generateBreadcrumbs, generateFAQPage } from '../../data/schema';
import { t } from '../../i18n/utils';
import { buildHreflangPair } from '../../i18n/hreflang';
import { trackOnClick } from '../../lib/analytics';
import { buildMasterclassPayload, serializePayload } from '../../lib/emailCapture';

import founderImage from '../../assets/images/Founder/portrait-doctor.jpg';
import heroImage from '../../assets/images/Founder/lifestyle-water.jpg';

const pageSlug = 'hormone-histamin-zyklus-superpower';
const pageTitle = 'Hormone, Histamin & Zyklus als Superpower';
const pageUrl = `/masterclass/${pageSlug}`;

const breadcrumbs = [
  { label: t('breadcrumb.home'), href: '/' },
  { label: t('breadcrumb.angebot'), href: '/angebot' },
  { label: t('breadcrumb.masterclass') },
  { label: pageTitle },
];

const breadcrumbSchema = breadcrumbs.map((b) => ({
  name: b.label,
  url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}${pageUrl}`,
}));

const analyticsBase = {
  page_type: 'masterclass' as const,
  page_slug: pageSlug,
  locale: 'de',
};

const learnings = [
  {
    title: 'Hormone verstehen',
    description: 'Was Östrogen, Progesteron und Cortisol wirklich in deinem Körper machen — und warum sie sich manchmal gegen dich wenden.',
  },
  {
    title: 'Histamin & dein Zyklus',
    description: 'Warum Histamin-Beschwerden zyklusabhängig sind und was du in jeder Phase konkret tun kannst.',
  },
  {
    title: 'Training nach Zyklus',
    description: 'Wann dein Körper Leistung bringen kann und wann er Erholung braucht — basierend auf deinen Hormonen, nicht auf einem Kalender.',
  },
  {
    title: 'Ernährung, die unterstützt',
    description: 'Welche Lebensmittel deine Hormone stabilisieren und welche sie aus dem Gleichgewicht bringen.',
  },
  {
    title: 'Perimenopause erkennen',
    description: 'Die Zeichen, die viele Ärzte übersehen — und was du jetzt schon tun kannst, auch wenn du erst 35 bist.',
  },
  {
    title: 'Dein persönlicher Fahrplan',
    description: 'Am Ende der Masterclass hast du einen konkreten Plan, den du direkt umsetzen kannst.',
  },
];

const faqs = [
  {
    q: 'Wann findet die Masterclass statt?',
    a: 'Das genaue Datum steht noch nicht fest. Trag dich in die Warteliste ein und du erfährst es als Erste — mit einem exklusiven Frühbucher-Vorteil.',
  },
  {
    q: 'Ist die Masterclass kostenlos?',
    a: 'Die Masterclass wird einen kleinen Preis haben, der noch bekanntgegeben wird. Wartelisten-Mitglieder erhalten einen exklusiven Rabatt.',
  },
  {
    q: 'Brauche ich Vorkenntnisse?',
    a: 'Nein. Die Masterclass ist so aufgebaut, dass du alles verstehst — egal ob du dich zum ersten Mal mit Hormonen beschäftigst oder schon länger recherchierst.',
  },
  {
    q: 'Gibt es eine Aufzeichnung?',
    a: 'Ja, alle Teilnehmerinnen erhalten Zugang zur Aufzeichnung. Du kannst in deinem eigenen Tempo schauen.',
  },
  {
    q: 'Für wen ist die Masterclass geeignet?',
    a: 'Für alle Frauen, die das Gefühl haben, dass ihr Körper nicht mehr so funktioniert wie gewohnt — und die verstehen wollen, warum. Besonders relevant, wenn du zwischen 28 und 52 bist.',
  },
  {
    q: 'Was unterscheidet das von einem YouTube-Video?',
    a: 'Die Masterclass verbindet drei Themen (Hormone, Histamin, Zyklus), die normalerweise einzeln behandelt werden. Du bekommst das Gesamtbild — von einer Ärztin, nicht von einem Influencer.',
  },
];

const { founder } = siteConfig;

// Pre-build the email capture payload for the waitlist form
const waitlistPayload = buildMasterclassPayload('', {
  masterclassSlug: pageSlug,
});
const waitlistPayloadJson = serializePayload(waitlistPayload);
---

<BaseLayout
  title={`${pageTitle} — Masterclass | ${siteConfig.name}`}
  description="Verstehe endlich, warum dein Körper sich verändert hat. Kostenlose Masterclass über Hormone, Histamin und zyklusbewusstes Leben — von Dr. Verena Mann."
  hreflang={buildHreflangPair('/masterclass/hormone-histamin-zyklus-superpower', '/en/masterclass/hormones-histamine-cycle-superpower')}
  schemas={[
    generateBreadcrumbs(breadcrumbSchema),
    generateFAQPage(faqs),
  ]}
  locale="de"
>
  <BreadcrumbNav items={breadcrumbs} />

  {/* ──────────────────────────────────────────────
      1. SITUATIONAL HOOK — start with the moment the ICP lives
      ────────────────────────────────────────────── */}
  <section class="relative overflow-hidden bg-primary-dark text-white min-h-[60vh] md:min-h-[70vh] flex items-center">
    <div class="absolute inset-0">
      <Image
        src={heroImage}
        alt="Frau am Wasser — Ruhe und Kraft"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        class="w-full h-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#2D2A26]/90 via-[#2D2A26]/70 to-[#2D2A26]/50"></div>
    </div>
    <div class="relative max-w-3xl mx-auto px-4 md:px-6 py-20 md:py-28">
      <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/20 text-accent-light rounded-full mb-6">
        Masterclass &middot; Warteliste
      </span>
      <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl text-white leading-tight mb-6">
        Du machst eigentlich vieles richtig — und&nbsp;f&uuml;hlst dich trotzdem nicht wie du selbst.
      </h1>
      <p class="text-lg md:text-xl text-white/80 leading-relaxed mb-8 max-w-2xl">
        Du isst gesund, trainierst regelm&auml;&szlig;ig — und trotzdem f&uuml;hlt sich dein K&ouml;rper unberechenbar an. Die Energie schwankt, der Schlaf ist gest&ouml;rt, die Verdauung macht, was sie will.
      </p>
      <a
        href="#warteliste"
        class="inline-flex items-center px-8 py-4 text-base font-medium bg-accent hover:bg-accent-dark text-white transition-all duration-300 rounded-button shadow-lg shadow-accent/25"
        onclick={trackOnClick('masterclass_waitlist_signup', { ...analyticsBase, cta_location: 'hero' })}
      >
        Masterclass vormerken
        <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>

  {/* ──────────────────────────────────────────────
      2. EMOTIONAL TENSION — internal doubt
      ────────────────────────────────────────────── */}
  <section class="py-14 md:py-20 bg-bg">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <div class="space-y-6 text-lg text-text-muted leading-relaxed">
        <p>
          Vielleicht hast du schon bei deiner &Auml;rztin nachgefragt. Blutwerte? Unauff&auml;llig. Schilddr&uuml;se? Normal. Alles in Ordnung — sagt das Labor.
        </p>
        <p>
          Aber du <em>sp&uuml;rst</em>, dass etwas nicht stimmt. Die Bl&auml;hungen nach dem Essen. Die R&ouml;tungen im Gesicht. Die Migr&auml;ne, die immer zur selben Zyklusphase kommt. Das Gef&uuml;hl, dass dein K&ouml;rper sich gegen dich wendet.
        </p>
        <p class="text-text font-medium">
          Du bist nicht verr&uuml;ckt. Du bist nicht &uuml;berempfindlich. Und du bildest dir das nicht ein.
        </p>
      </div>
    </div>
  </section>

  {/* ──────────────────────────────────────────────
      3. REALITY CHECK — consequence if ignored
      ────────────────────────────────────────────── */}
  <section class="py-14 md:py-20 bg-bg-alt">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-6">
        Was passiert, wenn du es ignorierst
      </h2>
      <div class="space-y-5 text-text-muted leading-relaxed">
        <p>
          Dein K&ouml;rper gibt dir Signale. Wenn du sie &uuml;bergehst — mehr trainierst, weniger isst, dich durchbeisst — werden die Symptome nicht verschwinden. Sie werden lauter.
        </p>
        <p>
          Histamin-Intoleranz, hormonelles Ungleichgewicht und zyklusbedingte Beschwerden h&auml;ngen enger zusammen, als die meisten &Auml;rzte dir sagen. Aber wenn du die Zusammenh&auml;nge nicht kennst, l&ouml;st du das falsche Problem.
        </p>
      </div>
    </div>
  </section>

  {/* ──────────────────────────────────────────────
      4. REFRAME
      ────────────────────────────────────────────── */}
  <section class="py-14 md:py-20 bg-bg">
    <div class="max-w-3xl mx-auto px-4 md:px-6 text-center">
      <div class="w-16 h-1 bg-accent rounded-full mx-auto mb-8"></div>
      <h2 class="font-heading text-2xl md:text-3xl lg:text-4xl text-text mb-6">
        Dein K&ouml;rper arbeitet nicht gegen dich. Er spricht eine Sprache, die du noch nicht gelernt hast.
      </h2>
      <p class="text-lg text-text-muted max-w-2xl mx-auto">
        Hormone, Histamin und dein Zyklus sind keine Feinde. Sie sind ein System. Wenn du verstehst, wie es funktioniert, kannst du es f&uuml;r dich nutzen — statt dagegen zu k&auml;mpfen.
      </p>
    </div>
  </section>

  {/* ──────────────────────────────────────────────
      5. MASTERCLASS PROMISE
      ────────────────────────────────────────────── */}
  <section class="py-14 md:py-20 bg-accent/5">
    <div class="max-w-3xl mx-auto px-4 md:px-6 text-center">
      <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/10 text-accent rounded-full mb-6">
        Kostenlose Masterclass
      </span>
      <h2 class="font-heading text-3xl md:text-4xl text-text mb-4">
        {pageTitle}
      </h2>
      <p class="text-lg text-text-muted max-w-2xl mx-auto mb-8">
        In dieser Masterclass zeige ich dir als &Auml;rztin, wie Hormone, Histamin und dein Zyklus zusammenwirken — und wie du dieses Wissen sofort in deinem Alltag nutzen kannst.
      </p>
      <a
        href="#warteliste"
        class="inline-flex items-center px-8 py-4 text-base font-medium bg-accent hover:bg-accent-dark text-white transition-all duration-300 rounded-button shadow-lg shadow-accent/25"
        onclick={trackOnClick('masterclass_waitlist_signup', { ...analyticsBase, cta_location: 'inline' })}
      >
        Zur Warteliste
        <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>

  {/* ──────────────────────────────────────────────
      6. PRACTICAL DETAILS
      ────────────────────────────────────────────── */}
  <section class="py-14 md:py-20 bg-bg">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-8 text-center">
        So funktioniert's
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 md:gap-8">
        <div class="text-center">
          <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-accent/10 flex items-center justify-center">
            <svg class="w-6 h-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="font-medium text-text mb-2">ca. 60 Minuten</h3>
          <p class="text-sm text-text-muted">Kompakt und auf den Punkt. Kein F&uuml;llmaterial.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-accent/10 flex items-center justify-center">
            <svg class="w-6 h-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25" />
            </svg>
          </div>
          <h3 class="font-medium text-text mb-2">Live + Aufzeichnung</h3>
          <p class="text-sm text-text-muted">Schau live mit oder in deinem eigenen Tempo.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-accent/10 flex items-center justify-center">
            <svg class="w-6 h-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
            </svg>
          </div>
          <h3 class="font-medium text-text mb-2">Konkreter Fahrplan</h3>
          <p class="text-sm text-text-muted">Du gehst mit einem Plan nach Hause, nicht nur mit Wissen.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ──────────────────────────────────────────────
      7. WHAT YOU'LL LEARN
      ────────────────────────────────────────────── */}
  <section class="py-14 md:py-20 bg-bg-alt">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-10 text-center">
        Was du in der Masterclass lernst
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
        {learnings.map((item, idx) => (
          <div class="flex items-start gap-4 js-reveal" style={`--reveal-delay: ${idx * 80}ms`}>
            <div class="w-10 h-10 rounded-full bg-accent/10 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-sm font-semibold text-accent">{idx + 1}</span>
            </div>
            <div>
              <h3 class="font-medium text-text mb-1">{item.title}</h3>
              <p class="text-sm text-text-muted leading-relaxed">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ──────────────────────────────────────────────
      8. EXPERT AUTHORITY + PERSONAL STORY
      ────────────────────────────────────────────── */}
  <section class="py-16 md:py-24 bg-bg">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <div class="grid grid-cols-1 md:grid-cols-5 gap-10 md:gap-12 items-center">
        <div class="md:col-span-2 flex justify-center js-reveal">
          <Image
            src={founderImage}
            alt={`${founder.name} — ${founder.role}`}
            width={320}
            height={320}
            class="w-48 h-48 md:w-64 md:h-64 rounded-full object-cover shadow-lg"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="md:col-span-3 js-reveal" style="--reveal-delay: 150ms">
          <div class="w-12 h-1 bg-accent rounded-full mb-6"></div>
          <h2 class="font-heading text-2xl md:text-3xl text-text mb-2">
            Deine Masterclass-Leiterin
          </h2>
          <p class="text-sm font-medium text-accent mb-5">{founder.name} &mdash; {founder.role}</p>
          <div class="space-y-4 text-text-muted leading-relaxed mb-6">
            <p>
              Als Not&auml;rztin wei&szlig; ich, wie wichtig es ist, Symptome ernst zu nehmen — auch wenn Blutwerte unauff&auml;llig sind. Als Ironman-Athletin kenne ich meinen eigenen K&ouml;rper bis an seine Grenzen.
            </p>
            <p>
              Diese Masterclass verbindet beides: &auml;rztliches Fachwissen und pers&ouml;nliche Erfahrung. Keine Panikmache, kein Dogma — sondern klare, ehrliche Antworten auf die Fragen, die du dir schon lange stellst.
            </p>
          </div>
          <ul class="space-y-2">
            {founder.qualifications.map((q) => (
              <li class="text-sm text-text-muted flex items-center gap-2">
                <svg class="w-4 h-4 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                {q}
              </li>
            ))}
            <li class="text-sm text-text-muted flex items-center gap-2">
              <svg class="w-4 h-4 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Ironman-Athletin
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* ──────────────────────────────────────────────
      9 + 10. PROOF / RECOGNITION
      ⚠ PLACEHOLDER TESTIMONIALS — NOT REAL QUOTES.
      TODO: Replace with verified, real testimonials before production launch.
      Do NOT ship these placeholder quotes as real proof.
      Remove this entire section if no real testimonials are available at launch.
      ────────────────────────────────────────────── */}
  <section class="py-14 md:py-20 bg-bg-alt">
    <div class="max-w-3xl mx-auto px-4 md:px-6 text-center">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-6">
        Das sagen Frauen, die mit mir arbeiten
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {/* PLACEHOLDER — replace with real testimonials or remove before go-live */}
        <blockquote class="bg-white rounded-card p-6 text-left border border-border">
          <p class="text-text-muted text-sm leading-relaxed italic mb-4">
            &bdquo;Endlich jemand, der mir erkl&auml;rt hat, warum meine Beschwerden immer zur selben Zyklusphase kommen. Das hat alles ver&auml;ndert.&ldquo;
          </p>
          <footer class="text-xs text-text-muted font-medium">&mdash; Coaching-Kundin, 38</footer>
        </blockquote>
        {/* PLACEHOLDER — replace with real testimonials or remove before go-live */}
        <blockquote class="bg-white rounded-card p-6 text-left border border-border">
          <p class="text-text-muted text-sm leading-relaxed italic mb-4">
            &bdquo;Ich hatte drei &Auml;rzte besucht, bevor ich zu Dr. Verena kam. Sie war die Erste, die das Gesamtbild gesehen hat.&ldquo;
          </p>
          <footer class="text-xs text-text-muted font-medium">&mdash; Coaching-Kundin, 44</footer>
        </blockquote>
      </div>
    </div>
  </section>

  {/* ──────────────────────────────────────────────
      11. FAQ
      ────────────────────────────────────────────── */}
  <FAQAccordion
    items={faqs}
    locale="de"
    pageType="masterclass"
    pageSlug={pageSlug}
  />

  {/* ──────────────────────────────────────────────
      12. FINAL CTA — Waitlist signup
      ────────────────────────────────────────────── */}
  <section id="warteliste" class="py-16 md:py-24 bg-primary-dark text-white">
    <div class="max-w-2xl mx-auto px-4 md:px-6 text-center">
      <h2 class="font-heading text-3xl md:text-4xl text-white mb-4">
        Sei dabei, wenn es losgeht.
      </h2>
      <p class="text-lg text-white/70 max-w-xl mx-auto mb-8">
        Trag dich jetzt in die Warteliste ein und erfahre als Erste, wann die Masterclass startet — inklusive exklusivem Fr&uuml;hbucher-Vorteil.
      </p>

      <div class="max-w-md mx-auto">
        <form
          id="masterclass-waitlist"
          class="flex flex-col sm:flex-row gap-3"
          data-email-payload={waitlistPayloadJson}
        >
          <input
            type="email"
            name="email"
            placeholder="Deine E-Mail-Adresse"
            required
            class="flex-1 px-4 py-3 rounded-button text-text bg-white border-0 focus:ring-2 focus:ring-accent outline-none text-sm"
            aria-label="E-Mail-Adresse f&uuml;r Warteliste"
          />
          <button
            type="submit"
            class="px-6 py-3 text-sm font-medium bg-accent hover:bg-accent-dark text-white rounded-button transition-colors whitespace-nowrap"
          >
            Masterclass vormerken
          </button>
        </form>
        <p class="waitlist-success hidden mt-4 text-white/90 text-sm" aria-live="polite">
          Du bist auf der Warteliste! Wir melden uns, sobald es losgeht.
        </p>
        <p class="waitlist-error hidden mt-4 text-red-300 text-sm" role="alert">
          Etwas ist schiefgelaufen. Bitte versuche es erneut.
        </p>
        <p class="text-xs text-white/50 mt-3">
          Kein Spam. Du kannst dich jederzeit abmelden.
        </p>
      </div>
    </div>
  </section>

  <CTABand
    title="Du hast Fragen?"
    subtitle="Schreib mir — ich antworte pers&ouml;nlich."
    ctaText="Kontakt aufnehmen"
    ctaHref="/kontakt"
    eventName="coaching_cta_click"
    locale="de"
    pageType="masterclass"
    pageSlug={pageSlug}
  />

  <script is:inline>
  (function() {
    var form = document.getElementById('masterclass-waitlist');
    if (!form) return;

    var btn = form.querySelector('button[type="submit"]');
    var btnText = btn ? btn.textContent : '';

    function setLoading(on) {
      if (!btn) return;
      btn.disabled = on;
      btn.textContent = on ? 'Einen Moment…' : btnText;
      var input = form.querySelector('input[type="email"]');
      if (input) input.disabled = on;
    }

    function showError() {
      var el = form.parentElement.querySelector('.waitlist-error');
      if (el) el.classList.remove('hidden');
    }

    function hideError() {
      var el = form.parentElement.querySelector('.waitlist-error');
      if (el) el.classList.add('hidden');
    }

    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var emailInput = form.querySelector('input[type="email"]');
      var email = emailInput ? emailInput.value : '';
      if (!email) return;

      hideError();
      setLoading(true);

      // Parse pre-built payload template from server, inject email
      var payloadTemplate = form.dataset.emailPayload;
      var payload = payloadTemplate ? JSON.parse(payloadTemplate) : {};
      payload.email = email;

      // Submit to email capture layer
      // In placeholder mode this logs to console; in real mode it POSTs to /api/email-capture
      var provider = 'placeholder'; // TODO: read from env when ESP is configured

      function onSuccess() {
        if (typeof trackEvent === 'function') {
          trackEvent('masterclass_waitlist_signup', {
            page_type: 'masterclass',
            page_slug: payload.masterclassSlug || '',
            locale: 'de',
            cta_location: 'product_bottom',
            provider: provider,
          });
        }
        form.style.display = 'none';
        var msg = form.parentElement.querySelector('.waitlist-success');
        if (msg) msg.classList.remove('hidden');
      }

      function onError() {
        setLoading(false);
        showError();
      }

      if (provider === 'placeholder') {
        console.log('[emailCapture:placeholder] masterclass_waitlist', JSON.stringify(payload, null, 2));
        onSuccess();
      } else {
        fetch('/api/email-capture', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        }).then(function(res) {
          if (res.ok) { onSuccess(); } else { onError(); }
        }).catch(function() {
          onError();
        });
      }
    });
  })();
  </script>
</BaseLayout>
