---
import { getCollection } from 'astro:content';
import LeadMagnetLayout from '../../layouts/LeadMagnetLayout.astro';

export async function getStaticPaths() {
  const leadMagnets = (await getCollection('leadMagnets')).filter((lm) => !lm.data.locale || lm.data.locale === 'de');
  return leadMagnets.map((lm) => ({
    params: { slug: lm.data.pageSlug },
    props: { entry: lm },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<LeadMagnetLayout leadMagnet={entry.data}>
  <Content />
</LeadMagnetLayout>
