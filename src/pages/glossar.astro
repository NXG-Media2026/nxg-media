---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import CTABand from '../components/CTABand.astro';
import { siteConfig } from '../data/site';
import { generateDefinedTermSet, generateBreadcrumbs } from '../data/schema';
import { glossarTerms } from '../data/glossar';
import { t } from '../i18n/utils';

const sortedTerms = [...glossarTerms].sort((a, b) => a.term.localeCompare(b.term, 'de'));

const letters = [...new Set(sortedTerms.map((term) => term.term.charAt(0).toUpperCase()))].sort((a, b) =>
  a.localeCompare(b, 'de'),
);

const breadcrumbs = [
  { label: t('breadcrumb.home'), href: '/' },
  { label: t('breadcrumb.glossar') },
];

const breadcrumbSchema = breadcrumbs.map((b) => ({
  name: b.label,
  url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}/glossar`,
}));
---

<BaseLayout
  title={`Glossar | ${siteConfig.name}`}
  description="Glossar der Frauen-Gesundheit: Fachbegriffe zu Hormonen, Zyklus, Ernährung und Training einfach erklärt."
  schemas={[
    generateDefinedTermSet(sortedTerms),
    generateBreadcrumbs(breadcrumbSchema),
  ]}
  locale="de"
>
  <BreadcrumbNav items={breadcrumbs} />

  <section class="py-16 md:py-24 lg:py-32 bg-bg">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <div class="text-center mb-14 md:mb-20">
        <h1 class="font-heading text-4xl md:text-5xl text-text mb-4">
          Glossar
        </h1>
        <p class="text-lg text-text-muted max-w-2xl mx-auto">
          Fachbegriffe der Frauen-Gesundheit — verständlich erklärt und wissenschaftlich fundiert.
        </p>
      </div>

      <nav class="flex flex-wrap justify-center gap-2 mb-12" aria-label="Buchstaben-Navigation">
        {letters.map((letter) => (
          <a
            href={`#letter-${letter}`}
            class="inline-flex items-center justify-center w-10 h-10 text-sm font-medium bg-white border border-border rounded-full hover:border-accent/30 hover:text-accent transition-colors"
          >
            {letter}
          </a>
        ))}
      </nav>

      {letters.map((letter) => {
        const termsForLetter = sortedTerms.filter(
          (term) => term.term.charAt(0).toUpperCase() === letter,
        );
        return (
          <section id={`letter-${letter}`} class="mb-12 last:mb-0 scroll-mt-24">
            <h2 class="font-heading text-2xl text-text mb-6 pb-2 border-b border-border">
              {letter}
            </h2>
            <div class="space-y-6">
              {termsForLetter.map((term) => (
                <div id={term.slug} class="scroll-mt-24">
                  <h3 class="font-medium text-text text-lg mb-2">{term.term}</h3>
                  <p class="text-sm text-text-muted leading-relaxed mb-2">
                    {term.definition}
                  </p>
                  {term.relatedTermSlugs && term.relatedTermSlugs.length > 0 && (
                    <div class="flex flex-wrap gap-2">
                      {term.relatedTermSlugs.map((slug) => {
                        const related = glossarTerms.find((t) => t.slug === slug);
                        return related ? (
                          <a
                            href={`#${slug}`}
                            class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/10 text-accent rounded-full hover:bg-accent/20 transition-colors"
                          >
                            {related.term}
                          </a>
                        ) : null;
                      })}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </section>

  <CTABand
    title="Du möchtest diese Begriffe in der Praxis anwenden?"
    subtitle="Entdecke meine Produkte und Coaching-Angebote — wissenschaftlich fundiert und auf dich zugeschnitten."
    ctaText="Angebot entdecken"
    ctaHref="/angebot"
    eventName="product_cta_click"
    locale="de"
    pageType="glossar"
    pageSlug="/glossar"
  />
</BaseLayout>
