---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import CalendlyEmbed from '../components/CalendlyEmbed.astro';
import { siteConfig } from '../data/site';
import { generateBreadcrumbs } from '../data/schema';
import { t, localizePath } from '../i18n/utils';
import { buildHreflangTrilingual } from '../i18n/hreflang';

const locale = 'nl';
const hreflang = buildHreflangTrilingual('/contact/', '/en/contact/', '/es/contacto/');
const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: localizePath('/', locale) },
  { label: 'Contact' },
];
const breadcrumbSchema = [
  { name: t('breadcrumb.home', locale), url: `${siteConfig.url}${localizePath('/', locale)}` },
  { name: 'Contact', url: `${siteConfig.url}/contact` },
];
---

<BaseLayout
  title={`Contact | ${siteConfig.name}`}
  description="Neem contact op met NXG Media of plan een gesprek met Joost."
  schemas={[generateBreadcrumbs(breadcrumbSchema)]}
  locale={locale}
  hreflang={hreflang}
  hideNewsletter={true}
  hideStickyMobileCTA={true}
>
  <BreadcrumbNav items={breadcrumbs} />

  <section class="refresh-hero refresh-contact"><div class="refresh-wrap refresh-split"><div><p class="refresh-eyebrow">VERTEL ONS WAAR JE NAARTOE WILT</p><h1>JOUW VOLGENDE STAP.<br /><span>BEGINT HIER.</span></h1><p>In 15 minuten bespreken we jouw bedrijf, je groeiplannen en welke aanpak daarbij past. Persoonlijk, concreet en vrijblijvend.</p><a class="refresh-button" href="#calendly">Kies een moment met Joost <span aria-hidden="true">↓</span></a></div><aside class="refresh-contact-card"><img src="/lander-assets/proof/joost.webp" alt="Joost van Putten" width="100" height="100" /><p class="refresh-eyebrow">JE SPREEKT MET JOOST</p><h2>GEWOON EVEN<br />KENNISMAKEN.</h2><p>Liever eerst iets vragen? Stuur me gerust een bericht.</p><a href={'mailto:' + siteConfig.email}>{siteConfig.email} ↗</a><a href={siteConfig.socials.linkedin} target="_blank" rel="noopener noreferrer">Vind me op LinkedIn ↗</a></aside></div></section>

  <CalendlyEmbed pageType="contact" pageSlug="contact" locale={locale} title="Kies jouw moment." subtitle="15 minuten. Jouw bedrijf, jouw vragen en een concrete volgende stap." />
</BaseLayout>
