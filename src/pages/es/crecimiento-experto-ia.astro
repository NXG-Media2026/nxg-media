---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import LogoMarquee from '../../components/LogoMarquee.astro';
import { siteConfig } from '../../data/site';
import { generateBreadcrumbs, generateFAQPage, generateService } from '../../data/schema';
import { buildHreflangTrilingual } from '../../i18n/hreflang';

import heroPhoto from '../../assets/images/founder/joost-sitting-laptop-lookingfront.webp';
import founderPhoto from '../../assets/images/founder/joost-standing-relaxed.webp';
import verenaPhoto from '../../assets/images/cases/verena-mann-linkedin.webp';
import jamesPhoto from '../../assets/images/cases/james-mitchell-portrait.png';
import proofVerenaAi from '../../assets/images/cases/doc_veri_ai_answer_cropped.PNG';
import proofVerenaChatgpt from '../../assets/images/cases/doc-veri-chatgptproof.jpeg';
import proofGoogle from '../../assets/images/cases/proof-google-torrevieja.png';
import proofChatgpt from '../../assets/images/cases/proof-chatgpt-local.png';

import josineWhatsApp from '../../assets/images/cases/coachjosine_whatsapp_proof.png';
import josineProduct from '../../assets/images/cases/eetgids-coachjosine-product-proof.webp';
import tessaWhatsApp from '../../assets/images/cases/tessa-youlife-whatsapp-proof.webp';
import rolfWhatsApp from '../../assets/images/cases/rolf-happywithyoga-whatsapp-proof.webp';

const locale = 'es';

const hreflang = buildHreflangTrilingual('/ai-expert-groei-traject/', '/en/ai-expert-growth/', '/es/crecimiento-experto-ia/');

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logos/*.{webp,avif,png,jpg}', { eager: true });
const logos = Object.entries(logoFiles)
  .filter(([path]) => /logo/i.test(path.split('/').pop()!))
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/, '');
    const name = filename.replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim();
    return { src: mod.default, alt: name };
  });

const breadcrumbs = [
  { label: 'Inicio', href: '/es/' },
  { label: 'Crecimiento Experto IA' },
];

const faqItems = [
  {
    question: '¿Esto es solo visibilidad en IA?',
    answer: 'La visibilidad en IA es el punto de entrada y diagnóstico. El programa trata sobre el fundamento detrás: posicionamiento, pruebas, contenido, ruta de entrada y seguimiento. Ser encontrado más fácilmente tiene poco valor si los visitantes no entienden por qué tú eres la opción lógica.',
  },
  {
    question: '¿Necesito construir una plataforma online de inmediato?',
    answer: 'La primera fase es deliberadamente pequeña: un posicionamiento claro, una primera ruta de entrada y pruebas de que las personas están dispuestas a dar el primer paso. Solo cuando eso funciona, seguimos construyendo. Muchos coaches nunca inician la fase 3 — comienzan con una ruta compacta que genera pruebas.',
  },
  {
    question: '¿La publicidad todavía funciona para coaches?',
    answer: 'Enviar publicidad directamente a un programa caro o una llamada de ventas suele ser difícil. Por eso normalmente construimos primero un paso intermedio, como una guía, scan, masterclass o mini-producto. Esto reduce la barrera y genera confianza antes de que alguien agende una llamada.',
  },
  {
    question: '¿Qué pasa si ya tengo un sitio web?',
    answer: 'Evaluamos qué es útil y qué necesita mejorarse. A veces construimos sobre lo que ya existe; a veces un nuevo fundamento tiene más sentido. No se trata de la tecnología, sino de si tu expertise se comunica con suficiente claridad para visitantes e IA.',
  },
  {
    question: '¿Esto es adecuado si aún no tengo una gran audiencia?',
    answer: 'Una gran audiencia no es un requisito, siempre que tu expertise y oferta sean suficientemente claras. Con una ruta pequeña probamos a qué responden las personas. A menudo el crecimiento no comienza con más alcance, sino con un posicionamiento más afilado y un primer paso más claro.',
  },
];

const faqForSchema = faqItems.map((item) => ({ question: item.question, answer: item.answer }));
const faqForComponent = faqItems.map((item) => ({ q: item.question, a: item.answer }));

const serviceSchema = generateService({
  name: 'Programa de Crecimiento Experto IA',
  description: 'Construye una base de experto AI-ready alrededor de tu expertise. Para coaches y expertos que quieren ser encontrados y construir una ruta hacia consultas, productos y clientes de coaching.',
  url: `${siteConfig.url}/es/crecimiento-experto-ia/`,
  serviceType: 'Expert Growth System',
});
---

<BaseLayout
  title="Programa de Crecimiento para Coaches y Expertos | NXG Media"
  description="Construye una base de experto AI-ready alrededor de tu expertise. Para coaches y expertos que quieren ser encontrados y construir una ruta hacia consultas, productos y clientes de coaching."
  canonical={`${siteConfig.url}/es/crecimiento-experto-ia/`}
  schemas={[
    generateBreadcrumbs(breadcrumbs.map((b) => ({ name: b.label, url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}/es/crecimiento-experto-ia/` }))),
    generateFAQPage(faqForSchema),
    serviceSchema,
  ]}
  hreflang={hreflang}
  locale={locale}
>
  <BreadcrumbNav items={breadcrumbs} />

  {/* ── 1. HERO ── */}
  <section class="relative py-16 md:py-24 lg:py-32 overflow-hidden">
    <div class="absolute inset-0">
      <Image
        src={heroPhoto}
        alt="Joost van Putten — estratega de crecimiento online para coaches y expertos"
        widths={[800, 1200, 1600]}
        sizes="100vw"
        class="w-full h-full object-cover"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-white/95 via-white/85 to-white/40"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 md:px-6">
      <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl text-text mb-5 leading-tight max-w-2xl">
        Tu scan revela d&oacute;nde tu fundamento de experto tiene fugas. <em class="text-accent not-italic">Ahora construimos la ruta hacia consultas.</em>
      </h1>
      <p class="text-text-muted leading-relaxed mb-8 max-w-xl">
        La visibilidad en IA es el punto de entrada. Pero cuando la IA no te entiende bien, suele ser el mismo problema que sienten los clientes potenciales: tu posicionamiento, pruebas, ruta de entrada y seguimiento a&uacute;n no est&aacute;n conectados de forma l&oacute;gica.
      </p>
      <div class="flex flex-col sm:flex-row items-start gap-3">
        <a
          href="#analyse"
          class="inline-flex items-center px-8 py-4 text-base font-medium text-text-inverse bg-primary hover:bg-primary-dark transition-colors rounded-button shadow-lg"
        >
          Que Joost determine mi ruta de crecimiento
          <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a
          href="#cases"
          class="inline-flex items-center px-8 py-4 text-base font-medium text-primary border-2 border-primary hover:bg-primary/5 transition-colors rounded-button"
        >
          Ver los casos
        </a>
      </div>
      <p class="text-xs text-text-muted mt-4">
        Para coaches, terapeutas y expertos que quieren convertir su expertise en consultas, productos y clientes de coaching.
      </p>
    </div>
  </section>

  {/* ── 2. PROOF STRIP ── */}
  <section class="bg-bg-alt border-y border-border">
    <div class="max-w-4xl mx-auto px-4 md:px-6 py-8 md:py-10">
      <p class="text-xs uppercase tracking-widest text-text-muted font-medium text-center mb-5">Lo que esto ya gener&oacute; para otros expertos</p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <div class="font-heading text-2xl md:text-3xl text-primary">2 &rarr; 19</div>
          <p class="text-xs text-text-muted mt-1">consultas/mes</p>
          <p class="text-xs text-accent font-medium mt-0.5">Dr. Verena Mann</p>
        </div>
        <div>
          <div class="font-heading text-2xl md:text-3xl text-primary">600+</div>
          <p class="text-xs text-text-muted mt-1">gu&iacute;as vendidas</p>
          <p class="text-xs text-accent font-medium mt-0.5">Coach Josine</p>
        </div>
        <div>
          <div class="font-heading text-2xl md:text-3xl text-primary">&plusmn;&euro;10k/mes</div>
          <p class="text-xs text-text-muted mt-1">ingresos por productos online</p>
          <p class="text-xs text-accent font-medium mt-0.5">Tessa / Youlife</p>
        </div>
        <div>
          <div class="font-heading text-2xl md:text-3xl text-primary">2.000</div>
          <p class="text-xs text-text-muted mt-1">miembros de pago</p>
          <p class="text-xs text-accent font-medium mt-0.5">Happy With Yoga</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── 3. REFRAME: FUNDAMENTO DE EXPERTO ── */}
  <section class="py-14 md:py-20">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-3">
        Tu problema normalmente no es solo visibilidad. Es tu fundamento de experto.
      </h2>
      <p class="text-text-muted leading-relaxed mb-10 max-w-3xl">
        Tu expertise puede ser fuerte, pero si tu fundamento online no muestra claramente por qu&eacute; eres la opci&oacute;n l&oacute;gica, qu&eacute; puede hacer alguien como primer paso y c&oacute;mo se construye la confianza, pierdes inter&eacute;s c&aacute;lido.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">
        <div class="bg-white rounded-card p-5 border border-border">
          <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center mb-3">
            <span class="font-heading text-primary text-lg">1</span>
          </div>
          <h3 class="font-heading text-lg text-text mb-1">Ser encontrado</h3>
          <p class="text-sm text-text-muted leading-relaxed">IA, Google y visitantes entienden en qu&eacute; eres el experto.</p>
        </div>
        <div class="bg-white rounded-card p-5 border border-border">
          <div class="w-10 h-10 rounded-full bg-accent/10 flex items-center justify-center mb-3">
            <span class="font-heading text-accent text-lg">2</span>
          </div>
          <h3 class="font-heading text-lg text-text mb-1">Construir confianza</h3>
          <p class="text-sm text-text-muted leading-relaxed">Tu m&eacute;todo, historia, pruebas y resultados est&aacute;n en el lugar correcto.</p>
        </div>
        <div class="bg-white rounded-card p-5 border border-border">
          <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center mb-3">
            <span class="font-heading text-primary text-lg">3</span>
          </div>
          <h3 class="font-heading text-lg text-text mb-1">Que las personas den el primer paso</h3>
          <p class="text-sm text-text-muted leading-relaxed">Una gu&iacute;a, scan, masterclass o mini-producto hace que el primer paso sea f&aacute;cil.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── 4. RUTA DE 90 D&Iacute;AS ── */}
  <section class="py-14 md:py-20 bg-bg-alt">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-3">En los primeros 90 d&iacute;as construimos tu primera ruta de crecimiento</h2>
      <p class="text-text-muted leading-relaxed mb-10 max-w-3xl">
        No una gran plataforma de inmediato. Primero una ruta compacta que demuestre que las personas est&aacute;n dispuestas a dar el primer paso.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6 mb-8">
        <div class="bg-white rounded-card p-5 border border-border">
          <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-medium bg-primary/10 text-primary rounded-full mb-3">Fase 1</span>
          <h3 class="font-heading text-lg text-text mb-2">Posici&oacute;n de experto + p&aacute;ginas de nicho</h3>
          <p class="text-sm text-text-muted leading-relaxed">&iquest;Para qui&eacute;n eres la opci&oacute;n l&oacute;gica, qu&eacute; problema resuelves y c&oacute;mo se hace visible para IA, Google y visitantes?</p>
        </div>
        <div class="bg-white rounded-card p-5 border border-border">
          <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-medium bg-accent/10 text-accent rounded-full mb-3">Fase 2</span>
          <h3 class="font-heading text-lg text-text mb-2">Ruta de entrada + landing page</h3>
          <p class="text-sm text-text-muted leading-relaxed">Una gu&iacute;a, scan, masterclass o mini-producto con una p&aacute;gina que lleva a las personas al siguiente paso.</p>
        </div>
        <div class="bg-white rounded-card p-5 border border-border">
          <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-medium bg-primary/10 text-primary rounded-full mb-3">Fase 3</span>
          <h3 class="font-heading text-lg text-text mb-2">Seguimiento por email + test de tr&aacute;fico</h3>
          <p class="text-sm text-text-muted leading-relaxed">Un flujo corto que construye confianza y una primera prueba con publicidad o canales existentes.</p>
        </div>
      </div>

      <p class="text-accent font-medium text-center">
        Los primeros 90 d&iacute;as est&aacute;n dise&ntilde;ados para crear pruebas &mdash; no para construir una gran plataforma de inmediato.
      </p>
    </div>
  </section>

  {/* ── 5. CASOS / PRUEBAS ── */}
  <section id="cases" class="py-16 md:py-24 bg-primary">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-3xl md:text-4xl text-white mb-3">Esto es lo que puede suceder cuando el fundamento es correcto</h2>
      <p class="text-white/60 mb-12 max-w-3xl">
        No todos los coaches construyen una gran plataforma de inmediato. A menudo comienza m&aacute;s peque&ntilde;o: empaquetar la expertise de forma m&aacute;s afilada, construir una primera ruta de entrada y demostrar que las personas est&aacute;n dispuestas a dar el primer paso.
      </p>

      {/* ── Caso 1: Dr. Verena Mann ── */}
      <div class="bg-white/5 backdrop-blur border border-white/10 rounded-card p-5 md:p-8 mb-8">
        <div class="flex items-center gap-4 mb-5">
          <div class="w-12 h-12 rounded-full overflow-hidden ring-2 ring-accent/30 shrink-0">
            <Image src={verenaPhoto} alt="Dr. Verena Mann" widths={[48, 96]} sizes="48px" class="w-full h-full object-cover" loading="lazy" decoding="async" />
          </div>
          <div>
            <p class="text-white font-medium text-sm">Dr. Verena Mann</p>
            <a href="https://doc-veri.pages.dev" target="_blank" rel="noopener" class="text-accent/70 hover:text-accent text-xs transition-colors">doc-veri.pages.dev</a>
          </div>
          <div class="ml-auto flex items-center gap-3">
            <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-medium bg-accent/20 text-accent rounded-full">Plataforma de experto</span>
          </div>
        </div>

        <div class="grid grid-cols-3 gap-3 mb-5">
          <div class="bg-white/5 rounded-lg p-3 text-center">
            <p class="font-heading text-xl text-accent">2 &rarr; 19</p>
            <p class="text-[10px] text-white/50">consultas/mes</p>
          </div>
          <div class="bg-white/5 rounded-lg p-3 text-center">
            <p class="font-heading text-xl text-accent">0 &rarr; 15</p>
            <p class="text-[10px] text-white/50">menciones en IA</p>
          </div>
          <div class="bg-white/5 rounded-lg p-3 text-center">
            <p class="font-heading text-xl text-accent">&plusmn;6 sem</p>
            <p class="text-[10px] text-white/50">en vivo</p>
          </div>
        </div>

        <p class="text-white/70 text-sm leading-relaxed mb-3">
          Fuerte expertise y una comunidad activa, pero apenas consultas de personas que a&uacute;n no la conoc&iacute;an. Al empaquetar su expertise de forma m&aacute;s concreta alrededor de temas, problemas de clientes y pruebas, no solo se hizo m&aacute;s visible sino tambi&eacute;n m&aacute;s l&oacute;gica para contactar.
        </p>
        <p class="text-accent text-sm font-medium italic">
          &ldquo;De una mejor presencia online a consultas de personas que a&uacute;n no la conoc&iacute;an.&rdquo;
        </p>

        <div class="grid grid-cols-2 gap-3 mt-5">
          <div class="lightbox-trigger cursor-zoom-in group">
            <div class="bg-black/40 border border-white/10 rounded-lg overflow-hidden">
              <Image src={proofVerenaAi} alt="ChatGPT menciona a Dr. Verena Mann como experta adecuada" width={1200} quality={85} class="w-full h-auto" loading="lazy" />
            </div>
            <p class="text-white/30 text-[10px] mt-1 text-center group-hover:text-white/50 transition-colors">Respuesta de IA: &ldquo;eine passende Expertin&rdquo;</p>
          </div>
          <div class="lightbox-trigger cursor-zoom-in group">
            <div class="bg-black/40 border border-white/10 rounded-lg overflow-hidden">
              <Image src={proofVerenaChatgpt} alt="ChatGPT recomienda a Dr. Verena Mann con enlace directo" width={1200} quality={85} class="w-full h-auto" loading="lazy" />
            </div>
            <p class="text-white/30 text-[10px] mt-1 text-center group-hover:text-white/50 transition-colors">ChatGPT con enlace directo a su sitio</p>
          </div>
        </div>
      </div>

      {/* ── Caso 2: Coach Josine ── */}
      <div class="bg-white/5 backdrop-blur border border-white/10 rounded-card p-5 md:p-8 mb-8">
        <div class="flex items-center gap-4 mb-5">
          <div>
            <p class="text-white font-medium text-sm">Josine &mdash; Coach Josine</p>
            <a href="https://www.coachjosine.nl" target="_blank" rel="noopener" class="text-accent/70 hover:text-accent text-xs transition-colors">coachjosine.nl</a>
          </div>
          <div class="ml-auto">
            <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-medium bg-accent/20 text-accent rounded-full">Primera tracci&oacute;n</span>
          </div>
        </div>

        <div class="grid grid-cols-3 gap-3 mb-5">
          <div class="bg-white/5 rounded-lg p-3 text-center">
            <p class="font-heading text-xl text-accent">600+</p>
            <p class="text-[10px] text-white/50">gu&iacute;as vendidas</p>
          </div>
          <div class="bg-white/5 rounded-lg p-3 text-center">
            <p class="font-heading text-xl text-accent">80</p>
            <p class="text-[10px] text-white/50">inscripciones a masterclass</p>
          </div>
          <div class="bg-white/5 rounded-lg p-3 text-center">
            <p class="font-heading text-xl text-accent">18</p>
            <p class="text-[10px] text-white/50">quer&iacute;an el programa directamente</p>
          </div>
        </div>

        <p class="text-white/70 text-sm leading-relaxed mb-3">
          Ten&iacute;a expertise, pero ninguna ruta de entrada digital. Hicimos su primera gu&iacute;a concreta, construimos la landing page y la conectamos a una ruta de masterclass. Las personas compraron la gu&iacute;a, asistieron a la masterclass y preguntaron por el programa.
        </p>
        <p class="text-accent text-sm font-medium italic">
          &ldquo;No una plataforma de inmediato, sino primero pruebas de que las personas est&aacute;n dispuestas a dar el primer paso.&rdquo;
        </p>

        <div class="grid grid-cols-2 gap-3 mt-5">
          <div class="lightbox-trigger cursor-zoom-in group">
            <div class="bg-black/40 border border-white/10 rounded-lg overflow-hidden">
              <Image src={josineProduct} alt="Gu&iacute;a alimentaria Coach Josine — p&aacute;gina de producto" width={600} quality={80} class="w-full h-auto" loading="lazy" />
            </div>
            <p class="text-white/30 text-[10px] mt-1 text-center group-hover:text-white/50 transition-colors">La gu&iacute;a alimentaria que gener&oacute; las pruebas</p>
          </div>
          <div class="lightbox-trigger cursor-zoom-in group">
            <div class="bg-black/40 border border-white/10 rounded-lg overflow-hidden">
              <Image src={josineWhatsApp} alt="Mensaje de WhatsApp de Josine sobre resultados" width={600} quality={80} class="w-full h-auto" loading="lazy" />
            </div>
            <p class="text-white/30 text-[10px] mt-1 text-center group-hover:text-white/50 transition-colors">Respuesta de Josine</p>
          </div>
        </div>
      </div>

      {/* ── Caso 3: Tessa / Youlife ── */}
      <div class="bg-white/5 backdrop-blur border border-white/10 rounded-card p-5 md:p-8 mb-8">
        <div class="flex items-center gap-4 mb-5">
          <div>
            <p class="text-white font-medium text-sm">Tessa &mdash; Youlife</p>
          </div>
          <div class="ml-auto">
            <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-medium bg-accent/20 text-accent rounded-full">Crecimiento de producto</span>
          </div>
        </div>

        <div class="grid grid-cols-3 gap-3 mb-5">
          <div class="bg-white/5 rounded-lg p-3 text-center">
            <p class="font-heading text-xl text-accent">&euro;10k/mes</p>
            <p class="text-[10px] text-white/50">ingresos por productos online</p>
          </div>
          <div class="bg-white/5 rounded-lg p-3 text-center">
            <p class="font-heading text-xl text-accent">1 &rarr; 6</p>
            <p class="text-[10px] text-white/50">productos online</p>
          </div>
          <div class="bg-white/5 rounded-lg p-3 text-center">
            <p class="font-heading text-xl text-accent">&plusmn;10/mes</p>
            <p class="text-[10px] text-white/50">clientes de coaching</p>
          </div>
        </div>

        <p class="text-white/70 text-sm leading-relaxed mb-3">
          No comenz&oacute; con una gran plataforma, sino con productos individuales y la pregunta: &iquest;c&oacute;mo hacemos esto predecible? Desde un producto construimos hacia m&uacute;ltiples productos, flujos de email y consultas de coaching.
        </p>
        <p class="text-accent text-sm font-medium italic">
          &ldquo;La Gu&iacute;a se vende muy bien. Ya es rentable.&rdquo;
        </p>

        <div class="grid grid-cols-2 gap-3 mt-5">
          <div class="lightbox-trigger cursor-zoom-in group">
            <div class="bg-black/40 border border-white/10 rounded-lg overflow-hidden">
              <Image src={tessaWhatsApp} alt="Mensaje de WhatsApp de Tessa — resultados Youlife" width={600} quality={80} class="w-full h-auto" loading="lazy" />
            </div>
            <p class="text-white/30 text-[10px] mt-1 text-center group-hover:text-white/50 transition-colors">Respuesta de Tessa</p>
          </div>
          <div class="bg-white/5 rounded-lg p-4 flex items-center justify-center">
