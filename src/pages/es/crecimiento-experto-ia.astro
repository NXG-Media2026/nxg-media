  {/* ── Lightbox script ── */}
  <script is:inline>
  document.addEventListener('DOMContentLoaded', function() {
    var triggers = document.querySelectorAll('.lightbox-trigger');
    if (triggers.length === 0) return;

    var images = Array.from(triggers).map(function(t) {
      var img = t.querySelector('img');
      return img ? img.src : '';
    });

    var overlay = document.createElement('div');
    overlay.className = 'fixed inset-0 z-50 bg-black/85 hidden items-center justify-center p-4';
    overlay.id = 'lightbox';
    overlay.innerHTML = '<button type="button" class="absolute top-4 right-4 text-white/80 hover:text-white z-10" id="lightbox-close"><svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg></button><img src="" alt="" class="max-w-[90vw] max-h-[90vh] rounded-lg shadow-2xl" id="lightbox-img" />';
    document.body.appendChild(overlay);

    var lbImg = document.getElementById('lightbox-img');
    var lbClose = document.getElementById('lightbox-close');

    function openLightbox(index) {
      if (!images[index]) return;
      lbImg.src = images[index];
      lbImg.alt = (triggers[index].querySelector('img') || {}).alt || '';
      overlay.classList.remove('hidden');
      overlay.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }
    function closeLightbox() {
      overlay.classList.add('hidden');
      overlay.classList.remove('flex');
      document.body.style.overflow = '';
    }

    triggers.forEach(function(trigger, i) {
      trigger.addEventListener('click', function() { openLightbox(i); });
    });
    lbClose.addEventListener('click', closeLightbox);
    overlay.addEventListener('click', function(e) { if (e.target === overlay) closeLightbox(); });
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeLightbox(); });
  });
  </script>

  <script is:inline>
  (function() {
    var form = document.getElementById('groei-form');
    var thanks = document.getElementById('groei-thanks');
    var microcopy = document.getElementById('groei-microcopy');
    if (!form || !thanks) return;

    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var data = new FormData(form);
      var naam = data.get('naam');
      var email = data.get('email');
      var website = data.get('website') || '';

      if (!naam || !email) return;

      var btn = form.querySelector('button[type="submit"]');
      if (btn) { btn.disabled = true; btn.textContent = 'Un momento...'; }

      var checked = Array.from(form.querySelectorAll('input[name="interesse"]:checked')).map(function(cb) { return cb.value; });
      var interesse = checked.length > 0 ? checked.join(', ') : 'niet ingevuld';

      var payload = {
        naam: naam,
        email: email,
        websiteUrl: website || 'niet ingevuld',
        vraag: 'Expert Groei Traject aanvraag — Interesse: ' + interesse,
        source: 'expert-groei-traject-es',
      };

      var leadId = typeof nxgCapiEventId === 'function' ? nxgCapiEventId() : '';
      if (typeof fbq === 'function') {
        fbq('track', 'Lead', { content_name: 'expert-groei-traject-es', content_category: 'crecimiento-experto-ia' }, { eventID: leadId });
      }
      if (leadId && typeof nxgCapiSend === 'function') {
        nxgCapiSend('Lead', leadId, { content_name: 'expert-groei-traject-es', content_category: 'crecimiento-experto-ia' });
      }
      if (typeof trackEvent === 'function') {
        trackEvent('scanner_request_submitted', {
          page_type: 'page',
          page_slug: 'crecimiento-experto-ia',
          locale: 'es',
          cta_location: 'inline',
        });
      }

      fetch('https://scanner.nxg-media.com/api/gratis-check', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(payload),
      }).then(function() {
        showThanks();
      }).catch(function() {
        showThanks();
      });

      function showThanks() {
        form.classList.add('hidden');
        thanks.classList.remove('hidden');
        if (microcopy) microcopy.classList.add('hidden');
      }
    });
  })();
  </script>

