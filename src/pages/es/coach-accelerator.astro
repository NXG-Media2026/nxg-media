---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import LogoMarquee from '../../components/LogoMarquee.astro';
import { siteConfig } from '../../data/site';
import { generateBreadcrumbs, generateFAQPage, generateService } from '../../data/schema';
import { buildHreflangTrilingual } from '../../i18n/hreflang';

import heroPhoto from '../../assets/images/founder/joost-sitting-laptop-lookingfront.webp';
import founderPhoto from '../../assets/images/founder/joost-standing-relaxed.webp';
import verenaPhoto from '../../assets/images/cases/verena-mann-linkedin.webp';
import jamesPhoto from '../../assets/images/cases/james-mitchell-portrait.png';
import proofVerenaAi from '../../assets/images/cases/doc_veri_ai_answer_cropped.PNG';
import proofVerenaChatgpt from '../../assets/images/cases/doc-veri-chatgptproof.jpeg';
import proofGoogle from '../../assets/images/cases/proof-google-torrevieja.png';
import proofChatgpt from '../../assets/images/cases/proof-chatgpt-local.png';

import josineWhatsApp from '../../assets/images/cases/coachjosine_whatsapp_proof.png';
import josineProduct from '../../assets/images/cases/eetgids-coachjosine-product-proof.webp';
import tessaWhatsApp from '../../assets/images/cases/tessa-youlife-whatsapp-proof.webp';
import rolfWhatsApp from '../../assets/images/cases/rolf-happywithyoga-whatsapp-proof.webp';

const locale = 'es';

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logos/*.{webp,avif,png,jpg}', { eager: true });
const logos = Object.entries(logoFiles)
  .filter(([path]) => /logo/i.test(path.split('/').pop()!))
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/, '');
    const name = filename.replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim();
    return { src: mod.default, alt: name };
  });

const breadcrumbs = [
  { label: 'Inicio', href: '/es/' },
  { label: 'Coach Accelerator' },
];

const faqItems = [
  {
    question: '¿Esto es solo visibilidad en IA?',
    answer: 'La visibilidad en IA es el punto de entrada. El programa trata sobre el fundamento detrás: posicionamiento, pruebas, contenido, ruta de entrada y seguimiento. Ser encontrado más fácilmente tiene poco valor si los visitantes no entienden por qué tú eres la opción lógica.',
  },
  {
    question: '¿El fundamento web está incluido en Coach Accelerator?',
    answer: 'Sí. Tu sitio web, posición de experto y visibilidad forman la base de Coach Accelerator. Sobre eso construimos la ruta de entrada, seguimiento por email, estrategia publicitaria, test de leads y optimización hacia clientes. El fundamento es parte del programa.',
  },
  {
    question: '¿Necesito construir una plataforma online de inmediato?',
    answer: 'La primera fase es deliberadamente pequeña: un posicionamiento claro, una primera ruta de entrada y pruebas de que las personas están dispuestas a dar el primer paso. Solo cuando eso funciona, seguimos construyendo. Muchos coaches no inician la fase 3 — comienzan con una ruta compacta que genera pruebas.',
  },
  {
    question: '¿La publicidad todavía funciona para coaches?',
    answer: 'Enviar publicidad directamente a un programa caro o una llamada de ventas suele ser difícil. Por eso normalmente construimos primero un paso intermedio, como una guía, scan, masterclass o mini-producto. Esto reduce la barrera y genera confianza antes de que alguien agende una llamada.',
  },
  {
    question: '¿Qué pasa si ya tengo un sitio web?',
    answer: 'Evaluamos qué es útil y qué necesita mejorarse. A veces construimos sobre lo que ya existe; a veces un nuevo fundamento tiene más sentido. No se trata de la tecnología, sino de si tu expertise se comunica con suficiente claridad para visitantes e IA.',
  },
  {
    question: '¿Esto es adecuado si aún no tengo una gran audiencia?',
    answer: 'Una gran audiencia no es un requisito, siempre que tu expertise y oferta sean suficientemente claras. Con una ruta pequeña probamos a qué responden las personas. A menudo el crecimiento no comienza con más alcance, sino con un posicionamiento más afilado y un primer paso más claro.',
  },
  {
    question: '¿Puedo recibir solo algunos consejos sueltos?',
    answer: 'No como un programa de asesoramiento extenso. Este análisis está pensado para coaches y expertos que quieren saber qué ruta tiene más potencial comercial. Si solo buscas consejos gratuitos para quizá usarlos algún día, este programa no es el adecuado.',
  },
  {
    question: '¿Qué pasa si resulta que hay poco potencial de crecimiento?',
    answer: 'Entonces lo decimos honestamente. No todos los expertos o nichos son adecuados para este modelo. Preferimos no empezar a hacer un programa donde hay poca oportunidad comercial.',
  },
];

const faqForSchema = faqItems.map((item) => ({ question: item.question, answer: item.answer }));
const faqForComponent = faqItems.map((item) => ({ q: item.question, a: item.answer }));

const hreflang = buildHreflangTrilingual(
  '/coach-accelerator/',
  '/en/coach-accelerator/',
  '/es/coach-accelerator/',
);

const serviceSchema = generateService({
  name: 'Coach Accelerator',
  description: 'De expertise a consultas, inscripciones y clientes. Coach Accelerator Growth System desde €500/mes. Para coaches, terapeutas y expertos en conocimiento.',
  url: `${siteConfig.url}/es/coach-accelerator/`,
  serviceType: 'Expert Growth System',
});
---

<BaseLayout
  title="Coach Accelerator para Coaches y Expertos | NXG Media"
  description="Tu expertise no es el problema. Tu sistema hacia clientes sí. Coach Accelerator desde €500/mes."
  canonical={`${siteConfig.url}/es/coach-accelerator/`}
  schemas={[
    generateBreadcrumbs(breadcrumbs.map((b) => ({ name: b.label, url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}/es/coach-accelerator/` }))),
    generateFAQPage(faqForSchema),
    serviceSchema,
  ]}
  locale={locale}
  hreflang={hreflang}
  hideNewsletter={true}
  hideStickyMobileCTA={true}
>
  <BreadcrumbNav items={breadcrumbs} />


  {/* ── 1. HERO ── */}
  <section class="refresh-sales-hero relative overflow-hidden bg-primary">
    <div class="absolute inset-0 hidden md:block">
      <Image src={heroPhoto} alt="" width={800} class="absolute right-0 top-0 h-full w-auto object-cover object-top opacity-[0.15]" loading="eager" />
    </div>

    <div class="relative px-5 md:px-6 pt-10 pb-10 md:pt-14 md:pb-16">
      <div class="max-w-2xl mx-auto">
        <h1 class="font-heading text-[1.75rem] leading-[1.15] md:text-[2.75rem] md:leading-[1.1] text-white mb-4">
          Tu expertise no es el problema.<br />
          <em class="text-accent not-italic">Tu sistema hacia clientes sí.</em>
        </h1>

        <p class="text-white/70 leading-relaxed mb-2 text-[0.9rem] md:text-base max-w-xl">
          Para coaches, terapeutas y expertos que quieren más consultas, inscripciones y clientes a partir de su conocimiento &mdash; sin depender de publicaciones sueltas, DMs o llamadas de ventas directas.
        </p>
        <p class="text-white/90 font-medium mb-5 text-[0.9rem] md:text-base max-w-xl">
          Construimos tu sistema de crecimiento completo: sitio web de experto, posicionamiento, ruta de entrada, seguimiento por email, publicidad y un camino desde el primer clic hasta el cliente que paga.
        </p>

        <p class="text-accent text-xs font-medium uppercase tracking-widest mb-3">Este modelo ya generó:</p>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-6 max-w-lg">
          <div class="bg-white/[0.08] border border-white/15 rounded-lg px-3 py-2 text-center">
            <p class="font-heading text-lg text-white">2 &rarr; 19</p>
            <p class="text-white/50 text-[0.6rem]">consultas/mes</p>
          </div>
          <div class="bg-white/[0.08] border border-white/15 rounded-lg px-3 py-2 text-center">
            <p class="font-heading text-lg text-white">600+</p>
            <p class="text-white/50 text-[0.6rem]">guías vendidas</p>
          </div>
          <div class="bg-white/[0.08] border border-white/15 rounded-lg px-3 py-2 text-center">
            <p class="font-heading text-lg text-white">&euro;10k/mes</p>
            <p class="text-white/50 text-[0.6rem]">ingresos por productos</p>
          </div>
          <div class="bg-white/[0.08] border border-white/15 rounded-lg px-3 py-2 text-center">
            <p class="font-heading text-lg text-white">2.000</p>
            <p class="text-white/50 text-[0.6rem]">miembros de pago</p>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-start gap-3">
          <a href="#analyse" class="inline-flex items-center gap-2 px-8 py-4 text-base font-medium text-white bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg w-full sm:w-auto justify-center">
            Comprueba mi potencial de crecimiento
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </a>
          <a href="#cases" class="inline-flex items-center px-8 py-4 text-base font-medium text-white/80 border border-white/20 hover:bg-white/5 transition-colors rounded-button w-full sm:w-auto justify-center">
            Ver los casos de coaches
          </a>
        </div>

        <p class="text-white/40 text-xs mt-4">Un programa de 90 días. Fecha de inicio a convenir.</p>
      </div>
    </div>
  </section>


  {/* ── 2. DOLOR — BLOQUE OSCURO DE CONTRASTE ── */}
  <section class="px-4 md:px-6 py-14 md:py-20 bg-primary-dark">
    <div class="max-w-2xl mx-auto">
      <p class="text-accent text-xs font-semibold uppercase tracking-[0.2em] mb-6 text-center">Cómo se siente ahora mismo</p>

      <div class="space-y-6 mb-10">
        {[
          'Vives de referencias y boca a boca. Funciona… hasta que se detiene.',
          'Sabes que "deberías hacer algo con el marketing", pero el trabajo con clientes siempre va primero.',
          'Recibes reacciones a tu contenido, pero no suficientes consultas.',
          'Tu sitio web cuenta quién eres, pero no construye una ruta hacia inscripción, confianza y consulta.',
          'Cuando todo se queda en silencio, en realidad ya es demasiado tarde para construir con calma.',
        ].map((line) => (
          <div class="flex items-start gap-3">
            <span class="shrink-0 w-1.5 h-1.5 rounded-full bg-accent mt-2"></span>
            <p class="text-white/80 text-[0.95rem] md:text-base leading-relaxed">{line}</p>
          </div>
        ))}
      </div>

      <div class="border-t border-white/10 pt-8">
        <p class="text-white font-heading text-xl md:text-2xl leading-snug text-center">
          No eres malo en los negocios. Solo te falta un sistema que trabaje para ti, incluso cuando estás ocupado con clientes.
        </p>
      </div>
    </div>
  </section>


  {/* ── 3. EL VIEJO ENFOQUE YA NO FUNCIONA ── */}
  <section class="px-4 md:px-6 py-12 md:py-16">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-8 text-center">El viejo enfoque ya no funciona</h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
        <div class="bg-white rounded-card p-5 border border-border shadow-sm">
          <div class="w-8 h-8 rounded-full bg-red-50 flex items-center justify-center mb-3">
            <svg class="w-4 h-4 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
          </div>
          <p class="font-heading text-base text-text mb-2">E-books y descargas gratuitas</p>
          <p class="text-sm text-text-muted leading-relaxed">Compartes tus mejores consejos en un PDF. La gente lo descarga, pero la mayoría de los leads luego desaparecen.</p>
        </div>
        <div class="bg-white rounded-card p-5 border border-border shadow-sm">
          <div class="w-8 h-8 rounded-full bg-red-50 flex items-center justify-center mb-3">
            <svg class="w-4 h-4 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
          </div>
          <p class="font-heading text-base text-text mb-2">&lsquo;Reserva una llamada gratuita&rsquo;</p>
          <p class="text-sm text-text-muted leading-relaxed">Atraes personas que solo quieren charlar, aún no tienen confianza o no se presentan.</p>
        </div>
        <div class="bg-white rounded-card p-5 border border-border shadow-sm">
          <div class="w-8 h-8 rounded-full bg-red-50 flex items-center justify-center mb-3">
            <svg class="w-4 h-4 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
          </div>
          <p class="font-heading text-base text-text mb-2">Esperar referencias</p>
          <p class="text-sm text-text-muted leading-relaxed">Funciona mientras la gente te recomienda. Pero no tienes control sobre cuándo llega el próximo cliente.</p>
        </div>
      </div>

      <p class="text-text font-medium text-center text-[0.95rem]">
        Por eso no construimos una descarga suelta o una llamada sin compromiso. Construimos una ruta de interés a inscripción a consulta.
      </p>
    </div>
  </section>


  {/* ── 3b. UNA RUTA DE CLIC A CLIENTE ── */}
  <section class="px-4 md:px-6 py-12 md:py-16">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-3 text-center">Una ruta de clic a cliente</h2>
      <p class="text-text-muted text-center mb-8 max-w-2xl mx-auto text-[0.95rem]">
        Sin campañas aisladas. Sin &lsquo;más visibilidad&rsquo; sin seguimiento. Un sistema donde contenido, productos, emails y anuncios trabajan juntos como un camino &mdash; desde el primer clic hasta el cliente que paga.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
        <div class="bg-white rounded-card p-5 border border-border">
          <p class="font-heading text-base text-text mb-2">Una entrada que puede pagarse sola</p>
          <p class="text-sm text-text-muted leading-relaxed">Una guía, mini-curso, quiz o masterclass puede hacer más pequeño el paso hacia tu oferta y recuperar parcialmente los costes publicitarios.</p>
        </div>
        <div class="bg-white rounded-card p-5 border border-border">
          <p class="font-heading text-base text-text mb-2">Leads que se califican solos</p>
          <p class="text-sm text-text-muted leading-relaxed">Las personas muestran a través de su elección, quiz, producto o inscripción dónde están y qué necesitan.</p>
        </div>
        <div class="bg-white rounded-card p-5 border border-border">
          <p class="font-heading text-base text-text mb-2">Seguimiento que construye confianza</p>
          <p class="text-sm text-text-muted leading-relaxed">Después del primer paso, los leads reciben una serie que genera confianza antes de que ofrezcas un programa o coaching.</p>
        </div>
        <div class="bg-white rounded-card p-5 border border-border">
          <p class="font-heading text-base text-text mb-2">Crecimiento predecible, sin picos y valles</p>
          <p class="text-sm text-text-muted leading-relaxed">Contenido, productos, emails y anuncios forman una ruta. Esa es la diferencia entre visibilidad y crecimiento.</p>
        </div>
      </div>

      {/* Compact flow */}
      <div class="bg-bg-alt rounded-card p-4 border border-border max-w-2xl mx-auto mb-8">
        <div class="flex flex-col sm:flex-row items-center justify-center gap-2 sm:gap-0 text-center">
          {[
            { label: 'Atención', sub: 'Contenido / IA / anuncios' },
            { label: 'Ruta de entrada', sub: 'Guía / scan / masterclass' },
            { label: 'Confianza', sub: 'Email / pruebas' },
            { label: 'Cliente', sub: 'Consulta / producto / programa' },
          ].map((step, i) => (
            <>
              <div class="flex-1 px-2 py-1">
                <p class="text-xs font-medium text-text">{step.label}</p>
                <p class="text-[0.6rem] text-text-muted">{step.sub}</p>
              </div>
              {i < 3 && <span class="hidden sm:block text-accent text-sm shrink-0">&rarr;</span>}
            </>
          ))}
        </div>
      </div>

      <div class="max-w-2xl mx-auto text-center">
        <p class="text-text text-sm leading-relaxed mb-2">
          <strong>doc.veri</strong> es el ejemplo de lo que sucede cuando un experto ya no solo tiene un sitio web, sino un sistema online que puede construir confianza y generar consultas.
        </p>
        <p class="text-text font-medium text-sm">
          Esa es la diferencia entre estar presente online y ser elegido online.
        </p>
      </div>
    </div>
  </section>


  {/* ── 4. CASOS / PRUEBAS ── */}
  <section id="cases" class="py-16 md:py-24 bg-primary">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-3xl md:text-4xl text-white mb-3">El mismo patrón. Diferentes fases.</h2>
      <p class="text-white/60 mb-4 max-w-3xl">
        Estos no son historias de éxito aisladas. Es el mismo patrón en diferentes fases: empaquetar expertise de forma más afilada, construir una primera ruta de entrada, dar seguimiento con confianza y luego dirigir hacia consulta, producto o cliente.
      </p>
      <p class="text-accent text-sm font-medium mb-12">
        Estos éxitos no vinieron de un truco. Vinieron de un sistema: posicionamiento, oferta, ruta de entrada, seguimiento, tráfico y optimización.
      </p>

      {/* Caso 1: Dr. Verena Mann */}
      <div class="bg-white/5 backdrop-blur border border-white/10 rounded-card p-5 md:p-8 mb-8">
        <div class="flex items-center gap-4 mb-5">
          <div class="w-12 h-12 rounded-full overflow-hidden ring-2 ring-accent/30 shrink-0">
            <Image src={verenaPhoto} alt="Dr. Verena Mann" widths={[48, 96]} sizes="48px" class="w-full h-full object-cover" loading="lazy" decoding="async" />
          </div>
          <div>
            <p class="text-white font-medium text-sm">Dr. Verena Mann</p>
            <a href="https://doc-veri.pages.dev" target="_blank" rel="noopener" class="text-accent/70 hover:text-accent text-xs transition-colors">doc-veri.pages.dev</a>
          </div>
          <div class="ml-auto">
            <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-medium bg-accent/20 text-accent rounded-full">De posición de experto a consultas</span>
          </div>
        </div>

        <div class="grid grid-cols-3 gap-3 mb-5">
          <div class="bg-white/5 rounded-lg p-3 text-center">
            <p class="font-heading text-xl text-accent">2 &rarr; 19</p>
            <p class="text-[10px] text-white/50">consultas/mes</p>
          </div>
          <div class="bg-white/5 rounded-lg p-3 text-center">
            <p class="font-heading text-xl text-accent">0 &rarr; 15</p>
            <p class="text-[10px] text-white/50">menciones en IA</p>
          </div>
          <div class="bg-white/5 rounded-lg p-3 text-center">
            <p class="font-heading text-xl text-accent">&plusmn;6 sem</p>
            <p class="text-[10px] text-white/50">en vivo</p>
          </div>
        </div>

        <p class="text-white/70 text-sm leading-relaxed mb-3">
          Fuerte expertise y una comunidad activa, pero apenas consultas de personas que aún no la conocían. Al empaquetar su expertise de forma más concreta alrededor de temas, problemas de clientes y pruebas, no solo se hizo más visible sino también más lógica para contactar.
        </p>

        <div class="grid grid-cols-2 gap-3 mt-5">
          <div class="lightbox-trigger cursor-zoom-in group">
            <div class="bg-black/40 border border-white/10 rounded-lg overflow-hidden">
              <Image src={proofVerenaAi} alt="ChatGPT menciona a Dr. Verena Mann como experta adecuada" width={1200} quality={85} class="w-full h-auto" loading="lazy" />
            </div>
          </div>
          <div class="lightbox-trigger cursor-zoom-in group">
            <div class="bg-black/40 border border-white/10 rounded-lg overflow-hidden">
              <Image src={proofVerenaChatgpt} alt="ChatGPT con enlace directo a Dr. Verena Mann" width={1200} quality={85} class="w-full h-auto" loading="lazy" />
            </div>
          </div>
        </div>
      </div>

      {/* Caso 2: Coach Josine */}
      <div class="bg-white/5 backdrop-blur border border-white/10 rounded-card p-5 md:p-8 mb-8">
        <div class="flex items-center gap-4 mb-5">
          <div>
            <p class="text-white font-medium text-sm">Josine &mdash; Coach Josine</p>
            <a href="https://www.coachjosine.nl" target="_blank" rel="noopener" class="text-accent/70 hover:text-accent text-xs transition-colors">coachjosine.nl</a>
          </div>
          <div class="ml-auto">
            <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-medium bg-accent/20 text-accent rounded-full">De guía a interés en programa</span>
          </div>
        </div>

        <div class="grid grid-cols-3 gap-3 mb-5">
          <div class="bg-white/5 rounded-lg p-3 text-center">
            <p class="font-heading text-xl text-accent">600+</p>
            <p class="text-[10px] text-white/50">guías vendidas</p>
          </div>
          <div class="bg-white/5 rounded-lg p-3 text-center">
            <p class="font-heading text-xl text-accent">80</p>
            <p class="text-[10px] text-white/50">inscripciones a masterclass</p>
          </div>
          <div class="bg-white/5 rounded-lg p-3 text-center">
            <p class="font-heading text-xl text-accent">18</p>
            <p class="text-[10px] text-white/50">querían el programa directamente</p>
          </div>
        </div>

        <p class="text-white/70 text-sm leading-relaxed mb-3">
          Tenía expertise, pero ninguna ruta de entrada digital. Hicimos su primera guía concreta, construimos la landing page y la conectamos a una ruta de masterclass. Las personas compraron la guía, asistieron a la masterclass y preguntaron por el programa.
        </p>

        <div class="grid grid-cols-2 gap-3 mt-5">
          <div class="lightbox-trigger cursor-zoom-in group">
            <div class="bg-black/40 border border-white/10 rounded-lg overflow-hidden">
              <Image src={josineProduct} alt="Guía alimentaria Coach Josine" width={600} quality={80} class="w-full h-auto" loading="lazy" />
            </div>
          </div>
          <div class="lightbox-trigger cursor-zoom-in group">
            <div class="bg-black/40 border border-white/10 rounded-lg overflow-hidden">
              <Image src={josineWhatsApp} alt="Mensaje de WhatsApp de Josine sobre resultados" width={600} quality={80} class="w-full h-auto" loading="lazy" />
            </div>
          </div>
        </div>
      </div>

      {/* Caso 3: Tessa / Youlife */}
      <div class="bg-white/5 backdrop-blur border border-white/10 rounded-card p-5 md:p-8 mb-8">
        <div class="flex items-center gap-4 mb-5">
          <div>
            <p class="text-white font-medium text-sm">Tessa &mdash; Youlife</p>
          </div>
