---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LogoMarquee from '../../components/LogoMarquee.astro';
import VideoTestimonialCarousel from '../../components/VideoTestimonialCarousel.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import SocialStorytellingGrid from '../../components/SocialStorytellingGrid.astro';
import { siteConfig } from '../../data/site';
import { generateOrganization, generateWebSite, generateFounderPerson, generateFAQPage } from '../../data/schema';
import { buildHreflangTrilingual } from '../../i18n/hreflang';
import { videoTestimonials } from '../../data/videoTestimonials';
import { getSocialPosts } from '../../data/socialPosts';

import heroPhoto from '../../assets/images/founder/joost-standing-relaxed.webp';
import founderPhoto from '../../assets/images/founder/joost-sitting-laptop-looking-working.webp';

const locale = 'es';
const hreflang = buildHreflangTrilingual('/', '/en/', '/es/');

/* Client logos — auto-import all from Client-logos folder */
const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/Client-logos/*.{webp,avif,png,jpg}', { eager: true });
const logos = Object.entries(logoFiles)
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/, '');
    const name = filename.replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim();
    return { src: mod.default, alt: name };
  });

/* FAQ — posicionamiento PYMES */
const homepageFaq = [
  {
    q: '¿Para qué tipo de empresa es NXG Media?',
    a: 'Trabajamos con PYMES prácticas: fontaneros, techadores, constructores, instaladores, empresas de limpieza y otros proveedores de servicios que quieren ser encontrados localmente. Sin rodeos — simplemente más clientes.',
  },
  {
    q: '¿Cuánto cuesta trabajar con NXG Media?',
    a: 'Nuestros paquetes empiezan desde €299 al mes (Encontrado). El paquete más popular es Crecimiento (€599/mes) que incluye anuncios y landing pages. <a href="/es/contacto/">Reserva una llamada gratis</a> y vemos juntos qué encaja contigo.',
  },
  {
    q: '¿Qué tan rápido veré resultados?',
    a: 'Con el paquete Encontrado, normalmente ves mejores posiciones en Google en 4-6 semanas. Con el paquete Crecimiento (incl. anuncios), los primeros leads suelen llegar en las primeras 2 semanas.',
  },
  {
    q: '¿Qué diferencia hay con una agencia de marketing normal?',
    a: 'Combinamos visibilidad en Google y buscadores con IA (ChatGPT, Gemini) con anuncios que generan clientes de forma directa. Nada de humo, sino un sistema que funciona. Y siempre tienes contacto personal — sin sistema de tickets.',
  },
  {
    q: '¿Qué es la visibilidad ante IA?',
    a: 'Cada vez más personas buscan a través de ChatGPT, Google AI y otras herramientas de IA. Nos aseguramos de que tu empresa también aparezca allí. <a href="' + siteConfig.external.scannerUrl + '" target="_blank" rel="noopener">Comprueba gratis cómo puntúas ahora</a>.',
  },
  {
    q: '¿Me ato a un contrato?',
    a: 'No. Nuestros paquetes son cancelables mensualmente. Creemos que te quedas porque funciona, no porque estés atado a un contrato.',
  },
];

const socialPosts = getSocialPosts(6, 'es');

const faqForSchema = homepageFaq.map((f) => ({ question: f.q, answer: f.a }));

const schemas = [
  generateOrganization(locale),
  generateWebSite(locale),
  generateFounderPerson(locale),
  generateFAQPage(faqForSchema, locale),
];
---

<BaseLayout
  title="NXG Media — Hazte visible. Que te elijan. Consigue más consultas."
  description="NXG Media ayuda a PYMES a ser más visibles en Google, ChatGPT y otros buscadores con IA — y lo combina con anuncios que generan clientes."
  locale={locale}
  hreflang={hreflang}
  schemas={schemas}
  hideNewsletter={true}
>

  {/* ══════════════════════════════════════════════════
      HERO — azul, grande, impactante
      ══════════════════════════════════════════════════ */}
  <section class="bg-primary text-white relative overflow-hidden">
    <div class="max-w-[1260px] mx-auto px-5 md:px-8 py-14 md:py-20 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">

        {/* Left: copy */}
        <div class="relative z-10">
          <p class="eyebrow light mb-5">NXG MEDIA · MARKETING ONLINE PARA PYMES</p>

          <h1 class="font-heading font-extrabold text-[2.75rem] leading-[0.98] md:text-[3.5rem] lg:text-[4rem] text-white mb-6 uppercase">
            Hazte visible.<br />
            Que te elijan.<br />
            <span class="marker">Consigue más consultas.</span>
          </h1>

          <p class="text-white/75 text-base leading-relaxed mb-8 max-w-lg">
            <strong class="text-white font-semibold">NXG Media</strong> ayuda a PYMES a ser más visibles
            en Google, ChatGPT y otros buscadores con IA
            — y lo combina con anuncios que generan clientes.
          </p>

          <div class="flex flex-wrap gap-3 mb-6">
            <a
              href="/es/contacto/"
              class="inline-flex items-center gap-2 px-6 py-[15px] text-[15px] font-extrabold text-text bg-accent hover:brightness-95 transition-all rounded-button"
            >
              Reserva una llamada gratis
              <span aria-hidden="true">↗</span>
            </a>
            <a
              href="#paquetes"
              class="inline-flex items-center gap-2 px-6 py-[15px] text-[15px] font-extrabold text-white border-2 border-white/30 hover:border-white/60 transition-colors rounded-button"
            >
              Ver nuestros paquetes
            </a>
          </div>
        </div>

        {/* Right: hero photo */}
        <div class="relative flex justify-center lg:justify-end">
          <div class="relative">
            <Image
              src={heroPhoto}
              alt="Joost van Putten — fundador NXG Media"
              width={520}
              height={640}
              class="relative z-10 max-h-[500px] md:max-h-[580px] w-auto object-contain drop-shadow-2xl"
              loading="eager"
            />

            {/* Sticky note: testimonial */}
            <div class="absolute top-4 right-0 md:-right-4 z-20 sticky-note text-base md:text-lg max-w-[200px] rotate-2">
              "Más consultas.<br />Eso sí es trabajar."
            </div>

            {/* Sticky note: PYMES badge */}
            <div class="absolute bottom-16 -right-2 md:right-0 z-20 sticky-note text-lg md:text-xl font-black uppercase -rotate-3">
              Las PYMES<br />lo hacen.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      LOGO MARQUEE — logos de clientes
      ══════════════════════════════════════════════════ */}
  <LogoMarquee
    logos={logos}
    label="MARKETING PARA ENTRE OTROS"
    speed={35}
  />


  {/* ══════════════════════════════════════════════════
      TRUST STRIP — 3 puntos clave
      ══════════════════════════════════════════════════ */}
  <section class="py-14 md:py-20 border-b border-border">
    <div class="max-w-[1260px] mx-auto px-5 md:px-8">
      <div class="grid md:grid-cols-3 gap-8 md:gap-10">

        <div class="flex items-start gap-4">
          <div class="shrink-0 w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center">
            <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
          </div>
          <div>
            <h3 class="font-heading font-extrabold text-lg mb-1">Google + IA</h3>
            <p class="text-text-muted text-sm leading-relaxed">Más visible en Google, ChatGPT y otros buscadores con IA.</p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="shrink-0 w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center">
            <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
          </div>
          <div>
            <h3 class="font-heading font-extrabold text-lg mb-1">Precio claro</h3>
            <p class="text-text-muted text-sm leading-relaxed">Paquetes transparentes. Sin sorpresas.</p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="shrink-0 w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center">
            <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
          </div>
          <div>
            <h3 class="font-heading font-extrabold text-lg mb-1">Sin rodeos</h3>
            <p class="text-text-muted text-sm leading-relaxed">Práctico, personal y orientado a resultados.</p>
          </div>
        </div>

      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      VIDEO TESTIMONIALS
      ══════════════════════════════════════════════════ */}
  <VideoTestimonialCarousel
    title="Lo que dicen nuestros clientes"
    subtitle="Emprendedores reales sobre su colaboración con NXG Media"
    eyebrow="LO QUE DICEN LOS CLIENTES"
    testimonials={videoTestimonials}
  />


  {/* ══════════════════════════════════════════════════
      AI SCANNER CTA — sección oscura
      ══════════════════════════════════════════════════ */}
  <section class="bg-bg-dark text-white py-[104px]">
    <div class="max-w-[1260px] mx-auto px-5 md:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <p class="eyebrow light mb-4">ANÁLISIS DE VISIBILIDAD IA GRATIS</p>
          <h2 class="font-heading font-extrabold text-4xl md:text-[3.5rem] lg:text-[4rem] leading-[0.98] text-white mb-6 uppercase">
            ¿Qué tan visible<br />
            <span class="text-accent">es tu empresa?</span>
          </h2>
        </div>
        <div>
          <p class="text-white/70 text-base leading-relaxed mb-8">
            Descubre en 30 segundos qué tan visible es tu empresa en Google y buscadores con IA
            como ChatGPT. Sin complicaciones, sin necesidad de cuenta.
          </p>
          <a
            href={siteConfig.external.scannerUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-[15px] text-[15px] font-extrabold text-text bg-accent hover:brightness-95 transition-all rounded-button"
          >
            Analiza tu visibilidad
            <span aria-hidden="true">↗</span>
          </a>
          <p class="mt-4 text-white/40 text-sm">Gratis · Sin cuenta · Resultado en 30 segundos</p>
        </div>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      PAQUETES — precios
      ══════════════════════════════════════════════════ */}
  <section id="paquetes" class="py-[104px]">
    <div class="max-w-[1260px] mx-auto px-5 md:px-8">

      <div class="mb-12 md:mb-16">
        <p class="eyebrow text-primary mb-4">CLARO ANTES DE CONTRATAR</p>
        <h2 class="font-heading font-extrabold text-4xl md:text-[3.5rem] lg:text-[4rem] leading-[0.98] text-text uppercase">
          Elige tu paquete.
        </h2>
        <p class="text-text-muted mt-4 max-w-2xl text-base leading-relaxed">
          Tanto si estás empezando como si quieres crecer más — tenemos un paquete que se adapta a tus ambiciones.
          Todos los paquetes están enfocados en más visibilidad, más tráfico y más clientes.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 lg:gap-8">

        {/* Encontrado — €299 */}
        <div class="relative border-2 border-border rounded-xl p-6 md:p-8 flex flex-col">
          <h3 class="font-heading font-extrabold text-2xl mb-1 uppercase">Encontrado</h3>
          <p class="text-text-muted text-sm mb-4">Empieza con visibilidad.</p>
          <p class="font-heading font-extrabold text-5xl md:text-6xl text-text mb-1">&euro;299</p>
          <p class="text-text-muted text-sm mb-6">al mes</p>

          <ul class="space-y-3 mb-8 flex-1">
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Optimización web</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Mejor posicionamiento local</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Perfil de Google Business</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Informe mensual</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Soporte personal</li>
          </ul>

          <a href="/es/contacto/" class="block w-full py-[15px] text-center text-[15px] font-extrabold text-text border-2 border-text rounded-button hover:bg-text hover:text-white transition-colors">
            Empieza con Encontrado ↗
          </a>
        </div>

        {/* Crecimiento — €599 (destacado) */}
        <div class="relative border-2 border-primary rounded-xl p-6 md:p-8 flex flex-col shadow-lg">
          <div class="absolute -top-4 left-1/2 -translate-x-1/2 z-10">
            <span class="sticky-note text-sm font-black uppercase px-4 py-1.5 rotate-[-2deg]">Más elegido</span>
          </div>

          <h3 class="font-heading font-extrabold text-2xl mb-1 uppercase">Crecimiento</h3>
          <p class="text-text-muted text-sm mb-4">Más tráfico. Más clientes.</p>
          <p class="font-heading font-extrabold text-5xl md:text-6xl text-text mb-1">&euro;599</p>
          <p class="text-text-muted text-sm mb-6">al mes</p>

          <ul class="space-y-3 mb-8 flex-1">
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Todo lo del paquete Encontrado</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Anuncios (Google &amp; Social)</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Landing pages que convierten</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Contenido mensual</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Estrategia y optimización</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Soporte personal</li>
          </ul>

          <a href="/es/contacto/" class="block w-full py-[15px] text-center text-[15px] font-extrabold text-text bg-accent hover:brightness-95 rounded-button transition-all">
            Empieza con Crecimiento ↗
          </a>
        </div>

        {/* Agenda llena — €999 */}
        <div class="relative border-2 border-border rounded-xl p-6 md:p-8 flex flex-col">
          <h3 class="font-heading font-extrabold text-2xl mb-1 uppercase">Agenda llena</h3>
          <p class="text-text-muted text-sm mb-4">Máximo crecimiento. Sin días vacíos.</p>
          <p class="font-heading font-extrabold text-5xl md:text-6xl text-text mb-1">&euro;999</p>
          <p class="text-text-muted text-sm mb-6">al mes</p>

          <ul class="space-y-3 mb-8 flex-1">
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Todo lo del paquete Crecimiento</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Campañas de anuncios avanzadas</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Múltiples landing pages</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Creación de contenido (foto, vídeo, texto)</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Optimización continua</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Asesoría estratégica</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Soporte prioritario</li>
          </ul>

          <a href="/es/contacto/" class="block w-full py-[15px] text-center text-[15px] font-extrabold text-text border-2 border-text rounded-button hover:bg-text hover:text-white transition-colors">
            Empieza con Agenda llena ↗
          </a>
        </div>

      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      SOBRE JOOST — fundador
      ══════════════════════════════════════════════════ */}
  <section class="bg-primary text-white py-[104px]">
    <div class="max-w-[1260px] mx-auto px-5 md:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div class="flex justify-center lg:justify-start">
          <div class="relative">
            <Image
              src={founderPhoto}
              alt="Joost van Putten — fundador NXG Media"
              width={480}
              height={480}
              class="w-full max-w-[400px] rounded-xl shadow-2xl"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-4 left-4 right-4 bg-black/60 backdrop-blur-sm rounded-lg px-4 py-3">
              <p class="text-white font-extrabold text-sm">Joost van Putten · Fundador NXG Media</p>
            </div>
          </div>
        </div>

        <div>
          <p class="eyebrow light mb-4">LA PERSONA DETRÁS DE NXG MEDIA</p>
          <h2 class="font-heading font-extrabold text-4xl md:text-[3.5rem] leading-[0.98] text-white mb-6 uppercase">
            Hola, soy Joost.<br />
            <span class="text-accent">Construyo contigo.</span>
          </h2>
          <p class="text-white/70 text-base leading-relaxed mb-6">
            Llevo más de 7 años ayudando a emprendedores con marketing online. Desde campañas hasta webs: quiero saber qué resultados da para el negocio que hay detrás.
          </p>
          <p class="text-white/70 text-base leading-relaxed mb-8">
            <strong class="text-white">Tú quieres clientes. Nosotros concretamos cómo vamos a conseguir tus próximas consultas.</strong>
          </p>
          <a
            href="/es/sobre-joost/"
            class="inline-flex items-center gap-2 px-6 py-[15px] text-[15px] font-extrabold text-text bg-accent hover:brightness-95 transition-all rounded-button"
          >
            Más sobre Joost
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      FAQ
      ══════════════════════════════════════════════════ */}
  <section class="py-[104px]">
    <div class="max-w-[1260px] mx-auto px-5 md:px-8">
      <div class="grid lg:grid-cols-[1fr_2fr] gap-12 lg:gap-20">
        <div>
          <p class="eyebrow text-primary mb-4">UNA RESPUESTA CLARA, SIN MÁS</p>
          <h2 class="font-heading font-extrabold text-4xl md:text-[3.5rem] lg:text-[4rem] leading-[0.98] text-text uppercase">
            Buenas<br />
            <span class="marker">preguntas.</span>
          </h2>
        </div>
        <div>
          <FAQAccordion
            items={homepageFaq}
            locale="es"
            pageType="homepage"
            pageSlug="/es/"
            minimal={true}
          />
        </div>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      INSTAGRAM GRID — personal
      ══════════════════════════════════════════════════ */}
  <SocialStorytellingGrid
    posts={socialPosts}
    instagramUrl={siteConfig.socials.instagram}
    locale="es"
  />


  {/* ══════════════════════════════════════════════════
      FOOTER CTA — banda amarilla
      ══════════════════════════════════════════════════ */}
