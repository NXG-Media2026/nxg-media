---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrustBar from '../../components/TrustBar.astro';
import ClientResults from '../../components/ClientResults.astro';
import VideoTestimonialCarousel from '../../components/VideoTestimonialCarousel.astro';
import LogoMarquee from '../../components/LogoMarquee.astro';
import SocialStorytellingGrid from '../../components/SocialStorytellingGrid.astro';
import FounderPreview from '../../components/FounderPreview.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import ScannerChooser from '../../components/ScannerChooser.astro';
import AIPlatformBar from '../../components/AIPlatformBar.astro';
import { siteConfig } from '../../data/site';
import { generateOrganization, generateWebSite, generateFounderPerson, generateFAQPage } from '../../data/schema';
import { buildHreflangTrilingual } from '../../i18n/hreflang';
import { getTestimonials } from '../../data/testimonials';
import { getSocialPosts } from '../../data/socialPosts';
import { videoTestimonials } from '../../data/videoTestimonials';

import heroPhoto from '../../assets/images/founder/joost-profielfoto-portrait.webp';
import founderPhoto from '../../assets/images/founder/joost-sitting-laptop-looking-working.webp';

const locale = 'es';
const hreflang = buildHreflangTrilingual('/', '/en/', '/es/');

const testimonials = getTestimonials({ locale: 'es' });
const socialPosts = getSocialPosts(6, 'es');

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logos/*.{webp,avif,png,jpg}', { eager: true });
const logos = Object.entries(logoFiles)
  .filter(([path]) => /logo/i.test(path.split('/').pop()!))
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/, '');
    const name = filename.replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim();
    return { src: mod.default, alt: name };
  });

const guides = (await getCollection('guides'))
  .filter((g) => g.data.locale === locale)
  .sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime())
  .slice(0, 4);

const trustItems = [
  { value: '50+', label: 'Coaches guiados' },
  { value: '€5M+', label: 'Inversión en ads gestionada' },
  { value: '5-7×', label: 'ROAS promedio' },
  { value: '7+', label: 'Años de experiencia' },
];

const homepageFaq = [
  {
    q: '¿Cuánto cuesta trabajar con NXG Media?',
    a: 'NXG Media ofrece micro-productos desde €6,99 para emprendedores que quieren empezar por su cuenta. El Coach Accelerator es un programa fijo con setup + optimización mensual. <a href="/es/contacto/">Contáctanos</a> para una conversación sin compromiso sobre la inversión adecuada para tu situación.',
  },
  {
    q: '¿Solo trabajáis con coaches?',
    a: 'NXG Media trabaja con dos áreas: Coach Accelerator (coaches, expertos, emprendedores del conocimiento) y Visibilidad ante IA (clínicas locales, PYMES). El enfoque es diferente, pero el principio es el mismo: construir un sistema, no campañas aisladas.',
  },
  {
    q: '¿Qué tan rápido veré resultados?',
    a: 'Los primeros resultados del Coach Accelerator suelen aparecer en 2-4 semanas (primeros leads, primeras ventas de producto). Un sistema completamente operativo toma 2-3 meses. Con Visibilidad ante IA, puedes re-escanear inmediatamente después de aplicar los kits y ver la diferencia.',
  },
  {
    q: '¿Qué hace diferente a NXG Media de una agencia de marketing normal?',
    a: 'Construimos sistemas de crecimiento completos — no campañas o sitios web aislados. Storytelling, productos, flujos de email, anuncios y visibilidad ante IA trabajan juntos como una sola máquina. Esa es la diferencia entre "más visibilidad" y "crecimiento predecible".',
  },
  {
    q: '¿Necesito tener una audiencia grande?',
    a: 'No. El sistema está diseñado para construir tu audiencia y tu flujo de leads al mismo tiempo. Con un pequeño presupuesto de anuncios (€5-10/día) atraes 20-50 seguidores cualificados al día.',
  },
];

const faqForSchema = homepageFaq.map((f) => ({ question: f.q, answer: f.a }));
---

<BaseLayout
  title={`${siteConfig.name} — ${siteConfig.tagline.es}`}
  description="Construye un sistema de crecimiento online alrededor de tu experiencia. Coach Accelerator para coaches y expertos. Visibilidad ante IA para clínicas y negocios locales."
  hreflang={hreflang}
  schemas={[generateOrganization(), generateWebSite(locale), generateFounderPerson(locale), generateFAQPage(faqForSchema)]}
  locale={locale}
>

  {/* ── Hero ── */}
  <section class="relative py-20 md:py-28 lg:py-36 overflow-hidden">
    <div class="absolute inset-0">
      <Image
        src={heroPhoto}
        alt="Joost van Putten construyendo sistemas de crecimiento online para coaches y expertos — NXG Media"
        widths={[800, 1200, 1600]}
        sizes="100vw"
        class="w-full h-full object-cover object-top"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-white/95 via-white/80 to-white/40"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 md:px-6">
      <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl text-text mb-6 leading-tight max-w-2xl">
        Construye un sistema de crecimiento online alrededor de tu experiencia
      </h1>
      <p class="text-lg md:text-xl text-text-muted leading-relaxed mb-10 max-w-xl">
        Para coaches y expertos que quieren convertir su conocimiento en leads predecibles, ventas de productos y consultas de coaching. Y para clínicas locales que quieren ser visibles en herramientas de IA.
      </p>
      <div class="flex flex-col sm:flex-row items-start gap-4">
        <button
          type="button"
          data-scanner-open
          class="inline-flex items-center px-8 py-4 text-base font-medium text-text-inverse bg-primary hover:bg-primary-dark transition-colors rounded-button shadow-lg cursor-pointer"
        >
          Haz el Análisis de Visibilidad IA
          <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </button>
        <a
          href="/es/coach-accelerator/"
          class="inline-flex items-center px-8 py-4 text-base font-medium text-primary border-2 border-primary hover:bg-primary/5 transition-colors rounded-button"
        >
          Descubre Coach Accelerator
        </a>
        <a
          href="/es/visibilidad-ia/"
          class="inline-flex items-center px-8 py-4 text-base font-medium text-primary border-2 border-primary hover:bg-primary/5 transition-colors rounded-button"
        >
          Descubre Visibilidad IA
        </a>
      </div>
    </div>
  </section>

  {/* ── Trust Bar ── */}
  <section class="bg-bg-alt border-y border-border">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <TrustBar items={trustItems} />
    </div>
  </section>

  {/* ── Recognition ── */}
  <section class="py-16 md:py-20 bg-primary">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-white mb-8">¿Te suena familiar?</h2>
      <div class="space-y-6">
        <p class="text-white/80 leading-relaxed">Ya tienes un buen programa de coaching, pero tu flujo de leads sube y baja. Un mes tres clientes nuevos, el siguiente cero — y no sabes por qué.</p>
        <p class="text-white/80 leading-relaxed">O tu clínica funciona bien, pero cuando alguien le pregunta a ChatGPT por un especialista en tu zona, no apareces.</p>
      </div>
    </div>
  </section>

  {/* ── AI Platform Bar ── */}
  <AIPlatformBar locale="es" />

  {/* ── What NXG Media builds ── */}
  <section class="py-12 md:py-16 bg-bg-alt">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-6">No campañas sueltas — una ruta de clic a cliente</h2>
      <p class="text-lg text-text-muted leading-relaxed mb-8 max-w-3xl">
        No te falta marketing. Te falta un sistema que trabaje para ti, incluso cuando estás ocupado con clientes.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="bg-white rounded-card p-6 border border-border">
          <h3 class="font-heading text-lg text-text mb-2">Un punto de entrada que se paga solo</h3>
          <p class="text-sm text-text-muted">Tu primer producto online — una guía, mini-curso o masterclass — cubre tu inversión en anuncios desde el día 1. Sin meses esperando retorno.</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <h3 class="font-heading text-lg text-text mb-2">Leads que se cualifican solos</h3>
          <p class="text-sm text-text-muted">Los visitantes siguen una ruta interactiva y te muestran lo que necesitan. Sabes exactamente quién está listo — sin llamadas en frío ni DMs interminables.</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <h3 class="font-heading text-lg text-text mb-2">Seguimiento que genera confianza</h3>
          <p class="text-sm text-text-muted">Después del primer registro, los leads reciben una serie personalizada. Cuando ven tu programa, ya no necesitas convencerlos.</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <h3 class="font-heading text-lg text-text mb-2">Una ruta, no campañas sueltas</h3>
          <p class="text-sm text-text-muted">Contenido, productos, emails y anuncios forman un solo camino: del primer clic al cliente que paga. Esa es la diferencia entre "más visibilidad" y crecimiento predecible.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── Two clusters ── */}
  <section class="py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-white rounded-card p-8 border border-border hover:border-accent/30 hover:shadow-lg transition-all">
          <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/10 text-accent rounded-full mb-4">expert-growth</span>
          <h2 class="font-heading text-xl text-text mb-3">Coach Accelerator</h2>
          <p class="text-text-muted text-sm leading-relaxed mb-6">
            Un sistema de crecimiento completo para coaches y expertos — desde un sitio web rápido y visible para IA hasta storytelling, micro-productos, flujos de email y anuncios. Todo funciona como una sola máquina que genera visibilidad, leads y clientes.
          </p>
          <a href="/es/coach-accelerator/" class="inline-flex items-center text-accent hover:text-accent-dark transition-colors font-medium text-sm">
            Conoce Coach Accelerator
            <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
        <div class="bg-white rounded-card p-8 border border-border hover:border-accent/30 hover:shadow-lg transition-all">
          <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-primary/10 text-primary rounded-full mb-4">ai-visibility</span>
          <h2 class="font-heading text-xl text-text mb-3">Visibilidad ante IA</h2>
          <p class="text-text-muted text-sm leading-relaxed mb-6">
            La visibilidad ante IA es un terreno nuevo. Por eso empezamos con un escaneo práctico: ¿dónde estás, qué falta y qué mejoras tienen sentido? Del escaneo a los kits, hasta la auditoría completa.
          </p>
          <a href="/es/visibilidad-ia/" class="inline-flex items-center text-accent hover:text-accent-dark transition-colors font-medium text-sm">
            Conoce Visibilidad ante IA
            <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ── Client Results (merged proof wall + testimonials) ── */}
  <ClientResults
    title="Resultados de clientes"
    featuredCases={[
      {
        testimonial: testimonials.find((t) => t.id === 'rolf-happywithyoga')!,
        period: 'Desde 2022',
        stats: [
          { value: '30.000+', label: 'leads de webinar' },
          { value: '1.700+', label: 'ventas de mini-curso' },
          { value: '2.000', label: 'miembros de pago' },
        ],
        caseHref: '/es/casos/happy-with-yoga/',
      },
      {
        testimonial: testimonials.find((t) => t.id === 'tessa-youlife')!,
        period: 'Desde feb 2025',
        stats: [
          { value: '~€10k/mes', label: 'productos online' },
          { value: '6', label: 'productos lanzados' },
          { value: '~10/mes', label: 'clientes de coaching' },
        ],
        caseHref: '/es/casos/tessa-youlife/',
      },
      {
        testimonial: testimonials.find((t) => t.id === 'josine-coachjosine')!,
        period: 'Desde oct 2025',
        stats: [
          { value: '600×', label: 'guía vendida' },
          { value: '80', label: 'inscripciones masterclass' },
        ],
        caseHref: '/es/casos/coach-josine/',
      },
    ]}
    smallResults={[
      {
        name: 'Manon van Bakel',
        period: 'Primer mes',
        stats: [
          { value: '120', label: 'inscripciones en 2 semanas' },
          { value: '~10%', label: 'conversión a programas' },
        ],
      },
      {
        name: 'Kim Bongers',
        period: '2 meses',
        stats: [
          { value: '90', label: 'inscripciones masterclass' },
          { value: '350×', label: 'guía vendida' },
          { value: '8%', label: 'conversión' },
        ],
      },
      {
        name: 'MCM Research',
        logo: 'mcm-research-logo.webp',
        period: 'Cliente desde 2022',
        stats: [
          { value: '2.500+', label: 'leads en Países Bajos' },
          { value: '500', label: 'candidatos NL' },
          { value: '1.500+', label: 'leads en Bélgica' },
          { value: '250', label: 'candidatos BE' },
        ],
      },
    ]}
    otherTestimonials={testimonials.filter((t) => ['claire-ikrouwvanje', 'andrew-coreprogression'].includes(t.id))}
    caseLabel="Leer el caso"
    allCasesHref="/es/casos/"
    allCasesLabel="Ver todos los casos"
    locale="es"
  />

  {/* ── Client logos marquee ── */}
  {logos.length > 0 && (
    <LogoMarquee
      logos={logos}
      label="Confianza de coaches, expertos y empresas"
      speed={35}
    />
  )}

  {/* ── Video Testimonials Carousel ── */}
  <VideoTestimonialCarousel
    title="Lo que dicen los clientes sobre trabajar con Joost"
    subtitle="Experiencias reales de emprendedores que colaboran exitosamente con Joost"
    testimonials={videoTestimonials}
  />

  {/* ── Blog / Guides preview ── */}
  {guides.length > 0 && (
    <section class="py-16 md:py-20">
      <div class="max-w-4xl mx-auto px-4 md:px-6">
        <h2 class="font-heading text-2xl md:text-3xl text-text mb-10 text-center">Artículos recientes</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {guides.map((g) => (
            <a href={`/es/guias/${g.data.pageSlug}/`} class="group block bg-white border border-border rounded-card p-6 hover:border-accent/30 hover:shadow-lg transition-all">
              {g.data.cluster && (
                <span class="text-xs font-medium text-accent uppercase tracking-wider mb-2 block">{g.data.cluster}</span>
              )}
              <h3 class="font-heading text-lg text-text group-hover:text-accent transition-colors mb-2">{g.data.title}</h3>
              <p class="text-sm text-text-muted">{g.data.contentSchema.primaryAnswer.slice(0, 120)}...</p>
            </a>
          ))}
        </div>
        <div class="text-center mt-8">
          <a href="/es/guias/" class="inline-flex items-center text-accent hover:text-accent-dark transition-colors font-medium">
            Ver todas las guías
            <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </div>
    </section>
  )}

  {/* ── Instagram / Social Grid ── */}
  <div class="bg-bg-alt">
    <div class="max-w-5xl mx-auto px-4 md:px-6 pt-16 md:pt-20">
      <h2 class="font-heading text-2xl md:text-3xl text-text text-center mb-2">Sigue el proceso</h2>
      <p class="text-text-muted text-center">Detrás de cámaras, resultados y tips de sistemas de crecimiento en Instagram.</p>
    </div>
    <SocialStorytellingGrid posts={socialPosts} instagramUrl={siteConfig.socials.instagram} locale="es" />
  </div>

  {/* ── Founder Preview (EEAT) ── */}
  <FounderPreview
    name={siteConfig.founder.name}
    role={siteConfig.founder.role}
    bio={siteConfig.founder.bio[locale]}
    image={founderPhoto}
    credentials={siteConfig.founder.credentials.map((c) => ({ name: c.name, issuer: c.issuer }))}
    knowsAbout={siteConfig.founder.knowsAbout[locale]}
    aboutHref="/es/sobre-joost/"
    aboutLabel="Más sobre Joost"
    locale="es"
  />

  {/* ── Homepage FAQ ── */}
  <div class="bg-bg-alt">
    <FAQAccordion
      title="Preguntas frecuentes"
      items={homepageFaq}
      locale="es"
      pageType="homepage"
      pageSlug="/es/"
    />
  </div>

  <ScannerChooser locale="es" />

</BaseLayout>
