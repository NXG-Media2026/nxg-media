---
import { Image } from 'astro:assets';
import NxgSearchMethod from '../../components/NxgSearchMethod.astro';
import { siteConfig } from '../../data/site';
import '../../styles/lander.css';
import landerScriptUrl from '../../scripts/lander.js?url';
import type { ImageMetadata } from 'astro';
import CookieConsent from '../../components/CookieConsent.astro';
import { getTrackingScript, getMetaPixelScript, getCapiHelperScript } from '../../lib/analytics';
const clientLogoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/Client-logos/*.{webp,avif,png,jpg}', { eager: true });
const clientLogos = Object.entries(clientLogoFiles).map(([file, mod]) => ({ src: mod.default, alt: file.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/i, '').replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim() }));
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>NXG AI Search — Más solicitudes. Garantizado.</title>
<meta name="description" content="Quieres clientes. Organizamos todo para conseguir las solicitudes que necesitas. Un sistema de crecimiento, un objetivo concreto de solicitudes y garantía de resultados.">
<link rel="canonical" href="https://nxg-media.com/es/nxg-growth">
<link rel="alternate" hreflang="nl" href="https://nxg-media.com/landermkb" />
<link rel="alternate" hreflang="en" href="https://nxg-media.com/en/nxg-growth" />
<link rel="alternate" hreflang="es" href="https://nxg-media.com/es/nxg-growth" />
<link rel="alternate" hreflang="x-default" href="https://nxg-media.com/landermkb" />
<meta name="theme-color" content="#0756ef">
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%230756ef'/%3E%3Cpath d='M15 48V16h8l18 20V16h8v32h-8L23 28v20z' fill='%23fff000'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800;900&family=DM+Sans:wght@400;500;600;650;700;800&display=swap" rel="stylesheet">
<style is:global>.photo{background-image:url('/lander-assets/ondernemer-werkplaats-nxg-growth.webp');background-position:76% center}@media(max-width:760px){.photo{background-position:75% 35%}}</style>
<style is:global>
.hero h1 .hero-opening{display:block;font-size:.68em;margin-bottom:12px}
.hero h1 .hero-generation{display:inline-block;font-size:1.08em;line-height:1.03}
.hero-ticket .ticket-minimum{display:block;font:800 18px/1.2 var(--body);letter-spacing:1px;margin-bottom:4px}
.hero-ticket .ticket-start{display:block;font:700 14px/1.4 var(--body);margin:0 0 16px}
.session-host{display:flex;align-items:center;gap:14px;margin:24px 0}
.session-host img{width:64px;height:64px;border-radius:50%;object-fit:cover;object-position:50% 30%;border:2px solid var(--yellow)}
.session-host p{margin:0;font-size:15px}.session-host span{display:block;font-size:13px}
@media(max-width:760px){.hero-ticket .ticket-start{font-size:12px}.hero-ticket .ticket-minimum{font-size:14px}}
</style></head>
<body>
<a class="skip" href="#main">Ir al contenido</a>
<header><div class="nav wrap"><a class="brand" href="/es" aria-label="NXG-media, ir a la página de inicio">NXG<span>-media</span><small>AI Search Agency</small></a><nav aria-label="Navegación principal"><a href="#cases">Resultados</a><a href="#investering">La garantía</a><a class="lander-scan-link" href={siteConfig.external.scannerUrl}>Escáner IA gratis ↗</a></nav><div class="lander-languages"><a href="/landermkb" lang="nl">NL</a><a href="/en/nxg-growth" lang="en">EN</a><span aria-current="true">ES</span></div><a class="button yellow compact" href="#groeisessie">Comprueba si tu negocio cumple los requisitos <span aria-hidden="true">↗</span></a></div><a class="lander-mobile-scan" href={siteConfig.external.scannerUrl}>Escáner IA gratis <span>Descubre si la IA menciona tu negocio ↗</span></a></header>
<main id="main">
<section class="hero"><div class="wrap hero-grid"><div class="hero-copy"><p class="eyebrow light">EL SISTEMA NXG AI SEARCH</p><h1><span class="hero-opening">MÁS SOLICITUDES A TRAVÉS DE</span><span class="marker hero-generation">LA NUEVA<br>GENERACIÓN DE BÚSQUEDA.</span></h1><div class="growth-formula" aria-label="Visibilidad en IA más AI Search Ads más una web que convierte es tu sistema de crecimiento AI Search"><div class="formula-inputs"><span>Visibilidad en IA</span><b aria-hidden="true">+</b><span>AI Search Ads</span><b aria-hidden="true">+</b><span>Una web que convierte</span></div><div class="formula-answer"><b aria-hidden="true">=</b><strong>El sistema NXG<br>AI Search.</strong></div></div><p class="hero-body">Tus clientes potenciales buscan lo que ofreces. Nosotros hacemos lo necesario para que tu negocio aparezca y convertir ese interés en solicitudes. Orgánico, de pago y con una web que convence.</p><a class="button yellow" href="#groeisessie">Comprueba si tu negocio cumple los requisitos <span aria-hidden="true">↗</span></a><a class="hero-news" href="#chatgpt-ads"><span class="news-logo"><img src="/lander-assets/platforms/openai.svg" alt="ChatGPT" width="32" height="32"></span><span><b>NUEVO EN ESPAÑA</b><strong>Publicidad en ChatGPT.</strong><small>Parte de nuestro sistema, si encaja contigo.</small></span><span class="news-arrow" aria-hidden="true">↗</span></a></div><div class="hero-visual"><div class="portrait-stage" aria-label="Profesionales para quienes el sistema NXG AI Search funciona"><div class="portrait-frame is-active" aria-hidden="false"><img src="/lander-assets/portraits/vakman-omgeving.webp" alt="Profesional en su taller" width="1024" height="1536" fetchpriority="high" loading="eager" decoding="async"></div><div class="portrait-frame" aria-hidden="true"><img src="/lander-assets/portraits/tandarts-omgeving.webp" alt="Dentista en su consulta" width="1024" height="1536" loading="lazy" decoding="async"></div><div class="portrait-frame" aria-hidden="true"><img src="/lander-assets/portraits/laserspecialist-omgeving.webp" alt="Especialista en láser en su clínica" width="1024" height="1536" loading="lazy" decoding="async"></div><div class="portrait-frame" aria-hidden="true"><img src="/lander-assets/portraits/chiropractor-omgeving.webp" alt="Quiropráctico en su consulta" width="1024" height="1536" loading="lazy" decoding="async"></div><div class="portrait-frame" aria-hidden="true"><img src="/lander-assets/portraits/makelaar-omgeving.webp" alt="Agente inmobiliario en la entrada de una vivienda" width="1024" height="1536" loading="lazy" decoding="async"></div></div><div class="hero-ticket"><p><span class="ticket-minimum">MÍNIMO</span><b>15</b><br>solicitudes<br>cualificadas.</p><span class="ticket-start">En 90 días desde el lanzamiento.</span><div class="ticket-refund">O te devolvemos<br><strong>tu dinero.</strong></div></div><div class="portrait-controls"><button type="button" class="portrait-prev" aria-label="Retrato anterior">‹</button><button type="button" class="portrait-pause" aria-label="Pausar retratos" aria-pressed="false">Ⅱ</button><button type="button" class="portrait-next" aria-label="Siguiente retrato">›</button></div></div></div></section>
<section class="client-proof" aria-label="Empresas para las que hemos realizado trabajo de marketing"><div class="wrap proof-heading"><p>MARKETING PARA, ENTRE OTROS</p><button class="logos-toggle" type="button" aria-pressed="false">Pausar logos</button></div><div class="client-window"><div class="client-track">{[0, 1].map(copy => <div class="client-group" aria-hidden={copy === 1 ? 'true' : undefined}>{clientLogos.map(logo => <div class="client-logo"><Image src={logo.src} alt={copy === 0 ? logo.alt : ''} height={48} loading="lazy" decoding="async" /></div>)}</div>)}</div></div></section>
<div class="promise-strip"><div class="wrap strip-grid"><div><span class="check">✓</span><p><strong>Un objetivo definido</strong><span>Acordado de antemano. Medible después.</span></p></div><div><span class="check">✓</span><p><strong>Te devolvemos tu dinero si fallamos</strong><span>¿Sin resultado? Sin riesgo.</span></p></div><div><span class="check">✓</span><p><strong>Tu fundamento es tuyo</strong><span>Lo que construimos es tuyo. Siempre.</span></p></div></div>
<section class="section results" id="cases"><div class="wrap"><p class="eyebrow">AI SEARCH EN LA PRÁCTICA</p><h2>DE SER ENCONTRADO.<br><span class="blue">A SOLICITUDES REALES.</span></h2><p class="results-intro">Dos clientes para quienes trabajamos los cimientos online y la visibilidad. Esto es lo que consiguieron.</p><div class="case-grid"><article class="result-card"><div class="case-person"><img src="/lander-assets/proof/james.webp" alt="Dr. James Mitchell" width="80" height="80" loading="lazy"><div><strong>Costa Blanca Movement Centre</strong><a href="https://www.costablancamovement.com/" target="_blank" rel="noopener noreferrer">costablancamovement.com ↗</a></div></div><h3>DE CERO A<br>12–15 PACIENTES AL MES.</h3><p>Sin web, sin historial en Google y sin backlinks. En 14 días los nuevos cimientos estaban en la página 1 de Google. A los 2 meses, recibía 12–15 pacientes al mes por vía online.</p><div class="case-metrics"><div><strong>12–15</strong><span>pacientes al mes por vía online</span></div><div><strong>800+</strong><span>visitantes orgánicos al mes</span></div></div><div class="case-proof"><a href="/lander-assets/proof/google-proof.webp" target="_blank" rel="noopener"><img src="/lander-assets/proof/google-proof.webp" alt="Resultado en Google del caso Costa Blanca Movement Centre" width="600" height="360" loading="lazy"><span>Página 1 de Google en 14 días · ver prueba ↗</span></a><a href="/lander-assets/proof/chatgpt-proof.webp" target="_blank" rel="noopener"><img src="/lander-assets/proof/chatgpt-proof.webp" alt="ChatGPT menciona Costa Blanca Movement Centre como opción local" width="600" height="360" loading="lazy"><span>Mencionado por ChatGPT · ver prueba ↗</span></a></div></article><article class="result-card"><div class="case-person"><img src="/lander-assets/proof/verena.webp" alt="Dr. Verena Mann" width="80" height="80" loading="lazy"><div><strong>Dr. Verena Mann</strong><a href="https://doc-veri.pages.dev/" target="_blank" rel="noopener noreferrer">doc-veri.pages.dev ↗</a></div></div><h3>DE 2 A 19<br>SOLICITUDES AL MES.</h3><p>Tenía experiencia y comunidad, pero apenas recibía solicitudes a través de la web. Al presentar mejor su expertise, pruebas y ruta de contacto, creció hasta 19 solicitudes al mes y fue mencionada por ChatGPT.</p><div class="case-metrics"><div><strong>2 → 19</strong><span>solicitudes al mes</span></div><div><strong>0 → 15</strong><span>menciones en IA</span></div></div><div class="case-proof single"><a href="/lander-assets/proof/verena-proof.webp" target="_blank" rel="noopener"><img src="/lander-assets/proof/verena-proof.webp" alt="Mención en ChatGPT de Dr. Verena Mann de su caso" width="1200" height="360" loading="lazy"><span>Mencionada como experta por ChatGPT · ver prueba ↗</span></a></div></article></div><div class="results-bottom"><p>Aplicamos este enfoque a tu objetivo:<br><strong>Mínimo 15 solicitudes cualificadas en 90 días desde el lanzamiento con nuestro sistema AI Search.</strong></p><a class="button yellow" href="#groeisessie">Comprueba si tu negocio cumple los requisitos <span aria-hidden="true">↗</span></a></div></div></section>



<NxgSearchMethod ctaHref="#groeisessie" locale="es" />
<section class="section guarantee" id="investering"><div class="wrap guarantee-wrap"><div class="guarantee-content"><p class="eyebrow">LA GARANTÍA</p><h2>MÍNIMO 15 SOLICITUDES<br>EN 90 DÍAS.<br><span class="blue">O TE DEVOLVEMOS TU DINERO.</span></h2><p>Un sistema que combina visibilidad en IA, Google Search y, cuando es relevante, ChatGPT Ads para generar solicitudes. El objetivo es simple: mínimo 15 solicitudes cualificadas en 90 días desde que tu nuevo fundamento esté activo.</p><ul class="guarantee-points"><li>¿No alcanzamos el objetivo acordado? Te devolvemos tu dinero.</li><li>Conservas el fundamento que hemos construido para ti.</li><li>Hablamos del enfoque, el objetivo y las condiciones en persona.</li></ul><a class="button yellow" href="#groeisessie">Comprueba si tu negocio cumple los requisitos <span aria-hidden="true">↗</span></a></div></div></section>

<section class="section founder"><div class="wrap founder-grid"><div class="founder-photo"><img src="/lander-assets/proof/joost.webp" alt="Joost van Putten, fundador de NXG-media, trabajando" width="850" height="1000" loading="lazy"><span>Joost van Putten · Fundador de NXG-media</span></div><div><p class="eyebrow">LA PERSONA DETRÁS DE NXG-MEDIA</p><h2>HOLA, SOY JOOST.<br><span class="blue">CONSTRUYO CONTIGO.</span></h2><p>Llevo más de 7 años ayudando a profesionales con marketing online. Desde campañas hasta webs: quiero saber qué aporta al negocio que hay detrás.</p><p class="strong">Tú quieres clientes. Nosotros concretamos cómo trabajar en tus próximas solicitudes.</p><a class="text-link" href="#groeisessie">Comprueba si tu negocio cumple los requisitos <span aria-hidden="true">↗</span></a></div></div></section>
<section class="session section"><div class="wrap session-grid"><div><p class="eyebrow light">AHORA TU NEGOCIO.</p><h2>¿QUÉ PUEDE EL SISTEMA<br><span class="yellow-text">NXG AI SEARCH</span><br>HACER POR TI?</h2><p>En 35 minutos sabrás qué enfoque, qué presupuesto y qué objetivo de solicitudes encaja con tu negocio. Juntos analizamos si la garantía de mínimo 15 solicitudes cualificadas son viables para ti.</p><div class="session-host"><img src="/lander-assets/proof/joost.webp" alt="Joost van Putten" width="64" height="64" loading="lazy"><p><strong>Hablarás con Joost.</strong><span>Fundador de NXG-media</span></p></div><div class="session-duration">35 MINUTOS <span>·</span> PERSONAL <span>·</span> SIN COMPROMISO</div><ul class="session-topics"><li>Dónde buscan tus clientes.</li><li>Tus oportunidades con el sistema NXG AI Search.</li><li>El objetivo de solicitudes, presupuesto y la garantía.</li></ul><p>Decides después de la sesión si quieres empezar.</p></div><div class="inline-agenda" id="groeisessie"><h3>ELIGE TU MOMENTO.</h3><iframe class="calendly-inline-frame" src="https://calendly.com/nxgmedia/gratis-15-minuten-strategiegesprek?embed_domain=nxg-media.com&amp;embed_type=Inline&amp;hide_event_type_details=1&amp;hide_gdpr_banner=1" title="Reserva tu sesión gratuita de estrategia AI Search de 35 minutos con NXG-media" loading="eager"></iframe><a class="agenda-fallback" href="https://calendly.com/nxgmedia/gratis-15-minuten-strategiegesprek" target="_blank" rel="noopener noreferrer">¿No ves la agenda? Abre Calendly ↗</a></div></div></section>
<section class="section faq"><div class="wrap faq-grid"><div><p class="eyebrow">UNA RESPUESTA CLARA, SIN MÁS</p><h2>BUENAS<br><span class="blue">PREGUNTAS.</span></h2></div><div class="questions"><details><summary>¿El fundamento sigue siendo mío aunque no alcancéis el objetivo?</summary><p>Sí. La web, el contenido y las optimizaciones que construimos para ti son tuyos. Incluso si no alcanzamos el objetivo de solicitudes acordado. No tienes que devolver la base construida.</p></details><details><summary>¿Podéis gestionar también publicidad en ChatGPT para mí?</summary><p>Sí, si encaja con tu negocio. ChatGPT Ads ya está disponible en autoservicio para anunciantes en España. Evaluamos las posibilidades para tus servicios y público objetivo y hablamos del presupuesto de prueba en persona.</p></details><details><summary>¿Qué es una solicitud cualificada?</summary><p>Una solicitud única de alguien del público objetivo acordado, con datos de contacto válidos e interés demostrable en tu servicio. Definimos de antemano qué cuenta. Spam, duplicados y contactos irrelevantes no cuentan.</p></details><details id="garantie-vraag"><summary>¿Cómo funciona exactamente la garantía?</summary><p>Acordamos de antemano un objetivo concreto de solicitudes, público objetivo y plazo. ¿No lo alcanzamos? Te devolvemos tu dinero y conservas el fundamento que hemos construido para ti. Las condiciones exactas las hablamos en persona.</p></details><details><summary>¿Tengo que contratar publicidad siempre?</summary><p>No. Determinamos qué medios son necesarios para tu objetivo. Si se necesitan campañas de pago, acordamos el presupuesto de antemano. No generamos costes extra sin tu aprobación.</p></details><details><summary>¿Qué pasa después de los primeros 90 días?</summary><p>Evaluamos los resultados y hablamos sobre la continuación. El fundamento sigue siendo tuyo. La duración, cancelación y traspaso se definen antes de empezar.</p></details></div></div></section>
<section class="last-call"><div class="wrap"><h2>MÍNIMO 15 SOLICITUDES EN 90 DÍAS.<br><span>CON EL SISTEMA NXG AI SEARCH.</span></h2><a class="button black" href="#groeisessie">Comprueba si tu negocio cumple los requisitos <span aria-hidden="true">↗</span></a></div></section>
</main><footer><div class="wrap footer-main"><a class="brand" href="/">NXG<span>-media</span><small>AI Search Agency</small></a><p>Creado para profesionales.<br>Enfocado en solicitudes.</p><a href="#investering">Descubre cómo funciona la garantía ↗</a></div><div class="wrap footer-bottom"><span>© <span id="year">2026</span> NXG-media</span><span>Tú emprendes. Nosotros crecemos contigo.</span><span><a href="/es/privacidad">Privacidad</a> · <a href="/es/terminos">Condiciones</a></span></div></footer>
<div class="mobile-cta"><a class="button yellow" href="#groeisessie">Comprueba si tu negocio cumple los requisitos <span aria-hidden="true">↗</span></a></div>

<CookieConsent locale="es" />
<style>
.lander-scan-link{color:#0756ef;background:#edf3ff;padding:10px 12px;border-radius:5px;font-weight:800}.lander-mobile-scan{display:none}@media(max-width:760px){.lander-mobile-scan{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:11px 20px;background:#edf3ff;color:#0756ef;font-size:12px;font-weight:800;border-top:1px solid #d5e3ff}.lander-mobile-scan span{font-size:10px;font-weight:600}}
.lander-languages{display:flex;align-items:center;gap:4px;font-size:13px;font-weight:700}.lander-languages a{color:var(--text-muted,#6b7280);text-decoration:none;padding:4px 6px;border-radius:4px}.lander-languages a:hover{color:var(--blue,#0756ef);background:#edf3ff}.lander-languages span[aria-current]{color:var(--blue,#0756ef);padding:4px 6px;border-radius:4px;background:#edf3ff}
</style>
<script is:inline set:html={getTrackingScript()} />
<script is:inline set:html={getCapiHelperScript()} />
<Fragment set:html={getMetaPixelScript(siteConfig.analytics.metaPixelId)} />
<script is:inline>
window.addEventListener('message',function(e){
  if(e.origin.indexOf('calendly')===-1)return;
  try{var d=typeof e.data==='string'?JSON.parse(e.data):e.data}catch(x){return}
  if(!d||d.event!=='calendly.event_scheduled')return;
  var eid=typeof nxgCapiEventId==='function'?nxgCapiEventId():'';
  if(typeof fbq==='function'){fbq('track','Schedule',{content_name:'nxg-growth-es',content_category:'mkb-lander'},{eventID:eid})}
  if(eid&&typeof nxgCapiSend==='function'){nxgCapiSend('Schedule',eid,{content_name:'nxg-growth-es',content_category:'mkb-lander'})}
  if(typeof trackEvent==='function'){trackEvent('ai_vindbaarheid_call_booked',{page_type:'page',page_slug:'es/nxg-growth',locale:'es',provider:'calendly'})}
});
</script>
<script is:inline src={landerScriptUrl}></script>
</body></html>
