---
/**
 * Suscripción Web — /es/suscripcion-web/
 * Landing page para negocios locales en España.
 * noindex — ads lander. No links to other offer pages.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import LogoMarquee from '../../components/LogoMarquee.astro';
import { siteConfig } from '../../data/site';
import { generateFAQPage, generateBreadcrumbs } from '../../data/schema';
import { buildHreflangTrilingual } from '../../i18n/hreflang';

import heroPhoto from '../../assets/images/founder/joost-standing-workinglaptop.webp';
import keystaticDashboard from '../../assets/images/keystatic1.png';
import keystaticHomepage from '../../assets/images/keystatic_edit_homepage.png';
import keystaticBlog from '../../assets/images/keystatic_add_blog.png';

const cmsScreenshots = [
  { src: keystaticDashboard, alt: 'Panel de administración con vista general de todas las páginas, blogs, servicios y productos', caption: 'Todo en un solo lugar' },
  { src: keystaticHomepage, alt: 'Editar textos de la página principal mediante campos de entrada sencillos', caption: 'Editar textos — sin código' },
  { src: keystaticBlog, alt: 'Escribir un artículo de blog con barra de formato y campos SEO', caption: 'Publicar artículos tú mismo' },
];
import proofGoogle from '../../assets/images/cases/proof-google-torrevieja.png';
import proofChatgpt from '../../assets/images/cases/proof-chatgpt-local.png';
import proofVerenaAi from '../../assets/images/cases/doc_veri_ai_answer_cropped.PNG';
import proofVerenaChatgpt from '../../assets/images/cases/doc-veri-chatgptproof.jpeg';
import verenaPhoto from '../../assets/images/cases/verena-mann-linkedin.webp';
import jamesPhoto from '../../assets/images/cases/james-mitchell-portrait.png';

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logos/*.{webp,avif,png,jpg}', { eager: true });
const logos = Object.entries(logoFiles)
  .filter(([path]) => /logo/i.test(path.split('/').pop()!))
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/, '');
    const name = filename.replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim();
    return { src: mod.default, alt: name };
  });

const locale = 'es';
const title = 'Web preparada para Google y ChatGPT — desde 79€/mes | NXG Media';
const description = 'Convertimos tu web actual en una web más clara, rápida y preparada para Google, ChatGPT y nuevos clientes. Desde 79€/mes. Primeras 10 plazas este mes.';

const hreflang = buildHreflangTrilingual('/website-abonnement', '/en/website-subscription', '/es/suscripcion-web');

const breadcrumbs = [
  { label: 'Inicio', href: '/es/' },
  { label: 'Suscripción Web' },
];

const faqItems = [
  {
    q: '¿Hay que rehacer toda mi web?',
    a: "El punto de partida es conservar lo que funciona: tu oferta, marca, textos, fotos y reseñas. Lo reconstruimos sobre una base más rápida, clara y preparada para Google y ChatGPT.",
  },
  {
    q: '¿Por qué puede hacerse por 79€ al mes?',
    a: "Porque no construimos un proyecto a medida desde cero. Convertimos tu web actual en una base más clara y mejor estructurada. Eso nos permite trabajar más rápido y mantener los costes bajos.",
  },
  {
    q: '¿Hay permanencia?',
    a: "El plan más económico suele ir ligado a una colaboración más larga, porque incluye web, hosting, mantenimiento y revisión mensual. Antes de pagar nada, recibes una propuesta clara con las condiciones.",
  },
  {
    q: '¿Por qué solo 10 plazas?',
    a: "Porque cada proyecto recibe atención personal. No es una plantilla genérica — revisamos tu web, tu sector y tu zona para construir algo que funcione. Por eso aceptamos un máximo de 10 negocios al mes.",
  },
  {
    q: '¿Qué pasa si quiero páginas extra o contenido SEO?',
    a: "Las ampliaciones pueden venir después. Páginas de servicios adicionales, blog, contenido local y optimización avanzada se pueden contratar aparte. Primero nos aseguramos de que la base esté bien.",
  },
  {
    q: '¿Voy a perder mi contenido antiguo?',
    a: "Lo que funciona, lo conservamos. Lo que no está claro, es lento o no convierte, lo mejoramos. Tu marca, fotos y reseñas se aprovechan siempre que sea posible.",
  },
  {
    q: '¿Es para cualquier empresa?',
    a: "Principalmente para negocios locales y empresas de servicios: clínicas, fisioterapeutas, abogados, gestorías, centros de estética, academias, inmobiliarias y similares. Tiendas online y webs complejas a medida suelen quedar fuera de esta oferta.",
  },
];

const schemas = [
  generateFAQPage(faqItems.map(i => ({ question: i.q, answer: i.a }))),
  generateBreadcrumbs(breadcrumbs),
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={`${siteConfig.url}/es/suscripcion-web`}
  noindex={true}
  schemas={schemas}
  locale={locale}
  hreflang={hreflang}
>

  {/* ══════════════════════════════════════════════════
      1 · HERO
      ══════════════════════════════════════════════════ */}
  <section class="relative overflow-hidden bg-primary">
    <div class="absolute inset-0 hidden md:block">
      <Image
        src={heroPhoto}
        alt=""
        width={800}
        class="absolute right-0 top-0 h-full w-auto object-cover object-top opacity-[0.15]"
        loading="eager"
      />
    </div>

    <div class="relative px-5 md:px-6 pt-12 pb-14 md:pt-16 md:pb-20">
      <div class="max-w-2xl mx-auto">

        <h1 class="font-heading text-[1.85rem] leading-[1.12] md:text-[2.75rem] md:leading-[1.1] text-white mb-5">
          Tu web está online.<br />
          <em class="text-accent not-italic">Pero tus clientes llaman a tu competencia.</em>
        </h1>

        <p class="text-white/70 leading-relaxed mb-6 text-[0.95rem] md:text-base max-w-xl">
          Si Google, ChatGPT y tus visitantes entienden antes a tu competencia que a ti, pierdes consultas sin darte cuenta.
        </p>

        <p class="text-white/90 leading-relaxed mb-8 text-[0.95rem] md:text-base max-w-xl font-medium">
          No tiramos tu web actual a la basura. Aprovechamos lo que ya sirve &mdash; servicios, textos, fotos, marca y reseñas &mdash; y lo convertimos en una web más rápida, clara y preparada para Google, ChatGPT y nuevos clientes.
        </p>

        {/* Deal card */}
        <div class="bg-white/[0.12] backdrop-blur-sm border-2 border-accent/40 rounded-card p-5 md:p-6 mb-6 max-w-md shadow-lg">
          <p class="font-heading text-4xl md:text-5xl text-white mb-2">
            Desde 79&euro;<span class="text-lg text-white/60 font-body">/mes</span>
          </p>
          <div class="flex flex-wrap gap-2 mt-3">
            <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/20 text-accent rounded-full">Primeras 10 plazas este mes</span>
            <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-white/10 text-white/80 rounded-full">Sin pago ahora</span>
            <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-white/10 text-white/80 rounded-full">Aprovechamos lo que ya tienes</span>
          </div>
        </div>

        <a
          href="#formulario"
          class="inline-flex items-center gap-2 px-8 py-4 text-base font-medium text-white bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg w-full md:w-auto justify-center"
        >
          Comprobar si mi web encaja
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>

        <p class="text-white/40 text-xs mt-4">Los últimos 2 proyectos fueron visibles en Google o ChatGPT en menos de 2 semanas.</p>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      2 · PROOF STRIP
      ══════════════════════════════════════════════════ */}
  <section class="bg-bg-alt border-b border-border/50 px-4 md:px-6 py-6 md:py-8">
    <div class="max-w-4xl mx-auto">
      <p class="text-xs uppercase tracking-widest text-text-muted font-medium text-center mb-4">Resultados recientes</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
        <div class="flex items-start gap-3 bg-white border border-border rounded-card px-5 py-4">
          <span class="text-accent text-lg font-bold shrink-0 mt-0.5">#1</span>
          <div>
            <p class="text-text font-medium text-sm leading-snug">Clínica en Torrevieja: visible en Google en 14 días</p>
          </div>
        </div>
        <div class="flex items-start gap-3 bg-white border border-border rounded-card px-5 py-4">
          <span class="text-accent text-lg font-bold shrink-0 mt-0.5">#2</span>
          <div>
            <p class="text-text font-medium text-sm leading-snug">Dr. Verena Mann: 2 &rarr; 19 consultas/mes + mencionada por ChatGPT</p>
          </div>
        </div>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      3 · NO SOLO UNA WEB BONITA
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-12 md:py-16">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-3 text-center">
        Una web bonita no basta. Tu web tiene que generar consultas.
      </h2>
      <p class="text-text-muted text-center mb-8 md:mb-10 max-w-2xl mx-auto text-[0.95rem] leading-relaxed">
        Un diseñador web tradicional piensa en páginas y diseño. Nosotros nos enfocamos en cómo Google, ChatGPT y tus clientes entienden tu negocio — y en que te elijan a ti.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6">
        <div class="border border-border rounded-card p-5 md:p-6 bg-white/50">
          <p class="text-text-muted text-xs uppercase tracking-widest font-medium mb-3">Diseñador web tradicional</p>
          <ul class="space-y-2.5">
            {[
              'Web bonita, pocas consultas',
              'Piensa en páginas y diseño',
              'El SEO viene después',
              'Entregar y listo',
            ].map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-text-muted leading-relaxed">
                <svg class="w-4 h-4 text-red-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="border-2 border-accent/30 rounded-card p-5 md:p-6 bg-white shadow-lg relative">
          <span class="absolute -top-3 left-6 inline-block px-3 py-0.5 text-[0.65rem] font-medium tracking-widest uppercase bg-accent text-white rounded-full">
            NXG Media
          </span>
          <p class="text-text text-xs uppercase tracking-widest font-medium mb-3">Preparada para Google, ChatGPT y clientes</p>
          <ul class="space-y-2.5">
            {[
              'Visibilidad + conversión como punto de partida',
              'Servicio + zona claramente posicionados',
              'Pruebas y confianza antes de pedir cita',
              'Construida para que Google y ChatGPT te entiendan',
            ].map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-text leading-relaxed font-medium">
                <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <p class="text-text font-medium text-center text-[0.95rem] mt-8">
        La web es el medio. Más consultas es el objetivo.
      </p>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      4 · NO HAY QUE TIRARLO TODO
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-12 md:py-16 bg-bg-alt">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-3 text-center">
        No tiramos tu web. La convertimos en algo que funcione.
      </h2>
      <p class="text-text-muted text-center mb-8 md:mb-10 max-w-2xl mx-auto text-[0.95rem] leading-relaxed">
        Tu marca, reseñas, fotos y textos útiles los conservamos. Lo que no está claro, es lento o no convence, lo mejoramos.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">
        <div class="bg-white border border-border rounded-card p-5">
          <p class="font-heading text-lg text-text mb-1">Lo que funciona, lo conservamos</p>
          <p class="text-text-muted text-sm leading-relaxed">
            Marca, fotos, reseñas y textos útiles no tienen por qué perderse.
          </p>
        </div>
        <div class="bg-white border border-border rounded-card p-5">
          <p class="font-heading text-lg text-text mb-1">Lo que no entienden, lo mejoramos</p>
          <p class="text-text-muted text-sm leading-relaxed">
            Servicios, zona, pruebas y llamadas a la acción para que te perciban como la opción lógica.
          </p>
        </div>
        <div class="bg-white border border-border rounded-card p-5">
          <p class="font-heading text-lg text-text mb-1">Las ampliaciones pueden esperar</p>
          <p class="text-text-muted text-sm leading-relaxed">
            Blog, SEO local y anuncios se pueden añadir después. Primero la base.
          </p>
        </div>
      </div>

      <div class="text-center mt-8">
        <a
          href="#formulario"
          class="inline-flex items-center gap-2 px-7 py-3.5 text-sm font-medium text-text-inverse bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg"
        >
          Comprobar si mi web encaja
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      5 · DOLOR / PIERDES CLIENTES
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-12 md:py-16">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-3 text-center">
        Puede que ya estés perdiendo clientes frente a un competidor más claro
      </h2>
      <p class="text-text font-medium text-center mb-8 md:mb-10 max-w-2xl mx-auto text-[0.95rem]">
        Tu competencia no tiene que ser mejor. Solo más fácil de encontrar y entender.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6 mb-8">
        <div class="bg-bg-alt border border-border rounded-card p-5">
          <p class="font-heading text-lg text-text mb-1">Los visitantes se van</p>
          <p class="text-text-muted text-sm leading-relaxed">
            Si no sienten confianza lo suficientemente rápido, se van con la competencia.
          </p>
        </div>
        <div class="bg-bg-alt border border-border rounded-card p-5">
          <p class="font-heading text-lg text-text mb-1">Google y ChatGPT eligen al más claro</p>
          <p class="text-text-muted text-sm leading-relaxed">
            Webs bien estructuradas con información clara de servicios y zona se muestran más a menudo.
          </p>
        </div>
        <div class="bg-bg-alt border border-border rounded-card p-5">
          <p class="font-heading text-lg text-text mb-1">Un cliente extra ya lo recupera</p>
          <p class="text-text-muted text-sm leading-relaxed">
            ¿Un cliente te genera 500€? Entonces un cliente extra ya cubre más de 6 meses.
          </p>
        </div>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      6 · BASTA DE PARCHES SEO
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-12 md:py-16 bg-bg-alt">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-3 text-center">
        Deja de poner parches SEO en una web que no convierte
      </h2>
      <p class="text-text-muted text-center mb-8 md:mb-10 max-w-2xl mx-auto text-[0.95rem] leading-relaxed">
        Cuando la base es lenta, desordenada o confusa, los ajustes SEO puntuales no sirven. Primero la base tiene que estar bien.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6">
        <div class="border border-border rounded-card p-5 md:p-6 bg-white/50">
          <p class="text-text-muted text-xs uppercase tracking-widest font-medium mb-3">Enfoque antiguo</p>
          <ul class="space-y-2.5">
            {[
              'Añadir un plugin, ajustar un texto',
              'Probar otra cosa el mes siguiente',
              'La base sigue igual',
            ].map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-text-muted leading-relaxed">
                <svg class="w-4 h-4 text-red-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="border-2 border-accent/30 rounded-card p-5 md:p-6 bg-white shadow-lg relative">
          <span class="absolute -top-3 left-6 inline-block px-3 py-0.5 text-[0.65rem] font-medium tracking-widest uppercase bg-accent text-white rounded-full">
            Nuevo enfoque
          </span>
          <p class="text-text text-xs uppercase tracking-widest font-medium mb-3">Web preparada para Google y ChatGPT</p>
          <ul class="space-y-2.5">
            {[
              'Tu web actual convertida en una base clara',
              'Servicio + zona claros, pruebas en el lugar correcto',
              'Lista para más optimización cuando quieras',
            ].map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-text leading-relaxed font-medium">
                <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="text-center mt-8">
        <a
          href="#formulario"
          class="inline-flex items-center gap-2 px-7 py-3.5 text-sm font-medium text-text-inverse bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg"
        >
          Comprobar si mi web encaja
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      7 · PRUEBAS / CASOS
      ══════════════════════════════════════════════════ */}
  <section class="py-16 md:py-24 bg-primary">
    <div class="max-w-5xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-3xl md:text-4xl text-white mb-3 text-center">
        Caso en España: de cero a visible en Google en 14 días
      </h2>
      <p class="text-white/60 text-center mb-12 md:mb-16 max-w-xl mx-auto text-[0.95rem]">
        Los últimos 2 proyectos fueron visibles en Google o ChatGPT en menos de 2 semanas.
      </p>

      {/* ── CASE 1: CBMC (principal) ── */}
      <div class="bg-white/5 backdrop-blur border-2 border-accent/30 rounded-card p-5 md:p-8 mb-10">
        <div class="flex items-center gap-4 mb-5">
          <div class="w-12 h-12 rounded-full overflow-hidden ring-2 ring-accent/30 shrink-0">
            <Image
              src={jamesPhoto}
              alt="Dr. James Mitchell — Costa Blanca Movement Centre"
              widths={[56, 112]}
              sizes="56px"
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div>
            <p class="text-white font-medium text-sm">Dr. James Mitchell</p>
            <a href="https://www.costablancamovement.com" target="_blank" rel="noopener" class="text-accent/70 hover:text-accent text-xs transition-colors">costablancamovement.com</a>
          </div>
        </div>

        <h3 class="font-heading text-2xl md:text-3xl text-white mb-3">Clínica quiropráctica para expats en Torrevieja</h3>
        <p class="text-white/60 text-sm mb-5 leading-relaxed">
          Costa Blanca Movement Centre no tenía web, ni historial en Google, ni backlinks. En 14 días, la nueva web ya aparecía en Google. Después de 2 meses, recibía 12–15 pacientes al mes a través de la web.
        </p>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
          <div class="bg-white/5 rounded-card p-3 text-center">
            <p class="font-heading text-xl md:text-2xl text-accent">Pág.&nbsp;1</p>
            <p class="text-white/50 text-xs mt-0.5">en Google</p>
          </div>
          <div class="bg-white/5 rounded-card p-3 text-center">
            <p class="font-heading text-xl md:text-2xl text-accent">ChatGPT</p>
            <p class="text-white/50 text-xs mt-0.5">la menciona como opción local</p>
          </div>
          <div class="bg-white/5 rounded-card p-3 text-center">
            <p class="font-heading text-xl md:text-2xl text-accent">12&ndash;15</p>
            <p class="text-white/50 text-xs mt-0.5">pacientes/mes</p>
          </div>
          <div class="bg-white/5 rounded-card p-3 text-center">
            <p class="font-heading text-xl md:text-2xl text-accent">800+</p>
            <p class="text-white/50 text-xs mt-0.5">visitas orgánicas/mes</p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
          <button type="button" class="proof-trigger cursor-pointer group text-left">
            <div class="bg-black/40 border border-white/10 rounded-lg overflow-hidden">
              <Image src={proofGoogle} alt="Resultado en Google: Costa Blanca Movement Centre en página 1 tras 2 semanas" width={1200} quality={85} class="w-full h-auto" loading="lazy" />
            </div>
            <p class="text-white/40 text-xs mt-1.5 text-center group-hover:text-white/60 transition-colors">Google página 1 — tras 2 semanas</p>
          </button>
          <button type="button" class="proof-trigger cursor-pointer group text-left">
            <div class="bg-black/40 border border-white/10 rounded-lg overflow-hidden">
