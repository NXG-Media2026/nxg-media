---
/**
 * Web AI-ready — /es/suscripcion-web/
 * Direct-response landing page. Translate existing site to AI-ready foundation.
 * noindex — ads lander. No links to other offer pages.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import LogoMarquee from '../../components/LogoMarquee.astro';
import { siteConfig } from '../../data/site';
import { generateFAQPage, generateBreadcrumbs } from '../../data/schema';
import { buildHreflangTrilingual } from '../../i18n/hreflang';

import heroPhoto from '../../assets/images/founder/joost-standing-workinglaptop.webp';
import keystaticDashboard from '../../assets/images/keystatic1.png';
import keystaticHomepage from '../../assets/images/keystatic_edit_homepage.png';
import keystaticBlog from '../../assets/images/keystatic_add_blog.png';

const cmsScreenshots = [
  { src: keystaticDashboard, alt: 'Panel de administracion con vista general de todas las paginas, blogs, servicios y productos', caption: 'Todo en un solo lugar' },
  { src: keystaticHomepage, alt: 'Editar textos de la pagina principal mediante campos de entrada sencillos', caption: 'Editar textos — sin codigo' },
  { src: keystaticBlog, alt: 'Escribir un articulo de blog con barra de formato y campos SEO', caption: 'Publicar articulos tu mismo' },
];
import proofGoogle from '../../assets/images/cases/proof-google-torrevieja.png';
import proofChatgpt from '../../assets/images/cases/proof-chatgpt-local.png';
import proofVerenaAi from '../../assets/images/cases/doc_veri_ai_answer_cropped.PNG';
import proofVerenaChatgpt from '../../assets/images/cases/doc-veri-chatgptproof.jpeg';
import verenaPhoto from '../../assets/images/cases/verena-mann-linkedin.webp';
import jamesPhoto from '../../assets/images/cases/james-mitchell-portrait.png';

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logos/*.{webp,avif,png,jpg}', { eager: true });
const logos = Object.entries(logoFiles)
  .filter(([path]) => /logo/i.test(path.split('/').pop()!))
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/, '');
    const name = filename.replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim();
    return { src: mod.default, alt: name };
  });

const locale = 'es';
const title = 'Web AI-ready — desde €79/mes | NXG Media';
const description = 'Transforma tu sitio web actual en una base de clientes AI-ready que Google, ChatGPT y los clientes entienden. Desde €79/mes. Primeras 10 plazas este mes.';

const hreflang = buildHreflangTrilingual('/website-abonnement', '/en/website-subscription', '/es/suscripcion-web');

const breadcrumbs = [
  { label: 'Inicio', href: '/es/' },
  { label: 'Suscripcion Web' },
];

const faqItems = [
  {
    q: 'Mi sitio web completo tiene que rehacerse?',
    a: "El punto de partida es conservar lo que funciona: tu oferta, identidad visual, textos, fotos y pruebas. Lo reconstruimos sobre una base mas rapida y clara.",
  },
  {
    q: 'Por que puede hacerse por 79 euros al mes?',
    a: "Porque no construimos un proyecto completamente personalizado desde cero. Traducimos tu sitio actual a una base solida. Eso nos permite construir mas rapido y mantener los costes bajos.",
  },
  {
    q: 'Por que solo 10 plazas?',
    a: "Porque esto solo funciona cuando el alcance se mantiene ajustado: convertir tu sitio actual en una base mejor, sin un proyecto personalizado interminable. Por eso aceptamos un maximo de 10 empresas al mes.",
  },
  {
    q: 'Por que 12 meses?',
    a: "Web, hosting, mantenimiento y revision mensual de visibilidad estan incluidos en una suscripcion. Sin gran pago inicial, pero con una base que sigue funcionando y se mantiene.",
  },
  {
    q: 'Que pasa si quiero paginas extra o contenido SEO?',
    a: "Eso puede venir despues. Paginas de servicios adicionales, blogs, contenido local y optimizacion avanzada se pueden contratar aparte. Primero nos aseguramos de que la base este bien.",
  },
  {
    q: 'Voy a perder mi contenido antiguo?',
    a: "No. Lo que funciona, lo conservamos. Lo que no esta claro, es lento o no convierte, lo mejoramos.",
  },
  {
    q: 'Es para cualquier empresa?',
    a: "Principalmente para proveedores de servicios locales, consultorios y especialistas con un servicio claro. Tiendas online y sitios complejos a medida suelen quedar fuera de esta oferta.",
  },
];

const schemas = [
  generateFAQPage(faqItems.map(i => ({ question: i.q, answer: i.a }))),
  generateBreadcrumbs(breadcrumbs),
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={`${siteConfig.url}/es/suscripcion-web`}
  noindex={true}
  schemas={schemas}
  locale={locale}
  hreflang={hreflang}
>

  {/* ══════════════════════════════════════════════════
      1 · HERO
      ══════════════════════════════════════════════════ */}
  <section class="relative overflow-hidden bg-primary">
    <div class="absolute inset-0 hidden md:block">
      <Image
        src={heroPhoto}
        alt=""
        width={800}
        class="absolute right-0 top-0 h-full w-auto object-cover object-top opacity-[0.15]"
        loading="eager"
      />
    </div>

    <div class="relative px-5 md:px-6 pt-12 pb-14 md:pt-16 md:pb-20">
      <div class="max-w-2xl mx-auto">

        <h1 class="font-heading text-[1.85rem] leading-[1.12] md:text-[2.75rem] md:leading-[1.1] text-white mb-5">
          Tu web esta online.<br />
          <em class="text-accent not-italic">Pero tu competencia se lleva al cliente.</em>
        </h1>

        <p class="text-white/70 leading-relaxed mb-6 text-[0.95rem] md:text-base max-w-xl">
          Cuando Google, ChatGPT y los visitantes entienden a tu competencia mas rapido que a ti, pierdes consultas sin darte cuenta.
        </p>

        <p class="text-white/90 leading-relaxed mb-8 text-[0.95rem] md:text-base max-w-xl font-medium">
          Traducimos tu sitio actual &mdash; oferta, identidad visual, textos y pruebas &mdash; a una base AI-ready mas rapida, construida para ser encontrada y elegida.
        </p>

        {/* Deal card */}
        <div class="bg-white/[0.12] backdrop-blur-sm border-2 border-accent/40 rounded-card p-5 md:p-6 mb-6 max-w-md shadow-lg">
          <p class="font-heading text-4xl md:text-5xl text-white mb-2">
            Desde &euro;79<span class="text-lg text-white/60 font-body">/mes</span>
          </p>
          <div class="flex flex-wrap gap-2 mt-3">
            <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/20 text-accent rounded-full">Primeras 10 plazas este mes</span>
            <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-white/10 text-white/80 rounded-full">Sin pago ahora</span>
          </div>
        </div>

        <a
          href="#aanvragen"
          class="inline-flex items-center gap-2 px-8 py-4 text-base font-medium text-white bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg w-full md:w-auto justify-center"
        >
          Analizar mi web
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      2 · PROOF STRIP
      ══════════════════════════════════════════════════ */}
  <section class="bg-bg-alt border-b border-border/50 px-4 md:px-6 py-6 md:py-8">
    <div class="max-w-4xl mx-auto">
      <p class="text-xs uppercase tracking-widest text-text-muted font-medium text-center mb-4">Pruebas recientes de 2 nuevas bases</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
        <div class="flex items-start gap-3 bg-white border border-border rounded-card px-5 py-4">
          <span class="text-accent text-lg font-bold shrink-0 mt-0.5">#1</span>
          <div>
            <p class="text-text font-medium text-sm leading-snug">Costa Blanca: visible en Google en 14 dias</p>
          </div>
        </div>
        <div class="flex items-start gap-3 bg-white border border-border rounded-card px-5 py-4">
          <span class="text-accent text-lg font-bold shrink-0 mt-0.5">#2</span>
          <div>
            <p class="text-text font-medium text-sm leading-snug">Dr. Verena Mann: 2 &rarr; 19 consultas/mes + mencionada por ChatGPT</p>
          </div>
        </div>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      3 · NO SOLO UNA WEB BONITA
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-12 md:py-16">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-3 text-center">
        No solo una web bonita. Una web que debe generar clientes.
      </h2>
      <p class="text-text-muted text-center mb-8 md:mb-10 max-w-2xl mx-auto text-[0.95rem] leading-relaxed">
        Un disenador web tradicional piensa en paginas y diseno. Nosotros nos enfocamos en intencion de busqueda, confianza, pruebas, CTAs y como Google, ChatGPT y los clientes entienden tu negocio.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6">
        <div class="border border-border rounded-card p-5 md:p-6 bg-white/50">
          <p class="text-text-muted text-xs uppercase tracking-widest font-medium mb-3">Disenador web tradicional</p>
          <ul class="space-y-2.5">
            {[
              'Web bonita, pocas consultas',
              'Piensa en paginas y diseno',
              'El SEO viene despues',
              'Entregar y listo',
            ].map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-text-muted leading-relaxed">
                <svg class="w-4 h-4 text-red-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="border-2 border-accent/30 rounded-card p-5 md:p-6 bg-white shadow-lg relative">
          <span class="absolute -top-3 left-6 inline-block px-3 py-0.5 text-[0.65rem] font-medium tracking-widest uppercase bg-accent text-white rounded-full">
            NXG Media
          </span>
          <p class="text-text text-xs uppercase tracking-widest font-medium mb-3">Visibilidad AI y conversion</p>
          <ul class="space-y-2.5">
            {[
              'Visibilidad + conversion como punto de partida',
              'Servicio + region claramente posicionados',
              "Pruebas antes del CTA",
              'Construida para Google, AI y clientes',
            ].map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-text leading-relaxed font-medium">
                <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <p class="text-text font-medium text-center text-[0.95rem] mt-8">
        La web es el medio. Mas consultas es el objetivo.
      </p>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      4 · NO HAY QUE TIRARLO TODO
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-12 md:py-16 bg-bg-alt">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-3 text-center">
        No tienes que tirarlo todo. La base tiene que mejorar.
      </h2>
      <p class="text-text-muted text-center mb-8 md:mb-10 max-w-2xl mx-auto text-[0.95rem] leading-relaxed">
        Tu oferta, identidad visual, resenas, fotos y textos utiles los conservamos. Lo que no esta claro, es lento o no convence, lo mejoramos.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">
        <div class="bg-white border border-border rounded-card p-5">
          <p class="font-heading text-lg text-text mb-1">Lo que funciona, lo conservamos</p>
          <p class="text-text-muted text-sm leading-relaxed">
            Identidad visual, fotos, resenas y textos utiles no tienen por que perderse.
          </p>
        </div>
        <div class="bg-white border border-border rounded-card p-5">
          <p class="font-heading text-lg text-text mb-1">Lo que clientes y AI no entienden, lo mejoramos</p>
          <p class="text-text-muted text-sm leading-relaxed">
            Servicios, region, pruebas y CTAs para que te perciban como la opcion logica mas rapido.
          </p>
        </div>
        <div class="bg-white border border-border rounded-card p-5">
          <p class="font-heading text-lg text-text mb-1">Las optimizaciones extra pueden esperar</p>
          <p class="text-text-muted text-sm leading-relaxed">
            Blogs, SEO local y anuncios se pueden anadir despues. Primero la base.
          </p>
        </div>
      </div>

      <div class="text-center mt-8">
        <a
          href="#aanvragen"
          class="inline-flex items-center gap-2 px-7 py-3.5 text-sm font-medium text-text-inverse bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg"
        >
          Analizar mi web
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      5 · DOLOR / PIERDES CLIENTES
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-12 md:py-16">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-3 text-center">
        Puede que ya estes perdiendo clientes frente a un competidor mas claro
      </h2>
      <p class="text-text font-medium text-center mb-8 md:mb-10 max-w-2xl mx-auto text-[0.95rem]">
        Tu competencia no tiene que ser mejor. Solo mas claramente encontrable.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6 mb-8">
        <div class="bg-bg-alt border border-border rounded-card p-5">
          <p class="font-heading text-lg text-text mb-1">Los visitantes se van</p>
          <p class="text-text-muted text-sm leading-relaxed">
            Si no sienten confianza lo suficientemente rapido, se van con la competencia.
          </p>
        </div>
        <div class="bg-bg-alt border border-border rounded-card p-5">
          <p class="font-heading text-lg text-text mb-1">Google y AI eligen al mas claro</p>
          <p class="text-text-muted text-sm leading-relaxed">
            Sitios bien estructurados con informacion clara de servicios y region se muestran mas a menudo.
          </p>
        </div>
        <div class="bg-bg-alt border border-border rounded-card p-5">
          <p class="font-heading text-lg text-text mb-1">Un cliente extra ya lo recupera</p>
          <p class="text-text-muted text-sm leading-relaxed">
            Te genera un cliente &euro;500? Entonces un cliente extra ya cubre mas de 6 meses de suscripcion.
          </p>
        </div>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      6 · BASTA DE PARCHES SEO
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-12 md:py-16 bg-bg-alt">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-3 text-center">
        Deja de poner parches SEO en una web que no convierte
      </h2>
      <p class="text-text-muted text-center mb-8 md:mb-10 max-w-2xl mx-auto text-[0.95rem] leading-relaxed">
        Cuando la base es lenta, desordenada o confusa, los ajustes SEO puntuales se quedan cortos. Primero la base tiene que estar bien.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6">
        <div class="border border-border rounded-card p-5 md:p-6 bg-white/50">
          <p class="text-text-muted text-xs uppercase tracking-widest font-medium mb-3">Enfoque antiguo</p>
          <ul class="space-y-2.5">
            {[
              'Anadir un plugin, ajustar un texto',
              'Probar otra cosa el mes siguiente',
              'La base sigue igual',
            ].map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-text-muted leading-relaxed">
                <svg class="w-4 h-4 text-red-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="border-2 border-accent/30 rounded-card p-5 md:p-6 bg-white shadow-lg relative">
          <span class="absolute -top-3 left-6 inline-block px-3 py-0.5 text-[0.65rem] font-medium tracking-widest uppercase bg-accent text-white rounded-full">
            Nuevo enfoque
          </span>
          <p class="text-text text-xs uppercase tracking-widest font-medium mb-3">Base AI-ready</p>
          <ul class="space-y-2.5">
            {[
              'Sitio actual traducido a una base clara',
              'Servicio + region claros, pruebas en el lugar correcto',
              'Lista para mas optimizacion',
            ].map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-text leading-relaxed font-medium">
                <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="text-center mt-8">
        <a
          href="#aanvragen"
          class="inline-flex items-center gap-2 px-7 py-3.5 text-sm font-medium text-text-inverse bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg"
        >
          Analizar mi web
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      7 · PRUEBAS / CASOS
      ══════════════════════════════════════════════════ */}
  <section class="py-16 md:py-24 bg-primary">
    <div class="max-w-5xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-3xl md:text-4xl text-white mb-3 text-center">
        Esto es lo que puede pasar cuando la base esta bien
      </h2>
      <p class="text-white/60 text-center mb-12 md:mb-16 max-w-xl mx-auto text-[0.95rem]">
        Nuestras 2 ultimas bases nuevas fueron visibles en Google o AI en menos de 2 semanas.
      </p>

      {/* ── CASE 1: CBMC ── */}
      <div class="bg-white/5 backdrop-blur border-2 border-accent/30 rounded-card p-5 md:p-8 mb-10">
        <div class="flex items-center gap-4 mb-5">
          <div class="w-12 h-12 rounded-full overflow-hidden ring-2 ring-accent/30 shrink-0">
            <Image
              src={jamesPhoto}
              alt="Dr. James Mitchell"
              widths={[56, 112]}
              sizes="56px"
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div>
            <p class="text-white font-medium text-sm">Dr. James Mitchell</p>
            <a href="https://www.costablancamovement.com" target="_blank" rel="noopener" class="text-accent/70 hover:text-accent text-xs transition-colors">costablancamovement.com</a>
          </div>
        </div>

        <h3 class="font-heading text-2xl md:text-3xl text-white mb-1">De cero a visible en 14 dias</h3>
        <p class="text-white/50 text-sm mb-5">Clinica quiropractica para expats en Torrevieja. Sin web, sin historial, sin backlinks.</p>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
          <div class="bg-white/5 rounded-card p-3 text-center">
            <p class="font-heading text-xl md:text-2xl text-accent">pag.&nbsp;1</p>
            <p class="text-white/50 text-xs mt-0.5">en Google</p>
          </div>
          <div class="bg-white/5 rounded-card p-3 text-center">
            <p class="font-heading text-xl md:text-2xl text-accent">ChatGPT</p>
            <p class="text-white/50 text-xs mt-0.5">menciona la clinica</p>
          </div>
          <div class="bg-white/5 rounded-card p-3 text-center">
            <p class="font-heading text-xl md:text-2xl text-accent">12&ndash;15</p>
            <p class="text-white/50 text-xs mt-0.5">pacientes/mes</p>
          </div>
          <div class="bg-white/5 rounded-card p-3 text-center">
            <p class="font-heading text-xl md:text-2xl text-accent">800+</p>
            <p class="text-white/50 text-xs mt-0.5">visitantes/mes</p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
          <button type="button" class="proof-trigger cursor-pointer group text-left">
            <div class="bg-black/40 border border-white/10 rounded-lg overflow-hidden">
              <Image src={proofGoogle} alt="Resultado en Google: Costa Blanca Movement Centre en pagina 1 tras 2 semanas" width={1200} quality={85} class="w-full h-auto" loading="lazy" />
            </div>
            <p class="text-white/40 text-xs mt-1.5 text-center group-hover:text-white/60 transition-colors">Google pagina 1 &mdash; tras 2 semanas</p>
          </button>
          <button type="button" class="proof-trigger cursor-pointer group text-left">
            <div class="bg-black/40 border border-white/10 rounded-lg overflow-hidden">
              <Image src={proofChatgpt} alt="ChatGPT recomienda Costa Blanca Movement Centre como opcion local numero 1" width={1200} quality={85} class="w-full h-auto" loading="lazy" />
            </div>
            <p class="text-white/40 text-xs mt-1.5 text-center group-hover:text-white/60 transition-colors">ChatGPT recomienda la clinica como #1</p>
          </button>
        </div>

        <p class="text-accent font-medium text-center text-base pt-4 border-t border-white/10">
          No despues de un ano de SEO. En 14 dias la base ya fue detectada.
        </p>
      </div>

      {/* ── CASE 2: Dr. Verena Mann ── */}
      <div class="bg-white/5 backdrop-blur border border-white/10 rounded-card p-5 md:p-8 mb-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
          <div>
            <div class="flex items-center gap-4 mb-5">
              <div class="w-12 h-12 rounded-full overflow-hidden ring-2 ring-accent/30 shrink-0">
