---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import { siteConfig } from '../../../data/site';
import { t } from '../../../i18n/utils';
import { buildHreflangTrilingual } from '../../../i18n/hreflang';

const locale = 'es';
const hreflang = buildHreflangTrilingual('/guides/', '/en/guides/', '/es/guias/');
const guides = (await getCollection('guides')).filter((g) => g.data.locale === locale);
const nlGuides = guides.length === 0 ? (await getCollection('guides')).filter((g) => g.data.locale === 'nl') : [];

const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: '/es/' },
  { label: t('breadcrumb.guides', locale) },
];
---

<BaseLayout title={`Guías | ${siteConfig.name}`} description="Guías prácticas sobre crecimiento online, visibilidad ante IA y posicionamiento de expertos." locale={locale} hreflang={hreflang}>
  <BreadcrumbNav items={breadcrumbs} />
  <section class="py-16 md:py-24">
    <div class="max-w-[1260px] mx-auto px-5 md:px-8">
      <p class="eyebrow text-primary mb-4">BASE DE CONOCIMIENTO</p>
      <h1 class="font-heading font-extrabold text-4xl md:text-[3.5rem] lg:text-[4rem] leading-[0.98] text-text mb-10 uppercase">Guías</h1>
      <div class="space-y-6">
        {guides.length > 0 ? (
          guides.map((g) => (
            <a href={`/es/guias/${g.data.pageSlug}/`} class="group block bg-white border border-border rounded-card p-6 hover:border-accent/30 hover:shadow-lg transition-all">
              {g.data.cluster && <span class="text-xs font-medium text-accent uppercase tracking-wider mb-2 block">{g.data.cluster}</span>}
              <h2 class="font-heading text-lg text-text group-hover:text-accent transition-colors">{g.data.title}</h2>
            </a>
          ))
        ) : (
          nlGuides.map((g) => (
            <a href={`/guides/${g.data.pageSlug}/`} class="group block bg-white border border-border rounded-card p-6 hover:border-accent/30 hover:shadow-lg transition-all">
              {g.data.cluster && <span class="text-xs font-medium text-accent uppercase tracking-wider mb-2 block">{g.data.cluster}</span>}
              <h2 class="font-heading text-lg text-text group-hover:text-accent transition-colors">{g.data.title}</h2>
            </a>
          ))
        )}
      </div>
    </div>
  </section>
</BaseLayout>
