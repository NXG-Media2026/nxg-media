---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import CalendlyEmbed from '../../components/CalendlyEmbed.astro';
import { siteConfig } from '../../data/site';
import { generateBreadcrumbs } from '../../data/schema';
import { t, localizePath } from '../../i18n/utils';
import { buildHreflangTrilingual } from '../../i18n/hreflang';

const locale = 'es';
const hreflang = buildHreflangTrilingual('/contact', '/en/contact', '/es/contacto');
const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: localizePath('/', locale) },
  { label: 'Contacto' },
];
const breadcrumbSchema = [
  { name: t('breadcrumb.home', locale), url: `${siteConfig.url}${localizePath('/', locale)}` },
  { name: 'Contacto', url: `${siteConfig.url}/es/contacto` },
];
---

<BaseLayout
  title={`Contacto | ${siteConfig.name}`}
  description="Contacta con NXG Media o reserva una llamada con Joost."
  schemas={[generateBreadcrumbs(breadcrumbSchema)]}
  locale={locale}
  hreflang={hreflang}
  hideNewsletter={true}
  hideStickyMobileCTA={true}
>
  <BreadcrumbNav items={breadcrumbs} />

  <section class="refresh-hero refresh-contact"><div class="refresh-wrap refresh-split"><div><p class="refresh-eyebrow">CUÉNTANOS HACIA DÓNDE QUIERES IR</p><h1>TU SIGUIENTE PASO.<br /><span>EMPIEZA AQUÍ.</span></h1><p>En 15 minutos hablamos sobre tu negocio, tus planes de crecimiento y qué enfoque encaja mejor. Personal, concreto y sin compromiso.</p><a class="refresh-button" href="#calendly">Elige un momento con Joost <span aria-hidden="true">↓</span></a></div><aside class="refresh-contact-card"><img src="/lander-assets/proof/joost.webp" alt="Joost van Putten" width="100" height="100" /><p class="refresh-eyebrow">HABLARÁS CON JOOST</p><h2>SOLO UNA BREVE<br />PRESENTACIÓN.</h2><p>¿Prefieres preguntar algo primero? Envíame un mensaje sin problema.</p><a href={'mailto:' + siteConfig.email}>{siteConfig.email} ↗</a><a href={siteConfig.socials.linkedin} target="_blank" rel="noopener noreferrer">Encuéntrame en LinkedIn ↗</a></aside></div></section>

  <CalendlyEmbed pageType="contact" pageSlug="contacto" locale={locale} title="Elige tu momento." subtitle="15 minutos. Tu negocio, tus preguntas y un siguiente paso concreto." />
</BaseLayout>
