---
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import Quiz from '../components/Quiz';
import { siteConfig } from '../data/site';
import { generateBreadcrumbs } from '../data/schema';
import { t } from '../i18n/utils';

const breadcrumbs = [
  { label: t('breadcrumb.home'), href: '/' },
  { label: t('quiz.heading') },
];

const breadcrumbSchema = breadcrumbs.map((b) => ({
  name: b.label,
  url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}/quiz`,
}));
---

<BaseLayout
  title={`${t('quiz.heading')} | ${siteConfig.name}`}
  description="Finde heraus, welcher Hormon-Typ du bist — mit dem kostenlosen Quiz von doc.veri. 7 Fragen, personalisiertes Ergebnis."
  schemas={[generateBreadcrumbs(breadcrumbSchema)]}
  locale="de"
>
  <BreadcrumbNav items={breadcrumbs} />

  <section class="py-16 md:py-24 lg:py-32 bg-bg">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <div class="text-center mb-14 md:mb-20">
        <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/10 text-accent rounded-full mb-4">
          Kostenlos & unverbindlich
        </span>
        <h1 class="font-heading text-4xl md:text-5xl text-text mb-4">
          {t('quiz.heading')}
        </h1>
        <p class="text-lg text-text-muted max-w-2xl mx-auto">
          Beantworte 7 kurze Fragen und finde heraus, welcher Hormon-Typ du bist — mit personalisierten Empfehlungen von Dr. Verena.
        </p>
      </div>

      <Quiz client:load />
    </div>
  </section>
</BaseLayout>
