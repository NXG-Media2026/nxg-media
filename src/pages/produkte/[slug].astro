---
/**
 * Product page dynamic route.
 *
 * Products with a `cluster` field use HybridProductLayout (v1.2 model).
 * Products without a cluster use the standard ProductLayout.
 */
import { getCollection } from 'astro:content';
import ProductLayout from '../../layouts/ProductLayout.astro';
import HybridProductLayout from '../../layouts/HybridProductLayout.astro';

export async function getStaticPaths() {
  const products = await getCollection('produkte');
  return products.map((product) => ({
    params: { slug: product.data.pageSlug },
    props: { entry: product },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const isHybrid = Boolean(entry.data.cluster);
---

{isHybrid ? (
  <HybridProductLayout product={entry.data}>
    <Content />
  </HybridProductLayout>
) : (
  <ProductLayout product={entry.data}>
    <Content />
  </ProductLayout>
)}
