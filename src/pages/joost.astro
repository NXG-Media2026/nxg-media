    .fine { margin-top: 18px; font-size: 13px; line-height: 1.55; color: var(--muted); max-width: 60em; }

    .ratio-34 { aspect-ratio: 3 / 4; }
    .ratio-11 { aspect-ratio: 1 / 1; }
    video.facade-frame { object-fit: cover; }

    .bands { margin-top: 40px; display: grid; gap: 16px; }
    .band { display: grid; gap: 24px; padding: 22px; border-radius: 18px; background: var(--tint); }
    @media (min-width: 1024px) { .band { grid-template-columns: 330px 1fr; gap: 40px; padding: 32px; align-items: start; } }
    .band-text { display: flex; flex-direction: column; align-items: flex-start; }
