  <script is:inline>
    function openLinkedSection(hash) {
      var target = document.getElementById(hash.slice(1));
      if (!target) return;
      var fold = target.closest('.portfolio-fold') || target.querySelector(':scope > .portfolio-fold');
      if (fold) fold.open = true;
    }
    document.querySelectorAll('a[href^="#"]').forEach(function (link) {
      link.addEventListener('click', function () { openLinkedSection(link.hash); });
    });
    window.addEventListener('hashchange', function () { openLinkedSection(location.hash); });
    if (location.hash) openLinkedSection(location.hash);
    document.querySelectorAll('.portfolio-fold').forEach(function (fold) {
      fold.addEventListener('toggle', function () {
        if (fold.open) return;
        fold.querySelectorAll('video').forEach(function (video) { video.pause(); });
        fold.querySelectorAll('iframe[data-vimeo-player]').forEach(function (frame) {
          frame.contentWindow.postMessage({ method: 'pause' }, 'https://player.vimeo.com');
        });
      });
    });
    document.querySelectorAll('.facade[data-video]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var v = document.createElement('video');
        v.src = btn.dataset.video;
        v.controls = true;
        v.autoplay = true;
        v.playsInline = true;
        v.setAttribute('aria-label', btn.getAttribute('aria-label') || 'Video');
        v.className = btn.className.replace('facade', 'facade-frame');
        btn.replaceWith(v);
        v.play().catch(function () {});
      }, { once: true });
    });

    document.querySelectorAll('.facade[data-vimeo]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var iframe = document.createElement('iframe');
        iframe.src = 'https://player.vimeo.com/video/' + btn.dataset.vimeo + '?autoplay=1&dnt=1&title=0&byline=0&portrait=0';
        iframe.allow = 'autoplay; fullscreen; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.dataset.vimeoPlayer = '';
        iframe.title = btn.getAttribute('aria-label') || 'Video';
        iframe.className = btn.className.replace('facade', 'facade-frame');
        btn.replaceWith(iframe);
      }, { once: true });
    });


    (function () {
      var toggles = document.querySelectorAll('.ai-toggle');
      var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      function set(btn, open) {
        var panel = document.getElementById(btn.getAttribute('aria-controls'));
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        btn.firstChild.nodeValue = open ? 'Close project ' : btn.dataset.label + ' ';
        btn.lastElementChild.textContent = open ? '−' : '+';
        btn.closest('.ai-card').classList.toggle('is-open', open);
        if (panel) panel.hidden = !open;
        return panel;
      }
      toggles.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var open = btn.getAttribute('aria-expanded') !== 'true';
          toggles.forEach(function (other) { if (other !== btn) set(other, false); });
          var panel = set(btn, open);
          if (open && panel) panel.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'nearest' });
        });
      });
    })();

    (function () {
      var links = document.querySelectorAll('.pf-links a');
      var map = {};
      links.forEach(function (a) { map[a.getAttribute('href').slice(1)] = a; });
      if (!('IntersectionObserver' in window)) return;
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          links.forEach(function (a) { a.removeAttribute('aria-current'); });
          var a = map[e.target.id];
          if (a) a.setAttribute('aria-current', 'true');
        });
      }, { rootMargin: '-45% 0px -50% 0px' });
      Object.keys(map).concat('top').forEach(function (id) {
        var el = document.getElementById(id);
        if (el) io.observe(el);
      });
    })();
  </script>

