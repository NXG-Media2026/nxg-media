    .glance-list { display: grid; gap: 7px; }
    .glance-list li { position: relative; padding-left: 16px; font-size: 14px; line-height: 1.4; color: #2b2e33; }
    .glance-list li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 7px; height: 7px; border-radius: 2px; background: var(--blue); }
    .glance-list .glance-strong { font-weight: 800; color: var(--ink); }
    .glance-list .glance-strong::before { background: var(--yellow); box-shadow: 0 0 0 1px var(--ink); }

    /* Final logo and platform polish */
    .marquee-note { margin: -18px auto 0; padding-bottom: 8px; text-align: center; font-size: 12.5px; color: var(--muted); }
    .plat-icon { display: inline-flex; width: 14px; height: 14px; flex-shrink: 0; }
    .plat-icon svg { width: 100%; height: 100%; fill: currentColor; }
    .plats-lg .plat-icon { width: 15px; height: 15px; }
    .glance-plat-name { display: inline-flex; align-items: center; gap: 8px; }
    .edu li { flex-direction: row; align-items: center; gap: 14px; padding-left: 0; border-left: 0; }
    .edu li > div { display: flex; flex-direction: column; }
    .edu-logo { height: 30px; width: auto; max-width: 120px; object-fit: contain; flex-shrink: 0; }
    .tl-period { font-size: 1.2rem; }

    /* System diagrams in AI cards */
    .ai-mini { display: block; padding: 18px 20px; }
    @media (min-width: 900px) { .ai-mini { min-height: 0; } }
    .ai-panel-diagram { max-width: 760px; padding: 24px; border-radius: 16px; background: #1a1d22; border: 1px solid #2c2f35; }
    .ai-panel-diagram + .ai-panel-lead { margin-top: 18px; }

    /* Creative OS screenshots */
    .ai-shot-preview { padding: 18px 20px 0; background: #14161a; border-bottom: 1px solid #2c2f35; }
    .ai-shot-preview .browser { border-radius: 10px 10px 0 0; border-bottom: 0; box-shadow: none; max-height: 220px; overflow: hidden; }
    .os-evidence { margin-top: 22px; display: grid; gap: 22px; }
    @media (min-width: 900px) { .os-evidence { grid-template-columns: 0.85fr 1.15fr; align-items: start; } }
    .os-evidence figure { margin: 0; }
    .os-evidence figcaption { margin-top: 10px; font-size: 14px; line-height: 1.5; color: #b7b9be; }
    .os-evidence figcaption strong { display: block; color: #fff; }
    .os-crop { aspect-ratio: 16 / 9; overflow: hidden; background: #191919; }
    .os-crop img { width: 100%; height: 100%; object-fit: cover; object-position: left top; }
  </style>
