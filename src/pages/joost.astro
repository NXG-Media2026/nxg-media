    .ai-mini { padding: 22px; background: #14161a; border-bottom: 1px solid #2c2f35; display: flex; align-items: center; }
    @media (min-width: 900px) { .ai-mini { min-height: 118px; } .ai-grid .ai-card { grid-template-rows: auto 1fr; } }
    .card-stack { margin-top: 14px; line-height: 1.55; }
