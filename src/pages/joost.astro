    .ai-card-body { padding: 24px; display: flex; flex-direction: column; align-items: flex-start; }
    .ai-card h3 { margin-top: 10px; font-size: clamp(1.4rem, 2.6vw, 1.9rem); font-weight: 800; line-height: 1.1; color: #fff; }
    .ai-card .product-kicker { margin-top: 12px; }
    .ai-card .product-kicker + h3 { margin-top: 4px; }
    .ai-card-text { margin-top: 10px; font-size: 15px; line-height: 1.55; color: #c9cbcf; max-width: 34em; }
    .ai-outcome { margin-top: 16px; font-size: 15px; color: #fff; }
    .ai-outcome .num { font-size: 2.2rem; color: var(--yellow); margin-right: 6px; vertical-align: -4px; }
