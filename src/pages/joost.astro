    .availability-break { display: none; }
    @media (max-width: 600px) { .availability-break { display: inline; } .availability-divider { display: none; } }
    .availability { margin-bottom: 20px; padding: 9px 14px; background: var(--yellow); border-radius: 6px; line-height: 1.4; display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 600; color: var(--ink); }
    .availability-dot { width: 8px; height: 8px; border-radius: 999px; background: #1f8f5f; box-shadow: 0 0 0 4px rgba(31, 143, 95, 0.15); flex-shrink: 0; }
    .hero-actions { margin-top: 18px; }
    .plats { list-style: none; padding: 0; margin: 10px 0 0; display: flex; flex-wrap: wrap; gap: 6px; }
    .plat { display: inline-flex; align-items: center; gap: 6px; padding: 3px 10px; border: 1px solid var(--line); border-radius: 999px; font-size: 12px; font-weight: 700; color: var(--ink); background: var(--paper); }
    .plats-lg .plat { font-size: 13px; padding: 5px 12px; }
    .plat-core { border-color: var(--ink); }
    .plat-core-tag { font-size: 10px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: var(--blue); }
    .prev { padding-top: 72px; }
    .prev-intro { margin-top: 4px; max-width: 72em; color: var(--muted); font-size: 14px; line-height: 1.55; }
    .prev-list { list-style: none; padding: 0; margin: 20px 0 0; border-top: 1px solid var(--line); }
    .prev-row { display: grid; gap: 8px 24px; padding: 18px 0; border-bottom: 1px solid var(--line); grid-template-columns: 1fr; align-items: center; }
    @media (min-width: 900px) {
      .prev-row { grid-template-columns: 1.25fr 0.75fr 1.05fr 1.6fr; }
      .prev-result { grid-column: 4; }
    }
    .prev-brand { display: flex; flex-direction: column; gap: 4px; }
    .prev-logo { height: 24px; width: auto; max-width: 140px; object-fit: contain; display: block; }
    .prev-name { font-weight: 800; font-size: 1.05rem; }
    .prev-icon-name { display: inline-flex; align-items: center; gap: 8px; }
    .prev-icon { height: 26px; width: 26px; object-fit: contain; }
    .prev-role { font-size: 13px; color: var(--muted); }
    .prev-row .plats { margin: 0; }
    .prev-spend { display: flex; flex-direction: column; }
    .prev-spend .num { font-size: 1.6rem; }
    .prev-spend-label { font-size: 12.5px; line-height: 1.35; color: var(--muted); }
    .prev-result { font-size: 14px; font-weight: 600; line-height: 1.4; }
    .prev-result:empty { display: none; }
    .tags { list-style: none; padding: 0; margin: 0 0 6px; display: flex; flex-wrap: wrap; gap: 6px; }
    .tags li { padding: 4px 10px; border-radius: 6px; background: var(--tint); font-size: 13px; color: #2b2e33; }
    .skill-groups { margin-top: 8px; display: grid; gap: 4px 28px; }
    @media (min-width: 640px) { .skill-groups { grid-template-columns: 1fr 1fr; } }
    .edu { list-style: none; padding: 0; margin: 0 0 8px; display: grid; gap: 12px; }
    .edu li { display: flex; flex-direction: column; padding-left: 14px; border-left: 3px solid var(--blue); }
    .edu strong { font-size: 15px; }
    .edu span { font-size: 14px; color: var(--muted); }
    .langs-cv li { color: var(--ink); }

    /* AI cards with progressive disclosure */
    .ai-card { display: grid; gap: 0; border-radius: 16px; overflow: hidden; background: #1a1d22; border: 1px solid #2c2f35; transition: border-color 150ms; }
    .ai-card.is-open { border-color: var(--yellow); }
    .ai-card-body { padding: 24px; display: flex; flex-direction: column; align-items: flex-start; }
    .ai-card h3 { margin-top: 10px; font-size: clamp(1.4rem, 2.6vw, 1.9rem); font-weight: 800; line-height: 1.1; color: #fff; }
    .ai-card .product-kicker { margin-top: 12px; }
    .ai-card .product-kicker + h3 { margin-top: 4px; }
    .ai-card-text { margin-top: 10px; font-size: 15px; line-height: 1.55; color: #c9cbcf; max-width: 34em; }
    .ai-outcome { margin-top: 16px; font-size: 15px; color: #fff; }
    .ai-outcome .num { font-size: 2.2rem; color: var(--yellow); margin-right: 6px; vertical-align: -4px; }
    .ai-outcome-text { margin-top: 14px; padding-left: 12px; border-left: 3px solid var(--yellow); font-size: 14px; font-weight: 600; color: #fff; }
    .ai-toggle { margin-top: 20px; display: inline-flex; align-items: center; gap: 10px; padding: 9px 16px; border-radius: 999px; border: 1.5px solid #fff; background: transparent; color: #fff; font: inherit; font-weight: 700; font-size: 14px; cursor: pointer; transition: background 150ms, color 150ms; }
    .ai-toggle:hover, .ai-toggle[aria-expanded="true"] { background: var(--yellow); border-color: var(--yellow); color: var(--ink); }
    .ai-toggle span { font-size: 18px; line-height: 1; }
    .ai-card-feature { margin-top: 8px; }
    @media (min-width: 900px) { .ai-card-feature { grid-template-columns: 1.15fr 1fr; align-items: center; } }
    .ai-card-feature .ai-card-media { border-radius: 0; border: 0; box-shadow: none; }
    @media (min-width: 900px) { .ai-card-feature .ai-card-body { padding: 32px 36px; } }
    .ai-grid { margin-top: 20px; display: grid; gap: 20px; }
    @media (min-width: 900px) { .ai-grid { grid-template-columns: 1fr 1fr; } }
    .ai-mini { padding: 22px; background: #14161a; border-bottom: 1px solid #2c2f35; display: flex; align-items: center; }
    @media (min-width: 900px) { .ai-mini { min-height: 118px; } .ai-grid .ai-card { grid-template-rows: auto 1fr; } }
    .card-stack { margin-top: 14px; line-height: 1.55; }
    .pilot-note { margin-top: 24px; padding-top: 16px; border-top: 1px solid #41444a; color: #c9cbcf; font-size: 14px; }
    .pilot-note strong { color: #fff; }
    .marker { background: linear-gradient(transparent 56%, var(--yellow) 56%); color: inherit; font-weight: 700; }
    .section-dark .marker { color: var(--ink); background: var(--yellow); padding-inline: 0.12em; box-decoration-break: clone; }
    .ai-panel { margin-top: 16px; padding: 28px 0 8px; border-top: 2px solid var(--yellow); animation: ai-fade 200ms ease; }
    .ai-panel[hidden] { display: none; }
    .ai-panel .flow { margin-top: 18px; }
    .ai-panel-lead { font-size: 15px; line-height: 1.6; color: #c9cbcf; max-width: 52em; }
    .ai-panel-lead strong { color: #fff; }
    @keyframes ai-fade { from { opacity: 0; } to { opacity: 1; } }
    @media (prefers-reduced-motion: reduce) { .ai-panel { animation: none; } }

    /* Expertise at a glance */
    .glance { padding: 28px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
    .glance-title { font-size: 13px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--blue); }
    .glance-grid { margin-top: 18px; display: grid; gap: 24px 32px; grid-template-columns: 1fr; }
    @media (min-width: 640px) { .glance-grid { grid-template-columns: 1fr 1fr; } }
    @media (min-width: 1024px) { .glance-grid { grid-template-columns: 1.25fr 1fr 1fr 1fr; } }
    .glance-label { font-size: 12px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); margin-bottom: 10px; }
    .glance-col ul { list-style: none; padding: 0; margin: 0; }
    .glance-platforms ul { display: grid; gap: 6px; }
    .glance-plat { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; padding: 6px 0; border-bottom: 1px dashed var(--line); font-size: 14px; }
    .glance-plat-name { font-weight: 600; color: #3a3d42; }
    .glance-tier { font-size: 12px; color: var(--muted); white-space: nowrap; }
    .glance-primary { padding: 8px 12px; border: 0; border-radius: 10px; background: var(--ink); }
    .glance-primary .glance-plat-name { color: #fff; font-weight: 800; font-size: 15px; }
    .glance-primary .glance-tier { color: var(--yellow); font-weight: 700; }
    .glance-second .glance-plat-name { color: var(--ink); font-weight: 700; }
    .glance-list { display: grid; gap: 7px; }
    .glance-list li { position: relative; padding-left: 16px; font-size: 14px; line-height: 1.4; color: #2b2e33; }
    .glance-list li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 7px; height: 7px; border-radius: 2px; background: var(--blue); }
    .glance-list .glance-strong { font-weight: 800; color: var(--ink); }
    .glance-list .glance-strong::before { background: var(--yellow); box-shadow: 0 0 0 1px var(--ink); }

    /* Final logo and platform polish */
    .marquee-note { margin: -18px auto 0; padding-bottom: 8px; text-align: center; font-size: 12.5px; color: var(--muted); }
    .plat-icon { display: inline-flex; width: 14px; height: 14px; flex-shrink: 0; }
    .plat-icon svg { width: 100%; height: 100%; fill: currentColor; }
    .plats-lg .plat-icon { width: 15px; height: 15px; }
    .glance-plat-name { display: inline-flex; align-items: center; gap: 8px; }
    .edu li { flex-direction: row; align-items: center; gap: 14px; padding-left: 0; border-left: 0; }
    .edu li > div { display: flex; flex-direction: column; }
    .edu-logo { height: 30px; width: auto; max-width: 120px; object-fit: contain; flex-shrink: 0; }
    .tl-period { font-size: 1.2rem; }

    /* System diagrams in AI cards */
    .ai-mini { display: block; padding: 18px 20px; }
    @media (min-width: 900px) { .ai-mini { min-height: 0; } }
    .ai-panel-diagram { max-width: 760px; padding: 24px; border-radius: 16px; background: #1a1d22; border: 1px solid #2c2f35; }
    .ai-panel-diagram + .ai-panel-lead { margin-top: 18px; }

    /* Creative OS screenshots */
    .ai-shot-preview { padding: 18px 20px 0; background: #14161a; border-bottom: 1px solid #2c2f35; }
    .ai-shot-preview .browser { border-radius: 10px 10px 0 0; border-bottom: 0; box-shadow: none; max-height: 220px; overflow: hidden; }
    .os-evidence { margin-top: 22px; display: grid; gap: 22px; }
    @media (min-width: 900px) { .os-evidence { grid-template-columns: 0.85fr 1.15fr; align-items: start; } }
    .os-evidence figure { margin: 0; }
    .os-evidence figcaption { margin-top: 10px; font-size: 14px; line-height: 1.5; color: #b7b9be; }
    .os-evidence figcaption strong { display: block; color: #fff; }
    .os-crop { aspect-ratio: 16 / 9; overflow: hidden; background: #191919; }
    .os-crop img { width: 100%; height: 100%; object-fit: cover; object-position: left top; }
  </style>
</body>
