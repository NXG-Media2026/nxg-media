---
import '../styles/global.css';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SEOHead from '../components/SEOHead.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import { siteConfig } from '../data/site';
import portrait from '../assets/images/Founder/joost-profielfoto-portrait.webp';
import thumbCat from '../assets/images/testimonials/cathowell-8loops-thumb.webp';
import thumbSomnox from '../assets/images/testimonials/somnox-thumb.webp';
import thumbNarayan from '../assets/images/testimonials/narayan-eetclubnl-thumb.webp';

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logos/*.{webp,avif,png,jpg}', { eager: true });
const logos = Object.entries(logoFiles)
  .filter(([path]) => /logo/i.test(path.split('/').pop()!))
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/, '');
    const name = filename.replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim();
    return { src: mod.default, alt: name };
  });

const PENDING = null;

const vimeoThumb = (hash: string) => `https://i.vimeocdn.com/video/${hash}-d_640?region=us`;

const ads = [
  { id: '879783232', brand: 'Stekkies', goal: 'Subscriptions', metric: PENDING, thumb: vimeoThumb('1746468935-854ca36667954722c5be77923bb0b67e8c42efc4d97ae47447ffd55883b358d2') },
  { id: '879781428', brand: 'Posivino', goal: 'Unboxing / sales', metric: PENDING, thumb: vimeoThumb('1746466363-5db09dba52cb1068a9ef88722c6054866d7d97c749602315c03d960c213456d6') },
  { id: '879784334', brand: 'HeyAreYouOkay', goal: 'Sales', metric: PENDING, thumb: vimeoThumb('1746470391-a8c3962d85191eee6e3a777de24fe2fc63231ddcde5e3f7a717b80fe6dd7d531') },
  { id: '879779883', brand: 'Stekkies', goal: 'Subscriptions', metric: PENDING, thumb: vimeoThumb('1746464431-b361b0ea64f584f9c3f98509ea2787fdc8961a29d4f2bb3620de4c818d83bdf0') },
  { id: '879780426', brand: 'Happy with Yoga', goal: 'Sales', metric: PENDING, thumb: vimeoThumb('1746465095-2d823b8c6fe2e41dd7120f75cd7121d4675f80aee4ea5fd45f8a326255bdfddd') },
  { id: '879782682', brand: 'MCM Research', goal: 'Job applicants', metric: PENDING, thumb: vimeoThumb('1746467737-ffbd319f522e6753576797f0b103f080ffddc65a893c2b77955638fdaf03dfec') },
];

const results = [
  { client: 'Happy With Yoga', sector: 'Online yoga', result: 'Q4 2025: 4,084 leads at €1.08 CPL, 495 sales at €7.31.', note: 'Client since 2022.', role: PENDING },
  { client: 'Real Estate Masterclass', sector: 'Real estate education', result: '~€30k/month on Meta and TikTok, average 6.5x ROAS, peak 12.5x.', role: PENDING },
  { client: 'Somnox', sector: 'Sleep technology', result: 'Meta from €0 to €20k/month at ~4.0x ROAS.', role: PENDING },
  { client: 'MCM Research', sector: 'Recruitment', result: '4,000+ leads and 750 applicants across NL and BE.', role: PENDING },
  { client: 'Youlife', sector: PENDING, result: '~€10k/month online product revenue, 6 products launched.', role: PENDING },
];

const testimonials = [
  { id: '879049102', name: 'Cat Howell', role: 'Author and agency owner', thumb: thumbCat },
  { id: '879049149', name: 'Julian Jagtenberg', role: 'Somnox', thumb: thumbSomnox },
  { id: '879049124', name: 'Narayan', role: 'Nederland Eet Groep (now eetclub.nl)', thumb: thumbNarayan },
];

const aiSystems = [
  { area: 'Client communication', before: 'Scattered mails and notes', now: 'Every mail and call auto-filed per client in Notion, with a summary', result: 'Nothing falls through, full context in a minute', status: 'In use' },
  { area: 'Daily task mail', before: 'Manual morning triage', now: 'Automatic prioritised task mail', result: 'A clear top 3 each day', status: 'In use' },
  { area: 'Client status', before: 'Kept in my head', now: 'Auto-updated status per client', result: 'I see who needs attention early', status: 'In use' },
  { area: 'KPIs', before: 'Vague or shifting', now: 'Fixed at onboarding', result: 'Reporting follows the agreed KPIs', status: 'In use' },
  { area: 'Creative analysis', before: 'Manual review', now: 'Gemini scores hook and structure next to performance data', result: 'Faster understanding of why winners win', status: 'In use' },
  { area: 'Creative strategist agent', before: 'Concepts from scratch', now: 'Concepts based on proven winners', result: 'More grounded test variants per week', status: 'In development' },
];

const pillars = [
  { title: 'Performance Marketing', body: 'Meta Ads, media buying, acquisition, funnels, CRO and optimisation.' },
  { title: 'Creative & Growth', body: 'Creative strategy, experiments, positioning and offer development.' },
  { title: 'AI & Automation', body: 'Self-built AI systems, n8n, dashboards and process improvement.' },
  { title: 'Business & Commercial', body: 'Sales, business development, client relationships, negotiation and entrepreneurship.' },
];

const commercialSkills = [
  { title: 'Business development & sales', body: 'Prospecting, lead generation, discovery calls, proposals, pitching, negotiation and closing new clients.' },
  { title: 'Client relationship management', body: 'Long-term partnerships, client communication, expectation management, reporting and retention.' },
  { title: 'Commercial strategy', body: 'Developing service offerings and pricing, spotting growth opportunities and connecting marketing decisions to profitability.' },
  { title: 'Entrepreneurship', body: 'Running an independent business, balancing client delivery with sales and deciding where time and budget go.' },
  { title: 'Project & stakeholder management', body: 'Coordinating campaigns and projects with clients, developers, creatives and external collaborators.' },
  { title: 'Consultative problem solving', body: 'Understanding the business problem first, then turning it into a practical marketing and acquisition plan.' },
];

const commercialHighlights = [
  'Personally closed 8 new client deals in 2026.',
  'Long-term client partnerships, including Happy With Yoga since 2022.',
];

const linkedinUrl: string | null = null;
---

<!doctype html>
<html lang="en">
<head>
  <SEOHead
    title="Joost van Putten | Performance Marketer"
    description="Performance marketer focused on Meta Ads, creative strategy and AI systems. Selected ads, results and client feedback."
    canonical={`${siteConfig.url}/joost`}
    noindex={true}
    locale="en"
  />
</head>
<body class="bg-bg text-text font-body antialiased">

  <header class="border-b border-border">
    <div class="max-w-5xl mx-auto px-4 md:px-6 h-14 flex items-center">
      <span class="font-heading text-xl font-extrabold tracking-tight uppercase">Joost van Putten</span>
    </div>
  </header>

  <main>
    {/* 1. Hero */}
    <section class="py-12 md:py-20">
      <div class="max-w-5xl mx-auto px-4 md:px-6 grid gap-8 md:grid-cols-[1fr_280px] md:items-center">
        <div>
          <h1 class="font-heading uppercase text-5xl md:text-7xl leading-[0.95]">Joost van Putten</h1>
          <p class="mt-4 text-lg md:text-xl font-semibold text-primary">
            Performance Marketer · Meta Ads · Creative Strategy · AI Systems
          </p>
          <p class="mt-5 max-w-xl text-lg leading-relaxed">
            I combine hands-on marketing expertise with the commercial judgment of an entrepreneur
            and the technical curiosity to build practical AI systems.
          </p>
          <ul class="mt-6 flex flex-wrap gap-2 text-sm font-semibold">
            <li class="stat">8+ years</li>
            <li class="stat">Founder since 2018</li>
            <li class="stat"><span class="pending">Metric pending</span> in managed Meta spend</li>
            <li class="stat">50+ clients</li>
          </ul>
          <p class="mt-6 text-text-muted">Based in Valencia, working remotely for NL/EU teams.</p>
        </div>
        <Image
          src={portrait}
          alt="Joost van Putten"
          width={560}
          class="w-48 md:w-full aspect-[4/5] object-cover rounded-image"
          loading="eager"
        />
      </div>
    </section>

    {/* Expertise pillars */}
    <section class="pb-12 md:pb-16" aria-labelledby="pillars-title">
      <div class="max-w-5xl mx-auto px-4 md:px-6">
        <p class="eyebrow text-primary">Expertise</p>
        <h2 id="pillars-title" class="section-title">What I bring</h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
          {pillars.map((p, i) => (
            <article class="card p-5">
              <span class="text-sm font-extrabold text-primary">0{i + 1}</span>
              <h3 class="mt-1 font-heading uppercase text-xl leading-tight">{p.title}</h3>
              <p class="mt-2 text-sm text-text-muted">{p.body}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* 2. Selected ads */}
    <section class="py-12 md:py-16 bg-bg-alt" aria-labelledby="ads-title">
      <div class="max-w-5xl mx-auto px-4 md:px-6">
        <p class="eyebrow text-primary">Work</p>
        <h2 id="ads-title" class="section-title">Selected ads</h2>
        <div class="mt-8 grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-6">
          {ads.map((ad) => (
            <article class="card overflow-hidden">
              <button
                type="button"
                class="facade aspect-[9/16]"
                data-vimeo={ad.id}
                aria-label={`Play ${ad.brand} ad`}
              >
                <img src={ad.thumb} alt="" width="640" height="1138" loading="lazy" decoding="async" />
                <span class="play" aria-hidden="true"></span>
              </button>
              <div class="p-3 md:p-4">
                <h3 class="font-heading uppercase text-lg leading-tight">{ad.brand}</h3>
                <p class="text-sm text-text-muted">{ad.goal}</p>
                <p class="mt-2 text-sm font-semibold">
                  {ad.metric ?? <span class="pending">Metric pending</span>}
                </p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* 3. Selected results */}
    <section class="py-12 md:py-16" aria-labelledby="results-title">
      <div class="max-w-5xl mx-auto px-4 md:px-6">
        <p class="eyebrow text-primary">Results</p>
        <h2 id="results-title" class="section-title">Selected results</h2>
        <div class="mt-8 grid gap-4 md:grid-cols-2">
          {results.map((r) => (
            <article class="card p-5 md:p-6">
              <div class="flex flex-wrap items-baseline justify-between gap-2">
                <h3 class="font-heading uppercase text-2xl leading-tight">{r.client}</h3>
                <span class="text-xs font-semibold uppercase tracking-wide text-text-muted">
                  {r.sector ?? <span class="pending">Sector pending</span>}
                </span>
              </div>
              <p class="mt-3 font-semibold">{r.result}</p>
              {r.note && <p class="mt-1 text-sm text-text-muted">{r.note}</p>}
              <p class="mt-3 text-sm">
                <span class="text-text-muted">My role: </span>
                {r.role ?? <span class="pending">Role pending</span>}
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* Experience: entrepreneurship */}
    <section class="py-12 md:py-16 border-t border-border" aria-labelledby="experience-title">
      <div class="max-w-5xl mx-auto px-4 md:px-6">
        <p class="eyebrow text-primary">Experience</p>
        <h2 id="experience-title" class="section-title">Running my own business</h2>

        <div class="mt-8 grid gap-8 md:grid-cols-[1fr_1.4fr]">
          <div>
            <h3 class="font-heading uppercase text-2xl leading-tight">Founder, NXG Media</h3>
            <p class="text-sm font-semibold text-text-muted">2018 to now · Independent marketing business</p>
            <p class="mt-4 leading-relaxed">
              I founded NXG Media in 2018 and have built and run it for more than eight years.
              Next to running campaigns myself, I bring in clients, write proposals, set pricing
              and carry the commercial results of the business. That puts every campaign decision
              in the context of the client's revenue, margins and business model.
            </p>
            <ul class="mt-6 space-y-2">
              {commercialHighlights.map((h) => (
                <li class="highlight">{h}</li>
              ))}
            </ul>
          </div>
          <dl class="grid gap-4 sm:grid-cols-2">
            {commercialSkills.map((s) => (
              <div class="card p-4">
                <dt class="font-heading uppercase text-lg leading-tight">{s.title}</dt>
                <dd class="mt-1 text-sm text-text-muted">{s.body}</dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    {/* 4. What clients say */}
    <section class="py-12 md:py-16 bg-bg-alt" aria-labelledby="clients-title">
      <div class="max-w-5xl mx-auto px-4 md:px-6">
        <p class="eyebrow text-primary">Feedback</p>
        <h2 id="clients-title" class="section-title">What clients say</h2>
        <div class="mt-8 grid gap-6 md:grid-cols-3">
          {testimonials.map((t) => (
            <article class="card overflow-hidden">
              <button
                type="button"
                class="facade aspect-video"
                data-vimeo={t.id}
                aria-label={`Play testimonial from ${t.name}`}
              >
                <Image src={t.thumb} alt="" width={640} loading="lazy" />
                <span class="play" aria-hidden="true"></span>
              </button>
              <div class="p-4">
                <h3 class="font-heading uppercase text-lg leading-tight">{t.name}</h3>
                <p class="text-sm text-text-muted">{t.role}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* 5. Logo row */}
    <LogoMarquee logos={logos} label="Brands I have worked with" />

    {/* 6. How I work with AI */}
    <section class="py-12 md:py-16" aria-labelledby="ai-title">
      <div class="max-w-5xl mx-auto px-4 md:px-6">
        <p class="eyebrow text-primary">Systems</p>
        <h2 id="ai-title" class="section-title">How I work with AI</h2>
        <p class="mt-3 max-w-2xl text-text-muted">
          Systems I use day to day for client work and creative analysis.
        </p>

        <div class="mt-8 grid gap-4">
          {aiSystems.map((s) => (
            <article class="card p-5 md:p-6">
              <div class="flex flex-wrap items-center justify-between gap-2">
                <h3 class="font-heading uppercase text-xl leading-tight">{s.area}</h3>
                <span class={s.status === 'In use' ? 'badge badge-live' : 'badge badge-dev'}>{s.status}</span>
              </div>
              <dl class="mt-4 grid gap-3 md:grid-cols-3 text-sm">
                <div><dt class="flow-label">Before</dt><dd>{s.before}</dd></div>
                <div><dt class="flow-label">Now</dt><dd>{s.now}</dd></div>
                <div><dt class="flow-label">Result</dt><dd class="font-semibold">{s.result}</dd></div>
              </dl>
            </article>
          ))}
        </div>

        <p class="mt-6 font-semibold">
          Measured impact: <span class="pending">Metric pending</span> hours saved per week.
        </p>

        <div class="mt-6 grid gap-4 md:grid-cols-3">
          {[1, 2, 3].map((n) => (
            <div class="screenshot-slot aspect-video">Screenshot {n} pending</div>
          ))}
        </div>
      </div>
    </section>

    {/* 7. About + contact */}
    <section class="py-12 md:py-16 bg-bg-dark text-text-inverse" aria-labelledby="about-title" id="contact">
      <div class="max-w-3xl mx-auto px-4 md:px-6">
        <p class="eyebrow light">About</p>
        <h2 id="about-title" class="section-title">About and contact</h2>
        <div class="mt-6 space-y-4 text-white/85 leading-relaxed">
          <p>
            I am a hands-on performance marketer with 8+ years of experience in paid social, mostly Meta Ads.
            Since founding NXG Media in 2018 I have also handled sales, proposals, pricing and long-term client relationships myself.
            I have worked with 50+ clients, including subscription and e-commerce brands, education companies and recruitment.
            I am happy to build and optimise campaigns myself, and I bring the commercial view of someone who has run a business.
            I am based in Valencia and work remotely with teams in the Netherlands and across Europe.
          </p>
        </div>
        <ul class="mt-8 grid gap-3 sm:grid-cols-2">
          <li>
            <a class="contact-link" href="mailto:info@nxg-media.com">
              <span class="flow-label text-white/60">Email</span>
              info@nxg-media.com
            </a>
          </li>
          <li>
            {linkedinUrl ? (
              <a class="contact-link" href={linkedinUrl} target="_blank" rel="noopener noreferrer">
                <span class="flow-label text-white/60">LinkedIn</span>
                View profile
              </a>
            ) : (
              <div class="contact-link">
                <span class="flow-label text-white/60">LinkedIn</span>
                <span class="pending">Link pending</span>
              </div>
            )}
          </li>
        </ul>
      </div>
    </section>
  </main>

  <footer class="py-6 text-center text-xs text-text-muted">© {new Date().getFullYear()} Joost van Putten</footer>

  <script is:inline>
    document.querySelectorAll('.facade[data-vimeo]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var iframe = document.createElement('iframe');
        iframe.src = 'https://player.vimeo.com/video/' + btn.dataset.vimeo + '?autoplay=1&dnt=1&title=0&byline=0&portrait=0';
        iframe.allow = 'autoplay; fullscreen; picture-in-picture';
        iframe.allowFullscreen = true;
        iframe.title = btn.getAttribute('aria-label') || 'Video';
        iframe.className = btn.className.replace('facade', 'facade-frame');
        btn.replaceWith(iframe);
      }, { once: true });
    });
  </script>

  <style is:global>
    .section-title {
      font-family: 'Barlow Condensed', 'Arial Narrow', Impact, sans-serif;
      text-transform: uppercase;
      font-size: clamp(2rem, 5vw, 3rem);
      line-height: 1;
      margin-top: 0.25rem;
    }
    .stat {
      border: 1px solid var(--color-border);
      border-radius: 999px;
      padding: 0.35rem 0.85rem;
      background: var(--color-bg);
    }
    .card {
      background: var(--color-bg);
      border: 1px solid var(--color-border);
      border-radius: 12px;
    }
    .facade,
    .facade-frame {
      position: relative;
      display: block;
      width: 100%;
      border: 0;
      padding: 0;
      background: var(--color-bg-dark);
    }
    .facade { cursor: pointer; }
    .facade img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .play {
      position: absolute;
      left: 50%;
      top: 50%;
      width: 56px;
      height: 56px;
      transform: translate(-50%, -50%);
      border-radius: 999px;
      background: var(--color-accent);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
      transition: transform 150ms;
    }
    .play::after {
      content: '';
      position: absolute;
      left: 22px;
      top: 17px;
      border-style: solid;
      border-width: 11px 0 11px 17px;
      border-color: transparent transparent transparent var(--color-text);
    }
    .facade:hover .play,
    .facade:focus-visible .play { transform: translate(-50%, -50%) scale(1.08); }
    .facade:focus-visible { outline: 3px solid var(--color-primary); outline-offset: -3px; }
    .pending {
      display: inline-block;
      padding: 0.05rem 0.45rem;
      border: 1px dashed #c2410c;
      border-radius: 4px;
      background: #fff7ed;
      color: #9a3412;
      font-size: 0.8em;
      font-weight: 700;
      letter-spacing: 0.02em;
    }
    .badge {
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
      padding: 0.25rem 0.6rem;
      border-radius: 999px;
    }
    .badge-live { background: var(--color-primary); color: #fff; }
    .badge-dev { background: var(--color-accent); color: var(--color-text); }
    .flow-label {
      display: block;
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 1px;
      text-transform: uppercase;
      color: var(--color-text-muted);
      margin-bottom: 0.15rem;
    }
    .screenshot-slot {
      display: flex;
      align-items: center;
      justify-content: center;
      border: 2px dashed var(--color-border);
      border-radius: 12px;
      color: var(--color-text-muted);
      font-size: 0.875rem;
      font-weight: 600;
    }
    .contact-link {
      display: block;
      padding: 1rem 1.25rem;
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 12px;
      color: #fff;
      font-weight: 600;
      text-decoration: none;
      transition: border-color 150ms;
    }
    a.contact-link:hover { border-color: var(--color-accent); }
    .highlight {
      padding: 0.6rem 0.9rem;
      border-left: 4px solid var(--color-accent);
      background: var(--color-bg-alt);
      font-weight: 600;
      font-size: 0.95rem;
    }
  </style>
</body>
</html>
