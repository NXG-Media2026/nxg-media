const creativeFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/portfolio/*.{jpg,jpeg,png,webp}', { eager: true });
const media = (slug?: string) => {
  if (!slug) return {};
  const poster = creativeImage(slug + '-poster');
  if (poster) return { video: { src: '/portfolio/video/' + slug + '.mp4', poster } };
  const image = creativeImage(slug);
  return image ? { image } : {};
};
const creativeImage = (slug: string) =>
  Object.entries(creativeFiles).find(([p]) => p.split('/').pop()!.replace(/\.\w+$/, '') === slug)?.[1].default;

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logos/*.{webp,avif,png,jpg}', { eager: true });
const logos = Object.entries(logoFiles)
  .filter(([path]) => /logo/i.test(path.split('/').pop()!))
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/, '');
    const name = filename.replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim();
    return { src: mod.default, alt: name };
  });

