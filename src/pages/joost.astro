    /* Nav */
    .pf-nav { position: sticky; top: 0; z-index: 50; background: rgba(255,255,255,0.88); backdrop-filter: saturate(1.4) blur(12px); -webkit-backdrop-filter: saturate(1.4) blur(12px); border-bottom: 1px solid var(--line); }
    .pf-nav-inner { display: flex; align-items: center; gap: 12px; height: 56px; }
    .pf-brand { font-weight: 800; color: var(--ink); text-decoration: none; letter-spacing: -0.01em; white-space: nowrap; }
    .pf-brand-full { display: none; }
    @media (min-width: 640px) { .pf-brand-full { display: inline; } .pf-brand-short { display: none; } }
    .pf nav { margin-left: auto; overflow-x: auto; scrollbar-width: none; }
    .pf-links { display: flex; gap: 2px; list-style: none; margin: 0; padding: 0; }
    .pf-links a { display: block; padding: 6px 6px; font-size: 13px; font-weight: 600; color: var(--muted); text-decoration: none; border-radius: 999px; white-space: nowrap; transition: color 150ms, background 150ms; }
    .pf-links a:hover { color: var(--ink); }
    .pf-links a[aria-current] { color: var(--ink); background: var(--tint); }
    .pf-cv-btn { display: none; padding: 7px 14px; border-radius: 999px; background: var(--ink); color: #fff; font-size: 14px; font-weight: 700; text-decoration: none; }
    @media (min-width: 768px) { .pf-cv-btn { display: inline-block; } .pf-links a { padding: 6px 12px; font-size: 14px; } }

    /* Hero */
    .hero { padding: 40px 0 0; }
    .hero-grid { display: grid; gap: 32px; align-items: end; }
    @media (min-width: 900px) { .hero { padding-top: 72px; } .hero-grid { grid-template-columns: 1.25fr 1fr; gap: 56px; } }
    .kicker-sub { margin-top: 6px; font-size: 14px; font-weight: 600; color: var(--muted); }
    .kicker { font-size: 13px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--blue); }
    .hero-name { margin-top: 14px; font-size: clamp(3rem, 11vw, 6.5rem); line-height: 0.92; font-weight: 800; letter-spacing: -0.045em; }
    .hero-lead { margin-top: 24px; max-width: 34em; font-size: 1.125rem; line-height: 1.6; color: #2b2e33; }
    .hero-actions { margin-top: 28px; display: flex; flex-wrap: wrap; gap: 10px; }
    .hero-meta { margin-top: 24px; display: grid; gap: 10px; font-size: 14px; color: var(--muted); }
    .hero-places, .langs { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 6px 18px; }
    .hero-places li { position: relative; padding-left: 14px; }
    .hero-places li::before { content: ''; position: absolute; left: 0; top: 0.55em; width: 6px; height: 6px; border-radius: 999px; background: var(--blue); }
    .langs li { display: inline-flex; align-items: center; gap: 7px; color: var(--ink); font-weight: 600; }
    .lang-level { font-weight: 400; color: var(--muted); }
    .lang-flag { display: inline-flex; width: 20px; height: 14px; border-radius: 3px; overflow: hidden; box-shadow: 0 0 0 1px rgba(0,0,0,0.08); flex-shrink: 0; }
    .lang-flag svg { width: 100%; height: 100%; display: block; }
    .hero-photo { margin: 0; border-radius: 20px; overflow: hidden; background: var(--tint); aspect-ratio: 4 / 5; max-height: 640px; }
    .hero-photo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; }
    @media (max-width: 899px) { .hero-photo { order: -1; aspect-ratio: 5 / 4; } }

    .figures { margin: 48px 0 0; display: grid; grid-template-columns: repeat(2, 1fr); border-top: 1px solid var(--line); }
    @media (min-width: 768px) { .figures { grid-template-columns: repeat(4, 1fr); } }
    .figures > div { padding: 22px 0 24px; border-bottom: 1px solid var(--line); }
    @media (min-width: 768px) { .figures > div { border-bottom: 0; padding-right: 16px; } .figures > div + div { padding-left: 20px; border-left: 1px solid var(--line); } }
    .figures dt { font-size: clamp(2.25rem, 5vw, 3.25rem); }
    .figures dd { margin: 6px 0 0; font-size: 14px; color: var(--muted); }

    /* Buttons */
    .btn { display: inline-flex; align-items: center; gap: 8px; padding: 12px 18px; border-radius: 999px; font-weight: 700; font-size: 15px; text-decoration: none; transition: transform 150ms, background 150ms, border-color 150ms; }
    .btn:hover { transform: translateY(-1px); }
    .btn-dark { background: var(--ink); color: #fff; }
    .btn-line { border: 1.5px solid var(--ink); color: var(--ink); }
    .btn-line:hover { background: var(--ink); color: #fff; }
    .btn-meta { font-size: 11px; font-weight: 800; letter-spacing: 0.06em; opacity: 0.6; }

    /* Sections */
    .section { padding: 72px 0; }
    @media (min-width: 900px) { .section { padding: 112px 0; } }
    .section-tint { background: var(--tint); }
    .section-dark { background: var(--ink); color: #f1f1ee; }
    .sec-head { max-width: 720px; margin-bottom: 40px; }
    .sec-head-row { max-width: none; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 20px; }
    .sec-index { font-size: 13px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--blue); }
    .section-dark .sec-index { color: #8db0ff; }
    .sec-head h2 { margin-top: 10px; font-size: clamp(2.1rem, 5vw, 3.5rem); line-height: 1; font-weight: 800; }
    .sec-intro { margin-top: 14px; font-size: 1.0625rem; line-height: 1.6; color: var(--muted); }
    .section-dark .sec-intro { color: #b7b9be; }

    /* Gallery */
    @media (min-width: 1024px) {
        }

    .facade, .facade-frame { position: relative; display: block; width: 100%; border: 0; padding: 0; background: #0d0f12; border-radius: 14px; overflow: hidden; }
    .facade { cursor: pointer; }
    .ratio-916 { aspect-ratio: 9 / 16; }
    .ratio-169 { aspect-ratio: 16 / 9; }
    .facade img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 400ms ease; }
    .facade:hover img { transform: scale(1.03); }
    .play { position: absolute; left: 50%; top: 50%; width: 56px; height: 56px; transform: translate(-50%, -50%); border-radius: 999px; background: var(--yellow); box-shadow: 0 6px 20px rgba(0,0,0,0.35); transition: transform 150ms; }
    .play::after { content: ''; position: absolute; left: 22px; top: 17px; border-style: solid; border-width: 11px 0 11px 17px; border-color: transparent transparent transparent var(--ink); }
    .facade:hover .play { transform: translate(-50%, -50%) scale(1.08); }
    @media (prefers-reduced-motion: reduce) { .facade img, .play, .btn { transition: none; } }

    /* Cases */
    .case-label { font-size: 12px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); margin: 18px 0 6px; }
    .case-label:first-child { margin-top: 0; }
    .ratio-45 { aspect-ratio: 4 / 5; }

    /* Figure scopes */
    .scope-legend { list-style: none; padding: 0; margin: 18px 0 0; display: flex; flex-wrap: wrap; gap: 8px; }
    .scope { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 10.5px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; line-height: 1.6; white-space: nowrap; }
    .scope-client { background: var(--ink); color: #fff; }
    .scope-campaign { background: #e6eeff; color: #0544c0; }
    .scope-ad { background: var(--yellow); color: var(--ink); }

    /* Flagship cases */
    .flag { padding: 56px 0; border-top: 1px solid var(--line); }
    @media (min-width: 900px) { .flag { padding: 88px 0; } }
    .flag-tint { background: var(--tint); border-top: 0; }
    .flag-head { display: flex; align-items: center; gap: 18px; }
    .flag-logo { width: auto; height: 44px; max-width: 120px; object-fit: contain; flex-shrink: 0; }
    @media (min-width: 768px) { .flag-logo { height: 56px; max-width: 150px; } }
    .flag-no { font-size: 12px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--blue); }
    .flag h3 { margin-top: 2px; font-size: clamp(1.75rem, 4.5vw, 3rem); font-weight: 800; line-height: 1.02; }
    .flag-alias { color: var(--muted); font-weight: 700; font-size: 0.6em; letter-spacing: -0.01em; }
    .flag-meta { margin-top: 6px; font-size: 14px; color: var(--muted); }
    .flag-intro { margin-top: 28px; display: grid; gap: 28px; }
    @media (min-width: 900px) { .flag-intro { grid-template-columns: 1.1fr 1fr; gap: 56px; align-items: start; } }
    .flag-lead { font-size: 1.125rem; line-height: 1.6; color: #2b2e33; max-width: 36em; }
    .totals { margin: 0; display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px 24px; }
    .totals dt { font-size: clamp(2.25rem, 5vw, 3.25rem); }
    .totals dd { margin: 8px 0 0; font-size: 13.5px; line-height: 1.4; color: var(--muted); display: flex; flex-direction: column; align-items: flex-start; gap: 6px; }
    .fine { margin-top: 18px; font-size: 13px; line-height: 1.55; color: var(--muted); max-width: 60em; }

    .ratio-34 { aspect-ratio: 3 / 4; }
    .ratio-11 { aspect-ratio: 1 / 1; }
    video.facade-frame { object-fit: cover; }

    .bands { margin-top: 40px; display: grid; gap: 16px; }
    .band { display: grid; gap: 24px; padding: 22px; border-radius: 18px; background: var(--tint); }
    @media (min-width: 1024px) { .band { grid-template-columns: 330px 1fr; gap: 40px; padding: 32px; align-items: start; } }
    .band-text { display: flex; flex-direction: column; align-items: flex-start; }
    .band-compact { background: transparent; border: 1.5px solid var(--line); }
    .band-side-note { font-size: 15px; line-height: 1.6; color: #3a3d42; max-width: 34em; }
    @media (min-width: 1024px) { .band-side-note { align-self: center; padding-left: 40px; border-left: 1px solid var(--line); } }
    @media (min-width: 1024px) { .band-compact { grid-template-columns: 330px 1fr; } }
    .band-gallery { display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 6px; align-items: flex-start; }
    .band-gallery > .ct { flex: 0 0 44%; scroll-snap-align: start; }
    .band-gallery > .ct-lg { flex-basis: 60%; }
    @media (min-width: 1024px) { .band-gallery { display: grid; grid-template-columns: 1.3fr 1fr 1fr; gap: 18px; overflow: visible; } }
    .band .ct figcaption { margin-top: 8px; }
    .band .ct-format { font-size: 13.5px; }

    .irvj-grid { display: grid; gap: 20px; }
    @media (min-width: 900px) { .irvj-grid { grid-template-columns: 0.62fr 1fr; gap: 28px; align-items: start; } }
    @media (max-width: 899px) { .irvj-grid > .ct { width: 72%; } }
    .irvj-squares { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px 18px; }

    .stage-tag { display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
    .stage-tag span { display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: 999px; background: var(--ink); color: #fff; font-size: 11px; letter-spacing: 0; }
    .band h4 { margin-top: 10px; font-size: 1.3rem; font-weight: 800; line-height: 1.2; }
    .stage-figures { margin: 18px 0 12px; display: grid; grid-template-columns: repeat(3, auto); gap: 14px; justify-content: start; }
    .stage-figures dt { font-size: clamp(1.6rem, 3.2vw, 2.1rem); }
    .stage-figures dd { margin: 4px 0 0; font-size: 12.5px; line-height: 1.3; color: var(--muted); max-width: 9em; }
    .stage-note { margin-top: 12px; font-size: 13.5px; line-height: 1.55; color: #3a3d42; }

    .flag-video { margin-top: 36px; display: grid; gap: 20px; align-items: center; grid-template-columns: minmax(0, 220px) 1fr; }
    .flag-video-text p { margin-top: 8px; font-size: 14px; line-height: 1.55; color: var(--muted); max-width: 30em; }
    @media (max-width: 559px) { .flag-video { grid-template-columns: 1fr 1fr; align-items: start; } }

    .wall-label { margin: 40px 0 14px; display: flex; align-items: center; gap: 10px; font-weight: 800; }
    .wall { display: grid; gap: 16px; grid-template-columns: repeat(2, 1fr); }
    @media (min-width: 1100px) { .wall { grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 22px; align-items: start; } }
    @media (max-width: 1099px) { .wall .ct-lg { grid-column: span 2; } }

    .rail { display: grid; grid-auto-flow: column; grid-auto-columns: 58%; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 8px; }
    .rail > * { scroll-snap-align: start; }
    @media (min-width: 640px) { .rail { grid-auto-columns: 34%; } }
    @media (min-width: 1024px) { .rail { grid-auto-flow: row; grid-template-columns: repeat(5, 1fr); overflow: visible; } }

    /* Creative tile */
    .ct { margin: 0; min-width: 0; }
    .ct-media { position: relative; display: block; border-radius: 14px; overflow: hidden; background: #e9e9e4; }
    .ct-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
    .ct-media.ct-fallback { aspect-ratio: 1 / 1; }
    .ct-fallback + figcaption .ct-format { display: none; }
    .ct-fallback + figcaption .ct-metrics { margin-top: 0; }
    .ct-fallback { display: flex; flex-direction: column; justify-content: space-between; padding: 16px; text-decoration: none; color: var(--ink); background: #fff; border: 1px solid var(--line); transition: border-color 150ms, transform 150ms; }
    .ct-fallback:hover { border-color: var(--ink); transform: translateY(-2px); }
    .ct-fallback .ct-fallback-logo { position: static; width: auto; height: 36px; max-width: 70%; object-fit: contain; object-position: left; }
    .ct-fallback-format { font-size: clamp(1rem, 2vw, 1.25rem); font-weight: 800; line-height: 1.15; letter-spacing: -0.01em; }
    .ct-fallback-cta { font-size: 12.5px; font-weight: 700; color: var(--blue); }
    .ct-lg .ct-fallback-format { font-size: clamp(1.4rem, 3vw, 2rem); }
    .ct figcaption { margin-top: 10px; }
    .ct-format { display: block; font-weight: 800; font-size: 15px; line-height: 1.3; }
    .ct-metrics { margin: 10px 0 0; display: flex; flex-wrap: wrap; gap: 6px; }
    .ct-metrics > div { display: flex; align-items: baseline; gap: 5px; padding: 4px 9px; border-radius: 6px; background: var(--yellow); }
    .ct-metrics dt { font-weight: 800; font-size: 14px; }
    .ct-metrics dd { margin: 0; font-size: 12px; color: #3a3d42; }
    .ct-lg .ct-metrics dt { font-size: 18px; }
    .ct-note { margin-top: 8px; font-size: 13px; line-height: 1.5; color: var(--muted); }
    .ct-link { display: inline-block; margin-top: 8px; font-size: 13px; font-weight: 700; color: var(--blue); text-decoration: none; }

    /* More work + earlier */
    .more { padding-top: 72px; }
    .more-head h3, .earlier-title { font-size: clamp(1.5rem, 3vw, 2rem); font-weight: 800; }
    .more-head p { margin-top: 8px; color: var(--muted); }
    .more-grid { margin-top: 24px; display: grid; grid-template-columns: repeat(2, 1fr); gap: 28px 16px; }
    @media (min-width: 1024px) { .more-grid { grid-template-columns: repeat(4, 1fr); gap: 24px; } }
    .more-brand { height: 28px; margin-bottom: 10px; display: flex; align-items: center; }
    .more-logo { height: 26px; width: auto; max-width: 110px; object-fit: contain; }
    .earlier { padding-top: 72px; }
    .earlier-grid { margin-top: 20px; display: grid; gap: 0; border-top: 1px solid var(--line); }
    @media (min-width: 900px) { .earlier-grid { grid-template-columns: repeat(2, 1fr); } .earlier-item + .earlier-item { border-left: 1px solid var(--line); padding-left: 28px; } .earlier-item { padding-right: 28px; } }
    .earlier-item { padding: 24px 0; border-bottom: 1px solid var(--line); }
    @media (min-width: 900px) { .earlier-item { border-bottom: 0; } }
    .earlier-item h4 { font-size: 1.25rem; font-weight: 800; }
    .earlier-text { margin-top: 10px; font-size: 14.5px; line-height: 1.55; color: #3a3d42; }
    .earlier-figures { margin: 16px 0 0; display: grid; grid-template-columns: repeat(3, auto); gap: 12px; justify-content: start; }
    .earlier-figures dt { font-size: 1.6rem; }
    .earlier-figures dd { margin: 4px 0 0; font-size: 12px; line-height: 1.3; color: var(--muted); max-width: 8em; }
    .integrity { margin-top: 36px; padding-top: 18px; border-top: 1px solid var(--line); }
    @media (min-width: 900px) { .flow.flow-3 { grid-template-columns: repeat(3, 1fr); } }
    .section-dark .case-label { color: #8d9097; }
    .ticks { list-style: none; padding: 0; margin: 0; display: grid; gap: 8px; }
    .ticks li { position: relative; padding-left: 20px; line-height: 1.55; }
    .ticks li::before { content: ''; position: absolute; left: 0; top: 0.6em; width: 8px; height: 2px; background: var(--blue); }
    .section-dark .ticks li::before { background: var(--yellow); }
    .also { margin-top: 28px; font-size: 14px; line-height: 1.7; color: var(--muted); }
    .also span { font-weight: 800; color: var(--ink); }

    /* Testimonials */
    .voices { display: grid; gap: 20px; }
    @media (min-width: 900px) { .voices { grid-template-columns: 1.6fr 1fr; } .voice-lead { grid-row: span 2; } }
    .voice { margin: 0; }
    .voice figcaption { margin-top: 10px; font-size: 15px; color: var(--muted); }
    .voice figcaption strong { color: var(--ink); }

    /* AI */
    .legend { list-style: none; padding: 0; margin: 20px 0 0; display: flex; flex-wrap: wrap; gap: 8px 20px; font-size: 14px; color: #b7b9be; }
    .status { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 11px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; margin-right: 6px; }
    .status-live { background: #1f8f5f; color: #fff; }
    .status-pilot { background: var(--yellow); color: var(--ink); }
    .project { padding: 40px 0; border-top: 1px solid #2c2f35; }
    .project-head h3 { margin-top: 14px; font-size: clamp(1.75rem, 4vw, 2.75rem); font-weight: 800; line-height: 1.05; color: #fff; }
    .project-lead { margin-top: 14px; max-width: 46em; font-size: 1.0625rem; line-height: 1.6; color: #c9cbcf; }
    .flow { list-style: none; padding: 0; margin: 32px 0 0; display: grid; gap: 12px; counter-reset: none; }
    @media (min-width: 900px) { .flow { grid-template-columns: repeat(5, 1fr); gap: 0; } .flow-4 { grid-template-columns: repeat(4, 1fr); } }
    .flow li { position: relative; display: flex; flex-direction: column; gap: 6px; padding: 18px; background: #1a1d22; border-radius: 12px; font-size: 14px; line-height: 1.5; color: #b7b9be; }
    @media (min-width: 900px) {
      .flow li { border-radius: 0; border-right: 1px solid #2c2f35; }
      .flow li:first-child { border-radius: 12px 0 0 12px; }
      .flow li:last-child { border-radius: 0 12px 12px 0; border-right: 0; }
      .flow li:not(:last-child)::after { content: '→'; position: absolute; right: -9px; top: 50%; transform: translateY(-50%); z-index: 1; color: var(--yellow); font-weight: 800; background: #1a1d22; line-height: 1; }
    }
    .flow strong { color: #fff; font-size: 15px; }
    .flow-no { font-family: 'Barlow Condensed', sans-serif; font-weight: 800; color: var(--yellow); font-size: 15px; }
    .gate { margin-top: auto; padding-top: 6px; font-style: normal; font-size: 12px; font-weight: 700; color: #8db0ff; }
    .stack { font-family: ui-monospace, 'SFMono-Regular', Consolas, monospace; font-size: 13px; color: #c9cbcf; }
    .stack.mt { margin-top: 24px; }
    .features { margin: 32px 0 0; display: grid; gap: 22px 40px; }
    @media (min-width: 768px) { .features { grid-template-columns: repeat(2, 1fr); } }
    @media (min-width: 1024px) { .features { grid-template-columns: repeat(3, 1fr); } }
    .features dt { font-weight: 800; color: #fff; }
    .features dd { margin: 4px 0 0; font-size: 15px; line-height: 1.55; color: #b7b9be; }

    /* Experience */
    .timeline { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
    .timeline > li { display: grid; gap: 8px; padding: 32px 0; border-bottom: 1px solid var(--line); }
    @media (min-width: 900px) { .timeline > li { grid-template-columns: 200px 1fr; gap: 48px; } }
    .tl-period { font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: 1.35rem; color: var(--blue); }
    .timeline h3 { font-size: 1.5rem; font-weight: 800; line-height: 1.15; }
    .tl-org { margin-top: 4px; font-weight: 600; color: var(--muted); }
    .tl-summary { margin: 12px 0 14px; line-height: 1.6; max-width: 46em; }
    .timeline .ticks { max-width: 50em; color: #2b2e33; }

    .commercial { margin-top: 72px; display: grid; gap: 28px; padding: 36px 24px; background: var(--tint); border-radius: 20px; }
    @media (min-width: 900px) { .commercial { grid-template-columns: 1fr 1.5fr; gap: 56px; padding: 48px; } }
    .commercial h3 { margin-top: 10px; font-size: clamp(1.75rem, 3.5vw, 2.5rem); font-weight: 800; line-height: 1.05; }
    .commercial-intro > p:last-child { margin-top: 14px; line-height: 1.6; color: var(--muted); }
    .commercial-list { margin: 0; display: grid; gap: 22px; }
    .commercial-list > div { padding-left: 16px; border-left: 3px solid var(--yellow); }
    .commercial-list dt { font-weight: 800; }
    .commercial-list dd { margin: 4px 0 0; line-height: 1.55; color: #2b2e33; }

    .cv-grid { margin-top: 72px; display: grid; gap: 40px; }
