    .wall { margin-top: 28px; display: grid; gap: 16px; grid-template-columns: repeat(2, 1fr); }
    @media (min-width: 900px) { .wall { grid-template-columns: 0.7fr 1fr 1fr; gap: 22px; align-items: start; } }

    .rail { display: grid; grid-auto-flow: column; grid-auto-columns: 58%; gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 8px; }
    .rail > * { scroll-snap-align: start; }
