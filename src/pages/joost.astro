    @media (min-width: 1024px) { .glance-grid { grid-template-columns: 1.25fr 1fr 1fr 1fr; } }
    .glance-label { font-size: 12px; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); margin-bottom: 10px; }
    .glance-col ul { list-style: none; padding: 0; margin: 0; }
