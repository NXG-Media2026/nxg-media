    .cv-skills dl { margin: 0; display: grid; gap: 18px; }
    .cv-skills dt { font-weight: 800; }
    .cv-skills dd { margin: 4px 0 0; line-height: 1.55; color: #2b2e33; }
    .plain { list-style: none; padding: 0; margin: 0 0 8px; display: grid; gap: 10px; line-height: 1.5; color: #2b2e33; }

    /* Contact */
    .contact-grid { display: grid; gap: 36px; }
    @media (min-width: 900px) { .contact-grid { grid-template-columns: 1fr 1fr; align-items: end; } }
    .contact h2 { color: #fff; margin-top: 10px; font-size: clamp(2.5rem, 7vw, 4.5rem); line-height: 0.95; font-weight: 800; }
    .contact-list { list-style: none; padding: 0; margin: 0; border-top: 1px solid #2c2f35; }
    .contact-list a { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 16px; padding: 18px 0; border-bottom: 1px solid #2c2f35; color: #fff; font-weight: 700; font-size: 1.0625rem; text-decoration: none; word-break: break-word; transition: color 150ms; }
    .contact-list a:hover { color: var(--yellow); }
    .contact-list span { font-size: 12px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: #8d9097; align-self: center; }
    .pf-foot { padding: 28px 20px; font-size: 13px; color: var(--muted); }

    /* Product case + AI */
    .product { padding: 40px 0 56px; border-top: 1px solid #2c2f35; }
    .product-kicker { margin-top: 14px; font-size: 13px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--yellow); }
    .product .project-head h3 { margin-top: 6px; }
    .browser { margin: 0; border-radius: 12px; overflow: hidden; background: #1a1d22; border: 1px solid #2c2f35; box-shadow: 0 20px 50px rgba(0,0,0,0.35); }
    .browser-bar { height: 26px; display: flex; align-items: center; gap: 6px; padding: 0 12px; background: #23262c; }
    .browser-bar span { width: 9px; height: 9px; border-radius: 999px; background: #3a3e46; }
    .browser img { display: block; width: 100%; height: auto; }
    .browser-lg { margin-top: 32px; }
    .browser-shot { aspect-ratio: 16 / 10; overflow: hidden; background: #fff; }
    .browser-shot img { width: 100%; height: 100%; object-fit: cover; object-position: top; }
    .geo-steps { list-style: none; padding: 0; margin: 24px 0 0; display: grid; grid-auto-flow: column; grid-auto-columns: 78%; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 6px; }
    .geo-steps > li { scroll-snap-align: start; }
    @media (min-width: 900px) { .geo-steps { grid-auto-flow: row; grid-template-columns: repeat(3, 1fr); gap: 24px; overflow: visible; } }
    .geo-step-title { margin-top: 14px; display: flex; align-items: center; gap: 8px; font-weight: 800; color: #fff; }
    .geo-step-title span { display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: 999px; background: var(--yellow); color: var(--ink); font-size: 12px; }
    .geo-step-text { margin-top: 4px; font-size: 14px; line-height: 1.5; color: #b7b9be; }
    .geo-step-first { flex-wrap: wrap; }
    .geo-step-first em { flex-basis: 100%; padding-left: 30px; font-style: normal; font-weight: 400; font-size: 14px; color: #b7b9be; }
    .shot-note { margin-top: 14px; font-size: 12.5px; color: #8d9097; }
    .geo-results { margin-top: 40px; display: grid; gap: 32px; padding: 28px; border-radius: 16px; background: #1a1d22; }
    @media (min-width: 900px) { .geo-results { grid-template-columns: 1fr 1fr 1.1fr; gap: 40px; } }
    .geo-figures { margin: 14px 0 0; display: grid; gap: 14px; }
    .geo-figures dt { font-size: clamp(1.9rem, 4vw, 2.5rem); color: #fff; }
    .geo-figures dd { margin: 4px 0 0; font-size: 13.5px; color: #b7b9be; }
    .geo-results .ticks { color: #d9dadd; font-size: 15px; }
    .scope-outcome { background: #1f8f5f; color: #fff; }
    .fine-dark { color: #8d9097; }
    .ai-shots { margin-top: 24px; display: grid; gap: 20px; }
    @media (min-width: 900px) { .ai-shots { grid-template-columns: repeat(2, 1fr); } }
    .features dt .status { margin-left: 6px; vertical-align: 2px; font-size: 9.5px; padding: 2px 7px; }
    .principles { margin-top: 24px; max-width: 52em; color: #d9dadd; font-size: 15px; }
    .legend .status + .status { margin-left: -2px; }

    /* Scale */
    .scale { margin-top: 48px; display: grid; gap: 24px; }
    @media (min-width: 900px) { .scale { grid-template-columns: 1fr 1.6fr; gap: 56px; } }
    .scale-intro p { margin-top: 10px; color: var(--muted); line-height: 1.6; }
    .scale-list { margin: 0; border-top: 1px solid var(--line); }
    .scale-list > div { display: grid; grid-template-columns: 1fr; gap: 2px; padding: 12px 0; border-bottom: 1px solid var(--line); }
    @media (min-width: 640px) { .scale-list > div { grid-template-columns: 210px 1fr; gap: 16px; align-items: baseline; } }
    .scale-list dt { font-weight: 800; }
    .scale-list dd { margin: 0; color: var(--muted); font-size: 14.5px; }
    .scale-list .num { font-size: 1.5rem; color: var(--ink); margin-right: 6px; }
  </style>
</body>
</html>
