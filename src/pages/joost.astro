    @media (min-width: 1024px) { .band-compact { grid-template-columns: 330px 1fr; } }
    .band-gallery { display: flex; gap: 12px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 6px; align-items: flex-start; }
