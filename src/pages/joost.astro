    .stage-tag { display: flex; align-items: center; gap: 8px; font-size: 12px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
    .stage-tag span { display: inline-grid; place-items: center; width: 22px; height: 22px; border-radius: 999px; background: var(--ink); color: #fff; font-size: 11px; letter-spacing: 0; }
    .band h4 { margin-top: 10px; font-size: 1.3rem; font-weight: 800; line-height: 1.2; }
