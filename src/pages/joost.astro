    .product .project-head h3 { margin-top: 6px; }
    .browser { margin: 0; border-radius: 12px; overflow: hidden; background: #1a1d22; border: 1px solid #2c2f35; box-shadow: 0 20px 50px rgba(0,0,0,0.35); }
    .browser-bar { height: 26px; display: flex; align-items: center; gap: 6px; padding: 0 12px; background: #23262c; }
    .browser-bar span { width: 9px; height: 9px; border-radius: 999px; background: #3a3e46; }
