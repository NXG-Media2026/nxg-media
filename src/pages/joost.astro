    /* Logos and links */
    a.ext { color: inherit; text-decoration: underline; text-decoration-color: rgba(7, 86, 239, 0.35); text-underline-offset: 3px; transition: text-decoration-color 150ms; }
    a.ext:hover { text-decoration-color: var(--blue); }
