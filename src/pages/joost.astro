      'Own paid acquisition end to end: strategy, budget allocation, creative testing, funnels, CRO and reporting, scaling or cutting spend on CPA and ROAS targets.',
      'Meta is the core channel; Google, TikTok, Pinterest and LinkedIn where they fit. B2C and B2B, for 50+ clients.',
      'Brief designers and content creators on hooks, angles, formats and copy.',
      'Commercial side of working independently: client acquisition and proposals, pricing and profitability, multi-year relationships (EasyZZP since 2018, Happy with Yoga since 2022) and launching new propositions, such as an AI-search service in 2026 that brought in 8 new B2B clients.',
      'Built my own tools: the NXG AI Visibility Scanner, a client hub, creative dashboards and AI workflows.',
    ],
  },
  {
    period: '2024 to present',
    role: 'Freelance Performance Marketer',
    org: 'Cordital',
    platforms: ['Google Ads', 'Meta Ads'],
    focus: 'More than 5 clients',
    summary: 'I manage Google Ads and Meta Ads campaigns for Cordital clients, including VB-installaties and TopTuinen.nl.',
    points: [],
  },
  {
    period: '2022 to 2024',
    role: 'Performance Marketer (freelance)',
    org: 'Vos Marketing, e-commerce agency, Rotterdam',
    platforms: ['Meta Ads', 'TikTok Ads'],
    orgUrl: 'https://vosmarketing.nl',
    focus: 'Agency-side e-commerce',
    summary: 'I joined the Vos Marketing team alongside my independent work. I ran paid social and acquisition for their e-commerce clients in the Netherlands, Germany and the UK.',
    points: [
      'Managed up to 7 e-commerce ad accounts at the same time (more brands over the whole engagement), with roughly €40,000 in combined monthly ad spend, for about 18 to 24 months.',
      'Presented monthly performance reviews to clients (spend, revenue, ROAS, CPA, AOV, conversion rate) and set the testing plan for the next month.',
      "Worked inside another agency's team, processes and client structure.",
    ],
  },
  {
    period: '~2024 · 6 months',
    role: 'Performance Marketer (freelance)',
    org: 'Rocket Leads, lead generation agency',
    platforms: ['Meta Ads'],
    orgUrl: 'https://www.rocketleads.com/',
    focus: 'Around 9 to 10 client accounts',
    summary: 'This short agency assignment spanned several industries, including dental care (AltaDent Clinic), DJs and entertainment, coffee businesses, solar energy and other local services.',
    points: [],
  },
];

const channels = [
  { name: 'Meta Ads', core: true },
  { name: 'Google Ads' },
  { name: 'TikTok Ads' },
  { name: 'Pinterest Ads' },
  { name: 'LinkedIn Ads' },
];

const skillGroups = [
  { group: 'Creative', items: ['Hooks and angles', 'UGC and creator briefs', 'Social proof', 'Creative testing'] },
  { group: 'Growth', items: ['Funnels', 'Landing pages and CRO', 'E-mail and CRM', 'Tracking and attribution'] },
  { group: 'Data and AI', items: ['Google Analytics', 'Dashboards', 'n8n', 'Gemini', 'Claude'] },
  { group: 'Business', items: ['Client acquisition', 'Proposals and pricing', 'Account management'] },
];

const glance = {
  platforms: [
    { name: 'Meta Ads', tier: 'Primary specialisation' },
    { name: 'Google Ads', tier: 'Hands-on' },
    { name: 'TikTok Ads', tier: 'Additional' },
    { name: 'Pinterest Ads', tier: 'Additional' },
    { name: 'LinkedIn Ads', tier: 'Additional' },
  ],
  business: ['B2C and e-commerce', 'B2B lead generation', 'Recruitment advertising', 'Digital products, courses and subscriptions'],
  capabilities: ['Performance creative strategy', 'Campaign management and optimisation', 'Funnels and CRO', 'AI-assisted creative workflows'],
  background: ['Independent freelance specialist since 2018', 'Worked inside agency teams: Vos Marketing, Rocket Leads, Cordital', 'Clients in NL, BE, UK, DE and ES'],
};

const personSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Joost van Putten',
  jobTitle: 'Performance Creative Strategist',
  url: pageUrl,
  email: `mailto:${email}`,
  sameAs: [linkedinUrl],
  address: { '@type': 'PostalAddress', addressLocality: 'Valencia', addressCountry: 'ES' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: 'Hogeschool Utrecht' },
  knowsLanguage: ['nl', 'en', 'es', 'de'],
});
---

<!doctype html>
<html lang="en">
<head>
  <SEOHead
    title="Joost van Putten | Performance Creative Strategist · Paid Social & Meta Ads"
    description="Performance creative strategist with 8+ years in paid social and Meta Ads: creative strategy and testing, €8M+ in managed Meta spend, 50+ clients and self-built AI marketing systems. Ad creatives, case studies and full CV."
    canonical={pageUrl}
    ogImage="/images/og/default.jpg"
    locale="en"
    schemas={[personSchema]}
  />
</head>
<body class="pf">
  <a class="skip" href="#main">Skip to content</a>

  <header class="pf-nav" data-nav>
    <div class="wrap pf-nav-inner">
      <a href="#top" class="pf-brand" aria-label="Joost van Putten, back to top">
        <span class="pf-brand-full">Joost van Putten</span>
        <span class="pf-brand-short" aria-hidden="true">JvP</span>
      </a>
      <nav aria-label="Sections">
        <ul class="pf-links">
          <li><a href="#work">Work</a></li>
          <li><a href="#ai">AI Systems</a></li>
          <li><a href="#experience">Experience</a></li>
          <li><a href="#contact">Contact</a></li>
        </ul>
      </nav>
      <a class="pf-cv-btn" href={cvUrl} download>CV <span aria-hidden="true">↓</span></a>
    </div>
  </header>

  <main id="main">
    {/* Hero */}
    <section id="top" class="hero">
      <div class="wrap hero-grid">
        <div class="hero-copy">
          <p class="availability"><span class="availability-dot" aria-hidden="true"></span><span>Available for freelance collaborations<br class="availability-break" /> <span class="availability-divider" aria-hidden="true">·</span> Open to in-house opportunities</span></p>
          <p class="kicker">Performance Creative Strategist</p>
          <p class="kicker-sub">Paid Social · Growth Marketing · AI Systems</p>
          <h1 class="hero-name">Joost<br />van Putten</h1>
          <p class="hero-lead">
            8+ years turning creative ideas into measurable growth.
            From Meta Ads and creative testing to building AI-powered marketing systems.
          </p>
          <div class="hero-actions">
            <a class="btn btn-dark" href="#work">Selected work</a>
            <a class="btn btn-line" href="#ai">AI systems</a>
            <a class="btn btn-line" href={cvUrl} download>Download CV <span class="btn-meta">PDF</span></a>
          </div>
          <div class="hero-meta">
            <ul class="hero-places" aria-label="Locations">
              <li>Valencia, Spain</li>
              <li>Hooglanderveen, The Netherlands</li>
            </ul>
            <ul class="langs" aria-label="Languages">
              {languages.map((l) => (
                <li><span class="lang-flag" aria-hidden="true" set:html={l.flag} />{l.name} <span class="lang-level">{l.level}</span></li>
              ))}
            </ul>
          </div>
        </div>
        <figure class="hero-photo">
          <Image src={portrait} alt="Joost van Putten" widths={[480, 720, 960]} sizes="(min-width: 900px) 40vw, 90vw" loading="eager" fetchpriority="high" />
        </figure>
      </div>
      <div class="wrap">
        <dl class="figures">
          {heroFigures.map((f) => (
            <div>
              <dt class="num">{f.value}</dt>
              <dd>{f.label}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <LogoMarquee logos={logos} speed={42} label="Selected brands I've worked with" variant="light" />
    <p class="marquee-note wrap">Includes brands I worked on through Vos Marketing, Rocket Leads and other agency partners.</p>

    <div class="wrap">
      <section class="glance" aria-labelledby="glance-title">
        <h2 id="glance-title" class="fold-title">Expertise at a glance</h2>
        <p class="fold-preview">Paid social, creative strategy, campaign management and CRO.</p>
        <div class="glance-grid">
          <div class="glance-col glance-platforms">
            <p class="glance-label">Advertising platforms</p>
            <ul>
              {glance.platforms.map((p, i) => (
                <li class:list={['glance-plat', { 'glance-primary': i === 0, 'glance-second': i === 1 }]}>
                  <span class="glance-plat-name">{platIcon(p.name) && <span class="plat-icon" style={`color:${i === 0 ? '#fff' : platIcon(p.name)!.color}`} set:html={platIcon(p.name)!.svg} aria-hidden="true" />}{p.name}</span><span class="glance-tier">{p.tier}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="glance-col">
            <p class="glance-label">Business types</p>
            <ul class="glance-list">{glance.business.map((b) => <li>{b}</li>)}</ul>
          </div>
          <div class="glance-col">
            <p class="glance-label">Core capabilities</p>
            <ul class="glance-list">{glance.capabilities.map((c, i) => <li class:list={{ 'glance-strong': i === 0 }}>{c}</li>)}</ul>
          </div>
          <div class="glance-col">
            <p class="glance-label">Background</p>
            <ul class="glance-list">{glance.background.map((b) => <li>{b}</li>)}</ul>
          </div>
        </div>
      </section>
    </div>

    {/* Work: flagship cases */}
    <section id="work" class="fold-section section">
      <details class="portfolio-fold">
        <summary class="wrap fold-summary">
          <h2><span class="sec-index">01 · Work</span><span class="fold-title">Selected work</span><span class="fold-preview">Three client cases, the ads I made and the results behind them.</span></h2>
          <span class="fold-icon" aria-hidden="true"></span>
        </summary>
      <div class="wrap">
        <p class="sec-intro">For my direct clients, I often make the ads myself, from the first concept to the final cut. I use CapCut for video editing and Canva AI for ad design.</p>
          <ul class="scope-legend" aria-label="How figures are labelled">
            <li><span class="scope scope-client">Client total</span></li>
            <li><span class="scope scope-campaign">Campaign</span></li>
            <li><span class="scope scope-ad">This ad</span></li>
          </ul>
      </div>

      {/* Flagship 1: Happy with Yoga */}
      <article class="flag" aria-labelledby="flag-hwy">
        <div class="wrap">
          <div class="flag-head">
            <Image src={hwy.logo} alt="" height={56} class="flag-logo" />
            <div>
              <p class="flag-no">Case 01</p>
              <h3 id="flag-hwy">{hwy.client}</h3>
              <p class="flag-meta">{hwy.meta}</p>
              <ul class="plats" aria-label="Ad platforms">{hwy.platforms.map((p) => <li class="plat">{platIcon(p) && <span class="plat-icon" style={`color:${platIcon(p)!.color}`} set:html={platIcon(p)!.svg} aria-hidden="true" />}{p}</li>)}</ul>
            </div>
          </div>
          <div class="flag-intro">
            <p class="flag-lead">{hwy.lead}</p>
            <dl class="totals">
              {hwy.totals.map((t) => (
                <div><dt class="num">{t.value}</dt><dd><span class="scope scope-client">Client total</span>{t.label}</dd></div>
              ))}
            </dl>
          </div>

          <div class="bands">
            {hwy.stages.map((s, i) => (
              <section class:list={['band', { 'band-compact': s.creatives.length === 0 }]} aria-label={s.name}>
                <div class="band-text">
                  <p class="stage-tag"><span>{String.fromCharCode(65 + i)}</span>{s.tag}</p>
                  <h4>{s.name}</h4>
                  <dl class="stage-figures">
                    {s.figures.map((f) => (
                      <div><dt class="num">{f.value}</dt><dd>{f.label}</dd></div>
                    ))}
                  </dl>
                  <span class="scope scope-campaign">Campaign</span>
                  {s.note && s.creatives.length > 0 && <p class="stage-note">{s.note}</p>}
                </div>
                {s.creatives.length === 0 && s.note && <p class="band-side-note">{s.note}</p>}
                {s.creatives.length > 0 && (
                  <div class="band-gallery">
                    {s.creatives.map((c) => (
                      <CreativeTile brand={hwy.client} format={c.format} ratio={c.ratio} size={c.size === 'lg' ? 'lg' : 'sm'} {...media(c.slug)} />
                    ))}
                  </div>
                )}
              </section>
            ))}
          </div>

          <div class="flag-video">
            <CreativeTile brand={hwy.client} format={hwy.video.format} vimeo={hwy.video.vimeo} metrics={hwy.video.metrics} />
            <div class="flag-video-text">
              <span class="scope scope-ad">This ad</span>
              <p>A video ad from the same account, with its own results. "Results" is the conversion event the campaign optimised for.</p>
            </div>
          </div>
        </div>
      </article>

      {/* Flagship 2: Het Grote Depri Doeboek */}
      <article class="flag flag-tint" aria-labelledby="flag-depri">
        <div class="wrap">
          <div class="flag-head">
            <Image src={depri.logo} alt="" height={56} class="flag-logo" />
            <div>
              <p class="flag-no">Case 02</p>
              <h3 id="flag-depri">{depri.client} <span class="flag-alias">/ {depri.alias}</span></h3>
              <p class="flag-meta">{depri.meta}</p>
              <ul class="plats" aria-label="Ad platforms">{depri.platforms.map((p) => <li class="plat">{platIcon(p) && <span class="plat-icon" style={`color:${platIcon(p)!.color}`} set:html={platIcon(p)!.svg} aria-hidden="true" />}{p}</li>)}</ul>
            </div>
          </div>
          <div class="flag-intro">
            <p class="flag-lead">{depri.lead}</p>
            <dl class="totals">
              {depri.totals.map((t) => (
                <div><dt class="num">{t.value}</dt><dd><span class="scope scope-client">Client total</span>{t.label}</dd></div>
              ))}
            </dl>
          </div>
          <p class="wall-label"><span class="scope scope-ad">This ad</span> Five ads, each with its own results</p>
          <div class="wall-top">
            {depri.creatives.filter((c) => c.featured).map((c) => (
              <CreativeTile brand={depri.client} logo={depri.logo} format={c.format} vimeo={c.vimeo} {...media(c.slug)} ratio={c.ratio} postUrl={c.postUrl} metrics={c.metrics} note={c.note} size="lg" />
            ))}
          </div>
          <div class="wall">
            {depri.creatives.filter((c) => !c.featured).map((c) => (
              <CreativeTile brand={depri.client} logo={depri.logo} format={c.format} vimeo={c.vimeo} {...media(c.slug)} ratio={c.ratio} postUrl={c.postUrl} metrics={c.metrics} note={c.note} size={c.size === 'lg' ? 'lg' : 'md'} />
            ))}
          </div>
        </div>
      </article>

      {/* Flagship 3: Ik Rouw Van Je */}
      <article class="flag" aria-labelledby="flag-irvj">
        <div class="wrap">
          <div class="flag-head">
            <Image src={irvj.logo} alt="" height={56} class="flag-logo" />
            <div>
              <p class="flag-no">Case 03</p>
              <h3 id="flag-irvj">{irvj.client}</h3>
              <p class="flag-meta">{irvj.meta}</p>
              <ul class="plats" aria-label="Ad platforms">{irvj.platforms.map((p) => <li class="plat">{platIcon(p) && <span class="plat-icon" style={`color:${platIcon(p)!.color}`} set:html={platIcon(p)!.svg} aria-hidden="true" />}{p}</li>)}</ul>
            </div>
          </div>
          <div class="flag-intro">
            <p class="flag-lead">{irvj.lead}</p>
            <dl class="totals totals-4">
              {irvj.totals.map((t) => (
                <div><dt class="num">{t.value}</dt><dd><span class="scope scope-client">Client total</span>{t.label}</dd></div>
              ))}
            </dl>
          </div>
          <p class="wall-label">Five creative approaches</p>
          <div class="irvj-grid">
            <CreativeTile brand={irvj.client} format={irvjFeature.format} ratio={irvjFeature.ratio} size="lg" postUrl={irvjFeature.postUrl} {...media(irvjFeature.slug)} />
            <div class="irvj-squares">
              {irvj.creatives.map((c) => (
                <CreativeTile brand={irvj.client} logo={irvj.logo} format={c.format} ratio={c.ratio} size="sm" postUrl={c.postUrl} {...media(c.slug)} />
              ))}
            </div>
          </div>
        </div>
      </article>

      {/* More creative work */}
      <div class="wrap more">
        <header class="more-head">
          <h3>More creative work</h3>
          <p>Over three years of advertising for Stil, these two videos became top performers. I came up with both concepts and briefed the Stil team on what to film. They shot the footage, I edited both ads, and each ran for nearly a year. The two Stekkies videos ran on both Meta and TikTok.</p>
        </header>
        <div class="more-grid">
          {moreWork.map((w) => (
            <div class="more-item">
              <p class="more-brand">{w.url ? <a href={w.url} target="_blank" rel="noopener noreferrer" aria-label={w.brand + ' website'}>{w.logo ? <Image src={w.logo} alt={w.brand} height={28} class="more-logo" /> : <strong>{w.brand}</strong>}</a> : w.logo ? <Image src={w.logo} alt={w.brand} height={28} class="more-logo" /> : <strong>{w.brand}</strong>}</p>
              <CreativeTile brand={w.brand} format={w.format} vimeo={w.vimeo} {...media(w.slug)} metrics={w.metrics} note={w.note} />
            </div>
          ))}
        </div>
      </div>

      {/* Previous results and campaign scale */}
      <div class="wrap prev">
        <h3 class="earlier-title">Previous results and campaign scale</h3>
        <ul class="prev-list">
          {previous.map((r) => (
            <li class="prev-row">
              <div class="prev-brand">
                {r.logo && r.iconOnly ? (
                  <span class="prev-icon-name"><Image src={r.logo} alt="" height={56} class="prev-icon" />{r.url ? <a class="ext prev-name" href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a> : <span class="prev-name">{r.name}</span>}</span>
                ) : r.logo ? (
                  r.url ? <a class="logo-link" href={r.url} target="_blank" rel="noopener noreferrer"><Image src={r.logo} alt={r.name} height={56} class="prev-logo" /></a>
                        : <Image src={r.logo} alt={r.name} height={56} class="prev-logo" />
                ) : (
                  r.url ? <a class="ext prev-name" href={r.url} target="_blank" rel="noopener noreferrer">{r.name}</a> : <span class="prev-name">{r.name}</span>
                )}
                <p class="prev-role">{r.role}{r.period && <span> · {r.period}</span>}</p>
              </div>
              <ul class="plats" aria-label="Ad platforms">
                {r.platforms.map((p) => <li class="plat">{platIcon(p) && <span class="plat-icon" style={`color:${platIcon(p)!.color}`} set:html={platIcon(p)!.svg} aria-hidden="true" />}{p}</li>)}
              </ul>
              <p class="prev-spend"><span class:list={['num', { marker: r.highlightSpend }]}>{r.spend}</span><span class="prev-spend-label">{r.spendLabel}</span></p>
              <p class="prev-result">{r.resultHighlight && <mark class="marker">{r.resultHighlight}</mark>}{r.result}</p>
            </li>
          ))}
        </ul>
      </div>
      </details>
    </section>

    {/* Testimonials */}
    <section class="fold-section section" aria-labelledby="voices-title">
      <details class="portfolio-fold">
        <summary class="wrap fold-summary">
          <h2 id="voices-title"><span class="sec-index">02 · Clients</span><span class="fold-title">In their words</span><span class="fold-preview">Hear from clients at Somnox, Stekkies, MCM Research and Nederland Eet Groep.</span></h2>
          <span class="fold-icon" aria-hidden="true"></span>
        </summary>
      <div class="wrap">

        <div class="voices">
          {testimonials.map((t, i) => (
            <figure class:list={['voice', { 'voice-lead': i === 0 }]}>
              <button type="button" class="facade ratio-169" data-vimeo={t.id} aria-label={`Play video from ${t.name}`}>
                <Image src={t.thumb} alt="" width={i === 0 ? 960 : 640} loading="lazy" />
                <span class="play" aria-hidden="true"></span>
              </button>
              <figcaption>{t.logo && <Image src={t.logo} alt="" height={40} class="voice-logo" />}<span><strong>{t.name}</strong> · {t.role}</span></figcaption>
            </figure>
          ))}
        </div>
        <div class="voices-portrait">
          {portraitTestimonials.map((t) => (
            <figure class:list={['voice-p', { 'voice-p-wide': t.wide }]}>
              <button type="button" class:list={['facade', t.wide ? 'ratio-169' : 'ratio-916']} data-video={t.videoUrl} aria-label={'Play video from ' + t.name}>
                <Image src={t.thumbnail} alt="" width={360} loading="lazy" />
                <span class="play" aria-hidden="true"></span>
              </button>
              <figcaption>
                <Image src={t.logo} alt="" height={40} class="voice-logo" />
                <blockquote>"{t.quote}"</blockquote>
                <p><strong>{t.name}</strong> · {t.role}</p>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
      </details>
    </section>


    {/* AI systems */}
    <section id="ai" class="fold-section section section-dark">
      <details class="portfolio-fold">
        <summary class="wrap fold-summary">
          <h2><span class="sec-index">03 · AI Systems</span><span class="fold-title">Built and launched</span><span class="fold-preview">An AI search scanner that won 8 B2B clients, plus two tools for creative research and campaign decisions.</span></h2>
          <span class="fold-icon" aria-hidden="true"></span>
        </summary>
      <div class="wrap">


        <noscript><style>.ai-panel[hidden] { display: block; } .ai-toggle { display: none; }</style></noscript>

        {/* Featured: scanner */}
        <article class="ai-card ai-card-feature">
          {geo.landing && (
            <div class="ai-card-media browser">
              <div class="browser-bar" aria-hidden="true"><span></span><span></span><span></span></div>
              <Image src={geo.landing} alt="AI Visibility Scanner landing page" widths={[480, 720, 960]} sizes="(min-width: 900px) 560px, 92vw" loading="lazy" />
            </div>
          )}
          <div class="ai-card-body">
            <span class="status status-live">Live</span>
            <h3>{geo.title}</h3>
            <p class="ai-card-text">Enter a website to see where it appears in AI search, which competitors show up and what to improve. I built the scanner and used it to win website and advertising clients.</p>
            <p class="ai-outcome"><mark class="marker">8 new B2B clients</mark> from <strong>€3,209</strong> in ad spend</p>
            <p class="stack card-stack">Scan API · MailerLite · Calendly</p>
            <button type="button" class="ai-toggle" aria-expanded="false" aria-controls="ai-panel-geo" data-label="See the scan and results">See the scan and results <span aria-hidden="true">+</span></button>
          </div>
        </article>
        <div class="ai-panel" id="ai-panel-geo" hidden>
          <ol class="geo-steps">
            {geo.steps.filter((st) => st.image).map((st, i) => (
              <li>
                <figure class="browser">
                  <div class="browser-bar" aria-hidden="true"><span></span><span></span><span></span></div>
                  <div class="browser-shot">
                    <Image src={st.image!} alt={`Scanner screenshot: ${st.title}`} width={720} loading="lazy" />
                  </div>
                </figure>
                <p class="geo-step-title"><span>{i + 2}</span>{st.title}</p>
                <p class="geo-step-text">{st.text}</p>
              </li>
            ))}
          </ol>
          <p class="shot-note">Step 1 is the landing page above. Real product screenshots; client and competitor names are blurred.</p>
          <div class="geo-results">
            <div>
              <span class="scope scope-campaign">Campaign</span>
              <dl class="geo-figures">
                {geo.campaign.map((f) => <div><dt class="num">{f.value}</dt><dd>{f.label}</dd></div>)}
