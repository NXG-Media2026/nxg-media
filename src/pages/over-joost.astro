---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import CalendlyEmbed from '../components/CalendlyEmbed.astro';
import { siteConfig } from '../data/site';
import { generateProfilePage, generateFounderPerson, generateBreadcrumbs } from '../data/schema';
import { t, localizePath } from '../i18n/utils';
import { buildHreflangTrilingual } from '../i18n/hreflang';
import founderPhoto from '../assets/images/founder/joost-sitting-laptop-looking-working.webp';
import founderRelaxed from '../assets/images/founder/joost-standing-relaxed.webp';

const locale = 'nl';
const hreflang = buildHreflangTrilingual('/over-joost/', '/en/about-joost/', '/es/sobre-joost/');
const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: localizePath('/', locale) },
  { label: 'Over Joost' },
];
const breadcrumbSchema = [
  { name: t('breadcrumb.home', locale), url: `${siteConfig.url}${localizePath('/', locale)}` },
  { name: 'Over Joost', url: `${siteConfig.url}/over-joost` },
];
---

<BaseLayout
  title={`Over Joost | ${siteConfig.name}`}
  description="Joost van Putten — founder van NXG Media. Bouwt online groeisystemen voor coaches, experts, lokale MKB-bedrijven en praktijken. 7+ jaar ervaring, €5M+ ads beheerd."
  schemas={[generateProfilePage(), generateFounderPerson(locale), generateBreadcrumbs(breadcrumbSchema)]}
  locale={locale}
  hreflang={hreflang}
>
  <BreadcrumbNav items={breadcrumbs} />

<section class="refresh-hero refresh-about"><div class="refresh-wrap refresh-split"><div><p class="refresh-eyebrow">DE PERSOON ACHTER NXG-MEDIA</p><h1>HI, IK BEN JOOST.<br /><span>IK BOUW MEE.</span></h1><p>Al meer dan 7 jaar help ik ondernemers met online marketing. Van campagnes tot websites: ik wil weten wat het oplevert voor het bedrijf erachter.</p><p>Ik werk met MKB-bedrijven, praktijken en dienstverleners én met coaches en experts. Jij bent goed in je vak. Ik help je die expertise online te vertalen naar een duidelijke aanpak voor groei.</p><a class="refresh-button" href="/contact/">Laten we kennismaken <span aria-hidden="true">↗</span></a></div><figure><Image src={founderPhoto} alt="Joost van Putten aan het werk" width={620} loading="eager" fetchpriority="high" /><figcaption>Joost van Putten · Oprichter NXG-media</figcaption></figure></div></section>
<section class="py-10 md:py-14 bg-bg-alt"><div class="max-w-3xl mx-auto px-4 md:px-6"><h2 class="font-heading mb-6">Goed in je vak. Een aanpak die daarbij past.</h2><p class="text-text-muted leading-relaxed mb-4">Een praktijk wil nieuwe patiënten. Een vakbedrijf wil passende aanvragen. Een coach wil mensen bereiken die bij zijn of haar traject passen. Het doel verschilt, maar de vraag erachter herken ik: hoe maak je van je expertise een bedrijf dat online wordt gevonden én gekozen?</p><p class="text-text-muted leading-relaxed">Daar help ik bij. Met een heldere website, vindbaarheid, campagnes en opvolging die samen aan hetzelfde doel werken. Ik kijk naar jouw bedrijf, je doelgroep en wat je nodig hebt om verder te groeien.</p></div></section>
<section class="py-10 md:py-14"><div class="max-w-3xl mx-auto px-4 md:px-6"><h2 class="font-heading mb-6">Voor wie ik werk</h2><div class="grid md:grid-cols-2 gap-6"><article class="p-6 bg-bg-alt rounded-card"><h3 class="font-heading mb-4">MKB, praktijken en dienstverleners</h3><p class="text-text-muted mb-5">Van installateur en makelaar tot tandarts, kliniek en andere lokale dienstverleners. Met NXG Growth verbinden we AI-vindbaarheid, AI Search Ads en een website die bezoekers naar een aanvraag leidt.</p><a class="text-primary font-bold" href="/landermkb/">Bekijk de MKB-aanpak ↗</a></article><article class="p-6 bg-bg-alt rounded-card"><h3 class="font-heading mb-4">Coaches en experts</h3><p class="text-text-muted mb-5">Voor ondernemers die hun kennis en begeleiding verkopen. Met Coach Accelerator werken we aan de samenhang tussen positionering, aanbod, campagnes en opvolging.</p><a class="text-primary font-bold" href="/coach-accelerator/">Bekijk Coach Accelerator ↗</a></article></div></div></section>
<section class="py-10 md:py-14 bg-bg-alt"><div class="max-w-3xl mx-auto px-4 md:px-6"><h2 class="font-heading mb-6">Zo werk ik</h2><div class="space-y-6"><div><h3 class="font-heading mb-2">Eerst jouw bedrijf begrijpen</h3><p class="text-text-muted">Wie wil je bereiken, wat levert een klant op en waar loopt het nu vast? Dat bepaalt de aanpak.</p></div><div><h3 class="font-heading mb-2">Alles laten samenwerken</h3><p class="text-text-muted">We verbinden je website, boodschap, vindbaarheid en campagnes. Voor een praktijk kan dat een andere invulling hebben dan voor een coach.</p></div><div><h3 class="font-heading mb-2">Meten en verbeteren</h3><p class="text-text-muted">We kijken naar aanvragen en kwaliteit, bespreken wat het oplevert en sturen bij. Het doel, de investering en eventuele garantie leggen we vooraf vast.</p></div></div></div></section>
<section class="py-10 md:py-14"><div class="max-w-3xl mx-auto px-4 md:px-6"><h2 class="font-heading mb-6">Ervaring die ik meebreng</h2><p class="text-text-muted mb-6">Al meer dan 7 jaar werk ik aan online marketing: van advertentiecampagnes en websites tot content, funnels en AI-vindbaarheid. De klantcases laten zien hoe die ervaring in verschillende bedrijven wordt toegepast.</p><a class="text-primary font-bold" href="/cases/">Bekijk het werk en de resultaten ↗</a><h3 class="font-heading mt-8 mb-4">Certificeringen</h3><ul class="space-y-2">{siteConfig.founder.credentials.map(c=><li class="text-text-muted">{c.name} · {c.issuer} ({c.year})</li>)}</ul></div></section>
<section class="py-10 md:py-14 bg-bg-alt"><div class="max-w-3xl mx-auto px-4 md:px-6"><div class="flex flex-col md:flex-row gap-8 items-start"><Image src={founderRelaxed} alt="Joost van Putten" width={280} class="rounded-card w-56 shrink-0" loading="lazy" /><div><h2 class="font-heading mb-4">Ook buiten het werk nieuwsgierig</h2><p class="text-text-muted leading-relaxed mb-4">Ik werk vanuit Valencia en Nederland. Buiten het werk vind je me op de padelbaan, in de bergen rond Valencia of aan het experimenteren met nieuwe AI-tools.</p><p class="text-text-muted leading-relaxed">Die nieuwsgierigheid neem ik mee in mijn werk: nieuwe mogelijkheden onderzoeken en bekijken wat ze kunnen betekenen voor de ondernemers met wie ik samenwerk.</p></div></div></div></section>
<CalendlyEmbed pageType="about" pageSlug="over-joost" locale={locale} title="Vertel me over jouw bedrijf." subtitle="MKB, praktijk, dienstverlener, coach of expert: we bekijken samen welke aanpak past." />
</BaseLayout>