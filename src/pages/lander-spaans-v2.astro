---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import CookieConsent from '../components/CookieConsent.astro';
import LandingBookingCard from '../components/LandingBookingCard.astro';
import { getTrackingScript, getCapiHelperScript } from '../lib/analytics';
import '../styles/lander.css';
import '../styles/lander-spaans-v2.css';
const logos = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/Client-logos/*.{webp,avif,png,jpg}', { eager: true });
const clientLogos = Object.entries(logos).map(([file, mod]) => ({ src: mod.default, alt: file.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/i, '').replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim() }));
const thumbs = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/testimonials/*-thumb.webp', { eager: true });
const videos = await Promise.all([
  ['stekkies', 'Stekkies'], ['somnox', 'Somnox'], ['narayan-eetclubnl', 'Eetclub.nl'],
  ['mcm-research', 'MCM Research'], ['cathowell-8loops', 'Cat Howell · 8loops'],
].map(async ([id, name]) => ({ id, name, poster: (await getImage({ src: thumbs['/src/assets/images/testimonials/' + id + '-thumb.webp'].default, width: 600 })).src })));
const faqs = [
  ['¿Qué cuenta como solicitud cualificada?', 'Una solicitud única del público acordado, con datos válidos e interés en tu servicio. El spam, los duplicados y los contactos irrelevantes no cuentan.'],
  ['¿Cómo funciona la garantía?', 'La garantía cubre un mínimo de 15 solicitudes cualificadas en 90 días desde el lanzamiento. Antes de empezar, dejamos por escrito qué cuenta, el presupuesto y las condiciones de devolución.'],
  ['¿Necesito invertir en anuncios?', 'El presupuesto depende del objetivo y del punto de partida. Acordamos cualquier inversión publicitaria antes de activarla.'],
  ['¿Qué pasa después de los 90 días?', 'Los resultados se revisan juntos para decidir cómo continuar. La web, el contenido y las optimizaciones que construimos para ti siguen siendo tuyos.'],
];
---
<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<title>15 solicitudes cualificadas en 90 días | NXG AI Search</title>
<meta name="description" content="Mínimo 15 solicitudes cualificadas en 90 días desde el lanzamiento. O te devolvemos tu dinero. Con el sistema NXG AI Search: visibilidad, Search Ads y una web que convierte." />
<meta name="robots" content="noindex, follow" />
<link rel="canonical" href="https://nxg-media.com/lander-spaans-v2" />
<meta name="theme-color" content="#0756ef" />
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%230756ef'/%3E%3Cpath d='M15 48V16h8l18 20V16h8v32h-8L23 28v20z' fill='%23fff000'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800;900&family=DM+Sans:wght@400;500;600;650;700;800&display=swap" rel="stylesheet">

</head>
<body class="v2">
<a class="skip" href="#main">Ir al contenido</a>
<header><div class="nav wrap">
<a class="brand" href="/es" aria-label="NXG-media, inicio">NXG<span>-media</span><small>AI Search Agency</small></a>
<nav aria-label="Navegación principal"><a href="#cases">Resultados</a><a href="#nxg-systeem">Método AI Search</a><a href="#garantia">Garantía</a></nav>
<a class="button yellow compact" href="#groeisessie">Reservar mi sesión ↗</a>
</div></header>
<main id="main">
<section class="hero"><div class="wrap v2-hero-grid">
<div><p class="eyebrow light">EL SISTEMA NXG AI SEARCH</p>
<h1>MÍNIMO <span class="v2-yellow">15 SOLICITUDES CUALIFICADAS</span> EN 90 DÍAS.</h1>
<p class="v2-refund">O te devolvemos tu dinero.</p>
<p class="v2-hero-text">Hacemos que tus clientes te encuentren en Google, ChatGPT, Gemini y Perplexity. Con el sistema NXG AI Search, convertimos esas búsquedas en solicitudes cualificadas.</p>
<a class="button yellow" href="#groeisessie">Reservar mi sesión gratuita <span aria-hidden="true">↗</span></a>
<p class="v2-hero-note">Con Joost · Sin compromiso · 90 días desde el lanzamiento</p>
<div class="v2-search-formula" aria-label="Los tres pilares del sistema NXG AI Search"><span>Visibilidad en IA</span><b aria-hidden="true">+</b><span>AI Search Ads</span><b aria-hidden="true">+</b><span>Una web que convierte</span></div>
<a class="v2-ai-teaser" href="#chatgpt-ads"><img src="/lander-assets/platforms/openai.svg" alt="" width="30" height="30" /><span><small>LA NUEVA GENERACIÓN DE BÚSQUEDA</small><strong>También ChatGPT Ads.</strong></span><span aria-hidden="true">↗</span></a>
</div>
<figure class="v2-hero-photo v2-hero-team"><img src="/lander-assets/proof/joost-fleur-equipo-nxg.avif" alt="Joost y Fleur, del equipo NXG-media" width="454" height="322" loading="eager" fetchpriority="high" /><figcaption><span>Joost y Fleur · Equipo NXG-media</span></figcaption></figure>
</div></section>
<div class="promise-strip" id="confianza"><div class="wrap strip-grid" aria-label="Por qué elegir NXG">
<div><span class="check" aria-hidden="true">✓</span><p><strong>Equipo de habla hispana</strong><span>Hablamos contigo en español.</span></p></div>
<div><span class="check" aria-hidden="true">✓</span><p><strong>Más de 50 empresas ayudadas</strong><span>Experiencia en negocios como el tuyo.</span></p></div>
<div><span class="check" aria-hidden="true">✓</span><p><strong>Solicitudes 100% cualificadas</strong><span>Para la garantía, solo cuentan contactos que cumplen los criterios acordados.</span></p></div>
</div></div>
<section class="section results" id="cases"><div class="wrap"><p class="eyebrow">AI SEARCH EN LA PRÁCTICA</p><h2>DE GOOGLE Y CHATGPT<br><span class="blue">A SOLICITUDES REALES.</span></h2><p class="results-intro">Visibilidad en buscadores, menciones en ChatGPT y una web que convierte. Estos son dos proyectos reales.</p><div class="case-grid"><article class="result-card"><div class="case-person"><img src="/lander-assets/proof/james.webp" alt="Dr. James Mitchell" width="80" height="80" loading="lazy"><div><strong>Costa Blanca Movement Centre</strong><a href="https://www.costablancamovement.com/" target="_blank" rel="noopener noreferrer">costablancamovement.com ↗</a></div></div><h3>DE CERO A<br>12–15 PACIENTES AL MES.</h3><p>Partía de cero, sin web ni historial en Google. En 14 días, la nueva web ya aparecía en la primera página. A los 2 meses: 12–15 pacientes al mes a través de internet.</p><div class="case-metrics"><div><strong>12–15</strong><span>pacientes al mes por vía online</span></div><div><strong>800+</strong><span>visitantes orgánicos al mes</span></div></div><div class="case-proof"><a href="/lander-assets/proof/google-proof.webp" target="_blank" rel="noopener"><img src="/lander-assets/proof/google-proof.webp" alt="Resultado en Google del caso Costa Blanca Movement Centre" width="600" height="360" loading="lazy"><span>Página 1 de Google en 14 días · ver prueba ↗</span></a><a href="/lander-assets/proof/chatgpt-proof.webp" target="_blank" rel="noopener"><img src="/lander-assets/proof/chatgpt-proof.webp" alt="ChatGPT menciona Costa Blanca Movement Centre como opción local" width="600" height="360" loading="lazy"><span>Mencionado por ChatGPT · ver prueba ↗</span></a></div></article><article class="result-card"><div class="case-person"><img src="/lander-assets/proof/verena.webp" alt="Dr. Verena Mann" width="80" height="80" loading="lazy"><div><strong>Dr. Verena Mann</strong><a href="https://doc-veri.pages.dev/" target="_blank" rel="noopener noreferrer">doc-veri.pages.dev ↗</a></div></div><h3>DE 2 A 19<br>SOLICITUDES AL MES.</h3><p>Una web que muestra su experiencia y facilita el contacto. De 2 a 19 solicitudes al mes, con menciones como experta en ChatGPT.</p><div class="case-metrics"><div><strong>2 → 19</strong><span>solicitudes al mes</span></div><div><strong>0 → 15</strong><span>menciones en IA</span></div></div><div class="case-proof single"><a href="/lander-assets/proof/verena-proof.webp" target="_blank" rel="noopener"><img src="/lander-assets/proof/verena-proof.webp" alt="Mención en ChatGPT de Dr. Verena Mann de su caso" width="1200" height="360" loading="lazy"><span>Mencionada como experta por ChatGPT · ver prueba ↗</span></a></div></article></div><p class="v2-note">Resultados de proyectos concretos. Cada negocio tiene su punto de partida.</p></div></section>
<section class="section v2-method" id="nxg-systeem"><div class="wrap"><p class="eyebrow">NUESTRO MÉTODO. TUS PRÓXIMOS CLIENTES.</p><h2>EL SISTEMA<br><span class="v2-yellow">NXG AI SEARCH.</span></h2><p class="v2-method-intro">Tus clientes ya preguntan a la IA qué empresa deberían elegir. Trabajamos para que tu negocio aparezca en esas respuestas.</p><div class="v2-three"><article><span>01</span><h3>SER ENCONTRADO.</h3><p>Mejoramos tu presencia en Google y en las respuestas de ChatGPT, Gemini y Perplexity. La reforzamos con Search Ads para llegar a tus clientes potenciales.</p></article><article><span>02</span><h3>SER ELEGIDO.</h3><p>Una web que demuestra tu experiencia, responde a las dudas y facilita el contacto.</p></article><article><span>03</span><h3>RECIBIR SOLICITUDES.</h3><p>Medimos las solicitudes cualificadas y mejoramos tu web y campañas para alcanzar el objetivo acordado.</p></article></div><div class="v2-search-news" id="chatgpt-ads"><img src="/lander-assets/platforms/openai.svg" alt="ChatGPT" width="48" height="48" loading="lazy" /><div><p class="eyebrow">UN NUEVO CANAL PARA TU NEGOCIO</p><h3>TAMBIÉN CHATGPT ADS.</h3><p>Evaluamos ChatGPT Ads como parte de tu sistema NXG AI Search, según el acceso disponible, tu público y tu presupuesto.</p></div><a class="button yellow" href="#groeisessie">Ver mis oportunidades ↗</a></div></div></section>
<section class="section v2-team" id="equipo"><div class="wrap v2-team-intro"><img class="v2-team-photo" src="/lander-assets/proof/joost.webp" alt="Joost van Putten, fundador de NXG-media" width="720" height="900" loading="lazy" decoding="async" /><div><p class="eyebrow">TU EQUIPO NXG</p><h2>HOLA, SOY JOOST.</h2><p>Hablamos tu idioma. Te acompañamos en español para convertir las oportunidades de AI Search en solicitudes para tu negocio.</p></div></div></section>
<section class="section session v2-booking-section" id="groeisessie"><div class="wrap session-grid"><div><p class="eyebrow light">TU SESIÓN GRATUITA</p><h2>DESCUBRE TUS<br><span class="v2-yellow">OPORTUNIDADES EN AI SEARCH.</span></h2><p>Revisamos tu presencia en Google y ChatGPT, las oportunidades de tu negocio y cómo conseguir solicitudes cualificadas.</p><p><strong>En español. Con Joost. Sin compromiso.</strong></p></div><LandingBookingCard id="v2-calendar-first" /></div></section>
<section class="section" id="videos"><div class="wrap"><p class="eyebrow">CLIENTES CON VOZ PROPIA</p><h2>EXPERIENCIAS REALES.<br><span class="blue">DALE AL PLAY.</span></h2><p class="v2-note">Testimonios de trabajos de marketing de NXG. Vídeos en su idioma original.</p>
<div class="v2-video-grid">{videos.map(video => <figure class="v2-video"><video controls playsinline preload="none" poster={video.poster} aria-label={'Testimonio de ' + video.name}><source src={'/videos/testimonials/' + video.id + '-testimonial-video.mp4'} type="video/mp4" /><a href={'/videos/testimonials/' + video.id + '-testimonial-video.mp4'}>Ver el vídeo de {video.name}</a></video><figcaption>{video.name}</figcaption></figure>)}
</div></div></section>
<section class="section v2-booking-section v2-booking-bottom" id="reservar"><div class="wrap"><div class="v2-booking-heading"><p class="eyebrow">AHORA, TU NEGOCIO</p><h2>HABLEMOS DE TUS<br><span class="blue">PRÓXIMOS CLIENTES.</span></h2><p>Elige un horario para tu sesión gratuita con Joost. En español y sin compromiso.</p></div><LandingBookingCard id="v2-calendar-bottom" /></div></section>
<section class="client-proof" aria-label="Empresas para las que hemos realizado trabajo de marketing">
  <div class="wrap proof-heading"><p>EMPRESAS QUE YA HAN TRABAJADO CON JOOST</p><button class="logos-toggle" type="button" aria-pressed="false" aria-controls="v2-logo-track">Pausar logos</button></div>
  <div class="client-window"><div class="client-track" id="v2-logo-track">{[0, 1].map(copy => <div class="client-group" aria-hidden={copy === 1 ? 'true' : undefined}>{clientLogos.map(logo => <div class="client-logo"><Image src={logo.src} alt={copy === 0 ? logo.alt : ''} height={48} loading="lazy" decoding="async" /></div>)}</div>)}</div></div>
</section>
<section class="section v2-guarantee" id="garantia"><div class="wrap v2-guarantee-grid"><div><p class="eyebrow">EL COMPROMISO NXG</p><h2>15 SOLICITUDES CUALIFICADAS.<br>90 DÍAS.<br><span class="blue">O TE DEVOLVEMOS TU DINERO.</span></h2></div><div><p>El plazo empieza cuando lanzamos. Antes de empezar, dejamos por escrito los criterios, el presupuesto y las condiciones de devolución.</p><p><strong>La web y el contenido que construimos siguen siendo tuyos.</strong></p><a class="button black" href="#groeisessie">Hablar de mi objetivo ↗</a></div></div></section>
<section class="section faq"><div class="wrap faq-grid"><div><p class="eyebrow">SIN LETRA PEQUEÑA ESCONDIDA</p><h2>PREGUNTAS<br><span class="blue">FRECUENTES.</span></h2></div><div class="questions">{faqs.map(([question, answer]) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></div></section>
<section class="last-call"><div class="wrap"><h2>TU PRÓXIMO CLIENTE<br>YA TE ESTÁ BUSCANDO.</h2><a class="button black" href="#reservar">Reservar mi sesión gratuita ↗</a></div></section>
</main>
<footer><div class="wrap footer-main"><a class="brand" href="/es">NXG<span>-media</span><small>AI Search Agency</small></a><p>Personas reales.<br>Solicitudes cualificadas.</p><a href="#garantia">Ver la garantía ↗</a></div><div class="wrap footer-bottom"><span>© {new Date().getFullYear()} NXG-media · KVK 78318122</span><span><a href="/es/privacidad">Privacidad</a> · <a href="/es/terminos">Condiciones</a></span></div></footer>
<div class="mobile-cta"><a class="button yellow" href="#groeisessie">Reservar mi sesión gratuita ↗</a></div>
<script is:inline set:html={getTrackingScript()} />
<script is:inline set:html={getCapiHelperScript()} />
<CookieConsent locale="es" />
<script is:inline>
document.querySelectorAll('.logos-toggle').forEach(button => button.addEventListener('click', () => {
  const paused = button.closest('.client-proof').classList.toggle('is-paused');
  button.setAttribute('aria-pressed', String(paused));
  button.textContent = paused ? 'Reanudar logos' : 'Pausar logos';
}));
(function(C,A,L){let p=function(a,ar){a.q.push(ar)};let d=C.document;C.Cal=C.Cal||function(){let cal=C.Cal;let ar=arguments;if(!cal.loaded){cal.ns={};cal.q=cal.q||[];d.head.appendChild(d.createElement('script')).src=A;cal.loaded=true}if(ar[0]===L){const api=function(){p(api,arguments)};const namespace=ar[1];api.q=api.q||[];if(typeof namespace==='string'){cal.ns[namespace]=cal.ns[namespace]||api;p(cal.ns[namespace],ar);p(cal,['initNamespace',namespace])}else p(cal,ar);return}p(cal,ar)}})(window,'https://app.cal.com/embed/embed.js','init');
document.querySelectorAll('[data-booking-card]').forEach(function(card){
  var namespace=card.id;
  var target=card.querySelector('[data-calendar-target]');
  Cal('init',namespace,{origin:'https://cal.com'});
  Cal.ns[namespace]('inline',{elementOrSelector:'#'+target.id,config:{layout:'month_view',useSlotsViewOnSmallScreen:'true',theme:'light',locale:'es'},calLink:'joost-van-putten-iegf5p/cita-de-40-minutos'});
  Cal.ns[namespace]('ui',{hideEventTypeDetails:false,layout:'month_view',theme:'light'});
  Cal.ns[namespace]('on',{action:'bookingSuccessful',callback:function(){
    let consent={};try{consent=JSON.parse(localStorage.getItem('nxg_cookie_consent')||'{}')||{}}catch{}
    const eid=typeof nxgCapiEventId==='function'?nxgCapiEventId():'';
    if(consent.marketing&&typeof fbq==='function')fbq('track','Schedule',{content_name:'lander-spaans-v2',content_category:'mkb-lander'},{eventID:eid});
    if(consent.marketing&&eid&&typeof nxgCapiSend==='function')nxgCapiSend('Schedule',eid,{content_name:'lander-spaans-v2',content_category:'mkb-lander'});
    if(consent.analytics&&typeof trackEvent==='function')trackEvent('ai_vindbaarheid_call_booked',{page_type:'page',page_slug:'lander-spaans-v2',locale:'es',provider:'cal.com'});
  }});
});
document.querySelectorAll('.v2-video video').forEach(video => video.addEventListener('play', () => {
  document.querySelectorAll('.v2-video video').forEach(other => { if (other !== video) other.pause(); });
}));
</script>
</body>
</html>
