---
/**
 * Google & AI Aanvragen Traject — /ai-vindbaarheid-traject/
 * Hard direct-response offer page. Replaces old advisory/analysis version.
 * Old version archived at /ai-vindbaarheid-traject-v1/
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import { siteConfig } from '../data/site';
import { generateBreadcrumbs, generateFAQPage, generateService } from '../data/schema';

import heroPhoto from '../assets/images/founder/joost-sitting-laptop-lookingfront.webp';
import founderPhoto from '../assets/images/founder/joost-standing-relaxed.webp';
import verenaPhoto from '../assets/images/cases/verena-mann-linkedin.webp';
import jamesPhoto from '../assets/images/cases/james-mitchell-portrait.png';
import proofGoogle from '../assets/images/cases/proof-google-torrevieja.png';
import proofChatgpt from '../assets/images/cases/proof-chatgpt-local.png';
import proofVerenaAi from '../assets/images/cases/doc_veri_ai_answer_cropped.PNG';
import proofVerenaChatgpt from '../assets/images/cases/doc-veri-chatgptproof.jpeg';
// CMS screenshots moved to FAQ — imports kept for potential future use
// import keystaticDashboard from '../assets/images/keystatic1.png';
// import keystaticHomepage from '../assets/images/keystatic_edit_homepage.png';
// import keystaticBlog from '../assets/images/keystatic_add_blog.png';

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logos/*.{webp,avif,png,jpg}', { eager: true });
const logos = Object.entries(logoFiles)
  .filter(([path]) => /logo/i.test(path.split('/').pop()!))
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/, '');
    const name = filename.replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim();
    return { src: mod.default, alt: name };
  });

const locale = 'nl';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Google & AI Aanvragen Traject' },
];

const faqItems = [
  {
    q: 'Krijg ik echt een nieuwe website inbegrepen?',
    a: 'Ja, als je huidige website niet geschikt is, bouwen we een nieuw AI-ready websitefundament mee. Normaal betaal je hier al snel €2.000–€4.000 voor. Binnen dit traject zit dat fundament inbegrepen.',
  },
  {
    q: 'Wat is het verschil tussen €99 en €299?',
    a: 'Vanaf €99/mnd zetten we vooral je basis goed: een snelle, duidelijke website die Google, ChatGPT en AI-zoekmachines beter begrijpen. Vanaf €299/mnd nemen we ook de groei verder uit handen: content, reviews, Google Business, autoriteit, optimalisatie en conversie richting aanvragen.',
  },
  {
    q: 'Kom ik echt op pagina 1 in Google?',
    a: 'Voor lokale bedrijven is pagina 1 vaak realistischer dan mensen denken, vooral op dienst + regio zoektermen. Daarom bouwen we gericht op duidelijke diensten, regio\'s, bewijs, autoriteit en een sterke technische basis.',
  },
  {
    q: 'Word ik echt genoemd door ChatGPT en AI-zoekmachines?',
    a: 'Ja, dat is precies waar we je online fundament op inrichten: duidelijk genoeg worden voor AI-tools zoals ChatGPT, Perplexity en Google AI. Daarna bouwen we door naar de zoekvragen die klanten echt gebruiken.',
  },
  {
    q: 'Wat gebeurt er in de eerste 90 dagen?',
    a: 'In de eerste 90 dagen bouwen we stap voor stap aan vindbaarheid, vertrouwen en aanvragen.<br><br><strong>Week 1 — Groeiplan:</strong> kansen, zoekvragen, concurrenten en snelste route naar aanvragen.<br><br><strong>Week 2–4 — Fundament:</strong> je site wordt sneller, duidelijker en gebouwd voor Google, AI-zoekmachines en klanten.<br><br><strong>Week 4–8 — Autoriteit:</strong> reviews, Google Business, bewijs, content en lokale signalen.<br><br><strong>Week 8–12 — Optimalisatie:</strong> CTA\'s, conversie, vindbaarheid en aanvraagroute verbeteren.',
  },
  {
    q: 'Waarom geen WordPress?',
    a: 'Veel WordPress-sites worden traag en rommelig door plugins, thema\'s en updates. Wij bouwen liever een sneller, overzichtelijker fundament zonder plugin-chaos, zodat je site beter te beheren en beter te optimaliseren is.',
  },
  {
    q: 'Houd ik zelf controle over mijn website?',
    a: 'Ja. Je krijgt een beheerpaneel waarmee je zelf teksten, foto\'s, diensten en updates kunt aanpassen. Je hoeft niet voor elke kleine wijziging naar een webbouwer.<br><br>• Zelf teksten aanpassen<br>• Zelf foto\'s vervangen<br>• Blogs of updates publiceren<br>• Diensten beheren',
  },
  {
    q: 'Ben ik dan afhankelijk van NXG Media?',
    a: 'Nee, niet voor kleine inhoudelijke aanpassingen. Jij houdt controle over de inhoud. Wij beheren het technische fundament en zorgen dat de basis snel, veilig en goed ingericht blijft.',
  },
  {
    q: 'Wat moet ik zelf nog doen?',
    a: 'Bij de basisroute lever je vooral zelf input, reviews en content aan. Bij het volledig ontzorgde traject nemen wij veel meer uitvoering over, zoals content, reviewproces, Google Business en optimalisatie.',
  },
  {
    q: 'Voor wie is dit niet geschikt?',
    a: 'Dit traject is niet bedoeld voor webshops met honderden producten, SaaS-platformen, multinationals of bedrijven zonder duidelijke dienst, regio of klantwaarde. Het is juist gemaakt voor lokale dienstverleners, praktijken en specialisten waar één extra klant genoeg waarde heeft om online groei serieus te nemen.',
  },
  {
    q: 'Waarom maximaal 5 bedrijven per ronde?',
    a: 'Elk traject krijgt persoonlijke aandacht: strategie, uitvoering en optimalisatie. Dat lukt alleen als we het aantal bedrijven per ronde beperken. Bovendien nemen we maximaal één bedrijf per branche in dezelfde regio aan, zodat je nooit tegen een directe concurrent binnen het traject aankijkt.',
  },
];

const serviceSchema = generateService({
  name: 'Google & AI Aanvragen Traject',
  description: 'Pagina 1 in Google. Genoemd worden door ChatGPT, Perplexity en AI-zoekmachines. Meer aanvragen uit je website. Voor lokale dienstverleners en praktijken.',
  url: `${siteConfig.url}/ai-vindbaarheid-traject/`,
  serviceType: 'AI Visibility & Growth System',
});
---

<BaseLayout
  title="Pagina 1 in Google. Genoemd worden door ChatGPT. Meer aanvragen. | NXG Media"
  description="Pagina 1 in Google. Genoemd worden door ChatGPT en AI-zoekmachines. Meer aanvragen uit je website. Fundament vanaf €99/mnd. Check of jouw bedrijf in aanmerking komt."
  canonical={`${siteConfig.url}/ai-vindbaarheid-traject/`}
  schemas={[
    generateBreadcrumbs(breadcrumbs.map((b) => ({ name: b.label, url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}/ai-vindbaarheid-traject/` }))),
    generateFAQPage(faqItems.map(i => ({ question: i.q, answer: i.a }))),
    serviceSchema,
  ]}
  locale={locale}
>
  <BreadcrumbNav items={breadcrumbs} />


  {/* ══════════════════════════════════════════════════
      1 · HERO
      ══════════════════════════════════════════════════ */}
  <section class="relative overflow-hidden bg-primary">
    <div class="absolute inset-0 hidden md:block">
      <Image src={heroPhoto} alt="" width={800} class="absolute right-0 top-0 h-full w-auto object-cover object-top opacity-[0.15]" loading="eager" />
    </div>

    <div class="relative px-5 md:px-6 pt-12 pb-14 md:pt-16 md:pb-20">
      <div class="max-w-2xl mx-auto">
        <h1 class="font-heading text-[1.85rem] leading-[1.12] md:text-[2.75rem] md:leading-[1.1] text-white mb-5">
          Pagina 1 in Google.<br />
          Genoemd worden door ChatGPT en AI-zoekmachines.<br />
          <em class="text-accent not-italic">Meer aanvragen uit je website.</em>
        </h1>

        <p class="text-white/70 leading-relaxed mb-6 text-[0.95rem] md:text-base max-w-xl">
          Jouw volgende klant zoekt al naar jouw dienst &mdash; in Google, ChatGPT, Perplexity en andere AI-zoekmachines. Maar als zij je concurrent sneller begrijpen, gaat de aanvraag naar hem.
        </p>

        <p class="text-white/90 leading-relaxed mb-8 text-[0.95rem] md:text-base max-w-xl font-medium">
          Wij bouwen je online fundament om naar een klantenkanaal dat gevonden, vertrouwd en gekozen wordt.
        </p>

        {/* Deal card */}
        <div class="bg-white/[0.12] backdrop-blur-sm border-2 border-accent/40 rounded-card p-5 md:p-6 mb-6 max-w-md shadow-lg">
          <p class="font-heading text-4xl md:text-5xl text-white mb-1">
            Vanaf &euro;99<span class="text-lg text-white/60 font-body">/mnd</span>
          </p>
          <p class="text-white/50 text-sm mb-3">Voor bedrijven die in aanmerking komen.</p>
          <ul class="space-y-1.5 text-sm text-white/70">
            <li class="flex items-start gap-2"><span class="text-accent shrink-0 mt-0.5">&check;</span> Zichtbaar worden op pagina 1 in Google</li>
            <li class="flex items-start gap-2"><span class="text-accent shrink-0 mt-0.5">&check;</span> Genoemd worden door ChatGPT, Perplexity en Google AI</li>
            <li class="flex items-start gap-2"><span class="text-accent shrink-0 mt-0.5">&check;</span> Meer aanvragen uit je website</li>
            <li class="flex items-start gap-2"><span class="text-accent shrink-0 mt-0.5">&check;</span> AI-ready websitefundament inbegrepen als dat nodig is</li>
            <li class="flex items-start gap-2"><span class="text-accent shrink-0 mt-0.5">&check;</span> Volledig ontzorgd traject mogelijk vanaf &euro;299/mnd</li>
          </ul>
        </div>

        {/* Trajectronde badges */}
        <div class="flex flex-wrap gap-2 mb-6">
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium bg-accent/20 border border-accent/40 text-white rounded-full">
            <svg class="w-3.5 h-3.5 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" /></svg>
            Volgende trajectronde start 1 juli
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium bg-accent/20 border border-accent/40 text-white rounded-full">
            <svg class="w-3.5 h-3.5 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            Maximaal 5 bedrijven
          </span>
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium bg-accent/20 border border-accent/40 text-white rounded-full">
            <svg class="w-3.5 h-3.5 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
            1 bedrijf per branche/regio
          </span>
        </div>

        <a href="#formulier" class="inline-flex items-center gap-2 px-8 py-4 text-base font-medium text-white bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg w-full md:w-auto justify-center">
          Check of mijn bedrijf in aanmerking komt
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>

        <p class="text-white/40 text-xs mt-4">Geen betaling nu. Eerst kijken we of jouw bedrijf hiervoor in aanmerking komt.</p>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      2 · PROOF STRIP
      ══════════════════════════════════════════════════ */}
  <section class="bg-bg-alt border-b border-border/50 px-4 md:px-6 py-8 md:py-10">
    <div class="max-w-4xl mx-auto">
      <p class="text-xs uppercase tracking-widest text-accent font-medium text-center mb-5">Resultaten uit recente trajecten</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
        <div class="bg-white border-2 border-accent/20 rounded-card px-5 py-5 shadow-sm">
          <div class="flex items-center gap-3 mb-2">
            <span class="w-8 h-8 rounded-full bg-accent flex items-center justify-center text-white font-heading text-sm shrink-0">1</span>
            <p class="text-text font-heading text-base leading-snug">0 &rarr; pagina 1 in 14 dagen</p>
          </div>
          <p class="text-text-muted text-sm ml-11">Costa Blanca Movement Centre</p>
          <p class="text-accent font-medium text-sm ml-11">12&ndash;15 nieuwe patiënten/mnd</p>
        </div>
        <div class="bg-white border-2 border-accent/20 rounded-card px-5 py-5 shadow-sm">
          <div class="flex items-center gap-3 mb-2">
            <span class="w-8 h-8 rounded-full bg-accent flex items-center justify-center text-white font-heading text-sm shrink-0">2</span>
            <p class="text-text font-heading text-base leading-snug">2 &rarr; 19 aanvragen/mnd</p>
          </div>
          <p class="text-text-muted text-sm ml-11">Dr. Verena Mann</p>
          <p class="text-accent font-medium text-sm ml-11">15 AI-vermeldingen in ChatGPT</p>
        </div>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      3 · GUARANTEE / RISK REVERSAL
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-10 md:py-14">
    <div class="max-w-3xl mx-auto">
      <div class="bg-white border-2 border-accent/30 rounded-card p-6 md:p-8 shadow-lg text-center relative">
        <span class="absolute -top-3 left-1/2 -translate-x-1/2 inline-block px-4 py-1 text-[0.65rem] font-medium tracking-widest uppercase bg-accent text-white rounded-full whitespace-nowrap">Google & AI vooruitgangsgarantie</span>

        <div class="w-16 h-16 rounded-full bg-accent/10 flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.746 3.746 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
          </svg>
        </div>

        <h2 class="font-heading text-2xl md:text-3xl text-text mb-4">
          Geen zichtbare vooruitgang in Google of AI? Dan werken wij gratis door.
        </h2>
        <p class="text-text-muted mb-3 text-[0.95rem] leading-relaxed max-w-xl mx-auto">
          Binnen 90 dagen moet je vooruitgang zien in Google, AI-zoekmachines of aanvragen via je website.
        </p>
        <p class="text-text font-medium mb-6 text-[1.05rem] max-w-xl mx-auto">
          Geen vooruitgang? Dan werken wij gratis door totdat er resultaat zichtbaar wordt. Zonder extra kosten.
        </p>

        <div class="flex flex-wrap justify-center gap-3">
          {['Geen nieuw traject', 'Geen extra voorstel', 'Geen slap rapport', 'Resultaat moet zichtbaar worden'].map((item) => (
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm bg-bg-alt border border-border rounded-full text-text font-medium">
              <svg class="w-3.5 h-3.5 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              {item}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      4 · PAIN + ENEMY + ANTI-WP (samengevoegd)
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-12 md:py-16 bg-bg-alt">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-3 text-center">
        Waarom je huidige website klanten kost
      </h2>
      <p class="text-text-muted text-center mb-10 max-w-2xl mx-auto text-[0.95rem] leading-relaxed">
        Je website hoeft niet lelijk te zijn om aanvragen te verliezen. Als bezoekers, Google en AI-zoekmachines je bedrijf niet snel genoeg begrijpen, gaat de aanvraag naar je concurrent.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-10">
        {/* Card 1 */}
        <div class="bg-white border border-border rounded-card p-5">
          <p class="font-heading text-base text-text mb-2">Bezoekers haken af</p>
          <p class="text-text-muted text-sm leading-relaxed mb-3">Ze snappen niet direct waarom jij de logische keuze bent. Je bewijs komt te laat, je CTA is te zwak of je aanbod voelt te onduidelijk.</p>
          <ul class="space-y-1.5">
            {['Bewijs komt te laat', 'CTA is te zwak', 'Bezoekers verdwijnen zonder contact'].map((item) => (
              <li class="flex items-start gap-2 text-sm text-text-muted">
                <svg class="w-3.5 h-3.5 text-red-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        {/* Card 2 */}
        <div class="bg-white border border-border rounded-card p-5">
          <p class="font-heading text-base text-text mb-2">Google & AI kiezen je concurrent</p>
          <p class="text-text-muted text-sm leading-relaxed mb-3">Als je dienst, regio en expertise niet scherp genoeg staan, noemen Google, ChatGPT, Perplexity en Google AI sneller een duidelijkere concurrent.</p>
          <ul class="space-y-1.5">
            {['Concurrent verschijnt eerder', 'AI noemt hem wel', 'Jij wordt niet als logische keuze gezien'].map((item) => (
              <li class="flex items-start gap-2 text-sm text-text-muted">
                <svg class="w-3.5 h-3.5 text-red-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        {/* Card 3 */}
        <div class="bg-white border border-border rounded-card p-5">
          <p class="font-heading text-base text-text mb-2">Je oude WordPress-basis remt groei af</p>
          <p class="text-text-muted text-sm leading-relaxed mb-3">Veel MKB-sites hangen aan elkaar van plugins, oude thema's en losse SEO-pleisters. Dat kost snelheid, vertrouwen en aanvragen.</p>
          <ul class="space-y-1.5">
            {['Traag door plugins', 'Updates breken dingen', 'SEO op oude basis blijft pleisterwerk'].map((item) => (
              <li class="flex items-start gap-2 text-sm text-text-muted">
                <svg class="w-3.5 h-3.5 text-red-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>

      {/* Vergelijking */}
      <h3 class="font-heading text-xl md:text-2xl text-text mb-6 text-center">
        Een websitebouwer bouwt pagina's. Wij bouwen een klantenkanaal.
      </h3>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 max-w-3xl mx-auto mb-8">
        <div class="border border-border rounded-card p-5 bg-white/50">
          <p class="text-text-muted text-xs uppercase tracking-widest font-medium mb-3">Klassieke websitebouwer</p>
          <ul class="space-y-2">
            {['Mooie site', 'Design eerst', 'SEO later', 'WordPress + plugins', 'Opleveren en weg'].map((item) => (
              <li class="flex items-start gap-2 text-sm text-text-muted">
                <svg class="w-3.5 h-3.5 text-red-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="border-2 border-accent/30 rounded-card p-5 bg-white shadow-lg relative">
          <span class="absolute -top-3 left-6 inline-block px-3 py-0.5 text-[0.65rem] font-medium tracking-widest uppercase bg-accent text-white rounded-full">NXG Media</span>
          <p class="text-text text-xs uppercase tracking-widest font-medium mb-3">Klantenkanaal</p>
          <ul class="space-y-2">
            {['Google & AI als uitgangspunt', 'Dienst + regio scherp', 'Bewijs vóór de CTA', 'Geen WordPress-chaos', 'Gebouwd voor aanvragen'].map((item) => (
              <li class="flex items-start gap-2 text-sm text-text font-medium">
                <svg class="w-3.5 h-3.5 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <p class="text-text font-medium text-center text-[1.05rem] mb-6">
        De site is het middel. Meer aanvragen is het doel.
      </p>

