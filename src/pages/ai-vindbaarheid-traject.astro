---
/**
 * Google & AI Aanvragen Traject — /ai-vindbaarheid-traject/
 * Hard direct-response offer page. Replaces old advisory/analysis version.
 * Old version archived at /ai-vindbaarheid-traject-v1/
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import { siteConfig } from '../data/site';
import { generateBreadcrumbs, generateFAQPage, generateService } from '../data/schema';

import heroPhoto from '../assets/images/founder/joost-sitting-laptop-lookingfront.webp';
import founderPhoto from '../assets/images/founder/joost-standing-relaxed.webp';
import verenaPhoto from '../assets/images/cases/verena-mann-linkedin.webp';
import jamesPhoto from '../assets/images/cases/james-mitchell-portrait.png';
import proofGoogle from '../assets/images/cases/proof-google-torrevieja.png';
import proofChatgpt from '../assets/images/cases/proof-chatgpt-local.png';
import proofVerenaAi from '../assets/images/cases/doc_veri_ai_answer_cropped.PNG';
import proofVerenaChatgpt from '../assets/images/cases/doc-veri-chatgptproof.jpeg';
import rolfPhoto from '../assets/images/logos/rolf-profile-photo-happywithyoga.png';
import proofHwyWhatsapp from '../assets/images/cases/rolf-happywithyoga-whatsapp-proof.webp';
import keystaticDashboard from '../assets/images/keystatic1.png';
import keystaticHomepage from '../assets/images/keystatic_edit_homepage.png';
import keystaticBlog from '../assets/images/keystatic_add_blog.png';

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logos/*.{webp,avif,png,jpg}', { eager: true });
const logos = Object.entries(logoFiles)
  .filter(([path]) => /logo/i.test(path.split('/').pop()!))
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/, '');
    const name = filename.replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim();
    return { src: mod.default, alt: name };
  });

const locale = 'nl';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Google & AI Aanvragen Traject' },
];

const faqItems = [
  {
    q: 'Krijg ik echt een complete nieuwe website inbegrepen?',
    a: 'Ja. Als je huidige website niet geschikt is, bouwen we een complete AI-ready website op een premium fundament mee. Normaal betaal je hier al snel €2.000–€4.000 voor. Binnen dit traject zit dat inbegrepen.<br><br>Met fundament bedoelen we geen simpele starter-site, maar een snelle, moderne website-architectuur die beter geschikt is voor Google, AI-zoekmachines, snelheid en conversie dan standaard WordPress/Wix-oplossingen. Inclusief homepage, diensten/aanbod, bewijs/reviews, duidelijke contactroute, hosting, onderhoud en beheerpaneel.<br><br>Webshops, complexe platformen en uitgebreid maatwerk vallen hier niet onder.',
  },
  {
    q: 'Wat krijg ik precies bij het AI & Google Fundament van €99/mnd?',
    a: 'Dit pakket is voor bedrijven die hun fundament goed willen zetten en daarna zelf content, reviews en input willen aanleveren. Wij zorgen voor de complete AI-ready website op premium fundament, hosting, onderhoud, monitoring en concrete verbeterpunten. Jij voert de groei-acties grotendeels zelf uit.<br><br>• Complete AI-ready website op premium fundament<br>• Hosting en onderhoud<br>• Maandelijkse Google & AI-monitoring<br>• Concrete suggesties voor content, reviews en pagina\'s<br>• Beheerpaneel om zelf teksten, foto\'s en updates aan te passen<br>• Geen losse Wix-, WordPress- of hostingkosten meer nodig<br>• Jij levert zelf reviews, foto\'s, input en extra content aan',
  },
  {
    q: 'Wat krijg ik extra bij de 90-dagen Google & AI Groeitraject van €299/mnd?',
    a: 'Dit pakket is voor bedrijven die willen dat wij de groei-acties uitvoeren. We doen niet alleen het fundament, maar bouwen actief aan vindbaarheid, autoriteit, vertrouwen en aanvragen.<br><br>• Zoekvragen- en concurrentieonderzoek<br>• Dienst- en regiopagina\'s<br>• SEO/AI-content schrijven en plaatsen<br>• Google Business optimalisatie<br>• Reviewproces en reviewtemplates<br>• Reviews verwerken op de website<br>• FAQ\'s en bewijsblokken toevoegen<br>• CTA\'s en conversie verbeteren<br>• Maandelijkse Google & AI-check',
  },
  {
    q: 'Wat gebeurt er na de 90-dagen sprint?',
    a: 'Na de sprint kun je naar behoud & monitoring vanaf €79/mnd. Dan houden we je website online, snel en up-to-date, monitoren we je zichtbaarheid en zorgen we dat je fundament niet stilvalt. Grotere nieuwe pagina\'s, campagnes of extra content kunnen apart worden toegevoegd.',
  },
  {
    q: 'Waarom zou ik €299/mnd kiezen als er ook een €99/mnd optie is?',
    a: 'Het €99/mnd pakket is vooral bedoeld als fundament + richting. Jij moet dan zelf reviews, content en verbeteringen aanleveren. Bij €299/mnd voeren wij de groeiacties uit: onderzoek, pagina\'s, content, Google Business, reviews en optimalisatie richting aanvragen. Je betaalt dus vooral voor uitvoering en snelheid.',
  },
  {
    q: 'Kom ik echt op pagina 1 in Google?',
    a: 'Voor lokale bedrijven is pagina 1 vaak realistischer dan mensen denken, vooral op dienst + regio zoektermen. Daarom bouwen we gericht op duidelijke diensten, regio\'s, bewijs, autoriteit en een sterke technische basis.',
  },
  {
    q: 'Word ik echt genoemd door ChatGPT en AI-zoekmachines?',
    a: 'Ja, dat is precies waar we je online fundament op inrichten: duidelijk genoeg worden voor AI-tools zoals ChatGPT, Perplexity en Google AI. Daarna bouwen we door naar de zoekvragen die klanten echt gebruiken.',
  },
  {
    q: 'Wat doen jullie precies in het traject?',
    a: 'We bouwen aan drie dingen: beter gevonden worden, sneller vertrouwen opbouwen en meer aanvragen krijgen. Dat doen we via je websitefundament, Google/AI-structuur, dienst- en regiopagina\'s, reviews, Google Business, sterke CTA\'s en maandelijkse optimalisatie.<br><br>• <strong>Gevonden worden:</strong> Google, ChatGPT, Perplexity en Google AI begrijpen je bedrijf beter.<br>• <strong>Vertrouwd worden:</strong> reviews, bewijs en expertise staan op de juiste plekken.<br>• <strong>Aanvragen krijgen:</strong> je website krijgt een duidelijke route naar contact.',
  },
  {
    q: 'Wat gebeurt er in de eerste 90 dagen?',
    a: 'In de eerste 90 dagen bouwen we stap voor stap aan vindbaarheid, vertrouwen en aanvragen.<br><br><strong>Week 1 — Groeiplan:</strong> kansen, zoekvragen, concurrenten en snelste route naar aanvragen.<br><br><strong>Week 2–4 — Fundament:</strong> je site wordt sneller, duidelijker en gebouwd voor Google, AI-zoekmachines en klanten.<br><br><strong>Week 4–8 — Autoriteit:</strong> reviews, Google Business, bewijs, content en lokale signalen.<br><br><strong>Week 8–12 — Optimalisatie:</strong> CTA\'s, conversie, vindbaarheid en aanvraagroute verbeteren.',
  },
  {
    q: 'Waarom geen WordPress?',
    a: 'Veel WordPress-sites worden traag en rommelig door plugins, thema\'s en updates. Wij bouwen liever een snelle, moderne website op een premium fundament zonder plugin-chaos, zodat je site beter te beheren en beter te optimaliseren is.',
  },
  {
    q: 'Heb ik mijn huidige Wix, WordPress of hosting dan nog nodig?',
    a: 'Meestal niet. Als we je website overzetten naar ons AI-ready premium fundament, zitten hosting, onderhoud en beheerpaneel inbegrepen. Je hebt dan geen losse Wix-, WordPress-, plugin- of hostingkosten meer nodig. We bekijken vooraf wat er bij jouw huidige situatie logisch is, zodat je niets dubbel betaalt.',
  },
  {
    q: 'Houd ik zelf controle over mijn website?',
    a: 'Ja. Je krijgt een beheerpaneel waarmee je zelf teksten, foto\'s, diensten en updates kunt aanpassen. Je hoeft niet voor elke kleine wijziging naar een webbouwer.<br><br>• Zelf teksten aanpassen<br>• Zelf foto\'s vervangen<br>• Blogs of updates publiceren<br>• Diensten beheren',
  },
  {
    q: 'Ben ik dan afhankelijk van NXG Media?',
    a: 'Nee, niet voor kleine inhoudelijke aanpassingen. Jij houdt controle over de inhoud. Wij beheren het technische fundament en zorgen dat alles snel, veilig en goed ingericht blijft.',
  },
  {
    q: 'Wat moet ik zelf nog doen?',
    a: 'Bij het €99/mnd fundament lever je vooral zelf input, reviews en content aan. Bij het volledig ontzorgde traject nemen wij veel meer uitvoering over, zoals content, reviewproces, Google Business en optimalisatie.',
  },
  {
    q: 'Voor wie is dit niet geschikt?',
    a: 'Dit traject is niet bedoeld voor webshops met honderden producten, SaaS-platformen, multinationals of bedrijven zonder duidelijke dienst, regio of klantwaarde. Het is juist gemaakt voor lokale dienstverleners, praktijken en specialisten waar één extra klant genoeg waarde heeft om online groei serieus te nemen.',
  },
  {
    q: 'Waarom maximaal 5 bedrijven per ronde?',
    a: 'Elk traject krijgt persoonlijke aandacht: strategie, uitvoering en optimalisatie. Dat lukt alleen als we het aantal bedrijven per ronde beperken. Bovendien nemen we maximaal één bedrijf per branche in dezelfde regio aan, zodat je nooit tegen een directe concurrent binnen het traject aankijkt.',
  },
  {
    q: 'Hoe bepalen jullie of er vooruitgang is?',
    a: 'We starten altijd met een 0-meting. Daarin leggen we vast hoe je bedrijf nu zichtbaar is in Google, ChatGPT, Perplexity, Google AI en je website. We kijken naar relevante zoektermen, AI-vermeldingen, websitefundament, content, bewijs en aanvraagroute.<br><br>Na 90 dagen vergelijken we de resultaten met die nulmeting. Geen duidelijke vooruitgang in Google, AI-zichtbaarheid of aanvragen? Dan werken we gratis door.',
  },
  {
    q: 'Kunnen jullie ook meten wat bezoekers doen op mijn website?',
    a: 'Ja. We kunnen tracking en optimalisatie toevoegen, zoals Google Tag Manager, Meta Pixel, Microsoft Clarity, formuliertracking en conversiemeting. Daarmee zien we waar bezoekers afhaken en welke pagina\'s, CTA\'s of formulieren beter kunnen. Dit is vooral interessant zodra je website live staat en er verkeer op komt.',
  },
  {
    q: 'Wat kunnen jullie na de eerste 90 dagen blijven doen?',
    a: 'Na de eerste 90 dagen kunnen we doorgaan met behoud, monitoring en groei. Denk aan extra dienst- en regiopagina\'s, SEO/AI-content, Google Business optimalisatie, reviewproces, conversie-optimalisatie, Microsoft Clarity analyses, A/B-tests en tracking via Meta Pixel of Google Tag Manager.',
  },
];

const serviceSchema = generateService({
  name: 'Google & AI Aanvragen Traject',
  description: 'Pagina 1 in Google. Genoemd worden door ChatGPT, Perplexity en AI-zoekmachines. Meer aanvragen uit je website. Voor lokale dienstverleners en praktijken.',
  url: `${siteConfig.url}/ai-vindbaarheid-traject/`,
  serviceType: 'AI Visibility & Growth System',
});
---

<BaseLayout
  title="Pagina 1 in Google. Genoemd worden door ChatGPT. Meer aanvragen. | NXG Media"
  description="Pagina 1 in Google. Genoemd worden door ChatGPT en AI-zoekmachines. Meer aanvragen uit je website. Fundament vanaf €99/mnd. Check of jouw bedrijf in aanmerking komt."
  canonical={`${siteConfig.url}/ai-vindbaarheid-traject/`}
  schemas={[
    generateBreadcrumbs(breadcrumbs.map((b) => ({ name: b.label, url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}/ai-vindbaarheid-traject/` }))),
    generateFAQPage(faqItems.map(i => ({ question: i.q, answer: i.a }))),
    serviceSchema,
  ]}
  locale={locale}
  hideNewsletter={true}
  hideStickyMobileCTA={true}
>
  <BreadcrumbNav items={breadcrumbs} />


  {/* ══════════════════════════════════════════════════
      1 · HERO
      ══════════════════════════════════════════════════ */}
  <section class="relative overflow-hidden bg-primary">
    <div class="absolute inset-0 hidden md:block">
      <Image src={heroPhoto} alt="" width={800} class="absolute right-0 top-0 h-full w-auto object-cover object-top opacity-[0.15]" loading="eager" />
    </div>

    <div class="relative px-5 md:px-6 pt-10 pb-10 md:pt-14 md:pb-16">
      <div class="max-w-2xl mx-auto">
        <h1 class="font-heading text-[1.75rem] leading-[1.15] md:text-[2.75rem] md:leading-[1.1] text-white mb-4">
          Pagina 1 in Google.<br />
          Genoemd worden door ChatGPT en AI-zoekmachines.<br />
          <em class="text-accent not-italic">Meer aanvragen uit je website.</em>
        </h1>

        <p class="text-white/70 leading-relaxed mb-2 text-[0.9rem] md:text-base max-w-xl">
          Jouw volgende klant zoekt al. Als Google, AI en bezoekers je concurrent sneller begrijpen, gaat de aanvraag naar hem.
        </p>
        <p class="text-white/90 font-medium mb-5 text-[0.9rem] md:text-base max-w-xl">
          Wij bouwen je website om van online visitekaartje naar klantenkanaal.
        </p>

        {/* Compact deal card */}
        <div class="bg-white/[0.12] backdrop-blur-sm border-2 border-accent/40 rounded-card p-4 md:p-5 mb-5 max-w-md shadow-lg">
          <div class="flex items-baseline gap-2 mb-1">
            <p class="font-heading text-3xl md:text-4xl text-white">Vanaf &euro;99<span class="text-base text-white/60 font-body">/mnd</span></p>
          </div>
          <p class="text-white/50 text-xs mb-3">Voor bedrijven die in aanmerking komen &middot; Volgende ronde: 1 juli &middot; Max 5 bedrijven &middot; 1 per branche/regio</p>
          <ul class="space-y-1 text-sm text-white/70">
            <li class="flex items-start gap-2"><span class="text-accent shrink-0 mt-0.5">&check;</span> Pagina 1 in Google als doel</li>
            <li class="flex items-start gap-2"><span class="text-accent shrink-0 mt-0.5">&check;</span> Genoemd worden door ChatGPT, Perplexity en Google AI</li>
            <li class="flex items-start gap-2"><span class="text-accent shrink-0 mt-0.5">&check;</span> Complete AI-ready website op premium fundament inbegrepen</li>
          </ul>
        </div>

        <a href="#formulier" class="inline-flex items-center gap-2 px-8 py-4 text-base font-medium text-white bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg w-full md:w-auto justify-center">
          Check of mijn bedrijf in aanmerking komt
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>

        <p class="text-white/40 text-xs mt-3">Geen betaling nu. Eerst kijken we of jouw bedrijf past.</p>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      2 · PROOF STRIP
      ══════════════════════════════════════════════════ */}
  <section class="bg-bg-alt border-b border-border/50 px-4 md:px-6 py-8 md:py-10">
    <div class="max-w-4xl mx-auto">
      <p class="text-xs uppercase tracking-widest text-accent font-medium text-center mb-5">Resultaten uit recente trajecten</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">

        {/* CBMC proof card */}
        <div class="bg-white border-2 border-accent/20 rounded-card overflow-hidden shadow-sm">
          <div class="px-5 pt-5 pb-4">
            <div class="flex items-center gap-3 mb-3">
              <Image src={jamesPhoto} alt="James Mitchell" width={40} height={40} class="w-10 h-10 rounded-full object-cover shrink-0 border-2 border-accent/20" />
              <div>
                <p class="text-text font-medium text-sm leading-tight">Costa Blanca Movement Centre</p>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 text-[0.6rem] font-semibold uppercase tracking-wider bg-accent/10 text-accent rounded-full mt-0.5">Google &amp; AI proof</span>
              </div>
            </div>
            <p class="text-text font-heading text-lg leading-snug mb-0.5">Van 0 naar pagina 1 in Google<span class="block text-sm font-body text-text-muted">binnen 14 dagen</span></p>
            <p class="text-accent font-semibold text-sm">12&ndash;15 nieuwe pati&euml;nten/mnd</p>
          </div>
          <div class="px-5 pb-4">
            <button type="button" class="proof-trigger cursor-pointer group w-full text-left">
              <div class="rounded-lg overflow-hidden border border-border/50">
                <Image src={proofGoogle} alt="Google pagina 1 bewijs — klik om te vergroten" width={1200} quality={90} class="w-full h-auto opacity-90 group-hover:opacity-100 transition-opacity" />
              </div>
              <p class="text-text-muted text-[0.6rem] text-center mt-1 group-hover:text-text transition-colors">Klik om te vergroten</p>
            </button>
          </div>
        </div>

        {/* Verena proof card */}
        <div class="bg-white border-2 border-accent/20 rounded-card overflow-hidden shadow-sm">
          <div class="px-5 pt-5 pb-4">
            <div class="flex items-center gap-3 mb-3">
              <Image src={verenaPhoto} alt="Dr. Verena Mann" width={40} height={40} class="w-10 h-10 rounded-full object-cover shrink-0 border-2 border-accent/20" />
              <div>
                <p class="text-text font-medium text-sm leading-tight">Dr. Verena Mann</p>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 text-[0.6rem] font-semibold uppercase tracking-wider bg-primary/10 text-primary rounded-full mt-0.5">AI proof</span>
              </div>
            </div>
            <p class="text-text font-heading text-lg leading-snug mb-0.5">2 &rarr; 19 aanvragen/mnd</p>
            <p class="text-accent font-semibold text-sm">15 AI-vermeldingen in ChatGPT</p>
          </div>
          <div class="px-5 pb-4">
            <button type="button" class="proof-trigger cursor-pointer group w-full text-left">
              <div class="rounded-lg overflow-hidden border border-border/50">
                <Image src={proofVerenaAi} alt="ChatGPT AI-vermelding bewijs — klik om te vergroten" width={1200} quality={90} class="w-full h-auto opacity-90 group-hover:opacity-100 transition-opacity" />
              </div>
              <p class="text-text-muted text-[0.6rem] text-center mt-1 group-hover:text-text transition-colors">Klik om te vergroten</p>
            </button>
          </div>
        </div>

      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      3 · GUARANTEE / RISK REVERSAL
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-10 md:py-14">
    <div class="max-w-3xl mx-auto">
      <div class="bg-white border-2 border-accent/30 rounded-card p-6 md:p-8 shadow-lg text-center relative">
        <span class="absolute -top-3 left-1/2 -translate-x-1/2 inline-block px-4 py-1 text-[0.65rem] font-medium tracking-widest uppercase bg-accent text-white rounded-full whitespace-nowrap">Google & AI vooruitgangsgarantie</span>

        <div class="w-16 h-16 rounded-full bg-accent/10 flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.746 3.746 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
          </svg>
        </div>

        <h2 class="font-heading text-2xl md:text-3xl text-text mb-4">
          Geen zichtbare vooruitgang in Google of AI? Dan werken wij gratis door.
        </h2>
        <p class="text-text-muted mb-3 text-[0.95rem] leading-relaxed max-w-xl mx-auto">
          Binnen 90 dagen moet je vooruitgang zien in Google, AI-zoekmachines of aanvragen via je website.
        </p>
        <p class="text-text font-medium mb-6 text-[1.05rem] max-w-xl mx-auto">
          Geen vooruitgang? Dan werken wij gratis door totdat er resultaat zichtbaar wordt. Zonder extra kosten.
        </p>

        <div class="flex flex-wrap justify-center gap-3 mb-4">
          {['Geen nieuw traject', 'Geen extra voorstel', 'Geen slap rapport', 'Resultaat moet zichtbaar worden'].map((item) => (
            <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm bg-bg-alt border border-border rounded-full text-text font-medium">
              <svg class="w-3.5 h-3.5 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              {item}
            </span>
          ))}
        </div>
        <p class="text-text-muted text-xs text-center">Vooruitgang meten we op basis van een 0-meting bij de start.</p>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      4 · ENEMY — WEBSITEBEHEERDER VS MARKETEER
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-10 md:py-14 bg-bg-alt">
    <div class="max-w-3xl mx-auto">
      <h2 class="font-heading text-xl md:text-2xl text-text mb-1 text-center leading-snug">
        Je websitepersoon beheert je site.<br class="hidden md:inline" />
        Maar wordt hij afgerekend op aanvragen?
      </h2>
      <p class="text-text-muted text-center text-[0.9rem] mb-5 max-w-xl mx-auto">
        Veel ondernemers hebben al &lsquo;een mannetje&rsquo;, webbouwer of bureau. Prima voor updates en kleine aanpassingen. Maar een tekst aanpassen is geen groeistrategie.
      </p>

      {/* Herkenningschips */}
      <div class="flex flex-wrap justify-center gap-2 mb-6">
        {['Ik heb al iemand voor mijn website', 'Hij past af en toe iets aan', 'Maar er komen weinig aanvragen uit'].map((item) => (
          <span class="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium bg-white border border-border text-text-muted rounded-full">
            <svg class="w-3 h-3 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            {item}
          </span>
        ))}
      </div>

      {/* Vergelijking — compact */}
