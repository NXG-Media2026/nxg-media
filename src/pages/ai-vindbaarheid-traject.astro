<script is:inline>
(function() {
  // Lightbox
  var lb = document.getElementById('proof-lightbox');
  var lbImg = document.getElementById('proof-img');
  var lbClose = document.getElementById('proof-close');
  if (!lb || !lbImg) return;

  document.querySelectorAll('.proof-trigger').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var img = btn.querySelector('img');
      if (!img) return;
      lbImg.src = img.src;
      lbImg.alt = img.alt;
      lb.classList.remove('hidden');
      lb.classList.add('flex');
      document.body.style.overflow = 'hidden';
    });
  });

  function closeLb() {
    lb.classList.add('hidden');
    lb.classList.remove('flex');
    lbImg.src = '';
    document.body.style.overflow = '';
  }

  if (lbClose) lbClose.addEventListener('click', closeLb);
  lb.addEventListener('click', function(e) { if (e.target === lb) closeLb(); });
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape' && !lb.classList.contains('hidden')) closeLb(); });
})();
</script>


<script is:inline>
(function() {
  // Sticky CTA: hide when form visible
  var sticky = document.getElementById('sticky-cta');
  if (!sticky) return;
  var formEl = document.getElementById('formulier');
  if (!formEl) return;

  var observer = new IntersectionObserver(function(entries) {
    sticky.style.display = entries[0].isIntersecting ? 'none' : 'block';
  }, { threshold: 0.1 });
  observer.observe(formEl);
})();
</script>


<script is:inline>
(function() {
  var form = document.getElementById('traject-form');
  var thanks = document.getElementById('traject-thanks');
  var microcopy = document.getElementById('traject-microcopy');
  if (!form || !thanks) return;

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    var data = new FormData(form);
    var naam = data.get('naam');
    var email = data.get('email');
    var telefoon = data.get('telefoon');
    var website = data.get('website');

    if (!naam || !email || !website) return;

    var btn = form.querySelector('button[type="submit"]');
    if (btn) { btn.disabled = true; btn.textContent = 'Even geduld...'; }

    // Collect all form data
    var doelen = data.getAll('doel');
    var commitment = data.get('commitment') || '';
    var routeVoorkeur = data.get('route_voorkeur') || '';
    var vraagParts = [];
    if (doelen.length > 0) vraagParts.push('Doelen: ' + doelen.join(', '));
    if (commitment) vraagParts.push('Commitment: ' + commitment);
    if (routeVoorkeur) vraagParts.push('Route voorkeur: ' + routeVoorkeur);

    var payload = {
      naam: naam,
      email: email,
      telefoon: telefoon || '',
      websiteUrl: website,
      vraag: vraagParts.length > 0 ? vraagParts.join('\n') : 'Check aanvraag',
      source: 'traject-hard-offer',
    };

    if (typeof fbq === 'function') {
      fbq('track', 'Lead', { content_name: 'traject-hard-offer', content_category: 'ai-vindbaarheid-traject' });
    }
    if (typeof trackEvent === 'function') {
      trackEvent('scanner_request_submitted', {
        page_type: 'service',
        page_slug: 'ai-vindbaarheid-traject',
        locale: 'nl',
        cta_location: 'inline',
      });
    }

    fetch('https://scanner.nxg-media.com/api/gratis-check', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(payload),
    }).then(function() {
      showThanks();
    }).catch(function() {
      showThanks();
    });

    function showThanks() {
      form.classList.add('hidden');
      thanks.classList.remove('hidden');
      if (microcopy) microcopy.classList.add('hidden');
    }
  });
})();
</script>
