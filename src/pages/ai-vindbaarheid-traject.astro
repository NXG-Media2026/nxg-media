---
/**
 * Google & AI Aanvragen Traject — /ai-vindbaarheid-traject/
 * Hard direct-response offer page. Replaces old advisory/analysis version.
 * Old version archived at /ai-vindbaarheid-traject-v1/
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import { siteConfig } from '../data/site';
import { generateBreadcrumbs, generateFAQPage, generateService } from '../data/schema';

import heroPhoto from '../assets/images/founder/joost-sitting-laptop-lookingfront.webp';
import founderPhoto from '../assets/images/founder/joost-standing-relaxed.webp';
import verenaPhoto from '../assets/images/cases/verena-mann-linkedin.webp';
import jamesPhoto from '../assets/images/cases/james-mitchell-portrait.png';
import proofGoogle from '../assets/images/cases/proof-google-torrevieja.png';
import proofChatgpt from '../assets/images/cases/proof-chatgpt-local.png';
import proofVerenaAi from '../assets/images/cases/doc_veri_ai_answer_cropped.PNG';
import proofVerenaChatgpt from '../assets/images/cases/doc-veri-chatgptproof.jpeg';
import keystaticDashboard from '../assets/images/keystatic1.png';
import keystaticHomepage from '../assets/images/keystatic_edit_homepage.png';
import keystaticBlog from '../assets/images/keystatic_add_blog.png';

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logos/*.{webp,avif,png,jpg}', { eager: true });
const logos = Object.entries(logoFiles)
  .filter(([path]) => /logo/i.test(path.split('/').pop()!))
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/, '');
    const name = filename.replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim();
    return { src: mod.default, alt: name };
  });

const locale = 'nl';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Google & AI Aanvragen Traject' },
];

const faqItems = [
  {
    q: 'Krijg ik echt een nieuwe website inbegrepen?',
    a: 'Als je huidige website niet geschikt is, bouwen we een nieuw AI-ready websitefundament mee. Normaal betaal je hier al snel €2.000–€4.000 voor. Binnen dit traject zit dat fundament inbegrepen.',
  },
  {
    q: 'Wat is het verschil tussen €99 en €299?',
    a: 'Vanaf €99/mnd zetten we vooral je basis goed: een snelle, duidelijke website die Google, AI-zoekmachines en klanten beter begrijpen. Vanaf €299/mnd nemen we ook de groei verder uit handen: content, reviews, Google Business, autoriteit, optimalisatie en conversie richting aanvragen.',
  },
  {
    q: 'Kom ik echt op pagina 1 in Google?',
    a: 'Voor lokale bedrijven is pagina 1 vaak realistischer dan mensen denken, vooral op dienst + regio zoektermen. Daarom bouwen we gericht op duidelijke diensten, regio\'s, bewijs, autoriteit en een sterke technische basis.',
  },
  {
    q: 'Word ik echt genoemd door ChatGPT en andere AI-zoekmachines?',
    a: 'Daar richten we je online fundament specifiek op in: duidelijk genoeg worden voor AI-tools zoals ChatGPT, Perplexity en Google AI. Daarna bouwen we door naar de zoekvragen die klanten echt gebruiken.',
  },
  {
    q: 'Waarom geen WordPress?',
    a: 'Veel WordPress-sites worden traag en rommelig door plugins, thema\'s en updates. Wij bouwen liever een sneller, overzichtelijker fundament zonder plugin-chaos, zodat je site beter te beheren en beter te optimaliseren is.',
  },
  {
    q: 'Houd ik zelf controle over mijn website?',
    a: 'Je krijgt een beheerpaneel waarmee je zelf teksten, foto\'s, diensten en updates kunt aanpassen. Je hoeft niet voor elke kleine wijziging naar een webbouwer.',
  },
  {
    q: 'Wat moet ik zelf nog doen?',
    a: 'Bij de basisroute lever je vooral zelf input, reviews en content aan. Bij het volledig ontzorgde traject nemen wij veel meer uitvoering over, zoals content, reviewproces, Google Business en optimalisatie.',
  },
  {
    q: 'Is dit voor elk bedrijf?',
    a: 'Nee. Dit is vooral voor lokale dienstverleners, praktijken en specialisten waar één extra klant genoeg waarde heeft om online groei serieus te nemen.',
  },
];

const serviceSchema = generateService({
  name: 'Google & AI Aanvragen Traject',
  description: 'Pagina 1 in Google. Genoemd worden door ChatGPT, Perplexity en AI-zoekmachines. Meer aanvragen uit je website. Voor lokale dienstverleners en praktijken.',
  url: `${siteConfig.url}/ai-vindbaarheid-traject/`,
  serviceType: 'AI Visibility & Growth System',
});
---

<BaseLayout
  title="Pagina 1 in Google. Genoemd worden door ChatGPT. Meer aanvragen. | NXG Media"
  description="Pagina 1 in Google. Genoemd worden door ChatGPT en AI-zoekmachines. Meer aanvragen uit je website. Fundament vanaf €99/mnd. Check of jouw bedrijf in aanmerking komt."
  canonical={`${siteConfig.url}/ai-vindbaarheid-traject/`}
  schemas={[
    generateBreadcrumbs(breadcrumbs.map((b) => ({ name: b.label, url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}/ai-vindbaarheid-traject/` }))),
    generateFAQPage(faqItems.map(i => ({ question: i.q, answer: i.a }))),
    serviceSchema,
  ]}
  locale={locale}
>
  <BreadcrumbNav items={breadcrumbs} />


  {/* ══════════════════════════════════════════════════
      1 · HERO
      ══════════════════════════════════════════════════ */}
  <section class="relative overflow-hidden bg-primary">
    <div class="absolute inset-0 hidden md:block">
      <Image src={heroPhoto} alt="" width={800} class="absolute right-0 top-0 h-full w-auto object-cover object-top opacity-[0.15]" loading="eager" />
    </div>

    <div class="relative px-5 md:px-6 pt-12 pb-14 md:pt-16 md:pb-20">
      <div class="max-w-2xl mx-auto">
        <h1 class="font-heading text-[1.85rem] leading-[1.12] md:text-[2.75rem] md:leading-[1.1] text-white mb-5">
          Pagina 1 in Google.<br />
          Genoemd worden door ChatGPT.<br />
          <em class="text-accent not-italic">Meer aanvragen uit je website.</em>
        </h1>

        <p class="text-white/70 leading-relaxed mb-6 text-[0.95rem] md:text-base max-w-xl">
          Jouw volgende klant zoekt al naar jouw dienst &mdash; in Google, ChatGPT, Perplexity en andere AI-zoekmachines. Maar als zij je concurrent sneller begrijpen, gaat de aanvraag naar hem.
        </p>

        <p class="text-white/90 leading-relaxed mb-8 text-[0.95rem] md:text-base max-w-xl font-medium">
          Wij bouwen je online fundament om naar een klantenkanaal dat gevonden, vertrouwd en gekozen wordt.
        </p>

        {/* Deal card */}
        <div class="bg-white/[0.12] backdrop-blur-sm border-2 border-accent/40 rounded-card p-5 md:p-6 mb-6 max-w-md shadow-lg">
          <p class="font-heading text-4xl md:text-5xl text-white mb-2">
            Vanaf &euro;99<span class="text-lg text-white/60 font-body">/mnd</span>
          </p>
          <ul class="space-y-1.5 mt-3 text-sm text-white/70">
            <li class="flex items-start gap-2"><span class="text-accent shrink-0 mt-0.5">&check;</span> Zichtbaar worden op pagina 1 in Google</li>
            <li class="flex items-start gap-2"><span class="text-accent shrink-0 mt-0.5">&check;</span> Genoemd worden door ChatGPT, Perplexity en AI-zoekmachines</li>
            <li class="flex items-start gap-2"><span class="text-accent shrink-0 mt-0.5">&check;</span> Meer aanvragen uit je website</li>
            <li class="flex items-start gap-2"><span class="text-accent shrink-0 mt-0.5">&check;</span> Websitefundament inbegrepen als dat nodig is</li>
            <li class="flex items-start gap-2"><span class="text-accent shrink-0 mt-0.5">&check;</span> Actief groeitraject mogelijk vanaf &euro;299/mnd</li>
          </ul>
        </div>

        <a href="#formulier" class="inline-flex items-center gap-2 px-8 py-4 text-base font-medium text-white bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg w-full md:w-auto justify-center">
          Check of mijn bedrijf in aanmerking komt
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>

        <p class="text-white/40 text-xs mt-4">Geen betaling nu. Eerst kijken we of jouw bedrijf hiervoor in aanmerking komt.</p>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      2 · PROOF STRIP
      ══════════════════════════════════════════════════ */}
  <section class="bg-bg-alt border-b border-border/50 px-4 md:px-6 py-8 md:py-10">
    <div class="max-w-4xl mx-auto">
      <p class="text-xs uppercase tracking-widest text-accent font-medium text-center mb-5">Resultaten uit recente trajecten</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
        <div class="bg-white border-2 border-accent/20 rounded-card px-5 py-5 shadow-sm">
          <div class="flex items-center gap-3 mb-2">
            <span class="w-8 h-8 rounded-full bg-accent flex items-center justify-center text-white font-heading text-sm shrink-0">1</span>
            <p class="text-text font-heading text-base leading-snug">0 &rarr; pagina 1 in 14 dagen</p>
          </div>
          <p class="text-text-muted text-sm ml-11">Costa Blanca Movement Centre</p>
          <p class="text-accent font-medium text-sm ml-11">12&ndash;15 nieuwe patiënten/mnd</p>
        </div>
        <div class="bg-white border-2 border-accent/20 rounded-card px-5 py-5 shadow-sm">
          <div class="flex items-center gap-3 mb-2">
            <span class="w-8 h-8 rounded-full bg-accent flex items-center justify-center text-white font-heading text-sm shrink-0">2</span>
            <p class="text-text font-heading text-base leading-snug">2 &rarr; 19 aanvragen/mnd</p>
          </div>
          <p class="text-text-muted text-sm ml-11">Dr. Verena Mann</p>
          <p class="text-accent font-medium text-sm ml-11">15 AI-vermeldingen in ChatGPT</p>
        </div>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      2b · WEBSITE VALUE STACK
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-12 md:py-16">
    <div class="max-w-4xl mx-auto">
      <div class="bg-white border-2 border-accent/30 rounded-card p-6 md:p-8 shadow-lg relative">
        <span class="absolute -top-3 left-6 inline-block px-3 py-0.5 text-[0.65rem] font-medium tracking-widest uppercase bg-accent text-white rounded-full">Inbegrepen</span>

        <h2 class="font-heading text-2xl md:text-3xl text-text mb-3">
          Nieuwe AI-ready website nodig? Die zit inbegrepen.
        </h2>
        <p class="text-text-muted text-[0.95rem] leading-relaxed mb-6 max-w-2xl">
          Normaal betaal je al snel &euro;2.000&ndash;&euro;4.000 voor een moderne websitebasis. Binnen dit traject bouwen we die basis voor je mee, zodat je direct kunt starten met vindbaarheid, vertrouwen en aanvragen.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
          {[
            'Geen grote investering vooraf',
            'Geen losse webdesigner nodig',
            'Geen trage WordPress-site',
            'Direct gebouwd voor Google, AI-zoekmachines en klanten',
            'Inclusief hosting, onderhoud en beheerpaneel',
          ].map((item) => (
            <div class="flex items-start gap-2.5">
              <svg class="w-5 h-5 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              <p class="text-sm text-text font-medium leading-relaxed">{item}</p>
            </div>
          ))}
        </div>

        <a href="#formulier" class="inline-flex items-center gap-2 px-7 py-3.5 text-sm font-medium text-text-inverse bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg">
          Check of mijn bedrijf in aanmerking komt
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      3 · PAIN SECTION
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-12 md:py-16">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-3 text-center">
        Je website staat online. Maar hij wint de klant niet.
      </h2>
      <p class="text-text-muted text-center mb-4 max-w-2xl mx-auto text-[0.95rem] leading-relaxed">
        Een mooie website zonder aanvragen is geen marketingkanaal. Het is een online visitekaartje dat geld kost.
      </p>
      <p class="text-text font-medium text-center mb-8 max-w-2xl mx-auto text-[0.95rem]">
        Als Google, AI-zoekmachines en bezoekers je bedrijf niet direct begrijpen, verlies je aanvragen. Niet later. Nu.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 mb-8 max-w-3xl mx-auto">
        {[
          'Je concurrent verschijnt eerder in Google',
          'ChatGPT en Perplexity noemen hem wel en jou niet',
          'Je bewijs komt te laat',
          'Je CTA is te zwak',
          'Je diensten zijn niet scherp genoeg gepositioneerd',
          'Je bezoekers verdwijnen zonder contact op te nemen',
        ].map((item) => (
          <div class="flex items-start gap-2.5 bg-bg-alt border border-border rounded-card px-4 py-3">
            <svg class="w-4 h-4 text-red-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
            <p class="text-sm text-text-muted leading-relaxed">{item}</p>
          </div>
        ))}
      </div>

      <p class="text-text font-medium text-center text-[1.05rem]">
        Je verliest geen klanten omdat je slechter bent. Je verliest klanten omdat je online minder duidelijk bent.
      </p>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      3b · ANTI-WORDPRESS
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-12 md:py-16 bg-primary">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-white mb-3 text-center">
        Je oude WordPress-site remt je groei af
      </h2>
      <p class="text-white/70 text-center mb-3 max-w-2xl mx-auto text-[0.95rem] leading-relaxed">
        Veel MKB-websites hangen aan elkaar van plugins, verouderde thema's, trage hosting en losse SEO-trucjes.
      </p>
      <p class="text-white/90 font-medium text-center mb-8 max-w-2xl mx-auto text-[0.95rem]">
        Dat kost snelheid, vertrouwen, vindbaarheid en aanvragen.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-8 max-w-3xl mx-auto">
        {[
          'Plugins vertragen je site',
          'Updates breken je layout',
          'SEO wordt een pleister op een oude basis',
          'Bezoekers haken sneller af',
          'Google en AI-zoekmachines begrijpen je bedrijf minder goed',
          'Elke kleine wijziging kost weer tijd of geld',
        ].map((item) => (
          <div class="flex items-start gap-2.5 bg-white/[0.08] border border-white/10 rounded-card px-4 py-3">
            <svg class="w-4 h-4 text-red-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
            <p class="text-sm text-white/80 leading-relaxed">{item}</p>
          </div>
        ))}
      </div>

      <div class="bg-white/[0.12] backdrop-blur-sm border border-accent/40 rounded-card p-5 md:p-6 max-w-2xl mx-auto mb-6">
        <p class="text-white font-medium text-[0.95rem] leading-relaxed">
          <span class="text-accent font-heading">Nieuwe aanpak:</span> Wij bouwen je nieuwe fundament zonder WordPress-chaos: snel, overzichtelijk, beheersbaar en gebouwd voor Google, AI-zoekmachines en klanten.
        </p>
      </div>

      <div class="text-center">
        <a href="#formulier" class="inline-flex items-center gap-2 px-7 py-3.5 text-sm font-medium text-white bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg">
          Check of mijn bedrijf in aanmerking komt
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      4 · ENEMY SECTION
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-12 md:py-16 bg-bg-alt">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-3 text-center">
        Een gewone websitebouwer lost dit niet op.
      </h2>
      <p class="text-text-muted text-center mb-8 max-w-xl mx-auto text-[0.95rem]">
        Een webdesigner bouwt pagina's. Wij bouwen een klantenkanaal.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6">
        <div class="border border-border rounded-card p-5 md:p-6 bg-white/50">
          <p class="text-text-muted text-xs uppercase tracking-widest font-medium mb-3">Klassieke websitebouwer</p>
          <ul class="space-y-2.5">
            {['Mooie site', 'Design eerst', 'SEO later', 'Geen focus op aanvragen', 'Geen focus op AI-vindbaarheid', 'Opleveren en weg'].map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-text-muted leading-relaxed">
                <svg class="w-4 h-4 text-red-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="border-2 border-accent/30 rounded-card p-5 md:p-6 bg-white shadow-lg relative">
          <span class="absolute -top-3 left-6 inline-block px-3 py-0.5 text-[0.65rem] font-medium tracking-widest uppercase bg-accent text-white rounded-full">NXG Media</span>
          <p class="text-text text-xs uppercase tracking-widest font-medium mb-3">Klantenkanaal</p>
          <ul class="space-y-2.5">
            {['Google & AI als uitgangspunt', 'Dienst + regio scherp gepositioneerd', 'Bewijs vóór de CTA', "Pagina's gebouwd voor aanvragen", 'Websitefundament inbegrepen als dat nodig is', 'Optimaliseren op zichtbaarheid en conversie'].map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-text leading-relaxed font-medium">
                <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <p class="text-text font-medium text-center text-[0.95rem] mt-8">
        De site is het middel. Meer aanvragen is het doel.
      </p>

      <div class="text-center mt-6">
        <a href="#formulier" class="inline-flex items-center gap-2 px-7 py-3.5 text-sm font-medium text-text-inverse bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg">
          Check of mijn bedrijf in aanmerking komt
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      5 · OFFER SECTION
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-14 md:py-20">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-2 text-center">
        Het Google & AI Aanvragen Traject
      </h2>
      <p class="text-text-muted text-center mb-4 max-w-2xl mx-auto text-[0.95rem]">
        Voor bedrijven die willen dat hun website eindelijk klanten oplevert.
      </p>
      <p class="text-text-muted text-center mb-10 max-w-2xl mx-auto text-sm leading-relaxed">
        Geen losse SEO-trucjes. Geen mooie website die niets oplevert. Geen technisch rapport dat in je inbox verdwijnt. Wij bouwen aan de drie dingen die wél tellen: gevonden worden, vertrouwd worden en aanvragen krijgen.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
        {[
          { title: 'Google & AI Fundament', desc: 'Je website wordt duidelijker, sneller en beter begrijpbaar voor Google, AI-zoekmachines en bezoekers.' },
          { title: 'Dienst- en regiopagina\'s', desc: "Pagina's die aansluiten op wat jouw klanten zoeken: dienst, probleem, regio en bewijs." },
          { title: 'Bewijs en vertrouwen', desc: 'Reviews, expertise, cases en resultaten komen op de plekken waar bezoekers beslissen.' },
          { title: 'Sterke CTA\'s', desc: 'Elke belangrijke pagina krijgt een duidelijke route naar aanvraag.' },
          { title: 'AI-vermeldingen', desc: 'We richten je content zo in dat ChatGPT, Perplexity, Google AI en andere AI-zoekmachines je bedrijf begrijpen en noemen.' },
          { title: 'Autoriteit en optimalisatie', desc: 'Content, reviews, Google Business, lokale signalen en maandelijkse verbeteringen.' },
        ].map((item) => (
          <div class="bg-white border border-border rounded-card p-5">
            <p class="font-heading text-base text-text mb-1.5">{item.title}</p>
            <p class="text-text-muted text-sm leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      6 · RESULT SECTION
      ══════════════════════════════════════════════════ */}
