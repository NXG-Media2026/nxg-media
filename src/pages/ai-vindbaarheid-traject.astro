---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import CalendlyEmbed from '../components/CalendlyEmbed.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import { siteConfig } from '../data/site';
import { generateBreadcrumbs, generateFAQPage } from '../data/schema';

import heroPhoto from '../assets/images/founder/joost-sitting-laptop-lookingfront.webp';
import founderPhoto from '../assets/images/founder/joost-standing-relaxed.webp';

const locale = 'nl';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'AI Vindbaarheid', href: '/ai-vindbaarheid/' },
  { label: '90-dagen traject' },
];

const faqItems = [
  {
    question: 'Is de website echt gratis?',
    answer: 'Je betaalt geen aparte webdesignfactuur. De AI-ready websitebasis zit inbegrepen in het 90-dagen traject, omdat AI-vindbaarheid vaak begint bij een beter websitefundament. Na het traject kan de website via Website Care bij ons blijven draaien.',
  },
  {
    question: 'Wat gebeurt er na 3 maanden?',
    answer: 'Het actieve traject stopt. Wil je dat wij je website live houden, beheren en blijven controleren, dan kun je overstappen naar Website Care vanaf €99 per maand. Daarmee blijven hosting, technisch beheer en kleine updates geregeld.',
  },
  {
    question: 'Kan ik mijn huidige website houden?',
    answer: 'Dat hangt af van de technische staat. Tijdens de analyse in maand 1 beoordelen we of je huidige site geschikt is als basis. Vaak is het fundament verouderd, traag of slecht gestructureerd voor AI-systemen — dan bouwen we een nieuwe AI-ready basis mee.',
  },
  {
    question: 'Verlies ik mijn huidige ranking?',
    answer: 'We gaan zorgvuldig om met bestaande pagina’s, URL’s en redirects. Ranking kan nooit gegarandeerd worden. Heeft je huidige site veel organisch verkeer, backlinks of honderden pagina’s? Dan valt je website mogelijk buiten het standaardtraject en is een aparte migratieanalyse nodig.',
  },
  {
    question: 'Wat gebeurt er met mijn backlinks?',
    answer: 'Bestaande backlinks kunnen waardevol zijn. Daarom kijken we bij livegang naar belangrijke bestaande URL’s en redirects. Uitgebreide backlinkanalyse of linkbuilding zit niet standaard in het 90-dagen traject, maar kan als extra dienst worden toegevoegd.',
  },
  {
    question: 'Kan ik zelf aanpassingen doen aan de website?',
    answer: 'De technische omgeving beheren wij om snelheid, veiligheid en vindbaarheid te bewaken. Kleine wijzigingen kun je via e-mail of formulier doorgeven. Afhankelijk van je Website Care-pakket zijn kleine edits inbegrepen; grotere wijzigingen worden apart geprijsd.',
  },
  {
    question: 'Is dit maatwerkdesign?',
    answer: 'Dit traject levert een professionele, snelle websitebasis met bewezen structuur — geen volledig maatwerkdesign vanaf nul. Het doel is vindbaarheid en duidelijkheid, niet visuele experimenten. Heb je specifieke branding- of designwensen, dan kan dat als aanvullend traject.',
  },
  {
    question: 'Schrijven jullie ook blogartikelen?',
    answer: 'Niet standaard in het 90-dagen traject. De focus ligt eerst op je fundament: homepage, kernpagina’s, diensten, FAQ’s, techniek en structuur. GEO/SEO-artikelen kunnen daarna worden toegevoegd via Growth Care of als losse add-on.',
  },
  {
    question: 'Doen jullie ook linkbuilding?',
    answer: 'Niet standaard in het basistraject. Linkbuilding/outreach is een aparte groeidienst, omdat dit doorlopend werk vraagt en sterk afhankelijk is van branche, concurrentie en doelregio.',
  },
  {
    question: 'Voor wie is dit traject niet geschikt?',
    answer: 'Dit traject is niet bedoeld voor webshops, platforms, membershipsites of grote websites met honderden pagina’s. Ook niet voor bedrijven die onbeperkte revisies verwachten, volledig maatwerkdesign willen of vooral een goedkope website zoeken in plaats van een vindbaarheidsfundament.',
  },
];

const faqForSchema = faqItems.map((item) => ({
  question: item.question,
  answer: item.answer,
}));

const faqForComponent = faqItems.map((item) => ({ q: item.question, a: item.answer }));
---

<BaseLayout
  title="90-dagen AI-vindbaarheidstraject — Beter gevonden door Google en AI | NXG Media"
  description="In 90 dagen een websitebasis die beter klaarstaat voor Google en AI. Inclusief AI-ready websitebasis, technische SEO-basis en structured data. Voor MKB-bedrijven en lokale praktijken. €299 per maand."
  schemas={[generateBreadcrumbs(breadcrumbs.map((b) => ({ name: b.label, url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}/ai-vindbaarheid-traject/` }))), generateFAQPage(faqForSchema)]}
  locale={locale}
>
  <BreadcrumbNav items={breadcrumbs} />

  {/* ── Hero ── */}
  <section class="relative py-20 md:py-28 lg:py-36 overflow-hidden">
    <div class="absolute inset-0">
      <Image
        src={heroPhoto}
        alt="Joost van Putten — AI-vindbaarheid specialist, helpt MKB-bedrijven beter gevonden worden door Google en AI-systemen"
        widths={[800, 1200, 1600]}
        sizes="100vw"
        class="w-full h-full object-cover"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-white/95 via-white/85 to-white/40"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 md:px-6">
      <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-primary/10 text-primary rounded-full mb-6">
        90-dagen traject
      </span>
      <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl text-text mb-6 leading-tight max-w-2xl">
        In 90 dagen een websitebasis die klaarstaat voor Google en AI
      </h1>
      <p class="text-lg md:text-xl text-text-muted leading-relaxed mb-4 max-w-xl">
        Je huidige website staat misschien online, maar wordt niet altijd goed begrepen, vertrouwd of aanbevolen door AI-systemen. In dit traject verbeteren we je online fundament — inclusief een AI-ready websitebasis als je huidige site je vindbaarheid remt.
      </p>
      <p class="text-sm text-text-muted mb-10">
        3 maanden &middot; &euro;299 per maand &middot; inclusief AI-ready websitebasis &middot; voor eenvoudige MKB-websites
      </p>
      <a
        href="#gesprek"
        class="inline-flex items-center px-8 py-4 text-base font-medium text-text-inverse bg-primary hover:bg-primary-dark transition-colors rounded-button shadow-lg"
      >
        Plan je adviesgesprek
        <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>

  {/* ── Problem ── */}
  <section class="py-16 md:py-20 bg-primary">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-white mb-8">Je probleem is waarschijnlijk geen losse SEO-fix</h2>
      <p class="text-white/80 leading-relaxed mb-8 text-lg">
        De meeste MKB-websites scoren niet slecht door een ontbrekende truc. Het fundament loopt achter — en dat maakt het verschil tussen wel of niet gevonden worden door Google en AI-systemen.
      </p>
      <div class="space-y-5">
        <div class="flex items-start gap-4">
          <span class="text-white/60 text-lg shrink-0 mt-0.5">&#10005;</span>
          <p class="text-white/80 leading-relaxed">Onduidelijke dienstpagina's die niet uitleggen wat je precies doet en voor wie</p>
        </div>
        <div class="flex items-start gap-4">
          <span class="text-white/60 text-lg shrink-0 mt-0.5">&#10005;</span>
          <p class="text-white/80 leading-relaxed">Weinig bewijs, reviews of klantverhalen die je geloofwaardigheid onderbouwen</p>
        </div>
        <div class="flex items-start gap-4">
          <span class="text-white/60 text-lg shrink-0 mt-0.5">&#10005;</span>
          <p class="text-white/80 leading-relaxed">Geen FAQ- of antwoordstructuur die AI-systemen helpt om je expertise te begrijpen</p>
        </div>
        <div class="flex items-start gap-4">
          <span class="text-white/60 text-lg shrink-0 mt-0.5">&#10005;</span>
          <p class="text-white/80 leading-relaxed">Rommelige of verouderde techniek — traag, onveilig of slecht gestructureerd</p>
        </div>
        <div class="flex items-start gap-4">
          <span class="text-white/60 text-lg shrink-0 mt-0.5">&#10005;</span>
          <p class="text-white/80 leading-relaxed">Weinig signalen die Google en AI helpen om je bedrijf te plaatsen in je regio en branche</p>
        </div>
      </div>
      <p class="text-white font-medium mt-8 text-lg">
        Advies alleen is dan niet genoeg. Je hebt een beter fundament nodig.
      </p>
    </div>
  </section>

  {/* ── Timeline — visual centerpiece ── */}
  <section class="py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-4">Wat we in 90 dagen doen</h2>
      <p class="text-lg text-text-muted leading-relaxed mb-12 max-w-3xl">
        Geen eindeloos project. Drie maanden, drie fases — van scan tot livegang.
      </p>

      <div class="relative">
        {/* Vertical connector line */}
        <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-px bg-border -translate-x-1/2"></div>

        <div class="space-y-8 md:space-y-12">
          {/* Month 1 */}
          <div class="relative md:grid md:grid-cols-2 md:gap-12 items-start">
            <div class="md:text-right md:pr-8">
              <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-primary/10 text-primary rounded-full mb-3">Maand 1</span>
              <h3 class="font-heading text-xl text-text mb-2">Scan, analyse & strategie</h3>
            </div>
            <div class="md:pl-8 mt-3 md:mt-0">
              <div class="bg-white rounded-card p-5 border border-border">
                <ul class="space-y-2 text-sm text-text-muted">
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">&rarr;</span> AI-vindbaarheidsscan doorlichten en interpreteren</li>
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">&rarr;</span> Huidige websitefundament analyseren: techniek, structuur, content</li>
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">&rarr;</span> Belangrijkste diensten, regio's en concurrenten bekijken</li>
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">&rarr;</span> Sitestructuur en paginaplan opstellen</li>
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">&rarr;</span> Input verzamelen: diensten, doelgroep, foto's, reviews, bedrijfsinformatie</li>
                </ul>
                <p class="text-xs text-accent font-medium mt-4">Doel: helder plan en alle bouwstenen klaarliggen</p>
              </div>
            </div>
            <div class="hidden md:flex absolute left-1/2 top-3 -translate-x-1/2 w-8 h-8 rounded-full bg-primary text-white items-center justify-center text-sm font-heading">1</div>
          </div>

          {/* Month 2 */}
          <div class="relative md:grid md:grid-cols-2 md:gap-12 items-start">
            <div class="md:text-right md:pr-8">
              <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/10 text-accent rounded-full mb-3">Maand 2</span>
              <h3 class="font-heading text-xl text-text mb-2">Bouw, copy & structuur</h3>
            </div>
            <div class="md:pl-8 mt-3 md:mt-0">
              <div class="bg-white rounded-card p-5 border border-border">
                <ul class="space-y-2 text-sm text-text-muted">
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">&rarr;</span> AI-ready websitebasis bouwen: snel, licht, geen pluginchaos</li>
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">&rarr;</span> Homepage, kernpagina's en dienstpagina's structureren</li>
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">&rarr;</span> Websitecopy schrijven op basis van jouw input</li>
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">&rarr;</span> FAQ-/antwoordstructuur toevoegen voor Google en AI</li>
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">&rarr;</span> Basis structured data en technische SEO-basis inrichten</li>
                </ul>
                <p class="text-xs text-accent font-medium mt-4">Doel: volledige websitebasis klaar voor review</p>
              </div>
            </div>
            <div class="hidden md:flex absolute left-1/2 top-3 -translate-x-1/2 w-8 h-8 rounded-full bg-accent text-white items-center justify-center text-sm font-heading">2</div>
          </div>

          {/* Month 3 */}
          <div class="relative md:grid md:grid-cols-2 md:gap-12 items-start">
            <div class="md:text-right md:pr-8">
              <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-primary/10 text-primary rounded-full mb-3">Maand 3</span>
              <h3 class="font-heading text-xl text-text mb-2">Livegang, optimalisatie & vervolg</h3>
            </div>
            <div class="md:pl-8 mt-3 md:mt-0">
              <div class="bg-white rounded-card p-5 border border-border">
                <ul class="space-y-2 text-sm text-text-muted">
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">&rarr;</span> Correctieronde verwerken: feitelijke en visuele correcties</li>
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">&rarr;</span> Website live zetten, domein/DNS begeleiden</li>
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">&rarr;</span> Basis tracking inrichten: Clarity en/of Analytics</li>
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">&rarr;</span> Eindcheck en vervolgadvies</li>
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">&rarr;</span> Keuze voor Website Care na afloop</li>
                </ul>
                <p class="text-xs text-accent font-medium mt-4">Doel: website live en klaar voor vindbaarheid</p>
              </div>
            </div>
            <div class="hidden md:flex absolute left-1/2 top-3 -translate-x-1/2 w-8 h-8 rounded-full bg-primary text-white items-center justify-center text-sm font-heading">3</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── What you get ── */}
  <section class="py-16 md:py-20 bg-bg-alt">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-10">Wat zit er in het traject?</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
            </svg>
          </div>
          <h3 class="font-heading text-lg text-text mb-2">AI-vindbaarheidsscan + interpretatie</h3>
          <p class="text-sm text-text-muted leading-relaxed">Zichtbaarheid in AI-systemen beoordelen, zwakke plekken uitleggen en bepalen waarom je nu niet of te weinig wordt aanbevolen.</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <h3 class="font-heading text-lg text-text mb-2">Websitefundament-analyse</h3>
          <p class="text-sm text-text-muted leading-relaxed">Technische basis, platform, paginastructuur en migratierisico's beoordelen. Bepalen of je huidige site geschikt is als basis.</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-10 h-10 rounded-full bg-accent/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
            </svg>
          </div>
          <h3 class="font-heading text-lg text-text mb-2">Nieuwe AI-ready websitebasis</h3>
          <p class="text-sm text-text-muted leading-relaxed">Homepage, over-sectie, contactpagina, FAQ, 1-3 dienstpagina's. Snel, licht, mobielvriendelijk — geen WordPress-/pluginchaos.</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-10 h-10 rounded-full bg-accent/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7 21a4 4 0 01-4-4V5a2 2 0 012-2h4a2 2 0 012 2v12a4 4 0 01-4 4zm0 0h12a2 2 0 002-2v-4a2 2 0 00-2-2h-2.343M11 7.343l1.657-1.657a2 2 0 012.828 0l2.829 2.829a2 2 0 010 2.828l-8.486 8.485M7 17h.01" />
            </svg>
          </div>
          <h3 class="font-heading text-lg text-text mb-2">AI/SEO-basisstructuur</h3>
          <p class="text-sm text-text-muted leading-relaxed">Duidelijke H1/H2-structuur, FAQ-antwoordblokken, basis structured data, interne linking, bedrijfsinformatie en lokale signalen.</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
          </div>
          <h3 class="font-heading text-lg text-text mb-2">Copywriting op basis van jouw input</h3>
          <p class="text-sm text-text-muted leading-relaxed">Jij levert diensten, doelgroep, foto's en reviews aan. Wij maken er duidelijke, vindbare websitecopy van met een correctieronde.</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <h3 class="font-heading text-lg text-text mb-2">Livegang + basis tracking</h3>
          <p class="text-sm text-text-muted leading-relaxed">Website live zetten, domein/DNS begeleiden, basis Clarity/Analytics inrichten, eindcheck en duidelijk vervolgadvies.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── Why a foundation, not a report ── */}
  <section class="py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-6">
        Waarom bouwen we geen rapport, maar een nieuw fundament?
      </h2>
      <p class="text-lg text-text-muted leading-relaxed mb-6">
        AI-vindbaarheid staat niet los van je website. Als je huidige site technisch rommelig is, weinig duidelijke antwoorden geeft of niet goed uitlegbaar is voor zoekmachines, dan blijft advies vooral theorie. Daarom bouwen we binnen het traject direct aan de basis waarop Google en AI-systemen je bedrijf beter kunnen begrijpen.
      </p>
      <div class="bg-accent/5 border border-accent/20 rounded-card p-6">
        <p class="text-accent font-medium text-lg leading-relaxed">
          Geen aparte webdesignfactuur. De AI-ready websitebasis zit in het traject inbegrepen.
        </p>
      </div>
    </div>
  </section>

  {/* ── Website features ── */}
  <section class="py-16 md:py-20 bg-bg-alt">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-4">Wat maakt de nieuwe websitebasis sterker?</h2>
      <p class="text-lg text-text-muted leading-relaxed mb-10 max-w-3xl">
        Je krijgt geen zware website vol plugins, maar een snelle, lichte websitebasis die duidelijk uitlegt wie je bent, wat je doet, waar je actief bent en waarom klanten voor jou moeten kiezen.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
        {[
          'Snelle statische basis',
          'Mobielvriendelijk',
          'Technisch schoon',
          'Duidelijke dienstenstructuur',
          'FAQ/antwoordblokken',
          'Schema/structured data',
          'Interne links tussen kernpagina’s',
          'Goede basis voor Google en AI',
          'Clarity/Analytics-ready',
          'Geen WordPress/Elementor/pluginchaos',
          'Makkelijk uitbreidbaar',
          'Hosting via Website Care',
        ].map((feature) => (
          <div class="flex items-start gap-2 text-sm text-text-muted">
            <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span>{feature}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── For whom ── */}
  <section class="py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-10">Voor wie dit traject geschikt is</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {/* Suitable */}
