        Elke maand dat jouw fundament niet klopt, worden je concurrenten w&eacute;l aanbevolen.
      </h2>
      <p class="text-lg text-white/80 mb-10 max-w-2xl mx-auto">
        Je content is er. Je expertise is er. Het enige wat mist is het fundament dat ervoor zorgt dat Google en AI dat ook zien.
      </p>

      {/* Compact formulier herhaling */}
      <div class="bg-white/10 backdrop-blur rounded-card p-6 md:p-8 max-w-xl mx-auto text-left">
        <h3 class="font-heading text-xl text-white mb-4">Vul je website in &mdash; ik kijk persoonlijk mee</h3>

        <form id="form-bottom" class="traject-form space-y-4">
          <input type="hidden" name="bron" value="trajectpagina" />

          <div class="flex flex-wrap gap-x-4 gap-y-2 mb-2">
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" name="vragen" value="Wat kost het traject voor mijn site?" class="rounded border-white/30 text-accent focus:ring-accent bg-white/10" />
              <span class="text-xs text-white/80">Wat kost het?</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" name="vragen" value="Hoe sta ik ervoor vs. concurrenten?" class="rounded border-white/30 text-accent focus:ring-accent bg-white/10" />
              <span class="text-xs text-white/80">Concurrentie-check</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" name="vragen" value="Wat zou jij eerst aanpakken?" class="rounded border-white/30 text-accent focus:ring-accent bg-white/10" />
              <span class="text-xs text-white/80">Eerste stap</span>
            </label>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="checkbox" name="vragen" value="Past dit bij mijn type bedrijf?" class="rounded border-white/30 text-accent focus:ring-accent bg-white/10" />
              <span class="text-xs text-white/80">Geschiktheidscheck</span>
            </label>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-[1fr_1fr_auto] gap-3">
            <input type="url" name="website" placeholder="https://jouwwebsite.nl" required class="w-full px-4 py-3 rounded-button border border-white/20 bg-white/10 text-sm text-white placeholder:text-white/40 focus:outline-none focus:ring-2 focus:ring-accent/50" />
            <input type="email" name="email" placeholder="je@email.nl" required class="w-full px-4 py-3 rounded-button border border-white/20 bg-white/10 text-sm text-white placeholder:text-white/40 focus:outline-none focus:ring-2 focus:ring-accent/50" />
            <button type="submit" class="px-6 py-3 text-sm font-medium text-text-inverse bg-accent hover:bg-accent-dark transition-colors rounded-button whitespace-nowrap">
              Verstuur &rarr;
            </button>
          </div>

          <p class="text-xs text-white/50 text-center">Geen spam. 1 persoonlijke mail binnen 48 uur.</p>
        </form>

        <div class="form-thanks hidden text-center py-6">
          <p class="text-white font-medium">Bedankt! Ik bekijk je site en mail je binnen 48 uur.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── Sticky mobile CTA ── */}
  <div class="fixed bottom-0 inset-x-0 p-3 bg-white/95 backdrop-blur border-t border-border md:hidden z-40 sticky-cta">
    <a
      href="#formulier"
      class="flex items-center justify-center w-full px-6 py-3.5 text-sm font-medium text-text-inverse bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg"
    >
      Vraag een persoonlijke indicatie aan
      <svg class="ml-2 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
    </a>
  </div>

  {/* ── Scripts ── */}
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // ── Sticky CTA: hide when form is visible ──
      const stickyCta = document.querySelector('.sticky-cta') as HTMLElement | null;
      if (stickyCta) {
        const formSections = document.querySelectorAll('#formulier, #form-bottom');
        const observer = new IntersectionObserver(
          (entries) => {
            const anyVisible = entries.some((e) => e.isIntersecting);
            stickyCta.style.display = anyVisible ? 'none' : 'block';
          },
          { threshold: 0.1 }
        );
        formSections.forEach((el) => observer.observe(el));
      }

      // ── Form submission ──
      document.querySelectorAll('.traject-form').forEach((form) => {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const f = e.target as HTMLFormElement;
          const data = new FormData(f);

          const email = data.get('email') as string;
          const website = data.get('website') as string;
          const vragen = data.getAll('vragen').join(', ');

          const payload = {
            naam: email,
            email,
            websiteUrl: website,
            vraag: vragen || 'Persoonlijk advies aangevraagd (compact formulier)',
            source: 'trajectpagina',
            abVersion: 'a',
          };

          try {
            await fetch('https://scanner.nxg-media.com/api/gratis-check', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
              body: JSON.stringify(payload),
            });
          } catch {
            // Silently fail — show thank you regardless
          }

          // Show thank you message
          f.classList.add('hidden');
          const thanks = f.parentElement?.querySelector('.form-thanks');
          if (thanks) thanks.classList.remove('hidden');
        });
      });

      // ── Lightbox for CMS screenshots ──
      const triggers = document.querySelectorAll('.lightbox-trigger');
      if (triggers.length === 0) return;

      // Collect full-res image URLs from the Image components
      const images = Array.from(triggers).map((t) => {
        const img = t.querySelector('img');
        return img ? img.src : '';
      });

      // Create lightbox overlay
      const overlay = document.createElement('div');
      overlay.className = 'fixed inset-0 z-50 bg-black/85 hidden items-center justify-center p-4';
      overlay.id = 'lightbox';
      overlay.innerHTML = `
        <button type="button" class="absolute top-4 right-4 text-white/80 hover:text-white z-10" id="lightbox-close">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
        <img src="" alt="" class="max-w-[90vw] max-h-[90vh] rounded-lg shadow-2xl" id="lightbox-img" />
      `;
      document.body.appendChild(overlay);

      const lbImg = document.getElementById('lightbox-img') as HTMLImageElement;
      const lbClose = document.getElementById('lightbox-close');

      function openLightbox(index: number) {
        if (!images[index]) return;
        lbImg.src = images[index];
        lbImg.alt = (triggers[index] as HTMLElement).querySelector('img')?.alt || '';
        overlay.classList.remove('hidden');
        overlay.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }

      function closeLightbox() {
        overlay.classList.add('hidden');
        overlay.classList.remove('flex');
        document.body.style.overflow = '';
      }

      triggers.forEach((trigger, i) => {
        trigger.addEventListener('click', () => openLightbox(i));
      });

      lbClose?.addEventListener('click', closeLightbox);
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) closeLightbox();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeLightbox();
      });
    });
  </script>

  <style>
    details[open] .details-chevron {
      transform: rotate(180deg);
    }
  </style>

</BaseLayout>
