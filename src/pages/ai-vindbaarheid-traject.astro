---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import CalendlyEmbed from '../components/CalendlyEmbed.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import { siteConfig } from '../data/site';
import { generateBreadcrumbs, generateFAQPage } from '../data/schema';

import heroPhoto from '../assets/images/founder/joost-sitting-laptop-lookingfront.webp';
import founderPhoto from '../assets/images/founder/joost-standing-relaxed.webp';

import hwyLogo from '../assets/images/logos/happywithyoga-logo.webp';
import hwyPhoto from '../assets/images/logos/rolf-profile-photo-happywithyoga.png';
import youlifeLogo from '../assets/images/logos/youlife-logo.avif';
import youlifePhoto from '../assets/images/logos/tessa-youlife-profile-photo.png';
import josineLogo from '../assets/images/logos/coachjosine-logo.avif';
import josinePhoto from '../assets/images/logos/coachjosine-profile-photo.png';

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logos/*.{webp,avif,png,jpg}', { eager: true });
const logos = Object.entries(logoFiles)
  .filter(([path]) => /logo/i.test(path.split('/').pop()!))
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/, '');
    const name = filename.replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim();
    return { src: mod.default, alt: name };
  });

const locale = 'nl';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'AI Vindbaarheid', href: '/ai-vindbaarheid/' },
  { label: '90-dagen traject' },
];

const faqItems = [
  {
    question: 'Is de website echt inbegrepen?',
    answer: 'Je betaalt geen aparte webdesignfactuur. De AI-ready websitebasis zit inbegrepen in het traject, omdat vindbaarheid vaak begint bij een beter fundament. Na het traject kan de website via Website Care bij ons blijven draaien.',
  },
  {
    question: 'Hoe snel kan mijn nieuwe website live?',
    answer: 'Als je snel je input aanlevert (teksten, foto\'s, bedrijfsinformatie), kan de nieuwe websitebasis vaak binnen 3-4 weken live staan. De rest van het traject gebruiken we om je fundament verder te versterken.',
  },
  {
    question: 'Wat moet ik zelf aanleveren?',
    answer: 'Je levert je diensten, doelgroep, foto\'s, reviews en bedrijfsinformatie aan. Wij maken daar duidelijke, vindbare websitecopy van. Hoe sneller je input komt, hoe sneller je website live staat.',
  },
  {
    question: 'Wat gebeurt er na 90 dagen?',
    answer: 'Het actieve traject stopt. Wil je dat wij je website live houden en beheren, dan kun je overstappen naar Website Care. Daarmee blijven hosting, technisch beheer en kleine updates geregeld.',
  },
  {
    question: 'Verlies ik mijn huidige ranking?',
    answer: 'We gaan zorgvuldig om met bestaande pagina\'s, URL\'s en redirects. Ranking kan nooit gegarandeerd worden. Heeft je huidige site veel organisch verkeer of honderden pagina\'s? Dan valt je website mogelijk buiten het standaardtraject.',
  },
  {
    question: 'Wat gebeurt er met mijn backlinks?',
    answer: 'Bestaande backlinks kunnen waardevol zijn. Daarom kijken we bij livegang naar belangrijke bestaande URL\'s en redirects. Uitgebreide backlinkanalyse of linkbuilding kan als extra dienst worden toegevoegd.',
  },
  {
    question: 'Kan ik zelf aanpassingen doen?',
    answer: 'Kleine wijzigingen kun je via e-mail of formulier doorgeven. Wij verwerken ze. Zelf inloggen en aanpassen is niet mogelijk — dat beschermt de snelheid, veiligheid en vindbaarheid van je website.',
  },
  {
    question: 'Wat valt buiten het traject?',
    answer: 'Webshops, loginomgevingen, volledig maatwerkdesign, onbeperkte revisies, blogartikelen, linkbuilding, reviewprogramma\'s, ads-beheer en geavanceerde tracking zitten niet standaard in het traject. Ze kunnen wel als extra dienst worden toegevoegd.',
  },
  {
    question: 'Doen jullie ook blogs, linkbuilding en reviews?',
    answer: 'Niet standaard in het 90-dagen traject. De focus ligt eerst op je fundament. Blogartikelen, linkbuilding en reviewprogramma\'s zijn groeidiensten die je daarna kunt toevoegen wanneer je basis staat.',
  },
  {
    question: 'Waarom geen WordPress, Wix of Elementor?',
    answer: 'Voor eenvoudige MKB-websites kiezen we voor een snelle, lichte basis zonder onnodige plugins, apps of onderhoudsrisico\'s. Dat maakt je site sneller, overzichtelijker en beter vindbaar voor Google en AI-systemen.',
  },
];

const faqForSchema = faqItems.map((item) => ({
  question: item.question,
  answer: item.answer,
}));

const faqForComponent = faqItems.map((item) => ({ q: item.question, a: item.answer }));
---

<BaseLayout
  title="90-dagen AI-vindbaarheidstraject — Beter gevonden door Google en AI | NXG Media"
  description="Je website staat online, maar je fundament loopt achter. In 90 dagen verbeteren we je basis voor Google, AI en klanten — inclusief AI-ready websitebasis. €299 per maand."
  schemas={[generateBreadcrumbs(breadcrumbs.map((b) => ({ name: b.label, url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}/ai-vindbaarheid-traject/` }))), generateFAQPage(faqForSchema)]}
  locale={locale}
>
  <BreadcrumbNav items={breadcrumbs} />

  {/* ── Hero ── */}
  <section class="relative py-20 md:py-28 lg:py-36 overflow-hidden">
    <div class="absolute inset-0">
      <Image
        src={heroPhoto}
        alt="Joost van Putten — AI-vindbaarheid specialist, helpt MKB-bedrijven beter gevonden worden door Google en AI-systemen"
        widths={[800, 1200, 1600]}
        sizes="100vw"
        class="w-full h-full object-cover"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-white/95 via-white/85 to-white/40"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 md:px-6">
      <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-primary/10 text-primary rounded-full mb-6">
        90-dagen traject
      </span>
      <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl text-text mb-6 leading-tight max-w-2xl">
        Je website staat online. Maar je fundament loopt achter.
      </h1>
      <p class="text-lg md:text-xl text-text-muted leading-relaxed mb-4 max-w-xl">
        In 90 dagen verbeteren we je online basis voor Google, AI en klanten. Als je huidige website je vindbaarheid remt, bouwen we direct een nieuwe AI-ready websitebasis mee — zonder aparte webdesignfactuur.
      </p>
      <p class="text-sm text-text-muted mb-10">
        &euro;299 per maand &middot; 3 maanden &middot; inclusief AI-ready websitebasis &middot; voor ZZP'ers en MKB-bedrijven met een eenvoudige website
      </p>
      <a
        href="#gesprek"
        class="inline-flex items-center px-8 py-4 text-base font-medium text-text-inverse bg-primary hover:bg-primary-dark transition-colors rounded-button shadow-lg"
      >
        Plan mijn adviesgesprek
        <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
      <p class="text-xs text-text-muted mt-6">
        7+ jaar ervaring &middot; &euro;5M+ advertentiebudget beheerd &middot; 50+ ondernemers geholpen
      </p>
    </div>
  </section>

  {/* ── Problem ── */}
  <section class="py-16 md:py-20 bg-primary">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-white mb-6">Je website kan duidelijk zijn voor mensen, maar onduidelijk voor AI.</h2>
      <p class="text-white/80 leading-relaxed mb-8 text-lg">
        Je website kan voor bezoekers prima duidelijk lijken, maar t&oacute;ch te weinig signalen geven aan Google en AI-systemen. Het gaat niet alleen om wat er op je site staat, maar ook om hoe duidelijk je diensten, bewijs, antwoorden en structuur worden opgebouwd voor moderne vindbaarheid.
      </p>
      <div class="space-y-4">
        <div class="flex items-start gap-4">
          <span class="text-white/60 text-lg shrink-0 mt-0.5">&#10005;</span>
          <p class="text-white/80 leading-relaxed">Je diensten zijn niet altijd opgebouwd als duidelijke vindbaarheidspagina's</p>
        </div>
        <div class="flex items-start gap-4">
          <span class="text-white/60 text-lg shrink-0 mt-0.5">&#10005;</span>
          <p class="text-white/80 leading-relaxed">Je website mist mogelijk concrete antwoorden op vragen die klanten &eacute;n AI stellen</p>
        </div>
        <div class="flex items-start gap-4">
          <span class="text-white/60 text-lg shrink-0 mt-0.5">&#10005;</span>
          <p class="text-white/80 leading-relaxed">Reviews, bewijs en expertise worden niet sterk genoeg benut voor vertrouwen</p>
        </div>
        <div class="flex items-start gap-4">
          <span class="text-white/60 text-lg shrink-0 mt-0.5">&#10005;</span>
          <p class="text-white/80 leading-relaxed">Je huidige techniek of structuur kan moderne vindbaarheid remmen</p>
        </div>
        <div class="flex items-start gap-4">
          <span class="text-white/60 text-lg shrink-0 mt-0.5">&#10005;</span>
          <p class="text-white/80 leading-relaxed">Concurrenten worden daardoor soms sneller begrepen en aanbevolen</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── How it works — 4 steps ── */}
  <section class="py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-4">Zo werkt het traject</h2>
      <p class="text-lg text-text-muted leading-relaxed mb-12 max-w-3xl">
        Geen maandenlang websiteproject. Als je snel je input aanlevert, kan je nieuwe websitebasis vaak binnen 3-4 weken live staan. De rest van het traject gebruiken we om je fundament verder te versterken.
      </p>

      <div class="relative">
        {/* Vertical connector line */}
        <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-px bg-border -translate-x-1/2"></div>

        <div class="space-y-8 md:space-y-12">
          {/* Step 1 */}
          <div class="relative md:grid md:grid-cols-2 md:gap-12 items-start">
            <div class="md:text-right md:pr-8">
              <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-primary/10 text-primary rounded-full mb-3">Stap 1</span>
              <h3 class="font-heading text-xl text-text mb-2">Scan & intake</h3>
            </div>
            <div class="md:pl-8 mt-3 md:mt-0">
              <div class="bg-white rounded-card p-5 border border-border">
                <p class="text-sm text-text-muted leading-relaxed">
                  We bekijken je scan, huidige website, diensten, doelgroep en concurrenten. Samen bepalen we wat je fundament nodig heeft.
                </p>
              </div>
            </div>
            <div class="hidden md:flex absolute left-1/2 top-3 -translate-x-1/2 w-8 h-8 rounded-full bg-primary text-white items-center justify-center text-sm font-heading">1</div>
          </div>

          {/* Step 2 */}
          <div class="relative md:grid md:grid-cols-2 md:gap-12 items-start">
            <div class="md:text-right md:pr-8">
              <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/10 text-accent rounded-full mb-3">Stap 2</span>
              <h3 class="font-heading text-xl text-text mb-2">Nieuwe basis bouwen</h3>
            </div>
            <div class="md:pl-8 mt-3 md:mt-0">
              <div class="bg-white rounded-card p-5 border border-border">
                <p class="text-sm text-text-muted leading-relaxed">
                  We bouwen een snelle AI-ready websitebasis op basis van bewezen templates en verwerken je belangrijkste diensten, bewijs, foto's en FAQ's.
                </p>
              </div>
            </div>
            <div class="hidden md:flex absolute left-1/2 top-3 -translate-x-1/2 w-8 h-8 rounded-full bg-accent text-white items-center justify-center text-sm font-heading">2</div>
          </div>

          {/* Step 3 */}
          <div class="relative md:grid md:grid-cols-2 md:gap-12 items-start">
            <div class="md:text-right md:pr-8">
              <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-primary/10 text-primary rounded-full mb-3">Stap 3</span>
              <h3 class="font-heading text-xl text-text mb-2">Preview & livegang</h3>
            </div>
            <div class="md:pl-8 mt-3 md:mt-0">
              <div class="bg-white rounded-card p-5 border border-border">
                <p class="text-sm text-text-muted leading-relaxed">
                  Je krijgt een preview en een correctieronde. Daarna zetten we de website live en begeleiden we de overstap.
                </p>
              </div>
            </div>
            <div class="hidden md:flex absolute left-1/2 top-3 -translate-x-1/2 w-8 h-8 rounded-full bg-primary text-white items-center justify-center text-sm font-heading">3</div>
          </div>

          {/* Step 4 */}
          <div class="relative md:grid md:grid-cols-2 md:gap-12 items-start">
            <div class="md:text-right md:pr-8">
              <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/10 text-accent rounded-full mb-3">Stap 4</span>
              <h3 class="font-heading text-xl text-text mb-2">90 dagen versterken</h3>
            </div>
            <div class="md:pl-8 mt-3 md:mt-0">
              <div class="bg-white rounded-card p-5 border border-border">
                <p class="text-sm text-text-muted leading-relaxed">
                  Na livegang gebruiken we de rest van het traject voor optimalisaties, meetpunten, AI-vindbaarheidscheck en vervolgstappen.
                </p>
              </div>
            </div>
            <div class="hidden md:flex absolute left-1/2 top-3 -translate-x-1/2 w-8 h-8 rounded-full bg-accent text-white items-center justify-center text-sm font-heading">4</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── Logo strip ── */}
  {logos.length > 0 && (
    <LogoMarquee
      logos={logos}
      label="Vertrouwd door coaches, experts en bedrijven"
      speed={35}
    />
  )}

  {/* ── What you get — 3 blocks ── */}
  <section class="py-16 md:py-20 bg-bg-alt">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-10">Wat zit er in het traject?</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {/* Block 1 */}
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
          </div>
          <h3 class="font-heading text-lg text-text mb-3">Een beter websitefundament</h3>
          <ul class="space-y-1.5 text-sm text-text-muted">
            <li class="flex items-start gap-2"><span class="text-accent mt-0.5">&rarr;</span> Homepage</li>
            <li class="flex items-start gap-2"><span class="text-accent mt-0.5">&rarr;</span> 1-3 kernpagina's</li>
            <li class="flex items-start gap-2"><span class="text-accent mt-0.5">&rarr;</span> Contactpagina</li>
            <li class="flex items-start gap-2"><span class="text-accent mt-0.5">&rarr;</span> FAQ</li>
            <li class="flex items-start gap-2"><span class="text-accent mt-0.5">&rarr;</span> Reviews en bewijs</li>
            <li class="flex items-start gap-2"><span class="text-accent mt-0.5">&rarr;</span> Mobiele opbouw</li>
          </ul>
        </div>
        {/* Block 2 */}
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-10 h-10 rounded-full bg-accent/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <h3 class="font-heading text-lg text-text mb-3">Een betere vindbaarheidsbasis</h3>
          <ul class="space-y-1.5 text-sm text-text-muted">
            <li class="flex items-start gap-2"><span class="text-accent mt-0.5">&rarr;</span> Duidelijke structuur</li>
            <li class="flex items-start gap-2"><span class="text-accent mt-0.5">&rarr;</span> Betere teksten op kernpagina's</li>
            <li class="flex items-start gap-2"><span class="text-accent mt-0.5">&rarr;</span> Antwoorden op klantvragen</li>
            <li class="flex items-start gap-2"><span class="text-accent mt-0.5">&rarr;</span> Basis SEO/AI-optimalisatie</li>
            <li class="flex items-start gap-2"><span class="text-accent mt-0.5">&rarr;</span> Logische interne links</li>
          </ul>
        </div>
        {/* Block 3 */}
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
            </svg>
          </div>
          <h3 class="font-heading text-lg text-text mb-3">Een concreet vervolgplan</h3>
          <ul class="space-y-1.5 text-sm text-text-muted">
            <li class="flex items-start gap-2"><span class="text-accent mt-0.5">&rarr;</span> Livegang</li>
            <li class="flex items-start gap-2"><span class="text-accent mt-0.5">&rarr;</span> Eindcheck</li>
            <li class="flex items-start gap-2"><span class="text-accent mt-0.5">&rarr;</span> Verbeterpunten</li>
            <li class="flex items-start gap-2"><span class="text-accent mt-0.5">&rarr;</span> Advies voor vervolgstappen</li>
            <li class="flex items-start gap-2"><span class="text-accent mt-0.5">&rarr;</span> Keuze voor Website Care</li>
          </ul>
        </div>
      </div>
      <div class="mt-8 bg-accent/5 border border-accent/20 rounded-card p-6">
        <p class="text-accent font-medium text-lg leading-relaxed">
          Geen aparte webdesignfactuur. De AI-ready websitebasis zit in het traject inbegrepen.
        </p>
      </div>
    </div>
  </section>

  {/* ── Proof cards ── */}
  <section class="py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-4">Fundamenten die w&eacute;l resultaat dragen</h2>
      <p class="text-lg text-text-muted leading-relaxed mb-10 max-w-3xl">
        AI-vindbaarheid staat niet los van je website, content en commerciële structuur. Dit is precies waar we de afgelopen jaren systemen voor bouwden.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full overflow-hidden shrink-0 ring-2 ring-white shadow-sm">
              <Image src={hwyPhoto} alt="Rolf — Happy With Yoga" widths={[80]} sizes="40px" class="w-full h-full object-cover" loading="lazy" decoding="async" />
            </div>
            <div>
              <p class="text-sm font-medium text-text">Rolf</p>
              <Image src={hwyLogo} alt="Happy With Yoga logo" widths={[96]} sizes="80px" class="h-4 w-auto mt-0.5" loading="lazy" decoding="async" />
            </div>
          </div>
          <div class="flex items-baseline gap-2 mb-3">
            <span class="font-heading text-2xl text-primary">30.000+</span>
            <span class="text-sm text-text-muted">webinarleads</span>
          </div>
          <p class="text-xs text-text-muted mb-4">2.000 betalende leden</p>
          <p class="text-sm text-text-muted leading-relaxed">Sterke content- en funnelstructuur rond een bestaand expertmerk.</p>
          <a href="/cases/happy-with-yoga/" class="inline-flex items-center text-sm text-accent hover:text-accent-dark transition-colors font-medium mt-4">
            Lees de case
            <svg class="w-3.5 h-3.5 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full overflow-hidden shrink-0 ring-2 ring-white shadow-sm">
              <Image src={youlifePhoto} alt="Tessa — Youlife" widths={[80]} sizes="40px" class="w-full h-full object-cover" loading="lazy" decoding="async" />
            </div>
            <div>
              <p class="text-sm font-medium text-text">Tessa</p>
              <Image src={youlifeLogo} alt="Youlife logo" widths={[96]} sizes="80px" class="h-4 w-auto mt-0.5" loading="lazy" decoding="async" />
            </div>
          </div>
          <div class="flex items-baseline gap-2 mb-3">
            <span class="font-heading text-2xl text-primary">&plusmn;&euro;10k/mnd</span>
            <span class="text-sm text-text-muted">productomzet</span>
          </div>
          <p class="text-xs text-text-muted mb-4">7.2&times; ROAS op advertenties</p>
          <p class="text-sm text-text-muted leading-relaxed">Productpagina's, ads en opvolging als &eacute;&eacute;n systeem.</p>
          <a href="/cases/tessa-youlife/" class="inline-flex items-center text-sm text-accent hover:text-accent-dark transition-colors font-medium mt-4">
            Lees de case
            <svg class="w-3.5 h-3.5 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full overflow-hidden shrink-0 ring-2 ring-white shadow-sm">
