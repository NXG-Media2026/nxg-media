  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const stickyCta = document.querySelector('.sticky-cta') as HTMLElement | null;
      if (!stickyCta) return;

      const gesprekSection = document.getElementById('gesprek');
      if (!gesprekSection) return;

      const observer = new IntersectionObserver(
        ([entry]) => {
          stickyCta.style.display = entry.isIntersecting ? 'none' : 'block';
        },
        { threshold: 0.1 }
      );
      observer.observe(gesprekSection);
    });
  </script>

