---
/**
 * Google & AI Aanvragen Traject — /ai-vindbaarheid-traject/
 * Hard direct-response offer page with 3 routes and qualification logic.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import { siteConfig } from '../data/site';
import { generateBreadcrumbs, generateFAQPage, generateService } from '../data/schema';

import heroPhoto from '../assets/images/founder/joost-sitting-laptop-lookingfront.webp';
import founderPhoto from '../assets/images/founder/joost-standing-relaxed.webp';
import verenaPhoto from '../assets/images/cases/verena-mann-linkedin.webp';
import jamesPhoto from '../assets/images/cases/james-mitchell-portrait.png';
import proofGoogle from '../assets/images/cases/proof-google-torrevieja.png';
import proofChatgpt from '../assets/images/cases/proof-chatgpt-local.png';
import proofVerenaAi from '../assets/images/cases/doc_veri_ai_answer_cropped.PNG';
import proofVerenaChatgpt from '../assets/images/cases/doc-veri-chatgptproof.jpeg';
import rolfPhoto from '../assets/images/logos/rolf-profile-photo-happywithyoga.png';
import proofHwyWhatsapp from '../assets/images/cases/rolf-happywithyoga-whatsapp-proof.webp';
import keystaticDashboard from '../assets/images/keystatic1.png';
import keystaticHomepage from '../assets/images/keystatic_edit_homepage.png';
import keystaticBlog from '../assets/images/keystatic_add_blog.png';

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logos/*.{webp,avif,png,jpg}', { eager: true });
const logos = Object.entries(logoFiles)
  .filter(([path]) => /logo/i.test(path.split('/').pop()!))
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/, '');
    const name = filename.replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim();
    return { src: mod.default, alt: name };
  });

const locale = 'nl';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Google & AI Aanvragen Traject' },
];

const faqItems = [
  {
    q: 'Krijg ik bij €99/mnd een nieuwe website?',
    a: 'Dat hangt van de route af. Bij het AI & Google Fundament (€99/mnd x 12 maanden) bouwen we een compleet nieuw AI-ready fundament inclusief hosting en beheerpaneel. Bij de losse-fixes-route (€99/mnd x 3 maanden) werken we binnen je huidige website en krijg je géén nieuwe site.',
  },
  {
    q: 'Waarom zou ik €299/mnd kiezen als er ook €99/mnd is?',
    a: 'De €299-route bevat actieve uitvoering in de eerste 90 dagen. We bouwen niet alleen het fundament, maar pakken ook de belangrijkste pagina\'s, structuur, citeerbaarheid en conversieroute actief aan. Bij €99/mnd lever je zelf meer input en uitvoering.',
  },
  {
    q: 'Kan ik ook alleen losse tips krijgen?',
    a: 'Niet als uitgebreid adviestraject. De losse-fixes-route is bedoeld voor ondernemers die willen dat wij de eerste verbeteringen uitvoeren. Zoek je alleen gratis tips om zelf ooit iets mee te doen, dan past dit traject minder goed.',
  },
  {
    q: 'Garanderen jullie 30% meer aanvragen?',
    a: 'Nee. Bij klanten waar het fundament goed stond, zagen we gemiddeld rond de 30% meer aanvragen, maar het effect verschilt per niche, aanbod, concurrentie en huidige situatie. Daarom werken we met een nulmeting en 90-dagen evaluatie.',
  },
  {
    q: 'Wat gebeurt er als uit jullie check blijkt dat er weinig kans ligt?',
    a: 'Dan zeggen we dat eerlijk. Niet elk bedrijf of elke markt is geschikt. We starten liever niet dan dat we een traject doen waar weinig commerciële kans in zit.',
  },
  {
    q: 'Kom ik echt op pagina 1 in Google?',
    a: 'Voor lokale bedrijven is pagina 1 vaak realistischer dan mensen denken, vooral op dienst + regio zoektermen. Daarom bouwen we gericht op duidelijke diensten, regio\'s, bewijs, autoriteit en een sterke technische basis.',
  },
  {
    q: 'Word ik echt genoemd door ChatGPT en AI-zoekmachines?',
    a: 'Ja, dat is precies waar we je online fundament op inrichten: duidelijk genoeg worden voor AI-tools zoals ChatGPT, Perplexity en Google AI. Daarna bouwen we door naar de zoekvragen die klanten echt gebruiken.',
  },
  {
    q: 'Wat doen jullie precies in het traject?',
    a: 'We bouwen aan drie dingen: beter gevonden worden, sneller vertrouwen opbouwen en meer aanvragen krijgen. Dat doen we via je websitefundament, Google/AI-structuur, dienst- en regiopagina\'s, reviews, Google Business, sterke CTA\'s en maandelijkse optimalisatie.<br><br>• <strong>Gevonden worden:</strong> Google, ChatGPT, Perplexity en Google AI begrijpen je bedrijf beter.<br>• <strong>Vertrouwd worden:</strong> reviews, bewijs en expertise staan op de juiste plekken.<br>• <strong>Aanvragen krijgen:</strong> je website krijgt een duidelijke route naar contact.',
  },
  {
    q: 'Wat gebeurt er in de eerste 90 dagen?',
    a: 'In de eerste 90 dagen bouwen we stap voor stap aan vindbaarheid, vertrouwen en aanvragen.<br><br><strong>Week 1 — Nulmeting & groeiplan:</strong> kansen, zoekvragen, concurrenten en snelste route naar aanvragen.<br><br><strong>Week 2–4 — Fundament:</strong> je site wordt sneller, duidelijker en gebouwd voor Google, AI-zoekmachines en klanten.<br><br><strong>Week 4–8 — Autoriteit:</strong> reviews, Google Business, bewijs, content en lokale signalen.<br><br><strong>Week 8–12 — Optimalisatie:</strong> CTA\'s, conversie, vindbaarheid en aanvraagroute verbeteren.',
  },
  {
    q: 'Waarom geen WordPress?',
    a: 'Veel WordPress-sites worden traag en rommelig door plugins, thema\'s en updates. Wij bouwen liever een snelle, moderne website op een premium fundament zonder plugin-chaos, zodat je site beter te beheren en beter te optimaliseren is.',
  },
  {
    q: 'Houd ik zelf controle over mijn website?',
    a: 'Ja. Bij Route 2 en 3 krijg je een beheerpaneel waarmee je zelf teksten, foto\'s, diensten en updates kunt aanpassen. Je hoeft niet voor elke kleine wijziging naar een webbouwer.',
  },
  {
    q: 'Ben ik dan afhankelijk van NXG Media?',
    a: 'Nee, niet voor kleine inhoudelijke aanpassingen. Jij houdt controle over de inhoud. Wij beheren het technische fundament en zorgen dat alles snel, veilig en goed ingericht blijft.',
  },
  {
    q: 'Voor wie is dit niet geschikt?',
    a: 'Dit traject is niet bedoeld voor webshops met honderden producten, SaaS-platformen, multinationals of bedrijven zonder duidelijke dienst, regio of klantwaarde. Het is juist gemaakt voor lokale dienstverleners, praktijken en specialisten waar één extra klant genoeg waarde heeft om online groei serieus te nemen.',
  },
  {
    q: 'Waarom maximaal 5 bedrijven per ronde?',
    a: 'Elk traject krijgt persoonlijke aandacht: strategie, uitvoering en optimalisatie. Dat lukt alleen als we het aantal bedrijven per ronde beperken. Bovendien nemen we maximaal één bedrijf per branche in dezelfde regio aan, zodat je nooit tegen een directe concurrent binnen het traject aankijkt.',
  },
  {
    q: 'Hoe bepalen jullie of er vooruitgang is?',
    a: 'We starten altijd met een nulmeting. Daarin leggen we vast hoe je bedrijf nu zichtbaar is in Google, ChatGPT, Perplexity, Google AI en je website. We kijken naar relevante zoektermen, AI-vermeldingen, websitefundament, content, bewijs en aanvraagroute.<br><br>Na 90 dagen vergelijken we de resultaten met die nulmeting. Geen duidelijke vooruitgang in Google, AI-zichtbaarheid of aanvragen? Dan werken we gratis door.',
  },
  {
    q: 'Kunnen jullie ook meten wat bezoekers doen op mijn website?',
    a: 'Ja. We kunnen tracking en optimalisatie toevoegen, zoals Google Tag Manager, Meta Pixel, Microsoft Clarity, formuliertracking en conversiemeting. Daarmee zien we waar bezoekers afhaken en welke pagina\'s, CTA\'s of formulieren beter kunnen.',
  },
  {
    q: 'Wat kunnen jullie na de eerste 90 dagen blijven doen?',
    a: 'Na de eerste 90 dagen kunnen we doorgaan met behoud, monitoring en groei. Denk aan extra dienst- en regiopagina\'s, SEO/AI-content, Google Business optimalisatie, reviewproces, conversie-optimalisatie, Microsoft Clarity analyses, A/B-tests en tracking via Meta Pixel of Google Tag Manager.',
  },
];

const serviceSchema = generateService({
  name: 'Google & AI Aanvragen Traject',
  description: 'Pagina 1 in Google. Genoemd worden door ChatGPT, Perplexity en AI-zoekmachines. Meer aanvragen uit je website. Voor lokale dienstverleners en praktijken.',
  url: `${siteConfig.url}/ai-vindbaarheid-traject/`,
  serviceType: 'AI Visibility & Growth System',
});
---

<BaseLayout
  title="Meer aanvragen uit Google en AI begint met het juiste fundament | NXG Media"
  description="Laat zien waar jouw bedrijf nu klanten mist in Google en AI. Losse fixes vanaf €99/mnd, nieuw fundament of complete 90-dagen boost vanaf €299/mnd."
  canonical={`${siteConfig.url}/ai-vindbaarheid-traject/`}
  schemas={[
    generateBreadcrumbs(breadcrumbs.map((b) => ({ name: b.label, url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}/ai-vindbaarheid-traject/` }))),
    generateFAQPage(faqItems.map(i => ({ question: i.q, answer: i.a }))),
    serviceSchema,
  ]}
  locale={locale}
  hideNewsletter={true}
  hideStickyMobileCTA={true}
>
  <BreadcrumbNav items={breadcrumbs} />


  {/* ══════════════════════════════════════════════════
      1 - HERO
      ══════════════════════════════════════════════════ */}
  <section class="relative overflow-hidden bg-primary">
    <div class="absolute inset-0 hidden md:block">
      <Image src={heroPhoto} alt="" width={800} class="absolute right-0 top-0 h-full w-auto object-cover object-top opacity-[0.15]" loading="eager" />
    </div>

    <div class="relative px-5 md:px-6 pt-10 pb-10 md:pt-14 md:pb-16">
      <div class="max-w-2xl mx-auto">
        <h1 class="font-heading text-[1.75rem] leading-[1.15] md:text-[2.75rem] md:leading-[1.1] text-white mb-4">
          Meer aanvragen uit Google en AI<br />
          <em class="text-accent not-italic">begint met het juiste fundament.</em>
        </h1>

        <p class="text-white/70 leading-relaxed mb-5 text-[0.9rem] md:text-base max-w-xl">
          Laat zien waar jouw bedrijf nu klanten mist in Google en AI. Als er concrete kansen liggen, kiezen we de route: losse fixes, een nieuw fundament of een complete 90-dagen boost.
        </p>

        {/* Price anchors */}
        <div class="flex flex-col sm:flex-row gap-3 mb-5 max-w-md">
          <div class="bg-white/[0.08] border border-white/15 rounded-lg px-4 py-3 flex-1">
            <p class="text-white font-heading text-xl">Vanaf &euro;99<span class="text-sm text-white/50 font-body">/mnd</span></p>
            <p class="text-white/50 text-xs">Losse AI/SEO-fixes</p>
          </div>
          <div class="bg-white/[0.12] border-2 border-accent/40 rounded-lg px-4 py-3 flex-1">
            <p class="text-white font-heading text-xl">Vanaf &euro;299<span class="text-sm text-white/50 font-body">/mnd</span></p>
            <p class="text-accent text-xs font-medium">Complete Google & AI boost</p>
          </div>
        </div>

        <ul class="space-y-1.5 text-sm text-white/70 mb-6">
          <li class="flex items-start gap-2"><span class="text-accent shrink-0 mt-0.5">&check;</span> Kies tussen losse fixes, een nieuw fundament of een complete 90-dagen boost</li>
          <li class="flex items-start gap-2"><span class="text-accent shrink-0 mt-0.5">&check;</span> Beter vindbaar worden in Google, ChatGPT, Perplexity en AI-zoekmachines</li>
          <li class="flex items-start gap-2"><span class="text-accent shrink-0 mt-0.5">&check;</span> Gericht op meer aanvragen, niet alleen meer bezoekers</li>
          <li class="flex items-start gap-2"><span class="text-accent shrink-0 mt-0.5">&check;</span> Altijd met nulmeting en evaluatie na 90 dagen</li>
        </ul>

        <a href="#formulier" class="inline-flex items-center gap-2 px-8 py-4 text-base font-medium text-white bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg w-full md:w-auto justify-center">
          Check of mijn bedrijf in aanmerking komt
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>

        <p class="text-white/40 text-xs mt-3">Geen gratis tips-rondje. We kijken of er genoeg potentie is voor een serieus 90-dagen traject.</p>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      2 - PROOF STRIP
      ══════════════════════════════════════════════════ */}
  <section class="bg-bg-alt border-b border-border/50 px-4 md:px-6 py-8 md:py-10">
    <div class="max-w-4xl mx-auto">
      <p class="text-xs uppercase tracking-widest text-accent font-medium text-center mb-5">Resultaten uit recente trajecten</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">

        {/* CBMC proof card */}
        <div class="bg-white border-2 border-accent/20 rounded-card overflow-hidden shadow-sm">
          <div class="px-5 pt-5 pb-4">
            <div class="flex items-center gap-3 mb-3">
              <Image src={jamesPhoto} alt="James Mitchell" width={40} height={40} class="w-10 h-10 rounded-full object-cover shrink-0 border-2 border-accent/20" />
              <div>
                <p class="text-text font-medium text-sm leading-tight">Costa Blanca Movement Centre</p>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 text-[0.6rem] font-semibold uppercase tracking-wider bg-accent/10 text-accent rounded-full mt-0.5">Google &amp; AI proof</span>
              </div>
            </div>
            <p class="text-text font-heading text-lg leading-snug mb-0.5">Van 0 naar pagina 1 in Google<span class="block text-sm font-body text-text-muted">binnen 14 dagen</span></p>
            <p class="text-accent font-semibold text-sm">12&ndash;15 nieuwe pati&euml;nten/mnd</p>
          </div>
          <div class="px-5 pb-4">
            <button type="button" class="proof-trigger cursor-pointer group w-full text-left">
              <div class="rounded-lg overflow-hidden border border-border/50">
                <Image src={proofGoogle} alt="Google pagina 1 bewijs" width={1200} quality={90} class="w-full h-auto opacity-90 group-hover:opacity-100 transition-opacity" />
              </div>
              <p class="text-text-muted text-[0.6rem] text-center mt-1 group-hover:text-text transition-colors">Klik om te vergroten</p>
            </button>
          </div>
        </div>

        {/* Verena proof card */}
        <div class="bg-white border-2 border-accent/20 rounded-card overflow-hidden shadow-sm">
          <div class="px-5 pt-5 pb-4">
            <div class="flex items-center gap-3 mb-3">
              <Image src={verenaPhoto} alt="Dr. Verena Mann" width={40} height={40} class="w-10 h-10 rounded-full object-cover shrink-0 border-2 border-accent/20" />
              <div>
                <p class="text-text font-medium text-sm leading-tight">Dr. Verena Mann</p>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 text-[0.6rem] font-semibold uppercase tracking-wider bg-primary/10 text-primary rounded-full mt-0.5">AI proof</span>
              </div>
            </div>
            <p class="text-text font-heading text-lg leading-snug mb-0.5">2 &rarr; 19 aanvragen/mnd</p>
            <p class="text-accent font-semibold text-sm">15 AI-vermeldingen in ChatGPT</p>
          </div>
          <div class="px-5 pb-4">
            <button type="button" class="proof-trigger cursor-pointer group w-full text-left">
              <div class="rounded-lg overflow-hidden border border-border/50">
                <Image src={proofVerenaAi} alt="ChatGPT AI-vermelding bewijs" width={1200} quality={90} class="w-full h-auto opacity-90 group-hover:opacity-100 transition-opacity" />
              </div>
              <p class="text-text-muted text-[0.6rem] text-center mt-1 group-hover:text-text transition-colors">Klik om te vergroten</p>
            </button>
          </div>
        </div>

      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      3 - KERNVRAAG / KWALIFICATIE
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-12 md:py-16">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-4 leading-snug">
        Als we kunnen laten zien waar jouw bedrijf nu klanten mist in Google en AI, ben je dan bereid om 90 dagen serieus aan dat fundament te werken?
      </h2>
      <p class="text-text-muted text-[0.95rem] leading-relaxed max-w-xl mx-auto">
        Dat is de enige vraag die ertoe doet. Wij doen alleen een deep dive als iemand serieus openstaat voor een traject wanneer er concrete kansen liggen.
      </p>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      4 - GUARANTEE / RISK REVERSAL
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-10 md:py-14">
    <div class="max-w-3xl mx-auto">
      <div class="bg-white border-2 border-accent/30 rounded-card p-6 md:p-8 shadow-lg text-center relative">
        <span class="absolute -top-3 left-1/2 -translate-x-1/2 inline-block px-4 py-1 text-[0.65rem] font-medium tracking-widest uppercase bg-accent text-white rounded-full whitespace-nowrap">Google & AI vooruitgangsgarantie</span>

        <div class="w-16 h-16 rounded-full bg-accent/10 flex items-center justify-center mx-auto mb-4">
          <svg class="w-8 h-8 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12c0 1.268-.63 2.39-1.593 3.068a3.745 3.745 0 01-1.043 3.296 3.745 3.745 0 01-3.296 1.043A3.745 3.745 0 0112 21c-1.268 0-2.39-.63-3.068-1.593a3.746 3.746 0 01-3.296-1.043 3.746 3.746 0 01-1.043-3.296A3.745 3.745 0 013 12c0-1.268.63-2.39 1.593-3.068a3.745 3.745 0 011.043-3.296 3.746 3.746 0 013.296-1.043A3.746 3.746 0 0112 3c1.268 0 2.39.63 3.068 1.593a3.746 3.746 0 013.296 1.043 3.746 3.746 0 011.043 3.296A3.745 3.745 0 0121 12z" />
          </svg>
        </div>

        <h2 class="font-heading text-2xl md:text-3xl text-text mb-4">
          Geen zichtbare vooruitgang? Dan werken wij gratis door.
        </h2>
        <p class="text-text-muted mb-6 text-[0.95rem] leading-relaxed max-w-xl mx-auto">
          Binnen 90 dagen moet je vooruitgang zien in Google, AI-zoekmachines of aanvragen via je website. Geen vooruitgang? Dan werken wij gratis door totdat er resultaat zichtbaar wordt.
        </p>
        <p class="text-text-muted text-xs">Vooruitgang meten we op basis van een nulmeting bij de start.</p>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      5 - RESULTAATCLAIM + NULMETING
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-10 md:py-14 bg-bg-alt">
    <div class="max-w-3xl mx-auto">
      <div class="bg-white border border-border rounded-card p-6 md:p-8">
        <p class="text-text text-[0.95rem] leading-relaxed mb-4">
          Bij klanten waar het fundament goed stond, zagen we gemiddeld rond de 30% meer aanvragen. Maar eerlijk is eerlijk: het effect verschilt per bedrijf. Daarom starten we altijd met een nulmeting en kijken we na 90 dagen wat er daadwerkelijk beweegt.
        </p>

        <p class="text-xs uppercase tracking-widest text-accent font-medium mb-3">Wat we meten</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
          {[
            'Organisch verkeer via Google Analytics',
            'Search Console-impressies en klikken',
            'Posities op belangrijkste zoekvragen',
            'AI-vermeldingen in ChatGPT, Perplexity en Gemini',
            'Best presterende pagina\'s',
            'Conversiepunten: formulier, telefoonklik, mailklik',
          ].map((item) => (
            <div class="flex items-start gap-2 text-sm text-text">
              <svg class="w-3.5 h-3.5 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              {item}
            </div>
          ))}
        </div>

        <div class="border-t border-border mt-5 pt-5">
          <p class="text-xs uppercase tracking-widest text-accent font-medium mb-3">Na 90 dagen vergelijken we</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
            {[
              'Welke zoekvragen bewegen',
              'Welke pagina\'s meer zichtbaarheid krijgen',
              'Of AI het bedrijf vaker noemt',
              'Of organisch verkeer groeit',
              'Of er meer kwalitatieve contactmomenten zijn',
              'Welke vervolgroute logisch is',
            ].map((item) => (
              <div class="flex items-start gap-2 text-sm text-text-muted">
                <svg class="w-3.5 h-3.5 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                {item}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      6 - URGENCY
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-10 md:py-14">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-4">
        De Google- en AI-posities worden n&uacute; verdeeld.
      </h2>
      <p class="text-text-muted text-[0.95rem] max-w-xl mx-auto">ChatGPT, Perplexity en Google AI leren welke bedrijven ze kunnen vertrouwen.</p>
      <p class="text-text font-medium text-[0.95rem] max-w-xl mx-auto mt-1.5 mb-8">Wacht je tot je concurrent die positie heeft? Dan wordt inhalen moeilijker.</p>

      {/* Trajectronde card */}
      <div class="relative max-w-md mx-auto mb-8">
        <div class="absolute -inset-1 bg-accent/20 rounded-2xl blur-md"></div>
        <div class="relative bg-primary-dark rounded-xl overflow-hidden shadow-xl border border-accent/30">
          <div class="bg-accent px-4 py-2">
            <span class="text-[0.65rem] font-bold tracking-[0.2em] uppercase text-white">Volgende trajectronde</span>
          </div>
          <div class="px-6 py-6 md:px-8 md:py-7">
