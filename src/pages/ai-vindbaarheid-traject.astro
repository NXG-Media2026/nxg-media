---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import { siteConfig } from '../data/site';
import { generateBreadcrumbs, generateFAQPage, generateService } from '../data/schema';

import heroPhoto from '../assets/images/founder/joost-sitting-laptop-lookingfront.webp';
import founderPhoto from '../assets/images/founder/joost-standing-relaxed.webp';

import keystaticDashboard from '../assets/images/keystatic1.png';
import keystaticHomepage from '../assets/images/keystatic_edit_homepage.png';
import keystaticBlog from '../assets/images/keystatic_add_blog.png';
import keystaticDiensten from '../assets/images/keystatic_services_oversight.png';

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logos/*.{webp,avif,png,jpg}', { eager: true });
const logos = Object.entries(logoFiles)
  .filter(([path]) => /logo/i.test(path.split('/').pop()!))
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/, '');
    const name = filename.replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim();
    return { src: mod.default, alt: name };
  });

const locale = 'nl';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'AI Vindbaarheid', href: '/ai-vindbaarheid/' },
  { label: '90-dagen traject' },
];

const faqItems = [
  {
    question: 'Moet mijn hele website opnieuw?',
    answer: 'Nee. Je content, teksten en foto\'s blijven. Ik bouw het technische fundament eronder opnieuw. Denk aan het verschil tussen een goed geschreven boek en een boek dat ook in elke bibliotheek correct gecatalogiseerd staat.',
  },
  {
    question: 'Ik heb net mijn website laten maken. Is dat voor niks geweest?',
    answer: 'Nee. Je content is je sterkste asset. Een beter fundament maakt je investering in content juist meer waard — niet minder.',
  },
  {
    question: 'Kan ik zelf nog dingen aanpassen?',
    answer: 'Ja. Je krijgt een beheerpaneel (zie screenshots hierboven) voor teksten, foto\'s, blogs, diensten en prijzen. Geen code nodig.',
  },
  {
    question: 'Waarom geen WordPress?',
    answer: 'WordPress was jarenlang de standaard. Maar de weg is veranderd. Ik bouw op Cloudflare Pages + Astro: geen plugins, geen ballast. WordPress laadt 6-10 seconden op mobiel. Mijn sites laden in onder de 2. Je huidige site rijdt offroad terwijl de concurrentie over een snelweg gaat.',
  },
  {
    question: 'Wat als ik wil stoppen na 3 maanden?',
    answer: 'Je bent vrij. Je krijgt alle bestanden en kunt zelf hosten. Of €50/maand hosting bij mij, maandelijks opzegbaar. Geen lock-in.',
  },
  {
    question: 'Verlies ik mijn Google-posities?',
    answer: 'Elke pagina behoudt dezelfde URL of krijgt een permanente doorverwijzing. Met een snellere site worden je posities in de meeste gevallen juist beter.',
  },
  {
    question: 'Blijft mijn site online tijdens het traject?',
    answer: 'Ja. De nieuwe site wordt op een testomgeving gebouwd. Je keurt alles goed voor de overstap. Je oude site blijft live als backup.',
  },
  {
    question: 'Hoeveel tijd kost het mij?',
    answer: '1-2 uur per week in maand 1. Foto\'s, feedback op teksten, wekelijks kort overleg. Daarna minder.',
  },
  {
    question: 'Krijg ik echt meer klanten hierdoor?',
    answer: 'Een snellere site krijgt hogere Google-posities. Hogere posities betekent meer verkeer. AI-vermeldingen zijn daar bovenop een nieuw kanaal dat elke maand groeit. Bij een praktijk met 20 klanten per maand via Google kan een beter fundament 3-6 extra klanten per maand betekenen.',
  },
  {
    question: 'Heb je voorbeelden?',
    answer: 'In het kennismakingsgesprek laat ik je live de sites zien die ik heb gebouwd, inclusief de scores. Zo kun je met eigen ogen het verschil zien.',
  },
];

const faqForSchema = faqItems.map((item) => ({ question: item.question, answer: item.answer }));
const faqForComponent = faqItems.map((item) => ({ q: item.question, a: item.answer }));

const serviceSchema = generateService({
  name: 'AI-Vindbaarheid Traject',
  description: 'In 90 dagen van onzichtbaar naar aanbevolen door ChatGPT en Google. Compleet vindbaarheids-fundament inclusief AI-ready website, nichepagina\'s, content-strategie en persoonlijke begeleiding.',
  url: `${siteConfig.url}/ai-vindbaarheid-traject/`,
  serviceType: 'AI Visibility Optimization',
});

const keystacticScreenshots = [
  { src: keystaticDashboard, alt: 'Keystatic CMS dashboard met welkom Mariëlle, overzicht van alle pagina\'s en content', caption: 'Alles op één plek — pagina\'s, blogs, reviews, diensten' },
  { src: keystaticHomepage, alt: 'Homepage bewerken in Keystatic CMS met Nederlandse veldlabels', caption: 'Homepage aanpassen — invullen, opslaan, klaar' },
  { src: keystaticBlog, alt: 'Blog editor met rich text toolbar en SEO-velden in Keystatic', caption: 'Blogartikelen schrijven — met opmaak en SEO-velden' },
  { src: keystaticDiensten, alt: 'Diensten en prijzen overzicht in Keystatic CMS', caption: 'Diensten en prijzen — zelf aanpassen wanneer je wilt' },
];
---

<BaseLayout
  title="AI-Vindbaarheid Traject — Word aanbevolen door ChatGPT en Google | NXG Media"
  description="Je content is goed. Je fundament niet. In 90 dagen van onzichtbaar naar aanbevolen door AI. Website t.w.v. €2.000-€4.000 inbegrepen. Trajecten vanaf €299/maand."
  schemas={[
    generateBreadcrumbs(breadcrumbs.map((b) => ({ name: b.label, url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}/ai-vindbaarheid-traject/` }))),
    generateFAQPage(faqForSchema),
    serviceSchema,
  ]}
  locale={locale}
>
  <BreadcrumbNav items={breadcrumbs} />

  {/* ── 1. HERO — PIJN + BELOFTE ── */}
  <section class="relative py-20 md:py-28 lg:py-36 overflow-hidden">
    <div class="absolute inset-0">
      <Image
        src={heroPhoto}
        alt="Joost van Putten — AI-vindbaarheid specialist"
        widths={[800, 1200, 1600]}
        sizes="100vw"
        class="w-full h-full object-cover"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-white/95 via-white/85 to-white/40"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 md:px-6">
      <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-primary/10 text-primary rounded-full mb-6">
        90-DAGEN TRAJECT
      </span>
      <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl text-text mb-6 leading-tight max-w-2xl">
        AI noemt jouw concurrenten.<br /><em>Niet jou.</em>
      </h1>
      <p class="text-lg md:text-xl text-text-muted leading-relaxed mb-8 max-w-xl">
        Je website staat online. Je content is goed. Maar als iemand ChatGPT vraagt naar jouw vakgebied in jouw regio, stuurt het ze naar de concurrent. Dat verandert in 90 dagen.
      </p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a
          href="#formulier"
          class="inline-flex items-center justify-center px-8 py-4 text-base font-medium text-text-inverse bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg"
        >
          Vraag een persoonlijke indicatie aan
          <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a
          href="#herkenning"
          class="inline-flex items-center justify-center px-6 py-4 text-base font-medium text-text-muted hover:text-text transition-colors"
        >
          Bekijk hoe &darr;
        </a>
      </div>
    </div>
  </section>

  {/* ── 2. HERKENNING — "DIT IS WAT ER GEBEURT" ── */}
  <section id="herkenning" class="py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-10">Herken je dit?</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-10">
        <div class="bg-white rounded-card p-5 border border-border">
          <span class="text-2xl mb-3 block">&#128552;</span>
          <p class="text-text-muted leading-relaxed italic">&ldquo;De telefoon ging vroeger vanzelf. Nu merk ik dat het stiller wordt &mdash; maar ik weet niet waarom.&rdquo;</p>
        </div>
        <div class="bg-white rounded-card p-5 border border-border">
          <span class="text-2xl mb-3 block">&#129300;</span>
          <p class="text-text-muted leading-relaxed italic">&ldquo;Ik heb al zoveel ge&iuml;nvesteerd in mijn website. Teksten, foto&rsquo;s, SEO. Waarom werkt het dan niet?&rdquo;</p>
        </div>
        <div class="bg-white rounded-card p-5 border border-border">
          <span class="text-2xl mb-3 block">&#128543;</span>
          <p class="text-text-muted leading-relaxed italic">&ldquo;Mijn concurrent heeft minder ervaring. Minder reviews. Maar wordt w&eacute;l aanbevolen door ChatGPT. Hoe kan dat?&rdquo;</p>
        </div>
        <div class="bg-white rounded-card p-5 border border-border">
          <span class="text-2xl mb-3 block">&#128274;</span>
          <p class="text-text-muted leading-relaxed italic">&ldquo;Ik wil niet weer afhankelijk worden van een techneut voor elke kleine aanpassing.&rdquo;</p>
        </div>
      </div>
      <p class="text-text-muted leading-relaxed text-lg">
        Als je jezelf hierin herkent, lees dan even door. Want het probleem is niet wat je denkt.
      </p>
    </div>
  </section>

  {/* ── 3. HET ECHTE PROBLEEM — CONSEQUENTIE ── */}
  <section class="py-16 md:py-20 bg-primary">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-white mb-6">Het probleem is niet jouw content. Het probleem is dat niemand het kan vinden.</h2>
      <p class="text-white/80 leading-relaxed mb-6 text-lg">
        Steeds meer mensen zoeken niet meer op Google. Ze vragen het aan ChatGPT, Gemini, Perplexity of Claude. &ldquo;Wie is een goede <em>[jouw vakgebied]</em> in <em>[jouw regio]</em>?&rdquo;
      </p>
      <p class="text-white/80 leading-relaxed mb-6 text-lg">
        En die tools geven een antwoord. Ze noemen namen. Maar ze noemen alleen bedrijven die ze kunnen begrijpen. Niet de beste. De meest leesbare.
      </p>
      <p class="text-white font-medium leading-relaxed mb-6 text-lg">
        Jouw concurrent schrijft niet beter dan jij. Die heeft alleen een fundament dat machines w&eacute;l begrijpen.
      </p>
      <p class="text-white/80 leading-relaxed text-lg">
        Elke maand dat jouw fundament niet klopt, beantwoordt ChatGPT dezelfde vraag &mdash; en stuurt de klant naar je concurrent.
      </p>
    </div>
  </section>

  {/* ── 4. DE VERSCHUIVING — WAAROM NU ── */}
  <section class="py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-6">De weg is veranderd. Niet jouw content.</h2>
      <p class="text-text-muted leading-relaxed mb-4 text-lg">
        WordPress was jarenlang de standaard. En je content die erin staat is waardevol &mdash; daar gooien we niks van weg.
      </p>
      <p class="text-text-muted leading-relaxed mb-4 text-lg">
        Maar de weg is veranderd. Google en AI stellen in 2026 andere eisen aan snelheid, structuur en leesbaarheid. Je huidige site is een degelijke auto &mdash; maar die rijdt nu offroad terwijl je concurrenten over een snelweg gaan.
      </p>
      <p class="text-text font-medium leading-relaxed mb-10 text-lg">
        Zelfde bestemming. Ander fundament. En offroad ga je het niet winnen.
      </p>

      {/* Side-by-side vergelijking */}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white rounded-card p-6 border-2 border-red-200">
          <h3 class="font-heading text-lg text-text mb-4 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-red-400 shrink-0"></span>
            Je huidige fundament
          </h3>
          <ul class="space-y-2.5 text-sm text-text-muted">
            <li class="flex items-start gap-2"><span class="text-red-400 shrink-0 mt-0.5">&times;</span> Laadtijd 6-10 seconden op mobiel</li>
            <li class="flex items-start gap-2"><span class="text-red-400 shrink-0 mt-0.5">&times;</span> Google-score: 35-55 van 100</li>
            <li class="flex items-start gap-2"><span class="text-red-400 shrink-0 mt-0.5">&times;</span> AI-vermeldingen: 0 van 5 tools</li>
            <li class="flex items-start gap-2"><span class="text-red-400 shrink-0 mt-0.5">&times;</span> Content onleesbaar voor machines</li>
            <li class="flex items-start gap-2"><span class="text-red-400 shrink-0 mt-0.5">&times;</span> Elke plugin maakt het trager</li>
          </ul>
        </div>
        <div class="bg-white rounded-card p-6 border-2 border-green-300 shadow-md">
          <h3 class="font-heading text-lg text-text mb-4 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-green-500 shrink-0"></span>
            Nieuw fundament
          </h3>
          <ul class="space-y-2.5 text-sm text-text-muted">
            <li class="flex items-start gap-2"><span class="text-green-500 shrink-0 mt-0.5">&check;</span> Laadtijd onder 2 seconden</li>
            <li class="flex items-start gap-2"><span class="text-green-500 shrink-0 mt-0.5">&check;</span> Google-score: 90-100 van 100</li>
            <li class="flex items-start gap-2"><span class="text-green-500 shrink-0 mt-0.5">&check;</span> AI begrijpt en citeert je content</li>
            <li class="flex items-start gap-2"><span class="text-green-500 shrink-0 mt-0.5">&check;</span> Geen plugins, geen ballast</li>
            <li class="flex items-start gap-2"><span class="text-green-500 shrink-0 mt-0.5">&check;</span> Gebouwd voor hoe mensen in 2026 zoeken</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* ── 5. HET BEWIJS — WAT DIT OPLEVERT ── */}
  <section class="py-16 md:py-20 bg-bg-alt">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-10">Dit verandert er als je fundament w&eacute;l klopt.</h2>

      {/* Yogapracht case */}
      <div class="bg-white rounded-card p-6 md:p-8 border border-border mb-10">
        <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-medium bg-amber-100 text-amber-700 rounded-full border border-amber-200 mb-4">HUIDIGE KLANT</span>
        <h3 class="font-heading text-xl text-text mb-1">Yogapracht &mdash; yogapraktijk, Hilvarenbeek</h3>
        <p class="text-text-muted italic mb-6">&ldquo;Dezelfde teksten. Dezelfde foto&rsquo;s. Dezelfde Mari&euml;lle. Alleen het fundament is anders.&rdquo;</p>

        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
          <div class="text-center">
            <p class="text-xs text-text-muted mb-1">Google Performance</p>
            <p class="text-sm text-red-500 line-through">53/100</p>
            <p class="font-heading text-2xl text-green-600">100/100</p>
          </div>
          <div class="text-center">
            <p class="text-xs text-text-muted mb-1">Laadtijd mobiel</p>
            <p class="text-sm text-red-500 line-through">6+ seconden</p>
            <p class="font-heading text-2xl text-green-600">Onder 2 sec</p>
          </div>
          <div class="text-center">
            <p class="text-xs text-text-muted mb-1">SEO-score</p>
            <p class="text-sm text-red-500 line-through">Error</p>
            <p class="font-heading text-2xl text-green-600">100/100</p>
          </div>
          <div class="text-center">
            <p class="text-xs text-text-muted mb-1">Verwacht extra bereik*</p>
            <p class="text-sm text-red-500 line-through">Alleen lokaal</p>
            <p class="font-heading text-lg text-green-600">Heel Brabant + landelijk</p>
          </div>
        </div>

        <p class="text-xs text-text-muted">
          *Google beloont snellere sites met hogere posities. Een site die 2x zo snel laadt, krijgt gemiddeld 15-30% meer organisch verkeer. Bij een praktijk met 20 nieuwe klanten per maand via Google kan dat 3-6 extra klanten per maand betekenen.
        </p>
      </div>

      {/* Drie sites patroon */}
      <h3 class="font-heading text-xl text-text mb-3">Drie sites. E&eacute;n fundament. Hetzelfde resultaat.</h3>
      <p class="text-text-muted leading-relaxed mb-6">Verschillende niches. Hetzelfde technische fundament. Allemaal 90+ bij Google.</p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="bg-white rounded-card p-5 border border-border">
          <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-medium bg-amber-100 text-amber-700 rounded-full border border-amber-200 mb-3">HUIDIGE KLANT</span>
          <h4 class="font-heading text-base text-text mb-1">Yogapracht</h4>
          <p class="text-xs text-text-muted mb-3">Yogapraktijk (NL)</p>
          <p class="text-sm text-text-muted">Performance: <strong class="text-green-600">100</strong> | SEO: <strong class="text-green-600">100</strong></p>
          <p class="text-xs text-text-muted italic mt-2">Was: 53 performance, SEO error</p>
        </div>
        <div class="bg-white rounded-card p-5 border border-border">
          <h4 class="font-heading text-base text-text mb-1">doc.veri</h4>
          <p class="text-xs text-text-muted mb-3">Vrouwengezondheid (DE)</p>
          <p class="text-sm text-text-muted">Performance: <strong class="text-green-600">90</strong> | SEO: <strong class="text-green-600">100</strong></p>
          <p class="text-xs text-text-muted italic mt-2">Nieuwbouw</p>
        </div>
        <div class="bg-white rounded-card p-5 border-2 border-accent/30">
          <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-medium bg-accent/10 text-accent rounded-full border border-accent/20 mb-3">NA 2 WEKEN LIVE</span>
          <h4 class="font-heading text-base text-text mb-1">Costa Blanca Movement Centre</h4>
          <p class="text-xs text-text-muted mb-3">Chiropraktijk (ES) &mdash; Dr. James Mitchell</p>
          <p class="text-sm text-text-muted">Performance: <strong class="text-green-600">99</strong> | SEO: <strong class="text-green-600">100</strong></p>
          <p class="text-xs text-accent font-medium mt-2">Google positie 4 + ChatGPT #1 aanbeveling</p>
        </div>
      </div>

      {/* Vergelijkingsbalken */}
      <div class="bg-white rounded-card p-6 border border-border">
        <div class="space-y-4">
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-sm text-text-muted">Gemiddelde WordPress mobiel</span>
              <span class="text-sm font-medium text-red-600">35&ndash;55</span>
            </div>
            <div class="w-full bg-gray-100 rounded-full h-3">
              <div class="bg-red-400 h-3 rounded-full" style="width: 45%"></div>
            </div>
          </div>
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <span class="text-sm text-text-muted">NXG Media fundament</span>
              <span class="text-sm font-medium text-green-600">90&ndash;100</span>
            </div>
            <div class="w-full bg-gray-100 rounded-full h-3">
              <div class="bg-green-500 h-3 rounded-full" style="width: 95%"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── 6. WAT DOE IK IN 90 DAGEN ── */}
  <section class="py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-4">In 90 dagen bouw ik je complete vindbaarheids-fundament.</h2>
      <p class="text-lg text-text-muted leading-relaxed mb-12 max-w-3xl">
        Niet alleen een snellere website. Een compleet systeem dat ervoor zorgt dat Google &eacute;n AI jou vinden, begrijpen en aanbevelen.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-10">
        {/* Maand 1 */}
        <div>
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full bg-primary text-white flex items-center justify-center font-heading text-lg shrink-0">1</div>
            <div>
              <span class="text-xs text-text-muted">Maand 1</span>
              <h3 class="font-heading text-lg text-text">Fundament</h3>
            </div>
          </div>
          <p class="text-sm text-text-muted leading-relaxed mb-3">
            Kickoff. Ik analyseer je site, je content, je concurrenten en je regio. Daarna bouw ik het nieuwe fundament: een snelle, AI-ready site met je bestaande content als basis. Je huidige site blijft live tot je de nieuwe hebt goedgekeurd. Geen dag zonder werkende website.
          </p>
          <p class="text-xs text-accent font-medium">&rarr; Resultaat: nieuwe site live, snelheid van 6-10 sec naar onder 2 sec</p>
        </div>

        {/* Maand 2 */}
        <div>
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full bg-accent text-white flex items-center justify-center font-heading text-lg shrink-0">2</div>
            <div>
              <span class="text-xs text-text-muted">Maand 2</span>
              <h3 class="font-heading text-lg text-text">Inhoud & autoriteit</h3>
            </div>
          </div>
          <p class="text-sm text-text-muted leading-relaxed mb-3">
            Nichepagina&rsquo;s die de exacte vragen beantwoorden die jouw klanten aan ChatGPT stellen. Lokale signalen versterken. Reviews verzamelen en structureren. Interne verwijzingen opzetten. Content-plan voor de komende 6 maanden.
          </p>
          <p class="text-xs text-accent font-medium">&rarr; Resultaat: AI-tools beginnen je te herkennen als bron</p>
        </div>

        {/* Maand 3 */}
        <div>
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full bg-primary text-white flex items-center justify-center font-heading text-lg shrink-0">3</div>
            <div>
              <span class="text-xs text-text-muted">Maand 3</span>
              <h3 class="font-heading text-lg text-text">Optimalisatie & groei</h3>
            </div>
          </div>
          <p class="text-sm text-text-muted leading-relaxed mb-3">
