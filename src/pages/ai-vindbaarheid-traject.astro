---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import CalendlyEmbed from '../components/CalendlyEmbed.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import { siteConfig } from '../data/site';
import { generateBreadcrumbs, generateFAQPage, generateService } from '../data/schema';

import heroPhoto from '../assets/images/founder/joost-sitting-laptop-lookingfront.webp';
import founderPhoto from '../assets/images/founder/joost-standing-relaxed.webp';

import hwyLogo from '../assets/images/logos/happywithyoga-logo.webp';
import hwyPhoto from '../assets/images/logos/rolf-profile-photo-happywithyoga.png';
import youlifeLogo from '../assets/images/logos/youlife-logo.avif';
import youlifePhoto from '../assets/images/logos/tessa-youlife-profile-photo.png';
import josineLogo from '../assets/images/logos/coachjosine-logo.avif';
import josinePhoto from '../assets/images/logos/coachjosine-profile-photo.png';

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logos/*.{webp,avif,png,jpg}', { eager: true });
const logos = Object.entries(logoFiles)
  .filter(([path]) => /logo/i.test(path.split('/').pop()!))
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/, '');
    const name = filename.replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim();
    return { src: mod.default, alt: name };
  });

const locale = 'nl';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'AI Vindbaarheid', href: '/ai-vindbaarheid/' },
  { label: '90-dagen traject' },
];

const faqItems = [
  {
    question: 'Moet mijn hele website opnieuw?',
    answer: 'Je content, teksten en foto\'s blijven. Het technische fundament eronder wordt opnieuw gebouwd. Denk aan het verschil tussen een goed geschreven boek en een boek dat ook in elke bibliotheek correct gecatalogiseerd staat.',
  },
  {
    question: 'Ik heb net mijn website laten maken. Is dat voor niks geweest?',
    answer: 'Je content is je sterkste asset. Een beter fundament maakt je investering in content juist meer waard — het zorgt ervoor dat Google en AI-systemen je content daadwerkelijk vinden en aanbevelen.',
  },
  {
    question: 'Kan ik zelf nog dingen aanpassen?',
    answer: 'Je krijgt een beheerpaneel voor teksten, foto\'s en pagina\'s. Geen code nodig. Technische structuur, SEO-instellingen en AI-vindbaarheid beheren wij.',
  },
  {
    question: 'Waarom geen WordPress?',
    answer: 'WordPress was jarenlang de standaard — en je content die erin staat is waardevol. Maar de weg is veranderd. De sites die wij bouwen laden in onder de 2 seconden op mobiel, zonder plugins. Een gemiddelde WordPress-site laadt in 6-10 seconden. Je huidige WordPress-site rijdt offroad terwijl de concurrentie over een snelweg gaat.',
  },
  {
    question: 'Wat als ik wil stoppen na 3 maanden?',
    answer: 'Je bent vrij. Je krijgt alle bestanden. Je kunt zelf hosten of bij ons blijven voor Website Care.',
  },
  {
    question: 'Blijft mijn site online tijdens het traject?',
    answer: 'Je huidige website blijft volledig live tot je de nieuwe hebt goedgekeurd. De nieuwe site wordt op een testomgeving gebouwd. Pas na jouw goedkeuring schakelen we over.',
  },
  {
    question: 'Verlies ik mijn Google-posities?',
    answer: 'Elke pagina behoudt dezelfde URL of krijgt een 301-redirect. Met een snellere, beter gestructureerde site worden posities meestal juist beter, niet slechter.',
  },
  {
    question: 'Hoeveel tijd kost het mij?',
    answer: 'Reken op 1-2 uur per week in de eerste maand. Foto\'s aanleveren, feedback op teksten, wekelijks kort overleg. In maand 2 en 3 neemt dat af.',
  },
  {
    question: 'Kan ik eerst een kleinere stap doen?',
    answer: 'De AI-Vindbaarheid Deep Dive (€57) is een eenmalig rapport met concrete aanbevelingen voor jouw situatie. Neem je daarna het traject, dan verrekenen we het bedrag.',
  },
  {
    question: 'Heb je voorbeelden?',
    answer: 'In het kennismakingsgesprek laat ik live voorbeelden zien met bijbehorende Lighthouse-scores, laadtijden en AI-vermeldingen. Zo zie je precies wat het verschil is.',
  },
];

const faqForSchema = faqItems.map((item) => ({
  question: item.question,
  answer: item.answer,
}));

const faqForComponent = faqItems.map((item) => ({ q: item.question, a: item.answer }));

const serviceSchema = generateService({
  name: 'AI-Vindbaarheid Traject',
  description: 'In 90 dagen bouwen we het technische fundament onder je bestaande content, zodat Google en AI-systemen jou herkennen als de logische keuze in jouw regio. Website t.w.v. €2.000-€4.000 inbegrepen.',
  url: `${siteConfig.url}/ai-vindbaarheid-traject/`,
  serviceType: 'AI Visibility Optimization',
});

const whatYouGet = [
  {
    icon: 'website',
    title: 'AI-ready website',
    value: '€2.000–€4.000',
    description: 'Snelle, moderne site. Homepage, over, diensten, contact, FAQ, 1-3 nichepagina\'s.',
  },
  {
    icon: 'speed',
    title: 'Technische optimalisatie',
    value: '€500–€1.000',
    description: 'Van 6-10 sec naar onder 2 sec. Schema markup, semantische structuur, lokale signalen.',
  },
  {
    icon: 'pages',
    title: 'Nichepagina\'s (1-3)',
    value: '€300–€600',
    description: 'Gebouwd rondom de zoekvragen die jouw klanten aan Google en ChatGPT stellen.',
  },
  {
    icon: 'analysis',
    title: 'Concurrentie-analyse',
    value: '€200',
    description: 'Wie wordt er wél aanbevolen in jouw regio en waarom.',
  },
  {
    icon: 'hosting',
    title: 'Hosting & technisch beheer',
    value: '€150',
    description: 'Geen apart hostingcontract nodig. Inbegrepen tijdens het traject.',
  },
  {
    icon: 'coaching',
    title: 'Persoonlijke begeleiding',
    value: '€450',
    description: 'Wekelijks/tweewekelijks. Direct contact, geen helpdesk.',
  },
];

const keystacticScreenshots = [
  {
    src: '/images/keystatic-dashboard.webp',
    alt: 'Keystatic CMS dashboard met overzicht van websitepagina\'s, blogs, klantervaringen en diensten',
    caption: 'Alles op één plek — pagina\'s, blogs, reviews, diensten en producten',
  },
  {
    src: '/images/keystatic-homepage-edit.webp',
    alt: 'Homepage bewerken in Keystatic CMS met velden voor titel, ondertitel en knoppen',
    caption: 'Homepage aanpassen — invullen, opslaan, klaar',
  },
  {
    src: '/images/keystatic-blog-editor.webp',
    alt: 'Blog editor met rich text toolbar, titel, samenvatting en omslagfoto',
    caption: 'Blogartikelen schrijven — met opmaak, afbeeldingen en SEO-velden',
  },
  {
    src: '/images/keystatic-diensten.webp',
    alt: 'Diensten en prijzen beheren in Keystatic CMS overzicht',
    caption: 'Diensten en prijzen beheren — zelf aanpassen wanneer je wilt',
  },
];
---

<BaseLayout
  title="AI-Vindbaarheid Traject — In 90 dagen van onzichtbaar naar aanbevolen | NXG Media"
  description="Je content is goed. Je fundament niet. In 90 dagen bouwen we het technische fundament zodat Google en ChatGPT jou aanbevelen. Website t.w.v. €2.000-€4.000 inbegrepen. Vanaf €299/maand."
  schemas={[
    generateBreadcrumbs(breadcrumbs.map((b) => ({ name: b.label, url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}/ai-vindbaarheid-traject/` }))),
    generateFAQPage(faqForSchema),
    serviceSchema,
  ]}
  locale={locale}
>
  <BreadcrumbNav items={breadcrumbs} />

  {/* ── SECTIE 1: HERO ── */}
  <section class="relative py-20 md:py-28 lg:py-36 overflow-hidden">
    <div class="absolute inset-0">
      <Image
        src={heroPhoto}
        alt="Joost van Putten — AI-vindbaarheid specialist, helpt MKB-bedrijven beter gevonden worden door Google en AI-systemen"
        widths={[800, 1200, 1600]}
        sizes="100vw"
        class="w-full h-full object-cover"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-white/95 via-white/85 to-white/40"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 md:px-6">
      <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-primary/10 text-primary rounded-full mb-6">
        90-DAGEN AI-VINDBAARHEID TRAJECT
      </span>
      <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl text-text mb-6 leading-tight max-w-2xl">
        Je content is goed. Je fundament niet.
      </h1>
      <p class="text-lg md:text-xl text-text-muted leading-relaxed mb-4 max-w-xl">
        Daarom noemt AI je concurrenten &mdash; en niet jou. In <strong>90 dagen</strong> bouwen we het technische fundament onder je bestaande content. Zodat Google &eacute;n ChatGPT jou herkennen als de logische keuze in jouw regio.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 mb-6">
        <a
          href="#investering"
          class="inline-flex items-center justify-center px-8 py-4 text-base font-medium text-text-inverse bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg"
        >
          Bekijk of jouw bedrijf in aanmerking komt
          <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a
          href="#herkenning"
          class="inline-flex items-center justify-center px-6 py-4 text-base font-medium text-text-muted hover:text-text transition-colors"
        >
          Bekijk het traject &darr;
        </a>
      </div>

      {/* Proof bar */}
      <div class="flex flex-wrap gap-x-8 gap-y-3 pt-6 border-t border-border/50">
        <div class="flex items-baseline gap-2">
          <span class="font-heading text-xl text-primary">&lt;2 sec</span>
          <span class="text-sm text-text-muted">laadtijd na migratie</span>
        </div>
        <div class="flex items-baseline gap-2">
          <span class="font-heading text-xl text-primary">90+</span>
          <span class="text-sm text-text-muted">Google Lighthouse score</span>
        </div>
        <div class="flex items-baseline gap-2">
          <span class="font-heading text-xl text-primary">&euro;2.000&ndash;&euro;4.000</span>
          <span class="text-sm text-text-muted">website-waarde inbegrepen</span>
        </div>
      </div>
    </div>
  </section>

  {/* ── SECTIE 2: HERKENNING ── */}
  <section id="herkenning" class="py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-10">Herken je dit?</h2>
      <div class="space-y-5">
        <div class="flex items-start gap-4">
          <span class="w-6 h-6 rounded-full bg-red-100 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-3.5 h-3.5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
          </span>
          <p class="text-text-muted leading-relaxed text-lg">Je staat op pagina 1 van Google, maar de telefoon gaat steeds minder.</p>
        </div>
        <div class="flex items-start gap-4">
          <span class="w-6 h-6 rounded-full bg-red-100 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-3.5 h-3.5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
          </span>
          <p class="text-text-muted leading-relaxed text-lg">Je vraagt ChatGPT om een aanbeveling in jouw vakgebied &mdash; je eigen naam staat er niet bij.</p>
        </div>
        <div class="flex items-start gap-4">
          <span class="w-6 h-6 rounded-full bg-red-100 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-3.5 h-3.5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
          </span>
          <p class="text-text-muted leading-relaxed text-lg">Je concurrent heeft minder ervaring maar wordt w&eacute;l aanbevolen.</p>
        </div>
        <div class="flex items-start gap-4">
          <span class="w-6 h-6 rounded-full bg-red-100 flex items-center justify-center shrink-0 mt-0.5">
            <svg class="w-3.5 h-3.5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
          </span>
          <p class="text-text-muted leading-relaxed text-lg">Je hebt al ge&iuml;nvesteerd in je website, in teksten, in SEO. Het resultaat blijft achter.</p>
        </div>
      </div>
      <div class="mt-10 p-6 bg-primary/5 rounded-card border-l-4 border-primary">
        <p class="text-text font-medium text-lg leading-relaxed">Het probleem is niet je content. Het probleem is het fundament eronder.</p>
      </div>
    </div>
  </section>

  {/* ── SECTIE 3: HET BEWIJS — BEFORE/AFTER ── */}
  <section class="py-16 md:py-20 bg-bg-alt">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-3">Dit is wat er verandert als je fundament w&eacute;l klopt.</h2>
      <p class="text-lg text-text-muted leading-relaxed mb-4">
        <strong>Case: Yogapracht</strong> &mdash; yogapraktijk, Hilvarenbeek
      </p>
      <p class="text-text-muted leading-relaxed mb-10 italic">
        &ldquo;Dezelfde teksten. Dezelfde foto&rsquo;s. Dezelfde Mari&euml;lle. Alleen het fundament is anders.&rdquo;
      </p>

      {/* Before / After cards */}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
        {/* Before */}
        <div class="bg-white rounded-card p-6 border-2 border-red-200">
          <div class="flex items-center gap-2 mb-6">
            <span class="px-3 py-1 text-xs font-medium bg-red-100 text-red-700 rounded-full">VOOR</span>
            <span class="text-sm text-text-muted">WordPress + Divi</span>
          </div>
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-sm text-text-muted">Performance</span>
              <div class="flex items-center gap-2">
                <div class="w-10 h-10 rounded-full border-2 border-red-500 flex items-center justify-center">
                  <span class="text-sm font-bold text-red-600">53</span>
                </div>
              </div>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-text-muted">Accessibility</span>
              <div class="flex items-center gap-2">
                <div class="w-10 h-10 rounded-full border-2 border-amber-500 flex items-center justify-center">
                  <span class="text-sm font-bold text-amber-600">72</span>
                </div>
              </div>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-text-muted">Best Practices</span>
              <div class="flex items-center gap-2">
                <div class="w-10 h-10 rounded-full border-2 border-green-500 flex items-center justify-center">
                  <span class="text-sm font-bold text-green-600">100</span>
                </div>
              </div>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-text-muted">SEO</span>
              <div class="flex items-center gap-2">
                <div class="w-10 h-10 rounded-full border-2 border-red-500 flex items-center justify-center">
                  <span class="text-[10px] font-bold text-red-600">Error</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        {/* After */}
        <div class="bg-white rounded-card p-6 border-2 border-green-300 shadow-md">
          <div class="flex items-center gap-2 mb-6">
            <span class="px-3 py-1 text-xs font-medium bg-green-100 text-green-700 rounded-full">NA</span>
            <span class="text-sm text-text-muted">Nieuw fundament</span>
          </div>
          <div class="space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-sm text-text-muted">Performance</span>
              <div class="flex items-center gap-2">
                <div class="w-10 h-10 rounded-full border-2 border-green-500 flex items-center justify-center">
                  <span class="text-sm font-bold text-green-600">100</span>
                </div>
              </div>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-text-muted">Accessibility</span>
              <div class="flex items-center gap-2">
                <div class="w-10 h-10 rounded-full border-2 border-green-500 flex items-center justify-center">
                  <span class="text-sm font-bold text-green-600">93</span>
                </div>
              </div>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-text-muted">Best Practices</span>
              <div class="flex items-center gap-2">
                <div class="w-10 h-10 rounded-full border-2 border-green-500 flex items-center justify-center">
                  <span class="text-sm font-bold text-green-600">96</span>
                </div>
              </div>
            </div>
            <div class="flex items-center justify-between">
              <span class="text-sm text-text-muted">SEO</span>
              <div class="flex items-center gap-2">
                <div class="w-10 h-10 rounded-full border-2 border-green-500 flex items-center justify-center">
                  <span class="text-sm font-bold text-green-600">100</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>

      {/* Difference metrics */}
      <div class="grid grid-cols-3 gap-4 mb-6">
        <div class="text-center bg-white rounded-card p-4 border border-border">
          <span class="font-heading text-2xl md:text-3xl text-green-600">+47</span>
          <p class="text-sm text-text-muted mt-1">Performance</p>
        </div>
        <div class="text-center bg-white rounded-card p-4 border border-border">
          <span class="font-heading text-2xl md:text-3xl text-green-600">+21</span>
          <p class="text-sm text-text-muted mt-1">Accessibility</p>
        </div>
        <div class="text-center bg-white rounded-card p-4 border border-border">
          <span class="font-heading text-2xl md:text-3xl text-green-600">Error &rarr; 100</span>
          <p class="text-sm text-text-muted mt-1">SEO</p>
        </div>
      </div>

      <p class="text-xs text-text-muted text-center">
        Google Lighthouse scores, mobiel. Google gebruikt deze scores als directe rankingfactor via Core Web Vitals.
      </p>
    </div>
  </section>

  {/* ── SECTIE 4: DRIE SITES ── */}
  <section class="py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-3">Drie sites. E&eacute;n fundament. Hetzelfde resultaat.</h2>
      <p class="text-lg text-text-muted leading-relaxed mb-10">
        Verschillende niches, verschillende klanten. Hetzelfde technische fundament, dezelfde scores.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
        {/* Yogapracht */}
        <div class="bg-white rounded-card p-6 border border-border">
          <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-medium bg-amber-100 text-amber-700 rounded-full border border-amber-200 mb-3">HUIDIGE KLANT</span>
          <h3 class="font-heading text-lg text-text mb-1">Yogapracht</h3>
          <p class="text-sm text-text-muted mb-4">Yogapraktijk</p>
          <div class="flex items-center gap-3 mb-3">
            <div class="w-8 h-8 rounded-full border-2 border-green-500 flex items-center justify-center">
              <span class="text-[10px] font-bold text-green-600">100</span>
            </div>
            <div class="w-8 h-8 rounded-full border-2 border-green-500 flex items-center justify-center">
              <span class="text-[10px] font-bold text-green-600">93</span>
            </div>
            <div class="w-8 h-8 rounded-full border-2 border-green-500 flex items-center justify-center">
              <span class="text-[10px] font-bold text-green-600">100</span>
            </div>
          </div>
          <p class="text-[10px] text-text-muted">Performance &middot; Accessibility &middot; SEO</p>
          <p class="text-xs text-text-muted mt-3 italic">Was: Performance 53, SEO error</p>
        </div>

        {/* doc.veri */}
        <div class="bg-white rounded-card p-6 border border-border">
          <h3 class="font-heading text-lg text-text mb-1">doc.veri</h3>
          <p class="text-sm text-text-muted mb-4">Vrouwengezondheid (DE)</p>
          <div class="flex items-center gap-3 mb-3">
            <div class="w-8 h-8 rounded-full border-2 border-green-500 flex items-center justify-center">
              <span class="text-[10px] font-bold text-green-600">90</span>
            </div>
            <div class="w-8 h-8 rounded-full border-2 border-green-500 flex items-center justify-center">
              <span class="text-[10px] font-bold text-green-600">96</span>
            </div>
            <div class="w-8 h-8 rounded-full border-2 border-green-500 flex items-center justify-center">
              <span class="text-[10px] font-bold text-green-600">100</span>
            </div>
          </div>
          <p class="text-[10px] text-text-muted">Performance &middot; Accessibility &middot; SEO</p>
          <p class="text-xs text-text-muted mt-3 italic">Nieuwbouw, from scratch</p>
        </div>

        {/* Costa Blanca */}
        <div class="bg-white rounded-card p-6 border border-border">
          <h3 class="font-heading text-lg text-text mb-1">Costa Blanca Movement Centre</h3>
          <p class="text-sm text-text-muted mb-4">Mobility kliniek (ES)</p>
          <div class="flex items-center gap-3 mb-3">
            <div class="w-8 h-8 rounded-full border-2 border-green-500 flex items-center justify-center">
              <span class="text-[10px] font-bold text-green-600">99</span>
            </div>
            <div class="w-8 h-8 rounded-full border-2 border-green-500 flex items-center justify-center">
              <span class="text-[10px] font-bold text-green-600">96</span>
            </div>
            <div class="w-8 h-8 rounded-full border-2 border-green-500 flex items-center justify-center">
              <span class="text-[10px] font-bold text-green-600">100</span>
            </div>
          </div>
