---
import { getCollection } from 'astro:content';
import CoachingLayout from '../../layouts/CoachingLayout.astro';

export async function getStaticPaths() {
  const coachingItems = await getCollection('coaching');
  return coachingItems.map((item) => ({
    params: { slug: item.data.pageSlug },
    props: { entry: item },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<CoachingLayout coaching={entry.data}>
  <Content />
</CoachingLayout>
