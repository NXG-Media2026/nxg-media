---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import VideoTestimonialCarousel from '../components/VideoTestimonialCarousel.astro';
import FounderPreview from '../components/FounderPreview.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import SocialStorytellingGrid from '../components/SocialStorytellingGrid.astro';
import { siteConfig } from '../data/site';
import { generateOrganization, generateWebSite, generateFounderPerson, generateFAQPage } from '../data/schema';
import { buildHreflangTrilingual } from '../i18n/hreflang';
import { videoTestimonials } from '../data/videoTestimonials';
import { getSocialPosts } from '../data/socialPosts';

/* TODO: Replace with new hero photo (Joost in NXG hoodie, arms crossed, transparent bg) */
import heroPhoto from '../assets/images/founder/joost-standing-relaxed.webp';
import founderPhoto from '../assets/images/founder/joost-sitting-laptop-looking-working.webp';

const locale = 'nl';
const hreflang = buildHreflangTrilingual('/', '/en/', '/es/');

/* Client logos — auto-import all from Client-logos folder */
const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/Client-logos/*.{webp,avif,png,jpg}', { eager: true });
const logos = Object.entries(logoFiles)
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/, '');
    const name = filename.replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim();
    return { src: mod.default, alt: name };
  });

/* FAQ — updated for MKB positioning */
const homepageFaq = [
  {
    q: 'Voor welk type bedrijf is NXG-media?',
    a: 'We werken met praktisch MKB: loodgieters, dakdekkers, aannemers, installateurs, schoonmaakbedrijven en andere dienstverleners die lokaal gevonden willen worden. Geen vaag gedoe — gewoon meer klanten.',
  },
  {
    q: 'Wat kost het om met NXG-media te werken?',
    a: 'Onze pakketten starten vanaf €299 per maand (Gevonden). Het meest gekozen pakket is Groei (€599/mnd) met advertenties en landingspagina\'s erbij. <a href="/contact/">Plan een gratis gesprek</a> en we kijken samen wat bij jou past.',
  },
  {
    q: 'Hoe snel zie ik resultaat?',
    a: 'Bij het Gevonden pakket zie je meestal binnen 4-6 weken betere posities in Google. Met het Groei pakket (incl. advertenties) komen de eerste leads vaak al in de eerste 2 weken binnen.',
  },
  {
    q: 'Wat is het verschil met een gewoon marketingbureau?',
    a: 'Wij combineren vindbaarheid in Google én AI-zoekmachines (ChatGPT, Gemini) met advertenties die direct klanten opleveren. Geen praatjes, maar een systeem dat werkt. En je hebt altijd persoonlijk contact — geen ticketsysteem.',
  },
  {
    q: 'Wat is AI-vindbaarheid?',
    a: 'Steeds meer mensen zoeken via ChatGPT, Google AI en andere AI-tools. Wij zorgen dat jouw bedrijf ook daar gevonden wordt. <a href="' + siteConfig.external.scannerUrl + '" target="_blank" rel="noopener">Check gratis hoe je nu scoort</a>.',
  },
  {
    q: 'Zit ik ergens aan vast?',
    a: 'Nee. Onze pakketten zijn maandelijks opzegbaar. We geloven dat je blijft omdat het werkt, niet omdat je vastzit aan een contract.',
  },
];

const socialPosts = getSocialPosts(6, 'nl');

const faqForSchema = homepageFaq.map((f) => ({ question: f.q, answer: f.a }));

const schemas = [
  generateOrganization(locale),
  generateWebSite(locale),
  generateFounderPerson(locale),
  generateFAQPage(faqForSchema, locale),
];
---

<BaseLayout
  title="NXG-media — Word gevonden. Word gekozen. Krijg meer aanvragen."
  description="NXG-media helpt praktisch MKB om beter vindbaar te zijn in Google, ChatGPT en andere AI-zoekmachines — en combineert dat met advertenties die klanten opleveren."
  locale={locale}
  hreflang={hreflang}
  schemas={schemas}
  hideNewsletter={true}
>

  {/* ══════════════════════════════════════════════════
      HERO — blauw met foto + sticky notes
      ══════════════════════════════════════════════════ */}
  <section class="bg-primary text-white relative overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 md:px-6 py-12 md:py-20 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">

        {/* Left: copy */}
        <div class="relative z-10">
          <h1 class="font-heading font-black text-[2.25rem] leading-[1.08] md:text-5xl lg:text-6xl text-white mb-6">
            Word gevonden.<br />
            Word gekozen.<br />
            <span class="text-accent">Krijg meer aanvragen.</span>
          </h1>

          <p class="text-white/80 text-base md:text-lg leading-relaxed mb-8 max-w-lg">
            <strong class="text-white font-semibold">NXG-media</strong> helpt praktisch MKB om beter vindbaar
            te zijn in Google, ChatGPT en andere AI-zoekmachines
            — en combineert dat met advertenties die klanten opleveren.
          </p>

          <div class="flex flex-wrap gap-3 mb-8">
            <a
              href="/contact/"
              class="inline-flex items-center gap-2 px-6 py-3.5 text-base font-bold text-text bg-accent hover:bg-accent-dark transition-colors rounded-button"
            >
              Plan een gratis gesprek
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            </a>
            <a
              href="#pakketten"
              class="inline-flex items-center gap-2 px-6 py-3.5 text-base font-medium text-white border-2 border-white/30 hover:border-white/60 transition-colors rounded-button"
            >
              Bekijk onze pakketten
            </a>
          </div>

          <p class="font-script text-2xl md:text-3xl text-accent -rotate-2 inline-block">
            Niet lullen. Poetsen.
          </p>
        </div>

        {/* Right: hero photo + sticky notes */}
        <div class="relative flex justify-center lg:justify-end">
          <div class="relative">
            <Image
              src={heroPhoto}
              alt="Joost van Putten — oprichter NXG-media"
              width={520}
              height={640}
              class="relative z-10 max-h-[500px] md:max-h-[580px] w-auto object-contain drop-shadow-2xl"
              loading="eager"
            />

            {/* Sticky note: testimonial */}
            <div class="absolute top-4 right-0 md:-right-4 z-20 sticky-note text-base md:text-lg max-w-[200px] rotate-2">
              "Meer aanvragen.<br />Dat is pas echt werk."
            </div>

            {/* Sticky note: MKB badge */}
            <div class="absolute bottom-16 -right-2 md:right-0 z-20 sticky-note text-lg md:text-xl font-black uppercase -rotate-3">
              MKB doet<br />het gewoon.
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* Script tagline strip */}
    <div class="border-t border-white/10 py-4">
      <div class="max-w-7xl mx-auto px-4 md:px-6 flex flex-wrap items-center justify-center gap-6 md:gap-12 text-center">
        <p class="font-script text-xl md:text-2xl text-accent -rotate-1">Agencytaal eruit.</p>
        <p class="font-heading font-extrabold text-lg md:text-xl text-white">
          <span class="text-accent">Resultaat</span> erin.
        </p>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      TRUST STRIP — 3 kernpunten
      ══════════════════════════════════════════════════ */}
  <section class="py-10 md:py-14 border-b border-border">
    <div class="max-w-5xl mx-auto px-4 md:px-6">
      <div class="grid md:grid-cols-3 gap-8 md:gap-10">

        <div class="flex items-start gap-4">
          <div class="shrink-0 w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
            <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8" /><path stroke-linecap="round" d="m21 21-4.35-4.35" /></svg>
          </div>
          <div>
            <h3 class="font-heading font-extrabold text-base mb-1">Google + AI</h3>
            <p class="text-text-muted text-sm leading-relaxed">Beter vindbaar in Google, ChatGPT en andere AI-zoekmachines.</p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="shrink-0 w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
            <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
          </div>
          <div>
            <h3 class="font-heading font-extrabold text-base mb-1">Duidelijke prijs</h3>
            <p class="text-text-muted text-sm leading-relaxed">Transparante pakketten. Geen verrassingen.</p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="shrink-0 w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
            <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
          </div>
          <div>
            <h3 class="font-heading font-extrabold text-base mb-1">Geen vaag gedoe</h3>
            <p class="text-text-muted text-sm leading-relaxed">Praktisch, persoonlijk en resultaatgericht.</p>
          </div>
        </div>

      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      LOGO MARQUEE — klantlogo's
      ══════════════════════════════════════════════════ */}
  <LogoMarquee
    logos={logos}
    label="Vertrouwd door ondernemers door heel Nederland"
    speed={35}
  />


  {/* ══════════════════════════════════════════════════
      VIDEO TESTIMONIALS
      ══════════════════════════════════════════════════ */}
  <VideoTestimonialCarousel
    title="Wat klanten zeggen"
    subtitle="Echte ondernemers over hun samenwerking met NXG-media"
    testimonials={videoTestimonials}
  />


  {/* ══════════════════════════════════════════════════
      AI SCANNER CTA
      ══════════════════════════════════════════════════ */}
  <section class="bg-primary text-white py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 md:px-6 text-center">
      <p class="font-script text-2xl md:text-3xl text-accent -rotate-1 mb-4">Benieuwd hoe je scoort?</p>
      <h2 class="font-heading font-black text-2xl md:text-4xl lg:text-5xl text-white mb-4">
        Gratis AI-vindbaarheidscheck
      </h2>
      <p class="text-white/80 text-base md:text-lg leading-relaxed max-w-2xl mx-auto mb-8">
        Ontdek in 30 seconden hoe goed jouw bedrijf vindbaar is in Google én AI-zoekmachines
        zoals ChatGPT. Geen gedoe, geen account nodig.
      </p>
      <a
        href={siteConfig.external.scannerUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-8 py-4 text-lg font-bold text-text bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg"
      >
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8" /><path stroke-linecap="round" d="m21 21-4.35-4.35" /></svg>
        Check jouw vindbaarheid
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" /></svg>
      </a>
      <p class="mt-4 text-white/50 text-sm">Gratis · Geen account · Resultaat in 30 seconden</p>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      PAKKETTEN — 3-tier pricing
      ══════════════════════════════════════════════════ */}
  <section id="pakketten" class="py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4 md:px-6">

      <div class="mb-10 md:mb-14">
        <p class="text-primary font-heading font-extrabold text-xs uppercase tracking-widest mb-2">Onze pakketten</p>
        <div class="flex flex-wrap items-end gap-4 md:gap-8">
          <h2 class="font-heading font-black text-3xl md:text-5xl lg:text-6xl text-text leading-none">
            Kies jouw pakket.
          </h2>
          <p class="font-script text-xl md:text-2xl text-primary -rotate-2 mb-1">
            Zelfde doel.<br />Meer resultaat.
          </p>
        </div>
        <p class="text-text-muted mt-4 max-w-2xl">
          Of je nu net begint of wilt doorgroeien — wij hebben een pakket dat past bij jouw ambities.
          Alle pakketten zijn gericht op meer zichtbaarheid, meer verkeer en meer klanten.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 lg:gap-8">

        {/* Gevonden — €299 */}
        <div class="relative border-2 border-border rounded-2xl p-6 md:p-8 flex flex-col">
          <h3 class="font-heading font-black text-2xl mb-1">Gevonden</h3>
          <p class="text-text-muted text-sm mb-4">Start met zichtbaarheid.</p>
          <p class="font-heading font-black text-5xl md:text-6xl text-text mb-1">&euro;299</p>
          <p class="text-text-muted text-sm mb-6">per maand</p>

          <ul class="space-y-3 mb-8 flex-1">
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Website optimalisatie</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Lokaal beter gevonden</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Google Business profiel</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Maandelijkse rapportage</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Persoonlijke support</li>
          </ul>

          <a href="/contact/" class="block w-full py-3.5 text-center font-bold text-text border-2 border-text rounded-button hover:bg-text hover:text-white transition-colors">
            Start met Gevonden &rarr;
          </a>
          <p class="font-script text-base text-text-muted mt-4 -rotate-1 text-center">Een sterke basis.<br />Meer klanten.</p>
        </div>

        {/* Groei — €599 (highlighted) */}
        <div class="relative border-2 border-primary rounded-2xl p-6 md:p-8 flex flex-col shadow-lg">
          <div class="absolute -top-4 left-1/2 -translate-x-1/2 z-10">
            <span class="sticky-note text-sm font-black uppercase px-4 py-1.5 rotate-[-2deg]">Meest gekozen</span>
          </div>

          <h3 class="font-heading font-black text-2xl mb-1">Groei</h3>
          <p class="text-text-muted text-sm mb-4">Meer verkeer. Meer klanten.</p>
          <p class="font-heading font-black text-5xl md:text-6xl text-text mb-1">&euro;599</p>
          <p class="text-text-muted text-sm mb-6">per maand</p>

          <ul class="space-y-3 mb-8 flex-1">
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Alles uit het Gevonden pakket</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Advertenties (Google & Social)</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Landingspagina's die converteren</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Maandelijkse content</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Strategie & optimalisatie</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Persoonlijke support</li>
          </ul>

          <a href="/contact/" class="block w-full py-3.5 text-center font-bold text-text bg-accent hover:bg-accent-dark rounded-button transition-colors">
            Start met Groei &rarr;
          </a>
          <p class="font-script text-base text-text-muted mt-4 -rotate-1 text-center">Meer zichtbaarheid.<br />Meer werk.</p>
        </div>

        {/* Volle agenda — €999 */}
        <div class="relative border-2 border-border rounded-2xl p-6 md:p-8 flex flex-col">
          <h3 class="font-heading font-black text-2xl mb-1">Volle agenda</h3>
          <p class="text-text-muted text-sm mb-4">Maximale groei. Geen lege dagen.</p>
          <p class="font-heading font-black text-5xl md:text-6xl text-text mb-1">&euro;999</p>
          <p class="text-text-muted text-sm mb-6">per maand</p>

          <ul class="space-y-3 mb-8 flex-1">
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Alles uit het Groei pakket</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Uitgebreide advertentiecampagnes</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Meerdere landingspagina's</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Content creatie (foto, video, tekst)</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Continue optimalisatie</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Strategisch advies</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Prioriteit support</li>
          </ul>

          <a href="/contact/" class="block w-full py-3.5 text-center font-bold text-text border-2 border-text rounded-button hover:bg-text hover:text-white transition-colors">
            Start met Volle agenda &rarr;
          </a>
          <p class="font-script text-base text-text-muted mt-4 -rotate-1 text-center">Meer leads. Meer omzet.<br />Meer vrijheid.</p>
        </div>

      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      OVER JOOST — founder preview
      ══════════════════════════════════════════════════ */}
  <FounderPreview
    name={siteConfig.founder.name}
    role={siteConfig.founder.role}
    bio={siteConfig.founder.bio.nl}
    image={founderPhoto}
    credentials={siteConfig.founder.credentials}
    knowsAbout={siteConfig.founder.knowsAbout.nl}
    aboutHref="/over-joost/"
    aboutLabel="Meer over Joost"
    locale="nl"
  />


  {/* ══════════════════════════════════════════════════
      FAQ
      ══════════════════════════════════════════════════ */}
  <FAQAccordion
    title="Veelgestelde vragen"
    items={homepageFaq}
    locale="nl"
    pageType="homepage"
    pageSlug="/"
  />


  {/* ══════════════════════════════════════════════════
      INSTAGRAM GRID — persoonlijk
      ══════════════════════════════════════════════════ */}
  <SocialStorytellingGrid
    posts={socialPosts}
    instagramUrl={siteConfig.socials.instagram}
    locale="nl"
  />


  {/* ══════════════════════════════════════════════════
      FOOTER CTA BAND
      ══════════════════════════════════════════════════ */}
  <section class="border-t border-border py-8 md:py-10">
    <div class="max-w-7xl mx-auto px-4 md:px-6">
