---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '../styles/lander.css';
import '../styles/home.css';
import landerScriptUrl from '../scripts/lander.js?url';
import SEOHead from '../components/SEOHead.astro';
import Header from '../components/Header.astro';
import CookieConsent from '../components/CookieConsent.astro';
import { getTrackingScript, getCapiHelperScript } from '../lib/analytics';
import { siteConfig } from '../data/site';
import { generateOrganization, generateWebSite, generateFounderPerson, generateFAQPage } from '../data/schema';
import { buildHreflangTrilingual } from '../i18n/hreflang';
import { videoTestimonials } from '../data/videoTestimonials';
import heroPhoto from '../assets/images/founder/joost-standing-relaxed.webp';
const clientLogoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/Client-logos/*.{webp,avif,png,jpg}', { eager: true });
const clientLogos = Object.entries(clientLogoFiles).map(([file, mod]) => ({ src: mod.default, alt: file.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/i, '').replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim() }));
const faq=[
{question:'Voor welke bedrijven werken jullie?',answer:'Voor ondernemers die aanvragen nodig hebben: van vakbedrijven en lokale praktijken tot coaches en experts. We kijken naar jouw diensten, doelgroep en groeiplannen om te bepalen welke aanpak past.'},
{question:'Wat doen jullie rondom AI Search?',answer:'We combineren een sterke website, content en technische optimalisatie voor organische AI-vindbaarheid met AI Search Ads waar dat past. We werken aan vindbaarheid in zoekmachines en AI-antwoorden en aan de route van bezoeker naar aanvraag.'},
{question:'Wat kost samenwerken met NXG-media?',answer:'NXG Fundament kost €349 per maand voor drie maanden (€1.047 totaal). NXG Growth kost €799 per maand voor de eerste drie maanden (€2.397 totaal), inclusief Fundament. Advertentiebudget komt daar apart bij. Voor de inhoud en garantievoorwaarden verwijzen we naar het complete Growth-aanbod.'},
{question:'Moet ik meteen voor Growth kiezen?',answer:'Nee. We bekijken eerst wat je nodig hebt. Je kunt beginnen met je Fundament of kiezen voor een aanpak waarin we ook doorlopend aan vindbaarheid, campagnes en aanvragen werken.'},
{question:'Blijft mijn website van mij?',answer:'Het opgeleverde Fundament, je content en de optimalisaties die we bouwen blijven van jou. Doorlopende hosting-, app- en licentiekosten en de afspraken over overdracht leggen we vooraf vast.'},
{question:'Hoe beginnen we?',answer:'Plan een kennismaking of vul eerst de gratis AI Search-scanner in. In het gesprek bespreken we waar je nu staat, wat je wilt bereiken en welke aanpak en investering daarbij passen.'}
];
const schemas=[generateOrganization('nl'),generateWebSite('nl'),generateFounderPerson('nl'),generateFAQPage(faq,'nl')];
---
<!doctype html><html lang="nl"><head>
<SEOHead title="NXG-media | AI Search Agency voor meer aanvragen" description="Meer aanvragen via de nieuwe generatie zoeken. NXG-media combineert AI-vindbaarheid, AI Search Ads en websites die converteren. Bekijk ons werk en onze aanpak." canonical="https://nxg-media.com/" locale="nl" hreflang={buildHreflangTrilingual('/', '/en/', '/es/')} schemas={schemas} />
<meta name="theme-color" content="#0756ef">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800;900&family=DM+Sans:wght@400;500;600;650;700;800&display=swap" rel="stylesheet">
</head><body class="nxg-home"><a class="skip" href="#main">Naar inhoud</a>
<Header locale="nl" currentPath="/" hreflang={buildHreflangTrilingual('/', '/en/', '/es/')} />
<main id="main">
<section class="home-hero"><div class="wrap home-hero-grid"><div class="home-hero-copy"><p class="eyebrow light">NXG-MEDIA · AI SEARCH AGENCY</p><h1>GOED IN JE VAK.<br><span class="home-underline">NU NOG<br>GEVONDEN WORDEN.</span></h1><p>Jouw volgende klant is al aan het zoeken. Wij helpen je in beeld te komen én van die interesse aanvragen te maken.</p><p class="home-hero-method">AI-vindbaarheid <span>+</span> AI Search Ads <span>+</span> een website die converteert.</p><div class="home-actions"><a class="button yellow" href="/contact/">Bespreek jouw groeiplannen <span aria-hidden="true">↗</span></a><a class="home-secondary" href="#cases">Bekijk ons werk ↓</a></div></div><div class="home-portrait"><Image src={heroPhoto} alt="Joost van Putten, oprichter van NXG-media" width={660} height={780} loading="eager" fetchpriority="high" /><div class="home-photo-caption"><span>JOUW AMBITIE. ONZE AANPAK.</span><strong>Jij onderneemt.<br>Wij bouwen mee.</strong><a href="/over-joost/">Joost van Putten · Oprichter ↗</a></div><span class="home-experience"><b>7+</b> jaar ervaring<br>in online marketing</span></div></div></section>
<section class="client-proof" aria-label="Bedrijven waarvoor we marketingwerk hebben gedaan"><div class="wrap proof-heading"><p>MARKETINGWERK VOOR ONDER ANDERE</p><button class="logos-toggle" type="button" aria-pressed="false">Logo’s pauzeren</button></div><div class="client-window"><div class="client-track">{[0, 1].map(copy => <div class="client-group" aria-hidden={copy === 1 ? 'true' : undefined}>{clientLogos.map(logo => <div class="client-logo"><Image src={logo.src} alt={copy === 0 ? logo.alt : ''} height={48} loading="lazy" decoding="async" /></div>)}</div>)}</div></div></section><section class="section home-services" id="diensten"><div class="wrap"><div class="home-section-heading"><div><p class="eyebrow">VAN ZOEKVRAAG NAAR AANVRAAG</p><h2>ALLES MOET<br><span class="blue">SAMENWERKEN.</span></h2></div><p>Een mooie website alleen is niet genoeg. We verbinden vindbaarheid, campagnes en conversie. Met één aanspreekpunt dat meebouwt.</p></div><div class="home-service-grid"><a class="home-service" href="/ai-vindbaarheid-traject-b/"><span class="home-index">01 / GEVONDEN WORDEN</span><h3>AI-<br>VINDBAARHEID.</h3><p>Laat jouw expertise terugkomen waar mensen zoeken. In Google én in antwoorden van AI-tools zoals ChatGPT en Gemini.</p><span class="home-service-link">Ontdek AI-vindbaarheid ↗</span></a><a class="home-service" href="/landermkb/"><span class="home-index">02 / INTERESSE AANTREKKEN</span><h3>AI SEARCH<br>ADS.</h3><p>Bereik mensen die al zoeken naar wat je aanbiedt. Met gerichte campagnes als onderdeel van jouw Growth-aanpak.</p><span class="home-service-link">Bekijk NXG Growth ↗</span></a><a class="home-service" href="/website-abonnement/"><span class="home-index">03 / GEKOZEN WORDEN</span><h3>WEBSITES DIE<br>OVERTUIGEN.</h3><p>Een duidelijke website die laat zien waarom klanten voor jou moeten kiezen. Snel, overtuigend en met een heldere route naar contact.</p><span class="home-service-link">Bekijk onze websites ↗</span></a></div><a class="home-expert-link" href="/coach-accelerator/">Coach of expert? Bekijk ook onze Coach Accelerator <span>↗</span></a></div></section><section class="section results" id="cases"><div class="wrap"><p class="eyebrow">AI SEARCH IN DE PRAKTIJK</p><h2>VAN GEVONDEN WORDEN.<br><span class="blue">NAAR ECHTE AANVRAGEN.</span></h2><p class="results-intro">Twee klanten voor wie we het online fundament en de vindbaarheid hebben aangepakt. Dit leverde het op.</p><div class="case-grid"><article class="result-card"><div class="case-person"><img src="/lander-assets/proof/james.webp" alt="Dr. James Mitchell" width="80" height="80" loading="lazy"><div><strong>Costa Blanca Movement Centre</strong><a href="https://www.costablancamovement.com/" target="_blank" rel="noopener noreferrer">costablancamovement.com ↗</a></div></div><h3>VAN NUL NAAR<br>12–15 PATIËNTEN PER MAAND.</h3><p>Geen website, geen Google-historie en geen backlinks. Binnen 14 dagen stond het nieuwe fundament op pagina 1 in Google. Na 2 maanden kwamen er 12–15 patiënten per maand online binnen.</p><div class="case-metrics"><div><strong>12–15</strong><span>patiënten per maand online</span></div><div><strong>800+</strong><span>organische bezoekers per maand</span></div></div><div class="case-proof"><a href="/lander-assets/proof/google-proof.webp" target="_blank" rel="noopener"><img src="/lander-assets/proof/google-proof.webp" alt="Google-resultaat uit de Costa Blanca Movement Centre case" width="600" height="360" loading="lazy"><span>Google pagina 1 na 14 dagen · bekijk bewijs ↗</span></a><a href="/lander-assets/proof/chatgpt-proof.webp" target="_blank" rel="noopener"><img src="/lander-assets/proof/chatgpt-proof.webp" alt="ChatGPT noemt Costa Blanca Movement Centre als lokale optie" width="600" height="360" loading="lazy"><span>Genoemd door ChatGPT · bekijk bewijs ↗</span></a></div></article><article class="result-card"><div class="case-person"><img src="/lander-assets/proof/verena.webp" alt="Dr. Verena Mann" width="80" height="80" loading="lazy"><div><strong>Dr. Verena Mann</strong><a href="https://doc-veri.pages.dev/" target="_blank" rel="noopener noreferrer">doc-veri.pages.dev ↗</a></div></div><h3>VAN 2 NAAR 19<br>AANVRAGEN PER MAAND.</h3><p>Wel expertise en een community, maar nauwelijks aanvragen via de website. Door haar expertise, bewijs en aanvraagroute duidelijker neer te zetten, groeide ze naar 19 aanvragen per maand en werd ze genoemd door ChatGPT.</p><div class="case-metrics"><div><strong>2 → 19</strong><span>aanvragen per maand</span></div><div><strong>0 → 15</strong><span>AI-vermeldingen</span></div></div><div class="case-proof single"><a href="/lander-assets/proof/verena-proof.webp" target="_blank" rel="noopener"><img src="/lander-assets/proof/verena-proof.webp" alt="ChatGPT-vermelding van Dr. Verena Mann uit haar case" width="1200" height="360" loading="lazy"><span>Genoemd als expert door ChatGPT · bekijk bewijs ↗</span></a></div></article></div><div class="results-bottom"><p>Van lokale praktijk tot groeiend bedrijf.<br><strong>Bekijk het werk achter de resultaten.</strong></p><a class="button yellow" href="/cases/">Meer klantcases <span aria-hidden="true">↗</span></a></div></div></section><section class="section home-testimonials"><div class="wrap"><div class="home-section-heading"><div><p class="eyebrow">DE SAMENWERKING, IN HUN WOORDEN</p><h2>ZIJ WERKTEN<br><span class="blue">AL MET JOOST.</span></h2></div><p>Van campagnes tot groeistrategie: hoor van ondernemers zelf hoe zij de samenwerking hebben ervaren.</p></div><div class="home-video-track" tabindex="0" role="region" aria-label="Klantvideo’s, horizontaal scrollbaar">{videoTestimonials.map(v=><article class="home-video-card"><video controls playsinline preload="none" poster={v.thumbnail.src} aria-label={'Ervaring van '+v.name+' van '+v.company}><source src={v.videoUrl} type="video/mp4" /><a href={v.videoUrl}>Bekijk de video van {v.name}</a></video><div><h3>{v.name}</h3><p class="home-company">{v.company}</p><blockquote>{v.quote}</blockquote></div></article>)}</div><p class="home-scroll-hint">Scroll door de vijf klantverhalen →</p></div></section><section class="section home-offers" id="pakketten"><div class="wrap"><div class="home-section-heading"><div><p class="eyebrow">EEN HELDERE VOLGENDE STAP</p><h2>JOUW BASIS.<br><span class="blue">JOUW GROEI.</span></h2></div><p>Begin met een sterk Fundament. Of laat ons met Growth ook actief aan jouw volgende aanvragen werken.</p></div><div class="home-offer-grid"><article><p class="eyebrow">NXG FUNDAMENT</p><h3>KLAAR VOOR DE<br>NIEUWE GENERATIE ZOEKEN.</h3><p>Een website, content en technische basis die jouw expertise zichtbaar maken en bezoekers naar contact leiden.</p><div class="home-price">€349 <span>/ maand</span></div><p>3 maanden · €1.047 totaal</p><a class="button home-outline" href="/landermkb/#investering">Bekijk het Fundament <span>↗</span></a></article><article class="home-growth"><p class="eyebrow">NXG GROWTH · HET COMPLETE SYSTEEM</p><h3>JE FUNDAMENT.<br>EN ACTIEF MEER AANVRAGEN.</h3><p>Inclusief Fundament, doorlopende AI-vindbaarheid, AI Search Ads waar nodig en verbetering van je aanvraagroute.</p><div class="home-price">€799 <span>/ maand</span></div><p>Eerste 3 maanden · €2.397 totaal</p><a class="button black" href="/landermkb/">Ontdek Growth en de garantie <span>↗</span></a><p class="home-offer-note">Advertentiebudget apart. Bekijk de afspraken en voorwaarden bij het aanbod.</p></article></div></div></section><section class="section founder"><div class="wrap founder-grid"><div class="founder-photo"><img src="/lander-assets/proof/joost.webp" alt="Joost van Putten, oprichter van NXG-media, aan het werk" width="850" height="1000" loading="lazy"><span>Joost van Putten · Oprichter NXG-media</span></div><div><p class="eyebrow">DE MENS ACHTER NXG-MEDIA</p><h2>HI, IK BEN JOOST.<br><span class="blue">IK BOUW MEE.</span></h2><p>Al meer dan 7 jaar help ik ondernemers met online marketing. Van campagnes tot websites: ik wil weten wat het oplevert voor het bedrijf erachter.</p><p class="strong">Jij wilt klanten. Wij maken concreet hoe we aan jouw volgende aanvragen gaan werken.</p><a class="text-link" href="/over-joost/">Meer over Joost <span aria-hidden="true">↗</span></a></div></div></section><section class="home-scanner"><div class="wrap"><div><p class="eyebrow">BEGIN MET INZICHT</p><h2>NOEMT AI JOU.<br>OF JE CONCURRENT?</h2><p>Ontdek hoe jouw bedrijf ervoor staat met onze gratis AI Search-scanner.</p></div><a class="button black" href={siteConfig.external.scannerUrl} target="_blank" rel="noopener noreferrer">Check mijn AI-vindbaarheid <span aria-hidden="true">↗</span></a></div></section>
<section class="section faq"><div class="wrap faq-grid"><div><p class="eyebrow">GOED OM TE WETEN</p><h2>GOEDE<br><span class="blue">VRAGEN.</span></h2></div><div class="questions">{faq.map(f=><details><summary>{f.question}</summary><p>{f.answer}</p></details>)}</div></div></section>
<section class="home-contact"><div class="wrap"><p class="eyebrow light">JE HOEFT HET NIET ALLEEN UIT TE ZOEKEN</p><h2>WAT WIL JIJ<br><span class="home-underline">LATEN GROEIEN?</span></h2><p>Vertel waar je staat en waar je naartoe wilt.<br>Dan bekijken we samen wat daarvoor nodig is.</p><a class="button yellow" href="/contact/">Laten we kennismaken <span aria-hidden="true">↗</span></a></div></section>
</main><footer><div class="wrap home-footer"><div><a class="brand" href="/">NXG<span>-media</span><small>AI Search Agency</small></a><p>Jij onderneemt.<br>Wij bouwen mee.</p></div><div><h3>ONTDEK</h3><a href="/landermkb/">NXG Growth</a><a href="/ai-vindbaarheid-traject-b/">AI-vindbaarheid</a><a href="/website-abonnement/">Websites</a><a href="/coach-accelerator/">Coach Accelerator</a></div><div><h3>NXG-MEDIA</h3><a href="/cases/">Cases</a><a href="/over-joost/">Over Joost</a><a href="/guides/">Kennis</a><a href="/contact/">Contact</a></div><div><h3>HOUD CONTACT</h3><a href={'mailto:'+siteConfig.email}>{siteConfig.email}</a><a href={siteConfig.socials.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href={siteConfig.socials.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a><p><a href="/en/" lang="en">English</a> · <a href="/es/" lang="es">Español</a></p></div></div><div class="wrap footer-bottom"><span>© <span id="year">2026</span> NXG-media · KVK 78318122</span><span><a href="/privacy/">Privacy</a> · <a href="/voorwaarden/">Voorwaarden</a></span></div></footer>
<CookieConsent locale="nl" /><script is:inline set:html={getTrackingScript()} /><script is:inline set:html={getCapiHelperScript()} /><script is:inline src={landerScriptUrl}></script></body></html>