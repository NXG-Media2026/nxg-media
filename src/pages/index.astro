---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustBar from '../components/TrustBar.astro';
import TestimonialSlider from '../components/TestimonialSlider.astro';
import SocialStorytellingGrid from '../components/SocialStorytellingGrid.astro';
import FounderPreview from '../components/FounderPreview.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import { siteConfig } from '../data/site';
import { generateOrganization, generateWebSite, generateFounderPerson, generateFAQPage } from '../data/schema';
import { buildHreflangTrilingual } from '../i18n/hreflang';
import { getTestimonials } from '../data/testimonials';
import { getSocialPosts } from '../data/socialPosts';

import heroPhoto from '../assets/images/founder/joost-standing-workinglaptop.webp';
import founderPhoto from '../assets/images/founder/joost-sitting-laptop-looking-working.webp';

const locale = 'nl';
const hreflang = buildHreflangTrilingual('/', '/en/', '/es/');

const testimonials = getTestimonials({ locale: 'nl' });
const socialPosts = getSocialPosts(6);

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logos/*.webp', { eager: true });
const logos = Object.entries(logoFiles).map(([path, mod]) => {
  const filename = path.split('/').pop()!.replace('.webp', '');
  const name = filename.replace('-logo', '').replace(/-/g, ' ');
  return { src: mod.default, alt: name };
});

const guides = (await getCollection('guides'))
  .filter((g) => g.data.locale === locale)
  .sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime())
  .slice(0, 4);

const trustItems = [
  { value: '50+', label: 'Coaches begeleid' },
  { value: '€5M+', label: 'Ads budget beheerd' },
  { value: '5-7×', label: 'Gemiddelde ROAS' },
  { value: '7+', label: 'Jaar ervaring' },
];

const homepageFaq = [
  {
    q: 'Wat kost het om met NXG Media te werken?',
    a: 'Dat hangt af van je situatie. Onze micro-producten beginnen bij €6,99 als je zelf aan de slag wilt. Het Expert Growth Accelerator traject is een vast traject met setup + maandelijkse optimalisatie. <a href="/contact/">Neem contact op</a> voor een vrijblijvend gesprek.',
  },
  {
    q: 'Werken jullie alleen met coaches?',
    a: 'Nee. We werken met twee clusters: Expert Growth (coaches, kennisondernemers, experts) en AI Vindbaarheid (lokale praktijken, MKB). De aanpak verschilt, maar het uitgangspunt is hetzelfde: bouw een systeem, geen losse campagnes.',
  },
  {
    q: 'Hoe snel zie ik resultaat?',
    a: 'De eerste resultaten bij Expert Growth zie je meestal binnen 2-4 weken (eerste leads, eerste productverkopen). Een volledig draaiend systeem kost 2-3 maanden. Bij AI Vindbaarheid kun je na het toepassen van de kits direct opnieuw scannen en het verschil zien.',
  },
  {
    q: 'Wat is het verschil tussen NXG Media en een gewoon marketingbureau?',
    a: 'Wij bouwen complete groeisystemen — geen losse campagnes of websites. Storytelling, producten, emailflows, ads en AI-vindbaarheid werken samen als één machine. Dat is het verschil tussen "meer zichtbaarheid" en "voorspelbare groei".',
  },
  {
    q: 'Moet ik al een groot publiek hebben?',
    a: 'Nee. Het systeem is juist ontworpen om je publiek en je leadflow tegelijk op te bouwen. Met een klein advertentiebudget (€5-10/dag) haal je dagelijks 20-50 gekwalificeerde volgers.',
  },
];

const faqForSchema = homepageFaq.map((f) => ({ question: f.q, answer: f.a }));
---

<BaseLayout
  title={`${siteConfig.name} — ${siteConfig.tagline.nl}`}
  description="Bouw een online groeisysteem rond jouw expertise. Expert Growth voor coaches en experts. AI-vindbaarheid voor lokale praktijken."
  hreflang={hreflang}
  schemas={[generateOrganization(), generateWebSite(locale), generateFounderPerson(), generateFAQPage(faqForSchema)]}
  locale={locale}
>

  {/* ── Hero ── */}
  <section class="relative py-20 md:py-28 lg:py-36 overflow-hidden">
    <div class="absolute inset-0">
      <Image
        src={heroPhoto}
        alt=""
        widths={[800, 1200, 1600]}
        sizes="100vw"
        class="w-full h-full object-cover"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-white/95 via-white/80 to-white/40"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 md:px-6">
      <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl text-text mb-6 leading-tight max-w-2xl">
        Bouw een online groeisysteem rond jouw expertise
      </h1>
      <p class="text-lg md:text-xl text-text-muted leading-relaxed mb-10 max-w-xl">
        Voor coaches en experts die hun kennis willen vertalen naar voorspelbare leads, productverkoop en coaching-aanvragen. En voor lokale praktijken die zichtbaar willen zijn in AI-tools.
      </p>
      <div class="flex flex-col sm:flex-row items-start gap-4">
        <a
          href="https://scanner.nxg-media.com"
          class="inline-flex items-center px-8 py-4 text-base font-medium text-text-inverse bg-primary hover:bg-primary-dark transition-colors rounded-button shadow-lg"
          target="_blank"
          rel="noopener noreferrer"
        >
          Doe de AI-vindbaarheidsscan
          <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
        </a>
        <a
          href="/diensten/expert-growth-accelerator/"
          class="inline-flex items-center px-8 py-4 text-base font-medium text-primary border-2 border-primary hover:bg-primary/5 transition-colors rounded-button"
        >
          Bekijk Expert Growth
        </a>
      </div>
    </div>
  </section>

  {/* ── Trust Bar ── */}
  <section class="bg-bg-alt border-y border-border">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <TrustBar items={trustItems} />
    </div>
  </section>

  {/* ── Recognition ── */}
  <section class="py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-8">Herken je dit?</h2>
      <div class="space-y-6">
        <p class="text-text-muted leading-relaxed">Je hebt al een goedlopend coachprogramma, maar je leadflow piekt en zakt. De ene maand drie nieuwe klanten, de andere maand nul — en je weet niet waarom.</p>
        <p class="text-text-muted leading-relaxed">Of je praktijk draait goed, maar als iemand aan ChatGPT vraagt naar een specialist in jouw regio, word je niet genoemd.</p>
      </div>
    </div>
  </section>

  {/* ── Wat NXG Media bouwt ── */}
  <section class="py-12 md:py-16 bg-bg-alt">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-6">Wat NXG Media bouwt</h2>
      <p class="text-lg text-text-muted leading-relaxed mb-8 max-w-3xl">
        Geen losse websites of ads-campagnes, maar geïntegreerde systemen waar storytelling, producten, emailflows en advertenties samenwerken.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="bg-white rounded-card p-6 border border-border">
          <h3 class="font-heading text-lg text-text mb-2">Storytelling & Content</h3>
          <p class="text-sm text-text-muted">Verhalen die resoneren met je ideale klant — geen generieke taglines.</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <h3 class="font-heading text-lg text-text mb-2">Productladder</h3>
          <p class="text-sm text-text-muted">Van gratis naar betaald — elk product kwalificeert leads voor het volgende.</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <h3 class="font-heading text-lg text-text mb-2">Email & Automatisering</h3>
          <p class="text-sm text-text-muted">Geautomatiseerde flows die leads onboarden en kopers opvolgen.</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <h3 class="font-heading text-lg text-text mb-2">Ads & Meetbaarheid</h3>
          <p class="text-sm text-text-muted">Meta Ads die het systeem voeden, met tracking die laat zien wat converteert.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── Two clusters ── */}
  <section class="py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-white rounded-card p-8 border border-border hover:border-accent/30 hover:shadow-lg transition-all">
          <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/10 text-accent rounded-full mb-4">expert-growth</span>
          <h2 class="font-heading text-xl text-text mb-3">Expert Growth Accelerator</h2>
          <p class="text-text-muted text-sm leading-relaxed mb-6">
            Een vast traject voor coaches en experts die hun expertise willen vertalen naar een online instaproute — met storytelling, masterclasses, mini-producten, emailflows en advertenties die samen leiden naar kopers, klanten of leden.
          </p>
          <a href="/diensten/expert-growth-accelerator/" class="inline-flex items-center text-accent hover:text-accent-dark transition-colors font-medium text-sm">
            Meer over Expert Growth
            <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
        <div class="bg-white rounded-card p-8 border border-border hover:border-accent/30 hover:shadow-lg transition-all">
          <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-primary/10 text-primary rounded-full mb-4">ai-vindbaarheid</span>
          <h2 class="font-heading text-xl text-text mb-3">AI Vindbaarheid</h2>
          <p class="text-text-muted text-sm leading-relaxed mb-6">
            AI-vindbaarheid is nog een nieuw speelveld. Daarom beginnen we met een praktische scan: waar sta je nu, wat ontbreekt er en welke verbeteringen zijn logisch? Van scan naar kits naar full audit.
          </p>
          <a href="/diensten/ai-vindbaarheid-audit/" class="inline-flex items-center text-accent hover:text-accent-dark transition-colors font-medium text-sm">
            Meer over AI Vindbaarheid
            <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ── Proof Wall ── */}
  <section class="py-16 md:py-20 bg-bg-alt">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-10 text-center">Resultaten van klanten</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-white rounded-card p-6 border border-border">
          <h3 class="font-heading text-lg text-text mb-1">Happy With Yoga</h3>
          <p class="text-xs text-text-muted mb-3">Sinds 2022</p>
          <div class="space-y-2">
            <p class="text-sm"><strong class="text-accent">30.000+</strong> webinarleads</p>
            <p class="text-sm"><strong class="text-accent">1.700+</strong> mini-cursusverkopen</p>
            <p class="text-sm"><strong class="text-accent">2.000</strong> betalende platformleden</p>
          </div>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <h3 class="font-heading text-lg text-text mb-1">Tessa / Youlife</h3>
          <p class="text-xs text-text-muted mb-3">Sinds feb 2025</p>
          <div class="space-y-2">
            <p class="text-sm"><strong class="text-accent">±€10k/mnd</strong> online producten</p>
            <p class="text-sm"><strong class="text-accent">6</strong> producten gelanceerd</p>
            <p class="text-sm"><strong class="text-accent">±10/mnd</strong> coachingklanten</p>
          </div>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <h3 class="font-heading text-lg text-text mb-1">Coach Josine</h3>
          <p class="text-xs text-text-muted mb-3">Sinds okt 2025</p>
          <div class="space-y-2">
            <p class="text-sm"><strong class="text-accent">600×</strong> gids verkocht</p>
            <p class="text-sm"><strong class="text-accent">80</strong> masterclass-aanmeldingen</p>
          </div>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <h3 class="font-heading text-lg text-text mb-1">Manon van Bakel</h3>
          <p class="text-xs text-text-muted mb-3">Eerste maand</p>
          <div class="space-y-2">
            <p class="text-sm"><strong class="text-accent">120</strong> aanmeldingen in 2 weken</p>
            <p class="text-sm"><strong class="text-accent">±10%</strong> conversie naar trajecten</p>
          </div>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <h3 class="font-heading text-lg text-text mb-1">Kim Bongers</h3>
          <p class="text-xs text-text-muted mb-3">2 maanden</p>
          <div class="space-y-2">
            <p class="text-sm"><strong class="text-accent">90</strong> masterclass-aanmeldingen</p>
            <p class="text-sm"><strong class="text-accent">350×</strong> gids verkocht</p>
            <p class="text-sm"><strong class="text-accent">8%</strong> conversie</p>
          </div>
        </div>
      </div>
      <div class="text-center mt-8">
        <a href="/cases/" class="inline-flex items-center text-accent hover:text-accent-dark transition-colors font-medium">
          Bekijk alle cases
          <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
        </a>
      </div>
    </div>
  </section>

  {/* ── Testimonials ── */}
  <div>
    <div class="max-w-4xl mx-auto px-4 md:px-6 pt-16 md:pt-20">
      <h2 class="font-heading text-2xl md:text-3xl text-text text-center">Wat klanten zeggen</h2>
    </div>
    <TestimonialSlider testimonials={testimonials} locale="nl" />
  </div>

  {/* ── Client logos ── */}
  {logos.length > 0 && (
    <section class="py-10 md:py-12 bg-bg-alt">
      <div class="max-w-5xl mx-auto px-4 md:px-6">
        <p class="text-sm text-text-muted text-center mb-8">Vertrouwd door coaches, experts en bedrijven</p>
        <div class="flex flex-wrap items-center justify-center gap-8 md:gap-12 opacity-70">
          {logos.map((logo) => (
            <Image
              src={logo.src}
              alt={logo.alt}
              width={120}
              height={48}
              class="h-8 md:h-10 w-auto object-contain grayscale hover:grayscale-0 transition-all"
              loading="lazy"
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {/* ── Blog / Guides preview ── */}
  {guides.length > 0 && (
    <section class="py-16 md:py-20">
      <div class="max-w-4xl mx-auto px-4 md:px-6">
        <h2 class="font-heading text-2xl md:text-3xl text-text mb-10 text-center">Laatste artikelen</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {guides.map((g) => (
            <a href={`/guides/${g.data.pageSlug}/`} class="group block bg-white border border-border rounded-card p-6 hover:border-accent/30 hover:shadow-lg transition-all">
              {g.data.cluster && (
                <span class="text-xs font-medium text-accent uppercase tracking-wider mb-2 block">{g.data.cluster}</span>
              )}
              <h3 class="font-heading text-lg text-text group-hover:text-accent transition-colors mb-2">{g.data.title}</h3>
              <p class="text-sm text-text-muted">{g.data.contentSchema.primaryAnswer.slice(0, 120)}...</p>
            </a>
          ))}
        </div>
        <div class="text-center mt-8">
          <a href="/guides/" class="inline-flex items-center text-accent hover:text-accent-dark transition-colors font-medium">
            Bekijk alle artikelen
            <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </div>
    </section>
  )}

  {/* ── Instagram / Social Grid ── */}
  <div class="bg-bg-alt">
    <div class="max-w-5xl mx-auto px-4 md:px-6 pt-16 md:pt-20">
      <h2 class="font-heading text-2xl md:text-3xl text-text text-center mb-2">Volg de journey</h2>
      <p class="text-text-muted text-center">Behind-the-scenes, resultaten en groeisysteem-tips op Instagram.</p>
    </div>
    <SocialStorytellingGrid posts={socialPosts} instagramUrl={siteConfig.socials.instagram} locale="nl" />
  </div>

  {/* ── Founder Preview (EEAT) ── */}
  <FounderPreview
    name={siteConfig.founder.name}
    role={siteConfig.founder.role}
    bio={siteConfig.founder.bio}
    image={founderPhoto}
    credentials={siteConfig.founder.credentials.map((c) => ({ name: c.name, issuer: c.issuer }))}
    knowsAbout={siteConfig.founder.knowsAbout}
    aboutHref="/over-joost/"
    aboutLabel="Meer over Joost"
    locale="nl"
  />

  {/* ── Homepage FAQ ── */}
  <div class="bg-bg-alt">
    <FAQAccordion
      title="Veelgestelde vragen"
      items={homepageFaq}
      locale="nl"
      pageType="homepage"
      pageSlug="/"
    />
  </div>

</BaseLayout>
