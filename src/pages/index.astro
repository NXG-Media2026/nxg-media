---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../data/site';
import { generateOrganization, generateWebSite, generateFounderPerson } from '../data/schema';
import { buildHreflangTrilingual } from '../i18n/hreflang';
import founderPhoto from '../assets/images/founder/joost-standing-relaxed.webp';

const locale = 'nl';
const hreflang = buildHreflangTrilingual('/', '/en/', '/es/');

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logos/*.webp', { eager: true });
const logos = Object.entries(logoFiles).map(([path, mod]) => {
  const filename = path.split('/').pop()!.replace('.webp', '');
  const name = filename.replace('-logo', '').replace(/-/g, ' ');
  return { src: mod.default, alt: name };
});
---

<BaseLayout
  title={`${siteConfig.name} — ${siteConfig.tagline.nl}`}
  description="Bouw een online groeisysteem rond jouw expertise. Expert Growth voor coaches en experts. AI-vindbaarheid voor lokale praktijken."
  hreflang={hreflang}
  schemas={[generateOrganization(), generateWebSite(locale), generateFounderPerson()]}
  locale={locale}
>
  {/* Hero */}
  <section class="py-16 md:py-24 lg:py-32">
    <div class="max-w-4xl mx-auto px-4 md:px-6 text-center">
      <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl text-text mb-6 leading-tight">
        Bouw een online groeisysteem rond jouw expertise
      </h1>
      <p class="text-lg md:text-xl text-text-muted leading-relaxed mb-10 max-w-2xl mx-auto">
        Voor coaches en experts die hun kennis willen vertalen naar voorspelbare leads, productverkoop en coaching-aanvragen. En voor lokale praktijken die zichtbaar willen zijn in AI-tools.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="https://scanner.nxg-media.com"
          class="inline-flex items-center px-8 py-4 text-base font-medium text-text-inverse bg-primary hover:bg-primary-dark transition-colors rounded-button shadow-lg"
          target="_blank"
          rel="noopener noreferrer"
        >
          Doe de AI-vindbaarheidsscan
          <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 003 8.25v10.5A2.25 2.25 0 005.25 21h10.5A2.25 2.25 0 0018 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
          </svg>
        </a>
        <a
          href="/expert-growth-accelerator/"
          class="inline-flex items-center px-8 py-4 text-base font-medium text-primary border-2 border-primary hover:bg-primary/5 transition-colors rounded-button"
        >
          Bekijk Expert Growth
        </a>
      </div>
    </div>
  </section>

  {/* Recognition */}
  <section class="py-12 md:py-16 bg-bg-alt">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-8">Herken je dit?</h2>
      <div class="space-y-6">
        <p class="text-text-muted leading-relaxed">Je hebt al een goedlopend coachprogramma, maar je leadflow piekt en zakt. De ene maand drie nieuwe klanten, de andere maand nul — en je weet niet waarom.</p>
        <p class="text-text-muted leading-relaxed">Of je praktijk draait goed, maar als iemand aan ChatGPT vraagt naar een specialist in jouw regio, word je niet genoemd.</p>
      </div>
    </div>
  </section>

  {/* Principle */}
  <section class="py-12 md:py-16">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-6">Wat NXG Media bouwt</h2>
      <p class="text-lg text-text-muted leading-relaxed mb-8">
        NXG Media bouwt online groeisystemen rond expertise. Geen losse websites of ads-campagnes, maar geïntegreerde systemen waar storytelling, producten, emailflows en advertenties samenwerken.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div class="bg-white rounded-card p-6 border border-border">
          <h3 class="font-heading text-lg text-text mb-2">Storytelling & Content</h3>
          <p class="text-sm text-text-muted">Verhalen die resoneren met je ideale klant — geen generieke taglines.</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <h3 class="font-heading text-lg text-text mb-2">Productladder</h3>
          <p class="text-sm text-text-muted">Van gratis naar betaald — elk product kwalificeert leads voor het volgende.</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <h3 class="font-heading text-lg text-text mb-2">Email & Automatisering</h3>
          <p class="text-sm text-text-muted">Geautomatiseerde flows die leads onboarden en kopers opvolgen.</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <h3 class="font-heading text-lg text-text mb-2">Ads & Meetbaarheid</h3>
          <p class="text-sm text-text-muted">Meta Ads die het systeem voeden, met tracking die laat zien wat converteert.</p>
        </div>
      </div>
    </div>
  </section>

  {/* Proof Wall */}
  <section class="py-12 md:py-16 lg:py-20 bg-bg-alt">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-10 text-center">Resultaten van klanten</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-white rounded-card p-6 border border-border">
          <h3 class="font-heading text-lg text-text mb-1">Happy With Yoga</h3>
          <p class="text-xs text-text-muted mb-3">Sinds 2022</p>
          <div class="space-y-2">
            <p class="text-sm"><strong class="text-accent">30.000+</strong> webinarleads</p>
            <p class="text-sm"><strong class="text-accent">1.700+</strong> mini-cursusverkopen</p>
            <p class="text-sm"><strong class="text-accent">2.000</strong> betalende platformleden</p>
          </div>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <h3 class="font-heading text-lg text-text mb-1">Tessa / Youlife</h3>
          <p class="text-xs text-text-muted mb-3">Sinds feb 2025</p>
          <div class="space-y-2">
            <p class="text-sm"><strong class="text-accent">±€10k/mnd</strong> online producten</p>
            <p class="text-sm"><strong class="text-accent">6</strong> producten gelanceerd</p>
            <p class="text-sm"><strong class="text-accent">±10/mnd</strong> coachingklanten</p>
          </div>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <h3 class="font-heading text-lg text-text mb-1">Coach Josine</h3>
          <p class="text-xs text-text-muted mb-3">Sinds okt 2025</p>
          <div class="space-y-2">
            <p class="text-sm"><strong class="text-accent">600×</strong> gids verkocht</p>
            <p class="text-sm"><strong class="text-accent">80</strong> masterclass-aanmeldingen</p>
          </div>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <h3 class="font-heading text-lg text-text mb-1">Manon van Bakel</h3>
          <p class="text-xs text-text-muted mb-3">Eerste maand</p>
          <div class="space-y-2">
            <p class="text-sm"><strong class="text-accent">120</strong> aanmeldingen in 2 weken</p>
            <p class="text-sm"><strong class="text-accent">±10%</strong> conversie naar trajecten</p>
          </div>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <h3 class="font-heading text-lg text-text mb-1">Kim Bongers</h3>
          <p class="text-xs text-text-muted mb-3">2 maanden</p>
          <div class="space-y-2">
            <p class="text-sm"><strong class="text-accent">90</strong> masterclass-aanmeldingen</p>
            <p class="text-sm"><strong class="text-accent">350×</strong> gids verkocht</p>
            <p class="text-sm"><strong class="text-accent">8%</strong> conversie</p>
          </div>
        </div>
      </div>
      <div class="text-center mt-8">
        <a href="/cases/" class="inline-flex items-center text-accent hover:text-accent-dark transition-colors font-medium">
          Bekijk alle cases
          <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  {/* Client logos */}
  <section class="py-10 md:py-12">
    <div class="max-w-5xl mx-auto px-4 md:px-6">
      <p class="text-sm text-text-muted text-center mb-8">Vertrouwd door coaches, experts en bedrijven</p>
      <div class="flex flex-wrap items-center justify-center gap-8 md:gap-12 opacity-70">
        {logos.map((logo) => (
          <Image
            src={logo.src}
            alt={logo.alt}
            width={120}
            height={48}
            class="h-8 md:h-10 w-auto object-contain grayscale hover:grayscale-0 transition-all"
            loading="lazy"
          />
        ))}
      </div>
    </div>
  </section>

  {/* Expert Growth preview */}
  <section class="py-12 md:py-16">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-4">Expert Growth Accelerator</h2>
      <p class="text-text-muted leading-relaxed mb-6">
        Een vast traject voor coaches en experts die hun expertise willen vertalen naar een online instaproute — met storytelling, masterclasses, mini-producten, emailflows en advertenties die samen leiden naar kopers, klanten of leden.
      </p>
      <a href="/expert-growth-accelerator/" class="inline-flex items-center text-accent hover:text-accent-dark transition-colors font-medium">
        Meer over Expert Growth
        <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </section>

  {/* AI Vindbaarheid secondary route */}
  <section class="py-12 md:py-16 bg-bg-alt">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-4">AI Vindbaarheid</h2>
      <p class="text-text-muted leading-relaxed mb-6">
        AI-vindbaarheid is nog een nieuw speelveld. Daarom beginnen we niet met grote beloftes, maar met een praktische scan: waar sta je nu, wat ontbreekt er en welke verbeteringen zijn logisch?
      </p>
      <a href="/ai-vindbaarheid/" class="inline-flex items-center text-accent hover:text-accent-dark transition-colors font-medium">
        Meer over AI Vindbaarheid
        <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </section>

  {/* About Joost */}
  <section class="py-12 md:py-16">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <div class="flex flex-col md:flex-row gap-8 items-start">
        <Image
          src={founderPhoto}
          alt="Joost van Putten — founder NXG Media, bouwt online groeisystemen voor coaches en experts"
          widths={[200, 300]}
          sizes="(max-width: 768px) 160px, 200px"
          class="rounded-card shadow-lg w-40 md:w-52 shrink-0"
          loading="lazy"
        />
        <div>
          <h2 class="font-heading text-2xl md:text-3xl text-text mb-6">Over Joost</h2>
          <p class="text-text-muted leading-relaxed mb-4">
            {siteConfig.founder.bio}
          </p>
          <a href="/over-joost/" class="inline-flex items-center text-accent hover:text-accent-dark transition-colors font-medium">
            Meer over Joost
            <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* Newsletter */}
  <section class="py-12 md:py-16 bg-primary text-text-inverse">
    <div class="max-w-xl mx-auto px-4 md:px-6 text-center">
      <h2 class="font-heading text-2xl md:text-3xl mb-4">Nieuwsbrief</h2>
      <p class="text-text-inverse/80 mb-6">Praktische inzichten over online groei, AI-vindbaarheid en expertpositionering — direct in je inbox.</p>
      <form class="flex flex-col sm:flex-row gap-3">
        <input type="email" placeholder="Je e-mailadres" class="flex-1 px-4 py-3 rounded-button text-text bg-white" />
        <button type="submit" class="px-6 py-3 bg-accent hover:bg-accent-dark text-white font-medium rounded-button transition-colors">
          Aanmelden
        </button>
      </form>
    </div>
  </section>
</BaseLayout>
