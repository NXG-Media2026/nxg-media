---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import CTABand from '../../components/CTABand.astro';
import { siteConfig } from '../../data/site';
import { generateCollectionPage, generateBreadcrumbs } from '../../data/schema';
import { t } from '../../i18n/utils';
import { buildHreflangPair } from '../../i18n/hreflang';

const articles = (await getCollection('artikel'))
  .filter((a) => !a.data.locale || a.data.locale === 'de')
  .sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime());

const fmtDate = (d: Date) =>
  d.toLocaleDateString('de-DE', { year: 'numeric', month: 'long', day: 'numeric' });

const breadcrumbs = [
  { label: t('breadcrumb.home'), href: '/' },
  { label: t('breadcrumb.blog') },
];

const breadcrumbSchema = breadcrumbs.map((b) => ({
  name: b.label,
  url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}/blog`,
}));
---

<BaseLayout
  title={`Blog — Hormone, Training & Zyklus | ${siteConfig.name}`}
  description="Wissenschaftlich fundierte Artikel zu Frauen-Gesundheit, Hormonen, Ernährung und Training — von Dr. Verena."
  schemas={[
    generateCollectionPage({
      name: 'Blog',
      url: `${siteConfig.url}/blog`,
      description: 'Wissenschaftlich fundierte Artikel zu Frauen-Gesundheit, Hormonen, Ernährung und Training.',
    }),
    generateBreadcrumbs(breadcrumbSchema),
  ]}
  hreflang={buildHreflangPair('/blog', '/en/blog')}
  locale="de"
>
  <BreadcrumbNav items={breadcrumbs} />

  <section class="py-16 md:py-24 lg:py-32 bg-bg">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <div class="text-center mb-14 md:mb-20">
        <h1 class="font-heading text-4xl md:text-5xl text-text mb-4">
          Blog
        </h1>
        <p class="text-lg text-text-muted max-w-2xl mx-auto">
          Fundiertes Wissen rund um Frauen-Gesundheit — kein Trend-Rauschen, sondern Evidenz.
        </p>
      </div>

      {articles.length > 0 ? (
        <div class="space-y-8">
          {articles.map((article, idx) => (
            <a
              href={`/blog/${article.data.pageSlug}`}
              class:list={[
                'group block bg-white border border-border rounded-card overflow-hidden',
                'hover:border-accent/30 hover:shadow-xl transition-all duration-300',
                'js-reveal',
              ]}
              style={`--reveal-delay: ${idx * 100}ms`}
            >
              <div class="flex flex-col md:flex-row">
                {article.data.heroImage && (
                  <div class="md:w-1/3 aspect-[16/10] md:aspect-auto overflow-hidden">
                    <img
                      src={typeof article.data.heroImage === 'string' ? article.data.heroImage : article.data.heroImage.src}
                      alt={article.data.title}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                )}
                <div class:list={['p-6 md:p-8', article.data.heroImage ? 'md:w-2/3' : 'w-full']}>
                  <div class="flex flex-wrap items-center gap-3 mb-3">
                    <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/10 text-accent rounded-full">
                      {article.data.pillarSlug.replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase())}
                    </span>
                    <span class="text-xs text-text-muted">{article.data.readingTime} {t('blog.readingTime')}</span>
                  </div>
                  <h2 class="font-heading text-xl md:text-2xl text-text mb-2 group-hover:text-accent transition-colors">
                    {article.data.title}
                  </h2>
                  <p class="text-sm text-text-muted leading-relaxed mb-4">
                    {article.data.excerpt}
                  </p>
                  <div class="flex items-center justify-between">
                    <time datetime={article.data.publishedDate.toISOString().split('T')[0]} class="text-xs text-text-muted">
                      {fmtDate(article.data.publishedDate)}
                    </time>
                    <span class="inline-flex items-center text-sm font-medium text-accent-dark group-hover:underline underline-offset-2">
                      {t('general.readMore')}
                      <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                      </svg>
                    </span>
                  </div>
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <p class="text-text-muted">Artikel werden in Kürze veröffentlicht.</p>
        </div>
      )}
    </div>
  </section>

  <CTABand
    title="Dieses Wissen in die Praxis umsetzen?"
    subtitle="Entdecke meine Produkte und Coaching-Angebote — wissenschaftlich fundiert und auf dich zugeschnitten."
    ctaText="Angebot entdecken"
    ctaHref="/angebot"
    eventName="product_cta_click"
    locale="de"
    pageType="article"
    pageSlug="/blog"
  />
</BaseLayout>
