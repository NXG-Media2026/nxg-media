---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import CalendlyEmbed from '../components/CalendlyEmbed.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import { siteConfig } from '../data/site';
import { generateBreadcrumbs, generateFAQPage } from '../data/schema';

import heroPhoto from '../assets/images/founder/joost-standing-workinglaptop.webp';
import founderPhoto from '../assets/images/founder/joost-standing-relaxed.webp';

import hwyLogo from '../assets/images/logos/happywithyoga-logo.webp';
import hwyPhoto from '../assets/images/logos/rolf-profile-photo-happywithyoga.png';
import youlifeLogo from '../assets/images/logos/youlife-logo.avif';
import youlifePhoto from '../assets/images/logos/tessa-youlife-profile-photo.png';
import josineLogo from '../assets/images/logos/coachjosine-logo.avif';
import josinePhoto from '../assets/images/logos/coachjosine-profile-photo.png';

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logos/*.{webp,avif,png,jpg}', { eager: true });
const logos = Object.entries(logoFiles)
  .filter(([path]) => /logo/i.test(path.split('/').pop()!))
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/, '');
    const name = filename.replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim();
    return { src: mod.default, alt: name };
  });

const locale = 'nl';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Website Care' },
];

const faqItems = [
  {
    question: 'Kan ik opzeggen?',
    answer: 'Website Care is maandelijks opzegbaar met een opzegtermijn van 1 maand. Er is geen langlopend contract. Wil je stoppen, dan begeleiden we de overdracht of afsluiting netjes.',
  },
  {
    question: 'Wat gebeurt er als ik stop?',
    answer: 'Je eigen content, foto\'s en bedrijfsgegevens blijven van jou. De beheerde websitebasis, templates, code en infrastructuur blijven onderdeel van NXG Media. Wil je volledige overdracht of maatwerk, dan bespreken we dat apart.',
  },
  {
    question: 'Kan ik zelf dingen aanpassen op de website?',
    answer: 'Kleine wijzigingen kun je doorgeven via formulier of e-mail. Wij verwerken ze binnen je pakket. Zelf inloggen en aanpassen is niet mogelijk — dat beschermt de snelheid, veiligheid en vindbaarheid van je website.',
  },
  {
    question: 'Waarom krijg ik geen WordPress-login?',
    answer: 'Je website draait als beheerde websitebasis. Wij beheren de technische laag zodat snelheid, veiligheid en vindbaarheid niet stukgaan door losse plugins, pagebuilders of ongecontroleerde wijzigingen. Dat is het verschil met een traditionele WordPress-site.',
  },
  {
    question: 'Zit AI-vindbaarheid standaard inbegrepen?',
    answer: 'De technische AI/SEO-basis die we in het 90-dagen traject opzetten, blijft behouden in elk Website Care-pakket. Actieve AI-vindbaarheidsmonitoring, rapportage en optimalisaties zitten in AI Visibility Care (vanaf €149 p/m) of hoger.',
  },
  {
    question: 'Wat als ik veel wijzigingen wil?',
    answer: 'Elk pakket bevat een bepaald aantal wijzigingen. Extra wijzigingen worden als add-on geprijsd. Heb je structureel meer nodig, dan is een hoger pakket of een maatwerkafspraak logischer.',
  },
  {
    question: 'Is hosting inbegrepen?',
    answer: 'Hosting zit bij elk Website Care-pakket inbegrepen. Je betaalt geen aparte hostingfactuur.',
  },
  {
    question: 'Kan ik later upgraden naar een hoger pakket?',
    answer: 'Upgraden kan op elk moment. We passen het pakket aan vanaf de volgende maand. Downgraden kan ook, met dezelfde opzegtermijn van 1 maand.',
  },
];

const faqForSchema = faqItems.map((item) => ({
  question: item.question,
  answer: item.answer,
}));

const faqForComponent = faqItems.map((item) => ({ q: item.question, a: item.answer }));

const packages = [
  {
    name: 'Website Care Basic',
    price: '€59',
    period: 'p/m',
    audience: 'Voor klanten die vooral willen dat hun website live en technisch goed beheerd blijft.',
    highlight: false,
    includes: [
      'Hosting',
      'Technisch beheer',
      'Basis monitoring',
      'Kleine technische fixes',
      '1 kleine wijziging per kwartaal',
      'Support via formulier/e-mail',
    ],
    excludes: [
      'Rapportage',
      'Strategie',
      'Nieuwe pagina\'s',
      'Contentcreatie',
    ],
  },
  {
    name: 'Website Care Plus',
    price: '€99',
    period: 'p/m',
    audience: 'Voor klanten die af en toe wijzigingen willen en hun fundament periodiek willen laten checken.',
    highlight: false,
    includes: [
      'Alles uit Basic',
      '1 kleine wijziging per maand',
      'Kwartaalcheck',
      'Simpele AI-vindbaarheidscheck per kwartaal',
      'Korte verbeterpunten-update',
      'Kleine FAQ/content-update per kwartaal',
    ],
    excludes: [
      'Uitgebreide rapportage',
      'Nieuwe pagina\'s',
      'GEO/SEO-content',
      'Linkbuilding',
    ],
  },
  {
    name: 'AI Visibility Care',
    price: '€149',
    period: 'p/m',
    audience: 'Voor klanten die hun AI-vindbaarheid actief willen blijven monitoren.',
    highlight: true,
    includes: [
      'Alles uit Plus',
      'Periodieke AI-vindbaarheid vs concurrenten check',
      'Korte rapportage',
      'Lichte optimalisaties aan bestaande pagina\'s',
      'Review/proof check',
      'Advies voor nieuwe pagina\'s of content',
    ],
    excludes: [
      'GEO/SEO-artikelen',
      'Linkbuilding',
      'Ads/tracking',
      'Grote herschrijvingen',
    ],
  },
  {
    name: 'Growth Care',
    price: 'Vanaf €249',
    period: 'p/m',
    audience: 'Voor bedrijven die actief willen doorgroeien met content, pagina\'s en zichtbaarheid.',
    highlight: false,
    includes: [
      'Alles uit AI Visibility Care',
      'GEO/SEO-content',
      'Extra dienst- of locatiepagina\'s',
      'Reviewprogramma',
      'Interne linking updates',
      'Conversieverbeteringen',
      'Uitgebreidere rapportage',
    ],
    excludes: [
      'Meta Ads / Google Ads beheer',
      'Geavanceerde tracking',
      'Meerdere talen',
      'Volledige redesign',
    ],
  },
];

const smallUpdateYes = [
  'Telefoonnummer aanpassen',
  'Openingstijden wijzigen',
  'Foto vervangen',
  'Korte tekst aanpassen',
  'Review toevoegen',
  'Kleine FAQ aanpassen',
  'Link aanpassen',
];

const smallUpdateNo = [
  'Nieuwe pagina',
  'Nieuwe dienstpagina schrijven',
  'Layout/design aanpassen',
  'Nieuwe taal toevoegen',
  'Blogartikel schrijven',
  'Nieuwe module bouwen',
  'Tracking/ads debugging',
  'Grote herschrijving',
];

const addOns = [
  'Extra pagina',
  'Dienstpagina met copy',
  'Locatiepagina',
  'GEO/SEO-artikel',
  'Extra taal',
  'AI-vindbaarheidsrapport',
  'Reviewprogramma',
  'Linkbuilding/outreach',
  'Analytics/tracking setup',
  'Spoedverzoek',
];
---

<BaseLayout
  title="Website Care — Hosting, beheer en doorontwikkeling voor je AI-ready website | NXG Media"
  description="Na het 90-dagen AI-vindbaarheidstraject blijft je website bij ons draaien. Hosting, technisch beheer, kleine updates en AI-vindbaarheidschecks — vanaf €59 per maand."
  schemas={[generateBreadcrumbs(breadcrumbs.map((b) => ({ name: b.label, url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}/website-care/` }))), generateFAQPage(faqForSchema)]}
  locale={locale}
>
  <BreadcrumbNav items={breadcrumbs} />

  {/* ── Hero ── */}
  <section class="relative py-20 md:py-28 lg:py-36 overflow-hidden">
    <div class="absolute inset-0">
      <Image
        src={heroPhoto}
        alt="Joost van Putten — Website Care specialist, beheert AI-ready websites voor MKB-bedrijven"
        widths={[800, 1200, 1600]}
        sizes="100vw"
        class="w-full h-full object-cover"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-white/95 via-white/85 to-white/40"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 md:px-6">
      <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-primary/10 text-primary rounded-full mb-6">
        Na het 90-dagen traject
      </span>
      <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl text-text mb-6 leading-tight max-w-2xl">
        Houd je AI-ready website live, snel en actueel
      </h1>
      <p class="text-lg md:text-xl text-text-muted leading-relaxed mb-10 max-w-xl">
        Na het 90-dagen traject kun je je website via NXG Media laten beheren. Wij zorgen voor hosting, technisch beheer, kleine updates en — als je wilt — periodieke AI-vindbaarheidschecks.
      </p>
      <a
        href="#gesprek"
        class="inline-flex items-center px-8 py-4 text-base font-medium text-text-inverse bg-primary hover:bg-primary-dark transition-colors rounded-button shadow-lg"
      >
        Bespreek Website Care
        <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
      <p class="text-xs text-text-muted mt-6">
        Gebouwd op 7+ jaar ervaring met websites, funnels, advertenties en online groeisystemen.
      </p>
    </div>
  </section>

  {/* ── Why Website Care ── */}
  <section class="py-16 md:py-20 bg-primary">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-white mb-4">Geen hostinggedoe, plugins of losse developers</h2>
      <p class="text-white/80 leading-relaxed mb-8 text-lg">
        Je nieuwe website draait als beheerde websitebasis. Je hoeft dus geen Wix, WordPress, Elementor, Joomla, losse hosting of plugin-updates meer te regelen. Je houdt gewoon je huidige domeinnaam.
      </p>
      <div class="space-y-4">
        {[
          'Hosting en technisch beheer geregeld',
          'Geen Wix, WordPress, Elementor, Joomla of pluginchaos nodig',
          'Je huidige domeinnaam blijft gewoon van jou',
          'Kleine wijzigingen vraag je makkelijk aan via formulier of e-mail',
          'Je website blijft snel, technisch schoon en goed beheerd',
          'Uitbreiden kan wanneer nodig',
          'AI/SEO-basis blijft bewaakt, afhankelijk van je pakket',
        ].map((item) => (
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <p class="text-white/85 leading-relaxed">{item}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ── Logo strip ── */}
  {logos.length > 0 && (
    <LogoMarquee
      logos={logos}
      label="Vertrouwd door coaches, experts en bedrijven"
      speed={35}
    />
  )}

  {/* ── Packages ── */}
  <section class="py-16 md:py-24">
    <div class="max-w-5xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-4 text-center">Kies het pakket dat bij je past</h2>
      <p class="text-lg text-text-muted leading-relaxed mb-12 text-center max-w-2xl mx-auto">
        Elk pakket bevat hosting en technisch beheer. Hoe hoger het pakket, hoe meer we actief meekijken en meewerken aan je vindbaarheid.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {packages.map((pkg) => (
          <div class={`rounded-card p-6 md:p-8 border-2 ${pkg.highlight ? 'bg-primary border-primary shadow-lg' : 'bg-white border-border'} flex flex-col`}>
            {pkg.highlight && (
              <span class="inline-flex items-center self-start px-3 py-1 text-xs font-medium bg-white/15 text-white rounded-full mb-3">
                Populairste keuze
              </span>
            )}
            <h3 class={`font-heading text-xl mb-2 ${pkg.highlight ? 'text-white' : 'text-text'}`}>{pkg.name}</h3>
            <div class="flex items-baseline gap-1 mb-2">
              <span class={`font-heading text-3xl ${pkg.highlight ? 'text-white' : 'text-primary'}`}>{pkg.price}</span>
              <span class={`text-sm ${pkg.highlight ? 'text-white/70' : 'text-text-muted'}`}>{pkg.period}</span>
            </div>
            <p class={`text-sm leading-relaxed mb-6 ${pkg.highlight ? 'text-white/80' : 'text-text-muted'}`}>{pkg.audience}</p>

            {/* Includes */}
            <div class="mb-4">
              <p class={`text-xs font-medium uppercase tracking-wider mb-2 ${pkg.highlight ? 'text-white/60' : 'text-text'}`}>Inbegrepen</p>
              <ul class="space-y-1.5">
                {pkg.includes.map((item) => (
                  <li class={`flex items-start gap-2 text-sm ${pkg.highlight ? 'text-white/85' : 'text-text-muted'}`}>
                    <svg class={`w-4 h-4 shrink-0 mt-0.5 ${pkg.highlight ? 'text-accent' : 'text-accent'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            {/* Excludes */}
            <div class={`mt-auto pt-4 border-t ${pkg.highlight ? 'border-white/20' : 'border-border'}`}>
              <p class={`text-xs font-medium uppercase tracking-wider mb-2 ${pkg.highlight ? 'text-white/50' : 'text-text-muted'}`}>Niet inbegrepen</p>
              <ul class="space-y-1">
                {pkg.excludes.map((item) => (
                  <li class={`flex items-start gap-2 text-xs ${pkg.highlight ? 'text-white/50' : 'text-text-muted/70'}`}>
                    <span class="shrink-0 mt-0.5">&mdash;</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>

      <p class="text-sm text-text-muted text-center mt-8">
        Alle pakketten zijn maandelijks opzegbaar met 1 maand opzegtermijn. Upgraden of downgraden kan op elk moment.
      </p>
    </div>
  </section>

  {/* ── What is a small update ── */}
  <section class="py-16 md:py-20 bg-bg-alt">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-10">Wat is een kleine wijziging?</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {/* Yes */}
        <div>
          <h3 class="font-heading text-lg text-text mb-4 flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-green-100 flex items-center justify-center shrink-0">
              <svg class="w-3.5 h-3.5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
            </span>
            Kleine wijziging
          </h3>
          <ul class="space-y-2 text-sm text-text-muted">
            {smallUpdateYes.map((item) => (
              <li class="flex items-start gap-2">
                <span class="text-green-500 mt-0.5">&check;</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
        {/* No */}
        <div>
          <h3 class="font-heading text-lg text-text mb-4 flex items-center gap-2">
            <span class="w-6 h-6 rounded-full bg-red-100 flex items-center justify-center shrink-0">
              <svg class="w-3.5 h-3.5 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </span>
            Geen kleine wijziging
          </h3>
          <ul class="space-y-2 text-sm text-text-muted">
            {smallUpdateNo.map((item) => (
              <li class="flex items-start gap-2">
                <span class="text-red-400 mt-0.5">&times;</span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <p class="text-sm text-text-muted mt-8">
        Grotere wijzigingen en nieuwe pagina's worden als add-on geprijsd of vallen onder een hoger pakket.
      </p>
    </div>
  </section>

  {/* ── Proof cards ── */}
  <section class="py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-4">Websites, funnels en systemen die resultaat dragen</h2>
      <p class="text-lg text-text-muted leading-relaxed mb-10 max-w-3xl">
        Website Care staat niet los van je online groei. De afgelopen jaren bouwden we websites, funnels en groeisystemen voor ondernemers die hun online fundament serieuzer wilden neerzetten.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full overflow-hidden shrink-0 ring-2 ring-white shadow-sm">
              <Image src={hwyPhoto} alt="Rolf — Happy With Yoga" widths={[80]} sizes="40px" class="w-full h-full object-cover" loading="lazy" decoding="async" />
            </div>
            <div>
              <p class="text-sm font-medium text-text">Rolf</p>
              <Image src={hwyLogo} alt="Happy With Yoga logo" widths={[96]} sizes="80px" class="h-4 w-auto mt-0.5" loading="lazy" decoding="async" />
            </div>
          </div>
          <div class="flex items-baseline gap-2 mb-3">
            <span class="font-heading text-2xl text-primary">30.000+</span>
            <span class="text-sm text-text-muted">webinarleads</span>
          </div>
          <p class="text-xs text-text-muted mb-4">2.000 betalende leden</p>
          <p class="text-sm text-text-muted leading-relaxed">Sterke content-, funnel- en platformstructuur rond een bestaand expertmerk.</p>
          <a href="/cases/happy-with-yoga/" class="inline-flex items-center text-sm text-accent hover:text-accent-dark transition-colors font-medium mt-4">
            Lees de case
            <svg class="w-3.5 h-3.5 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full overflow-hidden shrink-0 ring-2 ring-white shadow-sm">
              <Image src={youlifePhoto} alt="Tessa — Youlife" widths={[80]} sizes="40px" class="w-full h-full object-cover" loading="lazy" decoding="async" />
            </div>
            <div>
              <p class="text-sm font-medium text-text">Tessa</p>
              <Image src={youlifeLogo} alt="Youlife logo" widths={[96]} sizes="80px" class="h-4 w-auto mt-0.5" loading="lazy" decoding="async" />
            </div>
          </div>
          <div class="flex items-baseline gap-2 mb-3">
            <span class="font-heading text-2xl text-primary">&plusmn;&euro;10k/mnd</span>
            <span class="text-sm text-text-muted">productomzet</span>
          </div>
          <p class="text-xs text-text-muted mb-4">7.2&times; ROAS op advertenties</p>
          <p class="text-sm text-text-muted leading-relaxed">Productpagina's, advertenties en opvolging als &eacute;&eacute;n systeem.</p>
          <a href="/cases/tessa-youlife/" class="inline-flex items-center text-sm text-accent hover:text-accent-dark transition-colors font-medium mt-4">
            Lees de case
            <svg class="w-3.5 h-3.5 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 rounded-full overflow-hidden shrink-0 ring-2 ring-white shadow-sm">
              <Image src={josinePhoto} alt="Josine — Coach Josine" widths={[80]} sizes="40px" class="w-full h-full object-cover" loading="lazy" decoding="async" />
            </div>
            <div>
              <p class="text-sm font-medium text-text">Josine</p>
              <Image src={josineLogo} alt="Coach Josine logo" widths={[96]} sizes="80px" class="h-4 w-auto mt-0.5" loading="lazy" decoding="async" />
            </div>
          </div>
          <div class="flex items-baseline gap-2 mb-3">
            <span class="font-heading text-2xl text-primary">600&times;</span>
            <span class="text-sm text-text-muted">gids verkocht</span>
          </div>
          <p class="text-xs text-text-muted mb-4">80 masterclass-aanmeldingen</p>
          <p class="text-sm text-text-muted leading-relaxed">Van expertise naar een verkoopbare digitale route.</p>
          <a href="/cases/coach-josine/" class="inline-flex items-center text-sm text-accent hover:text-accent-dark transition-colors font-medium mt-4">
            Lees de case
            <svg class="w-3.5 h-3.5 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ── Add-ons ── */}
  <section class="py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-4">Meer nodig? Dan boek je het los bij.</h2>
      <p class="text-text-muted leading-relaxed mb-8">
        Alles wat buiten je pakket valt, kun je als losse add-on bijboeken. Geen verrassingen — we bespreken de kosten vooraf.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        {addOns.map((item) => (
          <div class="flex items-center gap-3 bg-white rounded-card px-4 py-3 border border-border">
            <svg class="w-4 h-4 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
            <span class="text-sm text-text-muted">{item}</span>
          </div>
        ))}
      </div>
