---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import TrustBar from '../components/TrustBar.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import ScannerChooser from '../components/ScannerChooser.astro';
import { siteConfig } from '../data/site';
import { generateBreadcrumbs, generateFAQPage } from '../data/schema';
import { getCluster, getClusterFaqLocalized } from '../lib/clusters';
import { getTestimonials } from '../data/testimonials';

import heroPhoto from '../assets/images/founder/joost-sitting-laptop-lookingfront.webp';
import founderPhoto from '../assets/images/founder/joost-standing-relaxed.webp';

const locale = 'nl';
const cluster = getCluster('ai-vindbaarheid')!;
const faqItems = getClusterFaqLocalized(cluster, locale);
const faqForComponent = faqItems.map((item) => ({ q: item.question, a: item.answer }));

const testimonials = getTestimonials({ locale: 'nl' });
const claireTestimonial = testimonials.find((t) => t.id === 'claire-ikrouwvanje');

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logos/*.{webp,avif,png,jpg}', { eager: true });
const logos = Object.entries(logoFiles)
  .filter(([path]) => /logo/i.test(path.split('/').pop()!))
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/, '');
    const name = filename.replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim();
    return { src: mod.default, alt: name };
  });

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'AI Vindbaarheid' },
];

const trustItems = [
  { value: '+60%', label: 'groei AI-zoekverkeer per jaar' },
  { value: '40%', label: 'van Gen Z zoekt via AI, niet Google' },
  { value: '4 van 5', label: 'AI-tools citeren dezelfde 3 bronnen' },
  { value: '0%', label: 'van MKB optimaliseert hiervoor' },
];
---

<BaseLayout
  title="AI Vindbaarheid — Word gevonden door ChatGPT, Gemini & Perplexity | NXG Media"
  description="AI-zoekverkeer groeit met 60% per jaar. Wordt jouw bedrijf al aanbevolen door ChatGPT, Gemini en Perplexity? Doe de gratis scan en ontdek waar je staat."
  schemas={[generateBreadcrumbs(breadcrumbs.map((b) => ({ name: b.label, url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}/ai-vindbaarheid/` }))), generateFAQPage(faqItems)]}
  locale={locale}
>
  <BreadcrumbNav items={breadcrumbs} />

  {/* ── Hero ── */}
  <section class="relative py-20 md:py-28 lg:py-36 overflow-hidden">
    <div class="absolute inset-0">
      <Image
        src={heroPhoto}
        alt="Joost van Putten — AI-vindbaarheid specialist, helpt lokale praktijken zichtbaar worden in ChatGPT en Gemini"
        widths={[800, 1200, 1600]}
        sizes="100vw"
        class="w-full h-full object-cover"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-white/95 via-white/85 to-white/40"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 md:px-6">
      <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-primary/10 text-primary rounded-full mb-6">
        Early adopter voordeel
      </span>
      <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl text-text mb-6 leading-tight max-w-2xl">
        Word aanbevolen door ChatGPT, Gemini & Perplexity
      </h1>
      <p class="text-lg md:text-xl text-text-muted leading-relaxed mb-10 max-w-xl">
        AI-zoekverkeer groeit met 60% per jaar. Steeds meer mensen vragen AI om aanbevelingen in plaats van Google. Wordt jouw bedrijf al genoemd?
      </p>
      <div class="flex flex-col sm:flex-row items-start gap-4">
        <button
          type="button"
          data-scanner-open
          class="inline-flex items-center px-8 py-4 text-base font-medium text-text-inverse bg-primary hover:bg-primary-dark transition-colors rounded-button shadow-lg cursor-pointer"
        >
          Doe de gratis AI-scan
          <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </button>
        <a
          href="/contact/"
          class="inline-flex items-center px-8 py-4 text-base font-medium text-primary border-2 border-primary hover:bg-primary/5 transition-colors rounded-button"
        >
          Plan een kennismaking
        </a>
      </div>
    </div>
  </section>

  {/* ── Trust Bar ── */}
  <section class="bg-bg-alt border-y border-border">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <TrustBar items={trustItems} />
    </div>
  </section>

  {/* ── Recognition / Pain ── */}
  <section class="py-16 md:py-20 bg-primary">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-white mb-8">Herken je dit?</h2>
      <div class="space-y-4">
        <div class="flex items-start gap-3">
          <span class="text-white/60 text-lg mt-0.5">&ldquo;</span>
          <p class="text-white/80 leading-relaxed">We staan op pagina 1 van Google, maar de telefoon gaat steeds minder.</p>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-white/60 text-lg mt-0.5">&ldquo;</span>
          <p class="text-white/80 leading-relaxed">Ik vroeg ChatGPT om een specialist in mijn regio — mijn concurrent werd genoemd, ik niet.</p>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-white/60 text-lg mt-0.5">&ldquo;</span>
          <p class="text-white/80 leading-relaxed">We investeren in SEO, maar AI-tools lijken ons compleet te negeren.</p>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-white/60 text-lg mt-0.5">&ldquo;</span>
          <p class="text-white/80 leading-relaxed">Mijn concurrenten doen er nog niks aan — maar ik wil niet te laat zijn zoals met Google destijds.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── FOMO / Early Adopter ── */}
  <section class="py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <div class="max-w-3xl">
        <h2 class="font-heading text-2xl md:text-3xl text-text mb-6">
          De verschuiving is al begonnen
        </h2>
        <p class="text-lg text-text-muted leading-relaxed mb-6">
          ChatGPT, Gemini, Perplexity, Claude — samen verwerken ze al honderden miljoenen zoekvragen per dag. En dat volume groeit met meer dan 60% per jaar.
        </p>
        <p class="text-lg text-text-muted leading-relaxed mb-6">
          40% van Gen Z gebruikt AI al als primaire zoekmachine. Niet Google. Ze vragen: <em>"Wat is de beste fysio in Utrecht?"</em> of <em>"Welke osteopaat raad je aan in Antwerpen?"</em> — en de AI geeft drie namen. Altijd dezelfde drie.
        </p>
        <p class="text-lg text-text leading-relaxed font-medium mb-10">
          Mogelijk was je te laat om bovenaan Google te komen. Maar met AI-vindbaarheid heb je nu een tweede kans — en de meeste concurrenten slapen nog.
        </p>
      </div>

      {/* Stats grid */}
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
        <div class="bg-white rounded-card p-5 border border-border text-center">
          <div class="font-heading text-2xl md:text-3xl text-primary mb-1">ChatGPT</div>
          <p class="text-xs text-text-muted">400M+ gebruikers per week</p>
        </div>
        <div class="bg-white rounded-card p-5 border border-border text-center">
          <div class="font-heading text-2xl md:text-3xl text-primary mb-1">Gemini</div>
          <p class="text-xs text-text-muted">Geïntegreerd in Google Search</p>
        </div>
        <div class="bg-white rounded-card p-5 border border-border text-center">
          <div class="font-heading text-2xl md:text-3xl text-primary mb-1">Perplexity</div>
          <p class="text-xs text-text-muted">15M+ dagelijkse zoekvragen</p>
        </div>
        <div class="bg-white rounded-card p-5 border border-border text-center">
          <div class="font-heading text-2xl md:text-3xl text-primary mb-1">Claude</div>
          <p class="text-xs text-text-muted">Snelst groeiende AI-assistent</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── Google vs AI Comparison ── */}
  <section class="py-16 md:py-20 bg-bg-alt">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-4 text-center">
        Google zoeken vs. AI zoeken
      </h2>
      <p class="text-text-muted text-center mb-10 max-w-2xl mx-auto">
        Dezelfde vraag, een compleet ander spel. Dit is waarom je SEO-strategie alleen niet meer genoeg is.
      </p>

      <div class="overflow-x-auto">
        <table class="w-full bg-white rounded-card border border-border text-sm md:text-base">
          <thead>
            <tr class="border-b border-border">
              <th class="text-left px-5 py-4 font-medium text-text-muted"></th>
              <th class="text-left px-5 py-4 font-medium text-text-muted">Google (klassiek)</th>
              <th class="text-left px-5 py-4 font-medium text-primary">AI zoeken</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            <tr>
              <td class="px-5 py-4 font-medium text-text">Resultaat</td>
              <td class="px-5 py-4 text-text-muted">10 blauwe links</td>
              <td class="px-5 py-4 text-text">1 direct antwoord met 2-3 aanbevelingen</td>
            </tr>
            <tr>
              <td class="px-5 py-4 font-medium text-text">Ranking-factoren</td>
              <td class="px-5 py-4 text-text-muted">Backlinks, keywords, technische SEO</td>
              <td class="px-5 py-4 text-text">Citeerbaarheid, autoriteit, context, reviews</td>
            </tr>
            <tr>
              <td class="px-5 py-4 font-medium text-text">Positie #4+</td>
              <td class="px-5 py-4 text-text-muted">Minder kliks, maar nog zichtbaar</td>
              <td class="px-5 py-4 text-text">Bestaat niet — je wordt genoemd of niet</td>
            </tr>
            <tr>
              <td class="px-5 py-4 font-medium text-text">Concurrentie</td>
              <td class="px-5 py-4 text-text-muted">Iedereen optimaliseert al 20 jaar</td>
              <td class="px-5 py-4 text-text">Bijna niemand optimaliseert hiervoor</td>
            </tr>
            <tr>
              <td class="px-5 py-4 font-medium text-text">Kosten</td>
              <td class="px-5 py-4 text-text-muted">€1.000+/mnd voor goede SEO</td>
              <td class="px-5 py-4 text-text">Laag — de juiste structuur is genoeg</td>
            </tr>
            <tr>
              <td class="px-5 py-4 font-medium text-text">Tijdlijn</td>
              <td class="px-5 py-4 text-text-muted">6-12 maanden voor resultaat</td>
              <td class="px-5 py-4 text-text">Weken — AI herindexeert continu</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {/* ── Mid-page CTA ── */}
  <section class="py-16 md:py-20 bg-accent">
    <div class="max-w-4xl mx-auto px-4 md:px-6 text-center">
      <h2 class="font-heading text-3xl md:text-4xl text-white mb-4">
        Check of AI-tools jouw bedrijf al aanbevelen
      </h2>
      <p class="text-lg text-white/80 mb-8 max-w-2xl mx-auto">
        Onze gratis scan controleert je zichtbaarheid in ChatGPT, Gemini, Perplexity en Google. In 2 minuten weet je waar je staat.
      </p>
      <button
        type="button"
        data-scanner-open
        class="inline-flex items-center px-8 py-4 text-base font-medium bg-white text-accent hover:bg-bg-alt transition-colors rounded-button cursor-pointer"
      >
        Doe de gratis AI-scan
        <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </button>
    </div>
  </section>

  {/* ── What we do ── */}
  <section class="py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-6">Hoe werkt het?</h2>
      <p class="text-lg text-text-muted leading-relaxed mb-10 max-w-3xl">
        We beginnen niet met beloftes, maar met data. De scan laat zien waar je nu staat — en wat er nodig is om door AI-tools aanbevolen te worden.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center mb-4">
            <span class="text-primary font-heading text-lg">1</span>
          </div>
          <h3 class="font-heading text-lg text-text mb-2">Scan</h3>
          <p class="text-sm text-text-muted leading-relaxed">Je ontvangt een volledig rapport over je zichtbaarheid in Google, ChatGPT, Gemini en Perplexity. Inclusief concrete verbeterpunten.</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center mb-4">
            <span class="text-primary font-heading text-lg">2</span>
          </div>
          <h3 class="font-heading text-lg text-text mb-2">Optimalisatie</h3>
          <p class="text-sm text-text-muted leading-relaxed">Op basis van de scan passen we je website, structured data, citeerbare content en lokale signalen aan — zodat AI-tools jou gaan herkennen.</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center mb-4">
            <span class="text-primary font-heading text-lg">3</span>
          </div>
          <h3 class="font-heading text-lg text-text mb-2">Monitoren</h3>
          <p class="text-sm text-text-muted leading-relaxed">AI-modellen worden continu bijgewerkt. We monitoren je positie en passen aan waar nodig — zodat je zichtbaar blijft.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── Testimonial — Claire ── */}
  {claireTestimonial && (
    <section class="py-16 md:py-20 bg-bg-alt">
      <div class="max-w-3xl mx-auto px-4 md:px-6">
        <div class="bg-white rounded-card p-8 md:p-10 border border-border">
          <div class="flex items-center gap-4 mb-6">
            {claireTestimonial.photo && (
              <div class="w-14 h-14 rounded-full overflow-hidden bg-bg-alt shrink-0">
                <img
                  src={`/images/testimonials/${claireTestimonial.photo}`}
                  alt={claireTestimonial.name}
                  width="56"
                  height="56"
                  class="w-full h-full object-cover"
                  loading="lazy"
                />
              </div>
            )}
            <div>
              <p class="font-medium text-text">{claireTestimonial.name}</p>
              {claireTestimonial.outcome && (
                <p class="text-sm text-text-muted">{claireTestimonial.outcome}</p>
              )}
            </div>
            {claireTestimonial.rating && (
              <div class="ml-auto flex gap-0.5">
                {Array.from({ length: claireTestimonial.rating }).map(() => (
                  <svg class="w-4 h-4 text-accent" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
            )}
          </div>
          <blockquote class="text-text-muted leading-relaxed text-lg italic">
            &ldquo;{claireTestimonial.text}&rdquo;
          </blockquote>
        </div>
      </div>
    </section>
  )}

  {/* ── Founder ── */}
  <section class="py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <div class="grid grid-cols-1 md:grid-cols-[auto_1fr] gap-10 md:gap-14 items-center">
        <div class="flex justify-center md:justify-start">
          <div class="w-48 h-48 md:w-56 md:h-56 rounded-full overflow-hidden shadow-lg ring-4 ring-bg-alt shrink-0">
            <Image
              src={founderPhoto}
              alt="Joost van Putten — Founder NXG Media"
              widths={[224, 320]}
              sizes="(max-width: 768px) 192px, 224px"
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
        <div>
          <div class="w-12 h-1 bg-accent rounded-full mb-4"></div>
          <h2 class="font-heading text-2xl md:text-3xl text-text mb-1">Joost van Putten</h2>
          <p class="text-sm text-text-muted mb-4">Founder & Online Growth Strategist</p>
          <p class="text-text-muted leading-relaxed mb-6">
            7+ jaar ervaring met online groeisystemen. Meer dan €5 miljoen aan advertentiebudget beheerd. Ik help coaches en MKB-bedrijven niet alleen zichtbaar te zijn op Google, maar ook in de AI-tools die Google steeds vaker gaan vervangen.
          </p>
          <a
            href="/over-joost/"
            class="inline-flex items-center text-accent hover:text-accent-dark transition-colors font-medium"
          >
            Meer over Joost
            <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ── Logo Marquee ── */}
  {logos.length > 0 && (
    <LogoMarquee
      logos={logos}
      label="Vertrouwd door coaches, experts en bedrijven"
      speed={35}
    />
  )}

  {/* ── FAQ ── */}
  {faqForComponent.length > 0 && (
    <div class="bg-bg-alt">
      <FAQAccordion
        title="Veelgestelde vragen over AI-vindbaarheid"
        items={faqForComponent}
        locale={locale}
        pageType="cluster_hub"
        pageSlug="ai-vindbaarheid"
      />
    </div>
  )}

  {/* ── Final CTA ── */}
  <section class="py-16 md:py-20 bg-primary">
    <div class="max-w-4xl mx-auto px-4 md:px-6 text-center">
      <h2 class="font-heading text-3xl md:text-4xl text-white mb-4">
        Wacht niet tot je concurrenten het ontdekken
      </h2>
      <p class="text-lg text-white/80 mb-8 max-w-2xl mx-auto">
        De bedrijven die nu investeren in AI-vindbaarheid, worden straks als eerste aanbevolen. Start vandaag met de gratis scan.
      </p>
      <button
        type="button"
        data-scanner-open
        class="inline-flex items-center px-8 py-4 text-base font-medium bg-accent hover:bg-accent-dark text-white transition-all duration-300 rounded-button shadow-lg shadow-accent/25 hover:shadow-xl cursor-pointer"
      >
        Doe de gratis AI-scan
        <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </button>
    </div>
  </section>

  <ScannerChooser locale="nl" />

</BaseLayout>
