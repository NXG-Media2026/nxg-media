---
/**
 * Glossar index page — /glossar
 *
 * Merges two sources:
 * 1. Content collection 'glossar' (YAML data, cluster-aware, with individual pages)
 * 2. Static glossarTerms from data/glossar.ts (legacy, anchor-only)
 *
 * Content collection entries link to /glossar/[slug].
 * Static entries stay as same-page anchors.
 * Duplicates (same slug in both) → collection entry wins.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import CTABand from '../../components/CTABand.astro';
import { siteConfig } from '../../data/site';
import { generateDefinedTermSet, generateBreadcrumbs } from '../../data/schema';
import { glossarTerms } from '../../data/glossar';
import { t } from '../../i18n/utils';
import { buildHreflangPair } from '../../i18n/hreflang';

// 1. Load content collection entries (DE only)
const collectionEntries = (await getCollection('glossar')).filter((e) => !e.data.locale || e.data.locale === 'de');
const collectionSlugs = new Set(collectionEntries.map((e) => e.data.slug));

// 2. Merge: unified shape { term, slug, definition, hasPage, relatedSlugs }
interface MergedTerm {
  term: string;
  slug: string;
  definition: string;
  hasPage: boolean;
  relatedSlugs: string[];
}

const merged: MergedTerm[] = [];

// Add collection entries first (they have individual pages)
for (const entry of collectionEntries) {
  merged.push({
    term: entry.data.term,
    slug: entry.data.slug,
    definition: entry.data.definition,
    hasPage: true,
    relatedSlugs: entry.data.relatedTerms ?? [],
  });
}

// Add static entries that don't overlap with collection
for (const staticTerm of glossarTerms) {
  if (collectionSlugs.has(staticTerm.slug)) continue;
  merged.push({
    term: staticTerm.term,
    slug: staticTerm.slug,
    definition: staticTerm.definition,
    hasPage: false,
    relatedSlugs: staticTerm.relatedTermSlugs ?? [],
  });
}

// Sort alphabetically (German locale)
const sortedTerms = merged.sort((a, b) => a.term.localeCompare(b.term, 'de'));

// Letter navigation
const letters = [...new Set(sortedTerms.map((t) => t.term.charAt(0).toUpperCase()))].sort((a, b) =>
  a.localeCompare(b, 'de'),
);

const breadcrumbs = [
  { label: t('breadcrumb.home'), href: '/' },
  { label: t('breadcrumb.glossar') },
];

const breadcrumbSchema = breadcrumbs.map((b) => ({
  name: b.label,
  url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}/glossar`,
}));
---

<BaseLayout
  title={`Glossar — Fachbegriffe der Frauen-Gesundheit | ${siteConfig.name}`}
  description="Glossar der Frauen-Gesundheit: Fachbegriffe zu Hormonen, Zyklus, Ernährung und Training einfach erklärt."
  schemas={[
    generateDefinedTermSet(sortedTerms.map((t) => ({ ...t, hasPage: t.hasPage }))),
    generateBreadcrumbs(breadcrumbSchema),
  ]}
  hreflang={buildHreflangPair('/glossar', '/en/glossary')}
  locale="de"
>
  <BreadcrumbNav items={breadcrumbs} />

  <section class="py-16 md:py-24 lg:py-32 bg-bg">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <div class="text-center mb-14 md:mb-20">
        <h1 class="font-heading text-4xl md:text-5xl text-text mb-4">
          Glossar
        </h1>
        <p class="text-lg text-text-muted max-w-2xl mx-auto">
          Fachbegriffe der Frauen-Gesundheit — verständlich erklärt und wissenschaftlich fundiert.
        </p>
      </div>

      <nav class="flex flex-wrap justify-center gap-2 mb-12" aria-label="Buchstaben-Navigation">
        {letters.map((letter) => (
          <a
            href={`#letter-${letter}`}
            class="inline-flex items-center justify-center w-10 h-10 text-sm font-medium bg-white border border-border rounded-full hover:border-accent/30 hover:text-accent transition-colors"
          >
            {letter}
          </a>
        ))}
      </nav>

      {letters.map((letter) => {
        const termsForLetter = sortedTerms.filter(
          (t) => t.term.charAt(0).toUpperCase() === letter,
        );
        return (
          <section id={`letter-${letter}`} class="mb-12 last:mb-0 scroll-mt-24">
            <h2 class="font-heading text-2xl text-text mb-6 pb-2 border-b border-border">
              {letter}
            </h2>
            <div class="space-y-6">
              {termsForLetter.map((item) => (
                <div id={item.slug} class="scroll-mt-24">
                  {item.hasPage ? (
                    <a href={`/glossar/${item.slug}`} class="group">
                      <h3 class="font-medium text-text text-lg mb-2 group-hover:text-accent transition-colors">
                        {item.term}
                        <svg class="w-4 h-4 inline-block ml-1 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                        </svg>
                      </h3>
                    </a>
                  ) : (
                    <h3 class="font-medium text-text text-lg mb-2">{item.term}</h3>
                  )}
                  <p class="text-sm text-text-muted leading-relaxed mb-2">
                    {item.definition}
                  </p>
                  {item.relatedSlugs.length > 0 && (
                    <div class="flex flex-wrap gap-2">
                      {item.relatedSlugs.map((relSlug) => {
                        const related = sortedTerms.find((t) => t.slug === relSlug);
                        if (!related) return null;
                        return related.hasPage ? (
                          <a
                            href={`/glossar/${relSlug}`}
                            class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/10 text-accent rounded-full hover:bg-accent/20 transition-colors"
                          >
                            {related.term}
                          </a>
                        ) : (
                          <a
                            href={`#${relSlug}`}
                            class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/10 text-accent rounded-full hover:bg-accent/20 transition-colors"
                          >
                            {related.term}
                          </a>
                        );
                      })}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </section>

  <CTABand
    title="Du möchtest diese Begriffe in der Praxis anwenden?"
    subtitle="Entdecke meine Produkte und Coaching-Angebote — wissenschaftlich fundiert und auf dich zugeschnitten."
    ctaText="Angebot entdecken"
    ctaHref="/angebot"
    eventName="product_cta_click"
    locale="de"
    pageType="glossar"
    pageSlug="/glossar"
  />
</BaseLayout>
