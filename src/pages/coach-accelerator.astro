---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import ClientResults from '../components/ClientResults.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import { siteConfig } from '../data/site';
import { generateBreadcrumbs, generateFAQPage } from '../data/schema';
import { getCluster, getClusterFaqLocalized } from '../lib/clusters';
import { getTestimonials } from '../data/testimonials';
import { buildHreflangTrilingual } from '../i18n/hreflang';

import heroPhoto from '../assets/images/founder/joost-standing-workinglaptop.webp';
import founderPhoto from '../assets/images/founder/joost-standing-relaxed.webp';

import claireWhatsApp from '../assets/images/cases/ikrouwvanje-claire-whatsapp-proof.webp';
import tessaWhatsApp from '../assets/images/cases/tessa-youlife-whatsapp-proof.webp';
import rolfWhatsApp from '../assets/images/cases/rolf-happywithyoga-whatsapp-proof.webp';

const locale = 'nl';
const cluster = getCluster('expert-growth')!;
const faqItems = getClusterFaqLocalized(cluster, locale);
const faqForComponent = faqItems.map((item) => ({ q: item.question, a: item.answer }));
const testimonials = getTestimonials({ locale: 'nl' });
const hreflang = buildHreflangTrilingual('/coach-accelerator/', '/en/coach-accelerator/', '/es/coach-accelerator/');

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logos/*.{webp,avif,png,jpg}', { eager: true });
const logos = Object.entries(logoFiles)
  .filter(([path]) => /logo/i.test(path.split('/').pop()!))
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/, '');
    const name = filename.replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim();
    return { src: mod.default, alt: name };
  });

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Coach Accelerator' },
];
---

<BaseLayout
  title="Coach Accelerator — Voorspelbare groei voor coaches en experts | NXG Media"
  description="Van referrals naar een systeem dat voor je werkt. Mini-producten, emailflows, ads en AI-vindbaarheid — gebouwd als één machine die leads en klanten oplevert."
  schemas={[generateBreadcrumbs(breadcrumbs.map((b) => ({ name: b.label, url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}/coach-accelerator/` }))), generateFAQPage(faqItems)]}
  hreflang={hreflang}
  locale={locale}
>
  <BreadcrumbNav items={breadcrumbs} />

  {/* ── Hero ── */}
  <section class="relative py-20 md:py-28 lg:py-36 overflow-hidden">
    <div class="absolute inset-0">
      <Image
        src={heroPhoto}
        alt="Joost van Putten — online groei-strateeg voor coaches en experts"
        widths={[800, 1200, 1600]}
        sizes="100vw"
        class="w-full h-full object-cover"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-white/95 via-white/85 to-white/40"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 md:px-6">
      <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl text-text mb-6 leading-tight max-w-2xl">
        Elke maand genoeg klantgesprekken — zonder te leven van referrals
      </h1>
      <p class="text-lg md:text-xl text-text-muted leading-relaxed mb-10 max-w-xl">
        De meeste coaches weten niet waar hun volgende klant vandaan komt. De ene maand loopt het, de andere is het stil. Met een systeem dat voor je werkt, hoef je niet meer te gokken.
      </p>
      <div class="flex flex-col sm:flex-row items-start gap-4">
        <a
          href="/contact/"
          class="inline-flex items-center px-8 py-4 text-base font-medium text-text-inverse bg-primary hover:bg-primary-dark transition-colors rounded-button shadow-lg"
        >
          Bekijk hoe het werkt
          <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a
          href="/contact/"
          class="inline-flex items-center px-8 py-4 text-base font-medium text-primary border-2 border-primary hover:bg-primary/5 transition-colors rounded-button"
        >
          Plan een kennismaking
        </a>
      </div>
    </div>
  </section>

  {/* ── Proof Stats ── */}
  <section class="bg-bg-alt border-y border-border">
    <div class="max-w-4xl mx-auto px-4 md:px-6 py-8 md:py-10">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <div class="font-heading text-2xl md:text-3xl text-primary">600×</div>
          <p class="text-xs text-text-muted mt-1">gids verkocht in 4 maanden</p>
          <p class="text-xs text-accent font-medium mt-0.5">Coach Josine</p>
        </div>
        <div>
          <div class="font-heading text-2xl md:text-3xl text-primary">€10k/mnd</div>
          <p class="text-xs text-text-muted mt-1">online productomzet</p>
          <p class="text-xs text-accent font-medium mt-0.5">Youlife</p>
        </div>
        <div>
          <div class="font-heading text-2xl md:text-3xl text-primary">2.000</div>
          <p class="text-xs text-text-muted mt-1">betalende platformleden</p>
          <p class="text-xs text-accent font-medium mt-0.5">Happy With Yoga</p>
        </div>
        <div>
          <div class="font-heading text-2xl md:text-3xl text-primary">7.2×</div>
          <p class="text-xs text-text-muted mt-1">ROAS op advertenties</p>
          <p class="text-xs text-accent font-medium mt-0.5">Youlife</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── Pain Recognition ── */}
  <section class="py-16 md:py-20 bg-primary">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-white mb-8">Hoe het nu voelt</h2>
      <div class="space-y-5">
        <div class="flex items-start gap-4">
          <span class="text-2xl shrink-0" aria-hidden="true">😓</span>
          <p class="text-white/80 leading-relaxed">Je leeft van referrals en mond-tot-mond. Het loopt... tot het stopt.</p>
        </div>
        <div class="flex items-start gap-4">
          <span class="text-2xl shrink-0" aria-hidden="true">🤷</span>
          <p class="text-white/80 leading-relaxed">Je weet dat je "iets aan marketing moet doen" maar komt er niet aan toe.</p>
        </div>
        <div class="flex items-start gap-4">
          <span class="text-2xl shrink-0" aria-hidden="true">⏰</span>
          <p class="text-white/80 leading-relaxed">Klantwerk gaat altijd voor. En als het stil is, is het te laat om te starten.</p>
        </div>
        <div class="flex items-start gap-4">
          <span class="text-2xl shrink-0" aria-hidden="true">😴</span>
          <p class="text-white/80 leading-relaxed">'s Avonds pieker je: waar komt volgende maand mijn omzet vandaan?</p>
        </div>
      </div>
      <p class="text-white font-medium mt-8 text-lg">
        Je bent niet slecht in ondernemen. Je mist gewoon een systeem dat voor je werkt, ook als jij met klanten bezig bent.
      </p>
    </div>
  </section>

  {/* ── Old Approach ── */}
  <section class="py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-10">De oude aanpak werkt niet meer</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-10 h-10 rounded-full bg-red-50 flex items-center justify-center mb-4">
            <span class="text-red-400 text-lg">✗</span>
          </div>
          <h3 class="font-heading text-lg text-text mb-2">Gratis e-books en downloads</h3>
          <p class="text-sm text-text-muted leading-relaxed">Je deelt je beste tips in een PDF. Van de 100 downloads wordt er misschien 1 klant. De rest hoor je nooit meer.</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-10 h-10 rounded-full bg-red-50 flex items-center justify-center mb-4">
            <span class="text-red-400 text-lg">✗</span>
          </div>
          <h3 class="font-heading text-lg text-text mb-2">"Boek een gratis gesprek"</h3>
          <p class="text-sm text-text-muted leading-relaxed">Je krijgt mensen die "even willen sparren", geen budget hebben, of niet komen opdagen.</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-10 h-10 rounded-full bg-red-50 flex items-center justify-center mb-4">
            <span class="text-red-400 text-lg">✗</span>
          </div>
          <h3 class="font-heading text-lg text-text mb-2">Wachten op referrals</h3>
          <p class="text-sm text-text-muted leading-relaxed">Het werkt... tot het stopt. Je hebt geen controle over wanneer de volgende klant komt.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── Social Proof — WhatsApp ── */}
  <section class="py-16 md:py-20 bg-primary">
    <div class="max-w-4xl mx-auto px-4 md:px-6 text-center">
      <h2 class="font-heading text-2xl md:text-3xl text-white mb-10">
        Resultaat van huidige klanten
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white/10 backdrop-blur rounded-card overflow-hidden border border-white/20">
          <div class="h-72 md:h-80 flex items-center justify-center bg-black/20 p-3">
            <Image
              src={claireWhatsApp}
              alt="WhatsApp bericht van Claire — recorddag met 26 bestellingen"
              widths={[300, 400]}
              sizes="(max-width: 768px) 100vw, 33vw"
              class="max-w-full max-h-full object-contain rounded-lg"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="p-4">
            <p class="font-medium text-white">Claire — ikrouwvanje.nl</p>
            <p class="text-sm text-white/70">+25% meer klanten</p>
          </div>
        </div>
        <div class="bg-white/10 backdrop-blur rounded-card overflow-hidden border border-white/20">
          <div class="h-72 md:h-80 flex items-center justify-center bg-black/20 p-3">
            <Image
              src={tessaWhatsApp}
              alt="WhatsApp bericht van Tessa — 7.2x ROAS op campagnes"
              widths={[300, 400]}
              sizes="(max-width: 768px) 100vw, 33vw"
              class="max-w-full max-h-full object-contain rounded-lg"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="p-4">
            <p class="font-medium text-white">Tessa — Youlife</p>
            <p class="text-sm text-white/70">7.2× ROAS op advertenties</p>
          </div>
        </div>
        <div class="bg-white/10 backdrop-blur rounded-card overflow-hidden border border-white/20">
          <div class="h-72 md:h-80 flex items-center justify-center bg-black/20 p-3">
            <Image
              src={rolfWhatsApp}
              alt="WhatsApp bericht van Rolf — Happy With Yoga resultaten"
              widths={[300, 400]}
              sizes="(max-width: 768px) 100vw, 33vw"
              class="max-w-full max-h-full object-contain rounded-lg"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="p-4">
            <p class="font-medium text-white">Rolf — Happy With Yoga</p>
            <p class="text-sm text-white/70">2.000 betalende leden</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── Timeline ── */}
  <section class="py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-4">Drie fases naar voorspelbare groei</h2>
      <p class="text-lg text-text-muted leading-relaxed mb-12 max-w-3xl">
        Niet alles tegelijk. Elke fase bouwt voort op de vorige — zodat je alleen investeert in wat bewezen werkt.
      </p>

      <div class="relative">
        <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-px bg-border -translate-x-1/2"></div>

        <div class="space-y-8 md:space-y-12">
          {/* Phase 1 */}
          <div class="relative md:grid md:grid-cols-2 md:gap-12 items-start">
            <div class="md:text-right md:pr-8">
              <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-primary/10 text-primary rounded-full mb-3">Maand 1–3</span>
              <h3 class="font-heading text-xl text-text mb-2">Fundament bouwen</h3>
            </div>
            <div class="md:pl-8 mt-3 md:mt-0">
              <div class="bg-white rounded-card p-5 border border-border">
                <ul class="space-y-2 text-sm text-text-muted">
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> Positionering aanscherpen — van generalist naar specialist</li>
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> Eerste product of masterclass live</li>
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> Emailflow na aanmelding — automatische opvolging</li>
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> Eerste ads-test — meten welke boodschap werkt</li>
                </ul>
                <p class="text-xs text-accent font-medium mt-4">Doel: eerste betalende klanten via het nieuwe systeem</p>
              </div>
            </div>
            <div class="hidden md:flex absolute left-1/2 top-3 -translate-x-1/2 w-8 h-8 rounded-full bg-primary text-white items-center justify-center text-sm font-heading">1</div>
          </div>

          {/* Phase 2 */}
          <div class="relative md:grid md:grid-cols-2 md:gap-12 items-start">
            <div class="md:text-right md:pr-8">
              <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/10 text-accent rounded-full mb-3">Maand 3–6</span>
              <h3 class="font-heading text-xl text-text mb-2">Groeien en schalen</h3>
            </div>
            <div class="md:pl-8 mt-3 md:mt-0">
              <div class="bg-white rounded-card p-5 border border-border">
                <ul class="space-y-2 text-sm text-text-muted">
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> Meer producten en kassakoopjes — hogere orderwaarde</li>
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> Advertenties optimaliseren op bewezen boodschappen</li>
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> Doorstroom van productkopers naar coaching of trajecten</li>
                </ul>
                <p class="text-xs text-accent font-medium mt-4">Doel: voorspelbare leadflow en schaalbare omzet</p>
              </div>
            </div>
            <div class="hidden md:flex absolute left-1/2 top-3 -translate-x-1/2 w-8 h-8 rounded-full bg-accent text-white items-center justify-center text-sm font-heading">2</div>
          </div>

          {/* Phase 3 */}
          <div class="relative md:grid md:grid-cols-2 md:gap-12 items-start">
            <div class="md:text-right md:pr-8">
              <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-primary/10 text-primary rounded-full mb-3">Maand 6+</span>
              <h3 class="font-heading text-xl text-text mb-2">Autoriteit en voorsprong</h3>
            </div>
            <div class="md:pl-8 mt-3 md:mt-0">
              <div class="bg-white rounded-card p-5 border border-border">
                <ul class="space-y-2 text-sm text-text-muted">
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> Platform of community — terugkerende omzet</li>
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> AI-vindbaarheid — gevonden worden door ChatGPT en Gemini</li>
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> Brancheautoriteit die concurrenten niet meer inhalen</li>
                </ul>
                <p class="text-xs text-accent font-medium mt-4">Doel: marktleider in jouw niche — online en offline</p>
              </div>
            </div>
            <div class="hidden md:flex absolute left-1/2 top-3 -translate-x-1/2 w-8 h-8 rounded-full bg-primary text-white items-center justify-center text-sm font-heading">3</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── Cases (ClientResults) ── */}
  <ClientResults
    title="Drie klanten, drie fases op dezelfde groeicurve"
    featuredCases={[
      {
        testimonial: testimonials.find((t) => t.id === 'rolf-happywithyoga')!,
        period: 'Sinds 2022',
        stats: [
          { value: '30.000+', label: 'webinarleads' },
          { value: '1.700+', label: 'mini-cursusverkopen' },
          { value: '2.000', label: 'betalende leden' },
        ],
        caseHref: '/cases/happy-with-yoga/',
      },
      {
        testimonial: testimonials.find((t) => t.id === 'tessa-youlife')!,
        period: 'Sinds feb 2025',
        stats: [
          { value: '±€10k/mnd', label: 'online producten' },
          { value: '6', label: 'producten gelanceerd' },
          { value: '±10/mnd', label: 'coachingklanten' },
        ],
        caseHref: '/cases/tessa-youlife/',
      },
      {
        testimonial: testimonials.find((t) => t.id === 'josine-coachjosine')!,
        period: 'Sinds okt 2025',
        stats: [
          { value: '600×', label: 'gids verkocht' },
          { value: '80', label: 'masterclass-aanmeldingen' },
        ],
        caseHref: '/cases/coach-josine/',
      },
    ]}
    smallResults={[]}
    otherTestimonials={[]}
    caseLabel="Lees de case"
    allCasesHref="/cases/"
    allCasesLabel="Bekijk alle cases"
    locale="nl"
  />

  {/* ── The System ── */}
  <section class="py-16 md:py-20 bg-bg-alt">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <div class="max-w-3xl">
        <h2 class="font-heading text-2xl md:text-3xl text-text mb-6">
          Eén route van klik naar klant
        </h2>
        <p class="text-lg text-text-muted leading-relaxed mb-8">
          Geen losse campagnes. Geen "meer zichtbaarheid." Eén systeem waar content, producten, emails en ads samenwerken als één pad — van eerste klik naar betalende klant.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-10 h-10 rounded-full bg-accent/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="font-heading text-lg text-text mb-2">Instap die zichzelf terugverdient</h3>
          <p class="text-sm text-text-muted leading-relaxed">Je eerste online product — een gids, mini-cursus of masterclass — dekt je advertentiekosten vanaf dag 1. Geen maanden wachten op rendement.</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-10 h-10 rounded-full bg-accent/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
            </svg>
          </div>
          <h3 class="font-heading text-lg text-text mb-2">Leads die zichzelf kwalificeren</h3>
          <p class="text-sm text-text-muted leading-relaxed">Bezoekers doorlopen een interactieve route en laten zien wat ze nodig hebben. Jij belt alleen met mensen die al weten waarom ze met jou willen praten.</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-10 h-10 rounded-full bg-accent/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="font-heading text-lg text-text mb-2">Opvolging die vertrouwen bouwt</h3>
          <p class="text-sm text-text-muted leading-relaxed">Na de eerste aanmelding ontvangen leads een persoonlijke serie. Tegen de tijd dat ze je traject zien, hoef je niet meer te overtuigen.</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-10 h-10 rounded-full bg-accent/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
          </div>
          <h3 class="font-heading text-lg text-text mb-2">Voorspelbare groei, geen pieken en dalen</h3>
          <p class="text-sm text-text-muted leading-relaxed">Content, producten, emails en ads vormen één pad. Dat is het verschil tussen "meer zichtbaarheid" en voorspelbare groei.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── Mid CTA ── */}
  <section class="py-16 md:py-20 bg-accent">
    <div class="max-w-4xl mx-auto px-4 md:px-6 text-center">
      <h2 class="font-heading text-3xl md:text-4xl text-white mb-4">
        Benieuwd of dit bij jouw fase past?
      </h2>
      <p class="text-lg text-white/80 mb-8 max-w-2xl mx-auto">
