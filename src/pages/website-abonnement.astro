---
/**
 * Founding Deal — /website-abonnement/
 * Direct-response, offer-led landing page for EUR79/month AI-ready website.
 * noindex — ads lander for test. No links to other offer pages.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import { siteConfig } from '../data/site';
import { generateFAQPage, generateBreadcrumbs } from '../data/schema';

import heroPhoto from '../assets/images/founder/joost-standing-relaxed.webp';
import proofGoogle from '../assets/images/cases/proof-google-torrevieja.png';
import proofChatgpt from '../assets/images/cases/proof-chatgpt-local.png';
import proofVerenaAi from '../assets/images/cases/doc_veri_ai_answer_cropped.PNG';
import proofVerenaChatgpt from '../assets/images/cases/doc-veri-chatgptproof.jpeg';
import verenaPhoto from '../assets/images/cases/verena-mann-linkedin.webp';
import jamesPhoto from '../assets/images/cases/james-mitchell-portrait.png';

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logos/*.{webp,avif,png,jpg}', { eager: true });
const logos = Object.entries(logoFiles)
  .filter(([path]) => /logo/i.test(path.split('/').pop()!))
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/, '');
    const name = filename.replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim();
    return { src: mod.default, alt: name };
  });

const locale = 'nl';
const title = 'Nieuwe AI-ready website — Founding Deal vanaf €79/mnd | NXG Media';
const description = 'Nieuwe AI-ready website zonder €3.000 vooraf. Vanaf €79/maand inclusief hosting, onderhoud en basis Google/AI-structuur. Eerste 10 bedrijven.';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Website Abonnement' },
];

const faqItems = [
  {
    q: 'Is dit echt een gratis website?',
    a: "Je betaalt geen bouwkosten vooraf. De website is inbegrepen in het abonnement van €79/mnd bij 12 maanden.",
  },
  {
    q: 'Waarom 12 maanden?',
    a: "Omdat dit geen los project is. Je krijgt website, hosting, onderhoud en maandelijkse vindbaarheidscheck in één abonnement.",
  },
  {
    q: 'Wat zit er niet in?',
    a: "Extra dienstpagina's, blogs, advertenties, fotografie, uitgebreide SEO-content en maatwerkfuncties zijn apart. Zo blijft het basisaanbod betaalbaar.",
  },
  {
    q: 'Is dit voor elk bedrijf?',
    a: "Nee. Dit is vooral geschikt voor lokale dienstverleners, praktijken en specialisten met een duidelijke dienst. Webshops en complexe maatwerksites vallen hier meestal buiten.",
  },
  {
    q: 'Kan ik zelf aanpassen?',
    a: "Ja. Je krijgt een simpel beheerpaneel voor teksten, foto's, diensten en basiscontent.",
  },
];

const schemas = [
  generateFAQPage(faqItems.map(i => ({ question: i.q, answer: i.a }))),
  generateBreadcrumbs(breadcrumbs),
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={`${siteConfig.url}/website-abonnement`}
  noindex={true}
  schemas={schemas}
  locale={locale}
>

  {/* ══════════════════════════════════════════════════
      SECTIE 1: HERO — HARD AANBOD
      ══════════════════════════════════════════════════ */}
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 hidden md:block">
      <Image
        src={heroPhoto}
        alt=""
        width={800}
        class="absolute right-0 top-0 h-full w-auto object-cover object-top opacity-[0.07]"
        loading="eager"
      />
    </div>

    <div class="relative px-4 md:px-6 pt-8 pb-12 md:pt-14 md:pb-20">
      <div class="max-w-2xl mx-auto">
        <span class="inline-block px-4 py-1.5 text-xs font-medium tracking-widest uppercase bg-accent/10 text-accent rounded-full mb-6">
          Founding Deal &mdash; eerste 10 bedrijven
        </span>

        <h1 class="font-heading text-[1.85rem] leading-[1.12] md:text-[2.75rem] md:leading-[1.1] text-text mb-5">
          Nieuwe AI-ready website.<br />
          <em class="text-accent not-italic">Zonder &euro;3.000 vooraf te betalen.</em>
        </h1>

        <p class="text-text-muted leading-relaxed mb-6 text-[0.95rem] md:text-base max-w-xl">
          Voor lokale dienstverleners die beter gevonden willen worden in Google en AI &mdash;
          zonder dure websitebouw, WordPress-gedoe of technische rommel.
        </p>

        <p class="text-text font-heading text-3xl md:text-4xl mb-6">
          Vanaf <strong class="text-accent">&euro;79</strong><span class="text-lg text-text-muted">/mnd</span>
        </p>

        <a
          href="#aanvragen"
          class="inline-flex items-center gap-2 px-8 py-4 text-base font-medium text-text-inverse bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg w-full md:w-auto justify-center"
        >
          Check of jouw bedrijf in aanmerking komt
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>

        <p class="text-xs text-text-muted mt-4 max-w-md">
          Founding deal &middot; Eerste 10 bedrijven &middot; Website inbegrepen bij 12 maanden
        </p>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      SECTIE 2: PRIJSVERGELIJKING — WAAROM NIET €3-5K?
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-14 md:py-20 border-t border-border/50">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-4 text-center">
        Waarom zou je nog &euro;3.000&ndash;&euro;5.000 vooruitbetalen?
      </h2>
      <p class="text-text-muted text-center mb-4 max-w-2xl mx-auto text-[0.95rem] leading-relaxed">
        Een traditionele websitebouwer rekent vaak duizenden euro&rsquo;s vooraf.
        Daarna betaal je alsnog voor hosting, onderhoud, SEO, aanpassingen en snelheid.
      </p>
      <p class="text-text-muted text-center mb-10 md:mb-12 max-w-2xl mx-auto text-[0.95rem] leading-relaxed">
        Wij draaien het om: je betaalt een laag maandbedrag voor een snel, modern online fundament
        dat gebouwd is om gevonden te worden.
      </p>

      {/* Comparison table */}
      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6">
        {/* Traditional */}
        <div class="border border-border rounded-card p-6 md:p-8 bg-white/50">
          <p class="text-text-muted text-xs uppercase tracking-widest font-medium mb-4">Traditionele website</p>
          <ul class="space-y-3">
            <li class="flex items-start gap-3 text-sm text-text-muted leading-relaxed">
              <svg class="w-4 h-4 text-red-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
              &euro;3.000&ndash;&euro;5.000 vooraf
            </li>
            <li class="flex items-start gap-3 text-sm text-text-muted leading-relaxed">
              <svg class="w-4 h-4 text-red-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
              Hosting apart
            </li>
            <li class="flex items-start gap-3 text-sm text-text-muted leading-relaxed">
              <svg class="w-4 h-4 text-red-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
              Onderhoud apart
            </li>
            <li class="flex items-start gap-3 text-sm text-text-muted leading-relaxed">
              <svg class="w-4 h-4 text-red-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
              SEO apart
            </li>
            <li class="flex items-start gap-3 text-sm text-text-muted leading-relaxed">
              <svg class="w-4 h-4 text-red-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
              Vaak WordPress/plugins
            </li>
            <li class="flex items-start gap-3 text-sm text-text-muted leading-relaxed">
              <svg class="w-4 h-4 text-red-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
              Na oplevering sta je er zelf voor
            </li>
          </ul>
        </div>

        {/* NXG Founding Deal */}
        <div class="border-2 border-accent/30 rounded-card p-6 md:p-8 bg-white shadow-lg relative">
          <span class="absolute -top-3 left-6 inline-block px-3 py-0.5 text-[0.65rem] font-medium tracking-widest uppercase bg-accent text-white rounded-full">
            Founding Deal
          </span>
          <p class="text-text text-xs uppercase tracking-widest font-medium mb-4">NXG Media</p>
          <ul class="space-y-3">
            <li class="flex items-start gap-3 text-sm text-text leading-relaxed font-medium">
              <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Vanaf &euro;79/mnd
            </li>
            <li class="flex items-start gap-3 text-sm text-text leading-relaxed font-medium">
              <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Website inbegrepen
            </li>
            <li class="flex items-start gap-3 text-sm text-text leading-relaxed font-medium">
              <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Hosting inbegrepen
            </li>
            <li class="flex items-start gap-3 text-sm text-text leading-relaxed font-medium">
              <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Technisch onderhoud inbegrepen
            </li>
            <li class="flex items-start gap-3 text-sm text-text leading-relaxed font-medium">
              <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Basis Google/AI-structuur inbegrepen
            </li>
            <li class="flex items-start gap-3 text-sm text-text leading-relaxed font-medium">
              <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
              Maandelijkse vindbaarheidscheck
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      SECTIE 3: WAT MOET DIT OPLEVEREN?
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-14 md:py-20 bg-bg-alt">
    <div class="max-w-3xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-4 text-center">
        Het doel: meer klanten die jou vinden v&oacute;&oacute;rdat ze je concurrent bellen.
      </h2>
      <p class="text-text-muted text-center mb-8 md:mb-10 max-w-2xl mx-auto text-[0.95rem] leading-relaxed">
        Je website hoeft niet alleen mooi te zijn. Hij moet zorgen dat Google, ChatGPT en potenti&euml;le klanten
        sneller begrijpen wat je doet, waar je werkt en waarom jij de logische keuze bent.
      </p>

      <ul class="space-y-4 mb-8">
        <li class="flex items-start gap-3">
          <span class="text-accent shrink-0 mt-0.5 font-bold">&rarr;</span>
          <p class="text-text text-[0.95rem] leading-relaxed">Beter zichtbaar op zoekvragen rond jouw dienst + regio</p>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-accent shrink-0 mt-0.5 font-bold">&rarr;</span>
          <p class="text-text text-[0.95rem] leading-relaxed">Sneller vertrouwen bij bezoekers die je nog niet kennen</p>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-accent shrink-0 mt-0.5 font-bold">&rarr;</span>
          <p class="text-text text-[0.95rem] leading-relaxed">Duidelijkere CTA&rsquo;s zodat mensen sneller contact opnemen</p>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-accent shrink-0 mt-0.5 font-bold">&rarr;</span>
          <p class="text-text text-[0.95rem] leading-relaxed">Een fundament dat AI-tools beter kunnen lezen en begrijpen</p>
        </li>
        <li class="flex items-start gap-3">
          <span class="text-accent shrink-0 mt-0.5 font-bold">&rarr;</span>
          <p class="text-text text-[0.95rem] leading-relaxed">Minder afhankelijk van mond-tot-mond of dure advertenties</p>
        </li>
      </ul>

      <p class="text-text font-medium text-center text-[0.95rem]">
        Geen garantie op wonderen. Wel een veel sterker fundament dan een trage, verouderde of onduidelijke website.
      </p>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      SECTIE 4: BEWIJS — HARDE CASES
      ══════════════════════════════════════════════════ */}
  <section class="py-20 md:py-28 bg-primary">
    <div class="max-w-5xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-3xl md:text-4xl text-white mb-3 text-center">
        Dit is wat er kan gebeuren als het fundament klopt.
      </h2>
      <p class="text-white/60 text-center mb-16 max-w-lg mx-auto">Geen portfoliostukjes. Echte resultaten.</p>

      {/* ── CASE 1: CBMC — met foto, metrics, screenshots ── */}
      <div class="bg-white/5 backdrop-blur border-2 border-accent/30 rounded-card p-6 md:p-10 mb-12">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-14 h-14 rounded-full overflow-hidden ring-2 ring-accent/30 shrink-0">
            <Image
              src={jamesPhoto}
              alt="Dr. James Mitchell"
              widths={[56, 112]}
              sizes="56px"
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div>
            <p class="text-white font-medium text-sm">Dr. James Mitchell</p>
            <a href="https://www.costablancamovement.com" target="_blank" rel="noopener" class="text-accent/70 hover:text-accent text-xs transition-colors">costablancamovement.com</a>
            <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-medium bg-accent/20 text-accent rounded-full uppercase tracking-wider mt-1">Chiropraktijk &middot; Costa Blanca</span>
          </div>
        </div>

        <h3 class="font-heading text-2xl md:text-3xl text-white mb-4">Van nul naar online vindbaar in 14 dagen.</h3>

        <p class="text-white/60 leading-relaxed mb-6">
          Costa Blanca Movement Centre &mdash; een chiropraktijk voor expats in Torrevieja.
          Geen bestaande site. Geen Google-geschiedenis. Geen backlinks. Nul.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-5 mb-8">
          <div class="space-y-2.5">
            <p class="text-white/50 text-[10px] uppercase tracking-wider font-medium">Na 2 weken live</p>
            <div class="flex items-start gap-3">
              <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
              <p class="text-white/80 text-sm font-medium">Na 2 weken: pagina 1 in Google</p>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
              <p class="text-white/80 text-sm font-medium">ChatGPT noemt de kliniek als lokale optie</p>
            </div>
          </div>
          <div class="space-y-3">
            <p class="text-white/50 text-[10px] uppercase tracking-wider font-medium">Na 2 maanden</p>
            <div class="bg-white/5 rounded-card p-4">
              <p class="text-white/50 text-xs uppercase tracking-wider mb-1">Nieuwe pati&euml;nten</p>
              <div class="flex items-center gap-2">
                <span class="font-heading text-xl text-white/40">0</span>
                <span class="text-accent text-sm">&rarr;</span>
                <span class="font-heading text-3xl text-accent">12&ndash;15</span>
              </div>
              <p class="text-white/40 text-xs mt-1">/maand via online</p>
            </div>
            <div class="bg-white/5 rounded-card p-4">
              <p class="text-white/50 text-xs uppercase tracking-wider mb-1">Organisch verkeer</p>
              <div class="flex items-center gap-2">
                <span class="font-heading text-xl text-white/40">0</span>
                <span class="text-accent text-sm">&rarr;</span>
                <span class="font-heading text-3xl text-accent">800+</span>
              </div>
              <p class="text-white/40 text-xs mt-1">bezoekers/maand</p>
            </div>
          </div>
        </div>

        {/* Screenshots */}
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
          <button type="button" class="proof-trigger cursor-pointer group text-left">
            <div class="bg-black/40 border border-white/10 rounded-lg overflow-hidden">
              <Image
                src={proofGoogle}
                alt="Google zoekresultaat: Costa Blanca Movement Centre op positie 4 na 2 weken"
                width={1200}
                quality={85}
                class="w-full h-auto"
                loading="lazy"
              />
            </div>
            <p class="text-white/40 text-xs mt-2 text-center group-hover:text-white/60 transition-colors">Google positie 4 &mdash; na 2 weken</p>
          </button>
          <button type="button" class="proof-trigger cursor-pointer group text-left">
            <div class="bg-black/40 border border-white/10 rounded-lg overflow-hidden">
              <Image
                src={proofChatgpt}
                alt="ChatGPT beveelt Costa Blanca Movement Centre aan als nummer 1 lokale optie"
                width={1200}
                quality={85}
                class="w-full h-auto"
                loading="lazy"
              />
            </div>
            <p class="text-white/40 text-xs mt-2 text-center group-hover:text-white/60 transition-colors">ChatGPT beveelt de kliniek aan als #1</p>
          </button>
        </div>

        <div class="pt-6 border-t border-white/10">
          <p class="text-accent font-medium leading-relaxed text-center text-lg">
            Niet na een jaar SEO. Niet na maanden wachten. Eerst het fundament goed &mdash;
            daarna kon Google en AI de praktijk veel sneller begrijpen.
          </p>
        </div>
      </div>

      {/* ── CASE 2: Dr. Verena Mann — met foto, metrics, screenshots ── */}
      <div class="bg-white/5 backdrop-blur border border-white/10 rounded-card p-6 md:p-10 mb-12">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14">
          <div>
            <div class="flex items-center gap-4 mb-5">
              <div class="w-14 h-14 rounded-full overflow-hidden ring-2 ring-accent/30 shrink-0">
                <Image
                  src={verenaPhoto}
                  alt="Dr. Verena Mann"
                  widths={[56, 112]}
                  sizes="56px"
                  class="w-full h-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div>
                <p class="text-white font-medium text-sm">Dr. Verena Mann</p>
                <a href="https://doc-veri.pages.dev" target="_blank" rel="noopener" class="text-accent/70 hover:text-accent text-xs transition-colors">doc-veri.pages.dev</a>
                <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-medium bg-accent/20 text-accent rounded-full uppercase tracking-wider mt-1">Arts &middot; Duitsland</span>
              </div>
            </div>
            <h3 class="font-heading text-2xl md:text-3xl text-white mb-4">Van sterke expertise naar aanvragen van mensen die haar nog niet kenden.</h3>

            <p class="text-white/60 leading-relaxed mb-6">
              Dr. Verena Mann is arts en expert rond hormonale gezondheid, darmgezondheid en intoleranties.
              Ze had al expertise en een community, maar haar website leverde nauwelijks aanvragen op van
              mensen die haar nog niet kenden.
            </p>

            <div class="space-y-2 mb-6">
              <div class="flex items-start gap-3">
                <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
                <p class="text-white/80 text-sm font-medium">2 &rarr; 19 aanvragen per maand</p>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
                <p class="text-white/80 text-sm font-medium">0 &rarr; 15 AI-vermeldingen</p>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
                <p class="text-white/80 text-sm font-medium">ChatGPT noemt haar als passende expert</p>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
                <p class="text-white/80 text-sm font-medium">Nieuwe AI-ready site live in &plusmn;6 weken</p>
              </div>
            </div>
          </div>

          {/* Rechts: harde metrics */}
          <div class="flex flex-col justify-center space-y-6">
            <div class="bg-white/5 rounded-card p-5">
              <p class="text-white/50 text-xs uppercase tracking-wider mb-2">Aanvragen per maand</p>
              <div class="flex items-center gap-3">
                <span class="font-heading text-3xl text-white/40">2</span>
                <span class="text-accent text-xl">&rarr;</span>
                <span class="font-heading text-5xl md:text-6xl text-accent">19</span>
              </div>
            </div>
            <div class="bg-white/5 rounded-card p-5">
              <p class="text-white/50 text-xs uppercase tracking-wider mb-2">AI-vermeldingen (ChatGPT)</p>
