    if (btn) { btn.disabled = true; btn.textContent = 'Even geduld...'; }

    var extraInfo = [];
    if (bedrijf) extraInfo.push('Bedrijf: ' + bedrijf);
    if (bedrijfstype) extraInfo.push('Type: ' + bedrijfstype);
    if (dienst) extraInfo.push('Dienst: ' + dienst);
    if (telefoon) extraInfo.push('Tel: ' + telefoon);

    var payload = {
      naam: naam,
      email: email,
      websiteUrl: website,
      vraag: 'Website Actie aanvraag — ' + extraInfo.join(' — '),
      source: 'website-actie',
    };

    if (typeof fbq === 'function') {
      fbq('track', 'Lead', { content_name: 'website-actie', content_category: 'website-abonnement' });
    }
    if (typeof trackEvent === 'function') {
      trackEvent('scanner_request_submitted', {
        page_type: 'page',
        page_slug: 'website-abonnement',
        locale: 'nl',
        cta_location: 'inline',
      });
    }

    fetch('https://scanner.nxg-media.com/api/gratis-check', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(payload),
    }).then(function() {
      showThanks();
    }).catch(function() {
      showThanks();
    });

    function showThanks() {
      form.classList.add('hidden');
      thanks.classList.remove('hidden');
      if (microcopy) microcopy.classList.add('hidden');
    }
  });
})();
</script>
