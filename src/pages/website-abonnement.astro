---
/**
 * AI-ready Website Actie — /website-abonnement/
 * Bold direct-response landing page. EUR79/month AI-ready website.
 * noindex — ads lander. No links to other offer pages.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import { siteConfig } from '../data/site';
import { generateFAQPage, generateBreadcrumbs } from '../data/schema';

import heroPhoto from '../assets/images/founder/joost-standing-relaxed.webp';
import proofGoogle from '../assets/images/cases/proof-google-torrevieja.png';
import proofChatgpt from '../assets/images/cases/proof-chatgpt-local.png';
import proofVerenaAi from '../assets/images/cases/doc_veri_ai_answer_cropped.PNG';
import proofVerenaChatgpt from '../assets/images/cases/doc-veri-chatgptproof.jpeg';
import verenaPhoto from '../assets/images/cases/verena-mann-linkedin.webp';
import jamesPhoto from '../assets/images/cases/james-mitchell-portrait.png';

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logos/*.{webp,avif,png,jpg}', { eager: true });
const logos = Object.entries(logoFiles)
  .filter(([path]) => /logo/i.test(path.split('/').pop()!))
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/, '');
    const name = filename.replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim();
    return { src: mod.default, alt: name };
  });

const locale = 'nl';
const title = 'Nieuwe AI-ready website vanaf €79/mnd — Website Actie | NXG Media';
const description = 'Nieuwe AI-ready website zonder €3.000 vooraf. Vanaf €79/maand inclusief hosting, onderhoud en Google/AI-structuur. Eerste 10 plekken deze maand.';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Website Abonnement' },
];

const faqItems = [
  {
    q: 'Is dit echt zonder bouwkosten?',
    a: "De website is inbegrepen in het abonnement vanaf €79/mnd bij 12 maanden. Geen €3.000-5.000 vooraf.",
  },
  {
    q: 'Waarom 12 maanden?',
    a: "Dit is geen los project. Website, hosting, onderhoud en maandelijkse vindbaarheidscheck zitten in één abonnement.",
  },
  {
    q: 'Wat als er niks gebeurt?',
    a: "Binnen 30 dagen staat je nieuwe fundament live. Daarna monitoren we maandelijks of de basis goed blijft staan voor snelheid, structuur en vindbaarheid. Als er iets technisch niet klopt aan het fundament, lossen we dat op.",
  },
  {
    q: 'Wat zit er niet in?',
    a: "Extra dienstpagina's, blogs, fotografie, advertenties, uitgebreide SEO-content en maatwerkfuncties zijn apart. Zo blijft de basisprijs laag.",
  },
  {
    q: 'Is dit voor elk bedrijf?',
    a: "Vooral voor lokale dienstverleners, praktijken en specialisten met een duidelijke dienst. Webshops en complexe maatwerksites vallen meestal buiten deze actie.",
  },
  {
    q: 'Kan ik zelf aanpassen?',
    a: "Je krijgt een simpel beheerpaneel voor teksten, foto's, diensten en basiscontent.",
  },
];

const schemas = [
  generateFAQPage(faqItems.map(i => ({ question: i.q, answer: i.a }))),
  generateBreadcrumbs(breadcrumbs),
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={`${siteConfig.url}/website-abonnement`}
  noindex={true}
  schemas={schemas}
  locale={locale}
>

  {/* ══════════════════════════════════════════════════
      HERO — BOLD OFFER
      ══════════════════════════════════════════════════ */}
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 hidden md:block">
      <Image
        src={heroPhoto}
        alt=""
        width={800}
        class="absolute right-0 top-0 h-full w-auto object-cover object-top opacity-[0.07]"
        loading="eager"
      />
    </div>

    <div class="relative px-4 md:px-6 pt-8 pb-10 md:pt-14 md:pb-16">
      <div class="max-w-2xl mx-auto">
        <span class="inline-block px-4 py-1.5 text-xs font-medium tracking-widest uppercase bg-accent/10 text-accent rounded-full mb-6">
          Actie-aanbod &middot; eerste 10 plekken deze maand
        </span>

        <h1 class="font-heading text-[1.85rem] leading-[1.12] md:text-[2.75rem] md:leading-[1.1] text-text mb-5">
          Nieuwe AI-ready website.<br />
          <em class="text-accent not-italic">Zonder &euro;3.000 vooraf te betalen.</em>
        </h1>

        <p class="text-text-muted leading-relaxed mb-5 text-[0.95rem] md:text-base max-w-xl">
          Voor lokale dienstverleners die gevonden willen worden in Google &eacute;n AI &mdash;
          zonder dure websitebouw, WordPress-gedoe of maanden wachten.
        </p>

        <p class="text-text font-heading text-3xl md:text-4xl mb-5">
          Vanaf <strong class="text-accent">&euro;79</strong><span class="text-lg text-text-muted">/mnd</span>
        </p>

        {/* Early proof — high on the page */}
        <div class="bg-accent/5 border border-accent/20 rounded-button px-4 py-3 mb-6 max-w-xl">
          <p class="text-sm text-text font-medium leading-snug">
            <span class="text-accent mr-1">&rarr;</span>
            Onze laatste 2 nieuwe websites werden binnen 2 weken zichtbaar in Google of AI.
          </p>
        </div>

        <a
          href="#aanvragen"
          class="inline-flex items-center gap-2 px-8 py-4 text-base font-medium text-text-inverse bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg w-full md:w-auto justify-center"
        >
          Check of mijn bedrijf in aanmerking komt
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>

        <p class="text-xs text-text-muted mt-4 max-w-md">
          Actie-aanbod &middot; Eerste 10 plekken deze maand &middot; Website inbegrepen bij 12 maanden
        </p>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      PAIN — DIT IS GEEN NICE-TO-HAVE
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-14 md:py-20 bg-bg-alt border-t border-border/50">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-10 md:mb-12 text-center">
        Dit is geen nice-to-have als je nu al klanten misloopt
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 mb-10">
        <div class="bg-white border border-border rounded-card p-6">
          <p class="font-heading text-lg text-text mb-2">Je oude site kost je mogelijk nu al aanvragen</p>
          <p class="text-text-muted text-sm leading-relaxed">
            Als bezoekers niet snel begrijpen wat je doet, waar je werkt en waarom jij betrouwbaar bent, klikken ze door.
          </p>
        </div>
        <div class="bg-white border border-border rounded-card p-6">
          <p class="font-heading text-lg text-text mb-2">Google en AI kiezen de duidelijkste optie</p>
          <p class="text-text-muted text-sm leading-relaxed">
            Niet altijd de beste ondernemer. Vaak de ondernemer die online het makkelijkst te begrijpen is.
          </p>
        </div>
        <div class="bg-white border border-border rounded-card p-6">
          <p class="font-heading text-lg text-text mb-2">&Eacute;&eacute;n extra klant kan dit al terugverdienen</p>
          <p class="text-text-muted text-sm leading-relaxed">
            Bij &euro;79/mnd hoeft dit geen groot risico te zijn. &Eacute;&eacute;n extra aanvraag of klant kan het verschil al maken.
          </p>
        </div>
      </div>

      <p class="text-text font-medium text-center text-base md:text-lg max-w-2xl mx-auto">
        Je concurrent hoeft niet beter te zijn. Alleen duidelijker vindbaar.
      </p>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      COMPARISON — WHY PAY 3-5K?
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-14 md:py-20">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-4 text-center">
        Waarom nog &euro;3.000&ndash;&euro;5.000 vooruitbetalen voor een website?
      </h2>
      <p class="text-text-muted text-center mb-3 max-w-2xl mx-auto text-[0.95rem] leading-relaxed">
        Een traditionele websitebouwer rekent duizenden euro&rsquo;s vooraf.
        Daarna betaal je alsnog voor hosting, onderhoud, SEO, snelheid en aanpassingen.
      </p>
      <p class="text-text text-center mb-10 md:mb-12 max-w-2xl mx-auto text-[0.95rem] leading-relaxed font-medium">
        Wij draaien het om: een modern AI-ready fundament vanaf &euro;79/mnd, inclusief website, hosting, onderhoud en maandelijkse vindbaarheidscheck.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6">
        {/* Traditional */}
        <div class="border border-border rounded-card p-6 md:p-8 bg-white/50">
          <p class="text-text-muted text-xs uppercase tracking-widest font-medium mb-4">Traditionele website</p>
          <ul class="space-y-3">
            {[
              '€3.000-5.000 vooraf',
              'Hosting apart',
              'Onderhoud apart',
              'SEO apart',
              'Vaak WordPress/plugins',
              'Na oplevering zoek je het zelf uit',
            ].map((item) => (
              <li class="flex items-start gap-3 text-sm text-text-muted leading-relaxed">
                <svg class="w-4 h-4 text-red-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        {/* NXG */}
        <div class="border-2 border-accent/30 rounded-card p-6 md:p-8 bg-white shadow-lg relative">
          <span class="absolute -top-3 left-6 inline-block px-3 py-0.5 text-[0.65rem] font-medium tracking-widest uppercase bg-accent text-white rounded-full">
            Actie-aanbod
          </span>
          <p class="text-text text-xs uppercase tracking-widest font-medium mb-4">NXG AI-ready Website Actie</p>
          <ul class="space-y-3">
            {[
              'Vanaf €79/mnd',
              'Nieuwe website inbegrepen',
              'Hosting inbegrepen',
              'Onderhoud inbegrepen',
              'Gebouwd voor Google én AI',
              'Maandelijkse vindbaarheidscheck',
            ].map((item) => (
              <li class="flex items-start gap-3 text-sm text-text leading-relaxed font-medium">
                <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      OUTCOMES — WAT MOET DIT OPLEVEREN
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-14 md:py-20 bg-bg-alt">
    <div class="max-w-3xl mx-auto">
      <p class="text-xs uppercase tracking-widest text-accent font-medium text-center mb-3">Wat moet dit opleveren?</p>
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-4 text-center">
        Meer klanten die jou vinden v&oacute;&oacute;rdat ze je concurrent bellen.
      </h2>
      <p class="text-text-muted text-center mb-8 md:mb-10 max-w-2xl mx-auto text-[0.95rem] leading-relaxed">
        Een website hoeft niet alleen mooi te zijn. Hij moet Google, ChatGPT en nieuwe klanten sneller laten begrijpen wat je doet, waar je werkt en waarom jij de logische keuze bent.
      </p>

      <ul class="space-y-4 mb-8">
        {[
          'Beter zichtbaar op zoekvragen rond jouw dienst + regio',
          'Sneller vertrouwen bij mensen die je nog niet kennen',
          "Duidelijkere CTA's zodat bezoekers sneller contact opnemen",
          'Een website die AI-tools kunnen lezen en begrijpen',
          'Minder afhankelijk van mond-tot-mond of dure advertenties',
        ].map((item) => (
          <li class="flex items-start gap-3">
            <span class="text-accent shrink-0 mt-0.5 font-bold">&rarr;</span>
            <p class="text-text text-[0.95rem] leading-relaxed">{item}</p>
          </li>
        ))}
      </ul>

      <p class="text-text font-medium text-center text-base md:text-lg">
        Niet mooier om mooier. Een website die klanten moet opleveren.
      </p>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      PROOF — HARD CASES
      ══════════════════════════════════════════════════ */}
  <section class="py-20 md:py-28 bg-primary">
    <div class="max-w-5xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-3xl md:text-4xl text-white mb-3 text-center">
        Het fundament werkt. Hier is het bewijs.
      </h2>
      <p class="text-white/60 text-center mb-16 max-w-xl mx-auto">
        De laatste 2 nieuwe sites die we bouwden, werden binnen 2 weken al zichtbaar in Google of AI.
      </p>

      {/* ── CASE 1: CBMC ── */}
      <div class="bg-white/5 backdrop-blur border-2 border-accent/30 rounded-card p-6 md:p-10 mb-12">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-14 h-14 rounded-full overflow-hidden ring-2 ring-accent/30 shrink-0">
            <Image
              src={jamesPhoto}
              alt="Dr. James Mitchell"
              widths={[56, 112]}
              sizes="56px"
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div>
            <p class="text-white font-medium text-sm">Dr. James Mitchell</p>
            <a href="https://www.costablancamovement.com" target="_blank" rel="noopener" class="text-accent/70 hover:text-accent text-xs transition-colors">costablancamovement.com</a>
            <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-medium bg-accent/20 text-accent rounded-full uppercase tracking-wider mt-1">Chiropraktijk &middot; Costa Blanca</span>
          </div>
        </div>

        <h3 class="font-heading text-2xl md:text-3xl text-white mb-4">Costa Blanca Movement Centre &mdash; van nul naar vindbaar in 14 dagen</h3>

        <p class="text-white/70 leading-relaxed mb-6 text-[0.95rem]">
          Een chiropraktijk voor expats in Torrevieja. Geen bestaande website. Geen Google-historie. Geen backlinks. Nul.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-5 mb-8">
          <div class="space-y-2.5">
            <p class="text-white/50 text-[10px] uppercase tracking-wider font-medium">Na 2 weken live</p>
            <div class="flex items-start gap-3">
              <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
              <p class="text-white/90 text-sm font-medium">Pagina 1 in Google</p>
            </div>
            <div class="flex items-start gap-3">
              <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
              <p class="text-white/90 text-sm font-medium">ChatGPT noemt de kliniek als lokale optie</p>
            </div>
          </div>
          <div class="space-y-3">
            <p class="text-white/50 text-[10px] uppercase tracking-wider font-medium">Na 2 maanden</p>
            <div class="bg-white/5 rounded-card p-4">
              <p class="text-white/50 text-xs uppercase tracking-wider mb-1">Nieuwe pati&euml;nten</p>
              <div class="flex items-center gap-2">
                <span class="font-heading text-xl text-white/40">0</span>
                <span class="text-accent text-sm">&rarr;</span>
                <span class="font-heading text-3xl text-accent">12&ndash;15</span>
              </div>
              <p class="text-white/40 text-xs mt-1">/maand via online</p>
            </div>
            <div class="bg-white/5 rounded-card p-4">
              <p class="text-white/50 text-xs uppercase tracking-wider mb-1">Organisch verkeer</p>
              <div class="flex items-center gap-2">
                <span class="font-heading text-xl text-white/40">0</span>
                <span class="text-accent text-sm">&rarr;</span>
                <span class="font-heading text-3xl text-accent">800+</span>
              </div>
              <p class="text-white/40 text-xs mt-1">bezoekers/maand</p>
            </div>
          </div>
        </div>

        {/* Screenshots */}
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
          <button type="button" class="proof-trigger cursor-pointer group text-left">
            <div class="bg-black/40 border border-white/10 rounded-lg overflow-hidden">
              <Image
                src={proofGoogle}
                alt="Google zoekresultaat: Costa Blanca Movement Centre op pagina 1 na 2 weken"
                width={1200}
                quality={85}
                class="w-full h-auto"
                loading="lazy"
              />
            </div>
            <p class="text-white/40 text-xs mt-2 text-center group-hover:text-white/60 transition-colors">Google pagina 1 &mdash; na 2 weken</p>
          </button>
          <button type="button" class="proof-trigger cursor-pointer group text-left">
            <div class="bg-black/40 border border-white/10 rounded-lg overflow-hidden">
              <Image
                src={proofChatgpt}
                alt="ChatGPT beveelt Costa Blanca Movement Centre aan als nummer 1 lokale optie"
                width={1200}
                quality={85}
                class="w-full h-auto"
                loading="lazy"
              />
            </div>
            <p class="text-white/40 text-xs mt-2 text-center group-hover:text-white/60 transition-colors">ChatGPT beveelt de kliniek aan als #1</p>
          </button>
        </div>

        <div class="pt-6 border-t border-white/10">
          <p class="text-accent font-medium leading-relaxed text-center text-lg">
            Niet na een jaar SEO. Na 14 dagen werd het fundament al opgepikt.
          </p>
        </div>
      </div>

      {/* ── CASE 2: Dr. Verena Mann ── */}
      <div class="bg-white/5 backdrop-blur border border-white/10 rounded-card p-6 md:p-10 mb-12">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14">
          <div>
            <div class="flex items-center gap-4 mb-5">
              <div class="w-14 h-14 rounded-full overflow-hidden ring-2 ring-accent/30 shrink-0">
                <Image
                  src={verenaPhoto}
                  alt="Dr. Verena Mann"
                  widths={[56, 112]}
                  sizes="56px"
                  class="w-full h-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div>
                <p class="text-white font-medium text-sm">Dr. Verena Mann</p>
                <a href="https://doc-veri.pages.dev" target="_blank" rel="noopener" class="text-accent/70 hover:text-accent text-xs transition-colors">doc-veri.pages.dev</a>
                <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-medium bg-accent/20 text-accent rounded-full uppercase tracking-wider mt-1">Arts &middot; Duitsland</span>
              </div>
            </div>
            <h3 class="font-heading text-2xl md:text-3xl text-white mb-4">Dr. Verena Mann &mdash; van sterke expertise naar 19 aanvragen per maand</h3>

            <p class="text-white/70 leading-relaxed mb-6 text-[0.95rem]">
              Dr. Verena Mann had expertise en een community, maar haar website leverde nauwelijks aanvragen op van mensen die haar nog niet kenden.
            </p>

            <div class="space-y-2 mb-6">
              <div class="flex items-start gap-3">
                <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
                <p class="text-white/90 text-sm font-medium">2 &rarr; 19 aanvragen per maand</p>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
                <p class="text-white/90 text-sm font-medium">0 &rarr; 15 AI-vermeldingen</p>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
                <p class="text-white/90 text-sm font-medium">ChatGPT noemt haar als passende expert</p>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
                <p class="text-white/90 text-sm font-medium">Nieuwe AI-ready site live in &plusmn;6 weken</p>
              </div>
            </div>
          </div>

          {/* Right: hard metrics */}
          <div class="flex flex-col justify-center space-y-6">
            <div class="bg-white/5 rounded-card p-5">
              <p class="text-white/50 text-xs uppercase tracking-wider mb-2">Aanvragen per maand</p>
              <div class="flex items-center gap-3">
                <span class="font-heading text-3xl text-white/40">2</span>
                <span class="text-accent text-xl">&rarr;</span>
                <span class="font-heading text-5xl md:text-6xl text-accent">19</span>
              </div>
            </div>
            <div class="bg-white/5 rounded-card p-5">
              <p class="text-white/50 text-xs uppercase tracking-wider mb-2">AI-vermeldingen (ChatGPT)</p>
              <div class="flex items-center gap-3">
                <span class="font-heading text-3xl text-white/40">0</span>
                <span class="text-accent text-xl">&rarr;</span>
                <span class="font-heading text-5xl md:text-6xl text-accent">15</span>
              </div>
            </div>
          </div>
        </div>

        {/* Screenshots */}
        <div class="mt-8 pt-8 border-t border-white/10">
          <p class="text-white/50 text-xs uppercase tracking-wider mb-4">ChatGPT beveelt Dr. Verena Mann aan bij relevante zoekvragen</p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <button type="button" class="proof-trigger cursor-pointer group text-left">
              <div class="bg-black/40 border border-white/10 rounded-lg overflow-hidden">
                <Image
                  src={proofVerenaAi}
                  alt="ChatGPT noemt Dr. Verena Mann als passende expertin"
                  width={1200}
                  quality={85}
                  class="w-full h-auto"
                  loading="lazy"
                />
              </div>
              <p class="text-white/40 text-xs mt-2 text-center group-hover:text-white/60 transition-colors">AI-antwoord: &ldquo;eine passende Expertin&rdquo;</p>
            </button>
            <button type="button" class="proof-trigger cursor-pointer group text-left">
              <div class="bg-black/40 border border-white/10 rounded-lg overflow-hidden">
                <Image
                  src={proofVerenaChatgpt}
                  alt="ChatGPT beveelt Dr. Verena Mann aan met directe link naar haar website"
                  width={1200}
                  quality={85}
                  class="w-full h-auto"
                  loading="lazy"
                />
              </div>
