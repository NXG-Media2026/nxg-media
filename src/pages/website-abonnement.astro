---
/**
 * AI-ready Website Actie — /website-abonnement/
 * Direct-response landing page. Translate existing site to AI-ready foundation.
 * noindex — ads lander. No links to other offer pages.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import { siteConfig } from '../data/site';
import { generateFAQPage, generateBreadcrumbs } from '../data/schema';

import heroPhoto from '../assets/images/founder/joost-standing-workinglaptop.webp';
import keystaticDashboard from '../assets/images/keystatic1.png';
import keystaticHomepage from '../assets/images/keystatic_edit_homepage.png';
import keystaticBlog from '../assets/images/keystatic_add_blog.png';

const cmsScreenshots = [
  { src: keystaticDashboard, alt: 'Beheerpaneel met overzicht van alle pagina\'s, blogs, diensten en producten', caption: 'Alles op één plek' },
  { src: keystaticHomepage, alt: 'Homepage teksten aanpassen via eenvoudige invoervelden', caption: 'Teksten aanpassen — geen code nodig' },
  { src: keystaticBlog, alt: 'Blog schrijven met opmaak toolbar en SEO-velden', caption: 'Zelf blogartikelen publiceren' },
];
import proofGoogle from '../assets/images/cases/proof-google-torrevieja.png';
import proofChatgpt from '../assets/images/cases/proof-chatgpt-local.png';
import proofVerenaAi from '../assets/images/cases/doc_veri_ai_answer_cropped.PNG';
import proofVerenaChatgpt from '../assets/images/cases/doc-veri-chatgptproof.jpeg';
import verenaPhoto from '../assets/images/cases/verena-mann-linkedin.webp';
import jamesPhoto from '../assets/images/cases/james-mitchell-portrait.png';

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logos/*.{webp,avif,png,jpg}', { eager: true });
const logos = Object.entries(logoFiles)
  .filter(([path]) => /logo/i.test(path.split('/').pop()!))
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/, '');
    const name = filename.replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim();
    return { src: mod.default, alt: name };
  });

const locale = 'nl';
const title = 'AI-ready Website Actie — vanaf €79/mnd | NXG Media';
const description = 'Je huidige website omzetten naar een AI-ready klantfundament dat Google, ChatGPT en klanten begrijpen. Vanaf €79/mnd. Eerste 10 plekken deze maand.';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Website Abonnement' },
];

const faqItems = [
  {
    q: 'Moet mijn hele website opnieuw?',
    a: "Het uitgangspunt is juist dat we meenemen wat bruikbaar is: je aanbod, huisstijl, teksten, foto's en bewijs. We zetten het opnieuw neer op een sneller en duidelijker fundament.",
  },
  {
    q: 'Waarom kan dit voor €79/mnd?',
    a: "Omdat we niet vanaf nul een volledig maatwerkproject bouwen. We vertalen je bestaande site naar een strak fundament. Daardoor kunnen we sneller bouwen en de kosten laag houden.",
  },
  {
    q: 'Waarom maar 10 plekken?',
    a: "Omdat dit alleen werkt als de scope strak blijft: je huidige site omzetten naar een beter fundament, zonder eindeloos maatwerktraject. Daarom nemen we maximaal 10 bedrijven per maand aan.",
  },
  {
    q: 'Waarom 12 maanden?',
    a: "Website, hosting, onderhoud en maandelijkse vindbaarheidscheck zitten in één abonnement. Geen groot bedrag vooraf, wel een fundament dat blijft draaien en onderhouden wordt.",
  },
  {
    q: "Wat als ik extra pagina's of SEO-content wil?",
    a: "Dat kan later. Extra dienstpagina's, blogs, lokale content en uitgebreide optimalisatie zijn apart bij te boeken. Eerst zorgen we dat het fundament klopt.",
  },
  {
    q: 'Ben ik mijn oude content kwijt?',
    a: "Nee. Wat bruikbaar is, nemen we mee. Wat onduidelijk, traag of niet converterend is, maken we scherper.",
  },
  {
    q: 'Is dit voor elk bedrijf?',
    a: "Vooral voor lokale dienstverleners, praktijken en specialisten met een duidelijke dienst. Webshops en complexe maatwerksites vallen meestal buiten deze actie.",
  },
];

const schemas = [
  generateFAQPage(faqItems.map(i => ({ question: i.q, answer: i.a }))),
  generateBreadcrumbs(breadcrumbs),
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={`${siteConfig.url}/website-abonnement`}
  noindex={true}
  schemas={schemas}
  locale={locale}
>

  {/* ══════════════════════════════════════════════════
      1 · HERO
      ══════════════════════════════════════════════════ */}
  <section class="relative overflow-hidden bg-primary">
    <div class="absolute inset-0 hidden md:block">
      <Image
        src={heroPhoto}
        alt=""
        width={800}
        class="absolute right-0 top-0 h-full w-auto object-cover object-top opacity-[0.15]"
        loading="eager"
      />
    </div>

    <div class="relative px-5 md:px-6 pt-12 pb-14 md:pt-16 md:pb-20">
      <div class="max-w-2xl mx-auto">

        <h1 class="font-heading text-[1.85rem] leading-[1.12] md:text-[2.75rem] md:leading-[1.1] text-white mb-5">
          Je website staat online.<br />
          <em class="text-accent not-italic">Maar je concurrent krijgt de klant.</em>
        </h1>

        <p class="text-white/70 leading-relaxed mb-6 text-[0.95rem] md:text-base max-w-xl">
          Als Google, ChatGPT en bezoekers je concurrent sneller begrijpen dan jou, verlies je aanvragen zonder dat je het doorhebt.
        </p>

        <p class="text-white/90 leading-relaxed mb-8 text-[0.95rem] md:text-base max-w-xl font-medium">
          Wij vertalen je huidige site &mdash; aanbod, huisstijl, teksten en bewijs &mdash; naar een sneller AI-ready fundament dat gebouwd is om gevonden en gekozen te worden.
        </p>

        {/* Deal card */}
        <div class="bg-white/[0.12] backdrop-blur-sm border-2 border-accent/40 rounded-card p-5 md:p-6 mb-6 max-w-md shadow-lg">
          <p class="font-heading text-4xl md:text-5xl text-white mb-2">
            Vanaf &euro;79<span class="text-lg text-white/60 font-body">/mnd</span>
          </p>
          <div class="flex flex-wrap gap-2 mt-3">
            <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/20 text-accent rounded-full">Eerste 10 plekken deze maand</span>
            <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-white/10 text-white/80 rounded-full">Geen betaling nu</span>
          </div>
        </div>

        <a
          href="#aanvragen"
          class="inline-flex items-center gap-2 px-8 py-4 text-base font-medium text-white bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg w-full md:w-auto justify-center"
        >
          Check mijn site
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      2 · PROOF STRIP
      ══════════════════════════════════════════════════ */}
  <section class="bg-bg-alt border-b border-border/50 px-4 md:px-6 py-6 md:py-8">
    <div class="max-w-4xl mx-auto">
      <p class="text-xs uppercase tracking-widest text-text-muted font-medium text-center mb-4">Recent bewijs uit 2 nieuwe fundamenten</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
        <div class="flex items-start gap-3 bg-white border border-border rounded-card px-5 py-4">
          <span class="text-accent text-lg font-bold shrink-0 mt-0.5">#1</span>
          <div>
            <p class="text-text font-medium text-sm leading-snug">Costa Blanca: binnen 14 dagen zichtbaar in Google</p>
          </div>
        </div>
        <div class="flex items-start gap-3 bg-white border border-border rounded-card px-5 py-4">
          <span class="text-accent text-lg font-bold shrink-0 mt-0.5">#2</span>
          <div>
            <p class="text-text font-medium text-sm leading-snug">Dr. Verena Mann: 2 &rarr; 19 aanvragen/mnd + genoemd door ChatGPT</p>
          </div>
        </div>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      3 · GEEN WEBDESIGNER
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-12 md:py-16">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-3 text-center">
        Niet alleen een mooie site. Een site die klanten moet opleveren.
      </h2>
      <p class="text-text-muted text-center mb-8 md:mb-10 max-w-2xl mx-auto text-[0.95rem] leading-relaxed">
        Een klassieke websitebouwer denkt in pagina&rsquo;s en design. Wij kijken naar zoekintentie, vertrouwen, bewijs, CTA&rsquo;s en hoe Google, ChatGPT en klanten je bedrijf begrijpen.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6">
        <div class="border border-border rounded-card p-5 md:p-6 bg-white/50">
          <p class="text-text-muted text-xs uppercase tracking-widest font-medium mb-3">Klassieke websitebouwer</p>
          <ul class="space-y-2.5">
            {[
              'Mooie site, weinig aanvragen',
              'Denkt in pagina\'s en design',
              'SEO komt later',
              'Opleveren en klaar',
            ].map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-text-muted leading-relaxed">
                <svg class="w-4 h-4 text-red-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="border-2 border-accent/30 rounded-card p-5 md:p-6 bg-white shadow-lg relative">
          <span class="absolute -top-3 left-6 inline-block px-3 py-0.5 text-[0.65rem] font-medium tracking-widest uppercase bg-accent text-white rounded-full">
            NXG Media
          </span>
          <p class="text-text text-xs uppercase tracking-widest font-medium mb-3">AI-vindbaarheid &amp; conversie</p>
          <ul class="space-y-2.5">
            {[
              'Vindbaarheid + conversie als uitgangspunt',
              'Dienst + regio duidelijk neergezet',
              "Bewijs vóór de CTA",
              'Gebouwd voor Google, AI en klanten',
            ].map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-text leading-relaxed font-medium">
                <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <p class="text-text font-medium text-center text-[0.95rem] mt-8">
        De site is het middel. Meer aanvragen is het doel.
      </p>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      4 · NIET ALLES WEGGOOIEN
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-12 md:py-16 bg-bg-alt">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-3 text-center">
        Je hoeft niet alles weg te gooien. De basis moet beter.
      </h2>
      <p class="text-text-muted text-center mb-8 md:mb-10 max-w-2xl mx-auto text-[0.95rem] leading-relaxed">
        Je aanbod, huisstijl, reviews, foto&rsquo;s en bruikbare teksten nemen we mee. Wat onduidelijk, traag of niet overtuigend is, zetten we scherper neer.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">
        <div class="bg-white border border-border rounded-card p-5">
          <p class="font-heading text-lg text-text mb-1">Wat goed is, nemen we mee</p>
          <p class="text-text-muted text-sm leading-relaxed">
            Huisstijl, foto&rsquo;s, reviews en bruikbare teksten hoeven niet verloren te gaan.
          </p>
        </div>
        <div class="bg-white border border-border rounded-card p-5">
          <p class="font-heading text-lg text-text mb-1">Wat klanten en AI niet begrijpen, maken we scherper</p>
          <p class="text-text-muted text-sm leading-relaxed">
            Diensten, regio, bewijs en CTA&rsquo;s zodat je sneller als logische keuze overkomt.
          </p>
        </div>
        <div class="bg-white border border-border rounded-card p-5">
          <p class="font-heading text-lg text-text mb-1">Extra optimalisaties kunnen later</p>
          <p class="text-text-muted text-sm leading-relaxed">
            Blogs, lokale SEO en advertenties zijn later bij te boeken. Eerst het fundament.
          </p>
        </div>
      </div>

      <div class="text-center mt-8">
        <a
          href="#aanvragen"
          class="inline-flex items-center gap-2 px-7 py-3.5 text-sm font-medium text-text-inverse bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg"
        >
          Check mijn site
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      5 · PIJN / JE VERLIEST KLANTEN
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-12 md:py-16">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-3 text-center">
        Je verliest mogelijk nu al klanten aan een duidelijkere concurrent
      </h2>
      <p class="text-text font-medium text-center mb-8 md:mb-10 max-w-2xl mx-auto text-[0.95rem]">
        Je concurrent hoeft niet beter te zijn. Alleen duidelijker vindbaar.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6 mb-8">
        <div class="bg-bg-alt border border-border rounded-card p-5">
          <p class="font-heading text-lg text-text mb-1">Bezoekers klikken door</p>
          <p class="text-text-muted text-sm leading-relaxed">
            Als ze niet snel genoeg vertrouwen voelen, gaan ze naar de concurrent.
          </p>
        </div>
        <div class="bg-bg-alt border border-border rounded-card p-5">
          <p class="font-heading text-lg text-text mb-1">Google en AI kiezen de duidelijkste</p>
          <p class="text-text-muted text-sm leading-relaxed">
            Goed gestructureerde sites met heldere dienst- en regio-info worden vaker getoond.
          </p>
        </div>
        <div class="bg-bg-alt border border-border rounded-card p-5">
          <p class="font-heading text-lg text-text mb-1">&Eacute;&eacute;n extra klant verdient dit terug</p>
          <p class="text-text-muted text-sm leading-relaxed">
            Levert &eacute;&eacute;n klant jou &euro;500 op? Dan verdient &eacute;&eacute;n extra klant al ruim 6 maanden abonnement terug.
          </p>
        </div>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      6 · GEEN SEO-PLEISTERS
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-12 md:py-16 bg-bg-alt">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-3 text-center">
        Stop met SEO-pleisters plakken op een site die niet verkoopt
      </h2>
      <p class="text-text-muted text-center mb-8 md:mb-10 max-w-2xl mx-auto text-[0.95rem] leading-relaxed">
        Als de basis traag, rommelig of onduidelijk is, blijven losse SEO-updates beperkt. Eerst moet het fundament kloppen.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6">
        <div class="border border-border rounded-card p-5 md:p-6 bg-white/50">
          <p class="text-text-muted text-xs uppercase tracking-widest font-medium mb-3">Oude aanpak</p>
          <ul class="space-y-2.5">
            {[
              'Plugin erbij, tekstje aanpassen',
              'Maand later weer iets proberen',
              'Basis blijft hetzelfde',
            ].map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-text-muted leading-relaxed">
                <svg class="w-4 h-4 text-red-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="border-2 border-accent/30 rounded-card p-5 md:p-6 bg-white shadow-lg relative">
          <span class="absolute -top-3 left-6 inline-block px-3 py-0.5 text-[0.65rem] font-medium tracking-widest uppercase bg-accent text-white rounded-full">
            Nieuwe aanpak
          </span>
          <p class="text-text text-xs uppercase tracking-widest font-medium mb-3">AI-ready fundament</p>
          <ul class="space-y-2.5">
            {[
              'Huidige site vertalen naar helder fundament',
              'Dienst + regio duidelijk, bewijs op de juiste plek',
              'Klaar voor verdere optimalisatie',
            ].map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-text leading-relaxed font-medium">
                <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="text-center mt-8">
        <a
          href="#aanvragen"
          class="inline-flex items-center gap-2 px-7 py-3.5 text-sm font-medium text-text-inverse bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg"
        >
          Check mijn site
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      7 · BEWIJS / CASES
      ══════════════════════════════════════════════════ */}
  <section class="py-16 md:py-24 bg-primary">
    <div class="max-w-5xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-3xl md:text-4xl text-white mb-3 text-center">
        Dit is wat er kan gebeuren als het fundament klopt
      </h2>
      <p class="text-white/60 text-center mb-12 md:mb-16 max-w-xl mx-auto text-[0.95rem]">
        Onze laatste 2 nieuwe fundamenten werden binnen 2 weken zichtbaar in Google of AI.
      </p>

      {/* ── CASE 1: CBMC ── */}
      <div class="bg-white/5 backdrop-blur border-2 border-accent/30 rounded-card p-5 md:p-8 mb-10">
        <div class="flex items-center gap-4 mb-5">
          <div class="w-12 h-12 rounded-full overflow-hidden ring-2 ring-accent/30 shrink-0">
            <Image
              src={jamesPhoto}
              alt="Dr. James Mitchell"
              widths={[56, 112]}
              sizes="56px"
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div>
            <p class="text-white font-medium text-sm">Dr. James Mitchell</p>
            <a href="https://www.costablancamovement.com" target="_blank" rel="noopener" class="text-accent/70 hover:text-accent text-xs transition-colors">costablancamovement.com</a>
          </div>
        </div>

        <h3 class="font-heading text-2xl md:text-3xl text-white mb-1">Van nul naar zichtbaar in 14 dagen</h3>
        <p class="text-white/50 text-sm mb-5">Chiropraktijk voor expats in Torrevieja. Geen site, geen historie, geen backlinks.</p>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
          <div class="bg-white/5 rounded-card p-3 text-center">
            <p class="font-heading text-xl md:text-2xl text-accent">pag.&nbsp;1</p>
            <p class="text-white/50 text-xs mt-0.5">in Google</p>
          </div>
          <div class="bg-white/5 rounded-card p-3 text-center">
            <p class="font-heading text-xl md:text-2xl text-accent">ChatGPT</p>
            <p class="text-white/50 text-xs mt-0.5">noemt kliniek</p>
          </div>
          <div class="bg-white/5 rounded-card p-3 text-center">
            <p class="font-heading text-xl md:text-2xl text-accent">12&ndash;15</p>
            <p class="text-white/50 text-xs mt-0.5">pati&euml;nten/mnd</p>
          </div>
          <div class="bg-white/5 rounded-card p-3 text-center">
            <p class="font-heading text-xl md:text-2xl text-accent">800+</p>
            <p class="text-white/50 text-xs mt-0.5">bezoekers/mnd</p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
          <button type="button" class="proof-trigger cursor-pointer group text-left">
            <div class="bg-black/40 border border-white/10 rounded-lg overflow-hidden">
              <Image src={proofGoogle} alt="Google zoekresultaat: Costa Blanca Movement Centre op pagina 1 na 2 weken" width={1200} quality={85} class="w-full h-auto" loading="lazy" />
            </div>
            <p class="text-white/40 text-xs mt-1.5 text-center group-hover:text-white/60 transition-colors">Google pagina 1 &mdash; na 2 weken</p>
          </button>
          <button type="button" class="proof-trigger cursor-pointer group text-left">
            <div class="bg-black/40 border border-white/10 rounded-lg overflow-hidden">
              <Image src={proofChatgpt} alt="ChatGPT beveelt Costa Blanca Movement Centre aan als nummer 1 lokale optie" width={1200} quality={85} class="w-full h-auto" loading="lazy" />
            </div>
            <p class="text-white/40 text-xs mt-1.5 text-center group-hover:text-white/60 transition-colors">ChatGPT beveelt de kliniek aan als #1</p>
          </button>
        </div>

        <p class="text-accent font-medium text-center text-base pt-4 border-t border-white/10">
          Niet na een jaar SEO. Na 14 dagen werd het fundament al opgepikt.
        </p>
      </div>

      {/* ── CASE 2: Dr. Verena Mann ── */}
