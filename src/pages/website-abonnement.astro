---
/**
 * Founding Deal — /website-abonnement/
 * Offer-led landing page for €79/month AI-ready website subscription.
 * noindex — ads lander for test. No links to other offer pages.
 */
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import { siteConfig } from '../data/site';
import { generateFAQPage, generateBreadcrumbs } from '../data/schema';

import heroPhoto from '../assets/images/founder/joost-standing-relaxed.webp';
import proofGoogle from '../assets/images/cases/proof-google-torrevieja.png';
import proofChatgpt from '../assets/images/cases/proof-chatgpt-local.png';

const locale = 'nl';
const title = 'Nieuwe AI-ready website — Founding Deal vanaf €79/mnd | NXG Media';
const description = 'Founding Deal: nieuwe AI-ready website gratis inbegrepen bij een abonnement vanaf €79/maand. Snel, vindbaar, met beheerpaneel. Beperkte plekken.';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Website Abonnement' },
];

const faqItems = [
  {
    q: 'Ik heb al een website. Wat gebeurt daarmee?',
    a: 'Je content nemen we over naar het nieuwe fundament. Je bestaande site blijft online tot de nieuwe klaar is.',
  },
  {
    q: 'Kan ik zelf aanpassen?',
    a: 'Ja. Je krijgt een beheerpaneel voor teksten, foto’s, diensten en prijzen. Geen code nodig. Geen afhankelijkheid.',
  },
  {
    q: 'Wat als ik wil stoppen?',
    a: 'Na 12 maanden ben je vrij. De site en alle bestanden zijn van jou — je kunt zelf hosten of bij mij blijven.',
  },
  {
    q: 'Wat zit er niet in?',
    a: 'Extra pagina’s, blogcontent, advertenties, uitgebreide SEO-optimalisatie en strategische begeleiding zijn apart bij te boeken. Het abonnement is het fundament — uitbreidingen kies je zelf.',
  },
];

const schemas = [
  generateFAQPage(faqItems.map(i => ({ question: i.q, answer: i.a }))),
  generateBreadcrumbs(breadcrumbs),
];

const features = [
  { title: 'Nieuwe snelle website', desc: 'Waarde €2.000–€4.000 — gratis inbegrepen bij 12 maanden' },
  { title: 'Snel en mobiel-vriendelijk', desc: 'Laadtijd onder 2 seconden. Geen WordPress, geen plugins, geen ballast.' },
  { title: 'Vindbaar voor Google en AI', desc: 'Basis SEO-structuur, schema markup, AI-leesbare opbouw.' },
  { title: 'Beheerpaneel', desc: 'Zelf teksten, foto’s, diensten en prijzen aanpassen. Geen code nodig.' },
  { title: 'Hosting en onderhoud', desc: 'Snelle hosting, technisch onderhoud, SSL — alles inbegrepen.' },
  { title: 'Maandelijkse check', desc: 'Elke maand controleren we of je fundament technisch goed staat.' },
];

const pricingFeatures = [
  'Nieuwe AI-ready website (waarde €2.000–€4.000)',
  'Hosting en technisch onderhoud',
  'Beheerpaneel voor zelf aanpassen',
  'Basis SEO en AI-structuur',
  'Maandelijkse technische check',
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={`${siteConfig.url}/website-abonnement`}
  noindex={true}
  schemas={schemas}
  locale={locale}
>

  {/* ── SECTIE 1: HERO — HET AANBOD ── */}
  <section class="relative overflow-hidden">
    {/* Subtle background photo */}
    <div class="absolute inset-0 hidden md:block">
      <Image
        src={heroPhoto}
        alt=""
        width={800}
        class="absolute right-0 top-0 h-full w-auto object-cover object-top opacity-[0.07]"
        loading="eager"
      />
    </div>

    <div class="relative px-4 md:px-6 pt-8 pb-12 md:pt-14 md:pb-20">
      <div class="max-w-2xl mx-auto">
        <span class="inline-block px-4 py-1.5 text-xs font-medium tracking-widest uppercase bg-accent/10 text-accent rounded-full mb-6">
          Founding Deal &mdash; beperkte plekken
        </span>

        <h1 class="font-heading text-[1.85rem] leading-[1.12] md:text-[2.75rem] md:leading-[1.1] text-text mb-5">
          Nieuwe AI-ready website.<br />
          <em class="text-accent not-italic">Gratis inbegrepen.</em>
        </h1>

        <p class="text-text-muted leading-relaxed mb-4 text-[0.95rem] md:text-base max-w-xl">
          Zodat Google, ChatGPT en je klanten sneller begrijpen
          waarom jij de logische keuze bent.
        </p>

        <p class="text-text-muted leading-relaxed mb-6 text-[0.95rem] md:text-base max-w-xl">
          Geen dure websitebouw. Geen technisch gedoe.
          We zetten deze maand een snel, vindbaar en toekomstbestendig
          online fundament voor je klaar.
        </p>

        <p class="text-text font-heading text-3xl md:text-4xl mb-6">
          Vanaf <strong class="text-accent">€79</strong><span class="text-lg text-text-muted">/maand</span>
        </p>

        <a
          href="#aanvragen"
          class="inline-flex items-center gap-2 px-8 py-4 text-base font-medium text-text-inverse bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg w-full md:w-auto justify-center"
        >
          Check of jouw site in aanmerking komt
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>

        <p class="text-xs text-text-muted mt-4 max-w-md">
          Gratis website inbegrepen &middot; Niet elke site past &middot;
          Beperkt aantal plekken deze maand
        </p>
      </div>
    </div>
  </section>


  {/* ── SECTIE 2: WAT JE KRIJGT ── */}
  <section class="px-4 md:px-6 py-14 md:py-20 border-t border-border/50">
    <div class="max-w-3xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-8 md:mb-10 text-center">
        Dit zit erin
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6">
        {features.map((f) => (
          <div class="flex items-start gap-3">
            <svg class="w-5 h-5 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <div>
              <p class="font-medium text-text text-[0.95rem] leading-snug">{f.title}</p>
              <p class="text-text-muted text-sm leading-relaxed mt-0.5">{f.desc}</p>
            </div>
          </div>
        ))}
      </div>

      {/* Expandable: wat zit er niet in */}
      <details class="mt-8 border border-border rounded-card overflow-hidden group">
        <summary class="flex items-center justify-between gap-4 px-5 py-4 cursor-pointer list-none text-text-muted hover:text-text transition-colors text-sm font-medium">
          Wat zit er niet standaard in?
          <svg
            class="w-4 h-4 shrink-0 transition-transform duration-200 group-open:rotate-45"
            fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
        </summary>
        <div class="px-5 pb-5 text-sm text-text-muted leading-relaxed">
          <p>
            Extra dienstpagina&rsquo;s, blogcontent, lokale SEO-content, advertenties,
            uitgebreide copywriting, fotografie, conversie-optimalisatie en
            maandelijkse strategische begeleiding zijn apart bij te boeken.
            Zo betaal je alleen voor wat je nodig hebt.
          </p>
        </div>
      </details>
    </div>
  </section>


  {/* ── SECTIE 3: BEWIJS — donkere band ── */}
  <section class="bg-primary px-4 md:px-6 py-14 md:py-20">
    <div class="max-w-3xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-white mb-3 text-center">
        Na 2 weken al op Google pagina 1.
      </h2>

      <p class="text-white/70 text-center mb-8 md:mb-10 max-w-lg mx-auto text-[0.95rem] leading-relaxed">
        Costa Blanca Movement Centre &mdash; van nul naar vindbaar in 14 dagen.
        Gebouwd op hetzelfde fundament.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6">
        {/* Google screenshot */}
        <button
          type="button"
          class="proof-trigger group cursor-pointer block rounded-image overflow-hidden border border-white/10 hover:border-white/30 transition-colors"
          data-proof="proof-google"
        >
          <Image
            src={proofGoogle}
            alt="Google zoekresultaat: Costa Blanca Movement Centre op positie 4 na 2 weken"
            width={600}
            quality={85}
            class="w-full h-auto"
            loading="lazy"
          />
          <p class="text-white/50 text-xs text-center py-2">Google positie 4 &mdash; na 2 weken</p>
        </button>

        {/* ChatGPT screenshot */}
        <button
          type="button"
          class="proof-trigger group cursor-pointer block rounded-image overflow-hidden border border-white/10 hover:border-white/30 transition-colors"
          data-proof="proof-chatgpt"
        >
          <Image
            src={proofChatgpt}
            alt="ChatGPT noemt Costa Blanca Movement Centre als eerste lokale aanbeveling"
            width={600}
            quality={85}
            class="w-full h-auto"
            loading="lazy"
          />
          <p class="text-white/50 text-xs text-center py-2">ChatGPT #1 lokale aanbeveling</p>
        </button>
      </div>

      <p class="text-white/40 text-xs text-center mt-5">
        Gebouwd op hetzelfde fundament. Zelfde technologie, zelfde aanpak.
      </p>
    </div>
  </section>

  {/* Lightbox overlay */}
  <div id="proof-lightbox" class="fixed inset-0 z-50 hidden items-center justify-center bg-black/90 p-4 md:p-8" role="dialog" aria-label="Screenshot vergroting">
    <button type="button" id="proof-close" class="absolute top-4 right-4 text-white/70 hover:text-white text-3xl leading-none z-10" aria-label="Sluiten">&times;</button>
    <img id="proof-img" src="" alt="" class="max-h-[90vh] max-w-full rounded-image" />
  </div>


  {/* ── SECTIE 4: PRICING CARD ── */}
  <section class="px-4 md:px-6 py-14 md:py-20">
    <div class="max-w-xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-8 md:mb-10 text-center">
        De investering
      </h2>

      {/* Single pricing card */}
      <div class="bg-white border-2 border-accent/30 rounded-card p-8 md:p-10 shadow-lg text-center">
        <span class="inline-block px-3 py-1 text-xs font-medium tracking-widest uppercase bg-accent/10 text-accent rounded-full mb-4">
          Founding Deal
        </span>

        <h3 class="font-heading text-xl md:text-2xl text-text mb-4">
          AI-Ready Website Abonnement
        </h3>

        <p class="font-heading text-5xl md:text-6xl text-text mb-1">
          &euro;79<span class="text-lg text-text-muted font-body">/maand</span>
        </p>
        <p class="text-sm text-text-muted mb-6">
          12 maanden &middot; Gratis website inbegrepen
        </p>

        <ul class="text-left space-y-3 mb-8">
          {pricingFeatures.map((f) => (
            <li class="flex items-start gap-3 text-[0.95rem] text-text-muted leading-relaxed">
              <svg class="w-5 h-5 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              {f}
            </li>
          ))}
        </ul>

        <a
          href="#aanvragen"
          class="inline-flex items-center gap-2 px-8 py-4 text-base font-medium text-text-inverse bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg w-full justify-center"
        >
          Check of jouw site in aanmerking komt
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>

        <p class="text-xs text-text-muted mt-4">
          Totaal: &euro;948/jaar &middot; Geen verborgen kosten &middot;
          Website is altijd van jou
        </p>
      </div>

      {/* Context below card */}
      <div class="mt-6 space-y-2 text-center">
        <p class="text-xs text-text-muted">
          Ter vergelijking: een nieuwe website laten bouwen
          kost normaal &euro;3.000&ndash;&euro;5.000. Plus &euro;50&ndash;&euro;150/maand hosting.
          Plus losse SEO-kosten.
        </p>
        <p class="text-xs text-text-muted">
          Beperkte plekken: we bouwen deze sites op een
          gestandaardiseerd fundament. Daarom kunnen we de eerste groep
          goedkoper helpen &mdash; in ruil voor feedback en toestemming om
          resultaten te gebruiken.
        </p>
      </div>
    </div>
  </section>


  {/* ── SECTIE 5: FORMULIER ── */}
  <section id="aanvragen" class="bg-primary px-4 md:px-6 py-14 md:py-20">
    <div class="max-w-lg mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-white mb-3 text-center">
        Komt jouw site in aanmerking?
      </h2>

      <p class="text-white/70 text-center mb-8 text-[0.95rem] leading-relaxed">
        Niet elke site past bij dit abonnement. Vul je gegevens in &mdash;
        ik bekijk je site en laat binnen 24 uur weten of het past
        en hoe de volgende stap eruitziet.
      </p>

      <form id="founding-deal-form" class="space-y-3">
        <input type="hidden" name="bron" value="founding-deal" />
        <input
          type="text"
          name="naam"
          placeholder="Je naam"
          required
          autocomplete="name"
          class="w-full px-4 py-3.5 rounded-button border border-white/20 bg-white/10 text-sm text-white placeholder:text-white/40 focus:outline-none focus:ring-2 focus:ring-accent/50"
        />
        <input
          type="text"
          name="bedrijf"
          placeholder="Bedrijfsnaam"
          required
          autocomplete="organization"
          class="w-full px-4 py-3.5 rounded-button border border-white/20 bg-white/10 text-sm text-white placeholder:text-white/40 focus:outline-none focus:ring-2 focus:ring-accent/50"
        />
        <input
          type="url"
          name="website"
          placeholder="https://jouwwebsite.nl"
          required
          autocomplete="url"
          class="w-full px-4 py-3.5 rounded-button border border-white/20 bg-white/10 text-sm text-white placeholder:text-white/40 focus:outline-none focus:ring-2 focus:ring-accent/50"
        />
        <input
          type="email"
          name="email"
          placeholder="je@email.nl"
          required
          autocomplete="email"
          class="w-full px-4 py-3.5 rounded-button border border-white/20 bg-white/10 text-sm text-white placeholder:text-white/40 focus:outline-none focus:ring-2 focus:ring-accent/50"
        />
        <input
          type="tel"
          name="telefoon"
          placeholder="Telefoonnummer (optioneel)"
          autocomplete="tel"
          class="w-full px-4 py-3.5 rounded-button border border-white/20 bg-white/10 text-sm text-white placeholder:text-white/40 focus:outline-none focus:ring-2 focus:ring-accent/50"
        />
        <button
          type="submit"
          class="w-full px-8 py-4 text-base font-medium text-text-inverse bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg flex items-center justify-center gap-2"
        >
          Check of ik in aanmerking kom
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </button>
      </form>

      {/* Inline thank-you message (hidden by default) */}
      <div id="founding-deal-thanks" class="hidden text-center py-8">
        <svg class="w-12 h-12 text-accent mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <p class="text-white font-heading text-xl mb-2">Bedankt!</p>
        <p class="text-white/70 text-[0.95rem]">
          Ik bekijk je site en laat binnen 24 uur weten of je in aanmerking komt.
        </p>
      </div>

      <p id="founding-deal-microcopy" class="text-xs text-white/50 text-center mt-4">
        Geen betaling. Geen verplichting.
        Ik check eerst of je site geschikt is.
      </p>
    </div>
  </section>


  {/* ── SECTIE 6: FAQ ── */}
  <FAQAccordion
    title="Veelgestelde vragen"
    items={faqItems}
    locale={locale}
    pageType="page"
    pageSlug="website-abonnement"
    compact={true}
  />

</BaseLayout>


{/* ── Lightbox script ── */}
<script is:inline>
(function() {
  var lb = document.getElementById('proof-lightbox');
  var lbImg = document.getElementById('proof-img');
  var lbClose = document.getElementById('proof-close');
  if (!lb || !lbImg) return;

  // Map proof buttons to their full-res image src
  document.querySelectorAll('.proof-trigger').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var img = btn.querySelector('img');
      if (!img) return;
      // Use the rendered src (already optimized by Astro)
      lbImg.src = img.src;
      lbImg.alt = img.alt;
      lb.classList.remove('hidden');
      lb.classList.add('flex');
      document.body.style.overflow = 'hidden';
    });
  });

  function closeLb() {
    lb.classList.add('hidden');
    lb.classList.remove('flex');
    lbImg.src = '';
    document.body.style.overflow = '';
  }

  if (lbClose) lbClose.addEventListener('click', closeLb);
  lb.addEventListener('click', function(e) {
    if (e.target === lb) closeLb();
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && !lb.classList.contains('hidden')) closeLb();
  });
})();
</script>


{/* ── Form handling: POST to scanner API, fire Meta Lead, inline thank-you ── */}
<script is:inline>
(function() {
  var form = document.getElementById('founding-deal-form');
  var thanks = document.getElementById('founding-deal-thanks');
  var microcopy = document.getElementById('founding-deal-microcopy');
  if (!form || !thanks) return;

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    var data = new FormData(form);
    var naam = data.get('naam');
    var email = data.get('email');
    var website = data.get('website');
    var bedrijf = data.get('bedrijf');
    var telefoon = data.get('telefoon') || '';

    if (!naam || !email || !website || !bedrijf) return;

    // Disable button
    var btn = form.querySelector('button[type="submit"]');
    if (btn) { btn.disabled = true; btn.textContent = 'Even geduld…'; }

    var payload = {
      naam: naam,
      email: email,
      websiteUrl: website,
      vraag: 'Founding Deal aanvraag — Bedrijf: ' + bedrijf + (telefoon ? ' — Tel: ' + telefoon : ''),
      source: 'founding-deal',
    };

    // Fire Meta Pixel Lead event (if loaded after consent)
    if (typeof fbq === 'function') {
      fbq('track', 'Lead', { content_name: 'founding-deal', content_category: 'website-abonnement' });
    }

    // Fire GA4 event
    if (typeof trackEvent === 'function') {
      trackEvent('scanner_request_submitted', {
        page_type: 'page',
        page_slug: 'website-abonnement',
        locale: 'nl',
        cta_location: 'inline',
      });
    }

    fetch('https://scanner.nxg-media.com/api/gratis-check', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(payload),
    }).then(function() {
      showThanks();
    }).catch(function() {
      // Even on error, show thanks — we don't want to lose the visitor
      showThanks();
    });

    function showThanks() {
      form.classList.add('hidden');
      thanks.classList.remove('hidden');
      if (microcopy) microcopy.classList.add('hidden');
    }
  });
})();
</script>
