---
/**
 * AI-ready Website Actie — /website-abonnement/
 * Direct-response landing page. Translate existing site to AI-ready foundation.
 * noindex — ads lander. No links to other offer pages.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import { siteConfig } from '../data/site';
import { generateFAQPage, generateBreadcrumbs } from '../data/schema';

import heroPhoto from '../assets/images/founder/joost-standing-relaxed.webp';
import keystaticDashboard from '../assets/images/keystatic1.png';
import keystaticHomepage from '../assets/images/keystatic_edit_homepage.png';
import keystaticBlog from '../assets/images/keystatic_add_blog.png';

const cmsScreenshots = [
  { src: keystaticDashboard, alt: 'Beheerpaneel met overzicht van alle pagina\'s, blogs, diensten en producten', caption: 'Alles op één plek' },
  { src: keystaticHomepage, alt: 'Homepage teksten aanpassen via eenvoudige invoervelden', caption: 'Teksten aanpassen — geen code nodig' },
  { src: keystaticBlog, alt: 'Blog schrijven met opmaak toolbar en SEO-velden', caption: 'Zelf blogartikelen publiceren' },
];
import proofGoogle from '../assets/images/cases/proof-google-torrevieja.png';
import proofChatgpt from '../assets/images/cases/proof-chatgpt-local.png';
import proofVerenaAi from '../assets/images/cases/doc_veri_ai_answer_cropped.PNG';
import proofVerenaChatgpt from '../assets/images/cases/doc-veri-chatgptproof.jpeg';
import verenaPhoto from '../assets/images/cases/verena-mann-linkedin.webp';
import jamesPhoto from '../assets/images/cases/james-mitchell-portrait.png';

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logos/*.{webp,avif,png,jpg}', { eager: true });
const logos = Object.entries(logoFiles)
  .filter(([path]) => /logo/i.test(path.split('/').pop()!))
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/, '');
    const name = filename.replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim();
    return { src: mod.default, alt: name };
  });

const locale = 'nl';
const title = 'AI-ready Website Actie — vanaf €79/mnd | NXG Media';
const description = 'Je huidige website omzetten naar een AI-ready klantfundament dat Google, ChatGPT en klanten begrijpen. Vanaf €79/mnd. Eerste 10 plekken deze maand.';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Website Abonnement' },
];

const faqItems = [
  {
    q: 'Moet mijn hele website opnieuw?',
    a: "Het uitgangspunt is juist dat we meenemen wat bruikbaar is: je aanbod, huisstijl, teksten, foto's en bewijs. We zetten het opnieuw neer op een sneller en duidelijker fundament.",
  },
  {
    q: 'Waarom kan dit voor €79/mnd?',
    a: "Omdat we niet vanaf nul een volledig maatwerkproject bouwen. We werken met een strak fundament en vertalen je bestaande site naar een betere basis.",
  },
  {
    q: "Wat als ik extra pagina's of SEO-content wil?",
    a: "Dat kan later. Extra dienstpagina's, blogs, lokale content, advertenties en uitgebreide optimalisatie zijn apart bij te boeken. Eerst zorgen we dat het fundament klopt.",
  },
  {
    q: 'Waarom 12 maanden?',
    a: "Website, hosting, onderhoud en maandelijkse vindbaarheidscheck zitten in één abonnement. Geen groot bedrag vooraf, wel een fundament dat blijft draaien en onderhouden wordt.",
  },
  {
    q: 'Ben ik mijn oude content kwijt?',
    a: "Nee. Wat bruikbaar is, nemen we mee. Wat onduidelijk, traag of niet converterend is, maken we scherper.",
  },
  {
    q: 'Is dit voor elk bedrijf?',
    a: "Vooral voor lokale dienstverleners, praktijken en specialisten met een duidelijke dienst. Webshops en complexe maatwerksites vallen meestal buiten deze actie.",
  },
];

const schemas = [
  generateFAQPage(faqItems.map(i => ({ question: i.q, answer: i.a }))),
  generateBreadcrumbs(breadcrumbs),
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={`${siteConfig.url}/website-abonnement`}
  noindex={true}
  schemas={schemas}
  locale={locale}
>

  {/* ══════════════════════════════════════════════════
      1 · HERO
      ══════════════════════════════════════════════════ */}
  <section class="relative overflow-hidden bg-primary">
    <div class="absolute inset-0">
      <Image
        src={heroPhoto}
        alt=""
        width={800}
        class="absolute right-0 top-0 h-full w-auto object-cover object-top opacity-[0.12] md:opacity-[0.18]"
        loading="eager"
      />
    </div>

    <div class="relative px-4 md:px-6 pt-10 pb-12 md:pt-16 md:pb-20">
      <div class="max-w-2xl mx-auto">

        <h1 class="font-heading text-[1.85rem] leading-[1.12] md:text-[2.75rem] md:leading-[1.1] text-white mb-5">
          Je website staat online.<br />
          <em class="text-accent not-italic">Maar je concurrent krijgt de klant.</em>
        </h1>

        <p class="text-white/70 leading-relaxed mb-5 text-[0.95rem] md:text-base max-w-xl">
          Veel ondernemers hebben een website die er prima uitziet, maar nauwelijks aanvragen oplevert.
          Niet omdat hun bedrijf slecht is, maar omdat Google, ChatGPT en bezoekers hun concurrent sneller begrijpen.
        </p>

        <p class="text-white/90 leading-relaxed mb-8 text-[0.95rem] md:text-base max-w-xl font-medium">
          Wij gooien je huidige site niet zomaar weg. We vertalen wat er al is &mdash; je aanbod, huisstijl, teksten, foto&rsquo;s en bewijs &mdash; naar een sneller AI-ready fundament dat gebouwd is om gevonden, begrepen en gekozen te worden.
        </p>

        {/* Price block */}
        <div class="bg-white/10 backdrop-blur border border-white/20 rounded-card p-5 md:p-6 mb-8 max-w-md">
          <p class="font-heading text-4xl md:text-5xl text-white mb-2">
            &euro;79<span class="text-lg text-white/60 font-body">/mnd</span>
          </p>
          <ul class="space-y-1.5">
            <li class="flex items-center gap-2 text-sm">
              <span class="text-accent">&rarr;</span>
              <span class="text-white/80">Geen duizenden euro&rsquo;s vooraf</span>
            </li>
            <li class="flex items-center gap-2 text-sm">
              <span class="text-accent">&rarr;</span>
              <span class="text-white/80">Eerste 10 plekken deze maand</span>
            </li>
            <li class="flex items-center gap-2 text-sm">
              <span class="text-accent">&rarr;</span>
              <span class="text-white/80">Bestaande content waar mogelijk meegenomen</span>
            </li>
          </ul>
        </div>

        {/* Proof line */}
        <div class="bg-accent/15 border border-accent/30 rounded-button px-4 py-3 mb-8 max-w-md">
          <p class="text-sm text-white font-medium leading-snug">
            <span class="text-accent mr-1.5">&rarr;</span>
            Onze laatste 2 nieuwe fundamenten werden binnen 2 weken zichtbaar in Google of AI.
          </p>
        </div>

        <a
          href="#aanvragen"
          class="inline-flex items-center gap-2 px-8 py-4 text-base font-medium text-white bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg w-full md:w-auto justify-center"
        >
          Check of mijn site geschikt is
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>

        <p class="text-xs text-white/40 mt-4 max-w-md">
          Geen betaling nu &middot; Je ontvangt eerst een voorstel &middot; Alleen voor bedrijven die binnen deze aanpak passen
        </p>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      1b · PROOF STRIP
      ══════════════════════════════════════════════════ */}
  <section class="bg-bg-alt border-b border-border/50 px-4 md:px-6 py-6 md:py-8">
    <div class="max-w-4xl mx-auto">
      <p class="text-xs uppercase tracking-widest text-text-muted font-medium text-center mb-4">Recent bewijs</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
        <div class="flex items-start gap-3 bg-white border border-border rounded-card px-5 py-4">
          <span class="text-accent text-lg font-bold shrink-0 mt-0.5">#1</span>
          <div>
            <p class="text-text font-medium text-sm leading-snug">Costa Blanca Movement Centre</p>
            <p class="text-text-muted text-sm leading-relaxed mt-1">Binnen 14 dagen pagina 1 in Google. Na 2 maanden 12&ndash;15 pati&euml;nten/mnd online.</p>
          </div>
        </div>
        <div class="flex items-start gap-3 bg-white border border-border rounded-card px-5 py-4">
          <span class="text-accent text-lg font-bold shrink-0 mt-0.5">#2</span>
          <div>
            <p class="text-text font-medium text-sm leading-snug">Dr. Verena Mann</p>
            <p class="text-text-muted text-sm leading-relaxed mt-1">Van 2 naar 19 aanvragen/mnd. Genoemd door ChatGPT als passende expert.</p>
          </div>
        </div>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      2 · MARKETEER, GEEN WEBDESIGNER
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-14 md:py-20">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-2 text-center">
        Geen webdesigner die toevallig iets van marketing weet.
      </h2>
      <p class="text-accent font-medium text-center mb-4 text-[0.95rem]">
        Een online marketeer die je huidige site vertaalt naar een groeikanaal.
      </p>
      <p class="text-text-muted text-center mb-3 max-w-2xl mx-auto text-[0.95rem] leading-relaxed">
        Een klassieke websitebouwer kijkt vooral naar design, pagina&rsquo;s en techniek.
        Maar een mooie site zonder aanvragen lost niets op.
      </p>
      <p class="text-text-muted text-center mb-10 md:mb-12 max-w-2xl mx-auto text-[0.95rem] leading-relaxed">
        Wij kijken anders: waar zoekt je ideale klant naar? Wat moet iemand geloven voordat hij contact opneemt?
        Welke bewijzen moeten zichtbaar zijn? Welke CTA moet waar staan?
        En hoe maken we je bedrijf begrijpelijk voor Google &eacute;n AI?
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6">
        {/* Klassieke websitebouwer */}
        <div class="border border-border rounded-card p-6 md:p-8 bg-white/50">
          <p class="text-text-muted text-xs uppercase tracking-widest font-medium mb-4">Klassieke websitebouwer</p>
          <ul class="space-y-3">
            {[
              'Bouwt een site die er goed uitziet',
              'Denkt in pagina\'s en design',
              'Maakt teksten netjes',
              'Levert op en verdwijnt',
              'SEO komt later als losse update',
            ].map((item) => (
              <li class="flex items-start gap-3 text-sm text-text-muted leading-relaxed">
                <svg class="w-4 h-4 text-red-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        {/* NXG Media */}
        <div class="border-2 border-accent/30 rounded-card p-6 md:p-8 bg-white shadow-lg relative">
          <span class="absolute -top-3 left-6 inline-block px-3 py-0.5 text-[0.65rem] font-medium tracking-widest uppercase bg-accent text-white rounded-full">
            NXG Media
          </span>
          <p class="text-text text-xs uppercase tracking-widest font-medium mb-4">Online marketeer</p>
          <ul class="space-y-3">
            {[
              'Vertaalt je bestaande site naar een klantfundament',
              'Denkt in zoekintentie, vertrouwen en conversie',
              'Neemt bruikbare content en huisstijl mee',
              "Zet bewijs en CTA's op de juiste plek",
              'Bouwt voor Google, ChatGPT en klanten',
              'Maakt de basis klaar voor verdere optimalisatie',
            ].map((item) => (
              <li class="flex items-start gap-3 text-sm text-text leading-relaxed font-medium">
                <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <p class="text-text font-medium text-center text-[0.95rem] mt-10">
        De site is het middel. Meer klanten is het doel.
      </p>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      3 · NIET ALLES WEGGOOIEN
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-14 md:py-20 bg-bg-alt">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-4 text-center">
        Je hoeft niet alles weg te gooien. De basis moet beter.
      </h2>
      <p class="text-text-muted text-center mb-3 max-w-2xl mx-auto text-[0.95rem] leading-relaxed">
        Veel ondernemers hebben al een website waar tijd, geld en aandacht in zit.
        Het probleem is meestal niet dat alles waardeloos is. Het probleem is dat de basis niet duidelijk genoeg is voor hoe klanten, Google en AI nu beslissen.
      </p>
      <p class="text-text text-center mb-10 md:mb-12 max-w-2xl mx-auto text-[0.95rem] leading-relaxed font-medium">
        Daarom vertalen we je huidige website naar een sneller, duidelijker en beter vindbaar fundament.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
        <div class="bg-white border border-border rounded-card p-6">
          <p class="font-heading text-lg text-text mb-2">Wat goed is, nemen we mee</p>
          <p class="text-text-muted text-sm leading-relaxed">
            Je aanbod, huisstijl, foto&rsquo;s, reviews en bruikbare teksten hoeven niet verloren te gaan.
          </p>
        </div>
        <div class="bg-white border border-border rounded-card p-6">
          <p class="font-heading text-lg text-text mb-2">Wat klanten en AI niet begrijpen, maken we scherper</p>
          <p class="text-text-muted text-sm leading-relaxed">
            We herstructureren je diensten, regio, bewijs en CTA&rsquo;s zodat je sneller als logische keuze overkomt.
          </p>
        </div>
        <div class="bg-white border border-border rounded-card p-6">
          <p class="font-heading text-lg text-text mb-2">Daarna kun je uitbreiden</p>
          <p class="text-text-muted text-sm leading-relaxed">
            Extra dienstpagina&rsquo;s, blogs, lokale SEO, advertenties en optimalisaties kunnen later. Eerst moet het fundament kloppen.
          </p>
        </div>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      4 · PIJN / FOMO
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-14 md:py-20">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-3 text-center">
        Je verliest mogelijk nu al klanten aan een duidelijkere concurrent
      </h2>
      <p class="text-text font-medium text-center mb-3 max-w-2xl mx-auto text-[0.95rem]">
        Je concurrent hoeft niet beter te zijn. Alleen duidelijker vindbaar.
      </p>
      <p class="text-text-muted text-center mb-10 md:mb-12 max-w-2xl mx-auto text-[0.95rem] leading-relaxed">
        Als jouw site vaag, traag of rommelig is, kiezen Google, ChatGPT en bezoekers sneller voor iemand anders.
        Niet omdat die beter is, maar omdat die online makkelijker te begrijpen is.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8 mb-10">
        <div class="bg-bg-alt border border-border rounded-card p-6">
          <p class="font-heading text-lg text-text mb-2">Bezoekers klikken door</p>
          <p class="text-text-muted text-sm leading-relaxed">
            Als ze niet snel genoeg vertrouwen voelen, gaan ze naar de concurrent die dat w&eacute;l duidelijk maakt.
          </p>
        </div>
        <div class="bg-bg-alt border border-border rounded-card p-6">
          <p class="font-heading text-lg text-text mb-2">Google en AI geven voorkeur aan duidelijke sites</p>
          <p class="text-text-muted text-sm leading-relaxed">
            Goed gestructureerde, snelle websites met heldere dienst- en regio-informatie worden vaker getoond en aanbevolen.
          </p>
        </div>
        <div class="bg-bg-alt border border-border rounded-card p-6">
          <p class="font-heading text-lg text-text mb-2">&Eacute;&eacute;n extra klant verdient dit terug</p>
          <p class="text-text-muted text-sm leading-relaxed">
            Bij &euro;79/mnd hoeft dit geen groot risico te zijn. &Eacute;&eacute;n extra aanvraag of klant kan het verschil al maken.
          </p>
        </div>
      </div>

      <p class="text-text font-medium text-center text-base md:text-lg">
        Niet mooier om mooier. Een website die klanten moet opleveren.
      </p>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      5 · GEEN SEO-PLEISTERS
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-14 md:py-20 bg-bg-alt">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-4 text-center">
        Stop met SEO-pleisters plakken op een site die niet verkoopt
      </h2>
      <p class="text-text-muted text-center mb-3 max-w-2xl mx-auto text-[0.95rem] leading-relaxed">
        Een paar SEO-updates op een trage WordPress-site lossen het echte probleem vaak niet op.
        Als de basis rommelig, traag of onduidelijk is, blijven Google, AI en bezoekers moeite houden om je bedrijf als logische keuze te zien.
      </p>
      <p class="text-text text-center mb-10 md:mb-12 max-w-2xl mx-auto text-[0.95rem] leading-relaxed font-medium">
        Daarom beginnen we niet met losse trucjes. We zetten eerst het fundament goed.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6">
        <div class="border border-border rounded-card p-6 md:p-8 bg-white/50">
          <p class="text-text-muted text-xs uppercase tracking-widest font-medium mb-4">Oude aanpak</p>
          <ul class="space-y-3">
            {[
              'Losse SEO-updates',
              'Extra plugin erbij',
              'Tekstje aanpassen',
              'Maand later weer iets proberen',
              'Basis blijft hetzelfde',
              'Bezoekers blijven afhaken',
            ].map((item) => (
              <li class="flex items-start gap-3 text-sm text-text-muted leading-relaxed">
                <svg class="w-4 h-4 text-red-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="border-2 border-accent/30 rounded-card p-6 md:p-8 bg-white shadow-lg relative">
          <span class="absolute -top-3 left-6 inline-block px-3 py-0.5 text-[0.65rem] font-medium tracking-widest uppercase bg-accent text-white rounded-full">
            Nieuwe aanpak
          </span>
          <p class="text-text text-xs uppercase tracking-widest font-medium mb-4">AI-ready fundament</p>
          <ul class="space-y-3">
            {[
              'Bestaande site vertalen naar helder fundament',
              'Snellere structuur',
              'Dienst + regio duidelijk',
              "Bewijs en CTA's op de juiste plek",
              'Beter leesbaar voor Google en AI',
              'Klaar om daarna verder te optimaliseren',
            ].map((item) => (
              <li class="flex items-start gap-3 text-sm text-text leading-relaxed font-medium">
                <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <p class="text-text font-medium text-center text-[0.95rem] mt-10 max-w-2xl mx-auto">
        Geen losse SEO-pleisters op een oude site. Eerst het fundament goed.
      </p>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      6 · BEWIJS
      ══════════════════════════════════════════════════ */}
  <section class="py-20 md:py-28 bg-primary">
    <div class="max-w-5xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-3xl md:text-4xl text-white mb-3 text-center">
        Dit is wat er kan gebeuren als het fundament klopt
      </h2>
      <p class="text-white/60 text-center mb-16 max-w-xl mx-auto">
        Onze laatste 2 nieuwe fundamenten werden binnen 2 weken al zichtbaar in Google of AI.
      </p>

      {/* ── CASE 1: CBMC ── */}
      <div class="bg-white/5 backdrop-blur border-2 border-accent/30 rounded-card p-6 md:p-10 mb-12">
        <div class="flex items-center gap-4 mb-6">
          <div class="w-14 h-14 rounded-full overflow-hidden ring-2 ring-accent/30 shrink-0">
            <Image
              src={jamesPhoto}
              alt="Dr. James Mitchell"
              widths={[56, 112]}
              sizes="56px"
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div>
            <p class="text-white font-medium text-sm">Dr. James Mitchell</p>
            <a href="https://www.costablancamovement.com" target="_blank" rel="noopener" class="text-accent/70 hover:text-accent text-xs transition-colors">costablancamovement.com</a>
            <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-medium bg-accent/20 text-accent rounded-full uppercase tracking-wider mt-1">Chiropraktijk &middot; Costa Blanca</span>
          </div>
        </div>

        <h3 class="font-heading text-2xl md:text-3xl text-white mb-4">Costa Blanca Movement Centre &mdash; van nul naar zichtbaar in 14 dagen</h3>

        <p class="text-white/70 leading-relaxed mb-6 text-[0.95rem]">
          Een chiropraktijk voor expats in Torrevieja. Geen bestaande site, geen Google-historie, geen backlinks.
