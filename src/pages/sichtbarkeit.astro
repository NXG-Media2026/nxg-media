---
import DashboardLayout from '../layouts/DashboardLayout.astro';
import manualData from '../data/visibility';
import { computeBuildMetrics } from '../lib/visibilityMetrics';
import type { SourceType, MetricEntry } from '../lib/visibilityMetrics';

// ─── Compute build-time metrics ─────────────────────────────────────────
const buildMetrics = await computeBuildMetrics();

const {
  updatedAt,
  reportMonth,
  authorityScore,
  organicTraffic,
  topPages,
  pageVisibility,
  conversionEvents,
  completedActions,
  nextPriorities,
} = manualData;

// ─── Derive visibility scores ───────────────────────────────────────────
// Technical and Citability: computed from build. Authority: manual.
// Overall: weighted average (Tech 35%, Cite 35%, Auth 30%).

const techScore = buildMetrics.technicalScore;
const citeScore = buildMetrics.citabilityScore;
const authScore = authorityScore.value;
const overallScore = Math.round(techScore * 0.35 + citeScore * 0.35 + authScore * 0.30);

function scoreStatus(value: number): 'strong' | 'improving' | 'building' | 'needs_work' {
  if (value >= 80) return 'strong';
  if (value >= 60) return 'improving';
  if (value >= 30) return 'building';
  return 'needs_work';
}

const scoreEntries = [
  { label: 'Overall',             value: overallScore, previousValue: 0, status: scoreStatus(overallScore), source: 'build-measured' as SourceType, note: 'Weighted: Tech 35%, Cite 35%, Auth 30%' },
  { label: 'Layer 1: Technical',  value: techScore,    previousValue: 0, status: scoreStatus(techScore),    source: 'build-measured' as SourceType, note: 'Measured from site structure' },
  { label: 'Layer 2: Citability', value: citeScore,    previousValue: 0, status: scoreStatus(citeScore),    source: 'build-measured' as SourceType, note: 'Measured from content depth' },
  { label: 'Layer 3: Authority',  value: authScore,    previousValue: authorityScore.previousValue, status: scoreStatus(authScore), source: authorityScore.source, note: authorityScore.note },
];

// ─── Utility functions ──────────────────────────────────────────────────

function scoreColor(value: number): string {
  if (value >= 80) return 'text-emerald-600';
  if (value >= 50) return 'text-amber-600';
  return 'text-red-600';
}

function scoreBg(value: number): string {
  if (value >= 80) return 'bg-emerald-50 border-emerald-200';
  if (value >= 50) return 'bg-amber-50 border-amber-200';
  return 'bg-red-50 border-red-200';
}

function scoreBarColor(value: number): string {
  if (value >= 80) return 'bg-emerald-500';
  if (value >= 50) return 'bg-amber-500';
  return 'bg-red-500';
}

function trendArrow(current: number, previous: number): string {
  const diff = current - previous;
  if (diff > 0) return `▲ +${diff}`;
  if (diff < 0) return `▼ ${diff}`;
  return '—';
}

function trendColor(current: number, previous: number): string {
  if (current > previous) return 'text-emerald-600';
  if (current < previous) return 'text-red-600';
  return 'text-text-muted';
}

function statusLabel(status: string): string {
  const map: Record<string, string> = { strong: 'Strong', improving: 'Improving', building: 'Building', needs_work: 'Needs work' };
  return map[status] || status;
}

function statusDot(status: string): string {
  const map: Record<string, string> = { strong: 'bg-emerald-500', improving: 'bg-amber-500', building: 'bg-blue-500', needs_work: 'bg-red-500' };
  return map[status] || 'bg-text-muted';
}

function priorityStatusColor(status: string): string {
  const map: Record<string, string> = { done: 'bg-emerald-100 text-emerald-700', in_progress: 'bg-amber-100 text-amber-700', planned: 'bg-blue-100 text-blue-700' };
  return map[status] || 'bg-bg-alt text-text-muted';
}

function priorityStatusLabel(status: string): string {
  const map: Record<string, string> = { done: 'Done', in_progress: 'In progress', planned: 'Planned' };
  return map[status] || status;
}

function formatMonth(monthStr: string): string {
  const [year, month] = monthStr.split('-');
  const date = new Date(parseInt(year), parseInt(month) - 1);
  return date.toLocaleDateString('en-GB', { month: 'short', year: '2-digit' });
}

function sourceLabel(source: SourceType): string {
  const map: Record<SourceType, string> = {
    'build-measured': 'Measured from build',
    'manual-check': 'Manual check',
    'placeholder': 'Placeholder',
    'external-pending': 'Pending integration',
  };
  return map[source];
}

function sourceBadgeColor(source: SourceType): string {
  const map: Record<SourceType, string> = {
    'build-measured': 'bg-emerald-50 text-emerald-600',
    'manual-check': 'bg-blue-50 text-blue-600',
    'placeholder': 'bg-amber-50 text-amber-600',
    'external-pending': 'bg-amber-50 text-amber-600',
  };
  return map[source];
}

const maxTraffic = Math.max(...organicTraffic.clicks.map((t) => t.value), 1);

const conversionEntries = [
  { label: 'Product CTAs',     value: conversionEvents.current.product_cta_clicks,    prev: conversionEvents.previousMonth.product_cta_clicks },
  { label: 'Coaching CTAs',    value: conversionEvents.current.coaching_cta_clicks,    prev: conversionEvents.previousMonth.coaching_cta_clicks },
  { label: 'Newsletter',       value: conversionEvents.current.newsletter_signups,     prev: conversionEvents.previousMonth.newsletter_signups },
  { label: 'Lead magnets',     value: conversionEvents.current.lead_magnet_downloads,  prev: conversionEvents.previousMonth.lead_magnet_downloads },
  { label: 'Quiz completions', value: conversionEvents.current.quiz_completions,       prev: conversionEvents.previousMonth.quiz_completions },
  { label: 'Discovery calls',  value: conversionEvents.current.discovery_calls,        prev: conversionEvents.previousMonth.discovery_calls },
];

// ─── Flatten build metrics for display ──────────────────────────────────
const inventoryEntries: MetricEntry[] = Object.values(buildMetrics.inventory);
const bilingualEntries: MetricEntry[] = Object.values(buildMetrics.bilingual);
const qualityEntries: MetricEntry[] = Object.values(buildMetrics.quality);
const technicalEntries: MetricEntry[] = Object.values(buildMetrics.technical);
---

<DashboardLayout
  title={`Visibility Report | ${reportMonth}`}
  description="Internal visibility dashboard — technical SEO, content citability and brand authority."
  lastUpdated={updatedAt}
>

  <div class="mb-8 md:mb-12">
    <h1 class="font-heading text-2xl md:text-3xl text-text mb-2">
      Visibility Report — {reportMonth}
    </h1>
    <p class="text-sm text-text-muted">
      Performance overview: technical SEO, content citability and brand authority.
    </p>
  </div>

  {/* ========== SCORE CARDS ========== */}
  <section class="mb-10 md:mb-14">
    <h2 class="text-xs font-semibold uppercase tracking-wider text-text-muted/60 mb-4">Visibility scores</h2>
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 md:gap-6">
      {scoreEntries.map((s) => (
        <div class:list={['rounded-card border p-5 md:p-6', scoreBg(s.value)]}>
          <div class="flex items-center justify-between mb-3">
            <p class="text-xs font-medium text-text-muted truncate">{s.label}</p>
            <span class:list={['text-[9px] font-medium px-1.5 py-0.5 rounded-full', sourceBadgeColor(s.source)]}>
              {sourceLabel(s.source)}
            </span>
          </div>
          <p class:list={['text-3xl md:text-4xl font-heading', scoreColor(s.value)]}>
            {s.value}
          </p>
          <div class="mt-3 h-1.5 bg-black/5 rounded-full overflow-hidden">
            <div
              class:list={['h-full rounded-full transition-all', scoreBarColor(s.value)]}
              style={`width: ${s.value}%`}
            ></div>
          </div>
          <div class="mt-3 flex items-center justify-between">
            <span class:list={['text-xs font-medium', trendColor(s.value, s.previousValue)]}>
              {trendArrow(s.value, s.previousValue)}
            </span>
            <span class="inline-flex items-center gap-1.5 text-xs text-text-muted">
              <span class:list={['w-1.5 h-1.5 rounded-full', statusDot(s.status)]}></span>
              {statusLabel(s.status)}
            </span>
          </div>
          <p class="mt-2 text-[10px] text-text-muted/50">{s.note}</p>
        </div>
      ))}
    </div>
  </section>

  {/* ========== BUILD-TIME METRICS ========== */}
  <section class="mb-10 md:mb-14">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-text-muted/60">Content inventory</h2>
      <span class:list={['text-[10px] font-medium px-2 py-0.5 rounded-full', sourceBadgeColor('build-measured')]}>
        Measured from build
      </span>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
      {inventoryEntries.map((m) => (
        <div class="bg-white rounded-card border border-border p-4">
          <p class="text-2xl font-heading text-text mb-1">{m.value}</p>
          <p class="text-xs text-text-muted">{m.label}</p>
        </div>
      ))}
    </div>
  </section>

  {/* ── Bilingual coverage ─── */}
  <section class="mb-10 md:mb-14">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-text-muted/60">Bilingual coverage</h2>
      <span class:list={['text-[10px] font-medium px-2 py-0.5 rounded-full', sourceBadgeColor('build-measured')]}>
        Measured from build
      </span>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
      {bilingualEntries.map((m) => (
        <div class="bg-white rounded-card border border-border p-4">
          <p class="text-2xl font-heading text-text mb-1">{m.value}</p>
          <p class="text-xs text-text-muted">{m.label}</p>
        </div>
      ))}
    </div>
  </section>

  {/* ── Content quality ─── */}
  <section class="mb-10 md:mb-14">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-text-muted/60">Content quality signals</h2>
      <span class:list={['text-[10px] font-medium px-2 py-0.5 rounded-full', sourceBadgeColor('build-measured')]}>
        Measured from build
      </span>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
      {qualityEntries.map((m) => (
        <div class="bg-white rounded-card border border-border p-4">
          <p class="text-2xl font-heading text-text mb-1">{m.value}</p>
          <p class="text-xs text-text-muted">{m.label}</p>
        </div>
      ))}
    </div>
  </section>

  {/* ── Technical checks ─── */}
  <section class="mb-10 md:mb-14">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-text-muted/60">Technical infrastructure</h2>
      <span class:list={['text-[10px] font-medium px-2 py-0.5 rounded-full', sourceBadgeColor('build-measured')]}>
        Measured from build
      </span>
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
      {technicalEntries.map((m) => (
        <div class="bg-white rounded-card border border-border p-4">
          <p class="text-2xl font-heading text-text mb-1">{m.value}</p>
          <p class="text-xs text-text-muted">{m.label}</p>
        </div>
      ))}
    </div>
  </section>

  {/* ========== TRAFFIC TREND (external) ========== */}
  <section class="mb-10 md:mb-14">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-text-muted/60">Organic traffic</h2>
      <span class:list={['text-[10px] font-medium px-2 py-0.5 rounded-full', sourceBadgeColor(organicTraffic.source)]}>
        {organicTraffic.sourceLabel}
      </span>
    </div>
    <div class="bg-white rounded-card border border-border p-5 md:p-6">
      <div class="space-y-4">
        {organicTraffic.clicks.map((t, idx) => {
          const prev = idx > 0 ? organicTraffic.clicks[idx - 1].value : null;
          const pctWidth = Math.max((t.value / maxTraffic) * 100, 2);
          return (
            <div class="flex items-center gap-4">
              <span class="text-xs text-text-muted w-16 shrink-0 text-right">{formatMonth(t.month)}</span>
              <div class="flex-1 h-8 bg-bg-alt rounded overflow-hidden relative">
                <div
                  class="h-full bg-accent/80 rounded transition-all flex items-center justify-end pr-2"
                  style={`width: ${pctWidth}%`}
                >
                  <span class="text-xs font-medium text-white">{t.value}</span>
                </div>
              </div>
              {prev !== null && (
                <span class:list={['text-xs font-medium w-14 text-right shrink-0', t.value > prev ? 'text-emerald-600' : t.value < prev ? 'text-red-600' : 'text-text-muted']}>
                  {t.value > prev ? `▲ ${Math.round(((t.value - prev) / prev) * 100)}%` : t.value < prev ? `▼ ${Math.round(((prev - t.value) / prev) * 100)}%` : '—'}
                </span>
              )}
            </div>
          );
        })}
      </div>
      <p class="mt-4 text-xs text-text-muted/60">
        Organic clicks from Google Search Console.
      </p>
    </div>
  </section>

  {/* ========== TOP PAGES (external) ========== */}
  <section class="mb-10 md:mb-14">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-text-muted/60">Top pages</h2>
      <span class:list={['text-[10px] font-medium px-2 py-0.5 rounded-full', sourceBadgeColor(topPages.source)]}>
        {topPages.sourceLabel}
      </span>
    </div>
    <div class="bg-white rounded-card border border-border overflow-hidden">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-border bg-bg-alt/50">
            <th class="text-left text-xs font-medium text-text-muted px-5 py-3">Page</th>
            <th class="text-right text-xs font-medium text-text-muted px-5 py-3">Clicks</th>
            <th class="text-right text-xs font-medium text-text-muted px-5 py-3 hidden sm:table-cell">Impressions</th>
            <th class="text-right text-xs font-medium text-text-muted px-5 py-3">Trend</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border/60">
          {topPages.entries.map((p) => (
            <tr>
              <td class="px-5 py-3.5">
                <p class="font-medium text-text">{p.title}</p>
                <p class="text-xs text-text-muted/60 mt-0.5">{p.page}</p>
              </td>
              <td class="text-right px-5 py-3.5 font-medium text-text tabular-nums">{p.clicks}</td>
              <td class="text-right px-5 py-3.5 text-text-muted tabular-nums hidden sm:table-cell">{p.impressions.toLocaleString()}</td>
              <td class="text-right px-5 py-3.5">
                {p.trend === 'up' && <span class="text-xs font-medium text-emerald-600">▲ Rising</span>}
                {p.trend === 'stable' && <span class="text-xs font-medium text-text-muted">— Stable</span>}
                {p.trend === 'down' && <span class="text-xs font-medium text-red-600">▼ Falling</span>}
                {p.trend === 'new' && <span class="inline-block text-xs font-medium px-2 py-0.5 rounded-full bg-blue-50 text-blue-700">New</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  {/* ========== PAGE VISIBILITY MAP ========== */}
  <section class="mb-10 md:mb-14">
    <h2 class="text-xs font-semibold uppercase tracking-wider text-text-muted/60 mb-4">Page visibility</h2>
    <div class="bg-white rounded-card border border-border overflow-hidden">
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-border bg-bg-alt/50">
            <th class="text-left text-xs font-medium text-text-muted px-5 py-3">Page</th>
            <th class="text-left text-xs font-medium text-text-muted px-5 py-3 hidden sm:table-cell">Target query</th>
            <th class="text-center text-xs font-medium text-text-muted px-5 py-3">Google</th>
            <th class="text-center text-xs font-medium text-text-muted px-5 py-3">AI</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-border/60">
          {pageVisibility.entries.map((p) => (
            <tr>
              <td class="px-5 py-3.5 font-medium text-text">{p.page}</td>
              <td class="px-5 py-3.5 text-text-muted hidden sm:table-cell">
                <code class="text-xs bg-bg-alt px-1.5 py-0.5 rounded">{p.targetQuery}</code>
              </td>
              <td class="px-5 py-3.5 text-center">
                {p.googleStatus === 'ranking' ? (
                  <span class="inline-block text-xs font-medium px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700">Ranking</span>
                ) : (
                  <span class="inline-block text-xs font-medium px-2.5 py-1 rounded-full bg-bg-alt text-text-muted">Not yet</span>
                )}
              </td>
              <td class="px-5 py-3.5 text-center">
                {p.aiStatus === 'cited' ? (
                  <span class="inline-block text-xs font-medium px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700">Cited</span>
                ) : (
                  <span class="inline-block text-xs font-medium px-2.5 py-1 rounded-full bg-bg-alt text-text-muted">Not found</span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <div class="mt-3 flex flex-wrap items-center gap-3 text-xs text-text-muted/60">
      <span>
        Google:
        <span class:list={['inline-flex items-center ml-1 px-2 py-0.5 text-[10px] font-medium rounded-full', sourceBadgeColor(pageVisibility.googleSource)]}>
          {pageVisibility.googleSourceLabel}
        </span>
      </span>
      <span>
        AI:
        <span class:list={['inline-flex items-center ml-1 px-2 py-0.5 text-[10px] font-medium rounded-full', sourceBadgeColor(pageVisibility.aiSource)]}>
          {pageVisibility.aiSourceLabel}
        </span>
      </span>
    </div>
  </section>

  {/* ========== CONVERSION EVENTS (external) ========== */}
  <section class="mb-10 md:mb-14">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-text-muted/60">Conversion events — {reportMonth}</h2>
      <span class:list={['text-[10px] font-medium px-2 py-0.5 rounded-full', sourceBadgeColor(conversionEvents.source)]}>
        {conversionEvents.sourceLabel}
      </span>
    </div>
    <div class="grid grid-cols-2 lg:grid-cols-3 gap-4">
      {conversionEntries.map((e) => {
        const diff = e.value - e.prev;
        const diffStr = diff >= 0 ? `+${diff}` : `${diff}`;
        const diffColor = diff > 0 ? 'text-emerald-600' : diff < 0 ? 'text-red-600' : 'text-text-muted';
        return (
          <div class="bg-white rounded-card border border-border p-4 md:p-5">
            <p class="text-2xl md:text-3xl font-heading text-text mb-1">{e.value}</p>
            <p class="text-xs text-text-muted mb-2">{e.label}</p>
            <p class:list={['text-xs font-medium', diffColor]}>
              {diffStr} vs. prev. month
            </p>
          </div>
        );
      })}
    </div>
  </section>

  {/* ========== ACTIONS + PRIORITIES ========== */}
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 md:gap-8 mb-10 md:mb-14">

    <section>
      <h2 class="text-xs font-semibold uppercase tracking-wider text-text-muted/60 mb-4">Completed actions</h2>
      <div class="bg-white rounded-card border border-border divide-y divide-border">
        {completedActions.map((item) => (
          <div class="px-5 py-4 flex gap-4">
            <time class="text-xs text-text-muted/60 w-20 shrink-0 pt-0.5" datetime={item.date}>
              {new Date(item.date).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}
            </time>
            <p class="text-sm text-text">{item.action}</p>
          </div>
        ))}
      </div>
    </section>

    <section>
      <h2 class="text-xs font-semibold uppercase tracking-wider text-text-muted/60 mb-4">Next priorities</h2>
      <div class="bg-white rounded-card border border-border divide-y divide-border">
        {nextPriorities.map((item) => (
          <div class="px-5 py-4 flex items-start justify-between gap-4">
            <p class="text-sm text-text">{item.priority}</p>
            <span class:list={['text-xs font-medium px-2.5 py-1 rounded-full shrink-0', priorityStatusColor(item.status)]}>
              {priorityStatusLabel(item.status)}
            </span>
          </div>
        ))}
      </div>
    </section>
  </div>

  {/* ========== SOURCE LEGEND + INTEGRATION NOTE ========== */}
  <section class="mb-6">
    <div class="bg-white rounded-card border border-border/60 p-5 md:p-6 space-y-4">
      <div class="flex flex-wrap items-center gap-3">
        <span class="text-xs text-text-muted font-medium mr-1">Source types:</span>
        <span class="inline-flex items-center gap-1.5 text-[10px] font-medium px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-600">
          <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full"></span> Measured from build
        </span>
        <span class="inline-flex items-center gap-1.5 text-[10px] font-medium px-2 py-0.5 rounded-full bg-blue-50 text-blue-600">
          <span class="w-1.5 h-1.5 bg-blue-500 rounded-full"></span> Manual check
        </span>
        <span class="inline-flex items-center gap-1.5 text-[10px] font-medium px-2 py-0.5 rounded-full bg-amber-50 text-amber-600">
          <span class="w-1.5 h-1.5 bg-amber-500 rounded-full"></span> Pending integration
        </span>
      </div>
      <p class="text-xs text-text-muted leading-relaxed">
        This dashboard is a lightweight internal visibility layer. Scores for Technical and Citability are computed from the codebase at build time. Authority, traffic, and conversion metrics require external integrations (Google Search Console, GA4, payment webhooks) and are currently placeholder or manually checked. AI visibility is verified through manual checks in ChatGPT, Perplexity, and Gemini.
      </p>
    </div>
  </section>

</DashboardLayout>
