---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import { siteConfig } from '../../data/site';
import { generateBreadcrumbs } from '../../data/schema';
import { t, localizePath } from '../../i18n/utils';

const locale = 'en';

const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: localizePath('/', locale) },
  { label: t('nav.agb', locale) },
];

const breadcrumbSchema = breadcrumbs.map((b) => ({
  name: b.label,
  url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}/en/terms`,
}));
---

<BaseLayout
  title={`Terms & Conditions | ${siteConfig.name}`}
  description={`Terms and conditions for ${siteConfig.name}.`}
  noindex={true}
  locale="en"
>
  <BreadcrumbNav items={breadcrumbs} />

  <article class="py-12 md:py-16 lg:py-20">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h1 class="font-heading text-3xl md:text-4xl text-text mb-8">Terms &amp; Conditions</h1>

      <div class="prose prose-lg max-w-none">
        <div class="bg-bg-alt border border-border rounded-card p-6 mb-8">
          <p class="text-text-muted text-sm mb-2">
            <strong>Note:</strong> As {siteConfig.name} is operated from Germany, the legally binding terms and conditions (AGB) are available in German.
          </p>
          <a
            href="/agb"
            class="inline-flex items-center text-sm font-medium text-accent hover:text-accent-dark transition-colors"
          >
            View terms &amp; conditions (German)
            <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>

        <h2>Overview</h2>
        <p>
          The following is a summary of key terms. The full, legally binding terms are available in German via the link above.
        </p>
        <ul>
          <li>All digital products are delivered electronically after purchase.</li>
          <li>Coaching sessions are subject to the cancellation policy outlined in the full terms.</li>
          <li>German law applies to all contracts.</li>
        </ul>

        <h2>Contact</h2>
        <p>
          For questions about these terms, please contact us at <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>.
        </p>
      </div>
    </div>
  </article>
</BaseLayout>
