---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import ClientResults from '../../../components/ClientResults.astro';
import MkbCaseProof from '../../../components/MkbCaseProof.astro';
import VideoTestimonialCarousel from '../../../components/VideoTestimonialCarousel.astro';
import { siteConfig } from '../../../data/site';
import { t, localizePath } from '../../../i18n/utils';
import { buildHreflangTrilingual } from '../../../i18n/hreflang';
import { getTestimonials } from '../../../data/testimonials';
import { videoTestimonials } from '../../../data/videoTestimonials';

const locale = 'en';
const hreflang = buildHreflangTrilingual('/cases/', '/en/cases/', '/es/casos/');
const cases = (await getCollection('cases')).filter((c) => c.data.locale === locale).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const testimonials = getTestimonials({ locale: 'en' });

const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: localizePath('/', locale) },
  { label: t('breadcrumb.cases', locale) },
];
---

<BaseLayout
  title={`Cases & Results | ${siteConfig.name}`}
  description="See how coaches, experts and SMBs grow with NXG Media. Real results, real clients, real numbers."
  locale={locale}
  hreflang={hreflang}
>
  <BreadcrumbNav items={breadcrumbs} />

  {/* ── Page Intro ── */}
  <section class="py-12 md:py-16 lg:py-20">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl text-text mb-4">REAL WORK.<br /><span>REAL RESULTS.</span></h1>
      <p class="text-lg text-text-muted leading-relaxed max-w-2xl">
        No vague promises, just concrete numbers. This is what happens when you stop running isolated campaigns and build a system that works for you.
      </p>
    </div>
  </section>

  <MkbCaseProof />

  {/* ── Featured Cases (same visual style as homepage) ── */}
  <ClientResults
    title="Coaches and experts"
    featuredCases={[
      {
        testimonial: testimonials.find((t) => t.id === 'rolf-happywithyoga')!,
        period: 'Since 2022',
        stats: [
          { value: '30,000+', label: 'webinar leads' },
          { value: '1,700+', label: 'mini-course sales' },
          { value: '2,000', label: 'paying members' },
        ],
        caseHref: '/en/cases/happy-with-yoga/',
      },
      {
        testimonial: testimonials.find((t) => t.id === 'tessa-youlife')!,
        period: 'Since Feb 2025',
        stats: [
          { value: '~€10k/mo', label: 'online products' },
          { value: '6', label: 'products launched' },
          { value: '~10/mo', label: 'coaching clients' },
        ],
        caseHref: '/en/cases/tessa-youlife/',
      },
      {
        testimonial: testimonials.find((t) => t.id === 'josine-coachjosine')!,
        period: 'Since Oct 2025',
        stats: [
          { value: '600×', label: 'guides sold' },
          { value: '80', label: 'masterclass signups' },
        ],
        caseHref: '/en/cases/coach-josine/',
      },
    ]}
    smallResults={[
      {
        name: 'Manon — Vrouw & Mindset coach',
        period: 'First month',
        stats: [
          { value: '120', label: 'signups in 2 weeks' },
          { value: '~10%', label: 'conversion to programmes' },
        ],
      },
      {
        name: 'Kim — Human Design coach',
        period: '2 months',
        stats: [
          { value: '90', label: 'masterclass signups' },
          { value: '350×', label: 'guides sold' },
          { value: '8%', label: 'conversion' },
        ],
      },
      {
        name: 'MCM Research',
        logo: 'mcm-research-logo.webp',
        period: 'Client since 2022',
        stats: [
          { value: '2,500+', label: 'leads in Netherlands' },
          { value: '500', label: 'applicants NL' },
          { value: '1,500+', label: 'leads in Belgium' },
          { value: '250', label: 'applicants BE' },
        ],
      },
    ]}
    otherTestimonials={testimonials.filter((t) => ['claire-ikrouwvanje', 'andrew-coreprogression'].includes(t.id))}
    caseLabel="Read the case"
    allCasesHref=""
    allCasesLabel=""
    locale="en"
  />

  {/* ── All Case Studies (if there are more beyond featured) ── */}
  {cases.length > 0 && (
    <section class="py-12 md:py-16">
      <div class="max-w-4xl mx-auto px-4 md:px-6">
        <h2 class="font-heading text-2xl md:text-3xl text-text mb-8">Explore the coach cases</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {cases.map((c) => (
            <a href={`/en/cases/${c.data.pageSlug}/`} class="group block bg-white border border-border rounded-card p-6 hover:border-accent/30 hover:shadow-lg transition-all duration-300">
              <span class="text-xs font-medium text-accent uppercase tracking-wider mb-2 block">{c.data.clientType}</span>
              <h3 class="font-heading text-lg text-text mb-2 group-hover:text-accent transition-colors">{c.data.title}</h3>
              {c.data.proofStats.length > 0 && (
                <div class="flex flex-wrap gap-2 mt-3">
                  {c.data.proofStats.slice(0, 3).map((stat) => (
                    <span class="inline-flex items-center px-2 py-1 text-xs bg-bg-alt rounded-full">
                      <strong class="text-accent mr-1">{stat.value}</strong> {stat.label}
                    </span>
                  ))}
                </div>
              )}
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* ── Video Testimonials ── */}
  <VideoTestimonialCarousel
    title="What clients say about working with Joost"
    subtitle="Real experiences from entrepreneurs who successfully collaborate with Joost"
    testimonials={videoTestimonials}
  />

  {/* ── CTA ── */}
  <section class="py-12 md:py-16 bg-bg-alt"><div class="max-w-4xl mx-auto px-4 md:px-6"><h2 class="font-heading mb-6">What fits your business?</h2><div class="grid md:grid-cols-2 gap-6"><a class="p-6 bg-white border border-border rounded-card" href="/landermkb/"><h3 class="font-heading mb-3">SMBs, practices and service providers</h3><p class="text-text-muted">Explore NXG Growth: AI Search, your website and campaigns as one approach.</p></a><a class="p-6 bg-white border border-border rounded-card" href="/en/coach-accelerator/"><h3 class="font-heading mb-3">Coaches and experts</h3><p class="text-text-muted">Explore Coach Accelerator: from expertise and offerings to entry products and clients.</p></a></div></div></section>

</BaseLayout>
