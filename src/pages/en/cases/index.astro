---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import { siteConfig } from '../../../data/site';
import { t } from '../../../i18n/utils';

const locale = 'en';
const cases = (await getCollection('cases')).filter((c) => c.data.locale === locale).sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99));
const nlCases = cases.length === 0 ? (await getCollection('cases')).filter((c) => c.data.locale === 'nl').sort((a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)) : [];

const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: '/en/' },
  { label: t('breadcrumb.cases', locale) },
];
---

<BaseLayout title={`Cases | ${siteConfig.name}`} description="See how coaches, experts and practices grow with NXG Media." locale={locale}>
  <BreadcrumbNav items={breadcrumbs} />
  <section class="py-12 md:py-16 lg:py-20">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h1 class="font-heading text-3xl md:text-4xl text-text mb-10">Cases</h1>
      {cases.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {cases.map((c) => (
            <a href={`/en/cases/${c.data.pageSlug}/`} class="group block bg-white border border-border rounded-card p-6 hover:border-accent/30 hover:shadow-lg transition-all">
              <span class="text-xs font-medium text-accent uppercase tracking-wider mb-2 block">{c.data.clientType}</span>
              <h2 class="font-heading text-lg text-text group-hover:text-accent transition-colors">{c.data.title}</h2>
            </a>
          ))}
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {nlCases.map((c) => (
            <a href={`/cases/${c.data.pageSlug}/`} class="group block bg-white border border-border rounded-card p-6 hover:border-accent/30 hover:shadow-lg transition-all">
              <span class="text-xs font-medium text-accent uppercase tracking-wider mb-2 block">{c.data.clientType}</span>
              <h2 class="font-heading text-lg text-text group-hover:text-accent transition-colors">{c.data.title}</h2>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
