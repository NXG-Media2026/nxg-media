---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import CTABand from '../../components/CTABand.astro';
import { siteConfig } from '../../data/site';
import { generateFounderPerson, generateProfilePage, generateBreadcrumbs } from '../../data/schema';
import { t, localizePath, getTranslatedPath } from '../../i18n/utils';
import { buildHreflangPair } from '../../i18n/hreflang';

import portraitImage from '../../assets/images/Founder/verena-linkedin.png';
import ironmanImage from '../../assets/images/Founder/hero-ironman.jpg';
import ctaBackground from '../../assets/images/Founder/lifestyle-water.jpg';

const locale = 'en';
const { founder: founderDe } = siteConfig;

// EN overrides for founder data (siteConfig.founder is DE)
const founder = {
  ...founderDe,
  role: 'Emergency Physician & Endurance Athlete',
  description:
    'Dr. Verena Mann is a licensed physician and emergency doctor as well as a passionate endurance athlete. She founded doc.veri to give women access to evidence-based knowledge about hormones, training, nutrition and cycle-aware living — no bro-science, no pseudoscience.',
  qualifications: [
    'Licensed Physician (Approbation)',
    'Emergency Medicine Specialist',
  ],
  education: [
    { institution: '', degree: 'Medical State Examination (Staatsexamen)', year: 0 },
  ],
  languages: ['German', 'English'],
  knowsAbout: [
    "Women's Health",
    'Hormone Balance',
    'Endurance Training for Women',
    'Cycle-Aware Training',
    'RED-S (Relative Energy Deficiency in Sport)',
    'Perimenopause',
    'Sports Nutrition for Women',
  ],
};

const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: localizePath('/', locale) },
  { label: t('nav.about', locale) },
];

const breadcrumbSchema = breadcrumbs.map((b) => ({
  name: b.label,
  url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}/en/about`,
}));
---

<BaseLayout
  title={`About ${founder.name} | ${siteConfig.name}`}
  description="Dr. Verena Mann — physician, emergency doctor & endurance athlete. Founder of doc.veri for evidence-based women's health."
  hreflang={buildHreflangPair('/ueber', '/en/about')}
  schemas={[
    generateFounderPerson(),
    generateProfilePage(),
    generateBreadcrumbs(breadcrumbSchema),
  ]}
  locale="en"
>
  <BreadcrumbNav items={breadcrumbs} />

  {/* ─── 1. Hero ─────────────────────────────────────────────── */}
  <section class="py-16 md:py-24 lg:py-32 bg-bg" id={founder.slug}>
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <div class="grid grid-cols-1 md:grid-cols-5 gap-10 md:gap-14 items-start">

        <div class="md:col-span-2 flex justify-center md:sticky md:top-28">
          <Image
            src={portraitImage}
            alt={`${founder.name} — ${founder.role}, Founder of doc.veri`}
            width={400}
            height={400}
            class="w-56 h-56 md:w-72 md:h-72 rounded-full object-cover shadow-lg"
            loading="eager"
            decoding="async"
          />
        </div>

        <div class="md:col-span-3">
          <div class="w-12 h-1 bg-accent rounded-full mb-6"></div>
          <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl text-text mb-2">
            {founder.name}
          </h1>
          <p class="text-lg font-medium text-accent mb-8">{founder.role}</p>

          <div class="prose prose-lg max-w-none mb-8">
            <p>
              Many women do everything right — and still do not feel right. They train, watch their diet, see their doctor. But the advice they receive is usually not built for the female body.
            </p>
            <p>
              doc.veri exists because that should be different. Verena founded doc.veri to make the knowledge accessible that she wished she had earlier: medically grounded, practically applicable, and built for women who want to truly understand their body.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ─── 2. What Verena keeps seeing ─────────────────────────── */}
  <section class="py-14 md:py-20 bg-bg-alt">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-6">
        What Verena keeps seeing
      </h2>
      <div class="prose prose-lg max-w-none">
        <p>
          In the ER and in practice, Verena encounters a pattern that keeps repeating: women with real symptoms — heart palpitations, exhaustion, sleep problems, unexplained intolerances — where diagnostics show nothing remarkable.
        </p>
        <p>
          Many of these women have spent years treating individual symptoms without anyone asking about the connection. Antihistamines for the skin, painkillers for the headaches, sleep aids for the nights. Nobody looked at skin, sleep and headaches together.
        </p>
        <p>
          Most blame themselves: not enough discipline, not enough sleep, too much stress. But the problem is rarely a lack of discipline — it is a lack of knowledge about how the female body actually works.
        </p>
      </div>
    </div>
  </section>

  {/* ─── 3. Point of View ────────────────────────────────────── */}
  <section class="py-14 md:py-20 bg-bg">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-6">
        What doc.veri stands for
      </h2>
      <div class="space-y-4">
        {[
          'You are not broken. The advice was not built for you.',
          'Health should not become another rulebook.',
          'Not everything needs optimizing.',
          'The female body is not unpredictable — most women were simply never taught its patterns.',
          'Structure should reduce overwhelm, not add pressure.',
          'Evidence-based health should still fit real life.',
        ].map((statement) => (
          <div class="flex items-start gap-3">
            <div class="w-1.5 h-1.5 bg-accent rounded-full mt-2.5 shrink-0"></div>
            <p class="text-lg text-text leading-relaxed">{statement}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ─── 4. Medical background ───────────────────────────────── */}
  <section class="py-14 md:py-20 bg-bg-alt">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-8">
        Medical background
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {/* Qualifications */}
        {founder.qualifications.length > 0 && (
          <div>
            <h3 class="font-heading text-lg text-text mb-4">{t('about.credentials', locale)}</h3>
            <ul class="space-y-3">
              {founder.qualifications.map((q) => (
                <li class="flex items-center gap-3 text-text-muted">
                  <svg class="w-5 h-5 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {q}
                </li>
              ))}
            </ul>
          </div>
        )}

        {/* Education */}
        {founder.education && founder.education.some(e => e.degree) && (
          <div>
            <h3 class="font-heading text-lg text-text mb-4">{t('about.education', locale)}</h3>
            <ul class="space-y-3">
              {founder.education.filter(e => e.degree).map((e) => (
                <li class="flex items-start gap-3 text-text-muted">
                  <svg class="w-5 h-5 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.438 60.438 0 00-.491 6.347A48.62 48.62 0 0112 20.904a48.62 48.62 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.636 50.636 0 00-2.658-.813A59.906 59.906 0 0112 3.493a59.903 59.903 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0112 13.489a50.702 50.702 0 017.74-3.342" />
                  </svg>
                  <span>
                    {e.degree}
                    {e.institution && <span class="text-text-muted/70"> — {e.institution}</span>}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>

      {/* Languages */}
      {founder.languages.length > 0 && (
        <div class="mt-8">
          <h3 class="font-heading text-lg text-text mb-4">{t('about.languages', locale)}</h3>
          <div class="flex flex-wrap gap-2">
            {founder.languages.map((lang) => (
              <span class="inline-flex items-center px-3 py-1.5 text-sm bg-bg border border-border rounded-full text-text-muted">
                {lang}
              </span>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  {/* ─── 5. Areas of Expertise ───────────────────────────────── */}
  {founder.knowsAbout.length > 0 && (
    <section class="py-14 md:py-20 bg-bg">
      <div class="max-w-4xl mx-auto px-4 md:px-6">
        <h2 class="font-heading text-2xl md:text-3xl text-text mb-8">
          Areas of Expertise
        </h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
          {founder.knowsAbout.map((topic) => (
            <span class="inline-flex items-center justify-center px-4 py-2.5 text-sm bg-accent/5 border border-accent/20 rounded-card text-accent-dark text-center">
              {topic}
            </span>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* ─── 6. How doc.veri works ───────────────────────────────── */}
  <section class="py-14 md:py-20 bg-bg-alt">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-6">
        How doc.veri works
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {[
          { step: '1', title: 'Recognize patterns', desc: 'Understand what is happening in your body — instead of treating isolated symptoms.' },
          { step: '2', title: 'Understand mechanisms', desc: 'Learn the connections between hormones, cycle, nutrition and lifestyle.' },
          { step: '3', title: 'Choose your next step', desc: 'Whether quiz, product, masterclass or coaching — pick what fits your situation.' },
          { step: '4', title: 'Take action', desc: 'Practical steps that fit your real life. No perfection required, just progress.' },
        ].map(({ step, title, desc }) => (
          <div class="bg-bg rounded-card p-5 border border-border">
            <span class="inline-flex items-center justify-center w-8 h-8 bg-accent/10 text-accent-dark text-sm font-heading font-bold rounded-full mb-3">
              {step}
            </span>
            <h3 class="font-heading font-medium text-text mb-2">{title}</h3>
            <p class="text-sm text-text-muted leading-relaxed">{desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* ─── 7. Personal lens / Ironman ──────────────────────────── */}
  <section class="py-16 md:py-24 bg-bg">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-14 items-center">
        <div>
          <Image
            src={ironmanImage}
            alt="Dr. Verena Mann crossing the Ironman finish line"
            width={600}
            height={400}
            class="w-full h-auto rounded-card shadow-lg object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div>
          <h2 class="font-heading text-2xl md:text-3xl text-text mb-4">
            Physician, Ironman athlete, human
          </h2>
          <p class="text-text-muted leading-relaxed mb-4">
            Medicine and endurance sports — for Verena, they go hand in hand. As an Ironman finisher, she knows first-hand what women's bodies need under stress — and what happens when generic training advice meets female physiology.
          </p>
          <p class="text-text-muted leading-relaxed mb-4">
            Health should make life bigger, not smaller. No over-engineering, no endless protocols. Just knowledge that helps you make better decisions — and then let go.
          </p>
          <p class="text-text-muted leading-relaxed">
            This knowledge flows into everything she does at doc.veri: from cycle-aware training plans to nutrition in perimenopause.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ─── 8. Disclaimer / boundaries ──────────────────────────── */}
  <section class="py-10 md:py-14 bg-bg-alt">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <div class="border-l-4 border-border pl-6 md:pl-8">
        <h2 class="font-heading text-lg text-text mb-3">Important to know</h2>
        <p class="text-text-muted leading-relaxed mb-3">
          doc.veri provides health information and education. The content does not replace medical diagnosis or treatment. For acute or unclear symptoms, please see a doctor.
        </p>
        <p class="text-text-muted leading-relaxed">
          If you are looking for individual guidance, 1:1 coaching can be a meaningful complement — but even there, education and self-understanding come first, not treatment.
        </p>
      </div>
    </div>
  </section>

  {/* ─── 9. CTA ──────────────────────────────────────────────── */}
  <section class="py-12 md:py-16 bg-bg">
    <div class="max-w-3xl mx-auto px-4 md:px-6 text-center">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-4">
        Ready to understand your body on your terms?
      </h2>
      <p class="text-text-muted mb-8 text-lg max-w-xl mx-auto">
        Start with the quiz — find out which topic would make the biggest difference for you.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="/en/quiz"
          class="inline-flex items-center px-8 py-4 text-base font-medium text-text-inverse bg-primary hover:bg-primary-dark transition-colors rounded-button shadow-lg"
        >
          Take the quiz
        </a>
        <a
          href="/en/offers"
          class="inline-flex items-center px-8 py-4 text-base font-medium text-text bg-bg-alt border border-border hover:border-accent/30 transition-colors rounded-button"
        >
          Explore offers
        </a>
      </div>
    </div>
  </section>

  <CTABand
    title="Questions? Unsure where to start?"
    subtitle="Get in touch — I'm happy to help."
    ctaText="Contact"
    ctaHref="/en/contact"
    backgroundImage={ctaBackground}
    backgroundAlt="Dr. Verena Mann by the sea"
    eventName="discovery_call_click"
    locale="en"
    pageType="about"
    pageSlug="/en/about"
  />
</BaseLayout>
