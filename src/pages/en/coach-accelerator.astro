---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import LogoMarquee from '../../components/LogoMarquee.astro';
import { siteConfig } from '../../data/site';
import { generateBreadcrumbs, generateFAQPage } from '../../data/schema';
import { getCluster, getClusterFaqLocalized } from '../../lib/clusters';

import heroPhoto from '../../assets/images/founder/joost-standing-workinglaptop.webp';
import founderPhoto from '../../assets/images/founder/joost-standing-relaxed.webp';

import josineScreenshot from '../../assets/images/cases/eetgids-coachjosine-product-proof.webp';
import tessaScreenshot from '../../assets/images/cases/tessa-youlife-meta-ads-proof.webp';
import hwyScreenshot from '../../assets/images/cases/autenthicoffers-lander-happywithyoga-funnel-proof.webp';

import claireWhatsApp from '../../assets/images/cases/ikrouwvanje-claire-whatsapp-proof.webp';
import tessaWhatsApp from '../../assets/images/cases/tessa-youlife-whatsapp-proof.webp';
import rolfWhatsApp from '../../assets/images/cases/rolf-happywithyoga-whatsapp-proof.webp';

const locale = 'en';
const cluster = getCluster('expert-growth')!;
const faqItems = getClusterFaqLocalized(cluster, locale);
const faqForComponent = faqItems.map((item) => ({ q: item.question, a: item.answer }));

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logos/*.{webp,avif,png,jpg}', { eager: true });
const logos = Object.entries(logoFiles)
  .filter(([path]) => /logo/i.test(path.split('/').pop()!))
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/, '');
    const name = filename.replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim();
    return { src: mod.default, alt: name };
  });

const breadcrumbs = [
  { label: 'Home', href: '/en/' },
  { label: 'Coach Accelerator' },
];
---

<BaseLayout
  title="Coach Accelerator — Predictable growth for coaches and experts | NXG Media"
  description="From referrals to a system that works for you. Mini-products, email flows, ads and AI visibility — built as one machine that delivers leads and clients."
  schemas={[generateBreadcrumbs(breadcrumbs.map((b) => ({ name: b.label, url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}/en/coach-accelerator/` }))), generateFAQPage(faqItems)]}
  locale={locale}
>
  <BreadcrumbNav items={breadcrumbs} />

  {/* ── Hero ── */}
  <section class="relative py-20 md:py-28 lg:py-36 overflow-hidden">
    <div class="absolute inset-0">
      <Image
        src={heroPhoto}
        alt="Joost van Putten — online growth strategist for coaches and experts"
        widths={[800, 1200, 1600]}
        sizes="100vw"
        class="w-full h-full object-cover"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-white/95 via-white/85 to-white/40"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 md:px-6">
      <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl text-text mb-6 leading-tight max-w-2xl">
        Enough client conversations every month — without relying on referrals
      </h1>
      <p class="text-lg md:text-xl text-text-muted leading-relaxed mb-10 max-w-xl">
        Most coaches don't know where their next client is coming from. One month is busy, the next is quiet. With a system that works for you, you stop guessing.
      </p>
      <div class="flex flex-col sm:flex-row items-start gap-4">
        <a
          href="/en/services/coach-accelerator/"
          class="inline-flex items-center px-8 py-4 text-base font-medium text-text-inverse bg-primary hover:bg-primary-dark transition-colors rounded-button shadow-lg"
        >
          See how it works
          <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a
          href="/en/contact/"
          class="inline-flex items-center px-8 py-4 text-base font-medium text-primary border-2 border-primary hover:bg-primary/5 transition-colors rounded-button"
        >
          Book an introduction
        </a>
      </div>
    </div>
  </section>

  {/* ── Proof Stats ── */}
  <section class="bg-bg-alt border-y border-border">
    <div class="max-w-4xl mx-auto px-4 md:px-6 py-8 md:py-10">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
        <div>
          <div class="font-heading text-2xl md:text-3xl text-primary">600×</div>
          <p class="text-xs text-text-muted mt-1">guides sold in week 1</p>
        </div>
        <div>
          <div class="font-heading text-2xl md:text-3xl text-primary">€10k/mo</div>
          <p class="text-xs text-text-muted mt-1">online product revenue</p>
        </div>
        <div>
          <div class="font-heading text-2xl md:text-3xl text-primary">2,000</div>
          <p class="text-xs text-text-muted mt-1">paying platform members</p>
        </div>
        <div>
          <div class="font-heading text-2xl md:text-3xl text-primary">7.2×</div>
          <p class="text-xs text-text-muted mt-1">ROAS on ads</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── Pain Recognition ── */}
  <section class="py-16 md:py-20 bg-primary">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-white mb-8">How it feels right now</h2>
      <div class="space-y-5">
        <div class="flex items-start gap-4">
          <span class="text-2xl shrink-0" aria-hidden="true">😓</span>
          <p class="text-white/80 leading-relaxed">You rely on referrals and word of mouth. It works... until it doesn't.</p>
        </div>
        <div class="flex items-start gap-4">
          <span class="text-2xl shrink-0" aria-hidden="true">🤷</span>
          <p class="text-white/80 leading-relaxed">You know you "should do something about marketing" but never get to it.</p>
        </div>
        <div class="flex items-start gap-4">
          <span class="text-2xl shrink-0" aria-hidden="true">⏰</span>
          <p class="text-white/80 leading-relaxed">Client work always comes first. And when things get quiet, it's too late to start.</p>
        </div>
        <div class="flex items-start gap-4">
          <span class="text-2xl shrink-0" aria-hidden="true">😴</span>
          <p class="text-white/80 leading-relaxed">At night you wonder: where will next month's revenue come from?</p>
        </div>
      </div>
      <p class="text-white font-medium mt-8 text-lg">
        You're not bad at business. You're just missing a system that works for you, even when you're busy with clients.
      </p>
    </div>
  </section>

  {/* ── Old Approach ── */}
  <section class="py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-10">The old approach no longer works</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-10 h-10 rounded-full bg-red-50 flex items-center justify-center mb-4">
            <span class="text-red-400 text-lg">✗</span>
          </div>
          <h3 class="font-heading text-lg text-text mb-2">Free e-books and downloads</h3>
          <p class="text-sm text-text-muted leading-relaxed">You share your best tips in a PDF. Out of 100 downloads, maybe 1 becomes a client. You never hear from the rest.</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-10 h-10 rounded-full bg-red-50 flex items-center justify-center mb-4">
            <span class="text-red-400 text-lg">✗</span>
          </div>
          <h3 class="font-heading text-lg text-text mb-2">"Book a free call"</h3>
          <p class="text-sm text-text-muted leading-relaxed">You get people who want to "pick your brain", have no budget, or don't show up.</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-10 h-10 rounded-full bg-red-50 flex items-center justify-center mb-4">
            <span class="text-red-400 text-lg">✗</span>
          </div>
          <h3 class="font-heading text-lg text-text mb-2">Waiting for referrals</h3>
          <p class="text-sm text-text-muted leading-relaxed">It works... until it stops. You have no control over when the next client arrives.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── The System ── */}
  <section class="py-16 md:py-20 bg-bg-alt">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <div class="max-w-3xl">
        <h2 class="font-heading text-2xl md:text-3xl text-text mb-6">
          One route from click to client
        </h2>
        <p class="text-lg text-text-muted leading-relaxed mb-8">
          No separate campaigns. No "more visibility." One system where content, products, emails and ads work together as a single path — from first click to paying client.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-10 h-10 rounded-full bg-accent/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="font-heading text-lg text-text mb-2">Entry product that pays for itself</h3>
          <p class="text-sm text-text-muted leading-relaxed">Your first online product — a guide, mini-course or masterclass — covers your ad costs from day 1. No months waiting for returns.</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-10 h-10 rounded-full bg-accent/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
            </svg>
          </div>
          <h3 class="font-heading text-lg text-text mb-2">Self-qualifying leads</h3>
          <p class="text-sm text-text-muted leading-relaxed">Visitors go through an interactive route and show what they need. You only speak with people who already know why they want to work with you.</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-10 h-10 rounded-full bg-accent/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="font-heading text-lg text-text mb-2">Follow-up that builds trust</h3>
          <p class="text-sm text-text-muted leading-relaxed">After signing up, leads receive a personal email series. By the time they see your programme, you no longer need to convince them.</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-10 h-10 rounded-full bg-accent/10 flex items-center justify-center mb-4">
            <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
            </svg>
          </div>
          <h3 class="font-heading text-lg text-text mb-2">Predictable growth, no peaks and valleys</h3>
          <p class="text-sm text-text-muted leading-relaxed">Content, products, emails and ads form one path. That's the difference between "more visibility" and predictable growth.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── Mid CTA ── */}
  <section class="py-16 md:py-20 bg-accent">
    <div class="max-w-4xl mx-auto px-4 md:px-6 text-center">
      <h2 class="font-heading text-3xl md:text-4xl text-white mb-4">
        Curious if this fits your phase?
      </h2>
      <p class="text-lg text-white/80 mb-8 max-w-2xl mx-auto">
        In 30 minutes we look at where you stand and what the logical next step is. No sales pitch.
      </p>
      <a
        href="/en/contact/"
        class="inline-flex items-center px-8 py-4 text-base font-medium bg-white text-accent hover:bg-bg-alt transition-colors rounded-button"
      >
        Book an introduction
        <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>

  {/* ── Timeline ── */}
  <section class="py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-4">Three phases to predictable growth</h2>
      <p class="text-lg text-text-muted leading-relaxed mb-12 max-w-3xl">
        Not everything at once. Each phase builds on the previous one — so you only invest in what's been proven to work.
      </p>

      <div class="relative">
        <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-px bg-border -translate-x-1/2"></div>

        <div class="space-y-8 md:space-y-12">
          {/* Phase 1 */}
          <div class="relative md:grid md:grid-cols-2 md:gap-12 items-start">
            <div class="md:text-right md:pr-8">
              <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-primary/10 text-primary rounded-full mb-3">
                Month 1–3
              </span>
              <h3 class="font-heading text-xl text-text mb-2">Build the foundation</h3>
            </div>
            <div class="md:pl-8 mt-3 md:mt-0">
              <div class="bg-white rounded-card p-5 border border-border">
                <ul class="space-y-2 text-sm text-text-muted">
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> Sharpen positioning — from generalist to specialist</li>
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> Launch first product or masterclass</li>
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> Email flow after sign-up — automatic follow-up</li>
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> First ads test — measure which message works</li>
                </ul>
                <p class="text-xs text-accent font-medium mt-4">Goal: first paying clients through the new system</p>
              </div>
            </div>
            <div class="hidden md:flex absolute left-1/2 top-3 -translate-x-1/2 w-8 h-8 rounded-full bg-primary text-white items-center justify-center text-sm font-heading">1</div>
          </div>

          {/* Phase 2 */}
          <div class="relative md:grid md:grid-cols-2 md:gap-12 items-start">
            <div class="md:text-right md:pr-8">
              <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/10 text-accent rounded-full mb-3">
                Month 3–6
              </span>
              <h3 class="font-heading text-xl text-text mb-2">Grow and scale</h3>
            </div>
            <div class="md:pl-8 mt-3 md:mt-0">
              <div class="bg-white rounded-card p-5 border border-border">
                <ul class="space-y-2 text-sm text-text-muted">
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> More products and order bumps — higher order value</li>
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> Optimise ads on proven messages</li>
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> Convert product buyers into coaching or programme clients</li>
                </ul>
                <p class="text-xs text-accent font-medium mt-4">Goal: predictable lead flow and scalable revenue</p>
              </div>
            </div>
            <div class="hidden md:flex absolute left-1/2 top-3 -translate-x-1/2 w-8 h-8 rounded-full bg-accent text-white items-center justify-center text-sm font-heading">2</div>
          </div>

          {/* Phase 3 */}
          <div class="relative md:grid md:grid-cols-2 md:gap-12 items-start">
            <div class="md:text-right md:pr-8">
              <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-primary/10 text-primary rounded-full mb-3">
                Month 6+
              </span>
              <h3 class="font-heading text-xl text-text mb-2">Authority and competitive edge</h3>
            </div>
            <div class="md:pl-8 mt-3 md:mt-0">
              <div class="bg-white rounded-card p-5 border border-border">
                <ul class="space-y-2 text-sm text-text-muted">
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> Platform or community — recurring revenue</li>
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> AI visibility — get found by ChatGPT and Gemini</li>
                  <li class="flex items-start gap-2"><span class="text-accent mt-0.5">→</span> Industry authority competitors can no longer catch up to</li>
                </ul>
                <p class="text-xs text-accent font-medium mt-4">Goal: market leader in your niche — online and offline</p>
              </div>
            </div>
            <div class="hidden md:flex absolute left-1/2 top-3 -translate-x-1/2 w-8 h-8 rounded-full bg-primary text-white items-center justify-center text-sm font-heading">3</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── Social Proof — WhatsApp ── */}
  <section class="py-16 md:py-20 bg-primary">
    <div class="max-w-4xl mx-auto px-4 md:px-6 text-center">
      <h2 class="font-heading text-2xl md:text-3xl text-white mb-10">
        Results from current clients
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white/10 backdrop-blur rounded-card overflow-hidden border border-white/20">
          <div class="aspect-[3/4] overflow-hidden">
            <Image src={claireWhatsApp} alt="WhatsApp message from Claire — record day with 26 orders" widths={[300, 400]} sizes="(max-width: 768px) 100vw, 33vw" class="w-full h-full object-cover object-top" loading="lazy" decoding="async" />
          </div>
          <div class="p-4">
            <p class="font-medium text-white">Claire — ikrouwvanje.nl</p>
            <p class="text-sm text-white/70">+25% more clients</p>
          </div>
        </div>
        <div class="bg-white/10 backdrop-blur rounded-card overflow-hidden border border-white/20">
          <div class="aspect-[3/4] overflow-hidden">
            <Image src={tessaWhatsApp} alt="WhatsApp message from Tessa — 7.2x ROAS on campaigns" widths={[300, 400]} sizes="(max-width: 768px) 100vw, 33vw" class="w-full h-full object-cover object-top" loading="lazy" decoding="async" />
          </div>
          <div class="p-4">
            <p class="font-medium text-white">Tessa — Youlife</p>
            <p class="text-sm text-white/70">7.2× ROAS on ads</p>
          </div>
        </div>
        <div class="bg-white/10 backdrop-blur rounded-card overflow-hidden border border-white/20">
          <div class="aspect-[3/4] overflow-hidden">
            <Image src={rolfWhatsApp} alt="WhatsApp message from Rolf — Happy With Yoga results" widths={[300, 400]} sizes="(max-width: 768px) 100vw, 33vw" class="w-full h-full object-cover object-top" loading="lazy" decoding="async" />
          </div>
          <div class="p-4">
            <p class="font-medium text-white">Rolf — Happy With Yoga</p>
            <p class="text-sm text-white/70">2,000 paying members</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── Cases ── */}
  <section class="py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-4">
        Three clients, three phases on the same growth curve
      </h2>
      <p class="text-lg text-text-muted leading-relaxed mb-10 max-w-3xl">
        Different niches, same principle: turning expertise into products, ads and recurring revenue. They're just at different points on the curve.
      </p>

      <div class="space-y-6">
        {/* Josine */}
        <div class="bg-white rounded-card border border-border overflow-hidden hover:shadow-lg transition-shadow">
          <div class="md:grid md:grid-cols-[280px_1fr]">
            <div class="aspect-[4/3] md:aspect-auto overflow-hidden bg-bg-alt">
              <Image src={josineScreenshot} alt="Coach Josine — Eating Struggle Guide product page" widths={[280, 400]} sizes="(max-width: 768px) 100vw, 280px" class="w-full h-full object-cover" loading="lazy" decoding="async" />
            </div>
            <div class="p-6">
              <div class="flex items-center gap-3 mb-3">
                <span class="inline-flex items-center px-2.5 py-0.5 text-xs font-medium bg-primary/10 text-primary rounded-full">First traction</span>
                <span class="text-xs text-text-muted">Since Oct 2025</span>
              </div>
              <h3 class="font-heading text-lg text-text mb-2">Coach Josine — 600× guides sold in week 1</h3>
              <p class="text-sm text-text-muted leading-relaxed mb-4">
                Expertise and audience were already there. What was missing: a digital product and launch structure. Within 7 weeks: guide live, 80 masterclass sign-ups, first recurring clients.
              </p>
              <div class="flex flex-wrap gap-3">
                <span class="inline-flex items-center px-3 py-1 text-xs bg-bg-alt rounded-full"><strong class="text-accent mr-1">600×</strong> guides sold</span>
                <span class="inline-flex items-center px-3 py-1 text-xs bg-bg-alt rounded-full"><strong class="text-accent mr-1">80</strong> masterclass sign-ups</span>
              </div>
              <a href="/en/cases/coach-josine/" class="inline-flex items-center text-accent hover:text-accent-dark transition-colors text-sm font-medium mt-4">
                Read the case
                <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
              </a>
            </div>
          </div>
        </div>

        {/* Tessa */}
        <div class="bg-white rounded-card border border-border overflow-hidden hover:shadow-lg transition-shadow">
          <div class="md:grid md:grid-cols-[280px_1fr]">
            <div class="aspect-[4/3] md:aspect-auto overflow-hidden bg-bg-alt">
