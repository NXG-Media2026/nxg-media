---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import Quiz from '../../components/Quiz';
import { siteConfig } from '../../data/site';
import { generateBreadcrumbs } from '../../data/schema';
import { t, localizePath } from '../../i18n/utils';
import { buildHreflangPair } from '../../i18n/hreflang';

const locale = 'en';

const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: localizePath('/', locale) },
  { label: t('quiz.heading', locale) },
];

const breadcrumbSchema = breadcrumbs.map((b) => ({
  name: b.label,
  url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}/en/quiz`,
}));
---

<BaseLayout
  title={`${t('quiz.heading', locale)} | ${siteConfig.name}`}
  description="Find out which hormone type you are — with the free quiz from doc.veri. 7 questions, personalized result."
  hreflang={buildHreflangPair('/quiz', '/en/quiz')}
  schemas={[generateBreadcrumbs(breadcrumbSchema)]}
  locale="en"
>
  <BreadcrumbNav items={breadcrumbs} />

  <section class="py-16 md:py-24 lg:py-32 bg-bg">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <div class="text-center mb-14 md:mb-20">
        <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/10 text-accent rounded-full mb-4">
          Free & no commitment
        </span>
        <h1 class="font-heading text-4xl md:text-5xl text-text mb-4">
          {t('quiz.heading', locale)}
        </h1>
        <p class="text-lg text-text-muted max-w-2xl mx-auto">
          Answer 7 short questions and find out which hormone type you are — with personalized recommendations from Dr. Verena.
        </p>
      </div>

      <Quiz client:load locale="en" />
    </div>
  </section>
</BaseLayout>
