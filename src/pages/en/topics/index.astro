---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTABand from '../../../components/CTABand.astro';
import { siteConfig } from '../../../data/site';
import { generateCollectionPage, generateBreadcrumbs } from '../../../data/schema';
import { t, localizePath, getCollectionBasePath } from '../../../i18n/utils';
import { buildHreflangPair } from '../../../i18n/hreflang';
import { getAllClusters, getClusterLocalized } from '../../../lib/clusters';
import { trackOnClick } from '../../../lib/analytics';

const locale = 'en';
const topicsBase = getCollectionBasePath('themen', locale);

const allClusters = getAllClusters();
const enClusters = allClusters
  .filter((c) => c.locales?.en)
  .map((c) => getClusterLocalized(c.slug, 'en')!)
  .filter(Boolean);

const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: localizePath('/', locale) },
  { label: t('breadcrumb.themen', locale) },
];

const breadcrumbSchema = breadcrumbs.map((b) => ({
  name: b.label,
  url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}${topicsBase}`,
}));
---

<BaseLayout
  title={`Topics | ${siteConfig.name}`}
  description="Evidence-based topics on women's health: hormones, nutrition, training, cycle, and more — by Dr. Verena."
  hreflang={buildHreflangPair('/themen', '/en/topics')}
  schemas={[
    generateCollectionPage({
      name: 'Topics',
      url: `${siteConfig.url}${topicsBase}`,
      description: "Evidence-based topics on women's health: hormones, nutrition, training, cycle, and more.",
    }),
    generateBreadcrumbs(breadcrumbSchema),
  ]}
  locale="en"
>
  <BreadcrumbNav items={breadcrumbs} />

  <section class="py-16 md:py-24 lg:py-32 bg-bg">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <div class="text-center mb-14 md:mb-20">
        <h1 class="font-heading text-4xl md:text-5xl text-text mb-4">
          Topics
        </h1>
        <p class="text-lg text-text-muted max-w-2xl mx-auto">
          Evidence-based knowledge on the most important topics in women's health — clear, practical, and science-backed.
        </p>
      </div>

      {enClusters.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {enClusters.map((cluster, idx) => (
            <a
              href={`${topicsBase}/${cluster.hubSlug}`}
              class:list={[
                'group block bg-white border border-border rounded-card overflow-hidden',
                'hover:border-accent/30 hover:shadow-xl transition-all duration-300',
                'js-reveal',
              ]}
              style={`--reveal-delay: ${idx * 100}ms`}
            >
              {cluster.heroImage && cluster.heroImage.trim() !== '' && (
                <div class="aspect-[16/10] overflow-hidden">
                  <img
                    src={cluster.heroImage}
                    alt={cluster.title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}
              <div class="p-6 md:p-8">
                <h2 class="font-heading text-xl md:text-2xl text-text mb-3 group-hover:text-accent transition-colors">
                  {cluster.title}
                </h2>
                <p class="text-sm text-text-muted leading-relaxed mb-4">
                  {cluster.citableDefinition.length > 160
                    ? cluster.citableDefinition.slice(0, 160) + '…'
                    : cluster.citableDefinition}
                </p>
                <div class="flex items-center justify-end">
                  <span class="inline-flex items-center text-sm font-medium text-accent-dark group-hover:underline underline-offset-2">
                    {t('cta.learnMore', locale)}
                    <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <p class="text-text-muted">Topics will be published soon.</p>
        </div>
      )}
    </div>
  </section>

  <section class="py-12 md:py-16">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <div class="bg-primary-dark rounded-card p-8 md:p-10 text-center">
        <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/20 text-accent-light rounded-full mb-4">
          Free Masterclass
        </span>
        <h2 class="font-heading text-2xl md:text-3xl text-white mb-3">
          Hormones, Histamine &amp; Your Cycle as a Superpower
        </h2>
        <p class="text-white/70 max-w-2xl mx-auto mb-6">
          How hormones, your cycle, histamine, and stress are connected — and what first steps actually make sense. Free.
        </p>
        <a
          href="/en/masterclass/hormones-histamine-cycle-superpower"
          class="inline-flex items-center px-6 py-3 text-sm font-medium text-primary bg-white hover:bg-bg-alt rounded-button transition-colors"
          onclick={trackOnClick('masterclass_cta_click', {
            page_type: 'pillar',
            page_slug: '/en/topics',
            locale: 'en',
            masterclass_slug: 'hormones-histamine-cycle-superpower',
            cta_location: 'inline',
          })}
        >
          Join the waitlist
          <svg class="ml-2 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <CTABand
    title="Want to go deeper?"
    subtitle="Discover my products and coaching — evidence-based and tailored to you."
    ctaText="Explore offers"
    ctaHref="/en/offers"
    eventName="product_cta_click"
    locale="en"
    pageType="pillar"
    pageSlug="/en/topics"
  />
</BaseLayout>
