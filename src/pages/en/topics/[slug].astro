---
import ClusterHubLayout from '../../../layouts/ClusterHubLayout.astro';
import { getAllClusters, getClusterLocalized } from '../../../lib/clusters';

export async function getStaticPaths() {
  const clusters = getAllClusters();
  const paths: Array<{
    params: { slug: string };
    props: { cluster: any };
  }> = [];

  for (const base of clusters) {
    const localized = getClusterLocalized(base.slug, 'en');
    if (!localized || !localized.locales?.en) continue;
    paths.push({
      params: { slug: localized.hubSlug },
      props: { cluster: localized },
    });
  }

  return paths;
}

const { cluster } = Astro.props;
---

<ClusterHubLayout cluster={cluster} locale="en" />
