---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import CalendlyEmbed from '../../components/CalendlyEmbed.astro';
import { siteConfig } from '../../data/site';
import { generateProfilePage, generateFounderPerson, generateBreadcrumbs } from '../../data/schema';
import { t, localizePath } from '../../i18n/utils';
import { buildHreflangTrilingual } from '../../i18n/hreflang';
import founderPhoto from '../../assets/images/founder/joost-sitting-laptop-looking-working.webp';
import founderRelaxed from '../../assets/images/founder/joost-standing-relaxed.webp';

const locale = 'en';
const hreflang = buildHreflangTrilingual('/over-joost/', '/en/about-joost/', '/es/sobre-joost/');
const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: localizePath('/', locale) },
  { label: 'About Joost' },
];
const breadcrumbSchema = [
  { name: t('breadcrumb.home', locale), url: `${siteConfig.url}${localizePath('/', locale)}` },
  { name: 'About Joost', url: `${siteConfig.url}/en/about-joost` },
];
---

<BaseLayout
  title={`About Joost | ${siteConfig.name}`}
  description="Joost van Putten — founder of NXG Media. Builds online growth systems for coaches, experts and local practices. 7+ years experience, €5M+ ads managed."
  schemas={[generateProfilePage(), generateFounderPerson(locale), generateBreadcrumbs(breadcrumbSchema)]}
  locale={locale}
  hreflang={hreflang}
>
  <BreadcrumbNav items={breadcrumbs} />

  {/* ── 1. Hero ── */}
  <section class="bg-primary text-white py-16 md:py-24">
    <div class="max-w-[1260px] mx-auto px-5 md:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div class="flex justify-center lg:justify-start">
          <Image
            src={founderPhoto}
            alt="Joost van Putten — founder of NXG Media, builds online growth systems for coaches and experts"
            widths={[300, 450, 600]}
            sizes="(max-width: 768px) 300px, 450px"
            class="rounded-xl shadow-2xl w-full max-w-[420px]"
            loading="eager"
          />
        </div>
        <div>
          <p class="eyebrow light mb-4">ABOUT JOOST</p>
          <h1 class="font-heading font-extrabold text-4xl md:text-[3.5rem] leading-[0.98] text-white mb-6 uppercase">
            The person behind<br />
            <span class="text-accent">the system.</span>
          </h1>
          <p class="text-xl text-white/80 mb-4">{siteConfig.founder.description[locale]}</p>
          <p class="text-white/60 text-sm">50+ coaches & businesses guided · €5M+ ads managed · 7+ years experience</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── 2. Why NXG Media exists ── */}
  <section class="py-[104px]">
    <div class="max-w-[1260px] mx-auto px-5 md:px-8">
      <div class="max-w-3xl">
        <p class="eyebrow text-primary mb-4">THE STORY</p>
        <h2 class="font-heading font-extrabold text-3xl md:text-[2.5rem] leading-[0.98] text-text mb-8 uppercase">Why NXG Media exists</h2>
        <div class="space-y-5 text-text-muted leading-relaxed">
          <p>NXG Media grew out of a pattern Joost saw for years: coaches and experts who were brilliant at their craft but stuck online. They tried social media, hired a freelancer for ads, or bought an online course about funnels — but nothing connected.</p>
          <p>The problem was never that they did too little. The problem was that nobody built them a complete growth system — designed around how their clients actually make decisions. No agency understood how a coaching client thinks.</p>
          <p>NXG Media was built to close that gap: one partner that combines storytelling, product ladders, email flows, ads and AI visibility into a system that consistently generates clients — without the expert having to become a marketer themselves.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── 3. Client patterns — dark section ── */}
  <section class="bg-bg-dark text-white py-[104px]">
    <div class="max-w-[1260px] mx-auto px-5 md:px-8">
      <p class="eyebrow light mb-4">THE PATTERN</p>
      <h2 class="font-heading font-extrabold text-3xl md:text-[2.5rem] leading-[0.98] text-white mb-10 uppercase">What I keep seeing</h2>
      <div class="grid md:grid-cols-2 gap-6">
        <div class="p-6 bg-white/5 rounded-xl border border-white/10">
          <span class="text-accent text-xl font-bold mb-3 block">→</span>
          <p class="text-white/70">Great expertise, but a website that generates nothing. No clear path from visitor to client.</p>
        </div>
        <div class="p-6 bg-white/5 rounded-xl border border-white/10">
          <span class="text-accent text-xl font-bold mb-3 block">→</span>
          <p class="text-white/70">Ads running without a system behind them. Money going to Meta Ads without an email flow, without a warm-up product.</p>
        </div>
        <div class="p-6 bg-white/5 rounded-xl border border-white/10">
          <span class="text-accent text-xl font-bold mb-3 block">→</span>
          <p class="text-white/70">Creating content without strategy. Posting on Instagram every week, but without contributing to visibility or sales.</p>
        </div>
        <div class="p-6 bg-white/5 rounded-xl border border-white/10">
          <span class="text-accent text-xl font-bold mb-3 block">→</span>
          <p class="text-white/70">Invisible to AI assistants. ChatGPT and Gemini recommend competitors, while you have more experience.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── 4. What I believe — side-by-side ── */}
  <section class="py-[104px]">
    <div class="max-w-[1260px] mx-auto px-5 md:px-8">
      <div class="grid lg:grid-cols-[1fr_2fr] gap-12 lg:gap-20">
        <div>
          <p class="eyebrow text-primary mb-4">BELIEFS</p>
          <h2 class="font-heading font-extrabold text-3xl md:text-[2.5rem] leading-[0.98] text-text uppercase">
            What I<br />
            <span class="marker">believe.</span>
          </h2>
        </div>
        <div class="space-y-8">
          <div>
            <h3 class="font-heading font-extrabold text-lg text-text mb-2">Systems over individual tactics</h3>
            <p class="text-text-muted leading-relaxed">A single good ad or viral post changes nothing structurally. Growth comes from the combination: storytelling that connects, a product ladder that fits the customer journey, email flows that build trust, and ads that accelerate the system.</p>
          </div>
          <div>
            <h3 class="font-heading font-extrabold text-lg text-text mb-2">Storytelling over pushing</h3>
            <p class="text-text-muted leading-relaxed">People don't buy from experts because they're "the best." They buy because they feel understood. The marketing message must start with what the client feels.</p>
          </div>
          <div>
            <h3 class="font-heading font-extrabold text-lg text-text mb-2">AI visibility is now, not later</h3>
            <p class="text-text-muted leading-relaxed">More and more people ask ChatGPT or Google AI for answers instead of searching Google. Those who aren't visible to AI now are missing a growing share of their market.</p>
          </div>
          <div>
            <h3 class="font-heading font-extrabold text-lg text-text mb-2">Partnership, not projects</h3>
            <p class="text-text-muted leading-relaxed">Building a website and disappearing doesn't work. Online growth is an ongoing process of testing, optimizing and expanding. NXG Media works as a strategic partner.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── 5. Background ── */}
  <section class="bg-bg-alt py-[104px]">
    <div class="max-w-[1260px] mx-auto px-5 md:px-8">
      <p class="eyebrow text-primary mb-4">BACKGROUND</p>
      <h2 class="font-heading font-extrabold text-3xl md:text-[2.5rem] leading-[0.98] text-text mb-10 uppercase">Background & track record</h2>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4 mb-10">
        {siteConfig.founder.qualifications[locale].map((q) => (
          <div class="flex items-start gap-3 p-5 bg-white rounded-xl border border-border">
            <svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span class="text-text text-sm">{q}</span>
          </div>
        ))}
      </div>
      {siteConfig.founder.credentials.length > 0 && (
        <div>
          <h3 class="font-heading font-extrabold text-lg text-text mb-4">Certifications</h3>
          <div class="flex flex-wrap gap-3">
            {siteConfig.founder.credentials.map((c) => (
              <span class="inline-flex items-center gap-2 px-4 py-2 bg-white rounded-full text-sm text-text border border-border">
                <svg class="w-4 h-4 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342" />
                </svg>
                {c.name} — {c.issuer} ({c.year})
              </span>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  {/* ── 6. The NXG method — blue section ── */}
  <section class="bg-primary text-white py-[104px]">
    <div class="max-w-[1260px] mx-auto px-5 md:px-8">
      <p class="eyebrow light mb-4">THE METHOD</p>
      <h2 class="font-heading font-extrabold text-3xl md:text-[2.5rem] leading-[0.98] text-white mb-6 uppercase">How it works</h2>
      <p class="text-white/70 text-base leading-relaxed mb-12 max-w-2xl">Every engagement at NXG Media follows the same logic. No magic bullets, but a proven approach in four steps.</p>
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-6 bg-white/5 rounded-xl border border-white/10">
          <span class="font-heading font-extrabold text-5xl text-accent/40 mb-3 block">1</span>
          <h3 class="font-heading font-extrabold text-lg text-white mb-2">Diagnosis</h3>
          <p class="text-white/60 text-sm">Analysis of your current online presence: website, funnel, content, visibility and conversion path.</p>
        </div>
        <div class="p-6 bg-white/5 rounded-xl border border-white/10">
          <span class="font-heading font-extrabold text-5xl text-accent/40 mb-3 block">2</span>
          <h3 class="font-heading font-extrabold text-lg text-white mb-2">System design</h3>
          <p class="text-white/60 text-sm">Growth system: storytelling, product ladder, email flows and ad strategy — tailored to your client.</p>
        </div>
        <div class="p-6 bg-white/5 rounded-xl border border-white/10">
          <span class="font-heading font-extrabold text-5xl text-accent/40 mb-3 block">3</span>
          <h3 class="font-heading font-extrabold text-lg text-white mb-2">Implementation</h3>
          <p class="text-white/60 text-sm">Landing pages, email sequences, ads, tracking and AI visibility. Everything connected.</p>
        </div>
        <div class="p-6 bg-white/5 rounded-xl border border-white/10">
          <span class="font-heading font-extrabold text-5xl text-accent/40 mb-3 block">4</span>
          <h3 class="font-heading font-extrabold text-lg text-white mb-2">Optimization</h3>
          <p class="text-white/60 text-sm">Data-driven adjustments: which ads perform, which emails convert, where do people drop off?</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── 7. Personal / real-life ── */}
  <section class="py-[104px]">
    <div class="max-w-[1260px] mx-auto px-5 md:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <p class="eyebrow text-primary mb-4">OUTSIDE WORK</p>
          <h2 class="font-heading font-extrabold text-3xl md:text-[2.5rem] leading-[0.98] text-text mb-8 uppercase">The person behind the brand</h2>
          <p class="text-text-muted leading-relaxed mb-4">
            Joost works from Valencia and the Netherlands — a combination that fits how he thinks about marketing: flexible, international and without unnecessary overhead. No office with ten people, but a lean team that moves fast.
          </p>
          <p class="text-text-muted leading-relaxed">
            Outside of work, you'll find him on the padel court, in the mountains around Valencia, or experimenting with new AI tools. That curiosity about technology carries into the work: NXG Media continuously tests new ways to make coaches and experts more visible.
          </p>
        </div>
        <div class="flex justify-center lg:justify-end">
          <Image
            src={founderRelaxed}
            alt="Joost van Putten — works from Valencia and the Netherlands"
            widths={[300, 450]}
            sizes="(max-width: 768px) 300px, 400px"
            class="rounded-xl shadow-2xl w-full max-w-[380px]"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </section>

  {/* ── 8. CTA ── */}
  <section class="bg-accent py-16 md:py-20">
    <div class="max-w-[1260px] mx-auto px-5 md:px-8 flex flex-col md:flex-row items-center justify-between gap-8">
      <div>
        <h2 class="font-heading font-extrabold text-3xl md:text-[2.5rem] leading-[0.98] text-text uppercase">
          Ready to grow?<br />
          <span class="text-primary">Let's talk.</span>
        </h2>
      </div>
      <a
        href="/en/contact/"
        class="inline-flex items-center gap-2 px-6 py-[15px] text-[15px] font-extrabold text-white bg-text hover:bg-primary transition-colors rounded-button shrink-0"
      >
        Book a free strategy call
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

  <CalendlyEmbed pageType="about" pageSlug="about-joost" locale={locale} />
</BaseLayout>
