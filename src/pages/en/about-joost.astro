---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalendlyEmbed from '../../components/CalendlyEmbed.astro';
import { siteConfig } from '../../data/site';
import { generateProfilePage, generateFounderPerson } from '../../data/schema';

const locale = 'en';
---

<BaseLayout
  title={`About Joost | ${siteConfig.name}`}
  description="Joost van Putten — founder of NXG Media. Builds online growth systems for coaches, experts and local practices."
  schemas={[generateProfilePage(), generateFounderPerson()]}
  locale={locale}
>
  <section class="py-12 md:py-16 lg:py-20">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl text-text mb-6">About Joost</h1>
      <p class="text-lg text-text-muted leading-relaxed mb-6">{siteConfig.founder.description}</p>
    </div>
  </section>
  <CalendlyEmbed pageType="about" pageSlug="about-joost" locale={locale} />
</BaseLayout>
