---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import CalendlyEmbed from '../../components/CalendlyEmbed.astro';
import { siteConfig } from '../../data/site';
import { generateProfilePage, generateFounderPerson, generateBreadcrumbs } from '../../data/schema';
import { t, localizePath } from '../../i18n/utils';
import { buildHreflangTrilingual } from '../../i18n/hreflang';
import founderPhoto from '../../assets/images/founder/joost-sitting-laptop-looking-working.webp';
import founderRelaxed from '../../assets/images/founder/joost-standing-relaxed.webp';

const locale = 'en';
const hreflang = buildHreflangTrilingual('/over-joost/', '/en/about-joost/', '/es/sobre-joost/');
const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: localizePath('/', locale) },
  { label: 'About Joost' },
];
const breadcrumbSchema = [
  { name: t('breadcrumb.home', locale), url: `${siteConfig.url}${localizePath('/', locale)}` },
  { name: 'About Joost', url: `${siteConfig.url}/en/about-joost` },
];
---

<BaseLayout
  title={`About Joost | ${siteConfig.name}`}
  description="Joost van Putten — founder of NXG Media. Builds online growth systems for coaches, experts, local SMEs and practices. 7+ years experience, €5M+ ads managed."
  schemas={[generateProfilePage(), generateFounderPerson(locale), generateBreadcrumbs(breadcrumbSchema)]}
  locale={locale}
  hreflang={hreflang}
>
  <BreadcrumbNav items={breadcrumbs} />

<section class="refresh-hero refresh-about"><div class="refresh-wrap refresh-split"><div><p class="refresh-eyebrow">THE PERSON BEHIND NXG-MEDIA</p><h1>HI, I'M JOOST.<br /><span>I BUILD WITH YOU.</span></h1><p>For over 7 years I've been helping entrepreneurs with online marketing. From campaigns to websites: I want to know what it delivers for the business behind it.</p><p>I work with SMEs, practices and service providers as well as coaches and experts. You're great at your craft. I help you translate that expertise online into a clear approach for growth.</p><a class="refresh-button" href="/en/contact/">Let's get acquainted <span aria-hidden="true">↗</span></a></div><figure><Image src={founderPhoto} alt="Joost van Putten at work" width={620} loading="eager" fetchpriority="high" /><figcaption>Joost van Putten · Founder NXG-media</figcaption></figure></div></section>
<section class="py-10 md:py-14 bg-bg-alt"><div class="max-w-3xl mx-auto px-4 md:px-6"><h2 class="font-heading mb-6">Great at your craft. An approach to match.</h2><p class="text-text-muted leading-relaxed mb-4">A practice wants new patients. A trade business wants fitting enquiries. A coach wants to reach people who match their programme. The goal differs, but the question behind it is one I recognise: how do you turn your expertise into a business that gets found and chosen online?</p><p class="text-text-muted leading-relaxed">That's where I help. With a clear website, findability, campaigns and follow-up that all work towards the same goal. I look at your business, your audience and what you need to keep growing.</p></div></section>
<section class="py-10 md:py-14"><div class="max-w-3xl mx-auto px-4 md:px-6"><h2 class="font-heading mb-6">Who I work with</h2><div class="grid md:grid-cols-2 gap-6"><article class="p-6 bg-bg-alt rounded-card"><h3 class="font-heading mb-4">SMEs, practices and service providers</h3><p class="text-text-muted mb-5">From installers and estate agents to dentists, clinics and other local service providers. With NXG Growth we connect AI findability, AI Search Ads and a website that guides visitors towards an enquiry.</p><a class="text-primary font-bold" href="/en/landermkb/">View the SME approach ↗</a></article><article class="p-6 bg-bg-alt rounded-card"><h3 class="font-heading mb-4">Coaches and experts</h3><p class="text-text-muted mb-5">For entrepreneurs who sell their knowledge and guidance. With Coach Accelerator we work on the coherence between positioning, offer, campaigns and follow-up.</p><a class="text-primary font-bold" href="/en/coach-accelerator/">View Coach Accelerator ↗</a></article></div></div></section>
<section class="py-10 md:py-14 bg-bg-alt"><div class="max-w-3xl mx-auto px-4 md:px-6"><h2 class="font-heading mb-6">How I work</h2><div class="space-y-6"><div><h3 class="font-heading mb-2">First understand your business</h3><p class="text-text-muted">Who do you want to reach, what is a client worth and where are things getting stuck? That determines the approach.</p></div><div><h3 class="font-heading mb-2">Make everything work together</h3><p class="text-text-muted">We connect your website, message, findability and campaigns. For a practice that might look different than for a coach.</p></div><div><h3 class="font-heading mb-2">Measure and improve</h3><p class="text-text-muted">We look at enquiries and quality, discuss what it delivers and adjust. The goal, the investment and any guarantee are agreed upfront.</p></div></div></div></section>
<section class="py-10 md:py-14"><div class="max-w-3xl mx-auto px-4 md:px-6"><h2 class="font-heading mb-6">Experience I bring</h2><p class="text-text-muted mb-6">For over 7 years I've worked in online marketing: from ad campaigns and websites to content, funnels and AI findability. The client cases show how that experience is applied across different businesses.</p><a class="text-primary font-bold" href="/en/cases/">View the work and results ↗</a><h3 class="font-heading mt-8 mb-4">Certifications</h3><ul class="space-y-2">{siteConfig.founder.credentials.map(c=><li class="text-text-muted">{c.name} · {c.issuer} ({c.year})</li>)}</ul></div></section>
<section class="py-10 md:py-14 bg-bg-alt"><div class="max-w-3xl mx-auto px-4 md:px-6"><div class="flex flex-col md:flex-row gap-8 items-start"><Image src={founderRelaxed} alt="Joost van Putten" width={280} class="rounded-card w-56 shrink-0" loading="lazy" /><div><h2 class="font-heading mb-4">Curious outside of work too</h2><p class="text-text-muted leading-relaxed mb-4">I work from Valencia and the Netherlands. Outside of work you'll find me on the padel court, in the mountains around Valencia or experimenting with new AI tools.</p><p class="text-text-muted leading-relaxed">That curiosity carries into my work: exploring new possibilities and seeing what they can mean for the entrepreneurs I work with.</p></div></div></div></section>
<CalendlyEmbed pageType="about" pageSlug="about-joost" locale={locale} title="Tell me about your business." subtitle="SME, practice, service provider, coach or expert: we'll look together at which approach fits." />
</BaseLayout>
