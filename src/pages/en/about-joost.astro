---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import CalendlyEmbed from '../../components/CalendlyEmbed.astro';
import { siteConfig } from '../../data/site';
import { generateProfilePage, generateFounderPerson, generateBreadcrumbs } from '../../data/schema';
import { t, localizePath } from '../../i18n/utils';
import founderPhoto from '../../assets/images/Founder/joost-sitting-laptop-looking-working.webp';
import founderRelaxed from '../../assets/images/Founder/joost-standing-relaxed.webp';

const locale = 'en';
const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: localizePath('/', locale) },
  { label: 'About Joost' },
];
const breadcrumbSchema = [
  { name: t('breadcrumb.home', locale), url: `${siteConfig.url}${localizePath('/', locale)}` },
  { name: 'About Joost', url: `${siteConfig.url}/en/about-joost` },
];
---

<BaseLayout
  title={`About Joost | ${siteConfig.name}`}
  description="Joost van Putten — founder of NXG Media. Builds online growth systems for coaches, experts and local practices. 7+ years experience, €5M+ ads managed."
  schemas={[generateProfilePage(), generateFounderPerson(locale), generateBreadcrumbs(breadcrumbSchema)]}
  locale={locale}
>
  <BreadcrumbNav items={breadcrumbs} />

  {/* ── 1. Hero with positioning ── */}
  <section class="py-12 md:py-16 lg:py-20">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <div class="flex flex-col md:flex-row gap-8 items-start mb-10">
        <Image
          src={founderPhoto}
          alt="Joost van Putten — founder of NXG Media, builds online growth systems for coaches and experts"
          widths={[200, 300, 400]}
          sizes="(max-width: 768px) 200px, 300px"
          class="rounded-card shadow-lg w-48 md:w-64 shrink-0"
          loading="eager"
        />
        <div>
          <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl text-text mb-4">About Joost</h1>
          <p class="text-xl text-accent font-medium mb-4">The person behind the system that gives 50+ coaches predictable growth.</p>
          <p class="text-lg text-text-muted leading-relaxed">{siteConfig.founder.description[locale]}</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── 2. Why NXG Media exists — origin story ── */}
  <section class="py-10 md:py-14 bg-bg-alt">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-6">Why NXG Media exists</h2>
      <p class="text-text-muted leading-relaxed mb-4">
        NXG Media grew out of a pattern Joost saw for years: coaches and experts who were brilliant at their craft but stuck online. They tried social media, hired a freelancer for ads, or bought an online course about funnels — but nothing connected. Every new attempt was an isolated tactic without a system behind it.
      </p>
      <p class="text-text-muted leading-relaxed mb-4">
        The problem was never that they did too little. The problem was that nobody built them a complete growth system — designed around how their clients actually make decisions. No agency understood how a coaching client thinks. No marketer grasped that a €3,000 program can't be sold with a simple ad.
      </p>
      <p class="text-text-muted leading-relaxed">
        NXG Media was built to close that gap: one partner that combines storytelling, product ladders, email flows, ads and AI visibility into a system that consistently generates clients — without the expert having to become a marketer themselves.
      </p>
    </div>
  </section>

  {/* ── 3. What he noticed — client patterns ── */}
  <section class="py-10 md:py-14">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-6">What I keep seeing with coaches and experts</h2>
      <div class="space-y-4">
        <div class="flex items-start gap-4 p-4 bg-bg-alt rounded-card">
          <span class="text-accent text-xl font-bold shrink-0 mt-0.5">→</span>
          <p class="text-text-muted">Great expertise, but a website that generates nothing. No clear path from visitor to client. The site explains what the coach does, but not why someone should act now.</p>
        </div>
        <div class="flex items-start gap-4 p-4 bg-bg-alt rounded-card">
          <span class="text-accent text-xl font-bold shrink-0 mt-0.5">→</span>
          <p class="text-text-muted">Ads running without a system behind them. Money going to Meta Ads without an email flow, without a warm-up product, without retargeting. Costs go up, but conversions stay flat.</p>
        </div>
        <div class="flex items-start gap-4 p-4 bg-bg-alt rounded-card">
          <span class="text-accent text-xl font-bold shrink-0 mt-0.5">→</span>
          <p class="text-text-muted">Creating content without strategy. Posting on Instagram every week, but without contributing to visibility, authority or sales. It feels like a chore, not a growth engine.</p>
        </div>
        <div class="flex items-start gap-4 p-4 bg-bg-alt rounded-card">
          <span class="text-accent text-xl font-bold shrink-0 mt-0.5">→</span>
          <p class="text-text-muted">Invisible to AI assistants. ChatGPT, Gemini and Perplexity recommend competitors, while the expert with more experience doesn't even appear in the answers.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── 4. Expert point of view ── */}
  <section class="py-10 md:py-14 bg-bg-alt">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-6">What I believe</h2>
      <div class="space-y-6">
        <div>
          <h3 class="font-heading text-lg text-text mb-2">Systems over individual tactics</h3>
          <p class="text-text-muted leading-relaxed">A single good ad or viral post changes nothing structurally. Growth comes from the combination: storytelling that connects, a product ladder that fits the customer journey, email flows that build trust, and ads that accelerate the system.</p>
        </div>
        <div>
          <h3 class="font-heading text-lg text-text mb-2">Storytelling over pushing</h3>
          <p class="text-text-muted leading-relaxed">People don't buy from experts because they're "the best." They buy because they feel understood. The marketing message must start with what the client feels — not with what the coach can do.</p>
        </div>
        <div>
          <h3 class="font-heading text-lg text-text mb-2">AI visibility is now, not later</h3>
          <p class="text-text-muted leading-relaxed">More and more people ask ChatGPT or Google AI for answers instead of searching Google. Those who aren't visible to AI now are missing a growing share of their market — and that gap only gets wider.</p>
        </div>
        <div>
          <h3 class="font-heading text-lg text-text mb-2">No one-off projects, but partnership</h3>
          <p class="text-text-muted leading-relaxed">Building a website and disappearing doesn't work. Online growth is an ongoing process of testing, optimizing and expanding. NXG Media works as a strategic partner, not a vendor that sends an invoice and moves on.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── 5. Professional background ── */}
  <section class="py-10 md:py-14">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-6">Background & track record</h2>
      <div class="grid md:grid-cols-2 gap-6 mb-8">
        {siteConfig.founder.qualifications[locale].map((q) => (
          <div class="flex items-start gap-3 p-4 bg-bg-alt rounded-card">
            <svg class="w-6 h-6 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <span class="text-text">{q}</span>
          </div>
        ))}
      </div>
      {siteConfig.founder.credentials.length > 0 && (
        <div>
          <h3 class="font-heading text-lg text-text mb-3">Certifications</h3>
          <ul class="space-y-2">
            {siteConfig.founder.credentials.map((c) => (
              <li class="flex items-center gap-3 text-text-muted">
                <svg class="w-5 h-5 text-primary shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.26 10.147a60.436 60.436 0 00-.491 6.347A48.627 48.627 0 0112 20.904a48.627 48.627 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.57 50.57 0 00-2.658-.813A59.905 59.905 0 0112 3.493a59.902 59.902 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.697 50.697 0 0112 13.489a50.702 50.702 0 017.74-3.342" />
                </svg>
                <span>{c.name} — {c.issuer} ({c.year})</span>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  {/* ── 6. Expertise areas ── */}
  <section class="py-10 md:py-14 bg-bg-alt">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-6">Expertise</h2>
      <div class="flex flex-wrap gap-3">
        {siteConfig.founder.knowsAbout[locale].map((item) => (
          <span class="inline-flex items-center gap-2 px-4 py-2 bg-white rounded-full text-text shadow-sm border border-gray-100">
            <svg class="w-4 h-4 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
            </svg>
            {item}
          </span>
        ))}
      </div>
    </div>
  </section>

  {/* ── 7. How the method works ── */}
  <section class="py-10 md:py-14">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-6">How it works — the NXG method</h2>
      <p class="text-text-muted leading-relaxed mb-8">Every engagement at NXG Media follows the same logic. No magic bullets, but a proven approach in four steps.</p>
      <div class="space-y-6">
        <div class="flex items-start gap-4">
          <span class="flex items-center justify-center w-10 h-10 rounded-full bg-primary text-white font-bold shrink-0">1</span>
          <div>
            <h3 class="font-heading text-lg text-text mb-1">Diagnosis</h3>
            <p class="text-text-muted">Analysis of your current online presence: website, funnel, content, visibility and conversion path. Where are the leaks? What's missing?</p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <span class="flex items-center justify-center w-10 h-10 rounded-full bg-primary text-white font-bold shrink-0">2</span>
          <div>
            <h3 class="font-heading text-lg text-text mb-1">System design</h3>
            <p class="text-text-muted">Based on the diagnosis, we build a growth system: storytelling, product ladder, email flows and ad strategy — tailored to your client.</p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <span class="flex items-center justify-center w-10 h-10 rounded-full bg-primary text-white font-bold shrink-0">3</span>
          <div>
            <h3 class="font-heading text-lg text-text mb-1">Implementation</h3>
            <p class="text-text-muted">NXG Media builds the system: landing pages, email sequences, ads, tracking and AI visibility. Everything connected, not as separate projects.</p>
          </div>
        </div>
        <div class="flex items-start gap-4">
          <span class="flex items-center justify-center w-10 h-10 rounded-full bg-primary text-white font-bold shrink-0">4</span>
          <div>
            <h3 class="font-heading text-lg text-text mb-1">Optimization</h3>
            <p class="text-text-muted">Data-driven adjustments: which ads perform, which emails convert, where do people drop off? Continuous improvement delivers structurally better results.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── 8. Personal / real-life lens ── */}
  <section class="py-10 md:py-14 bg-bg-alt">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <div class="flex flex-col md:flex-row gap-8 items-start">
        <Image
          src={founderRelaxed}
          alt="Joost van Putten — works from Valencia and the Netherlands"
          widths={[200, 300]}
          sizes="(max-width: 768px) 200px, 250px"
          class="rounded-card shadow-lg w-44 md:w-56 shrink-0"
          loading="lazy"
        />
        <div>
          <h2 class="font-heading text-2xl md:text-3xl text-text mb-4">Outside of work</h2>
          <p class="text-text-muted leading-relaxed mb-4">
            Joost works from Valencia and the Netherlands — a combination that fits how he thinks about marketing: flexible, international and without unnecessary overhead. No office with ten people, but a lean team that moves fast.
          </p>
          <p class="text-text-muted leading-relaxed">
            Outside of work, you'll find him on the padel court, in the mountains around Valencia, or experimenting with new AI tools. That curiosity about technology carries into the work: NXG Media continuously tests new ways to make coaches and experts more visible and discoverable.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* ── 9. Boundaries / disclaimer ── */}
  <section class="py-10 md:py-14">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-6">What NXG Media is not</h2>
      <div class="grid md:grid-cols-2 gap-4">
        <div class="p-4 border border-gray-200 rounded-card">
          <p class="text-text font-medium mb-1">Not a generic web agency</p>
          <p class="text-text-muted text-sm">NXG Media doesn't build standalone websites. Every project is a growth system with strategy, technology and content working together.</p>
        </div>
        <div class="p-4 border border-gray-200 rounded-card">
          <p class="text-text font-medium mb-1">No promises without evidence</p>
          <p class="text-text-muted text-sm">Results vary by situation. The ROAS figures mentioned are averages across 50+ clients — not a guarantee for every individual engagement.</p>
        </div>
        <div class="p-4 border border-gray-200 rounded-card">
          <p class="text-text font-medium mb-1">No one-size-fits-all</p>
          <p class="text-text-muted text-sm">Every system is customized for the expert's market, audience and price point. A yoga coach needs a different system than a business mentor.</p>
        </div>
        <div class="p-4 border border-gray-200 rounded-card">
          <p class="text-text font-medium mb-1">Not a replacement for your expertise</p>
          <p class="text-text-muted text-sm">NXG Media builds the online system — but the content, the offer and the client relationship remain yours. Marketing amplifies what's already there.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── 10. CTA — Calendly ── */}
  <CalendlyEmbed pageType="about" pageSlug="about-joost" locale={locale} />
</BaseLayout>
