---
import { getCollection } from 'astro:content';
import ProductLayout from '../../../layouts/ProductLayout.astro';
import HybridProductLayout from '../../../layouts/HybridProductLayout.astro';

export async function getStaticPaths() {
  const products = await getCollection('produkte');
  const enProducts = products.filter((p) => p.data.locale === 'en');
  return enProducts.map((product) => ({
    params: { slug: product.data.pageSlug },
    props: { entry: product },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const isHybrid = Boolean(entry.data.cluster);
---

{isHybrid ? (
  <HybridProductLayout product={entry.data} locale="en">
    <Content />
  </HybridProductLayout>
) : (
  <ProductLayout product={entry.data} locale="en">
    <Content />
  </ProductLayout>
)}
