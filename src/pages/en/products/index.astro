---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import { siteConfig } from '../../../data/site';
import { t } from '../../../i18n/utils';

const locale = 'en';
const products = (await getCollection('products')).filter((p) => p.data.locale === locale);

const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: '/en/' },
  { label: t('breadcrumb.producten', locale) },
];
---

<BaseLayout title={`Products | ${siteConfig.name}`} description="Practical micro-products for coaches, experts and local practices." locale={locale}>
  <BreadcrumbNav items={breadcrumbs} />
  <section class="py-12 md:py-16 lg:py-20">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h1 class="font-heading text-3xl md:text-4xl text-text mb-10">Products</h1>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {products.map((p) => (
          <a href={`/en/products/${p.data.pageSlug}/`} class="group block bg-white border border-border rounded-card p-6 hover:border-accent/30 hover:shadow-lg transition-all">
            <span class="text-xs font-medium text-accent uppercase tracking-wider mb-2 block">{p.data.cluster}</span>
            <h2 class="font-heading text-lg text-text mb-2 group-hover:text-accent transition-colors">{p.data.title}</h2>
            <p class="text-sm text-text-muted mb-3">{p.data.shortDescription}</p>
            <span class="font-heading font-bold text-text">&euro;{p.data.price}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
