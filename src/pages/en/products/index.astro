---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTABand from '../../../components/CTABand.astro';
import { siteConfig } from '../../../data/site';
import { generateCollectionPage, generateBreadcrumbs } from '../../../data/schema';
import { t, localizePath, getTranslatedPath, getCollectionBasePath } from '../../../i18n/utils';
import { buildHreflangPair } from '../../../i18n/hreflang';

const locale = 'en';
const productsBase = getCollectionBasePath('produkte', locale);

const products = (await getCollection('produkte'))
  .filter((p) => p.data.locale === 'en')
  .sort((a, b) => (a.data.sortOrder ?? 50) - (b.data.sortOrder ?? 50));

const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: localizePath('/', locale) },
  { label: t('breadcrumb.angebot', locale), href: getTranslatedPath('/angebot', locale) },
  { label: t('breadcrumb.produkte', locale) },
];

const breadcrumbSchema = breadcrumbs.map((b) => ({
  name: b.label,
  url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}${productsBase}`,
}));
---

<BaseLayout
  title={`Products | ${siteConfig.name}`}
  description="Digital guides, e-books, and courses for evidence-based women's health — by Dr. Verena."
  hreflang={buildHreflangPair('/produkte', '/en/products')}
  schemas={[
    generateCollectionPage({
      name: 'Products',
      url: `${siteConfig.url}${productsBase}`,
      description: "Digital guides, e-books, and courses for evidence-based women's health.",
    }),
    generateBreadcrumbs(breadcrumbSchema),
  ]}
  locale="en"
>
  <BreadcrumbNav items={breadcrumbs} />

  <section class="py-16 md:py-24 lg:py-32 bg-bg">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <div class="text-center mb-14 md:mb-20">
        <h1 class="font-heading text-4xl md:text-5xl text-text mb-4">
          Products
        </h1>
        <p class="text-lg text-text-muted max-w-2xl mx-auto">
          Digital guides, e-books, and courses — evidence-based and ready to use.
        </p>
      </div>

      {products.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {products.map((product, idx) => (
            <a
              href={`${productsBase}/${product.data.pageSlug}`}
              class:list={[
                'group block bg-white border border-border rounded-card overflow-hidden',
                'hover:border-accent/30 hover:shadow-xl transition-all duration-300',
                'js-reveal',
              ]}
              style={`--reveal-delay: ${idx * 100}ms`}
            >
              {product.data.heroImage && (
                <div class="aspect-[16/10] overflow-hidden">
                  <Image
                    src={product.data.heroImage}
                    alt={`Product cover: ${product.data.title}`}
                    width={600}
                    height={375}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}
              <div class="p-6 md:p-8">
                <h2 class="font-heading text-xl md:text-2xl text-text mb-2 group-hover:text-accent transition-colors">
                  {product.data.title}
                </h2>
                <p class="text-sm text-text-muted leading-relaxed mb-4">
                  {product.data.shortDescription}
                </p>
                <div class="flex items-center justify-between">
                  <span class="text-lg font-semibold text-text">{product.data.price} &euro;</span>
                  <span class="inline-flex items-center text-sm font-medium text-accent-dark group-hover:underline underline-offset-2">
                    {t('cta.learnMore', locale)}
                    <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <p class="text-text-muted">Products will be published soon.</p>
        </div>
      )}
    </div>
  </section>

  <CTABand
    title="Not sure which product is right for you?"
    subtitle="Get in touch — I'm happy to help you choose."
    ctaText="Contact"
    ctaHref={getTranslatedPath('/kontakt', locale)}
    eventName="discovery_call_click"
    locale="en"
    pageType="product"
    pageSlug="/en/products"
  />
</BaseLayout>
