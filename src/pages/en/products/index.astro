---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import { siteConfig } from '../../../data/site';
import { t, localizePath } from '../../../i18n/utils';
import { buildHreflangTrilingual } from '../../../i18n/hreflang';

const locale = 'en';
const hreflang = buildHreflangTrilingual('/producten/', '/en/products/', '/es/productos/');
const products = (await getCollection('products')).filter((p) => p.data.locale === locale);

const coverFiles = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/products/*.{webp,avif,png,jpg}',
  { eager: true },
);

function getCover(filename?: string): ImageMetadata | undefined {
  if (!filename) return undefined;
  const key = `/src/assets/images/products/${filename}`;
  return coverFiles[key]?.default;
}

const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: localizePath('/', locale) },
  { label: t('breadcrumb.producten', locale) },
];
---

<BaseLayout
  title={`Products | ${siteConfig.name}`}
  description="Practical mini-products for coaches, experts and local practices. Get started with proven systems — from €6.99."
  locale={locale}
  hreflang={hreflang}
>
  <BreadcrumbNav items={breadcrumbs} />

  {/* ── Page Intro ── */}
  <section class="py-16 md:py-24">
    <div class="max-w-[1260px] mx-auto px-5 md:px-8">
      <p class="eyebrow text-primary mb-4">DO IT YOURSELF</p>
      <h1 class="font-heading font-extrabold text-4xl md:text-[3.5rem] lg:text-[4rem] leading-[0.98] text-text mb-6 uppercase">Products</h1>
      <p class="text-lg text-text-muted leading-relaxed max-w-2xl">
        Not everyone needs a full engagement right away. These mini-products give you the right structure to get started on your own — using the same approach our clients use.
      </p>
    </div>
  </section>

  {/* ── Product Cards ── */}
  <section class="pb-16 md:pb-24">
    <div class="max-w-[1260px] mx-auto px-5 md:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
        {products.map((p) => {
          const cover = getCover(p.data.cover);
          return (
            <a
              href={`/en/products/${p.data.pageSlug}/`}
              class="group block bg-white border border-border rounded-card overflow-hidden hover:border-accent/30 hover:shadow-lg transition-all duration-300"
            >
              {cover && (
                <div class="aspect-[4/3] bg-bg-alt overflow-hidden">
                  <Image
                    src={cover}
                    alt={`${p.data.title} — product cover`}
                    widths={[400, 600]}
                    sizes="(max-width: 640px) 100vw, 50vw"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              )}
              <div class="p-6">
                <span class="text-xs font-medium text-accent uppercase tracking-wider mb-2 block">{p.data.cluster}</span>
                <h2 class="font-heading text-lg text-text mb-2 group-hover:text-accent transition-colors">{p.data.title}</h2>
                <p class="text-sm text-text-muted leading-relaxed mb-4">{p.data.shortDescription}</p>
                <div class="flex items-center justify-between">
                  <span class="font-heading text-xl font-bold text-text">&euro;{p.data.price}</span>
                  {p.data.status === 'draft' && (
                    <span class="text-xs bg-bg-alt text-text-muted px-3 py-1 rounded-full">{t('product.comingSoon', locale)}</span>
                  )}
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

</BaseLayout>
