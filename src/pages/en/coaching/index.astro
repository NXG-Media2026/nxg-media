---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTABand from '../../../components/CTABand.astro';
import { siteConfig } from '../../../data/site';
import { generateCollectionPage, generateBreadcrumbs } from '../../../data/schema';
import { t, localizePath, getTranslatedPath, getCollectionBasePath } from '../../../i18n/utils';
import { buildHreflangPair } from '../../../i18n/hreflang';

const locale = 'en';
const coachingBase = getCollectionBasePath('coaching', locale);
const allCoaching = await getCollection('coaching');
const coachingItems = allCoaching.filter((c) => c.data.locale === 'en');

const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: localizePath('/', locale) },
  { label: t('breadcrumb.angebot', locale), href: getTranslatedPath('/angebot', locale) },
  { label: t('breadcrumb.coaching', locale) },
];

const breadcrumbSchema = breadcrumbs.map((b) => ({
  name: b.label,
  url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}${coachingBase}`,
}));

const formatLabels: Record<string, string> = {
  '1-on-1': '1:1',
  'group': 'Group',
  'hybrid': 'Hybrid',
};
---

<BaseLayout
  title={`Coaching | ${siteConfig.name}`}
  description={t('coaching.pageDescription', locale)}
  hreflang={buildHreflangPair('/coaching', '/en/coaching')}
  schemas={[
    generateCollectionPage({
      name: 'Coaching',
      url: `${siteConfig.url}${coachingBase}`,
      description: t('coaching.pageDescription', locale),
    }),
    generateBreadcrumbs(breadcrumbSchema),
  ]}
  locale="en"
>
  <BreadcrumbNav items={breadcrumbs} />

  <section class="py-16 md:py-24 lg:py-32 bg-bg">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <div class="text-center mb-14 md:mb-20">
        <h1 class="font-heading text-4xl md:text-5xl text-text mb-4">
          {t('coaching.pageTitle', locale)}
        </h1>
        <p class="text-lg text-text-muted max-w-2xl mx-auto">
          {t('coaching.pageDescription', locale)}
        </p>
      </div>

      {coachingItems.length > 0 ? (
        <div class="space-y-8">
          {coachingItems.map((item, idx) => (
            <a
              href={`${coachingBase}/${item.data.pageSlug}`}
              class:list={[
                'group block bg-white border border-border rounded-card overflow-hidden',
                'hover:border-accent/30 hover:shadow-xl transition-all duration-300',
                'js-reveal',
              ]}
              style={`--reveal-delay: ${idx * 100}ms`}
            >
              <div class="p-8 md:p-10">
                <div class="flex flex-wrap items-center gap-3 mb-4">
                  <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/10 text-accent rounded-full">
                    {formatLabels[item.data.format] ?? item.data.format}
                  </span>
                  <span class="text-sm text-text-muted">{item.data.duration}</span>
                </div>
                <h2 class="font-heading text-2xl md:text-3xl text-text mb-3 group-hover:text-accent transition-colors">
                  {item.data.title}
                </h2>
                <p class="text-text-muted leading-relaxed mb-6">
                  {item.data.shortDescription}
                </p>
                {item.data.outcomes.length > 0 && (
                  <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 mb-6">
                    {item.data.outcomes.slice(0, 4).map((outcome) => (
                      <li class="flex items-start gap-2 text-sm text-text-muted">
                        <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                        </svg>
                        {outcome}
                      </li>
                    ))}
                  </ul>
                )}
                <span class="inline-flex items-center text-sm font-medium text-accent-dark group-hover:underline underline-offset-2">
                  {t('cta.learnMore', locale)}
                  <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </span>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <p class="text-text-muted">{t('coaching.emptyState', locale)}</p>
        </div>
      )}
    </div>
  </section>

  <CTABand
    title={t('coaching.readyForNext', locale)}
    subtitle={t('coaching.bookFreeSub', locale)}
    ctaText={t('coaching.bookFreeBtn', locale)}
    ctaHref={getTranslatedPath('/kontakt', locale)}
    eventName="discovery_call_click"
    locale="en"
    pageType="coaching"
    pageSlug="/en/coaching"
  />
</BaseLayout>
