---
import { getCollection } from 'astro:content';
import CoachingLayout from '../../../layouts/CoachingLayout.astro';

export async function getStaticPaths() {
  const coachingItems = await getCollection('coaching');
  const enItems = coachingItems.filter((c) => c.data.locale === 'en');
  return enItems.map((item) => ({
    params: { slug: item.data.pageSlug },
    props: { entry: item },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<CoachingLayout coaching={entry.data} locale="en">
  <Content />
</CoachingLayout>
