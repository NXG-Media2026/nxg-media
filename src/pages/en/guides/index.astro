---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import { siteConfig } from '../../../data/site';
import { t } from '../../../i18n/utils';
import { buildHreflangTrilingual } from '../../../i18n/hreflang';

const locale = 'en';
const hreflang = buildHreflangTrilingual('/guides/', '/en/guides/', '/es/guias/');
const guides = (await getCollection('guides')).filter((g) => g.data.locale === locale);
const nlGuides = guides.length === 0 ? (await getCollection('guides')).filter((g) => g.data.locale === 'nl') : [];

const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: '/en/' },
  { label: t('breadcrumb.guides', locale) },
];
---

<BaseLayout title={`Guides | ${siteConfig.name}`} description="Practical guides on online growth, AI visibility and expert positioning." locale={locale} hreflang={hreflang}>
  <BreadcrumbNav items={breadcrumbs} />
  <section class="py-12 md:py-16 lg:py-20">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h1 class="font-heading text-3xl md:text-4xl text-text mb-10">Guides</h1>
      <div class="space-y-6">
        {guides.length > 0 ? (
          guides.map((g) => (
            <a href={`/en/guides/${g.data.pageSlug}/`} class="group block bg-white border border-border rounded-card p-6 hover:border-accent/30 hover:shadow-lg transition-all">
              {g.data.cluster && <span class="text-xs font-medium text-accent uppercase tracking-wider mb-2 block">{g.data.cluster}</span>}
              <h2 class="font-heading text-lg text-text group-hover:text-accent transition-colors">{g.data.title}</h2>
            </a>
          ))
        ) : (
          nlGuides.map((g) => (
            <a href={`/guides/${g.data.pageSlug}/`} class="group block bg-white border border-border rounded-card p-6 hover:border-accent/30 hover:shadow-lg transition-all">
              {g.data.cluster && <span class="text-xs font-medium text-accent uppercase tracking-wider mb-2 block">{g.data.cluster}</span>}
              <h2 class="font-heading text-lg text-text group-hover:text-accent transition-colors">{g.data.title}</h2>
            </a>
          ))
        )}
      </div>
    </div>
  </section>
</BaseLayout>
