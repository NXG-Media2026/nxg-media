<script is:inline>
(function() {
  var lb = document.getElementById('proof-lightbox');
  var lbImg = document.getElementById('proof-img');
  var lbClose = document.getElementById('proof-close');
  if (!lb || !lbImg) return;

  document.querySelectorAll('.proof-trigger').forEach(function(btn) {
    btn.addEventListener('click', function() {
      var img = btn.querySelector('img');
      if (!img) return;
      lbImg.src = img.src;
      lbImg.alt = img.alt;
      lb.classList.remove('hidden');
      lb.classList.add('flex');
      document.body.style.overflow = 'hidden';
    });
  });

  function closeLb() {
    lb.classList.add('hidden');
    lb.classList.remove('flex');
    lbImg.src = '';
    document.body.style.overflow = '';
  }

  if (lbClose) lbClose.addEventListener('click', closeLb);
  lb.addEventListener('click', function(e) {
    if (e.target === lb) closeLb();
  });
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' && !lb.classList.contains('hidden')) closeLb();
  });
})();
</script>


<script is:inline>
(function() {
  var form = document.getElementById('founding-deal-form');
  var thanks = document.getElementById('founding-deal-thanks');
  var microcopy = document.getElementById('founding-deal-microcopy');
  if (!form || !thanks) return;

  form.addEventListener('submit', function(e) {
    e.preventDefault();
    var data = new FormData(form);
    var naam = data.get('naam');
    var email = data.get('email');
    var website = data.get('website');
    var bedrijf = data.get('bedrijf');
    var telefoon = data.get('telefoon') || '';
    var bedrijfstype = data.get('bedrijfstype') || '';
    var dienst = data.get('dienst') || '';

    if (!naam || !email || !website || !bedrijf) return;

    var btn = form.querySelector('button[type="submit"]');
    if (btn) { btn.disabled = true; btn.textContent = 'One moment...'; }

    var extraInfo = [];
    if (bedrijf) extraInfo.push('Business: ' + bedrijf);
    if (bedrijfstype) extraInfo.push('Type: ' + bedrijfstype);
    if (dienst) extraInfo.push('Service: ' + dienst);
    if (telefoon) extraInfo.push('Tel: ' + telefoon);

    var payload = {
      naam: naam,
      email: email,
      websiteUrl: website,
      vraag: 'Website Deal request — ' + extraInfo.join(' — '),
      source: 'website-actie-en',
    };

    if (typeof fbq === 'function') {
      fbq('track', 'Lead', { content_name: 'website-actie-en', content_category: 'website-subscription' });
    }
    if (typeof trackEvent === 'function') {
      trackEvent('scanner_request_submitted', {
        page_type: 'page',
        page_slug: 'website-subscription',
        locale: 'en',
        cta_location: 'inline',
      });
    }

    fetch('https://scanner.nxg-media.com/api/gratis-check', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify(payload),
    }).then(function() {
      showThanks();
    }).catch(function() {
      showThanks();
    });

    function showThanks() {
      form.classList.add('hidden');
      thanks.classList.remove('hidden');
      if (microcopy) microcopy.classList.add('hidden');
    }
  });
})();
</script>
