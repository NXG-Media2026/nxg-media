---
/**
 * AI-ready Website Deal — /en/website-subscription/
 * Direct-response landing page. Translate existing site to AI-ready foundation.
 * noindex — ads lander. No links to other offer pages.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import LogoMarquee from '../../components/LogoMarquee.astro';
import { siteConfig } from '../../data/site';
import { generateFAQPage, generateBreadcrumbs } from '../../data/schema';
import { buildHreflangTrilingual } from '../../i18n/hreflang';

import heroPhoto from '../../assets/images/founder/joost-standing-workinglaptop.webp';
import keystaticDashboard from '../../assets/images/keystatic1.png';
import keystaticHomepage from '../../assets/images/keystatic_edit_homepage.png';
import keystaticBlog from '../../assets/images/keystatic_add_blog.png';

const cmsScreenshots = [
  { src: keystaticDashboard, alt: 'Admin panel with overview of all pages, blogs, services and products', caption: 'Everything in one place' },
  { src: keystaticHomepage, alt: 'Edit homepage copy via simple input fields', caption: 'Edit copy — no code needed' },
  { src: keystaticBlog, alt: 'Write a blog post with formatting toolbar and SEO fields', caption: 'Publish blog posts yourself' },
];
import proofGoogle from '../../assets/images/cases/proof-google-torrevieja.png';
import proofChatgpt from '../../assets/images/cases/proof-chatgpt-local.png';
import proofVerenaAi from '../../assets/images/cases/doc_veri_ai_answer_cropped.PNG';
import proofVerenaChatgpt from '../../assets/images/cases/doc-veri-chatgptproof.jpeg';
import verenaPhoto from '../../assets/images/cases/verena-mann-linkedin.webp';
import jamesPhoto from '../../assets/images/cases/james-mitchell-portrait.png';

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logos/*.{webp,avif,png,jpg}', { eager: true });
const logos = Object.entries(logoFiles)
  .filter(([path]) => /logo/i.test(path.split('/').pop()!))
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/, '');
    const name = filename.replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim();
    return { src: mod.default, alt: name };
  });

const locale = 'en';
const title = 'AI-ready Website Deal — from €79/mo | NXG Media';
const description = 'Transform your current website into an AI-ready client foundation that Google, ChatGPT and customers understand. From €79/mo. First 10 spots this month.';

const hreflang = buildHreflangTrilingual('/website-abonnement', '/en/website-subscription', '/es/suscripcion-web');

const breadcrumbs = [
  { label: 'Home', href: '/en/' },
  { label: 'Website Subscription' },
];

const faqItems = [
  {
    q: 'Does my entire website need to be rebuilt?',
    a: "The starting point is to keep what works: your offer, branding, copy, photos and proof. We rebuild it on a faster, clearer foundation.",
  },
  {
    q: 'Why can this be done for €79/mo?',
    a: "Because we don't build a fully custom project from scratch. We translate your existing site into a solid foundation. That allows us to build faster and keep costs low.",
  },
  {
    q: 'Why only 10 spots?',
    a: "Because this only works when the scope stays tight: converting your current site into a better foundation, without an endless custom project. That's why we take on a maximum of 10 businesses per month.",
  },
  {
    q: 'Why 12 months?',
    a: "Website, hosting, maintenance and monthly visibility check are all included in one subscription. No large upfront payment, but a foundation that keeps running and stays maintained.",
  },
  {
    q: 'What if I want extra pages or SEO content?',
    a: "That can come later. Extra service pages, blogs, local content and advanced optimisation can be added on. First we make sure the foundation is right.",
  },
  {
    q: 'Will I lose my old content?',
    a: "No. What works, we keep. What's unclear, slow or not converting, we sharpen up.",
  },
  {
    q: 'Is this for every business?',
    a: "Mainly for local service providers, practices and specialists with a clear service offering. Webshops and complex custom sites usually fall outside this deal.",
  },
];

const schemas = [
  generateFAQPage(faqItems.map(i => ({ question: i.q, answer: i.a }))),
  generateBreadcrumbs(breadcrumbs),
];
---

<BaseLayout
  title={title}
  description={description}
  canonical={`${siteConfig.url}/en/website-subscription`}
  noindex={true}
  schemas={schemas}
  locale={locale}
  hreflang={hreflang}
>

  {/* ══════════════════════════════════════════════════
      1 · HERO
      ══════════════════════════════════════════════════ */}
  <section class="relative overflow-hidden bg-primary">
    <div class="absolute inset-0 hidden md:block">
      <Image
        src={heroPhoto}
        alt=""
        width={800}
        class="absolute right-0 top-0 h-full w-auto object-cover object-top opacity-[0.15]"
        loading="eager"
      />
    </div>

    <div class="relative px-5 md:px-6 pt-12 pb-14 md:pt-16 md:pb-20">
      <div class="max-w-2xl mx-auto">

        <h1 class="font-heading text-[1.85rem] leading-[1.12] md:text-[2.75rem] md:leading-[1.1] text-white mb-5">
          Your website is online.<br />
          <em class="text-accent not-italic">But your competitor gets the client.</em>
        </h1>

        <p class="text-white/70 leading-relaxed mb-6 text-[0.95rem] md:text-base max-w-xl">
          When Google, ChatGPT and visitors understand your competitor faster than you, you lose enquiries without even realising it.
        </p>

        <p class="text-white/90 leading-relaxed mb-8 text-[0.95rem] md:text-base max-w-xl font-medium">
          We translate your current site &mdash; offer, branding, copy and proof &mdash; into a faster AI-ready foundation built to be found and chosen.
        </p>

        {/* Deal card */}
        <div class="bg-white/[0.12] backdrop-blur-sm border-2 border-accent/40 rounded-card p-5 md:p-6 mb-6 max-w-md shadow-lg">
          <p class="font-heading text-4xl md:text-5xl text-white mb-2">
            From &euro;79<span class="text-lg text-white/60 font-body">/mo</span>
          </p>
          <div class="flex flex-wrap gap-2 mt-3">
            <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/20 text-accent rounded-full">First 10 spots this month</span>
            <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-white/10 text-white/80 rounded-full">No payment now</span>
          </div>
        </div>

        <a
          href="#aanvragen"
          class="inline-flex items-center gap-2 px-8 py-4 text-base font-medium text-white bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg w-full md:w-auto justify-center"
        >
          Check my site
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      2 · PROOF STRIP
      ══════════════════════════════════════════════════ */}
  <section class="bg-bg-alt border-b border-border/50 px-4 md:px-6 py-6 md:py-8">
    <div class="max-w-4xl mx-auto">
      <p class="text-xs uppercase tracking-widest text-text-muted font-medium text-center mb-4">Recent proof from 2 new foundations</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">
        <div class="flex items-start gap-3 bg-white border border-border rounded-card px-5 py-4">
          <span class="text-accent text-lg font-bold shrink-0 mt-0.5">#1</span>
          <div>
            <p class="text-text font-medium text-sm leading-snug">Costa Blanca: visible in Google within 14 days</p>
          </div>
        </div>
        <div class="flex items-start gap-3 bg-white border border-border rounded-card px-5 py-4">
          <span class="text-accent text-lg font-bold shrink-0 mt-0.5">#2</span>
          <div>
            <p class="text-text font-medium text-sm leading-snug">Dr. Verena Mann: 2 &rarr; 19 enquiries/mo + mentioned by ChatGPT</p>
          </div>
        </div>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      3 · NOT JUST A PRETTY SITE
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-12 md:py-16">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-3 text-center">
        Not just a pretty site. A site that should generate clients.
      </h2>
      <p class="text-text-muted text-center mb-8 md:mb-10 max-w-2xl mx-auto text-[0.95rem] leading-relaxed">
        A traditional web designer thinks in pages and design. We focus on search intent, trust, proof, CTAs and how Google, ChatGPT and clients understand your business.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6">
        <div class="border border-border rounded-card p-5 md:p-6 bg-white/50">
          <p class="text-text-muted text-xs uppercase tracking-widest font-medium mb-3">Traditional web designer</p>
          <ul class="space-y-2.5">
            {[
              'Nice site, few enquiries',
              'Thinks in pages and design',
              'SEO comes later',
              'Deliver and done',
            ].map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-text-muted leading-relaxed">
                <svg class="w-4 h-4 text-red-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="border-2 border-accent/30 rounded-card p-5 md:p-6 bg-white shadow-lg relative">
          <span class="absolute -top-3 left-6 inline-block px-3 py-0.5 text-[0.65rem] font-medium tracking-widest uppercase bg-accent text-white rounded-full">
            NXG Media
          </span>
          <p class="text-text text-xs uppercase tracking-widest font-medium mb-3">AI visibility &amp; conversion</p>
          <ul class="space-y-2.5">
            {[
              'Visibility + conversion as the starting point',
              'Service + region clearly positioned',
              "Proof before the CTA",
              'Built for Google, AI and clients',
            ].map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-text leading-relaxed font-medium">
                <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <p class="text-text font-medium text-center text-[0.95rem] mt-8">
        The site is the tool. More enquiries is the goal.
      </p>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      4 · DON'T THROW EVERYTHING AWAY
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-12 md:py-16 bg-bg-alt">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-3 text-center">
        You don&rsquo;t have to throw everything away. The foundation needs to be better.
      </h2>
      <p class="text-text-muted text-center mb-8 md:mb-10 max-w-2xl mx-auto text-[0.95rem] leading-relaxed">
        Your offer, branding, reviews, photos and usable copy come with us. What&rsquo;s unclear, slow or unconvincing, we sharpen up.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6">
        <div class="bg-white border border-border rounded-card p-5">
          <p class="font-heading text-lg text-text mb-1">What works, we keep</p>
          <p class="text-text-muted text-sm leading-relaxed">
            Branding, photos, reviews and usable copy don&rsquo;t have to be lost.
          </p>
        </div>
        <div class="bg-white border border-border rounded-card p-5">
          <p class="font-heading text-lg text-text mb-1">What clients and AI don&rsquo;t understand, we sharpen</p>
          <p class="text-text-muted text-sm leading-relaxed">
            Services, region, proof and CTAs so you come across as the obvious choice faster.
          </p>
        </div>
        <div class="bg-white border border-border rounded-card p-5">
          <p class="font-heading text-lg text-text mb-1">Extra optimisations can come later</p>
          <p class="text-text-muted text-sm leading-relaxed">
            Blogs, local SEO and ads can be added on later. First the foundation.
          </p>
        </div>
      </div>

      <div class="text-center mt-8">
        <a
          href="#aanvragen"
          class="inline-flex items-center gap-2 px-7 py-3.5 text-sm font-medium text-text-inverse bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg"
        >
          Check my site
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      5 · PAIN / YOU'RE LOSING CLIENTS
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-12 md:py-16">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-3 text-center">
        You may already be losing clients to a clearer competitor
      </h2>
      <p class="text-text font-medium text-center mb-8 md:mb-10 max-w-2xl mx-auto text-[0.95rem]">
        Your competitor doesn&rsquo;t have to be better. Just more clearly findable.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6 mb-8">
        <div class="bg-bg-alt border border-border rounded-card p-5">
          <p class="font-heading text-lg text-text mb-1">Visitors click away</p>
          <p class="text-text-muted text-sm leading-relaxed">
            If they don&rsquo;t feel trust fast enough, they go to the competitor.
          </p>
        </div>
        <div class="bg-bg-alt border border-border rounded-card p-5">
          <p class="font-heading text-lg text-text mb-1">Google and AI choose the clearest</p>
          <p class="text-text-muted text-sm leading-relaxed">
            Well-structured sites with clear service and region info are shown more often.
          </p>
        </div>
        <div class="bg-bg-alt border border-border rounded-card p-5">
          <p class="font-heading text-lg text-text mb-1">One extra client pays this back</p>
          <p class="text-text-muted text-sm leading-relaxed">
            Does one client earn you &euro;500? Then one extra client already covers over 6 months of subscription.
          </p>
        </div>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      6 · STOP WITH SEO BAND-AIDS
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-12 md:py-16 bg-bg-alt">
    <div class="max-w-4xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-3 text-center">
        Stop putting SEO band-aids on a site that doesn&rsquo;t convert
      </h2>
      <p class="text-text-muted text-center mb-8 md:mb-10 max-w-2xl mx-auto text-[0.95rem] leading-relaxed">
        When the foundation is slow, messy or unclear, one-off SEO tweaks stay limited. The foundation needs to be right first.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6">
        <div class="border border-border rounded-card p-5 md:p-6 bg-white/50">
          <p class="text-text-muted text-xs uppercase tracking-widest font-medium mb-3">Old approach</p>
          <ul class="space-y-2.5">
            {[
              'Add a plugin, tweak some text',
              'Try something else next month',
              'Foundation stays the same',
            ].map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-text-muted leading-relaxed">
                <svg class="w-4 h-4 text-red-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>

        <div class="border-2 border-accent/30 rounded-card p-5 md:p-6 bg-white shadow-lg relative">
          <span class="absolute -top-3 left-6 inline-block px-3 py-0.5 text-[0.65rem] font-medium tracking-widest uppercase bg-accent text-white rounded-full">
            New approach
          </span>
          <p class="text-text text-xs uppercase tracking-widest font-medium mb-3">AI-ready foundation</p>
          <ul class="space-y-2.5">
            {[
              'Current site translated into a clear foundation',
              'Service + region clear, proof in the right place',
              'Ready for further optimisation',
            ].map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-text leading-relaxed font-medium">
                <svg class="w-4 h-4 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="text-center mt-8">
        <a
          href="#aanvragen"
          class="inline-flex items-center gap-2 px-7 py-3.5 text-sm font-medium text-text-inverse bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg"
        >
          Check my site
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      7 · PROOF / CASES
      ══════════════════════════════════════════════════ */}
  <section class="py-16 md:py-24 bg-primary">
    <div class="max-w-5xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-3xl md:text-4xl text-white mb-3 text-center">
        This is what can happen when the foundation is right
      </h2>
      <p class="text-white/60 text-center mb-12 md:mb-16 max-w-xl mx-auto text-[0.95rem]">
        Our last 2 new foundations became visible in Google or AI within 2 weeks.
      </p>

      {/* ── CASE 1: CBMC ── */}
      <div class="bg-white/5 backdrop-blur border-2 border-accent/30 rounded-card p-5 md:p-8 mb-10">
        <div class="flex items-center gap-4 mb-5">
          <div class="w-12 h-12 rounded-full overflow-hidden ring-2 ring-accent/30 shrink-0">
            <Image
              src={jamesPhoto}
              alt="Dr. James Mitchell"
              widths={[56, 112]}
              sizes="56px"
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>
          <div>
            <p class="text-white font-medium text-sm">Dr. James Mitchell</p>
            <a href="https://www.costablancamovement.com" target="_blank" rel="noopener" class="text-accent/70 hover:text-accent text-xs transition-colors">costablancamovement.com</a>
          </div>
        </div>

        <h3 class="font-heading text-2xl md:text-3xl text-white mb-1">From zero to visible in 14 days</h3>
        <p class="text-white/50 text-sm mb-5">Chiropractic clinic for expats in Torrevieja. No site, no history, no backlinks.</p>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
          <div class="bg-white/5 rounded-card p-3 text-center">
            <p class="font-heading text-xl md:text-2xl text-accent">page&nbsp;1</p>
            <p class="text-white/50 text-xs mt-0.5">in Google</p>
          </div>
          <div class="bg-white/5 rounded-card p-3 text-center">
            <p class="font-heading text-xl md:text-2xl text-accent">ChatGPT</p>
            <p class="text-white/50 text-xs mt-0.5">mentions clinic</p>
          </div>
          <div class="bg-white/5 rounded-card p-3 text-center">
            <p class="font-heading text-xl md:text-2xl text-accent">12&ndash;15</p>
            <p class="text-white/50 text-xs mt-0.5">patients/mo</p>
          </div>
          <div class="bg-white/5 rounded-card p-3 text-center">
            <p class="font-heading text-xl md:text-2xl text-accent">800+</p>
            <p class="text-white/50 text-xs mt-0.5">visitors/mo</p>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
          <button type="button" class="proof-trigger cursor-pointer group text-left">
            <div class="bg-black/40 border border-white/10 rounded-lg overflow-hidden">
              <Image src={proofGoogle} alt="Google search result: Costa Blanca Movement Centre on page 1 after 2 weeks" width={1200} quality={85} class="w-full h-auto" loading="lazy" />
            </div>
            <p class="text-white/40 text-xs mt-1.5 text-center group-hover:text-white/60 transition-colors">Google page 1 &mdash; after 2 weeks</p>
          </button>
          <button type="button" class="proof-trigger cursor-pointer group text-left">
            <div class="bg-black/40 border border-white/10 rounded-lg overflow-hidden">
              <Image src={proofChatgpt} alt="ChatGPT recommends Costa Blanca Movement Centre as number 1 local option" width={1200} quality={85} class="w-full h-auto" loading="lazy" />
            </div>
            <p class="text-white/40 text-xs mt-1.5 text-center group-hover:text-white/60 transition-colors">ChatGPT recommends the clinic as #1</p>
          </button>
        </div>

        <p class="text-accent font-medium text-center text-base pt-4 border-t border-white/10">
          Not after a year of SEO. After 14 days the foundation was already picked up.
        </p>
      </div>

      {/* ── CASE 2: Dr. Verena Mann ── */}
      <div class="bg-white/5 backdrop-blur border border-white/10 rounded-card p-5 md:p-8 mb-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-12">
          <div>
            <div class="flex items-center gap-4 mb-5">
              <div class="w-12 h-12 rounded-full overflow-hidden ring-2 ring-accent/30 shrink-0">
                <Image src={verenaPhoto} alt="Dr. Verena Mann" widths={[56, 112]} sizes="56px" class="w-full h-full object-cover" loading="lazy" decoding="async" />
              </div>
              <div>
                <p class="text-white font-medium text-sm">Dr. Verena Mann</p>
                <a href="https://doc-veri.pages.dev" target="_blank" rel="noopener" class="text-accent/70 hover:text-accent text-xs transition-colors">doc-veri.pages.dev</a>
              </div>
            </div>
            <h3 class="font-heading text-2xl md:text-3xl text-white mb-1">From strong expertise to 19 enquiries per month</h3>
            <p class="text-white/50 text-sm mb-5">Doctor and expert with a community, but few enquiries via her website.</p>

            <div class="grid grid-cols-2 gap-3">
              <div class="bg-white/5 rounded-card p-3 text-center">
                <p class="text-white/50 text-xs uppercase tracking-wider mb-1">Enquiries/mo</p>
                <div class="flex items-center justify-center gap-2">
                  <span class="font-heading text-lg text-white/40">2</span>
                  <span class="text-accent">&rarr;</span>
                  <span class="font-heading text-2xl text-accent">19</span>
                </div>
              </div>
              <div class="bg-white/5 rounded-card p-3 text-center">
                <p class="text-white/50 text-xs uppercase tracking-wider mb-1">AI mentions</p>
