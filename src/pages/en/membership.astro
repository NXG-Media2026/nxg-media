---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import { siteConfig } from '../../data/site';
import { generateBreadcrumbs, generateFAQPage } from '../../data/schema';
import { t, localizePath, getTranslatedPath } from '../../i18n/utils';
import { buildHreflangPair } from '../../i18n/hreflang';

const locale = 'en';

const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: localizePath('/', locale) },
  { label: t('breadcrumb.angebot', locale), href: getTranslatedPath('/angebot', locale) },
  { label: t('nav.mitgliedschaft', locale) },
];

const breadcrumbSchema = breadcrumbs.map((b) => ({
  name: b.label,
  url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}/en/membership`,
}));

const communityFeatures = [
  { title: 'Monthly Live Calls', description: 'Regular Q&A sessions with Dr. Verena on hormones, training, and nutrition.' },
  { title: 'Exclusive Content', description: 'In-depth materials, worksheets, and recipes — only for community members.' },
  { title: 'Connect with Like-Minded Women', description: 'A private group of women who take their health into their own hands.' },
  { title: 'Monthly Challenges', description: 'Stay on track together: nutrition, movement, and mindset challenges.' },
];

const communityFaq = [
  { q: 'How much does the community cost?', a: 'Membership costs €29 per month. You can cancel at any time.' },
  { q: 'Where does the community take place?', a: 'The community runs on Skool — a platform for online communities with courses, discussions, and group calls.' },
  { q: 'Can I try the community?', a: 'Details about trial access will be announced before launch.' },
];
---

<BaseLayout
  title={`Membership — Women's Health Community | ${siteConfig.name}`}
  description="The doc.veri Community: live calls, exclusive content, and connection with like-minded women. Coming soon."
  hreflang={buildHreflangPair('/mitgliedschaft', '/en/membership')}
  schemas={[
    generateBreadcrumbs(breadcrumbSchema),
    generateFAQPage(communityFaq),
  ]}
  locale="en"
>
  <BreadcrumbNav items={breadcrumbs} />

  <section class="py-16 md:py-24 lg:py-32 bg-bg">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <div class="text-center mb-14">
        <span class="inline-flex items-center px-4 py-1.5 text-xs font-medium bg-amber-50 text-amber-700 rounded-full mb-4">
          Coming Soon
        </span>
        <h1 class="font-heading text-4xl md:text-5xl text-text mb-4">
          Support that grows with your cycle
        </h1>
        <p class="text-lg text-text-muted max-w-2xl mx-auto">
          A calm, practical space for women who want ongoing guidance — with live calls, exclusive materials, and a supportive group of like-minded women.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-14">
        {communityFeatures.map((item) => (
          <div class="bg-white rounded-card p-6 border border-border">
            <h2 class="font-medium text-text text-base mb-2">{item.title}</h2>
            <p class="text-sm text-text-muted leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>

      <div class="flex flex-wrap items-center justify-center gap-6 mb-14 text-sm text-text-muted">
        <span class="inline-flex items-center gap-2">
          <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          €29 / month
        </span>
        <span class="inline-flex items-center gap-2">
          <svg class="w-5 h-5 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z" />
          </svg>
          Online Community (Skool)
        </span>
      </div>

      <div class="prose prose-lg max-w-none mb-14">
        <h2>Your community for women's health</h2>
        <p>The doc.veri Community is the place where knowledge becomes habit. Together with other women — guided by Dr. Verena — you implement the fundamentals of hormones, training, and nutrition into your daily life.</p>
        <h3>Who is the community for?</h3>
        <p>For all women who don't just want to read, but want to take action. Whether you're just getting started or already deep into the topic — the community gives you structure, motivation, and personal support.</p>
      </div>

      <div class="bg-primary-dark rounded-card p-8 md:p-10 text-center mb-14">
        <h2 class="font-heading text-2xl text-white mb-3">
          Be the first to know when we launch
        </h2>
        <p class="text-white/70 mb-6 max-w-md mx-auto">
          Join the waitlist and secure exclusive benefits at launch.
        </p>
        <form
          id="waitlist-form"
          class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto"
          data-page-type="membership"
          data-page-slug="membership"
          data-locale="en"
        >
          <label for="waitlist-email" class="sr-only">{t('newsletter.placeholder', locale)}</label>
          <input
            id="waitlist-email"
            type="email"
            name="email"
            required
            placeholder={t('newsletter.placeholder', locale)}
            class="flex-1 px-4 py-3 rounded-button text-sm text-text bg-white border border-white/20 focus:outline-none focus:ring-2 focus:ring-accent"
          />
          <button
            type="submit"
            class="px-6 py-3 text-sm font-medium text-primary bg-white hover:bg-bg-alt rounded-button transition-colors"
          >
            Join the waitlist
          </button>
        </form>
        <p class="waitlist-success hidden mt-4 text-white/90 text-sm" aria-live="polite">
          You're in! We'll let you know as soon as we launch.
        </p>
      </div>
    </div>
  </section>

  <FAQAccordion
    items={communityFaq}
    locale="en"
    pageType="membership"
    pageSlug="membership"
  />

  <script is:inline>
  (function() {
    var form = document.getElementById('waitlist-form');
    if (!form || form.dataset.bound) return;
    form.dataset.bound = '1';
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var email = form.querySelector('input[type="email"]').value;
      if (!email) return;
      if (typeof trackEvent === 'function') {
        trackEvent('community_cta_click', {
          page_type: 'membership',
          page_slug: 'membership',
          locale: 'en',
          provider: 'placeholder',
        });
      }
      form.style.display = 'none';
      var msg = form.parentElement.querySelector('.waitlist-success');
      if (msg) msg.classList.remove('hidden');
    });
  })();
  </script>
</BaseLayout>
