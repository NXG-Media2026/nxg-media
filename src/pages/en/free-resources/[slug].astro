---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import LeadMagnetForm from '../../../components/LeadMagnetForm.astro';
import CTABand from '../../../components/CTABand.astro';
import { siteConfig } from '../../../data/site';
import { generateBreadcrumbs } from '../../../data/schema';
import { t, localizePath, getTranslatedPath } from '../../../i18n/utils';

const locale = 'en';

export async function getStaticPaths() {
  const leadMagnets = await getCollection('leadMagnets');
  const enEntries = leadMagnets.filter((lm) => lm.data.locale === 'en');
  return enEntries.map((lm) => ({
    params: { slug: lm.data.pageSlug },
    props: { entry: lm },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const leadMagnet = entry.data;
const pageUrl = `/en/free-resources/${leadMagnet.pageSlug}`;

const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: localizePath('/', locale) },
  { label: leadMagnet.title },
];

const breadcrumbSchema = breadcrumbs.map((b) => ({
  name: b.label,
  url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}${pageUrl}`,
}));
---

<BaseLayout
  title={leadMagnet.seo.title}
  description={leadMagnet.seo.description}
  schemas={[generateBreadcrumbs(breadcrumbSchema)]}
  locale="en"
>
  <BreadcrumbNav items={breadcrumbs} />

  <article class="py-12 md:py-16 lg:py-20">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <div class="mb-10 md:mb-14">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/10 text-accent rounded-full">
            {leadMagnet.tag}
          </span>
          {leadMagnet.pages && (
            <span class="text-sm text-text-muted">{leadMagnet.pages} pages</span>
          )}
          <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-green-50 text-green-700 rounded-full">
            Free
          </span>
        </div>

        <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl text-text mb-4">
          {leadMagnet.title}
        </h1>
        <p class="text-lg text-text-muted leading-relaxed">
          {leadMagnet.shortDescription}
        </p>
      </div>

      <div class="mb-12">
        <LeadMagnetForm
          pageSlug={leadMagnet.pageSlug}
          deliveryFileUrl={leadMagnet.deliveryFileUrl}
          locale="en"
        />
      </div>

      {leadMagnet.whatYouGet.length > 0 && (
        <section class="mb-12">
          <h2 class="font-heading text-2xl md:text-3xl text-text mb-6">
            {t('leadMagnet.whatYouGet', locale)}
          </h2>
          <ul class="space-y-4">
            {leadMagnet.whatYouGet.map((item) => (
              <li class="flex items-start gap-3 text-text-muted">
                <svg class="w-5 h-5 text-accent shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </section>
      )}

      <div class="prose prose-lg max-w-none mb-12">
        <Content />
      </div>

      <LeadMagnetForm
        pageSlug={leadMagnet.pageSlug}
        deliveryFileUrl={leadMagnet.deliveryFileUrl}
        locale="en"
      />
    </div>
  </article>

  <CTABand
    title="Want even more?"
    subtitle="Discover my products and coaching — science-based and tailored to you."
    ctaText="Discover offers"
    ctaHref={getTranslatedPath('/angebot', locale)}
    eventName="product_cta_click"
    locale="en"
    pageType="lead_magnet"
    pageSlug={leadMagnet.pageSlug}
  />
</BaseLayout>
