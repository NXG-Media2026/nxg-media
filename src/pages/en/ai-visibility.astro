---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import TrustBar from '../../components/TrustBar.astro';
import LogoMarquee from '../../components/LogoMarquee.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import ScannerChooser from '../../components/ScannerChooser.astro';
import { siteConfig } from '../../data/site';
import { generateBreadcrumbs, generateFAQPage } from '../../data/schema';
import { getCluster, getClusterFaqLocalized } from '../../lib/clusters';
import { getTestimonials } from '../../data/testimonials';
import { buildHreflangTrilingual } from '../../i18n/hreflang';

import heroPhoto from '../../assets/images/founder/joost-sitting-laptop-lookingfront.webp';
import founderPhoto from '../../assets/images/founder/joost-standing-relaxed.webp';
import clairePhoto from '../../assets/images/logos/claire-profile-photo.png';
import perplexityLogo from '../../assets/images/logos/perplexity-logo.jpg';
import claudeLogo from '../../assets/images/logos/claude-logo.svg';

const locale = 'en';
const cluster = getCluster('ai-vindbaarheid')!;
const faqItems = getClusterFaqLocalized(cluster, locale);
const faqForComponent = faqItems.map((item) => ({ q: item.question, a: item.answer }));

const testimonials = getTestimonials({ locale: 'en' });
const hreflang = buildHreflangTrilingual('/ai-vindbaarheid/', '/en/ai-visibility/', '/es/visibilidad-ia/');
const claireTestimonial = testimonials.find((t) => t.id === 'claire-ikrouwvanje');

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logos/*.{webp,avif,png,jpg}', { eager: true });
const logos = Object.entries(logoFiles)
  .filter(([path]) => /logo/i.test(path.split('/').pop()!))
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/, '');
    const name = filename.replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim();
    return { src: mod.default, alt: name };
  });

const breadcrumbs = [
  { label: 'Home', href: '/en/' },
  { label: 'AI Visibility' },
];

const trustItems = [
  { value: '+60%', label: 'AI search traffic growth per year' },
  { value: '40%', label: 'of Gen Z searches via AI, not Google' },
  { value: '4 out of 5', label: 'AI tools cite the same 3 sources' },
  { value: '0%', label: 'of SMBs optimise for this' },
];
---

<BaseLayout
  title="AI Visibility — Get recommended by ChatGPT, Gemini & Perplexity | NXG Media"
  description="AI search traffic is growing 60% per year. Is your business already recommended by ChatGPT, Gemini and Perplexity? Run the free scan and find out."
  schemas={[generateBreadcrumbs(breadcrumbs.map((b) => ({ name: b.label, url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}/en/ai-visibility/` }))), generateFAQPage(faqItems)]}
  hreflang={hreflang}
  locale={locale}
>
  <BreadcrumbNav items={breadcrumbs} />

  {/* ── Hero ── */}
  <section class="relative py-20 md:py-28 lg:py-36 overflow-hidden">
    <div class="absolute inset-0">
      <Image
        src={heroPhoto}
        alt="Joost van Putten — AI visibility specialist, helping local practices become visible in ChatGPT and Gemini"
        widths={[800, 1200, 1600]}
        sizes="100vw"
        class="w-full h-full object-cover"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-white/95 via-white/85 to-white/40"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 md:px-6">
      <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-primary/10 text-primary rounded-full mb-6">
        Early adopter advantage
      </span>
      <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl text-text mb-6 leading-tight max-w-2xl">
        Get recommended by ChatGPT, Gemini & Perplexity
      </h1>
      <p class="text-lg md:text-xl text-text-muted leading-relaxed mb-10 max-w-xl">
        AI search traffic is growing 60% per year. More and more people ask AI for recommendations instead of Google. Is your business being mentioned?
      </p>
      <div class="flex flex-col sm:flex-row items-start gap-4">
        <button
          type="button"
          data-scanner-open
          class="inline-flex items-center px-8 py-4 text-base font-medium text-text-inverse bg-primary hover:bg-primary-dark transition-colors rounded-button shadow-lg cursor-pointer"
        >
          Run the free AI scan
          <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </button>
        <a
          href="/en/contact/"
          class="inline-flex items-center px-8 py-4 text-base font-medium text-primary border-2 border-primary hover:bg-primary/5 transition-colors rounded-button"
        >
          Book an introduction
        </a>
      </div>
    </div>
  </section>

  {/* ── Trust Bar ── */}
  <section class="bg-bg-alt border-y border-border">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <TrustBar items={trustItems} />
    </div>
  </section>

  {/* ── Recognition / Pain ── */}
  <section class="py-16 md:py-20 bg-primary">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-white mb-8">Sound familiar?</h2>
      <div class="space-y-4">
        <div class="flex items-start gap-3">
          <span class="text-white/60 text-lg mt-0.5">&ldquo;</span>
          <p class="text-white/80 leading-relaxed">We rank on page 1 of Google, but the phone rings less and less.</p>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-white/60 text-lg mt-0.5">&ldquo;</span>
          <p class="text-white/80 leading-relaxed">I asked ChatGPT for a specialist in my area — my competitor was mentioned, I wasn't.</p>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-white/60 text-lg mt-0.5">&ldquo;</span>
          <p class="text-white/80 leading-relaxed">We invest in SEO, but AI tools seem to completely ignore us.</p>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-white/60 text-lg mt-0.5">&ldquo;</span>
          <p class="text-white/80 leading-relaxed">My competitors aren't doing anything about this yet — but I don't want to be late like I was with Google.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── FOMO / Early Adopter ── */}
  <section class="py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <div class="max-w-3xl">
        <h2 class="font-heading text-2xl md:text-3xl text-text mb-6">
          The shift has already started
        </h2>
        <p class="text-lg text-text-muted leading-relaxed mb-6">
          ChatGPT, Gemini, Perplexity, Claude — together they already process hundreds of millions of search queries per day. And that volume is growing by more than 60% per year.
        </p>
        <p class="text-lg text-text-muted leading-relaxed mb-6">
          40% of Gen Z already uses AI as their primary search engine. Not Google. They ask: <em>"What's the best physio in London?"</em> or <em>"Which osteopath do you recommend in Dublin?"</em> — and the AI gives three names. Always the same three.
        </p>
        <p class="text-lg text-text leading-relaxed font-medium mb-10">
          You may have been too late to rank at the top of Google. But with AI visibility you have a second chance — and most of your competitors are still asleep.
        </p>
      </div>

      {/* Stats grid */}
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
        <div class="bg-white rounded-card p-5 border border-border text-center flex flex-col items-center gap-3">
          <svg class="w-10 h-10" viewBox="0 0 24 24" fill="#10A37F" xmlns="http://www.w3.org/2000/svg" aria-label="ChatGPT logo" role="img">
            <path d="M22.282 9.821a5.985 5.985 0 0 0-.516-4.91 6.046 6.046 0 0 0-6.51-2.9A6.065 6.065 0 0 0 4.981 4.18a5.998 5.998 0 0 0-3.998 2.9 6.047 6.047 0 0 0 .743 7.097 5.98 5.98 0 0 0 .51 4.911 6.051 6.051 0 0 0 6.515 2.9A5.985 5.985 0 0 0 13.26 24a6.056 6.056 0 0 0 5.772-4.206 5.99 5.99 0 0 0 3.997-2.9 6.056 6.056 0 0 0-.747-7.073zM13.26 22.43a4.476 4.476 0 0 1-2.876-1.04l.141-.081 4.779-2.758a.795.795 0 0 0 .392-.681v-6.737l2.02 1.168a.071.071 0 0 1 .038.052v5.583a4.504 4.504 0 0 1-4.494 4.494zM3.6 18.304a4.47 4.47 0 0 1-.535-3.014l.142.085 4.783 2.759a.771.771 0 0 0 .78 0l5.843-3.369v2.332a.08.08 0 0 1-.033.062L9.74 19.95a4.5 4.5 0 0 1-6.14-1.646zM2.34 7.896a4.485 4.485 0 0 1 2.366-1.973V11.6a.766.766 0 0 0 .388.676l5.815 3.355-2.02 1.168a.076.076 0 0 1-.071 0l-4.83-2.786A4.504 4.504 0 0 1 2.34 7.872zm16.597 3.855l-5.833-3.387L15.119 7.2a.076.076 0 0 1 .071 0l4.83 2.791a4.494 4.494 0 0 1-.676 8.105v-5.678a.79.79 0 0 0-.407-.667zm2.01-3.023l-.141-.085-4.774-2.782a.776.776 0 0 0-.785 0L9.409 9.23V6.897a.066.066 0 0 1 .028-.061l4.83-2.787a4.5 4.5 0 0 1 6.68 4.66zm-12.64 4.135l-2.02-1.164a.08.08 0 0 1-.038-.057V6.075a4.5 4.5 0 0 1 7.375-3.453l-.142.08L8.704 5.46a.795.795 0 0 0-.393.681zm1.097-2.365l2.602-1.5 2.607 1.5v2.999l-2.597 1.5-2.607-1.5z"/>
          </svg>
          <p class="font-heading text-base font-semibold text-text">ChatGPT</p>
          <p class="text-xs text-text-muted">400M+ weekly users</p>
        </div>
        <div class="bg-white rounded-card p-5 border border-border text-center flex flex-col items-center gap-3">
          <svg class="w-10 h-10" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-label="Google Gemini logo" role="img">
            <defs>
              <linearGradient id="gemini-g-en" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0%" stop-color="#4285F4"/>
                <stop offset="35%" stop-color="#9B72CB"/>
                <stop offset="65%" stop-color="#D96570"/>
                <stop offset="100%" stop-color="#D96570"/>
              </linearGradient>
            </defs>
            <path d="M12 0C12 6.627 6.627 12 0 12c6.627 0 12 5.373 12 12 0-6.627 5.373-12 12-12C17.373 12 12 6.627 12 0z" fill="url(#gemini-g-en)"/>
          </svg>
          <p class="font-heading text-base font-semibold text-text">Gemini</p>
          <p class="text-xs text-text-muted">Integrated into Google Search</p>
        </div>
        <div class="bg-white rounded-card p-5 border border-border text-center flex flex-col items-center gap-3">
          <Image src={perplexityLogo} alt="Perplexity logo" width={40} height={40} class="w-10 h-10 object-contain" loading="lazy" decoding="async" />
          <p class="font-heading text-base font-semibold text-text">Perplexity</p>
          <p class="text-xs text-text-muted">15M+ daily search queries</p>
        </div>
        <div class="bg-white rounded-card p-5 border border-border text-center flex flex-col items-center gap-3">
          <Image src={claudeLogo} alt="Claude logo" width={40} height={40} class="w-10 h-10 object-contain" loading="lazy" decoding="async" />
          <p class="font-heading text-base font-semibold text-text">Claude</p>
          <p class="text-xs text-text-muted">Fastest growing AI assistant</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── Google vs AI Comparison ── */}
  <section class="py-16 md:py-20 bg-bg-alt">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-4 text-center">
        Google search vs. AI search
      </h2>
      <p class="text-text-muted text-center mb-10 max-w-2xl mx-auto">
        Same question, completely different game. This is why your SEO strategy alone is no longer enough.
      </p>

      <div class="overflow-x-auto">
        <table class="w-full bg-white rounded-card border border-border text-sm md:text-base">
          <thead>
            <tr class="border-b border-border">
              <th class="text-left px-5 py-4 font-medium text-text-muted"></th>
              <th class="text-left px-5 py-4 font-medium text-text-muted">Google (classic)</th>
              <th class="text-left px-5 py-4 font-medium text-primary">AI search</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-border">
            <tr>
              <td class="px-5 py-4 font-medium text-text">Result</td>
              <td class="px-5 py-4 text-text-muted">10 blue links</td>
              <td class="px-5 py-4 text-text">1 direct answer with 2-3 recommendations</td>
            </tr>
            <tr>
              <td class="px-5 py-4 font-medium text-text">Ranking factors</td>
              <td class="px-5 py-4 text-text-muted">Backlinks, keywords, technical SEO</td>
              <td class="px-5 py-4 text-text">Citability, authority, context, reviews</td>
            </tr>
            <tr>
              <td class="px-5 py-4 font-medium text-text">Position #4+</td>
              <td class="px-5 py-4 text-text-muted">Fewer clicks, but still visible</td>
              <td class="px-5 py-4 text-text">Doesn't exist — you're mentioned or you're not</td>
            </tr>
            <tr>
              <td class="px-5 py-4 font-medium text-text">Competition</td>
              <td class="px-5 py-4 text-text-muted">Everyone has optimised for 20 years</td>
              <td class="px-5 py-4 text-text">Almost nobody optimises for this yet</td>
            </tr>
            <tr>
              <td class="px-5 py-4 font-medium text-text">Cost</td>
              <td class="px-5 py-4 text-text-muted">€1,000+/mo for decent SEO</td>
              <td class="px-5 py-4 text-text">Low — the right structure is enough</td>
            </tr>
            <tr>
              <td class="px-5 py-4 font-medium text-text">Timeline</td>
              <td class="px-5 py-4 text-text-muted">6-12 months to see results</td>
              <td class="px-5 py-4 text-text">Weeks — AI re-indexes continuously</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  {/* ── Mid-page CTA ── */}
  <section class="py-16 md:py-20 bg-accent">
    <div class="max-w-4xl mx-auto px-4 md:px-6 text-center">
      <h2 class="font-heading text-3xl md:text-4xl text-white mb-4">
        Check if AI tools already recommend your business
      </h2>
      <p class="text-lg text-white/80 mb-8 max-w-2xl mx-auto">
        Our free scan checks your visibility in ChatGPT, Gemini, Perplexity and Google. In 2 minutes you'll know where you stand.
      </p>
      <button
        type="button"
        data-scanner-open
        class="inline-flex items-center px-8 py-4 text-base font-medium bg-white text-accent hover:bg-bg-alt transition-colors rounded-button cursor-pointer"
      >
        Run the free AI scan
        <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </button>
    </div>
  </section>

  {/* ── From invisible to recommended ── */}
  <section class="py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-6">From invisible to recommended</h2>
      <p class="text-lg text-text-muted leading-relaxed mb-10 max-w-3xl">
        Three steps — from your first scan to the moment AI tools start recommending your business to their users.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center mb-4">
            <span class="text-primary font-heading text-lg">1</span>
          </div>
          <h3 class="font-heading text-lg text-text mb-2">Discover your score</h3>
          <p class="text-sm text-text-muted leading-relaxed">The free scan analyses your visibility in ChatGPT, Gemini, Perplexity and Google. You receive a personal score with actionable improvements.</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center mb-4">
            <span class="text-primary font-heading text-lg">2</span>
          </div>
          <h3 class="font-heading text-lg text-text mb-2">Get recommended</h3>
          <p class="text-sm text-text-muted leading-relaxed">Based on your scan results we optimise your online presence — so AI tools start mentioning your business when someone searches for your specialism.</p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center mb-4">
            <span class="text-primary font-heading text-lg">3</span>
          </div>
          <h3 class="font-heading text-lg text-text mb-2">More clients, fewer ads</h3>
          <p class="text-sm text-text-muted leading-relaxed">Clients find you automatically through AI recommendations — without ad spend. Just like Claire: +25% more clients, less dependent on paid advertising.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── Results ── */}
  <section class="py-16 md:py-20 bg-primary">
    <div class="max-w-4xl mx-auto px-4 md:px-6 text-center">
      <h2 class="font-heading text-2xl md:text-3xl text-white mb-10">
        Results that matter
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-white/10 backdrop-blur rounded-card p-6 border border-white/20">
          <div class="font-heading text-3xl md:text-4xl text-accent mb-2">+25%</div>
          <p class="font-medium text-white mb-1">More clients</p>
          <p class="text-sm text-white/70">Without extra ad spend — purely through AI recommendations.</p>
        </div>
        <div class="bg-white/10 backdrop-blur rounded-card p-6 border border-white/20">
          <div class="font-heading text-3xl md:text-4xl text-accent mb-2">24/7</div>
          <p class="font-medium text-white mb-1">Visible</p>
          <p class="text-sm text-white/70">AI tools work day and night. Every search query is an opportunity to be recommended.</p>
        </div>
        <div class="bg-white/10 backdrop-blur rounded-card p-6 border border-white/20">
          <div class="font-heading text-3xl md:text-4xl text-accent mb-2">€0</div>
          <p class="font-medium text-white mb-1">Ad costs</p>
          <p class="text-sm text-white/70">AI recommendations are free traffic. No click budget, no campaigns.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── Testimonial — Claire ── */}
  {claireTestimonial && (
    <section class="py-16 md:py-20 bg-bg-alt">
      <div class="max-w-3xl mx-auto px-4 md:px-6">
        <div class="bg-white rounded-card p-8 md:p-10 border border-border">
          <div class="flex items-center gap-4 mb-6">
            <div class="w-14 h-14 rounded-full overflow-hidden bg-bg-alt shrink-0">
              <Image
                src={clairePhoto}
                alt={claireTestimonial.name}
                width={56}
                height={56}
                class="w-full h-full object-cover"
                loading="lazy"
                decoding="async"
              />
            </div>
            <div>
              <p class="font-medium text-text">{claireTestimonial.name}</p>
              {claireTestimonial.outcome && (
                <p class="text-sm text-text-muted">{claireTestimonial.outcome}</p>
              )}
            </div>
            {claireTestimonial.rating && (
              <div class="ml-auto flex gap-0.5">
                {Array.from({ length: claireTestimonial.rating }).map(() => (
                  <svg class="w-4 h-4 text-accent" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                ))}
              </div>
            )}
          </div>
          <blockquote class="text-text-muted leading-relaxed text-lg italic">
            &ldquo;{claireTestimonial.text}&rdquo;
          </blockquote>
        </div>
      </div>
    </section>
  )}

  {/* ── Founder ── */}
  <section class="py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <div class="grid grid-cols-1 md:grid-cols-[auto_1fr] gap-10 md:gap-14 items-center">
        <div class="flex justify-center md:justify-start">
          <div class="w-48 h-48 md:w-56 md:h-56 rounded-full overflow-hidden shadow-lg ring-4 ring-bg-alt shrink-0">
            <Image
              src={founderPhoto}
              alt="Joost van Putten — Founder NXG Media"
              widths={[224, 320]}
              sizes="(max-width: 768px) 192px, 224px"
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
        <div>
          <div class="w-12 h-1 bg-accent rounded-full mb-4"></div>
          <h2 class="font-heading text-2xl md:text-3xl text-text mb-1">Joost van Putten</h2>
          <p class="text-sm text-text-muted mb-4">Founder & Online Growth Strategist</p>
          <p class="text-text-muted leading-relaxed mb-6">
            7+ years of experience building online growth systems. Over €5 million in ad spend managed. I help coaches and SMBs become visible not just on Google, but also in the AI tools that are rapidly replacing it.
          </p>
          <a
            href="/en/about-joost/"
            class="inline-flex items-center text-accent hover:text-accent-dark transition-colors font-medium"
          >
            More about Joost
            <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ── Logo Marquee ── */}
  {logos.length > 0 && (
    <LogoMarquee
      logos={logos}
      label="Trusted by coaches, experts and businesses"
      speed={35}
    />
  )}

