---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTABand from '../../../components/CTABand.astro';
import { siteConfig } from '../../../data/site';
import { generateCollectionPage, generateBreadcrumbs } from '../../../data/schema';
import { t, localizePath, getTranslatedPath, getCollectionBasePath } from '../../../i18n/utils';
import { buildHreflangPair } from '../../../i18n/hreflang';

const locale = 'en';
const blogBase = getCollectionBasePath('blog', locale);

const articles = (await getCollection('artikel'))
  .filter((a) => a.data.locale === 'en')
  .sort((a, b) => b.data.publishedDate.getTime() - a.data.publishedDate.getTime());

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: localizePath('/', locale) },
  { label: t('breadcrumb.blog', locale) },
];

const breadcrumbSchema = breadcrumbs.map((b) => ({
  name: b.label,
  url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}${blogBase}`,
}));
---

<BaseLayout
  title={`Blog | ${siteConfig.name}`}
  description="Evidence-based articles on women's health, hormones, nutrition, and training — by Dr. Verena."
  hreflang={buildHreflangPair('/blog', '/en/blog')}
  schemas={[
    generateCollectionPage({
      name: 'Blog',
      url: `${siteConfig.url}${blogBase}`,
      description: "Evidence-based articles on women's health, hormones, nutrition, and training.",
    }),
    generateBreadcrumbs(breadcrumbSchema),
  ]}
  locale="en"
>
  <BreadcrumbNav items={breadcrumbs} />

  <section class="py-16 md:py-24 lg:py-32 bg-bg">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <div class="text-center mb-14 md:mb-20">
        <h1 class="font-heading text-4xl md:text-5xl text-text mb-4">
          Blog
        </h1>
        <p class="text-lg text-text-muted max-w-2xl mx-auto">
          Evidence-based knowledge on women's health — no trend noise, just science.
        </p>
      </div>

      {articles.length > 0 ? (
        <div class="space-y-8">
          {articles.map((article, idx) => (
            <a
              href={`${blogBase}/${article.data.pageSlug}`}
              class:list={[
                'group block bg-white border border-border rounded-card overflow-hidden',
                'hover:border-accent/30 hover:shadow-xl transition-all duration-300',
                'js-reveal',
              ]}
              style={`--reveal-delay: ${idx * 100}ms`}
            >
              <div class="p-6 md:p-8">
                <div class="flex flex-wrap items-center gap-3 mb-3">
                  <span class="text-xs text-text-muted">{article.data.readingTime} {t('blog.readingTime', locale)}</span>
                </div>
                <h2 class="font-heading text-xl md:text-2xl text-text mb-2 group-hover:text-accent transition-colors">
                  {article.data.title}
                </h2>
                <p class="text-sm text-text-muted leading-relaxed mb-4">
                  {article.data.excerpt}
                </p>
                <div class="flex items-center justify-between">
                  <time datetime={article.data.publishedDate.toISOString().split('T')[0]} class="text-xs text-text-muted">
                    {fmtDate(article.data.publishedDate)}
                  </time>
                  <span class="inline-flex items-center text-sm font-medium text-accent-dark group-hover:underline underline-offset-2">
                    {t('general.readMore', locale)}
                    <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="text-center py-12">
          <p class="text-text-muted">Articles will be published soon.</p>
        </div>
      )}
    </div>
  </section>

  <CTABand
    title={t('layout.applyKnowledge', locale)}
    subtitle={t('layout.applyKnowledgeSub', locale)}
    ctaText={t('layout.discoverOffers', locale)}
    ctaHref={getTranslatedPath('/angebot', locale)}
    eventName="product_cta_click"
    locale="en"
    pageType="article"
    pageSlug="/en/blog"
  />
</BaseLayout>
