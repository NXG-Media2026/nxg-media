---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import CalendlyEmbed from '../../components/CalendlyEmbed.astro';
import { siteConfig } from '../../data/site';
import { generateBreadcrumbs } from '../../data/schema';
import { t, localizePath } from '../../i18n/utils';
import { buildHreflangTrilingual } from '../../i18n/hreflang';

const locale = 'en';
const hreflang = buildHreflangTrilingual('/contact/', '/en/contact/', '/es/contacto/');
const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: localizePath('/', locale) },
  { label: 'Contact' },
];
const breadcrumbSchema = [
  { name: t('breadcrumb.home', locale), url: `${siteConfig.url}${localizePath('/', locale)}` },
  { name: 'Contact', url: `${siteConfig.url}/en/contact` },
];
---

<BaseLayout
  title={`Contact | ${siteConfig.name}`}
  description="Get in touch with NXG Media or book a call with Joost."
  schemas={[generateBreadcrumbs(breadcrumbSchema)]}
  locale={locale}
  hreflang={hreflang}
  hideNewsletter={true}
  hideStickyMobileCTA={true}
>
  <BreadcrumbNav items={breadcrumbs} />

  <section class="refresh-hero refresh-contact"><div class="refresh-wrap refresh-split"><div><p class="refresh-eyebrow">TELL US WHERE YOU WANT TO GO</p><h1>YOUR NEXT STEP.<br /><span>STARTS HERE.</span></h1><p>In 15 minutes we'll discuss your business, your growth plans and which approach fits best. Personal, concrete and no-obligation.</p><a class="refresh-button" href="#calendly">Pick a moment with Joost <span aria-hidden="true">↓</span></a></div><aside class="refresh-contact-card"><img src="/lander-assets/proof/joost.webp" alt="Joost van Putten" width="100" height="100" /><p class="refresh-eyebrow">YOU'LL SPEAK WITH JOOST</p><h2>JUST A QUICK<br />INTRO.</h2><p>Prefer to ask something first? Feel free to send me a message.</p><a href={'mailto:' + siteConfig.email}>{siteConfig.email} ↗</a><a href={siteConfig.socials.linkedin} target="_blank" rel="noopener noreferrer">Find me on LinkedIn ↗</a></aside></div></section>

  <CalendlyEmbed pageType="contact" pageSlug="contact" locale={locale} title="Pick your moment." subtitle="15 minutes. Your business, your questions and a concrete next step." />
</BaseLayout>
