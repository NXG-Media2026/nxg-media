---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import CalendlyEmbed from '../../components/CalendlyEmbed.astro';
import { siteConfig } from '../../data/site';
import { generateBreadcrumbs } from '../../data/schema';
import { t, localizePath } from '../../i18n/utils';
import { buildHreflangTrilingual } from '../../i18n/hreflang';

const locale = 'en';
const hreflang = buildHreflangTrilingual('/contact/', '/en/contact/', '/es/contacto/');
const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: localizePath('/', locale) },
  { label: 'Contact' },
];
const breadcrumbSchema = [
  { name: t('breadcrumb.home', locale), url: `${siteConfig.url}${localizePath('/', locale)}` },
  { name: 'Contact', url: `${siteConfig.url}/en/contact` },
];
---

<BaseLayout
  title={`Contact | ${siteConfig.name}`}
  description="Get in touch with NXG Media or book a call with Joost."
  schemas={[generateBreadcrumbs(breadcrumbSchema)]}
  locale={locale}
  hreflang={hreflang}
>
  <BreadcrumbNav items={breadcrumbs} />

  <section class="py-16 md:py-24">
    <div class="max-w-[1260px] mx-auto px-5 md:px-8">
      <div class="max-w-2xl">
        <p class="eyebrow text-primary mb-4">GET IN TOUCH</p>
        <h1 class="font-heading font-extrabold text-4xl md:text-[3.5rem] leading-[0.98] text-text mb-6 uppercase">
          Let's<br />
          <span class="marker">talk.</span>
        </h1>
        <p class="text-lg text-text-muted leading-relaxed mb-10">
          Want to discuss what NXG Media can do for you? Book a no-obligation call or send an email.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 mb-12">
        <a href={`mailto:${siteConfig.email}`} class="group flex items-start gap-4 bg-bg-alt rounded-xl p-6 border border-border hover:border-primary/30 transition-colors">
          <div class="shrink-0 w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
            <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
            </svg>
          </div>
          <div>
            <h3 class="font-heading font-extrabold text-lg mb-1 group-hover:text-primary transition-colors">Email</h3>
            <p class="text-text-muted text-sm">{siteConfig.email}</p>
          </div>
        </a>

        <a href={siteConfig.socials.linkedin} target="_blank" rel="noopener noreferrer" class="group flex items-start gap-4 bg-bg-alt rounded-xl p-6 border border-border hover:border-primary/30 transition-colors">
          <div class="shrink-0 w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center">
            <svg class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="currentColor">
              <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.36V9h3.41v1.56h.05c.47-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 11.01-4.12 2.06 2.06 0 01-.01 4.12zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z" />
            </svg>
          </div>
          <div>
            <h3 class="font-heading font-extrabold text-lg mb-1 group-hover:text-primary transition-colors">LinkedIn</h3>
            <p class="text-text-muted text-sm">Joost van Putten</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <CalendlyEmbed pageType="contact" pageSlug="contact" locale={locale} />
</BaseLayout>
