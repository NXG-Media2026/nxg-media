---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import { siteConfig } from '../../data/site';
import { generateBreadcrumbs } from '../../data/schema';
import { t, localizePath } from '../../i18n/utils';

const locale = 'en';

const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: localizePath('/', locale) },
  { label: t('nav.privacy', locale) },
];

const breadcrumbSchema = breadcrumbs.map((b) => ({
  name: b.label,
  url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}/en/privacy`,
}));
---

<BaseLayout
  title={`Privacy Policy | ${siteConfig.name}`}
  description={`Privacy policy for ${siteConfig.name}.`}
  noindex={true}
  locale="en"
>
  <BreadcrumbNav items={breadcrumbs} />

  <article class="py-12 md:py-16 lg:py-20">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h1 class="font-heading text-3xl md:text-4xl text-text mb-8">Privacy Policy</h1>

      <div class="prose prose-lg max-w-none">
        <div class="bg-bg-alt border border-border rounded-card p-6 mb-8">
          <p class="text-text-muted text-sm mb-2">
            <strong>Note:</strong> As {siteConfig.name} is operated from Germany, the legally binding privacy policy is available in German.
          </p>
          <a
            href="/datenschutz"
            class="inline-flex items-center text-sm font-medium text-accent hover:text-accent-dark transition-colors"
          >
            View privacy policy (German)
            <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>

        <h2>Summary</h2>
        <p>
          {siteConfig.name} is committed to protecting your personal data.
          We process data only as necessary to provide our services and comply with legal obligations under the EU General Data Protection Regulation (GDPR).
        </p>

        <h2>Controller</h2>
        <p>
          {siteConfig.legal.responsiblePerson || siteConfig.founder.name}<br />
          Email: <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
        </p>

        <h2>Your rights</h2>
        <p>
          Under the GDPR, you have the right to access, rectification, erasure, restriction of processing, data portability, and the right to object.
          To exercise your rights, please contact us at <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>.
        </p>
      </div>
    </div>
  </article>
</BaseLayout>
