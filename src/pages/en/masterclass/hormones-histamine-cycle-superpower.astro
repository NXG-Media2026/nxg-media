---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import FAQAccordion from '../../../components/FAQAccordion.astro';
import CTABand from '../../../components/CTABand.astro';
import { Image } from 'astro:assets';
import { siteConfig } from '../../../data/site';
import { generateBreadcrumbs, generateFAQPage } from '../../../data/schema';
import { t, localizePath, getTranslatedPath } from '../../../i18n/utils';
import { buildHreflangPair } from '../../../i18n/hreflang';
import { trackOnClick } from '../../../lib/analytics';
import { buildMasterclassPayload, serializePayload } from '../../../lib/emailCapture';

import founderImage from '../../../assets/images/Founder/portrait-doctor.jpg';
import heroImage from '../../../assets/images/Founder/lifestyle-water.jpg';

const locale = 'en';
const pageSlug = 'hormones-histamine-cycle-superpower';
const pageTitle = 'Hormones, Histamine & Your Cycle as Superpower';
const pageUrl = `/en/masterclass/${pageSlug}`;

const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: localizePath('/', locale) },
  { label: t('breadcrumb.angebot', locale), href: getTranslatedPath('/angebot', locale) },
  { label: t('breadcrumb.masterclass', locale) },
  { label: pageTitle },
];

const breadcrumbSchema = breadcrumbs.map((b) => ({
  name: b.label,
  url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}${pageUrl}`,
}));

const analyticsBase = {
  page_type: 'masterclass' as const,
  page_slug: pageSlug,
  locale: 'en',
};

const learnings = [
  {
    title: 'Understand your hormones',
    description: 'What estrogen, progesterone, and cortisol actually do in your body — and why they sometimes turn against you.',
  },
  {
    title: 'Histamine & your cycle',
    description: 'Why histamine symptoms are cycle-dependent and what you can do in each phase.',
  },
  {
    title: 'Cycle-based training',
    description: 'When your body can perform and when it needs recovery — based on your hormones, not a calendar.',
  },
  {
    title: 'Nutrition that supports',
    description: 'Which foods stabilize your hormones and which throw them off balance.',
  },
  {
    title: 'Recognizing perimenopause',
    description: 'The signs many doctors overlook — and what you can do now, even if you\'re only 35.',
  },
  {
    title: 'Your personal roadmap',
    description: 'By the end of the masterclass, you\'ll have a concrete plan you can implement right away.',
  },
];

const faqs = [
  {
    q: 'When does the masterclass take place?',
    a: 'The exact date hasn\'t been set yet. Sign up for the waitlist and you\'ll be the first to know — with an exclusive early-bird benefit.',
  },
  {
    q: 'Is the masterclass free?',
    a: 'The masterclass will have a small fee, to be announced. Waitlist members receive an exclusive discount.',
  },
  {
    q: 'Do I need prior knowledge?',
    a: 'No. The masterclass is structured so you can understand everything — whether you\'re exploring hormones for the first time or have been researching for a while.',
  },
  {
    q: 'Will there be a recording?',
    a: 'Yes, all participants get access to the recording. You can watch at your own pace.',
  },
  {
    q: 'Who is the masterclass for?',
    a: 'For all women who feel their body isn\'t working the way it used to — and want to understand why. Especially relevant if you\'re between 28 and 52.',
  },
  {
    q: 'How is this different from a YouTube video?',
    a: 'The masterclass connects three topics (hormones, histamine, cycle) that are usually covered separately. You get the full picture — from a physician, not an influencer.',
  },
];

const { founder } = siteConfig;

const waitlistPayload = buildMasterclassPayload('', {
  masterclassSlug: pageSlug,
});
const waitlistPayloadJson = serializePayload(waitlistPayload);
---

<BaseLayout
  title={`${pageTitle} — Masterclass | ${siteConfig.name}`}
  description="Finally understand why your body has changed. Masterclass on hormones, histamine, and cycle-aware living — by Dr. Verena Mann."
  hreflang={buildHreflangPair('/masterclass/hormone-histamin-zyklus-superpower', '/en/masterclass/hormones-histamine-cycle-superpower')}
  schemas={[
    generateBreadcrumbs(breadcrumbSchema),
    generateFAQPage(faqs),
  ]}
  locale="en"
>
  <BreadcrumbNav items={breadcrumbs} />

  <section class="relative overflow-hidden bg-primary-dark text-white min-h-[60vh] md:min-h-[70vh] flex items-center">
    <div class="absolute inset-0">
      <Image
        src={heroImage}
        alt="Woman at the water — calm and strength"
        widths={[768, 1280, 1920]}
        sizes="100vw"
        class="w-full h-full object-cover"
        loading="eager"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#2D2A26]/90 via-[#2D2A26]/70 to-[#2D2A26]/50"></div>
    </div>
    <div class="relative max-w-3xl mx-auto px-4 md:px-6 py-20 md:py-28">
      <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/20 text-accent-light rounded-full mb-6">
        Masterclass &middot; Waitlist
      </span>
      <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl text-white leading-tight mb-6">
        You do everything right — and still don't feel like yourself.
      </h1>
      <p class="text-lg md:text-xl text-white/80 leading-relaxed mb-8 max-w-2xl">
        You eat well, train regularly — yet your body feels unpredictable. Your energy fluctuates, sleep is disrupted, digestion does its own thing.
      </p>
      <a
        href="#waitlist"
        class="inline-flex items-center px-8 py-4 text-base font-medium bg-accent hover:bg-accent-dark text-white transition-all duration-300 rounded-button shadow-lg shadow-accent/25"
        onclick={trackOnClick('masterclass_waitlist_signup', { ...analyticsBase, cta_location: 'hero' })}
      >
        Join the waitlist
        <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>

  <section class="py-14 md:py-20 bg-bg">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <div class="space-y-6 text-lg text-text-muted leading-relaxed">
        <p>Maybe you've already asked your doctor. Blood work? Unremarkable. Thyroid? Normal. Everything's fine — says the lab.</p>
        <p>But you <em>feel</em> that something isn't right. The bloating after meals. The facial flushing. The migraine that comes at the same cycle phase every month. The feeling that your body is working against you.</p>
        <p class="text-text font-medium">You're not imagining things. You're not oversensitive. And you're not making this up.</p>
      </div>
    </div>
  </section>

  <section class="py-14 md:py-20 bg-bg-alt">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-6">What happens if you ignore it</h2>
      <div class="space-y-5 text-text-muted leading-relaxed">
        <p>Your body is sending you signals. If you push through — train harder, eat less, power through — the symptoms won't disappear. They'll get louder.</p>
        <p>Histamine intolerance, hormonal imbalance, and cycle-related issues are more closely connected than most doctors tell you. But if you don't understand the connections, you're solving the wrong problem.</p>
      </div>
    </div>
  </section>

  <section class="py-14 md:py-20 bg-bg">
    <div class="max-w-3xl mx-auto px-4 md:px-6 text-center">
      <div class="w-16 h-1 bg-accent rounded-full mx-auto mb-8"></div>
      <h2 class="font-heading text-2xl md:text-3xl lg:text-4xl text-text mb-6">
        Your body isn't working against you. It speaks a language you haven't learned yet.
      </h2>
      <p class="text-lg text-text-muted max-w-2xl mx-auto">
        Hormones, histamine, and your cycle aren't enemies. They're a system. When you understand how it works, you can use it to your advantage — instead of fighting against it.
      </p>
    </div>
  </section>

  <section class="py-14 md:py-20 bg-accent/5">
    <div class="max-w-3xl mx-auto px-4 md:px-6 text-center">
      <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/10 text-accent rounded-full mb-6">
        Free Masterclass
      </span>
      <h2 class="font-heading text-3xl md:text-4xl text-text mb-4">{pageTitle}</h2>
      <p class="text-lg text-text-muted max-w-2xl mx-auto mb-8">
        In this masterclass, I'll show you as a physician how hormones, histamine, and your cycle interact — and how you can use this knowledge in your daily life.
      </p>
      <a
        href="#waitlist"
        class="inline-flex items-center px-8 py-4 text-base font-medium bg-accent hover:bg-accent-dark text-white transition-all duration-300 rounded-button shadow-lg shadow-accent/25"
        onclick={trackOnClick('masterclass_waitlist_signup', { ...analyticsBase, cta_location: 'inline' })}
      >
        Join the waitlist
        <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>

  <section class="py-14 md:py-20 bg-bg">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-8 text-center">How it works</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 md:gap-8">
        <div class="text-center">
          <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-accent/10 flex items-center justify-center">
            <svg class="w-6 h-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="font-medium text-text mb-2">Approx. 60 minutes</h3>
          <p class="text-sm text-text-muted">Compact and to the point. No filler material.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-accent/10 flex items-center justify-center">
            <svg class="w-6 h-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 12V5.25" />
            </svg>
          </div>
          <h3 class="font-medium text-text mb-2">Live + Recording</h3>
          <p class="text-sm text-text-muted">Watch live or at your own pace.</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 mx-auto mb-4 rounded-full bg-accent/10 flex items-center justify-center">
            <svg class="w-6 h-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
            </svg>
          </div>
          <h3 class="font-medium text-text mb-2">Actionable roadmap</h3>
          <p class="text-sm text-text-muted">You leave with a plan, not just knowledge.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-14 md:py-20 bg-bg-alt">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-10 text-center">What you'll learn</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
        {learnings.map((item, idx) => (
          <div class="flex items-start gap-4 js-reveal" style={`--reveal-delay: ${idx * 80}ms`}>
            <div class="w-10 h-10 rounded-full bg-accent/10 flex items-center justify-center shrink-0 mt-0.5">
              <span class="text-sm font-semibold text-accent">{idx + 1}</span>
            </div>
            <div>
              <h3 class="font-medium text-text mb-1">{item.title}</h3>
              <p class="text-sm text-text-muted leading-relaxed">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 md:py-24 bg-bg">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <div class="grid grid-cols-1 md:grid-cols-5 gap-10 md:gap-12 items-center">
        <div class="md:col-span-2 flex justify-center js-reveal">
          <Image
            src={founderImage}
            alt={`${founder.name} — ${founder.role}`}
            width={320}
            height={320}
            class="w-48 h-48 md:w-64 md:h-64 rounded-full object-cover shadow-lg"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="md:col-span-3 js-reveal" style="--reveal-delay: 150ms">
          <div class="w-12 h-1 bg-accent rounded-full mb-6"></div>
          <h2 class="font-heading text-2xl md:text-3xl text-text mb-2">Your masterclass host</h2>
          <p class="text-sm font-medium text-accent mb-5">{founder.name} &mdash; {founder.role}</p>
          <div class="space-y-4 text-text-muted leading-relaxed mb-6">
            <p>As an emergency physician, I know how important it is to take symptoms seriously — even when blood work looks normal. As an Ironman athlete, I know my own body to its limits.</p>
            <p>This masterclass combines both: medical expertise and personal experience. No fear-mongering, no dogma — just clear, honest answers to the questions you've been asking yourself.</p>
          </div>
          <ul class="space-y-2">
            {founder.qualifications.map((q) => (
              <li class="text-sm text-text-muted flex items-center gap-2">
                <svg class="w-4 h-4 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                {q}
              </li>
            ))}
            <li class="text-sm text-text-muted flex items-center gap-2">
              <svg class="w-4 h-4 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              Ironman athlete
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <FAQAccordion
    items={faqs}
    locale="en"
    pageType="masterclass"
    pageSlug={pageSlug}
  />

  <section id="waitlist" class="py-16 md:py-24 bg-primary-dark text-white">
    <div class="max-w-2xl mx-auto px-4 md:px-6 text-center">
      <h2 class="font-heading text-3xl md:text-4xl text-white mb-4">Be there when it launches.</h2>
      <p class="text-lg text-white/70 max-w-xl mx-auto mb-8">
        Join the waitlist now and be the first to know when the masterclass starts — including an exclusive early-bird benefit.
      </p>
      <div class="max-w-md mx-auto">
        <form
          id="masterclass-waitlist"
          class="flex flex-col sm:flex-row gap-3"
          data-email-payload={waitlistPayloadJson}
        >
          <input
            type="email"
            name="email"
            placeholder="Your email address"
            required
            class="flex-1 px-4 py-3 rounded-button text-text bg-white border-0 focus:ring-2 focus:ring-accent outline-none text-sm"
            aria-label="Email address for waitlist"
          />
          <button
            type="submit"
            class="px-6 py-3 text-sm font-medium bg-accent hover:bg-accent-dark text-white rounded-button transition-colors whitespace-nowrap"
          >
            Join waitlist
          </button>
        </form>
        <p class="waitlist-success hidden mt-4 text-white/90 text-sm" aria-live="polite">
          You're on the waitlist! We'll let you know when it launches.
        </p>
        <p class="waitlist-error hidden mt-4 text-red-300 text-sm" role="alert">
          Something went wrong. Please try again.
        </p>
        <p class="text-xs text-white/50 mt-3">No spam. You can unsubscribe at any time.</p>
      </div>
    </div>
  </section>

  <CTABand
    title="Have questions?"
    subtitle="Write to me — I respond personally."
    ctaText="Get in touch"
    ctaHref={getTranslatedPath('/kontakt', locale)}
    eventName="coaching_cta_click"
    locale="en"
    pageType="masterclass"
    pageSlug={pageSlug}
  />

  <script is:inline>
  (function() {
    var form = document.getElementById('masterclass-waitlist');
    if (!form) return;
    var btn = form.querySelector('button[type="submit"]');
    var btnText = btn ? btn.textContent : '';
    function setLoading(on) {
      if (!btn) return;
      btn.disabled = on;
      btn.textContent = on ? 'One moment…' : btnText;
      var input = form.querySelector('input[type="email"]');
      if (input) input.disabled = on;
    }
    function showError() {
      var el = form.parentElement.querySelector('.waitlist-error');
      if (el) el.classList.remove('hidden');
    }
    function hideError() {
      var el = form.parentElement.querySelector('.waitlist-error');
      if (el) el.classList.add('hidden');
    }
    form.addEventListener('submit', function(e) {
      e.preventDefault();
      var emailInput = form.querySelector('input[type="email"]');
      var email = emailInput ? emailInput.value : '';
      if (!email) return;
      hideError();
      setLoading(true);
      var payloadTemplate = form.dataset.emailPayload;
      var payload = payloadTemplate ? JSON.parse(payloadTemplate) : {};
      payload.email = email;
      var provider = 'placeholder';
      function onSuccess() {
        if (typeof trackEvent === 'function') {
          trackEvent('masterclass_waitlist_signup', {
            page_type: 'masterclass',
            page_slug: payload.masterclassSlug || '',
            locale: 'en',
            cta_location: 'product_bottom',
            provider: provider,
          });
        }
        form.style.display = 'none';
        var msg = form.parentElement.querySelector('.waitlist-success');
        if (msg) msg.classList.remove('hidden');
      }
      function onError() {
        setLoading(false);
        showError();
      }
      if (provider === 'placeholder') {
        console.log('[emailCapture:placeholder] masterclass_waitlist', JSON.stringify(payload, null, 2));
        onSuccess();
      } else {
        fetch('/api/email-capture', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        }).then(function(res) {
          if (res.ok) { onSuccess(); } else { onError(); }
        }).catch(function() { onError(); });
      }
    });
  })();
  </script>
</BaseLayout>
