---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LogoMarquee from '../../components/LogoMarquee.astro';
import VideoTestimonialCarousel from '../../components/VideoTestimonialCarousel.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import SocialStorytellingGrid from '../../components/SocialStorytellingGrid.astro';
import { siteConfig } from '../../data/site';
import { generateOrganization, generateWebSite, generateFounderPerson, generateFAQPage } from '../../data/schema';
import { buildHreflangTrilingual } from '../../i18n/hreflang';
import { videoTestimonials } from '../../data/videoTestimonials';
import { getSocialPosts } from '../../data/socialPosts';

import heroPhoto from '../../assets/images/founder/joost-standing-relaxed.webp';
import founderPhoto from '../../assets/images/founder/joost-sitting-laptop-looking-working.webp';

const locale = 'en';
const hreflang = buildHreflangTrilingual('/', '/en/', '/es/');

/* Client logos — auto-import all from Client-logos folder */
const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/Client-logos/*.{webp,avif,png,jpg}', { eager: true });
const logos = Object.entries(logoFiles)
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/, '');
    const name = filename.replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim();
    return { src: mod.default, alt: name };
  });

/* FAQ — SMB positioning */
const homepageFaq = [
  {
    q: 'What type of business is NXG Media for?',
    a: 'We work with hands-on SMBs: plumbers, roofers, contractors, installers, cleaning companies and other service providers who want to be found locally. No fluff — just more clients.',
  },
  {
    q: 'What does it cost to work with NXG Media?',
    a: 'Our packages start at €299 per month (Found). The most popular package is Growth (€599/mo) which includes ads and landing pages. <a href="/en/contact/">Book a free call</a> and we\'ll figure out what fits your situation.',
  },
  {
    q: 'How quickly will I see results?',
    a: 'With the Found package, you typically see better Google rankings within 4-6 weeks. With the Growth package (incl. ads), the first leads often come in within the first 2 weeks.',
  },
  {
    q: "What makes NXG Media different from a regular marketing agency?",
    a: 'We combine visibility in Google and AI search engines (ChatGPT, Gemini) with ads that deliver clients directly. No waffle, just a system that works. And you always have personal contact — no ticket system.',
  },
  {
    q: 'What is AI visibility?',
    a: 'More and more people search via ChatGPT, Google AI and other AI tools. We make sure your business gets found there too. <a href="' + siteConfig.external.scannerUrl + '" target="_blank" rel="noopener">Check for free how you score now</a>.',
  },
  {
    q: 'Am I locked into a contract?',
    a: 'No. Our packages are cancellable monthly. We believe you stay because it works, not because you\'re tied to a contract.',
  },
];

const socialPosts = getSocialPosts(6, 'en');

const faqForSchema = homepageFaq.map((f) => ({ question: f.q, answer: f.a }));

const schemas = [
  generateOrganization(locale),
  generateWebSite(locale),
  generateFounderPerson(locale),
  generateFAQPage(faqForSchema, locale),
];
---

<BaseLayout
  title="NXG Media — Get found. Get chosen. Get more enquiries."
  description="NXG Media helps SMBs become more visible in Google, ChatGPT and other AI search engines — and combines that with ads that deliver clients."
  locale={locale}
  hreflang={hreflang}
  schemas={schemas}
  hideNewsletter={true}
>

  {/* ══════════════════════════════════════════════════
      HERO — blue, big, impactful
      ══════════════════════════════════════════════════ */}
  <section class="bg-primary text-white relative overflow-hidden">
    <div class="max-w-[1260px] mx-auto px-5 md:px-8 py-14 md:py-20 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">

        {/* Left: copy */}
        <div class="relative z-10">
          <p class="eyebrow light mb-5">NXG MEDIA · ONLINE MARKETING FOR SMBS</p>

          <h1 class="font-heading font-extrabold text-[2.75rem] leading-[0.98] md:text-[3.5rem] lg:text-[4rem] text-white mb-6 uppercase">
            Get found.<br />
            Get chosen.<br />
            <span class="marker">Get more enquiries.</span>
          </h1>

          <p class="text-white/75 text-base leading-relaxed mb-8 max-w-lg">
            <strong class="text-white font-semibold">NXG Media</strong> helps SMBs become more visible
            in Google, ChatGPT and other AI search engines
            — and combines that with ads that deliver clients.
          </p>

          <div class="flex flex-wrap gap-3 mb-6">
            <a
              href="/en/contact/"
              class="inline-flex items-center gap-2 px-6 py-[15px] text-[15px] font-extrabold text-text bg-accent hover:brightness-95 transition-all rounded-button"
            >
              Book a free call
              <span aria-hidden="true">↗</span>
            </a>
            <a
              href="#packages"
              class="inline-flex items-center gap-2 px-6 py-[15px] text-[15px] font-extrabold text-white border-2 border-white/30 hover:border-white/60 transition-colors rounded-button"
            >
              View our packages
            </a>
          </div>
        </div>

        {/* Right: hero photo */}
        <div class="relative flex justify-center lg:justify-end">
          <div class="relative">
            <Image
              src={heroPhoto}
              alt="Joost van Putten — founder NXG Media"
              width={520}
              height={640}
              class="relative z-10 max-h-[500px] md:max-h-[580px] w-auto object-contain drop-shadow-2xl"
              loading="eager"
            />

            {/* Sticky note: testimonial */}
            <div class="absolute top-4 right-0 md:-right-4 z-20 sticky-note text-base md:text-lg max-w-[200px] rotate-2">
              "More enquiries.<br />That's real work."
            </div>

            {/* Sticky note: SMB badge */}
            <div class="absolute bottom-16 -right-2 md:right-0 z-20 sticky-note text-lg md:text-xl font-black uppercase -rotate-3">
              SMBs just<br />get it done.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      LOGO MARQUEE — client logos
      ══════════════════════════════════════════════════ */}
  <LogoMarquee
    logos={logos}
    label="MARKETING WORK FOR AMONG OTHERS"
    speed={35}
  />


  {/* ══════════════════════════════════════════════════
      TRUST STRIP — 3 key points
      ══════════════════════════════════════════════════ */}
  <section class="py-14 md:py-20 border-b border-border">
    <div class="max-w-[1260px] mx-auto px-5 md:px-8">
      <div class="grid md:grid-cols-3 gap-8 md:gap-10">

        <div class="flex items-start gap-4">
          <div class="shrink-0 w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center">
            <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
          </div>
          <div>
            <h3 class="font-heading font-extrabold text-lg mb-1">Google + AI</h3>
            <p class="text-text-muted text-sm leading-relaxed">More visible in Google, ChatGPT and other AI search engines.</p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="shrink-0 w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center">
            <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
          </div>
          <div>
            <h3 class="font-heading font-extrabold text-lg mb-1">Clear pricing</h3>
            <p class="text-text-muted text-sm leading-relaxed">Transparent packages. No surprises.</p>
          </div>
        </div>

        <div class="flex items-start gap-4">
          <div class="shrink-0 w-10 h-10 rounded-full bg-primary/10 flex items-center justify-center">
            <svg class="w-5 h-5 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
          </div>
          <div>
            <h3 class="font-heading font-extrabold text-lg mb-1">No fluff</h3>
            <p class="text-text-muted text-sm leading-relaxed">Practical, personal and results-driven.</p>
          </div>
        </div>

      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      VIDEO TESTIMONIALS
      ══════════════════════════════════════════════════ */}
  <VideoTestimonialCarousel
    title="What clients say"
    subtitle="Real entrepreneurs on their collaboration with NXG Media"
    eyebrow="WHAT CLIENTS SAY"
    testimonials={videoTestimonials}
  />


  {/* ══════════════════════════════════════════════════
      AI SCANNER CTA — dark section
      ══════════════════════════════════════════════════ */}
  <section class="bg-bg-dark text-white py-[104px]">
    <div class="max-w-[1260px] mx-auto px-5 md:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div>
          <p class="eyebrow light mb-4">FREE AI VISIBILITY CHECK</p>
          <h2 class="font-heading font-extrabold text-4xl md:text-[3.5rem] lg:text-[4rem] leading-[0.98] text-white mb-6 uppercase">
            How visible<br />
            <span class="text-accent">is your business?</span>
          </h2>
        </div>
        <div>
          <p class="text-white/70 text-base leading-relaxed mb-8">
            Discover in 30 seconds how visible your business is in Google and AI search engines
            like ChatGPT. No hassle, no account needed.
          </p>
          <a
            href={siteConfig.external.scannerUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-6 py-[15px] text-[15px] font-extrabold text-text bg-accent hover:brightness-95 transition-all rounded-button"
          >
            Check your visibility
            <span aria-hidden="true">↗</span>
          </a>
          <p class="mt-4 text-white/40 text-sm">Free · No account · Results in 30 seconds</p>
        </div>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      PACKAGES — pricing
      ══════════════════════════════════════════════════ */}
  <section id="packages" class="py-[104px]">
    <div class="max-w-[1260px] mx-auto px-5 md:px-8">

      <div class="mb-12 md:mb-16">
        <p class="eyebrow text-primary mb-4">CLEAR BEFORE YOU COMMIT</p>
        <h2 class="font-heading font-extrabold text-4xl md:text-[3.5rem] lg:text-[4rem] leading-[0.98] text-text uppercase">
          Pick your package.
        </h2>
        <p class="text-text-muted mt-4 max-w-2xl text-base leading-relaxed">
          Whether you're just getting started or ready to scale — we have a package that fits your ambitions.
          Every package is focused on more visibility, more traffic and more clients.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-6 lg:gap-8">

        {/* Found — €299 */}
        <div class="relative border-2 border-border rounded-xl p-6 md:p-8 flex flex-col">
          <h3 class="font-heading font-extrabold text-2xl mb-1 uppercase">Found</h3>
          <p class="text-text-muted text-sm mb-4">Start with visibility.</p>
          <p class="font-heading font-extrabold text-5xl md:text-6xl text-text mb-1">&euro;299</p>
          <p class="text-text-muted text-sm mb-6">per month</p>

          <ul class="space-y-3 mb-8 flex-1">
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Website optimisation</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Better local rankings</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Google Business profile</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Monthly report</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Personal support</li>
          </ul>

          <a href="/en/contact/" class="block w-full py-[15px] text-center text-[15px] font-extrabold text-text border-2 border-text rounded-button hover:bg-text hover:text-white transition-colors">
            Start with Found ↗
          </a>
        </div>

        {/* Growth — €599 (highlighted) */}
        <div class="relative border-2 border-primary rounded-xl p-6 md:p-8 flex flex-col shadow-lg">
          <div class="absolute -top-4 left-1/2 -translate-x-1/2 z-10">
            <span class="sticky-note text-sm font-black uppercase px-4 py-1.5 rotate-[-2deg]">Most popular</span>
          </div>

          <h3 class="font-heading font-extrabold text-2xl mb-1 uppercase">Growth</h3>
          <p class="text-text-muted text-sm mb-4">More traffic. More clients.</p>
          <p class="font-heading font-extrabold text-5xl md:text-6xl text-text mb-1">&euro;599</p>
          <p class="text-text-muted text-sm mb-6">per month</p>

          <ul class="space-y-3 mb-8 flex-1">
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Everything in the Found package</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Ads (Google &amp; Social)</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Landing pages that convert</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Monthly content</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Strategy &amp; optimisation</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Personal support</li>
          </ul>

          <a href="/en/contact/" class="block w-full py-[15px] text-center text-[15px] font-extrabold text-text bg-accent hover:brightness-95 rounded-button transition-all">
            Start with Growth ↗
          </a>
        </div>

        {/* Full diary — €999 */}
        <div class="relative border-2 border-border rounded-xl p-6 md:p-8 flex flex-col">
          <h3 class="font-heading font-extrabold text-2xl mb-1 uppercase">Full diary</h3>
          <p class="text-text-muted text-sm mb-4">Maximum growth. No empty days.</p>
          <p class="font-heading font-extrabold text-5xl md:text-6xl text-text mb-1">&euro;999</p>
          <p class="text-text-muted text-sm mb-6">per month</p>

          <ul class="space-y-3 mb-8 flex-1">
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Everything in the Growth package</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Advanced ad campaigns</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Multiple landing pages</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Content creation (photo, video, copy)</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Continuous optimisation</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Strategic advice</li>
            <li class="flex items-start gap-2 text-sm"><svg class="w-5 h-5 text-primary shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>Priority support</li>
          </ul>

          <a href="/en/contact/" class="block w-full py-[15px] text-center text-[15px] font-extrabold text-text border-2 border-text rounded-button hover:bg-text hover:text-white transition-colors">
            Start with Full diary ↗
          </a>
        </div>

      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      ABOUT JOOST — founder
      ══════════════════════════════════════════════════ */}
  <section class="bg-primary text-white py-[104px]">
    <div class="max-w-[1260px] mx-auto px-5 md:px-8">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <div class="flex justify-center lg:justify-start">
          <div class="relative">
            <Image
              src={founderPhoto}
              alt="Joost van Putten — founder NXG Media"
              width={480}
              height={480}
              class="w-full max-w-[400px] rounded-xl shadow-2xl"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute bottom-4 left-4 right-4 bg-black/60 backdrop-blur-sm rounded-lg px-4 py-3">
              <p class="text-white font-extrabold text-sm">Joost van Putten · Founder NXG Media</p>
            </div>
          </div>
        </div>

        <div>
          <p class="eyebrow light mb-4">THE PERSON BEHIND NXG MEDIA</p>
          <h2 class="font-heading font-extrabold text-4xl md:text-[3.5rem] leading-[0.98] text-white mb-6 uppercase">
            Hi, I'm Joost.<br />
            <span class="text-accent">I build with you.</span>
          </h2>
          <p class="text-white/70 text-base leading-relaxed mb-6">
            For over 7 years I've been helping business owners with online marketing. From campaigns to websites: I want to know what it actually delivers for the business behind it.
          </p>
          <p class="text-white/70 text-base leading-relaxed mb-8">
            <strong class="text-white">You want clients. We make a concrete plan to get your next enquiries.</strong>
          </p>
          <a
            href="/en/about-joost/"
            class="inline-flex items-center gap-2 px-6 py-[15px] text-[15px] font-extrabold text-text bg-accent hover:brightness-95 transition-all rounded-button"
          >
            More about Joost
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      FAQ
      ══════════════════════════════════════════════════ */}
  <section class="py-[104px]">
    <div class="max-w-[1260px] mx-auto px-5 md:px-8">
      <div class="grid lg:grid-cols-[1fr_2fr] gap-12 lg:gap-20">
        <div>
          <p class="eyebrow text-primary mb-4">JUST A STRAIGHT ANSWER</p>
          <h2 class="font-heading font-extrabold text-4xl md:text-[3.5rem] lg:text-[4rem] leading-[0.98] text-text uppercase">
            Good<br />
            <span class="marker">questions.</span>
          </h2>
        </div>
        <div>
          <FAQAccordion
            items={homepageFaq}
            locale="en"
            pageType="homepage"
            pageSlug="/en/"
            minimal={true}
          />
        </div>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      INSTAGRAM GRID — personal
      ══════════════════════════════════════════════════ */}
  <SocialStorytellingGrid
    posts={socialPosts}
    instagramUrl={siteConfig.socials.instagram}
    locale="en"
  />


  {/* ══════════════════════════════════════════════════
      FOOTER CTA — yellow accent band
      ══════════════════════════════════════════════════ */}
  <section class="bg-accent py-16 md:py-20">
    <div class="max-w-[1260px] mx-auto px-5 md:px-8 flex flex-col md:flex-row items-center justify-between gap-8">
      <div>
        <h2 class="font-heading font-extrabold text-3xl md:text-[2.5rem] leading-[0.98] text-text uppercase">
          Get found. Get chosen.<br />
          <span class="text-primary">Get more enquiries.</span>
        </h2>
      </div>
      <a
        href="/en/contact/"
        class="inline-flex items-center gap-2 px-6 py-[15px] text-[15px] font-extrabold text-white bg-text hover:bg-primary transition-colors rounded-button shrink-0"
      >
        Book a free call
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

</BaseLayout>
