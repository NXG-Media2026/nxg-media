---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import '../../styles/lander.css';
import '../../styles/home.css';
import landerScriptUrl from '../../scripts/lander.js?url';
import SEOHead from '../../components/SEOHead.astro';
import Header from '../../components/Header.astro';
import NxgSearchMethod from '../../components/NxgSearchMethod.astro';
import { SHOW_HOME_PRICING } from '../../data/navigation';
import CookieConsent from '../../components/CookieConsent.astro';
import { getTrackingScript, getCapiHelperScript } from '../../lib/analytics';
import { siteConfig } from '../../data/site';
import { generateOrganization, generateWebSite, generateFounderPerson, generateFAQPage } from '../../data/schema';
import { buildHreflangTrilingual } from '../../i18n/hreflang';
import { videoTestimonials } from '../../data/videoTestimonials';
import heroPhoto from '../../assets/images/founder/joost-standing-relaxed.webp';
const clientLogoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/Client-logos/*.{webp,avif,png,jpg}', { eager: true });
const clientLogos = Object.entries(clientLogoFiles).map(([file, mod]) => ({ src: mod.default, alt: file.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/i, '').replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim() }));
const faq=[
{question:'What type of businesses do you work with?',answer:'With business owners who need enquiries: from trade businesses and local practices to coaches and experts. We look at your services, target audience and growth plans to determine what approach fits.'},
{question:'What do you do around AI Search?',answer:'We combine a strong website, content and technical optimisation for organic AI visibility with AI Search Ads where appropriate. We work on visibility in search engines and AI answers, and on the path from visitor to enquiry.'},
{question:'What does it cost to work with NXG-media?',answer:'NXG Foundation costs €349 per month for three months (€1,047 total). NXG Growth costs €799 per month for the first three months (€2,397 total), including Foundation. Ad budget is separate. For the full details and guarantee terms, see the complete Growth offer.'},
{question:'Do I have to choose Growth right away?',answer:'No. We first look at what you need. You can start with your Foundation or choose an approach where we also work on visibility, campaigns and enquiries on an ongoing basis.'},
{question:'Does my website stay mine?',answer:'The delivered Foundation, your content and the optimisations we build remain yours. Ongoing hosting, app and licence costs and transfer terms are agreed upfront.'},
{question:'Do you also run ChatGPT Ads?',answer:'Yes, if it fits your business and audience. ChatGPT Ads is available in the Netherlands. We include it within the NXG AI Search system, alongside organic AI visibility, Google Search and your website.'},
{question:'How do we get started?',answer:'Book an introductory call or fill in the free AI Search scanner first. In the call we discuss where you stand now, what you want to achieve and what approach and investment fit.'}
];
const schemas=[generateOrganization('en'),generateWebSite('en'),generateFounderPerson('en'),generateFAQPage(faq.filter(item => SHOW_HOME_PRICING || !['What does it cost to work with NXG-media?', 'Do I have to choose Growth right away?'].includes(item.question)),'en')];
---
<!doctype html><html lang="en"><head>
<SEOHead title="NXG-media | AI Search Agency for more enquiries" description="More enquiries through the new generation of search. NXG-media combines AI visibility, AI Search Ads and websites that convert. View our work and approach." canonical="https://nxg-media.com/en/" locale="en" hreflang={buildHreflangTrilingual('/', '/en/', '/es/')} schemas={schemas} />
<meta name="theme-color" content="#0756ef">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin><link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800;900&family=DM+Sans:wght@400;500;600;650;700;800&display=swap" rel="stylesheet">
</head><body class="nxg-home"><a class="skip" href="#main">Skip to content</a>
<Header locale="en" currentPath="/en/" hreflang={buildHreflangTrilingual('/', '/en/', '/es/')} />
<main id="main">
<section class="home-hero"><div class="wrap home-hero-grid"><div class="home-hero-copy"><p class="eyebrow light">NXG-MEDIA · AI SEARCH AGENCY</p><h1>YOUR NEXT CLIENT<br><span class="home-underline">IS ALREADY<br>SEARCHING.</span></h1><p>With the NXG AI Search system we put your business in front of them and turn that interest into enquiries.</p><p class="home-hero-method">AI visibility <span>+</span> AI Search Ads <span>+</span> a website that converts.</p><div class="home-actions"><a class="button yellow" href="/landermkb/#groeisessie">View my AI Search opportunities <span aria-hidden="true">↗</span></a><a class="home-secondary" href="#cases">View our work ↓</a></div><a class="home-ai-news" href="/landermkb/#chatgpt-ads"><img src="/lander-assets/platforms/openai.svg" alt="" width="34" height="34" /><span><b>NEW IN THE NETHERLANDS</b><strong>ChatGPT Ads.</strong><small>Also part of the NXG AI Search system, when it fits.</small></span><span aria-hidden="true">↗</span></a></div><div class="home-portrait"><Image src={heroPhoto} alt="Joost van Putten, founder of NXG-media" width={660} height={780} loading="eager" fetchpriority="high" /><div class="home-photo-caption"><span>FOR SMBS, PRACTICES &amp; SERVICE PROVIDERS</span><strong>At least 15 enquiries.<br>In 90 days.</strong><p class="home-promise-refund">Or you get &euro;1,500 back.</p><a class="home-promise-link" href="/landermkb/#garantie">With the NXG AI Search system · view the guarantee ↗</a><a href="/en/about-joost/">Joost van Putten · Founder ↗</a></div><span class="home-experience"><b>7+</b> years of experience<br>in online marketing</span></div></div></section>
<section class="client-proof" aria-label="Companies we have done marketing work for"><div class="wrap proof-heading"><p>MARKETING WORK FOR AMONG OTHERS</p><button class="logos-toggle" type="button" aria-pressed="false">Pause logos</button></div><div class="client-window"><div class="client-track">{[0, 1].map(copy => <div class="client-group" aria-hidden={copy === 1 ? 'true' : undefined}>{clientLogos.map(logo => <div class="client-logo"><Image src={logo.src} alt={copy === 0 ? logo.alt : ''} height={48} loading="lazy" decoding="async" /></div>)}</div>)}</div></div></section><section class="section results" id="cases"><div class="wrap"><p class="eyebrow">AI SEARCH IN PRACTICE</p><h2>FROM BEING FOUND.<br><span class="blue">TO REAL ENQUIRIES.</span></h2><p class="results-intro">Two clients for whom we tackled the online foundation and visibility. This is what it delivered.</p><div class="case-grid"><article class="result-card"><div class="case-person"><img src="/lander-assets/proof/james.webp" alt="Dr. James Mitchell" width="80" height="80" loading="lazy"><div><strong>Costa Blanca Movement Centre</strong><a href="https://www.costablancamovement.com/" target="_blank" rel="noopener noreferrer">costablancamovement.com ↗</a></div></div><h3>FROM ZERO TO<br>12–15 PATIENTS PER MONTH.</h3><p>No website, no Google history and no backlinks. Within 14 days the new foundation was on page 1 in Google. After 2 months, 12–15 patients per month came in online.</p><div class="case-metrics"><div><strong>12–15</strong><span>patients per month online</span></div><div><strong>800+</strong><span>organic visitors per month</span></div></div><div class="case-proof"><a href="/lander-assets/proof/google-proof.webp" target="_blank" rel="noopener"><img src="/lander-assets/proof/google-proof.webp" alt="Google result from the Costa Blanca Movement Centre case" width="600" height="360" loading="lazy"><span>Google page 1 after 14 days · view proof ↗</span></a><a href="/lander-assets/proof/chatgpt-proof.webp" target="_blank" rel="noopener"><img src="/lander-assets/proof/chatgpt-proof.webp" alt="ChatGPT mentions Costa Blanca Movement Centre as a local option" width="600" height="360" loading="lazy"><span>Mentioned by ChatGPT · view proof ↗</span></a></div></article><article class="result-card"><div class="case-person"><img src="/lander-assets/proof/verena.webp" alt="Dr. Verena Mann" width="80" height="80" loading="lazy"><div><strong>Dr. Verena Mann</strong><a href="https://doc-veri.pages.dev/" target="_blank" rel="noopener noreferrer">doc-veri.pages.dev ↗</a></div></div><h3>FROM 2 TO 19<br>ENQUIRIES PER MONTH.</h3><p>Plenty of expertise and a community, but barely any enquiries through the website. By showcasing her expertise, proof and enquiry path more clearly, she grew to 19 enquiries per month and was mentioned by ChatGPT.</p><div class="case-metrics"><div><strong>2 → 19</strong><span>enquiries per month</span></div><div><strong>0 → 15</strong><span>AI mentions</span></div></div><div class="case-proof single"><a href="/lander-assets/proof/verena-proof.webp" target="_blank" rel="noopener"><img src="/lander-assets/proof/verena-proof.webp" alt="ChatGPT mention of Dr. Verena Mann from her case" width="1200" height="360" loading="lazy"><span>Mentioned as expert by ChatGPT · view proof ↗</span></a></div></article></div><div class="results-bottom"><p>From local practice to growing business.<br><strong>View the work behind the results.</strong></p><a class="button yellow" href="/en/cases/">More client cases <span aria-hidden="true">↗</span></a></div></div></section><section class="section home-services" id="diensten"><div class="wrap"><div class="home-section-heading"><div><p class="eyebrow">TWO ROUTES. ONE GOAL.</p><h2>WHICH APPROACH<br><span class="blue">FITS YOU?</span></h2></div><p>From local service provider to coach or expert. We tailor the approach to your business and the clients you want to reach.</p></div><div class="home-service-grid home-service-duo"><a class="home-service" href="/landermkb/"><span class="home-index">01 / SMBS, PRACTICES &amp; SERVICE PROVIDERS</span><h3>THE NXG<br>AI SEARCH SYSTEM.</h3><p>AI visibility, AI Search Ads and a website that converts. One system. At least 15 qualified enquiries within 90 days of going live, or &euro;1,500 back.</p><span class="home-service-link">Discover the NXG AI Search system ↗</span></a><a class="home-service" href="/en/coach-accelerator/"><span class="home-index">02 / COACHES &amp; EXPERTS</span><h3>COACH<br>ACCELERATOR.</h3><p>Connect your expertise, offer, campaigns and follow-up. A growth system that fits how your clients make decisions.</p><span class="home-service-link">View Coach Accelerator ↗</span></a></div></div></section><NxgSearchMethod ctaHref="/landermkb/#groeisessie" /><section class="section home-testimonials"><div class="wrap"><div class="home-section-heading"><div><p class="eyebrow">THE COLLABORATION, IN THEIR WORDS</p><h2>THEY ALREADY<br><span class="blue">WORKED WITH JOOST.</span></h2></div><p>From campaigns to growth strategy: hear from business owners themselves how they experienced the collaboration.</p></div><div class="home-video-track" tabindex="0" role="region" aria-label="Client videos, horizontally scrollable">{videoTestimonials.map(v=><article class="home-video-card"><video controls playsinline preload="none" poster={v.thumbnail.src} aria-label={'Experience of '+v.name+' from '+v.company}><source src={v.videoUrl} type="video/mp4" /><a href={v.videoUrl}>Watch the video of {v.name}</a></video><div><h3>{v.name}</h3><p class="home-company">{v.company}</p><blockquote>{v.quote}</blockquote></div></article>)}</div><p class="home-scroll-hint">Scroll through the five client stories →</p></div></section>{SHOW_HOME_PRICING && (<section class="section home-offers" id="pakketten"><div class="wrap"><div class="home-section-heading"><div><p class="eyebrow">THE PACKAGES WITHIN OUR SMB APPROACH</p><h2>YOUR FOUNDATION.<br><span class="blue">YOUR GROWTH.</span></h2></div><p>Start with a strong Foundation. Or let us actively work on your next enquiries with Growth.</p></div><div class="home-offer-grid"><article><p class="eyebrow">NXG FOUNDATION</p><h3>READY FOR THE<br>NEW GENERATION OF SEARCH.</h3><p>A website, content and technical foundation that makes your expertise visible and guides visitors to contact.</p><div class="home-price">€349 <span>/ month</span></div><p>3 months · €1,047 total</p><a class="button home-outline" href="/landermkb/#investering">View the Foundation <span>↗</span></a></article><article class="home-growth"><p class="eyebrow">NXG GROWTH · THE COMPLETE SYSTEM</p><h3>YOUR FOUNDATION.<br>AND ACTIVELY MORE ENQUIRIES.</h3><p>Including Foundation, ongoing AI visibility, AI Search Ads where needed and improvement of your enquiry path.</p><div class="home-price">€799 <span>/ month</span></div><p>First 3 months · €2,397 total</p><a class="button black" href="/landermkb/">Discover Growth and the guarantee <span>↗</span></a><p class="home-offer-note">Ad budget separate. See the terms and conditions with the offer.</p></article></div></div></section>)}<section class="section founder"><div class="wrap founder-grid"><div class="founder-photo"><img src="/lander-assets/proof/joost.webp" alt="Joost van Putten, founder of NXG-media, at work" width="850" height="1000" loading="lazy"><span>Joost van Putten · Founder NXG-media</span></div><div><p class="eyebrow">THE PERSON BEHIND NXG-MEDIA</p><h2>HI, I'M JOOST.<br><span class="blue">I BUILD WITH YOU.</span></h2><p>For over 7 years I have been helping business owners with online marketing. From campaigns to websites: I want to know what it delivers for the business behind it.</p><p class="strong">You want clients. We make a concrete plan for your next enquiries.</p><a class="text-link" href="/en/about-joost/">More about Joost <span aria-hidden="true">↗</span></a></div></div></section><section class="home-scanner"><div class="wrap"><div><p class="eyebrow">START WITH INSIGHT</p><h2>DOES AI MENTION YOU.<br>OR YOUR COMPETITOR?</h2><p>Discover how your business scores with our free AI Search scanner.</p></div><a class="button black" href={siteConfig.external.scannerUrl} target="_blank" rel="noopener noreferrer">Check my AI visibility <span aria-hidden="true">↗</span></a></div></section>
<section class="section faq"><div class="wrap faq-grid"><div><p class="eyebrow">GOOD TO KNOW</p><h2>GOOD<br><span class="blue">QUESTIONS.</span></h2></div><div class="questions">{faq.filter(item => SHOW_HOME_PRICING || !['What does it cost to work with NXG-media?', 'Do I have to choose Growth right away?'].includes(item.question)).map(f=><details><summary>{f.question}</summary><p>{f.answer}</p></details>)}</div></div></section>
<section class="home-contact"><div class="wrap"><p class="eyebrow light">YOU DON'T HAVE TO FIGURE IT OUT ALONE</p><h2>WHAT CAN THE NXG<br><span class="home-underline">AI SEARCH SYSTEM</span><br>DO FOR YOU?</h2><p>We look at where your clients search, what opportunities exist and whether your business qualifies for the 15-enquiry guarantee.</p><a class="button yellow" href="/landermkb/#groeisessie">View my AI Search opportunities <span aria-hidden="true">↗</span></a></div></section>
</main><footer><div class="wrap home-footer"><div><a class="brand" href="/en/">NXG<span>-media</span><small>AI Search Agency</small></a><p>You run your business.<br>We build with you.</p></div><div><h3>DISCOVER</h3><a href="/landermkb/">NXG AI Search system</a><a href="/en/coach-accelerator/">Coach Accelerator</a></div><div><h3>NXG-MEDIA</h3><a href="/en/cases/">Cases</a><a href="/en/about-joost/">About Joost</a><a href="/en/guides/">Knowledge</a><a href="/en/contact/">Contact</a></div><div><h3>STAY IN TOUCH</h3><a href={'mailto:'+siteConfig.email}>{siteConfig.email}</a><a href={siteConfig.socials.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href={siteConfig.socials.instagram} target="_blank" rel="noopener noreferrer">Instagram ↗</a><p><a href="/" lang="nl">Nederlands</a> · <a href="/es/" lang="es">Español</a></p></div></div><div class="wrap footer-bottom"><span>© <span id="year">2026</span> NXG-media · KVK 78318122</span><span><a href="/en/privacy/">Privacy</a> · <a href="/en/terms/">Terms</a></span></div></footer>
<CookieConsent locale="en" /><script is:inline set:html={getTrackingScript()} /><script is:inline set:html={getCapiHelperScript()} /><script is:inline src={landerScriptUrl}></script></body></html>
