---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HeroSection from '../../components/HeroSection.astro';
import TrustBar from '../../components/TrustBar.astro';
import ApproachSection from '../../components/ApproachSection.astro';
import ServicesGrid from '../../components/ServicesGrid.astro';
import FAQAccordion from '../../components/FAQAccordion.astro';
import CTABand from '../../components/CTABand.astro';
import { siteConfig } from '../../data/site';
import { generateOrganization, generateWebSite, generateFAQPage } from '../../data/schema';
import { buildHreflangPair } from '../../i18n/hreflang';
import { trackOnClick } from '../../lib/analytics';

import heroImage from '../../assets/images/Founder/portrait-beach.jpg';
import ctaBackground from '../../assets/images/Founder/lifestyle-laughing.jpg';

import productHistamin from '../../assets/images/products/histamin-bundle.png';
import coachingImage from '../../assets/images/Founder/lifestyle-arms-up.jpg';

const locale = 'en';

const trustItems = [
  { value: 'MD', label: 'Licensed\nPhysician' },
  { value: '100%', label: 'Evidence-\nBased' },
  { value: '♀', label: 'By Women,\nFor Women' },
];

const approachItems = [
  {
    icon: 'evidence',
    title: 'Science-backed',
    description: 'All content is based on current research and medical expertise — no trends, no myths.',
  },
  {
    icon: 'personalized',
    title: 'Individual & practical',
    description: 'No one-size-fits-all. My offerings consider your cycle, your training, and your life phase.',
  },
  {
    icon: 'nonsurgical',
    title: 'Holistic',
    description: 'Hormones, training, nutrition, and lifestyle — everything is connected. I look at the big picture.',
  },
  {
    icon: 'multilingual',
    title: 'Clearly explained',
    description: 'Medical knowledge, presented so you can apply it immediately — without the jargon.',
  },
];

const offerItems = [
  {
    title: 'Products',
    slug: 'products',
    href: '/en/products',
    excerpt: 'Digital guides, e-books, and courses — evidence-based and ready to use. For hormones, training, nutrition, and more.',
    coverImages: [
      { src: productHistamin, alt: 'Histamine Bundle' },
    ],
  },
  {
    title: 'Coaching',
    slug: 'coaching',
    href: '/en/coaching',
    excerpt: 'Individual coaching for your health goals — personally guided, evidence-based, and tailored to you.',
    image: coachingImage,
    imageAlt: 'Dr. Verena Mann — Coaching',
  },
  {
    title: 'Free Masterclass',
    slug: 'masterclass',
    href: '/en/masterclass/hormones-histamine-cycle-superpower',
    excerpt: 'Hormones, histamine & your cycle as a superpower — a free masterclass that connects the dots.',
  },
];

const homepageFAQs = [
  {
    q: 'What is doc.veri?',
    a: "doc.veri is Dr. Verena's platform for evidence-based women's health. You'll find knowledge, products, and coaching on hormones, training, nutrition, and your cycle — all science-backed and practical.",
  },
  {
    q: 'Who are these offerings for?',
    a: "For all women who want to take charge of their health — whether you're an athlete, a working professional, or navigating perimenopause. The content is suitable for every fitness level and life phase.",
  },
  {
    q: 'Is Dr. Verena really a physician?',
    a: 'Yes! Dr. Verena is a licensed physician with a passion for endurance sports. She combines medical expertise with practical experience as an Ironman athlete.',
  },
  {
    q: 'How is doc.veri different from other health platforms?',
    a: 'doc.veri is committed to science over trends. All content is based on current research and created by a physician — no bro-science, no pseudoscience.',
  },
];
---

<BaseLayout
  title={`Women's Health — Evidence-Based | ${siteConfig.name}`}
  description="Hormones, training, nutrition, cycle, perimenopause — evidence-based, no bro-science. By Dr. Verena Mann, physician and endurance athlete."
  hreflang={buildHreflangPair('/', '/en')}
  schemas={[
    generateOrganization(),
    generateWebSite('en'),
    generateFAQPage(homepageFAQs),
  ]}
  locale="en"
>
  <HeroSection
    title="Women's health, evidence-based."
    subtitle="Hormones, training, nutrition, cycle, perimenopause — no bro-science, no pseudoscience. By Dr. Verena Mann, physician and Ironman athlete."
    backgroundImage={heroImage}
    backgroundAlt="Dr. Verena Mann — Physician and founder of doc.veri"
    ctaText="Explore offers"
    ctaHref="/en/offers"
    secondaryCtaText="Free Masterclass"
    secondaryCtaHref="/en/masterclass/hormones-histamine-cycle-superpower"
    locale="en"
    pageType="homepage"
    pageSlug="/en"
    eventName="product_cta_click"
  />

  <TrustBar items={trustItems} />

  <ApproachSection
    title="My Approach"
    items={approachItems}
    locale="en"
  />

  <ServicesGrid
    title="What I offer"
    subtitle="Knowledge and guidance for every phase of your health journey."
    services={offerItems}
    locale="en"
    pageType="homepage"
    pageSlug="/en"
    viewAllHref="/en/offers"
    viewAllLabel="View all offers"
  />

  <section class="py-16 md:py-20 bg-bg-alt">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <div class="md:flex items-center gap-10 lg:gap-14">
        <div class="md:w-3/5 mb-8 md:mb-0">
          <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/10 text-accent rounded-full mb-4">
            Free Masterclass
          </span>
          <h2 class="font-heading text-2xl md:text-3xl text-text mb-4">
            Hormones, Histamine &amp; Your Cycle as a Superpower
          </h2>
          <p class="text-text-muted leading-relaxed mb-6">
            You&rsquo;re doing a lot of things right — but still don&rsquo;t feel like yourself? In this free masterclass, Dr. Verena Mann shows you how hormones, your cycle, histamine, and stress are connected — and what first steps actually make sense.
          </p>
          <a
            href="/en/masterclass/hormones-histamine-cycle-superpower"
            class="inline-flex items-center px-6 py-3 text-sm font-medium text-text-inverse bg-primary hover:bg-primary-dark rounded-button transition-colors"
            onclick={trackOnClick('masterclass_cta_click', {
              page_type: 'homepage',
              page_slug: '/en',
              locale: 'en',
              masterclass_slug: 'hormones-histamine-cycle-superpower',
              cta_location: 'inline',
            })}
          >
            Join the waitlist
            <svg class="ml-2 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>
        <div class="md:w-2/5">
          <div class="bg-white rounded-card border border-border p-6 text-center">
            <div class="w-14 h-14 mx-auto rounded-full bg-accent/10 flex items-center justify-center mb-4">
              <svg class="w-7 h-7 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.91 11.672a.375.375 0 010 .656l-5.603 3.113a.375.375 0 01-.557-.328V8.887c0-.286.307-.466.557-.327l5.603 3.112z" />
              </svg>
            </div>
            <p class="text-sm font-medium text-text mb-1">Free</p>
            <p class="text-xs text-text-muted">Join the waitlist and be the first to know when it launches.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <FAQAccordion
    items={homepageFAQs}
    locale="en"
    pageType="homepage"
    pageSlug="/en"
    maxItems={4}
    showMoreLink={true}
  />

  <CTABand
    title="Ready to take charge of your health?"
    subtitle="Discover my products, coaching, and the community — all evidence-based."
    ctaText="Explore offers"
    ctaHref="/en/offers"
    backgroundImage={ctaBackground}
    backgroundAlt="Dr. Verena Mann"
    eventName="product_cta_click"
    locale="en"
    pageType="homepage"
    pageSlug="/en"
  />
</BaseLayout>
