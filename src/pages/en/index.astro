---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../data/site';
import { generateOrganization, generateWebSite, generateFounderPerson } from '../../data/schema';
import { buildHreflangTrilingual } from '../../i18n/hreflang';

const locale = 'en';
const hreflang = buildHreflangTrilingual('/', '/en/', '/es/');
---

<BaseLayout
  title={`${siteConfig.name} — ${siteConfig.tagline.en}`}
  description="Build an online growth system around your expertise. Expert Growth for coaches and experts. AI visibility for local practices."
  hreflang={hreflang}
  schemas={[generateOrganization(), generateWebSite(locale), generateFounderPerson()]}
  locale={locale}
>
  <section class="py-16 md:py-24 lg:py-32">
    <div class="max-w-4xl mx-auto px-4 md:px-6 text-center">
      <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl text-text mb-6 leading-tight">
        Build an online growth system around your expertise
      </h1>
      <p class="text-lg md:text-xl text-text-muted leading-relaxed mb-10 max-w-2xl mx-auto">
        For coaches and experts who want to turn their knowledge into predictable leads, product sales and coaching enquiries. And for local practices that want to be visible in AI tools.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a href="https://scanner.nxg-media.com" class="inline-flex items-center px-8 py-4 text-base font-medium text-text-inverse bg-primary hover:bg-primary-dark transition-colors rounded-button shadow-lg" target="_blank" rel="noopener noreferrer">
          Run the AI visibility scan
        </a>
        <a href="/en/expert-growth-accelerator/" class="inline-flex items-center px-8 py-4 text-base font-medium text-primary border-2 border-primary hover:bg-primary/5 transition-colors rounded-button">
          Explore Expert Growth
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
