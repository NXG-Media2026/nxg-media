---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTABand from '../../../components/CTABand.astro';
import { siteConfig } from '../../../data/site';
import { generateBreadcrumbs, generateDefinedTerm } from '../../../data/schema';
import { t, localizePath, getTranslatedPath, getCollectionBasePath } from '../../../i18n/utils';
import { getHreflangForContent } from '../../../i18n/hreflang';

const locale = 'en';
const glossaryBase = getCollectionBasePath('glossar', locale);
const blogBase = getCollectionBasePath('blog', locale);

export async function getStaticPaths() {
  const entries = await getCollection('glossar');
  const enEntries = entries.filter((e) => e.data.locale === 'en');
  return enEntries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { term, slug, definition, longDescription, relatedTerms, linkedArticle, cluster, seo } = entry.data;

const allTerms = await getCollection('glossar');
const enTerms = allTerms.filter((t) => t.data.locale === 'en');
const resolvedRelated = (relatedTerms ?? [])
  .map((relSlug: string) => enTerms.find((t) => t.data.slug === relSlug))
  .filter(Boolean);

let linkedArticleData: { title: string; slug: string; excerpt: string } | null = null;
if (linkedArticle) {
  const articles = await getCollection('artikel');
  const found = articles.find((a) => a.data.pageSlug === linkedArticle && a.data.locale === 'en');
  if (found) {
    linkedArticleData = {
      title: found.data.title,
      slug: found.data.pageSlug,
      excerpt: found.data.excerpt,
    };
  }
}

const pageUrl = `${glossaryBase}/${slug}`;

const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: localizePath('/', locale) },
  { label: t('breadcrumb.glossar', locale), href: glossaryBase },
  { label: term },
];

const breadcrumbSchema = breadcrumbs.map((b) => ({
  name: b.label,
  url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}${pageUrl}`,
}));

const seoTitle = seo?.title ?? `${term} — Glossary | ${siteConfig.name}`;
const seoDescription = seo?.description ?? definition.slice(0, 155);

const hreflang = await getHreflangForContent(entry.data.translationKey, 'glossar', 'glossar');
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  hreflang={hreflang}
  schemas={[
    generateBreadcrumbs(breadcrumbSchema),
    generateDefinedTerm({ term, definition, slug }, locale),
  ]}
  locale="en"
>
  <BreadcrumbNav items={breadcrumbs} />

  <article class="py-16 md:py-24 lg:py-32 bg-bg">
    <div class="max-w-3xl mx-auto px-4 md:px-6">

      <header class="mb-10 md:mb-14">
        {cluster && (
          <span class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/10 text-accent rounded-full mb-4">
            {cluster.charAt(0).toUpperCase() + cluster.slice(1)}
          </span>
        )}
        <h1 class="font-heading text-3xl md:text-4xl lg:text-5xl text-text mb-4">
          {term}
        </h1>
        <p class="text-lg md:text-xl text-text-muted leading-relaxed">
          {definition}
        </p>
      </header>

      {longDescription && (
        <section class="mb-12">
          <h2 class="font-heading text-xl md:text-2xl text-text mb-4">
            {t('glossar.background', locale)}
          </h2>
          <div class="prose prose-lg max-w-none">
            <p>{longDescription}</p>
          </div>
        </section>
      )}

      {linkedArticleData && (
        <section class="mb-12">
          <h2 class="font-heading text-xl md:text-2xl text-text mb-4">
            {t('glossar.relatedArticle', locale)}
          </h2>
          <a
            href={`${blogBase}/${linkedArticleData.slug}`}
            class="group block bg-bg-alt border border-border rounded-card p-6 hover:border-accent/30 hover:shadow-lg transition-all duration-300"
          >
            <h3 class="font-heading text-lg text-text mb-2 group-hover:text-accent transition-colors">
              {linkedArticleData.title}
            </h3>
            <p class="text-sm text-text-muted leading-relaxed line-clamp-2">
              {linkedArticleData.excerpt}
            </p>
            <span class="inline-flex items-center mt-3 text-sm font-medium text-accent-dark group-hover:underline underline-offset-2">
              {t('glossar.readArticle', locale)}
              <svg class="w-4 h-4 ml-1 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        </section>
      )}

      {resolvedRelated.length > 0 && (
        <section class="mb-12">
          <h2 class="font-heading text-xl md:text-2xl text-text mb-4">
            {t('glossar.relatedTerms', locale)}
          </h2>
          <div class="flex flex-wrap gap-3">
            {resolvedRelated.map((related: any) => (
              <a
                href={`${glossaryBase}/${related.data.slug}`}
                class="inline-flex items-center px-4 py-2 text-sm font-medium bg-accent/10 text-accent rounded-full hover:bg-accent/20 transition-colors"
              >
                {related.data.term}
              </a>
            ))}
          </div>
        </section>
      )}

      <div class="pt-8 border-t border-border">
        <a
          href={glossaryBase}
          class="inline-flex items-center gap-2 text-sm text-text-muted hover:text-text transition-colors"
        >
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
          </svg>
          {t('glossar.allTerms', locale)}
        </a>
      </div>
    </div>
  </article>

  <CTABand
    title={t('layout.applyKnowledge', locale)}
    subtitle={t('layout.applyKnowledgeSub', locale)}
    ctaText={t('layout.discoverOffers', locale)}
    ctaHref={getTranslatedPath('/angebot', locale)}
    eventName="product_cta_click"
    locale="en"
    pageType="glossar"
    pageSlug={pageUrl}
  />
</BaseLayout>
