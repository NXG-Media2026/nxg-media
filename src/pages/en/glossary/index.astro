---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../../components/BreadcrumbNav.astro';
import CTABand from '../../../components/CTABand.astro';
import { siteConfig } from '../../../data/site';
import { generateDefinedTermSet, generateBreadcrumbs } from '../../../data/schema';
import { t, localizePath, getCollectionBasePath } from '../../../i18n/utils';
import { buildHreflangPair } from '../../../i18n/hreflang';

const locale = 'en';
const glossaryBase = getCollectionBasePath('glossar', locale);

const collectionEntries = (await getCollection('glossar'))
  .filter((e) => e.data.locale === 'en');

const sortedTerms = collectionEntries
  .map((entry) => ({
    term: entry.data.term,
    slug: entry.data.slug,
    definition: entry.data.definition,
    hasPage: true,
    relatedSlugs: entry.data.relatedTerms ?? [],
  }))
  .sort((a, b) => a.term.localeCompare(b.term, 'en'));

const letters = [...new Set(sortedTerms.map((t) => t.term.charAt(0).toUpperCase()))].sort((a, b) =>
  a.localeCompare(b, 'en'),
);

const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: localizePath('/', locale) },
  { label: t('breadcrumb.glossar', locale) },
];

const breadcrumbSchema = breadcrumbs.map((b) => ({
  name: b.label,
  url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}${glossaryBase}`,
}));
---

<BaseLayout
  title={`Glossary — Women's Health Terms | ${siteConfig.name}`}
  description="Women's health glossary: key terms on hormones, cycle, nutrition, and training — clearly explained and evidence-based."
  hreflang={buildHreflangPair('/glossar', '/en/glossary')}
  schemas={[
    generateDefinedTermSet(sortedTerms.map((t) => ({ ...t, hasPage: t.hasPage })), locale),
    generateBreadcrumbs(breadcrumbSchema),
  ]}
  locale="en"
>
  <BreadcrumbNav items={breadcrumbs} />

  <section class="py-16 md:py-24 lg:py-32 bg-bg">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <div class="text-center mb-14 md:mb-20">
        <h1 class="font-heading text-4xl md:text-5xl text-text mb-4">
          Glossary
        </h1>
        <p class="text-lg text-text-muted max-w-2xl mx-auto">
          Key terms in women's health — clearly explained and evidence-based.
        </p>
      </div>

      {sortedTerms.length > 0 ? (
        <>
          <nav class="flex flex-wrap justify-center gap-2 mb-12" aria-label="Letter navigation">
            {letters.map((letter) => (
              <a
                href={`#letter-${letter}`}
                class="inline-flex items-center justify-center w-10 h-10 text-sm font-medium bg-white border border-border rounded-full hover:border-accent/30 hover:text-accent transition-colors"
              >
                {letter}
              </a>
            ))}
          </nav>

          {letters.map((letter) => {
            const termsForLetter = sortedTerms.filter(
              (t) => t.term.charAt(0).toUpperCase() === letter,
            );
            return (
              <section id={`letter-${letter}`} class="mb-12 last:mb-0 scroll-mt-24">
                <h2 class="font-heading text-2xl text-text mb-6 pb-2 border-b border-border">
                  {letter}
                </h2>
                <div class="space-y-6">
                  {termsForLetter.map((item) => (
                    <div id={item.slug} class="scroll-mt-24">
                      <a href={`${glossaryBase}/${item.slug}`} class="group">
                        <h3 class="font-medium text-text text-lg mb-2 group-hover:text-accent transition-colors">
                          {item.term}
                          <svg class="w-4 h-4 inline-block ml-1 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                          </svg>
                        </h3>
                      </a>
                      <p class="text-sm text-text-muted leading-relaxed mb-2">
                        {item.definition}
                      </p>
                      {item.relatedSlugs.length > 0 && (
                        <div class="flex flex-wrap gap-2">
                          {item.relatedSlugs.map((relSlug) => {
                            const related = sortedTerms.find((t) => t.slug === relSlug);
                            if (!related) return null;
                            return (
                              <a
                                href={`${glossaryBase}/${relSlug}`}
                                class="inline-flex items-center px-3 py-1 text-xs font-medium bg-accent/10 text-accent rounded-full hover:bg-accent/20 transition-colors"
                              >
                                {related.term}
                              </a>
                            );
                          })}
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              </section>
            );
          })}
        </>
      ) : (
        <div class="text-center py-12">
          <p class="text-text-muted">Glossary terms will be published soon.</p>
        </div>
      )}
    </div>
  </section>

  <CTABand
    title="Want to put these terms into practice?"
    subtitle="Discover my products and coaching — evidence-based and tailored to you."
    ctaText="Explore offers"
    ctaHref="/en/offers"
    eventName="product_cta_click"
    locale="en"
    pageType="glossar"
    pageSlug="/en/glossary"
  />
</BaseLayout>
