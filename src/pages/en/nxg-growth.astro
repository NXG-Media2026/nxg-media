---
import { Image } from 'astro:assets';
import NxgSearchMethod from '../../components/NxgSearchMethod.astro';
import { siteConfig } from '../../data/site';
import '../../styles/lander.css';
import landerScriptUrl from '../../scripts/lander.js?url';
import type { ImageMetadata } from 'astro';
import CookieConsent from '../../components/CookieConsent.astro';
import { getTrackingScript } from '../../lib/analytics';
const clientLogoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/Client-logos/*.{webp,avif,png,jpg}', { eager: true });
const clientLogos = Object.entries(clientLogoFiles).map(([file, mod]) => ({ src: mod.default, alt: file.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/i, '').replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim() }));
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>NXG AI Search — More enquiries. Guaranteed.</title>
<meta name="description" content="You want clients. We set everything up to generate the enquiries you need. One growth system, a concrete enquiry target and a results guarantee.">
<link rel="canonical" href="https://nxg-media.com/en/nxg-growth">
<link rel="alternate" hreflang="nl" href="https://nxg-media.com/landermkb" />
<link rel="alternate" hreflang="en" href="https://nxg-media.com/en/nxg-growth" />
<link rel="alternate" hreflang="es" href="https://nxg-media.com/es/nxg-growth" />
<link rel="alternate" hreflang="x-default" href="https://nxg-media.com/landermkb" />
<meta name="theme-color" content="#0756ef">
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='12' fill='%230756ef'/%3E%3Cpath d='M15 48V16h8l18 20V16h8v32h-8L23 28v20z' fill='%23fff000'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800;900&family=DM+Sans:wght@400;500;600;650;700;800&display=swap" rel="stylesheet">
<style is:global>.photo{background-image:url('/lander-assets/ondernemer-werkplaats-nxg-growth.webp');background-position:76% center}@media(max-width:760px){.photo{background-position:75% 35%}}</style>
<style is:global>
.hero h1 .hero-opening{display:block;font-size:.68em;margin-bottom:12px}
.hero h1 .hero-generation{display:inline-block;font-size:1.08em;line-height:1.03}
.hero-ticket .ticket-minimum{display:block;font:800 18px/1.2 var(--body);letter-spacing:1px;margin-bottom:4px}
.hero-ticket .ticket-start{display:block;font:700 14px/1.4 var(--body);margin:0 0 16px}
.session-host{display:flex;align-items:center;gap:14px;margin:24px 0}
.session-host img{width:64px;height:64px;border-radius:50%;object-fit:cover;object-position:50% 30%;border:2px solid var(--yellow)}
.session-host p{margin:0;font-size:15px}.session-host span{display:block;font-size:13px}
@media(max-width:760px){.hero-ticket .ticket-start{font-size:12px}.hero-ticket .ticket-minimum{font-size:14px}}
</style></head>
<body>
<a class="skip" href="#main">Skip to content</a>
<header><div class="nav wrap"><a class="brand" href="/en" aria-label="NXG-media, go to homepage">NXG<span>-media</span><small>AI Search Agency</small></a><nav aria-label="Main navigation"><a href="#cases">Results</a><a href="#investering">The guarantee</a><a class="lander-scan-link" href={siteConfig.external.scannerUrl}>Free AI scan ↗</a></nav><div class="lander-languages"><a href="/landermkb" lang="nl">NL</a><span aria-current="true">EN</span><a href="/es/nxg-growth" lang="es">ES</a></div><a class="button yellow compact" href="#groeisessie">Check if your business qualifies <span aria-hidden="true">↗</span></a></div><a class="lander-mobile-scan" href={siteConfig.external.scannerUrl}>Free AI scan <span>Find out if AI mentions your business ↗</span></a></header>
<main id="main">
<section class="hero"><div class="wrap hero-grid"><div class="hero-copy"><p class="eyebrow light">THE NXG AI SEARCH SYSTEM</p><h1><span class="hero-opening">MORE ENQUIRIES THROUGH</span><span class="marker hero-generation">THE NEW GENERATION<br>OF SEARCH.</span></h1><div class="growth-formula" aria-label="AI discoverability plus AI Search Ads plus a website that converts equals your AI Search growth system"><div class="formula-inputs"><span>AI discoverability</span><b aria-hidden="true">+</b><span>AI Search Ads</span><b aria-hidden="true">+</b><span>A website that converts</span></div><div class="formula-answer"><b aria-hidden="true">=</b><strong>The NXG<br>AI Search system.</strong></div></div><p class="hero-body">Your potential clients are searching for what you offer. We do whatever it takes to put your business in front of them and turn that interest into enquiries. Organic, paid and with a website that convinces.</p><a class="button yellow" href="#groeisessie">Check if your business qualifies <span aria-hidden="true">↗</span></a><a class="hero-news" href="#chatgpt-ads"><span class="news-logo"><img src="/lander-assets/platforms/openai.svg" alt="ChatGPT" width="32" height="32"></span><span><b>NEW</b><strong>Advertise in ChatGPT.</strong><small>Part of our system, if it suits your business.</small></span><span class="news-arrow" aria-hidden="true">↗</span></a></div><div class="hero-visual"><div class="portrait-stage" aria-label="Business owners the NXG AI Search system works for"><div class="portrait-frame is-active" aria-hidden="false"><img src="/lander-assets/portraits/vakman-omgeving.webp" alt="Craftsman in his workshop" width="1024" height="1536" fetchpriority="high" loading="eager" decoding="async"></div><div class="portrait-frame" aria-hidden="true"><img src="/lander-assets/portraits/tandarts-omgeving.webp" alt="Dentist in his treatment room" width="1024" height="1536" loading="lazy" decoding="async"></div><div class="portrait-frame" aria-hidden="true"><img src="/lander-assets/portraits/laserspecialist-omgeving.webp" alt="Laser specialist in her clinic" width="1024" height="1536" loading="lazy" decoding="async"></div><div class="portrait-frame" aria-hidden="true"><img src="/lander-assets/portraits/chiropractor-omgeving.webp" alt="Chiropractor in his practice" width="1024" height="1536" loading="lazy" decoding="async"></div><div class="portrait-frame" aria-hidden="true"><img src="/lander-assets/portraits/makelaar-omgeving.webp" alt="Estate agent at the entrance of a property" width="1024" height="1536" loading="lazy" decoding="async"></div></div><div class="hero-ticket"><p><span class="ticket-minimum">AT LEAST</span><b>15</b><br>qualified<br>enquiries.</p><span class="ticket-start">Within 90 days from go-live.</span><div class="ticket-refund">Or you get<br><strong>your money back.</strong></div></div><div class="portrait-controls"><button type="button" class="portrait-prev" aria-label="Previous portrait">‹</button><button type="button" class="portrait-pause" aria-label="Pause portraits" aria-pressed="false">Ⅱ</button><button type="button" class="portrait-next" aria-label="Next portrait">›</button></div></div></div></section>
<section class="client-proof" aria-label="Companies we have done marketing work for"><div class="wrap proof-heading"><p>MARKETING WORK FOR CLIENTS INCLUDING</p><button class="logos-toggle" type="button" aria-pressed="false">Pause logos</button></div><div class="client-window"><div class="client-track">{[0, 1].map(copy => <div class="client-group" aria-hidden={copy === 1 ? 'true' : undefined}>{clientLogos.map(logo => <div class="client-logo"><Image src={logo.src} alt={copy === 0 ? logo.alt : ''} height={48} loading="lazy" decoding="async" /></div>)}</div>)}</div></div></section>
<div class="promise-strip"><div class="wrap strip-grid"><div><span class="check">✓</span><p><strong>A fixed target</strong><span>Agreed upfront. Measurable afterwards.</span></p></div><div><span class="check">✓</span><p><strong>Money back if we miss it</strong><span>No result? No risk.</span></p></div><div><span class="check">✓</span><p><strong>Your foundation stays yours</strong><span>What we build is yours. Always.</span></p></div></div>
<section class="section results" id="cases"><div class="wrap"><p class="eyebrow">AI SEARCH IN PRACTICE</p><h2>FROM BEING FOUND.<br><span class="blue">TO REAL ENQUIRIES.</span></h2><p class="results-intro">Two clients for whom we rebuilt the online foundation and improved discoverability. Here is what it delivered.</p><div class="case-grid"><article class="result-card"><div class="case-person"><img src="/lander-assets/proof/james.webp" alt="Dr. James Mitchell" width="80" height="80" loading="lazy"><div><strong>Costa Blanca Movement Centre</strong><a href="https://www.costablancamovement.com/" target="_blank" rel="noopener noreferrer">costablancamovement.com ↗</a></div></div><h3>FROM ZERO TO<br>12–15 PATIENTS PER MONTH.</h3><p>No website, no Google history and no backlinks. Within 14 days the new foundation ranked on page 1 in Google. After 2 months, 12–15 patients per month came in online.</p><div class="case-metrics"><div><strong>12–15</strong><span>patients per month online</span></div><div><strong>800+</strong><span>organic visitors per month</span></div></div><div class="case-proof"><a href="/lander-assets/proof/google-proof.webp" target="_blank" rel="noopener"><img src="/lander-assets/proof/google-proof.webp" alt="Google result from the Costa Blanca Movement Centre case" width="600" height="360" loading="lazy"><span>Google page 1 after 14 days · view proof ↗</span></a><a href="/lander-assets/proof/chatgpt-proof.webp" target="_blank" rel="noopener"><img src="/lander-assets/proof/chatgpt-proof.webp" alt="ChatGPT mentions Costa Blanca Movement Centre as a local option" width="600" height="360" loading="lazy"><span>Mentioned by ChatGPT · view proof ↗</span></a></div></article><article class="result-card"><div class="case-person"><img src="/lander-assets/proof/verena.webp" alt="Dr. Verena Mann" width="80" height="80" loading="lazy"><div><strong>Dr. Verena Mann</strong><a href="https://doc-veri.pages.dev/" target="_blank" rel="noopener noreferrer">doc-veri.pages.dev ↗</a></div></div><h3>FROM 2 TO 19<br>ENQUIRIES PER MONTH.</h3><p>Plenty of expertise and a community, but hardly any enquiries through the website. By presenting her expertise, proof and enquiry route more clearly, she grew to 19 enquiries per month and was mentioned by ChatGPT.</p><div class="case-metrics"><div><strong>2 → 19</strong><span>enquiries per month</span></div><div><strong>0 → 15</strong><span>AI mentions</span></div></div><div class="case-proof single"><a href="/lander-assets/proof/verena-proof.webp" target="_blank" rel="noopener"><img src="/lander-assets/proof/verena-proof.webp" alt="ChatGPT mention of Dr. Verena Mann from her case" width="1200" height="360" loading="lazy"><span>Mentioned as expert by ChatGPT · view proof ↗</span></a></div></article></div><div class="results-bottom"><p>We apply this approach to your goal:<br><strong>At least 15 qualified enquiries within 90 days from go-live through our AI Search system.</strong></p><a class="button yellow" href="#groeisessie">Check if your business qualifies <span aria-hidden="true">↗</span></a></div></div></section>




<NxgSearchMethod ctaHref="#groeisessie" locale="en" />
<section class="section guarantee" id="investering"><div class="wrap guarantee-wrap"><div class="guarantee-content"><p class="eyebrow">THE GUARANTEE</p><h2>AT LEAST 15 ENQUIRIES<br>IN 90 DAYS.<br><span class="blue">OR YOUR MONEY BACK.</span></h2><p>One system that combines AI discoverability, Google Search and, where relevant, ChatGPT Ads to generate enquiries. The goal is simple: at least 15 qualified enquiries within 90 days after your new foundation goes live.</p><ul class="guarantee-points"><li>If we miss the agreed target, you get your money back.</li><li>You keep the foundation we built for you.</li><li>We discuss the approach, target and terms in person.</li></ul><a class="button yellow" href="#groeisessie">Check if your business qualifies <span aria-hidden="true">↗</span></a></div></div></section>

<section class="section founder"><div class="wrap founder-grid"><div class="founder-photo"><img src="/lander-assets/proof/joost.webp" alt="Joost van Putten, founder of NXG-media, at work" width="850" height="1000" loading="lazy"><span>Joost van Putten · Founder NXG-media</span></div><div><p class="eyebrow">THE PERSON BEHIND NXG-MEDIA</p><h2>HI, I'M JOOST.<br><span class="blue">I BUILD WITH YOU.</span></h2><p>For over 7 years I have been helping business owners with online marketing. From campaigns to websites: I want to know what it delivers for the business behind it.</p><p class="strong">You want clients. We make it concrete how we will work on your next enquiries.</p><a class="text-link" href="#groeisessie">Check if your business qualifies <span aria-hidden="true">↗</span></a></div></div></section>
<section class="session section"><div class="wrap session-grid"><div><p class="eyebrow light">NOW YOUR BUSINESS.</p><h2>WHAT CAN THE NXG<br><span class="yellow-text">AI SEARCH SYSTEM</span><br>DELIVER FOR YOU?</h2><p>In 35 minutes you will know which approach, which budget and which enquiry target suit your business. Together we assess whether the guarantee of at least 15 qualified enquiries is achievable for your business.</p><div class="session-host"><img src="/lander-assets/proof/joost.webp" alt="Joost van Putten" width="64" height="64" loading="lazy"><p><strong>You will speak with Joost.</strong><span>Founder of NXG-media</span></p></div><div class="session-duration">35 MINUTES <span>·</span> PERSONAL <span>·</span> NO OBLIGATION</div><ul class="session-topics"><li>Where your clients are searching.</li><li>Your opportunities with the NXG AI Search system.</li><li>The enquiry target, budget and the guarantee.</li></ul><p>You decide after the call whether you want to start.</p></div><div class="inline-agenda" id="groeisessie"><h3>CHOOSE YOUR MOMENT.</h3><iframe class="calendly-inline-frame" src="https://calendly.com/nxgmedia/gratis-15-minuten-strategiegesprek?embed_domain=nxg-media.com&amp;embed_type=Inline&amp;hide_event_type_details=1&amp;hide_gdpr_banner=1" title="Book your free 35-minute AI Search intro call with NXG-media" loading="eager"></iframe><a class="agenda-fallback" href="https://calendly.com/nxgmedia/gratis-15-minuten-strategiegesprek" target="_blank" rel="noopener noreferrer">Calendar not visible? Open Calendly ↗</a></div></div></section>
<section class="section faq"><div class="wrap faq-grid"><div><p class="eyebrow">JUST A CLEAR ANSWER</p><h2>GOOD<br><span class="blue">QUESTIONS.</span></h2></div><div class="questions"><details><summary>Does the foundation stay mine, even if you miss the target?</summary><p>Yes. The website, content and optimisations we build for you stay yours. Even if we miss the agreed enquiry target. You do not have to give up the work we built.</p></details><details><summary>Can you also run ads in ChatGPT for me?</summary><p>Yes, if it suits your business. ChatGPT Ads is now available via self-service for advertisers. We assess the possibilities for your services and target audience and discuss the test budget in person.</p></details><details><summary>What is a qualified enquiry?</summary><p>A unique enquiry from someone in the agreed target audience, with valid contact details and demonstrable interest in your service. We agree upfront what counts. Spam, duplicates and irrelevant contacts do not count.</p></details><details id="garantie-vraag"><summary>How does the guarantee work exactly?</summary><p>We agree on a concrete enquiry target, target audience and timeframe upfront. If we miss the target, you get your money back and keep the foundation we built for you. The exact terms are discussed in person.</p></details><details><summary>Do I always have to buy ads?</summary><p>No. We determine which tools are needed for your goal. If paid campaigns are necessary, we agree on the budget upfront. We do not incur additional costs without your approval.</p></details><details><summary>What happens after the first 90 days?</summary><p>We evaluate the results and discuss next steps. The foundation stays yours. The exact contract term, cancellation and handover are agreed before we start.</p></details></div></div></section>
<section class="last-call"><div class="wrap"><h2>AT LEAST 15 ENQUIRIES IN 90 DAYS.<br><span>WITH THE NXG AI SEARCH SYSTEM.</span></h2><a class="button black" href="#groeisessie">Check if your business qualifies <span aria-hidden="true">↗</span></a></div></section>
</main><footer><div class="wrap footer-main"><a class="brand" href="/">NXG<span>-media</span><small>AI Search Agency</small></a><p>Built for business owners.<br>Focused on enquiries.</p><a href="#investering">Read how the guarantee works ↗</a></div><div class="wrap footer-bottom"><span>© <span id="year">2026</span> NXG-media</span><span>You run the business. We grow with you.</span><span><a href="/en/privacy">Privacy</a> · <a href="/en/terms">Terms</a></span></div></footer>
<div class="mobile-cta"><a class="button yellow" href="#groeisessie">Check if your business qualifies <span aria-hidden="true">↗</span></a></div>

<CookieConsent locale="en" />
<style>
.lander-scan-link{color:#0756ef;background:#edf3ff;padding:10px 12px;border-radius:5px;font-weight:800}.lander-mobile-scan{display:none}@media(max-width:760px){.lander-mobile-scan{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:11px 20px;background:#edf3ff;color:#0756ef;font-size:12px;font-weight:800;border-top:1px solid #d5e3ff}.lander-mobile-scan span{font-size:10px;font-weight:600}}
.lander-languages{display:flex;align-items:center;gap:6px;font-size:13px;font-weight:700;margin-left:auto}.lander-languages a{color:#666;text-decoration:none;padding:4px 6px;border-radius:4px;transition:color .2s}.lander-languages a:hover{color:#0756ef}.lander-languages span[aria-current]{color:#0756ef;padding:4px 6px}@media(max-width:760px){.lander-languages{margin:0 auto;justify-content:center;padding:8px 0}}
</style>
<script is:inline set:html={getTrackingScript()} />
<script is:inline src={landerScriptUrl}></script>
</body></html>
