---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BreadcrumbNav from '../../components/BreadcrumbNav.astro';
import CTABand from '../../components/CTABand.astro';
import { siteConfig } from '../../data/site';
import { generateFAQPage, generateBreadcrumbs } from '../../data/schema';
import { faqCategoriesEn, getAllFAQsEn } from '../../data/faq-en';
import { t, localizePath, getTranslatedPath } from '../../i18n/utils';
import { buildHreflangPair } from '../../i18n/hreflang';

const locale = 'en';
const allFaqs = getAllFAQsEn();

const breadcrumbs = [
  { label: t('breadcrumb.home', locale), href: localizePath('/', locale) },
  { label: t('nav.faq', locale) },
];

const breadcrumbSchema = breadcrumbs.map((b) => ({
  name: b.label,
  url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}/en/faq`,
}));
---

<BaseLayout
  title={`FAQ | ${siteConfig.name}`}
  description="Frequently asked questions about doc.veri — products, coaching, hormones, nutrition, and training."
  hreflang={buildHreflangPair('/faq', '/en/faq')}
  schemas={[
    generateFAQPage(allFaqs),
    generateBreadcrumbs(breadcrumbSchema),
  ]}
  locale="en"
>
  <BreadcrumbNav items={breadcrumbs} />

  <section class="py-16 md:py-24 lg:py-32 bg-bg">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <div class="text-center mb-14 md:mb-20">
        <h1 class="font-heading text-4xl md:text-5xl text-text mb-4">
          {t('faq.heading', locale)}
        </h1>
        <p class="text-lg text-text-muted max-w-2xl mx-auto">
          Find answers to the most common questions about doc.veri, my offerings, and the topics of hormones, nutrition, and training.
        </p>
      </div>

      <nav class="flex flex-wrap gap-2 mb-12" aria-label="FAQ categories">
        {faqCategoriesEn.map((cat) => (
          <a
            href={`#${cat.slug}`}
            class="inline-flex items-center px-4 py-2 text-sm font-medium bg-white border border-border rounded-full hover:border-accent/30 hover:text-accent transition-colors"
          >
            {cat.title}
          </a>
        ))}
      </nav>

      {faqCategoriesEn.map((category) => (
        <section id={category.slug} class="mb-12 last:mb-0 scroll-mt-24">
          <h2 class="font-heading text-2xl md:text-3xl text-text mb-6">
            {category.title}
          </h2>
          <div class="space-y-4">
            {category.items.map((item) => (
              <details class="group bg-white border border-border rounded-card overflow-hidden">
                <summary class="flex items-center justify-between gap-4 px-6 py-5 cursor-pointer list-none text-left font-medium text-text hover:text-accent transition-colors">
                  <h3 class="text-base font-medium">{item.q}</h3>
                  <svg
                    class="w-5 h-5 shrink-0 text-text-muted group-open:rotate-180 transition-transform"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </summary>
                <div class="px-6 pb-5 text-sm text-text-muted leading-relaxed">
                  <Fragment set:html={item.a} />
                </div>
              </details>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>

  <CTABand
    title="Still have questions? Get in touch!"
    subtitle="I'm happy to help you personally."
    ctaText="Contact me"
    ctaHref={getTranslatedPath('/kontakt', locale)}
    eventName="discovery_call_click"
    locale="en"
    pageType="faq"
    pageSlug="/en/faq"
  />
</BaseLayout>
