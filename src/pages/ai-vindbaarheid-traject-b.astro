            <legend class="text-sm font-medium text-text mb-3">Wat is een nieuwe klant ongeveer waard?</legend>
            <div class="space-y-2">
              <label class="flex items-center gap-3 cursor-pointer">
                <input type="radio" name="klantwaarde" value="Minder dan €500" class="text-accent focus:ring-accent" />
                <span class="text-sm text-text-muted">Minder dan &euro;500</span>
              </label>
              <label class="flex items-center gap-3 cursor-pointer">
                <input type="radio" name="klantwaarde" value="€500–€1.500" class="text-accent focus:ring-accent" />
                <span class="text-sm text-text-muted">&euro;500&ndash;&euro;1.500</span>
              </label>
              <label class="flex items-center gap-3 cursor-pointer">
                <input type="radio" name="klantwaarde" value="€1.500–€5.000" class="text-accent focus:ring-accent" />
                <span class="text-sm text-text-muted">&euro;1.500&ndash;&euro;5.000</span>
              </label>
              <label class="flex items-center gap-3 cursor-pointer">
                <input type="radio" name="klantwaarde" value="Meer dan €5.000" class="text-accent focus:ring-accent" />
                <span class="text-sm text-text-muted">Meer dan &euro;5.000</span>
              </label>
              <label class="flex items-center gap-3 cursor-pointer">
                <input type="radio" name="klantwaarde" value="Wisselt sterk" class="text-accent focus:ring-accent" />
                <span class="text-sm text-text-muted">Wisselt sterk</span>
              </label>
            </div>
          </fieldset>

          {/* Vraag 4: Klantbron */}
          <fieldset>
            <legend class="text-sm font-medium text-text mb-3">Waar komen klanten nu vooral vandaan?</legend>
            <div class="space-y-2">
              <label class="flex items-center gap-3 cursor-pointer">
                <input type="radio" name="klantbron" value="Mond-tot-mond" class="text-accent focus:ring-accent" />
                <span class="text-sm text-text-muted">Mond-tot-mond</span>
              </label>
              <label class="flex items-center gap-3 cursor-pointer">
                <input type="radio" name="klantbron" value="Google" class="text-accent focus:ring-accent" />
                <span class="text-sm text-text-muted">Google</span>
              </label>
              <label class="flex items-center gap-3 cursor-pointer">
                <input type="radio" name="klantbron" value="Social media" class="text-accent focus:ring-accent" />
                <span class="text-sm text-text-muted">Social media</span>
              </label>
              <label class="flex items-center gap-3 cursor-pointer">
                <input type="radio" name="klantbron" value="Advertenties" class="text-accent focus:ring-accent" />
                <span class="text-sm text-text-muted">Advertenties</span>
              </label>
              <label class="flex items-center gap-3 cursor-pointer">
                <input type="radio" name="klantbron" value="Te weinig / onvoorspelbaar" class="text-accent focus:ring-accent" />
                <span class="text-sm text-text-muted">Te weinig / onvoorspelbaar</span>
              </label>
            </div>
          </fieldset>

          {/* Website + Email */}
          <div>
            <label for="website-top" class="block text-sm font-medium text-text mb-1.5">Wat is je huidige site?</label>
            <input type="url" id="website-top" name="website" placeholder="https://jouwbedrijf.nl" required class="w-full px-4 py-3 rounded-button border border-border text-sm text-text placeholder:text-text-muted/50 focus:outline-none focus:ring-2 focus:ring-accent/30 focus:border-accent" />
          </div>

          <div>
            <label for="email-top" class="block text-sm font-medium text-text mb-1.5">Waar mag ik de analyse naartoe sturen?</label>
            <input type="email" id="email-top" name="email" placeholder="je@email.nl" required class="w-full px-4 py-3 rounded-button border border-border text-sm text-text placeholder:text-text-muted/50 focus:outline-none focus:ring-2 focus:ring-accent/30 focus:border-accent" />
          </div>

          <button type="submit" class="w-full inline-flex items-center justify-center px-8 py-4 text-base font-medium text-text-inverse bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg">
            Ontvang mijn gratis groeianalyse
            <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
          </button>

          <p class="text-xs text-text-muted text-center">Geen spam. Geen verplichtingen. Binnen 48 uur persoonlijk advies van Joost &mdash; geen geautomatiseerd rapport.</p>
        </form>

        {/* Bedankmelding */}
        <div class="form-thanks hidden text-center py-8">
          <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-green-100 flex items-center justify-center">
            <svg class="w-8 h-8 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
          </div>
          <h3 class="font-heading text-xl text-text mb-2">Bedankt!</h3>
          <p class="text-text-muted">Ik bekijk je situatie en stuur je binnen 48 uur een persoonlijke analyse.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── 11. FAQ ── */}
  <div class="bg-white">
    <FAQAccordion
      title="Veelgestelde vragen"
      items={faqForComponent}
      locale={locale}
      pageType="service"
      pageSlug="ai-vindbaarheid-traject"
    />
  </div>

  {/* ── 12. OVER JOOST + AFSLUITENDE CTA ── */}
  <section class="py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <div class="grid grid-cols-1 md:grid-cols-[auto_1fr] gap-10 md:gap-14 items-center">
        <div class="flex justify-center md:justify-start">
          <div class="w-48 h-48 md:w-56 md:h-56 rounded-full overflow-hidden shadow-lg ring-4 ring-white shrink-0">
            <Image
              src={founderPhoto}
              alt="Joost van Putten — Founder NXG Media"
              widths={[224, 320]}
              sizes="(max-width: 768px) 192px, 224px"
              class="w-full h-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
        <div>
          <div class="w-12 h-1 bg-accent rounded-full mb-4"></div>
          <h2 class="font-heading text-2xl md:text-3xl text-text mb-4">Joost van Putten</h2>
          <p class="text-text-muted leading-relaxed">
            8 jaar online marketing. &euro;8M+ advertentiebudget beheerd. 50+ klanten in coaching, health en dienstverlening. Ik bouw geen sites. Ik bouw groeikanalen.
          </p>
        </div>
      </div>
    </div>
  </section>

  {/* Logo bar */}
  {logos.length > 0 && (
    <LogoMarquee logos={logos} speed={35} />
  )}

  {/* Afsluitende CTA met formulier */}
  <section class="py-16 md:py-20 bg-primary">
    <div class="max-w-3xl mx-auto px-4 md:px-6 text-center">
      <h2 class="font-heading text-3xl md:text-4xl text-white mb-4">
        Jouw volgende klant zoekt misschien nu al naar jou.
      </h2>
      <p class="text-lg text-white/80 mb-10 max-w-2xl mx-auto">
        De vraag is alleen: vindt hij jou, of je concurrent?
      </p>

      {/* Compact formulier herhaling */}
      <div class="bg-white/10 backdrop-blur rounded-card p-6 md:p-8 max-w-xl mx-auto text-left">
        <form id="form-bottom" class="traject-form space-y-4">
          <input type="hidden" name="bron" value="trajectpagina-b" />

          <div class="grid grid-cols-1 sm:grid-cols-[1fr_1fr_auto] gap-3">
            <input type="url" name="website" placeholder="https://jouwbedrijf.nl" required class="w-full px-4 py-3 rounded-button border border-white/20 bg-white/10 text-sm text-white placeholder:text-white/40 focus:outline-none focus:ring-2 focus:ring-accent/50" />
            <input type="email" name="email" placeholder="je@email.nl" required class="w-full px-4 py-3 rounded-button border border-white/20 bg-white/10 text-sm text-white placeholder:text-white/40 focus:outline-none focus:ring-2 focus:ring-accent/50" />
            <button type="submit" class="px-6 py-3 text-sm font-medium text-text-inverse bg-accent hover:bg-accent-dark transition-colors rounded-button whitespace-nowrap">
              Ontvang mijn groeianalyse &rarr;
            </button>
          </div>

          <p class="text-xs text-white/50 text-center">Gratis. Persoonlijk. Binnen 48 uur.</p>
        </form>

        <div class="form-thanks hidden text-center py-6">
          <p class="text-white font-medium">Bedankt! Ik bekijk je situatie en stuur je binnen 48 uur een persoonlijke analyse.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ── Sticky mobile CTA ── */}
  <div class="fixed bottom-0 inset-x-0 p-3 bg-white/95 backdrop-blur border-t border-border md:hidden z-40 sticky-cta">
    <a
      href="#formulier"
      class="flex items-center justify-center w-full px-6 py-3.5 text-sm font-medium text-text-inverse bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg"
    >
      Gratis groeianalyse aanvragen
      <svg class="ml-2 w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
    </a>
  </div>

  {/* ── Scripts ── */}
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // ── Show submitted banner if redirected from /groeiscan/ ──
      if (new URLSearchParams(window.location.search).get('submitted') === 'true') {
        const banner = document.getElementById('submitted-banner');
        if (banner) {
          banner.classList.remove('hidden');
          window.scrollTo({ top: 0 });
          // Clean up URL without reload
          history.replaceState(null, '', window.location.pathname);
        }
      }

      // ── Sticky CTA: hide when form is visible ──
      const stickyCta = document.querySelector('.sticky-cta') as HTMLElement | null;
      if (stickyCta) {
        const formSections = document.querySelectorAll('#formulier, #form-bottom');
        const observer = new IntersectionObserver(
          (entries) => {
            const anyVisible = entries.some((e) => e.isIntersecting);
            stickyCta.style.display = anyVisible ? 'none' : 'block';
          },
          { threshold: 0.1 }
        );
        formSections.forEach((el) => observer.observe(el));
      }

      // ── Form submission ──
      document.querySelectorAll('.traject-form').forEach((form) => {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const f = e.target as HTMLFormElement;
          const data = new FormData(f);

          const email = data.get('email') as string;
          const website = data.get('website') as string;

          // Collect radio values (only present in the full form)
          const doel = data.get('doel') as string | null;
          const bedrijfstype = data.get('bedrijfstype') as string | null;
          const klantwaarde = data.get('klantwaarde') as string | null;
          const klantbron = data.get('klantbron') as string | null;

          // Build structured "vraag" from radio selections
          const vraagParts = [
            doel ? `Doel: ${doel}` : '',
            bedrijfstype ? `Bedrijfstype: ${bedrijfstype}` : '',
            klantwaarde ? `Klantwaarde: ${klantwaarde}` : '',
            klantbron ? `Klantbron: ${klantbron}` : '',
          ].filter(Boolean).join('\n');

          const payload = {
            naam: email,
            email,
            websiteUrl: website,
            vraag: vraagParts || 'Groeianalyse aangevraagd (compact formulier)',
            klantwaarde: klantwaarde || undefined,
            source: 'trajectpagina-b',
            abVersion: 'b',
          };

          try {
            await fetch('https://scanner.nxg-media.com/api/gratis-check', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
              body: JSON.stringify(payload),
            });
          } catch {
            // Silently fail — show thank you regardless
          }

          // Show thank you message
          f.classList.add('hidden');
          const thanks = f.parentElement?.querySelector('.form-thanks');
          if (thanks) thanks.classList.remove('hidden');
        });
      });

      // ── Lightbox for CMS screenshot ──
      const triggers = document.querySelectorAll('.lightbox-trigger');
      if (triggers.length === 0) return;

      const images = Array.from(triggers).map((t) => {
        const img = t.querySelector('img');
        return img ? img.src : '';
      });

      const overlay = document.createElement('div');
      overlay.className = 'fixed inset-0 z-50 bg-black/85 hidden items-center justify-center p-4';
      overlay.id = 'lightbox';
      overlay.innerHTML = `
        <button type="button" class="absolute top-4 right-4 text-white/80 hover:text-white z-10" id="lightbox-close">
          <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
        </button>
        <img src="" alt="" class="max-w-[90vw] max-h-[90vh] rounded-lg shadow-2xl" id="lightbox-img" />
      `;
      document.body.appendChild(overlay);

      const lbImg = document.getElementById('lightbox-img') as HTMLImageElement;
      const lbClose = document.getElementById('lightbox-close');

      function openLightbox(index: number) {
        if (!images[index]) return;
        lbImg.src = images[index];
        lbImg.alt = (triggers[index] as HTMLElement).querySelector('img')?.alt || '';
        overlay.classList.remove('hidden');
        overlay.classList.add('flex');
        document.body.style.overflow = 'hidden';
      }

      function closeLightbox() {
        overlay.classList.add('hidden');
        overlay.classList.remove('flex');
        document.body.style.overflow = '';
      }

      triggers.forEach((trigger, i) => {
        trigger.addEventListener('click', () => openLightbox(i));
      });

      lbClose?.addEventListener('click', closeLightbox);
      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) closeLightbox();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeLightbox();
      });
    });
  </script>

  <style>
    details[open] .details-chevron {
      transform: rotate(180deg);
    }
  </style>

</BaseLayout>
