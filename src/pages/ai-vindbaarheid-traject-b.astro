---
/**
 * AI-Vindbaarheid Traject — Variant B (problem-first)
 * /ai-vindbaarheid-traject-b/
 * One story, no routes, no feature lists, no FAQ wall.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import CalendlyEmbed from '../components/CalendlyEmbed.astro';
import { siteConfig } from '../data/site';
import { generateBreadcrumbs, generateService } from '../data/schema';

import heroPhoto from '../assets/images/founder/joost-sitting-laptop-lookingfront.webp';
import founderPhoto from '../assets/images/founder/joost-standing-relaxed.webp';
import jamesPhoto from '../assets/images/cases/james-mitchell-portrait.png';
import verenaPhoto from '../assets/images/cases/verena-mann-linkedin.webp';
import proofGoogle from '../assets/images/cases/proof-google-torrevieja.png';
import proofChatgpt from '../assets/images/cases/proof-chatgpt-local.png';
import proofVerenaAi from '../assets/images/cases/doc_veri_ai_answer_cropped.PNG';
import proofVerenaChatgpt from '../assets/images/cases/doc-veri-chatgptproof.jpeg';
import rolfPhoto from '../assets/images/logos/rolf-profile-photo-happywithyoga.png';
import proofHwyWhatsapp from '../assets/images/cases/rolf-happywithyoga-whatsapp-proof.webp';

const locale = 'nl';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'AI-Vindbaarheid Traject' },
];

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logos/*.{webp,avif,png,jpg}', { eager: true });
const logos = Object.entries(logoFiles)
  .filter(([path]) => /logo/i.test(path.split('/').pop()!))
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/, '');
    const name = filename.replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim();
    return { src: mod.default, alt: name };
  });

const serviceSchema = generateService({
  name: 'AI-Vindbaarheid Traject',
  description: 'Jouw concurrent staat boven jou in ChatGPT, Google en AI. Wij draaien dat om in 90 dagen.',
  url: `${siteConfig.url}/ai-vindbaarheid-traject-b/`,
  serviceType: 'AI Visibility & Growth System',
});
---

<BaseLayout
  title="Je concurrent staat boven jou in ChatGPT en Google. Dat kost je elke maand klanten. | NXG Media"
  description="Wij zorgen dat jij boven je concurrenten komt in Google én aanbevolen wordt door ChatGPT — in 90 dagen. Max 5 bedrijven per regio."
  canonical={`${siteConfig.url}/ai-vindbaarheid-traject-b/`}
  schemas={[
    generateBreadcrumbs(breadcrumbs.map((b) => ({ name: b.label, url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}/ai-vindbaarheid-traject-b/` }))),
    serviceSchema,
  ]}
  locale={locale}
  hideNewsletter={true}
  hideStickyMobileCTA={true}
>
  <BreadcrumbNav items={breadcrumbs} />


  {/* ══════════════════════════════════════════════════
      HERO — Problem statement
      ══════════════════════════════════════════════════ */}
  <section class="relative overflow-hidden bg-primary">
    <div class="absolute inset-0 hidden md:block">
      <Image src={heroPhoto} alt="" width={800} class="absolute right-0 top-0 h-full w-auto object-cover object-top opacity-[0.12]" loading="eager" />
    </div>

    <div class="relative px-5 md:px-6 pt-12 pb-12 md:pt-20 md:pb-20">
      <div class="max-w-2xl mx-auto">
        <h1 class="font-heading text-[1.75rem] leading-[1.15] md:text-[2.75rem] md:leading-[1.1] text-white mb-5">
          Je concurrent staat boven jou in ChatGPT, Claude en Google.<br />
          <em class="text-accent not-italic">Dat kost je elke maand klanten.</em>
        </h1>

        <p class="text-white/60 text-sm md:text-base max-w-xl mb-5">
          Wij zorgen dat jij boven je concurrenten komt in Google én aanbevolen wordt door ChatGPT — in 90 dagen.
        </p>

        <div class="mb-5 max-w-xs">
          <div class="bg-white/[0.12] border-2 border-accent/40 rounded-lg px-4 py-3">
            <p class="text-white font-heading text-xl">Vanaf &euro;299<span class="text-sm text-white/50 font-body">/mnd</span></p>
            <p class="text-accent text-xs font-medium">Complete Google & AI boost</p>
          </div>
        </div>

        <ul class="space-y-1.5 text-sm text-white/70 mb-6">
          <li class="flex items-start gap-2"><span class="text-accent shrink-0 mt-0.5">&check;</span> Meer klanten door betere vindbaarheid in Google, ChatGPT, Perplexity en AI-zoekmachines</li>
          <li class="flex items-start gap-2"><span class="text-accent shrink-0 mt-0.5">&check;</span> Kom hoger te staan dan jouw concurrenten en krijg de aanvragen die nu naar hen gaan</li>
        </ul>

        <a href="#gesprek" class="inline-flex items-center gap-2 px-8 py-4 text-base font-medium text-white bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg w-full md:w-auto justify-center">
          Laat zien hoeveel omzet ik mis
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
        </a>
        <p class="text-white/40 text-xs mt-3">Stijg in Google &amp; AI of je krijgt je geld terug.</p>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      SECTIE 1 — Het probleem concreet maken (pijn)
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-14 md:py-20">
    <div class="max-w-2xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-6 leading-snug">
        Elke maand zoeken honderden mensen in jouw regio naar jouw dienst. <span class="text-accent font-bold">De nummer 1 pakt 30% meer van die zoekers dan de lagere posities zoals jij nu.</span>
      </h2>

      <div class="space-y-4 text-[0.95rem] leading-relaxed mb-10">
        <p class="text-text-muted">
          Google, ChatGPT, Perplexity en Claude bevelen nu specifieke dienstverleners aan. Niet een lijstje met tien opties &mdash; &eacute;&eacute;n of twee namen. Als jij daar niet bij staat, stuurt AI jouw klanten letterlijk naar je concurrent.
        </p>
        <p class="text-text font-medium">
          En het wordt erger. Elke dag dat jij niet zichtbaar bent, leert AI dat je concurrent de betere keuze is. Die voorsprong wordt steeds moeilijker in te halen.
        </p>
      </div>

      {/* Interactieve ROI calculator */}
      <div id="roi-calc" class="bg-primary rounded-2xl p-6 md:p-10 text-white">
        {/* Big number top */}
        <p class="text-xs uppercase tracking-widest text-white/50 font-medium mb-2">Jij mist nu elke maand</p>
        <p class="font-heading text-4xl md:text-6xl text-accent mb-1 transition-all duration-300" id="roi-amount">&euro;2.400 &ndash; &euro;6.000</p>
        <p class="text-white/60 text-sm mb-8" id="roi-subtitle">aan omzet die naar je concurrent gaat</p>

        {/* Niche selector */}
        <p class="text-white/50 text-xs uppercase tracking-widest font-medium mb-3">Selecteer jouw branche</p>
        <div class="flex flex-wrap gap-2 mb-8" id="niche-buttons">
          <button type="button" data-niche="fysiotherapeut" class="niche-btn active px-4 py-2 rounded-full text-sm font-medium transition-all bg-accent text-white">Fysiotherapeut</button>
          <button type="button" data-niche="chiropractor" class="niche-btn px-4 py-2 rounded-full text-sm font-medium transition-all bg-white/10 text-white/80 hover:bg-white/20">Chiropractor</button>
          <button type="button" data-niche="coach" class="niche-btn px-4 py-2 rounded-full text-sm font-medium transition-all bg-white/10 text-white/80 hover:bg-white/20">Coach / trainer</button>
          <button type="button" data-niche="psycholoog" class="niche-btn px-4 py-2 rounded-full text-sm font-medium transition-all bg-white/10 text-white/80 hover:bg-white/20">Psycholoog</button>
          <button type="button" data-niche="tandarts" class="niche-btn px-4 py-2 rounded-full text-sm font-medium transition-all bg-white/10 text-white/80 hover:bg-white/20">Tandarts</button>
          <button type="button" data-niche="huidtherapeut" class="niche-btn px-4 py-2 rounded-full text-sm font-medium transition-all bg-white/10 text-white/80 hover:bg-white/20">Huidtherapeut</button>
          <button type="button" data-niche="advocaat" class="niche-btn px-4 py-2 rounded-full text-sm font-medium transition-all bg-white/10 text-white/80 hover:bg-white/20">Advocaat</button>
          <button type="button" data-niche="accountant" class="niche-btn px-4 py-2 rounded-full text-sm font-medium transition-all bg-white/10 text-white/80 hover:bg-white/20">Accountant / boekhouder</button>
          <button type="button" data-niche="personal-trainer" class="niche-btn px-4 py-2 rounded-full text-sm font-medium transition-all bg-white/10 text-white/80 hover:bg-white/20">Personal trainer</button>
          <button type="button" data-niche="schoonheidssalon" class="niche-btn px-4 py-2 rounded-full text-sm font-medium transition-all bg-white/10 text-white/80 hover:bg-white/20">Schoonheidssalon</button>
          <button type="button" data-niche="yogastudio" class="niche-btn px-4 py-2 rounded-full text-sm font-medium transition-all bg-white/10 text-white/80 hover:bg-white/20">Yogastudio</button>
          <button type="button" data-niche="dietist" class="niche-btn px-4 py-2 rounded-full text-sm font-medium transition-all bg-white/10 text-white/80 hover:bg-white/20">Di&euml;tist</button>
        </div>

        {/* Funnel breakdown */}
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-8">
          <div class="bg-white/10 rounded-xl p-4 text-center">
            <p class="font-heading text-2xl md:text-3xl text-white" id="roi-searches">480</p>
            <p class="text-white/50 text-xs mt-1">zoekopdrachten /mnd</p>
          </div>
          <div class="bg-white/10 rounded-xl p-4 text-center">
            <p class="font-heading text-2xl md:text-3xl text-white" id="roi-visitors">~144</p>
            <p class="text-white/50 text-xs mt-1">bezoekers voor #1</p>
          </div>
          <div class="bg-white/10 rounded-xl p-4 text-center">
            <p class="font-heading text-2xl md:text-3xl text-white" id="roi-leads">5&ndash;7</p>
            <p class="text-white/50 text-xs mt-1">aanvragen /mnd</p>
          </div>
          <div class="bg-accent/20 border border-accent/30 rounded-xl p-4 text-center">
            <p class="font-heading text-2xl md:text-3xl text-accent" id="roi-value">&euro;400&ndash;800</p>
            <p class="text-white/50 text-xs mt-1">klantwaarde</p>
          </div>
        </div>

        {/* Example search terms */}
        <div class="bg-white/5 rounded-xl p-4 mb-8">
          <p class="text-white/40 text-xs uppercase tracking-widest font-medium mb-2">Typische zoekvragen in deze niche</p>
          <div class="flex flex-wrap gap-2" id="roi-keywords">
            <span class="px-3 py-1 rounded-full bg-white/10 text-white/70 text-xs">&ldquo;fysiotherapeut [stad]&rdquo;</span>
            <span class="px-3 py-1 rounded-full bg-white/10 text-white/70 text-xs">&ldquo;fysiotherapie in de buurt&rdquo;</span>
            <span class="px-3 py-1 rounded-full bg-white/10 text-white/70 text-xs">&ldquo;beste fysiotherapeut bij mij&rdquo;</span>
          </div>
        </div>

        {/* Bottom line */}
        <div class="bg-white rounded-2xl p-5 md:p-6 text-center">
          <p class="text-text font-heading text-lg md:text-xl leading-snug mb-1">
            Dit traject kost <span class="text-accent font-bold">&euro;299/mnd</span>. Reken maar uit.
          </p>
          <p class="text-text-muted text-sm mb-2">
            E&eacute;n extra klant per maand en je hebt het er dubbel en dwars uit.
          </p>
          <p class="text-accent font-semibold text-sm">
            Je stijgt in Google &amp; AI, of je krijgt je geld terug.
          </p>
        </div>
      </div>

      <script>
      (function () {
        const data = {
          'fysiotherapeut':    { searches: 480,  visitors: 144, leadsLow: 5, leadsHigh: 7,  valueLow: 400,  valueHigh: 800,   keywords: ['fysiotherapeut [stad]', 'fysiotherapie in de buurt', 'beste fysiotherapeut bij mij'] },
          'chiropractor':      { searches: 320,  visitors: 96,  leadsLow: 3, leadsHigh: 5,  valueLow: 500,  valueHigh: 1200,  keywords: ['chiropractor [stad]', 'chiropractor in de buurt', 'nekpijn behandeling'] },
          'coach':             { searches: 590,  visitors: 177, leadsLow: 5, leadsHigh: 9,  valueLow: 800,  valueHigh: 3000,  keywords: ['loopbaancoach [stad]', 'burnout coach', 'life coach bij mij in de buurt'] },
          'psycholoog':        { searches: 720,  visitors: 216, leadsLow: 6, leadsHigh: 11, valueLow: 500,  valueHigh: 1500,  keywords: ['psycholoog [stad]', 'therapie angst', 'psycholoog zonder wachtlijst'] },
          'tandarts':          { searches: 880,  visitors: 264, leadsLow: 8, leadsHigh: 13, valueLow: 200,  valueHigh: 600,   keywords: ['tandarts [stad]', 'tandarts in de buurt', 'spoed tandarts'] },
          'huidtherapeut':     { searches: 260,  visitors: 78,  leadsLow: 2, leadsHigh: 4,  valueLow: 600,  valueHigh: 2000,  keywords: ['huidtherapeut [stad]', 'acne behandeling', 'huidtherapie in de buurt'] },
          'advocaat':          { searches: 650,  visitors: 195, leadsLow: 6, leadsHigh: 10, valueLow: 1500, valueHigh: 5000,  keywords: ['advocaat [stad]', 'arbeidsrecht advocaat', 'letselschade advocaat'] },
          'accountant':        { searches: 540,  visitors: 162, leadsLow: 5, leadsHigh: 8,  valueLow: 1000, valueHigh: 3000,  keywords: ['boekhouder [stad]', 'accountant zzp', 'belastingaangifte hulp'] },
          'personal-trainer':  { searches: 390,  visitors: 117, leadsLow: 4, leadsHigh: 6,  valueLow: 300,  valueHigh: 800,   keywords: ['personal trainer [stad]', 'personal training', 'afvallen begeleiding'] },
          'schoonheidssalon':  { searches: 440,  visitors: 132, leadsLow: 4, leadsHigh: 7,  valueLow: 200,  valueHigh: 500,   keywords: ['schoonheidssalon [stad]', 'gezichtsbehandeling', 'nagelsalon in de buurt'] },
          'yogastudio':        { searches: 350,  visitors: 105, leadsLow: 3, leadsHigh: 5,  valueLow: 400,  valueHigh: 1200,  keywords: ['yoga [stad]', 'yogales in de buurt', 'beginners yoga'] },
          'dietist':           { searches: 310,  visitors: 93,  leadsLow: 3, leadsHigh: 5,  valueLow: 400,  valueHigh: 1000,  keywords: ['diëtist [stad]', 'voedingsadvies', 'afvallen begeleiding diëtist'] },
        };

        function fmt(n) { return n.toLocaleString('nl-NL'); }

        function update(niche) {
          const d = data[niche];
          if (!d) return;
          const revLow  = d.leadsLow  * d.valueLow;
          const revHigh = d.leadsHigh * d.valueHigh;

          document.getElementById('roi-amount').innerHTML    = '&euro;' + fmt(revLow) + ' &ndash; &euro;' + fmt(revHigh);
          document.getElementById('roi-searches').textContent = fmt(d.searches);
          document.getElementById('roi-visitors').textContent = '~' + fmt(d.visitors);
          document.getElementById('roi-leads').innerHTML      = d.leadsLow + '&ndash;' + d.leadsHigh;
          document.getElementById('roi-value').innerHTML      = '&euro;' + fmt(d.valueLow) + '&ndash;' + fmt(d.valueHigh);

          const kwBox = document.getElementById('roi-keywords');
          kwBox.innerHTML = d.keywords.map(function (kw) {
            return '<span class="px-3 py-1 rounded-full bg-white/10 text-white/70 text-xs">&ldquo;' + kw + '&rdquo;</span>';
          }).join('');

          document.querySelectorAll('.niche-btn').forEach(function (btn) {
            if (btn.dataset.niche === niche) {
              btn.className = 'niche-btn active px-4 py-2 rounded-full text-sm font-medium transition-all bg-accent text-white';
            } else {
              btn.className = 'niche-btn px-4 py-2 rounded-full text-sm font-medium transition-all bg-white/10 text-white/80 hover:bg-white/20';
            }
          });
        }

        document.querySelectorAll('.niche-btn').forEach(function (btn) {
          btn.addEventListener('click', function () { update(btn.dataset.niche); });
        });
      })();
      </script>

    </div>
  </section>

  {/* ══════════════════════════════════════════════════
      PROOF STRIP (uit pagina A)
      ══════════════════════════════════════════════════ */}
  <section class="bg-bg-alt border-b border-border/50 px-4 md:px-6 py-8 md:py-10">
    <div class="max-w-4xl mx-auto">
      <p class="text-xs uppercase tracking-widest text-accent font-medium text-center mb-5">Resultaten uit recente trajecten</p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6">

        {/* CBMC proof card */}
        <div class="bg-white border-2 border-accent/20 rounded-card overflow-hidden shadow-sm">
          <div class="px-5 pt-5 pb-4">
            <div class="flex items-center gap-3 mb-3">
              <Image src={jamesPhoto} alt="James Mitchell" width={40} height={40} class="w-10 h-10 rounded-full object-cover shrink-0 border-2 border-accent/20" />
              <div>
                <p class="text-text font-medium text-sm leading-tight">Costa Blanca Movement Centre</p>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 text-[0.6rem] font-semibold uppercase tracking-wider bg-accent/10 text-accent rounded-full mt-0.5">Google &amp; AI proof</span>
              </div>
            </div>
            <p class="text-text font-heading text-lg leading-snug mb-0.5">Van 0 naar pagina 1 in Google<span class="block text-sm font-body text-text-muted">binnen 14 dagen</span></p>
            <p class="text-accent font-semibold text-sm">12&ndash;15 nieuwe pati&euml;nten/mnd</p>
          </div>
          <div class="px-5 pb-4">
            <button type="button" class="proof-trigger cursor-pointer group w-full text-left">
              <div class="rounded-lg overflow-hidden border border-border/50">
                <Image src={proofGoogle} alt="Google pagina 1 bewijs" width={1200} quality={90} class="w-full h-auto opacity-90 group-hover:opacity-100 transition-opacity" />
              </div>
              <p class="text-text-muted text-[0.6rem] text-center mt-1 group-hover:text-text transition-colors">Klik om te vergroten</p>
            </button>
          </div>
        </div>

        {/* Verena proof card */}
        <div class="bg-white border-2 border-accent/20 rounded-card overflow-hidden shadow-sm">
          <div class="px-5 pt-5 pb-4">
            <div class="flex items-center gap-3 mb-3">
              <Image src={verenaPhoto} alt="Dr. Verena Mann" width={40} height={40} class="w-10 h-10 rounded-full object-cover shrink-0 border-2 border-accent/20" />
              <div>
                <p class="text-text font-medium text-sm leading-tight">Dr. Verena Mann</p>
                <span class="inline-flex items-center gap-1 px-2 py-0.5 text-[0.6rem] font-semibold uppercase tracking-wider bg-primary/10 text-primary rounded-full mt-0.5">AI proof</span>
              </div>
            </div>
            <p class="text-text font-heading text-lg leading-snug mb-0.5">2 &rarr; 19 aanvragen/mnd</p>
            <p class="text-accent font-semibold text-sm">15 AI-vermeldingen in ChatGPT</p>
          </div>
          <div class="px-5 pb-4">
            <button type="button" class="proof-trigger cursor-pointer group w-full text-left">
              <div class="rounded-lg overflow-hidden border border-border/50">
                <Image src={proofVerenaAi} alt="ChatGPT AI-vermelding bewijs" width={1200} quality={90} class="w-full h-auto opacity-90 group-hover:opacity-100 transition-opacity" />
              </div>
              <p class="text-text-muted text-[0.6rem] text-center mt-1 group-hover:text-text transition-colors">Klik om te vergroten</p>
            </button>
          </div>
        </div>

      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      SECTIE 2 — Wat wij doen (belofte, niet features)
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-14 md:py-20 bg-primary">
    <div class="max-w-2xl mx-auto text-center">
      <h2 class="font-heading text-2xl md:text-[2.25rem] md:leading-[1.15] text-white mb-5">
        Wij zorgen dat jij boven je concurrenten komt in Google én aanbevolen wordt door ChatGPT.<br />
        <em class="text-accent not-italic">In 90 dagen.</em>
      </h2>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      DISQUALIFICATIE (boven cases)
      ══════════════════════════════════════════════════ */}
  <section class="px-4 md:px-6 py-14 md:py-20">
    <div class="max-w-2xl mx-auto">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-6">
        Dit is niet voor je als:
      </h2>

      <ul class="space-y-3 mb-8">
        {[
          'Je al vol zit met klanten en niet wil groeien met je bedrijf.',
          'Je jouw website van 5 jaar geleden niet wil loslaten.',
          'Je alleen gratis tips zoekt.',
          'Je minder dan €299/mnd over hebt voor groei van je bedrijf — voor tenminste 3 maanden.',
        ].map((item) => (
          <li class="flex items-start gap-3 text-text-muted">
            <svg class="w-4 h-4 text-red-400 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
            <span class="text-[0.95rem]">{item}</span>
          </li>
        ))}
      </ul>

      <div class="border-t border-border pt-6">
        <p class="text-text font-heading text-lg md:text-xl">
          Maar als je serieus meer klanten wilt en bereid bent om samen met ons 90 dagen gas te geven, lees dan vooral verder.
        </p>
      </div>
    </div>
  </section>


  {/* ══════════════════════════════════════════════════
      CASES / BEWIJS
      ══════════════════════════════════════════════════ */}
  <section class="py-14 md:py-20 bg-bg-alt">
    <div class="max-w-5xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-2 text-center">
        Wat er gebeurt als het fundament klopt
      </h2>
      <p class="text-text-muted text-center mb-4 max-w-2xl mx-auto text-[0.95rem] leading-relaxed">
        Deze cases laten vooral zien wat er mogelijk wordt wanneer techniek, structuur, content, lokale signalen en conversie vanaf dag &eacute;&eacute;n kloppen. Dat is het verschil tussen losse fixes en een echt fundament.
      </p>

      {/* CASE 1: CBMC */}
      <div class="bg-white border-2 border-accent/30 rounded-card p-5 md:p-8 mb-8 shadow-lg">
        <div class="flex items-center gap-4 mb-5">
          <div class="w-12 h-12 rounded-full overflow-hidden ring-2 ring-accent/30 shrink-0">
