---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import BreadcrumbNav from '../components/BreadcrumbNav.astro';
import FAQAccordion from '../components/FAQAccordion.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import { siteConfig } from '../data/site';
import { generateBreadcrumbs, generateFAQPage, generateService } from '../data/schema';

import heroPhoto from '../assets/images/founder/joost-sitting-laptop-lookingfront.webp';
import founderPhoto from '../assets/images/founder/joost-standing-relaxed.webp';
import keystaticDashboard from '../assets/images/keystatic1.png';
import keystaticHomepage from '../assets/images/keystatic_edit_homepage.png';
import keystaticBlog from '../assets/images/keystatic_add_blog.png';
import verenaPhoto from '../assets/images/cases/verena-mann-linkedin.webp';
import jamesPhoto from '../assets/images/cases/james-mitchell-portrait.png';

const keystacticScreenshots = [
  { src: keystaticDashboard, alt: 'Beheerpaneel met overzicht van alle pagina\'s, blogs, diensten en producten', caption: 'Alles op één plek' },
  { src: keystaticHomepage, alt: 'Homepage teksten aanpassen via eenvoudige invoervelden', caption: 'Teksten aanpassen — geen code nodig' },
  { src: keystaticBlog, alt: 'Blog schrijven met opmaak toolbar en SEO-velden', caption: 'Zelf blogartikelen publiceren' },
];

const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/logos/*.{webp,avif,png,jpg}', { eager: true });
const logos = Object.entries(logoFiles)
  .filter(([path]) => /logo/i.test(path.split('/').pop()!))
  .map(([path, mod]) => {
    const filename = path.split('/').pop()!.replace(/\.(webp|avif|png|jpg)$/, '');
    const name = filename.replace(/[-_]?logo[-_]?/gi, '').replace(/[-_]/g, ' ').trim();
    return { src: mod.default, alt: name };
  });

const locale = 'nl';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'AI Vindbaarheid', href: '/ai-vindbaarheid/' },
  { label: '90-dagen traject' },
];

const faqItems = [
  {
    question: 'Krijg ik echt meer klanten hierdoor?',
    answer: 'Een snellere, beter vindbare online aanwezigheid met sterkere dienstpagina’s, reviews en conversie-optimalisatie leidt bij de meeste bedrijven tot meer aanvragen. Bij vergelijkbare trajecten zagen we 2-3x meer aanvragen binnen 90 dagen.',
  },
  {
    question: 'Is dit niet gewoon een nieuwe site?',
    answer: 'Nee. Een site is een middel, geen doel. Wij bouwen een online klantensysteem: beter vindbaar, meer vertrouwen, betere conversie naar aanvragen. Daar zit een nieuw technisch fundament onder, maar dat is het middel — niet het product.',
  },
  {
    question: 'Waarom 90 dagen?',
    answer: 'Maand 1: fundament en structuur. Maand 2: inhoud, bewijs en autoriteit opbouwen. Maand 3: optimaliseren op basis van data. Google en AI hebben tijd nodig om veranderingen te verwerken — 90 dagen is het minimum voor meetbaar resultaat.',
  },
  {
    question: 'Wat kost het?',
    answer: 'Trajecten starten vanaf €299/maand voor eenvoudige praktijksites. De exacte investering hangt af van je situatie. Daarom begin ik met een gratis analyse — dan weet je precies wat bij jouw situatie past.',
  },
  {
    question: 'Kan ik zelf aanpassen?',
    answer: 'Ja. Je krijgt een beheerpaneel voor teksten, foto’s, diensten en prijzen. Geen code nodig. Je bent niet afhankelijk van mij voor dagelijkse aanpassingen.',
  },
  {
    question: 'Wat als het niet werkt?',
    answer: 'Na 90 dagen evalueren we samen op basis van data: meer verkeer, meer aanvragen, betere posities. Je bent vrij om te stoppen. Geen lock-in, geen langlopend contract.',
  },
  {
    question: 'Verlies ik mijn huidige Google-posities?',
    answer: 'Elke bestaande pagina behoudt dezelfde URL of krijgt een permanente doorverwijzing. Je posities worden in de meeste gevallen juist beter door een sneller fundament.',
  },
  {
    question: 'Hoeveel tijd kost het mij?',
    answer: '1-2 uur per week in de eerste maand. Foto’s en feedback. Daarna minder.',
  },
];

const faqForSchema = faqItems.map((item) => ({ question: item.question, answer: item.answer }));
const faqForComponent = faqItems.map((item) => ({ q: item.question, a: item.answer }));

const serviceSchema = generateService({
  name: 'AI-Vindbaarheid Traject',
  description: 'Meer klanten via Google en AI. In 90 dagen beter gevonden worden, sneller vertrouwen opbouwen en meer bezoekers omzetten in aanvragen. Gratis groeianalyse.',
  url: `${siteConfig.url}/ai-vindbaarheid-traject/`,
  serviceType: 'AI Visibility Optimization',
});
---

<BaseLayout
  title="Meer klanten via Google en AI — Gratis Groeianalyse | NXG Media"
  description="Ontdek waar jouw bedrijf nu klanten laat liggen. Gratis persoonlijke groeianalyse binnen 48 uur. Trajecten vanaf €299/maand."
  canonical={`${siteConfig.url}/ai-vindbaarheid-traject/`}
  noindex={true}
  schemas={[
    generateBreadcrumbs(breadcrumbs.map((b) => ({ name: b.label, url: b.href ? `${siteConfig.url}${b.href}` : `${siteConfig.url}/ai-vindbaarheid-traject/` }))),
    generateFAQPage(faqForSchema),
    serviceSchema,
  ]}
  locale={locale}
>
  <BreadcrumbNav items={breadcrumbs} />

  {/* ── Bedank-banner voor redirects vanuit /groeiscan/ ── */}
  <div id="submitted-banner" class="hidden bg-green-50 border-b border-green-200">
    <div class="max-w-4xl mx-auto px-4 md:px-6 py-4 flex items-center gap-3">
      <div class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center shrink-0">
        <svg class="w-5 h-5 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
      </div>
      <p class="text-sm text-green-800 leading-relaxed">
        <strong>Bedankt!</strong> Ik bekijk je site en mail je binnen 48 uur een persoonlijke analyse. Lees hieronder meer over hoe het traject werkt.
      </p>
    </div>
  </div>

  {/* ── 1. HERO — GROEIKANS, NIET TECHNIEK ── */}
  <section class="relative py-20 md:py-28 lg:py-36 overflow-hidden">
    <div class="absolute inset-0">
      <Image
        src={heroPhoto}
        alt="Joost van Putten — online marketing specialist"
        widths={[800, 1200, 1600]}
        sizes="100vw"
        class="w-full h-full object-cover"
        loading="eager"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-white/95 via-white/85 to-white/40"></div>
    </div>
    <div class="relative max-w-4xl mx-auto px-4 md:px-6">
      <h1 class="font-heading text-4xl md:text-5xl lg:text-6xl text-text mb-6 leading-tight max-w-2xl">
        Jouw volgende klant zoekt al naar jou.<br /><em>Alleen vindt hij je concurrent.</em>
      </h1>
      <p class="text-lg md:text-xl text-text-muted leading-relaxed mb-4 max-w-xl">
        Mensen zoeken dagelijks via Google en AI naar de beste dienstverlener, praktijk of specialist in hun regio. Als jouw bedrijf daar niet goed zichtbaar is, verlies je aanvragen zonder dat je het doorhebt.
      </p>
      <p class="text-lg md:text-xl text-text font-medium leading-relaxed mb-8 max-w-xl">
        Ontdek waar jouw bedrijf nu klanten laat liggen &mdash; en welke verbeteringen het snelst meer aanvragen kunnen opleveren.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 mb-4">
        <a
          href="#formulier"
          class="inline-flex items-center justify-center px-8 py-4 text-base font-medium text-text-inverse bg-accent hover:bg-accent-dark transition-colors rounded-button shadow-lg"
        >
          Ontvang mijn gratis groeianalyse
          <svg class="ml-2 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
      <p class="text-sm text-text-muted">
        Gratis analyse &middot; Binnen 48 uur persoonlijk advies &middot; Geen technisch rapport maar concrete groeikansen
      </p>
    </div>
  </section>

  {/* ── 2. HET PROBLEEM — KLANTVERLIES, NIET TECHNIEK ── */}
  <section class="py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-6">Je website hoeft niet mooier. Hij moet meer klanten opleveren.</h2>
      <p class="text-text-muted leading-relaxed mb-6 text-lg">
        Veel ondernemers denken dat hun website prima is omdat hij er netjes uitziet. Maar een site kan er goed uitzien en alsnog weinig opleveren.
      </p>
      <p class="text-text-muted leading-relaxed mb-4">Omdat:</p>
      <div class="space-y-3 mb-8">
        <div class="flex items-start gap-3">
          <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
          <p class="text-text-muted">je diensten niet duidelijk genoeg worden gevonden</p>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
          <p class="text-text-muted">je pagina&rsquo;s niet aansluiten op waar klanten naar zoeken</p>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
          <p class="text-text-muted">bezoekers te weinig vertrouwen voelen om contact op te nemen</p>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
          <p class="text-text-muted">je concurrenten sterker zichtbaar zijn in Google</p>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
          <p class="text-text-muted">AI-tools jouw bedrijf niet goed genoeg begrijpen om aan te bevelen</p>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
          <p class="text-text-muted">je contactmomenten te zwak of te laat komen</p>
        </div>
      </div>
      <p class="text-text font-medium leading-relaxed text-lg">
        Het resultaat: mensen zoeken naar wat jij aanbiedt, maar komen bij een ander uit.
      </p>
    </div>
  </section>

  {/* ── 3. DIFFERENTIATOR — MARKETEER, NIET WEBDESIGNER ── */}
  <section class="py-16 md:py-20 bg-primary">
    <div class="max-w-3xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-white mb-6">
        Geen webdesigner die toevallig iets van marketing weet.<br />
        Een online marketeer die jouw online aanwezigheid bouwt als groeikanaal.
      </h2>
      <p class="text-white/80 leading-relaxed mb-6 text-lg">
        Dit traject is niet gebouwd door een sitebouwer. Het is gebouwd door een online marketeer met 8 jaar ervaring in advertenties, funnels, conversie en klantacquisitie.
      </p>
      <p class="text-white/80 leading-relaxed mb-4">Dat betekent dat we niet kijken naar &ldquo;wordt het mooi?&rdquo; maar naar:</p>
      <div class="space-y-3 mb-6">
        <div class="flex items-start gap-3">
          <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
          <p class="text-white/80">Waar zoekt je ideale klant naar?</p>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
          <p class="text-white/80">Wat moet iemand geloven voordat hij contact opneemt?</p>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
          <p class="text-white/80">Welke twijfels houden hem tegen?</p>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
          <p class="text-white/80">Welke bewijzen moeten zichtbaar zijn?</p>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
          <p class="text-white/80">Hoe maken we je expertise vindbaar voor Google &eacute;n AI?</p>
        </div>
        <div class="flex items-start gap-3">
          <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
          <p class="text-white/80">Waar moet de CTA staan zodat bezoekers niet afhaken?</p>
        </div>
      </div>
      <p class="text-white font-medium leading-relaxed text-lg">
        Een klassieke websitebouwer bouwt wat jij vraagt. Een online marketeer bouwt wat jouw klant nodig heeft om contact op te nemen.
      </p>
    </div>
  </section>

  {/* ── Vergelijkingstabel ── */}
  <section class="py-16 md:py-20 bg-bg-alt">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white rounded-card p-6 border border-border">
          <h3 class="font-heading text-lg text-text mb-5 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-gray-400 shrink-0"></span>
            Klassieke websitebouwer
          </h3>
          <ul class="space-y-3 text-sm text-text-muted">
            <li class="flex items-start gap-2"><span class="text-gray-400 shrink-0 mt-0.5">&ndash;</span> Bouwt een site die er goed uitziet</li>
            <li class="flex items-start gap-2"><span class="text-gray-400 shrink-0 mt-0.5">&ndash;</span> Denkt in pagina&rsquo;s en design</li>
            <li class="flex items-start gap-2"><span class="text-gray-400 shrink-0 mt-0.5">&ndash;</span> Levert op en verdwijnt</li>
            <li class="flex items-start gap-2"><span class="text-gray-400 shrink-0 mt-0.5">&ndash;</span> Werkt vanuit thema&rsquo;s en templates</li>
            <li class="flex items-start gap-2"><span class="text-gray-400 shrink-0 mt-0.5">&ndash;</span> Maakt teksten &ldquo;netjes&rdquo;</li>
            <li class="flex items-start gap-2"><span class="text-gray-400 shrink-0 mt-0.5">&ndash;</span> Kijkt naar techniek als einddoel</li>
          </ul>
        </div>
        <div class="bg-white rounded-card p-6 border-2 border-accent shadow-md">
          <h3 class="font-heading text-lg text-text mb-5 flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-accent shrink-0"></span>
            NXG Media
          </h3>
          <ul class="space-y-3 text-sm text-text-muted">
            <li class="flex items-start gap-2"><span class="text-accent shrink-0 mt-0.5">&check;</span> Bouwt een systeem dat aanvragen moet opleveren</li>
            <li class="flex items-start gap-2"><span class="text-accent shrink-0 mt-0.5">&check;</span> Denkt in klantreis, zoekintentie en conversie</li>
            <li class="flex items-start gap-2"><span class="text-accent shrink-0 mt-0.5">&check;</span> Meet, verbetert en optimaliseert 90 dagen door</li>
            <li class="flex items-start gap-2"><span class="text-accent shrink-0 mt-0.5">&check;</span> Werkt vanuit jouw aanbod, markt en concurrentie</li>
            <li class="flex items-start gap-2"><span class="text-accent shrink-0 mt-0.5">&check;</span> Maakt content vindbaar, overtuigend en citeerbaar</li>
            <li class="flex items-start gap-2"><span class="text-accent shrink-0 mt-0.5">&check;</span> Gebruikt techniek als middel voor groei</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  {/* ── 4. WAT WE BOUWEN — 3 PIJLERS ── */}
  <section class="py-16 md:py-20">
    <div class="max-w-4xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-2xl md:text-3xl text-text mb-4">In 90 dagen bouwen we drie dingen.</h2>
      <p class="text-text-muted leading-relaxed mb-12 text-lg">
        Niet een site. Een systeem dat drie dingen doet:
      </p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-10">
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-12 h-12 rounded-full bg-primary/10 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
          </div>
          <h3 class="font-heading text-lg text-text mb-3">Beter gevonden worden</h3>
          <p class="text-sm text-text-muted leading-relaxed">
            Je diensten worden vindbaar op de zoekvragen die jouw klanten stellen aan Google en AI. Niet alleen op je bedrijfsnaam, maar op dienst + regio, probleem + oplossing, vraag + antwoord.
          </p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-12 h-12 rounded-full bg-accent/10 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
          </div>
          <h3 class="font-heading text-lg text-text mb-3">Sneller vertrouwen opbouwen</h3>
          <p class="text-sm text-text-muted leading-relaxed">
            Bezoekers zien binnen 10 seconden waarom jij de logische keuze bent. Reviews, expertise, werkwijze, resultaten &mdash; zichtbaar op de juiste plek, niet verstopt op een over-pagina.
          </p>
        </div>
        <div class="bg-white rounded-card p-6 border border-border">
          <div class="w-12 h-12 rounded-full bg-green-100 flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
          </div>
          <h3 class="font-heading text-lg text-text mb-3">Meer bezoekers omzetten in aanvragen</h3>
          <p class="text-sm text-text-muted leading-relaxed">
            Duidelijke vervolgstappen. Minder afleiding. Betere volgorde. Meer bewijs v&oacute;&oacute;r de CTA. Lagere drempel om contact op te nemen.
          </p>
        </div>
      </div>

      <div class="bg-accent/5 border border-accent/20 rounded-card p-6">
        <p class="text-accent font-medium leading-relaxed text-center text-lg">
          &ldquo;De site is het middel. Meer klanten is het doel.&rdquo;
        </p>
      </div>
    </div>
  </section>

  {/* ── 5. BEWIJS — VISUEEL DOMINANTE PROOF SECTION ── */}
  <section class="py-20 md:py-28 bg-primary">
    <div class="max-w-5xl mx-auto px-4 md:px-6">
      <h2 class="font-heading text-3xl md:text-4xl text-white mb-3">Dit gebeurde er nadat het fundament klopte.</h2>
      <p class="text-white/60 text-lg mb-16">Geen portfoliostukjes. Echte businesstransformaties.</p>

      {/* ── HERO CASE: Dr. Verena Mann ── */}
      <div class="bg-white/5 backdrop-blur border border-white/10 rounded-card p-6 md:p-10 mb-12">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-14">
          {/* Links: het verhaal */}
          <div>
            <div class="flex items-center gap-4 mb-5">
              <div class="w-14 h-14 rounded-full overflow-hidden ring-2 ring-accent/30 shrink-0">
                <Image
                  src={verenaPhoto}
                  alt="Dr. Verena Mann"
                  widths={[56, 112]}
                  sizes="56px"
                  class="w-full h-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div>
                <p class="text-white font-medium text-sm">Dr. Verena Mann</p>
                <span class="inline-flex items-center px-2.5 py-0.5 text-[10px] font-medium bg-accent/20 text-accent rounded-full uppercase tracking-wider">Coach &middot; 90-dagen traject</span>
              </div>
            </div>
            <h3 class="font-heading text-2xl md:text-3xl text-white mb-4">Van Instagram-zichtbaarheid naar 19 aanvragen per maand</h3>

            <p class="text-white/60 leading-relaxed italic mb-6">
              Not&auml;rztin &amp; Ausdauer-Athletin. Veel zichtbaarheid op Instagram, tevreden klanten, sterke content. Maar haar online aanwezigheid leverde weinig nieuwe aanvragen op van mensen die haar nog niet kenden.
            </p>

            <div class="space-y-2 mb-8">
              <div class="flex items-start gap-3">
                <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
                <p class="text-white/70 text-sm">Aparte pagina&rsquo;s voor specifieke klantproblemen</p>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
                <p class="text-white/70 text-sm">Bewijs en resultaten zichtbaar op elke pagina</p>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
                <p class="text-white/70 text-sm">Aanvraagroute simpeler en logischer</p>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
                <p class="text-white/70 text-sm">Content vindbaar voor Google &eacute;n AI</p>
              </div>
              <div class="flex items-start gap-3">
                <span class="text-accent shrink-0 mt-0.5">&rarr;</span>
                <p class="text-white/70 text-sm">Positionering aangescherpt als expert in haar niche</p>
              </div>
            </div>

            <blockquote class="border-l-2 border-accent pl-5">
              <p class="text-white text-lg leading-relaxed font-medium">
                &ldquo;Ik dacht dat ik een betere online aanwezigheid nodig had. Achteraf was het veel meer dan dat. Ik kreeg eindelijk aanvragen van mensen die mij nog niet kenden.&rdquo;
              </p>
              <cite class="block text-white/40 text-sm mt-2 not-italic">&mdash; Dr. Verena Mann, doc-veri.pages.dev</cite>
            </blockquote>
          </div>

