---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  role: string;
  bio: string;
  image: ImageMetadata;
  credentials: Array<{ name: string; issuer: string }>;
  knowsAbout: string[];
  aboutHref: string;
  aboutLabel: string;
  locale?: string;
}

const {
  name,
  role,
  bio,
  image,
  credentials,
  knowsAbout,
  aboutHref,
  aboutLabel,
  locale = 'nl',
} = Astro.props;

const visibleSkills = knowsAbout.slice(0, 4);
---

<section class="py-16 md:py-24">
  <div class="max-w-4xl mx-auto px-4 md:px-6">
    <div class="grid grid-cols-1 md:grid-cols-[auto_1fr] gap-10 md:gap-14 items-start">

      {/* Circular founder image */}
      <div class="flex justify-center md:justify-start">
        <div class="w-48 h-48 md:w-56 md:h-56 rounded-full overflow-hidden shadow-lg ring-4 ring-bg-alt shrink-0">
          <Image
            src={image}
            alt={`${name} — ${role}`}
            widths={[224, 320]}
            sizes="(max-width: 768px) 192px, 224px"
            class="w-full h-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>

      {/* Content */}
      <div>
        {/* Accent bar */}
        <div class="w-12 h-1 bg-accent rounded-full mb-4"></div>

        <h2 class="font-heading text-2xl md:text-3xl text-text mb-1">{name}</h2>
        <p class="text-sm text-text-muted mb-4">{role}</p>
        <p class="text-text-muted leading-relaxed mb-6">{bio}</p>

        {/* Credentials */}
        {credentials.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-6">
            {credentials.map((cred) => (
              <span class="inline-flex items-center gap-1.5 text-xs bg-bg-alt border border-border rounded-button px-3 py-1.5">
                <span class="font-medium text-text">{cred.name}</span>
                <span class="text-text-muted">&middot; {cred.issuer}</span>
              </span>
            ))}
          </div>
        )}

        {/* knowsAbout checkmark list */}
        {visibleSkills.length > 0 && (
          <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 mb-8">
            {visibleSkills.map((skill) => (
              <li class="flex items-start gap-2 text-sm text-text-muted">
                <svg class="w-4 h-4 mt-0.5 shrink-0 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
                {skill}
              </li>
            ))}
          </ul>
        )}

        {/* More about link */}
        <a
          href={aboutHref}
          class="inline-flex items-center text-accent hover:text-accent-dark transition-colors font-medium"
        >
          {aboutLabel}
          <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>
