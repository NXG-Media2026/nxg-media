  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const toggle = document.getElementById('contract-toggle');
      if (!toggle) return;
      const btns = toggle.querySelectorAll('.term-btn') as NodeListOf<HTMLButtonElement>;
      const prices1y = document.querySelectorAll('.price-1y');
      const prices2y = document.querySelectorAll('.price-2y');

      function setTerm(term: string) {
        btns.forEach((btn) => {
          const isCurrent = btn.dataset.term === term;
          if (isCurrent) {
            btn.className = 'term-btn px-5 py-2.5 text-sm font-medium rounded-full transition-colors bg-primary text-white';
          } else {
            btn.className = 'term-btn px-5 py-2.5 text-sm font-medium rounded-full transition-colors bg-white text-text-muted border border-border hover:border-primary/30';
          }
        });
        prices1y.forEach((el) => el.classList.toggle('hidden', term === '2y'));
        prices2y.forEach((el) => el.classList.toggle('hidden', term === '1y'));
      }

      btns.forEach((btn) => {
        btn.addEventListener('click', () => setTerm(btn.dataset.term!));
      });
    });
  </script>

