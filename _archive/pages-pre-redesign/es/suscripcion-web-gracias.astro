---
/**
 * Bedanktpagina ES founding deal — /es/suscripcion-web-gracias
 * noindex — post-conversion thank you page.
 * Fires Meta Pixel Lead event.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteConfig } from '../../data/site';

const locale = 'es';
const title = 'Gracias — Tu solicitud ha sido recibida | NXG Media';
const description = 'Hemos recibido tu solicitud. Revisaremos tu web y te contactaremos en 24 horas.';
---

<BaseLayout
  title={title}
  description={description}
  canonical={`${siteConfig.url}/es/suscripcion-web-gracias`}
  noindex={true}
  schemas={[]}
  locale={locale}
>

  <section class="px-4 md:px-6 py-20 md:py-32">
    <div class="max-w-lg mx-auto text-center">

      <svg class="w-16 h-16 text-accent mx-auto mb-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>

      <h1 class="font-heading text-3xl md:text-4xl text-text mb-4">
        ¡Gracias! Tu solicitud ha sido recibida.
      </h1>

      <p class="text-text-muted text-[1.05rem] leading-relaxed mb-6 max-w-md mx-auto">
        Revisaremos tu web y te contactaremos en las próximas 24 horas por email o WhatsApp con el siguiente paso.
      </p>

      <div class="bg-bg-alt border border-border rounded-card p-5 mb-8 max-w-sm mx-auto">
        <p class="text-text font-medium text-sm mb-2">¿Qué pasa ahora?</p>
        <ol class="text-left text-text-muted text-sm space-y-2">
          <li class="flex items-start gap-2.5">
            <span class="text-accent font-bold shrink-0">1.</span>
            <span>Revisamos tu web actual y tu sector</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-accent font-bold shrink-0">2.</span>
            <span>Te contactamos con una propuesta clara</span>
          </li>
          <li class="flex items-start gap-2.5">
            <span class="text-accent font-bold shrink-0">3.</span>
            <span>Solo si encaja, empezamos a construir</span>
          </li>
        </ol>
      </div>

      <a
        href="/es/"
        class="inline-flex items-center gap-2 px-6 py-3 text-sm font-medium text-text border border-border hover:border-accent/30 transition-colors rounded-button"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" /></svg>
        Volver a la página principal
      </a>

    </div>
  </section>

</BaseLayout>

<script is:inline>
  var leadId = typeof nxgCapiEventId === 'function' ? nxgCapiEventId() : '';
  if (typeof fbq === 'function') {
    fbq('track', 'Lead', { content_name: 'es-mkb-founding-deal' }, { eventID: leadId });
  }
  if (leadId && typeof nxgCapiSend === 'function') {
    nxgCapiSend('Lead', leadId, { content_name: 'es-mkb-founding-deal' });
  }
</script>
